<?xml version="1.0"?>
<ruleset name="GLPIGrcManager">
    <description>Coding standard for GLPI GRC Manager.</description>

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="p"/>

    <file>src</file>
    <file>tests</file>
    <file>setup.php</file>
    <file>hook.php</file>
    <file>inc</file>
    <file>front</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- GLPI hook/setup entry points use snake_case function names required by GLPI's plugin
         loader, and CommonDBTM's own magic hook methods (post_updateItem, post_addItem,
         pre_deleteItem...) are snake_case too, e.g. PluginGrcmanagerControl::post_updateItem()
         (see inc/control.class.php), not an oversight. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>setup.php</exclude-pattern>
        <exclude-pattern>hook.php</exclude-pattern>
        <exclude-pattern>inc/*</exclude-pattern>
    </rule>

    <!-- setup.php necessarily mixes constant/function declarations with the conditional
         vendor/autoload.php require, that's the standard GLPI plugin entry point shape.
         SetupMenuRedefinitionTest.php is the same shape for the same reason: it requires
         setup.php (a side effect) to reach plugin_grcmanager_redefine_menus() before declaring
         its own test class. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>setup.php</exclude-pattern>
        <exclude-pattern>front/*</exclude-pattern>
        <exclude-pattern>tests/Unit/SetupMenuRedefinitionTest.php</exclude-pattern>
    </rule>

    <!-- inc/ holds GLPI's legacy global-namespace CommonDBTM subclasses (PluginGrcmanager*),
         GLPI's own plugin autoloader requires this shape (no namespace), not an oversight.
         front/ scripts are also global-namespace by the same GLPI convention. -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>inc/*</exclude-pattern>
    </rule>
</ruleset>
