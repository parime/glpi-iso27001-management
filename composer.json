{
    "name": "parime/glpi-iso27001-management",
    "description": "Generic organizational risk, ISO 27001 Statement of Applicability, internal audit and CAPA platform built on GLPI.",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Vincent GUILLOTTE",
            "homepage": "https://github.com/parime"
        }
    ],
    "homepage": "https://github.com/parime/glpi-iso27001-management",
    "support": {
        "issues": "https://github.com/parime/glpi-iso27001-management/issues",
        "source": "https://github.com/parime/glpi-iso27001-management"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Grcmanager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Grcmanager\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "stan": "phpstan analyse --no-progress",
        "cs": "phpcs"
    }
}
