parameters:
    level: 6
    tmpDir: .phpstan-cache
    # Scope limited to pure-PHP logic that has no runtime dependency on GLPI core classes
    # (CommonDBTM, Migration, ProfileRight, DBmysql, global $DB/$PLUGIN_HOOKS...). Those are only
    # available inside a running GLPI instance and are not yet stubbed for static analysis, same
    # exclusion rationale as the sibling plugin glpi-vulnerability-manager (same author). Extend
    # `paths` as GLPI-independent services are added under src/.
    paths:
        - src/Compatibility
        - src/Services/Risk
        - src/Services/Control
        - src/Services/Capa
        - src/Services/Training
        - src/Services/Classification
        - src/Services/Policy
        - src/Services/Objective
        - src/Services/Compliance
        - src/Services/Incident
    excludePaths:
        # Depends on GLPI's legacy global-namespace CommonDBTM classes (PluginGrcmanager*), not
        # available for static analysis, see above. src/Install/ is entirely GLPI-dependent and
        # stays out of `paths` altogether for the same reason.
        - src/Services/DefaultSearchColumns.php
        - src/Services/Dashboard/DashboardCardService.php
        # Sprint 7: depends on GLPI core's Glpi\Dashboard\Dashboard (global $DB, Session,
        # TemplateRenderer...), same rationale as DashboardCardService.php above.
        - src/Services/Dashboard/DefaultDashboardService.php
        # Sprint 7 (suivi de version GitHub): depends on \Toolbox::getURLContent(), $GLPI_CACHE
        # and DAY_TIMESTAMP, same category of GLPI-core-only runtime symbol as
        # RiskMatrixConfig.php/OverdueCapaService.php below.
        - src/Services/GithubVersionChecker.php
        # Sprint 2: reads GLPI's runtime global $DB (RiskMatrixConfig) or depends on GLPI core
        # classes NotificationEvent/PluginGrcmanagerRisk (ReviewReminderService), same rationale.
        # RiskMatrixDefaults.php and ReviewReminderResult.php in the same directory stay in scope:
        # both are pure PHP with no GLPI dependency.
        - src/Services/Risk/RiskMatrixConfig.php
        - src/Services/Risk/ReviewReminderService.php
        # Sprint 4: depends on GLPI core classes NotificationEvent/PluginGrcmanagerNonconformity,
        # same rationale as ReviewReminderService above. OverdueCapaResult.php in the same
        # directory stays in scope: pure PHP with no GLPI dependency.
        - src/Services/Capa/OverdueCapaService.php
        # Sprint 6: depends on GLPI's runtime global $DB and core classes
        # NotificationEvent/PluginGrcmanagerTraining, same rationale as OverdueCapaService above.
        # TrainingRenewalResult.php in the same directory stays in scope: pure PHP with no GLPI
        # dependency.
        - src/Services/Training/TrainingRenewalService.php
        # Issue #28: depends on GLPI core classes NotificationEvent/PluginGrcmanagerPolicy, same
        # rationale as ReviewReminderService above. PolicyLifecycle.php,
        # PolicyReviewReminderWindow.php and PolicyReviewReminderResult.php in the same directory
        # stay in scope: all three are pure PHP with no GLPI dependency.
        - src/Services/Policy/PolicyReviewReminderService.php
        # Issue #31: depends on GLPI core classes NotificationEvent/PluginGrcmanagerRiskTreatmentAction,
        # same rationale as OverdueCapaService above. TreatmentPlanRules.php and
        # OverdueTreatmentActionResult.php in the same directory stay in scope: both are pure PHP
        # with no GLPI dependency.
        - src/Services/Risk/OverdueTreatmentActionService.php
        # Module toggle infra for the security-incident absorption (ROADMAP.md "Version 2.0"):
        # depends on GLPI's runtime global $DB, same rationale as RiskMatrixConfig above.
        - src/Services/Incident/SecurityIncidentModuleConfig.php
