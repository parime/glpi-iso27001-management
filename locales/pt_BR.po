msgstr "nenhum: informe o auditor na ficha ou adicione auditores na aba Equipe."

#, php-format
msgid "No independence conflict between the auditors and the audited processes."
msgstr "Nenhum conflito de independência entre os auditores e os processos auditados."

#, php-format
msgid "Role in the matrix"
msgstr "Papel na matriz"

