msgid "Action plan #%d"
msgstr "Plano de ação nº %d"

msgid "Propose an action plan"
msgstr "Propor um plano de ação"

msgid "Security watch"
msgstr "Monitoramento de segurança"

msgid "New security advisory about the supplier"
msgstr "Novo aviso de segurança sobre o fornecedor"

msgid "Security advisories"
msgstr "Avisos de segurança"

msgid "Choose this risk's supplier to follow the security advisories about it."
msgstr ""
"Escolha o fornecedor deste risco para acompanhar os avisos de segurança "
"sobre ele."

msgid "Searched names"
msgstr "Nomes pesquisados"

msgid ""
"The watch queries CERT-FR once the \"Enable NVD enrichment\" option is "
"checked in the plugin configuration."
msgstr ""
"O monitoramento consulta o CERT-FR assim que a opção \"Ativar o "
"enriquecimento pelo NVD\" é marcada na configuração do plugin."

#, php-format
msgid "CERT-FR advisories and alerts (last %d days)"
msgstr "Avisos e alertas do CERT-FR (últimos %d dias)"

msgid "No advisory mentions this supplier."
msgstr "Nenhum aviso menciona este fornecedor."

#, php-format
msgid "Last CERT-FR check: %s."
msgstr "Última consulta ao CERT-FR: %s."

msgid "Date"
msgstr "Data"

msgid "Reference"
msgstr "Referência"

msgid "Alert"
msgstr "Alerta"

msgid "Vulnerabilities of its software in the fleet"
msgstr "Vulnerabilidades dos seus softwares no parque"

msgid "No watched software from this supplier has a known vulnerability."
msgstr ""
"Nenhum software monitorado deste fornecedor tem vulnerabilidade conhecida."

