msgid "%1$s (ID %2$d)"
msgstr "%1$s (ID %2$d)"

msgid "No review date"
msgstr "Sem data de revisão"

#, php-format
msgid "Review was due on %s"
msgstr "A revisão vencia em %s"

#, php-format
msgid "Due on %s"
msgstr "Vence em %s"

#, php-format
msgid "Level: %s"
msgstr "Nível: %s"

#, php-format
msgid "Accepted at level %s, no signed acceptance"
msgstr "Aceito no nível %s, sem aceitação assinada"

#, php-format
msgid "Justification too short: \"%s\""
msgstr "Justificativa curta demais: \"%s\""

msgid "No linked risk"
msgstr "Nenhum risco vinculado"

msgid "No valid document, never tested"
msgstr "Nenhum documento válido, nunca testado"

#, php-format
msgid "No valid document, last test on %s"
msgstr "Nenhum documento válido, último teste em %s"

msgid "Statement of Applicability"
msgstr "Declaração de Aplicabilidade"

#, php-format
msgid "Changed since version %s was approved"
msgstr "Alterada desde a aprovação da versão %s"

#, php-format
msgid "Action \"%1$s\" due on %2$s"
msgstr "Ação \"%1$s\" com vencimento em %2$s"

#, php-format
msgid "Ended on %s"
msgstr "Encerrada em %s"

#, php-format
msgid "Valid until %s"
msgstr "Válido até %s"

msgid "None recorded as completed"
