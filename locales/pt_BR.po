msgstr "Chamados e mudanças exigem o direito de ver todos."

msgid "All my active entities"
msgstr "Todas as minhas entidades ativas"

msgid "Period covered: from"
msgstr "Período coberto: de"

msgid "to"
msgstr "até"

msgid ""
"Creation date of users and computers; opening date of tickets and changes, "
"or closing date if closed only."
msgstr ""
"Data de criação de usuários e computadores; data de abertura de chamados e "
"mudanças, ou data de fechamento se somente fechados."

msgid "Category (tickets and changes)"
msgstr "Categoria (chamados e mudanças)"

msgid "Closed tickets or changes only"
msgstr "Somente chamados ou mudanças fechados"

msgid "Active user accounts only"
msgstr "Somente contas de usuário ativas"

msgid "How often the control operates"
msgstr "Frequência de funcionamento do controle"

msgid "Empty: the size proposed for this frequency."
msgstr "Vazio: o tamanho proposto para esta frequência."

msgid "Seed (optional)"
msgstr "Semente (opcional)"

