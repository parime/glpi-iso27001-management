msgstr "%1$d medidas, %2$d requisitos"

msgid "Register"
msgstr "Registro"

msgid "Without owner"
msgstr "Sem responsável"

msgid "By function of the national framework"
msgstr "Por função do framework nacional"

msgid "Approval to record"
msgstr "Aprovação a registrar"

