msgstr "Criar o risco correspondente"

msgid "Items affected by a failure"
msgstr "Itens afetados por uma falha"

msgid "No item depends on this one."
msgstr "Nenhum item depende deste."

msgid "Dependency"
msgstr "Dependência"

msgid "Direct"
msgstr "Direta"

#, php-format
