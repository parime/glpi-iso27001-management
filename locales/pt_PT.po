#, php-format
msgid "%1$d vulnerabilities: the %2$d highest-priority ones are shown."
msgstr "%1$d vulnerabilidades: as %2$d de maior prioridade são exibidas."

msgid "Catalog of typical risks"
msgstr "Catálogo de riscos típicos"

msgid "Administration service exposed to the Internet"
msgstr "Serviço de administração exposto na Internet"

msgid "An administration interface (SSH, remote desktop, firewall console, proxy or hypervisor dashboard) can be reached from the Internet."
msgstr "Uma interface de administração (SSH, área de trabalho remota, console de firewall, painel de proxy ou de hipervisor) pode ser acessada a partir da Internet."

msgid "Brute-force or stolen-password attack, exploitation of a published flaw before the update, takeover of the device."
msgstr "Ataque de força bruta ou com senhas roubadas, exploração de uma falha publicada antes da atualização, tomada de controle do equipamento."

msgid "Does a firewall rule publish an administration port to the Internet?"
msgstr "Alguma regra de firewall publica uma porta de administração para a Internet?"

msgid "Does administrative access go through a VPN or a bastion with strong authentication?"
msgstr "O acesso administrativo passa por uma VPN ou por um bastion com autenticação forte?"

msgid "Server remote management cards reachable outside the administration network"
msgstr "Placas de gerenciamento remoto de servidores acessíveis fora da rede de administração"

msgid "iLO, iDRAC, IPMI or similar interfaces are on the same network as workstations or servers, or even published."
msgstr "Interfaces iLO, iDRAC, IPMI ou similares estão na mesma rede que as estações de trabalho ou os servidores, ou até publicadas."

msgid "Hardware-level takeover of the server (console, power, image mounting) that bypasses the operating system and its protections."
msgstr "Tomada de controle do servidor no nível de hardware (console, energia, montagem de imagens), contornando o sistema operacional e suas proteções."

msgid "Are the management cards on a dedicated, filtered network?"
msgstr "As placas de gerenciamento estão em uma rede dedicada e filtrada?"

msgid "Have their default passwords been changed and their firmware updated?"
msgstr "As senhas padrão foram alteradas e o firmware foi atualizado?"

msgid "Networks overlapping with a partner connected by VPN"
msgstr "Redes sobrepostas com um parceiro conectado por VPN"

msgid "A partner, customer or provider connected by VPN uses the same address range as one of your sites."
msgstr "Um parceiro, cliente ou prestador conectado por VPN usa a mesma faixa de endereços que um dos seus sites."

msgid "Misrouted or blocked traffic, improvised workarounds (address translation added in a hurry, overly broad rules) that open more than needed."
msgstr "Tráfego mal roteado ou bloqueado, soluções improvisadas (tradução de endereços adicionada às pressas, regras amplas demais) que abrem mais do que o necessário."

msgid "Do VPN tunnels connect your networks to third parties' networks?"
msgstr "Há túneis VPN conectando suas redes às redes de terceiros?"

msgid "Are the ranges on each side documented and distinct?"
msgstr "As faixas de cada lado estão documentadas e são distintas?"

msgid "Insufficiently isolated guest network"
msgstr "Rede de visitantes insuficientemente isolada"

msgid "The guest Wi-Fi or visitor network can reach internal devices."
msgstr "O Wi-Fi de convidados ou a rede de visitantes consegue acessar dispositivos internos."

msgid "An unknown or compromised device reaches workstations, printers or servers; internal traffic is eavesdropped."
msgstr "Um dispositivo desconhecido ou comprometido alcança estações de trabalho, impressoras ou servidores; o tráfego interno é interceptado."

msgid "Does the guest network only have access to the Internet?"
msgstr "A rede de visitantes tem acesso apenas à Internet?"

msgid "Has the isolation been checked by a test from a guest device?"
msgstr "O isolamento foi verificado por um teste a partir de um dispositivo visitante?"

msgid "Flat internal network, without segmentation"
msgstr "Rede interna plana, sem segmentação"

msgid "Workstations, servers, printers, telephony and industrial equipment share the same network."
msgstr "Estações de trabalho, servidores, impressoras, telefonia e equipamentos industriais compartilham a mesma rede."

msgid "A compromised workstation (ransomware, Trojan) spreads freely to servers and backups."
msgstr "Uma estação comprometida (ransomware, cavalo de Troia) se propaga livremente para os servidores e os backups."

msgid "Does each use have its own network or VLAN, with filtering between them?"
msgstr "Cada uso tem sua própria rede ou VLAN, com filtragem entre elas?"

msgid "Are the flows allowed between networks listed in the network flow matrix?"
msgstr "Os fluxos permitidos entre redes estão listados na matriz de fluxos de rede?"

msgid "Single point of failure: power supply"
msgstr "Ponto único de falha: alimentação elétrica"

msgid "The server room or network closet depends on a single UPS, a single power feed or a single power supply per device."
msgstr "A sala de servidores ou o rack de rede depende de um único nobreak, de uma única entrada de energia ou de uma única fonte por equipamento."

msgid "Total outage during a UPS failure or electrical work; equipment damaged by a sudden shutdown."
msgstr "Interrupção total durante uma falha do nobreak ou uma intervenção elétrica; equipamentos danificados por um desligamento abrupto."

msgid "Do critical devices have two power supplies, on two circuits?"
msgstr "Os dispositivos críticos têm duas fontes de alimentação, em dois circuitos?"

msgid "Is the UPS runtime tested and sufficient for a clean shutdown?"
msgstr "A autonomia do nobreak é testada e suficiente para um desligamento seguro?"

msgid "Single point of failure: hypervisor or shared storage"
msgstr "Ponto único de falha: hipervisor ou armazenamento compartilhado"

msgid "Several critical virtual servers rely on a single virtualization host or a single storage array."
msgstr "Vários servidores virtuais críticos dependem de um único host de virtualização ou de um único storage."

msgid "Simultaneous outage of all hosted applications after a hardware failure or a failed update."
msgstr "Interrupção simultânea de todas as aplicações hospedadas após uma falha de hardware ou uma atualização malsucedida."

msgid "Can a second host take over the critical virtual machines?"
msgstr "Um segundo host consegue assumir as máquinas virtuais críticas?"

msgid "Has the recovery time been measured during a test?"
msgstr "O tempo de recuperação foi medido durante um teste?"

msgid "Single point of failure: carrier link"
msgstr "Ponto único de falha: link da operadora"

msgid "A site, or access to online services, depends on a single Internet link or a single carrier."
msgstr "Um site, ou o acesso a serviços online, depende de um único link de Internet ou de uma única operadora."

msgid "Site cut off during an outage (works, carrier failure), telephony and hosted applications unavailable."
msgstr "Site isolado durante uma interrupção (obras, falha da operadora), telefonia e aplicações hospedadas indisponíveis."

msgid "Is there a second link, with another carrier and over another physical path?"
msgstr "Existe um segundo link, com outra operadora e por outro caminho físico?"

msgid "Has the failover been tested?"
msgstr "O failover foi testado?"

msgid "Single point of failure: directory (domain controller)"
msgstr "Ponto único de falha: diretório (controlador de domínio)"

msgid "A site has only one domain controller, or the directory has only one server."
msgstr "Um site tem apenas um controlador de domínio, ou o diretório tem apenas um servidor."

msgid "No more logons or access to shares after a failure; long and tricky directory restore."
msgstr "Sem logons nem acesso aos compartilhamentos após uma falha; restauração do diretório longa e delicada."

msgid "Does each site have at least two domain controllers, or reliable access to a second one?"
msgstr "Cada site tem pelo menos dois controladores de domínio, ou acesso confiável a um segundo?"

msgid "Has the directory restore ever been tested?"
msgstr "A restauração do diretório já foi testada alguma vez?"

msgid "Backups on the same site as the data"
msgstr "Backups no mesmo site que os dados"

msgid "Backups are stored in the same room, building or administration domain as the data they protect."
msgstr "Os backups são armazenados na mesma sala, prédio ou domínio de administração que os dados que protegem."

msgid "Simultaneous loss of data and backups in a fire, a flood or a ransomware attack that also encrypts the backups."
msgstr "Perda simultânea dos dados e dos backups em um incêndio, uma inundação ou um ataque de ransomware que também criptografa os backups."

msgid "Is a copy kept off-site or offline, immutable?"
msgstr "Uma cópia é mantida fora do site ou offline, imutável?"

msgid "Is a full restore tested regularly?"
msgstr "Uma restauração completa é testada regularmente?"

msgid "Network diagram and address plan not kept up to date"
