msgstr[1] "%d aktiv ausgenutzte Schwachstellen"

#, php-format
msgid "%d vulnerability likely to be exploited"
msgid_plural "%d vulnerabilities likely to be exploited"
msgstr[0] "%d wahrscheinlich ausgenutzte Schwachstelle"
msgstr[1] "%d wahrscheinlich ausgenutzte Schwachstellen"

#, php-format
