msgstr "[ÜBUNG] %s"

msgid "This is a crisis exercise: no real incident is in progress."
msgstr "Dies ist eine Krisenübung: Es läuft kein echter Vorfall."

#, php-format
msgid "Target: %d min after the start of the exercise."
msgstr "Ziel: %d Min. nach Beginn der Übung."

#, php-format
