msgstr "Reifegrad: %d"

#, php-format
msgid "%d overdue corrective/preventive action(s), %d notification(s) raised."
msgstr ""
"%d überfällige Korrektur-/Vorbeugemaßnahme(n), %d Benachrichtigung(en) "
"ausgelöst."

#, php-format
msgid "%d policy(ies) awaiting review, %d notification(s) raised."
msgstr "%d Richtlinie(n) zur Überprüfung, %d Benachrichtigung(en) ausgelöst."

#, php-format
msgid "%d risk(s) awaiting review, %d notification(s) raised."
msgstr "%d Risiko/Risiken zur Überprüfung, %d Benachrichtigung(en) ausgelöst."

#, php-format
msgid "%d overdue risk treatment action(s), %d notification(s) raised."
msgstr ""
"%d überfällige Risikobehandlungsmaßnahme(n), %d Benachrichtigung(en) "
"ausgelöst."

#, php-format
msgid "%1$d CVE(s) refreshed from the NVD out of %2$d tracked."
msgstr "%1$d von %2$d verfolgten CVE(s) aus der NVD aktualisiert."

#, php-format
msgid "%d supplier risk(s) awaiting review, %d notification(s) raised."
msgstr ""
"%d Lieferantenrisiko/-risiken zur Überprüfung, %d Benachrichtigung(en) "
