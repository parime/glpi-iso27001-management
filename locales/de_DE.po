msgstr "Hoch (CVSS unter 9)"

msgid "Urgency colour"
msgstr "Farbe der Dringlichkeit"

#, php-format
msgid "Report by email: %1$s, next one on %2$s."
msgstr "Bericht per E-Mail: %1$s, nächster am %2$s."

