msgstr "%s : vérifié adresse par adresse"

msgid "Have I Been Pwned key accepted."
msgstr "Clé Have I Been Pwned acceptée."

msgid "Have I Been Pwned refused the API key."
msgstr "Have I Been Pwned a refusé la clé d'API."

