msgstr "Este elemento ya está vinculado al proceso."

msgid "Business impact analysis"
msgstr "Análisis de impacto en el negocio (BIA)"

msgid "Financial"
msgstr "Financiero"

msgid "Legal and regulatory"
msgstr "Legal y regulatorio"

msgid "Image and reputation"
msgstr "Imagen y reputación"

msgid "Operational"
msgstr "Operativo"

msgid "Not rated"
msgstr "No evaluado"

msgid "Negligible"
msgstr "Insignificante"

msgid "Limited"
msgstr "Limitado"

