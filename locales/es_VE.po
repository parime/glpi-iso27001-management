msgstr "Indicadores de riesgo (KRI) en rojo"

msgid "A numeric value is required."
msgstr "Se requiere un valor numérico."

msgid ""
"The tolerance cannot be below the appetite: these categories were not saved."
msgstr ""
"La tolerancia no puede ser inferior al apetito: estas categorías no se han "
"guardado."

msgid "No value could be measured for this indicator."
msgstr "No se ha podido medir ningún valor para este indicador."

msgid "The indicator is not in the red: no ticket was created."
msgstr "El indicador no está en rojo: no se ha creado ningún ticket."

