msgstr "Vista general del SGSI"

msgid "Data protection officer (DPO)"
msgstr "Delegado de protección de datos (DPD)"

msgid ""
"Name and contact details of the data protection officer, shown on the record "
"of processing activities (GDPR, article 30)."
msgstr ""
"Nombre y datos de contacto del delegado de protección de datos, que figuran "
"en el registro de actividades de tratamiento (RGPD, artículo 30)."

msgid "G1 - Minor"
msgstr "G1 - Menor"

msgid "G2 - Significant"
msgstr "G2 - Significativa"

msgid "G3 - Serious"
msgstr "G3 - Grave"

msgid "G4 - Critical"
msgstr "G4 - Crítica"

