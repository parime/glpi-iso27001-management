#, php-format
msgid "%1$d vulnerabilities: the %2$d highest-priority ones are shown."
msgstr "%1$d vulnérabilités : les %2$d plus prioritaires sont affichées."

msgid "Catalog of typical risks"
msgstr "Catalogue de risques types"

msgid "Administration service exposed to the Internet"
msgstr "Service d'administration exposé sur Internet"

msgid "An administration interface (SSH, remote desktop, firewall console, proxy or hypervisor dashboard) can be reached from the Internet."
msgstr "Une interface d'administration (SSH, bureau à distance, console d'un pare-feu, tableau de bord d'un proxy ou d'un hyperviseur) est joignable depuis Internet."

msgid "Brute-force or stolen-password attack, exploitation of a published flaw before the update, takeover of the device."
msgstr "Attaque par force brute ou par mots de passe volés, exploitation d'une faille publiée avant la mise à jour, prise de contrôle de l'équipement."

msgid "Does a firewall rule publish an administration port to the Internet?"
msgstr "Une règle du pare-feu publie-t-elle un port d'administration vers Internet ?"

msgid "Does administrative access go through a VPN or a bastion with strong authentication?"
msgstr "L'accès d'administration passe-t-il par un VPN ou un bastion avec authentification forte ?"

msgid "Server remote management cards reachable outside the administration network"
msgstr "Cartes de gestion à distance des serveurs joignables hors du réseau d'administration"

msgid "iLO, iDRAC, IPMI or similar interfaces are on the same network as workstations or servers, or even published."
msgstr "Les interfaces iLO, iDRAC, IPMI ou équivalentes sont sur le même réseau que les postes ou les serveurs, voire publiées."

msgid "Hardware-level takeover of the server (console, power, image mounting) that bypasses the operating system and its protections."
msgstr "Prise de contrôle matérielle du serveur (console, alimentation, montage d'images) qui contourne le système d'exploitation et ses protections."

msgid "Are the management cards on a dedicated, filtered network?"
msgstr "Les cartes de gestion sont-elles sur un réseau dédié, filtré ?"

msgid "Have their default passwords been changed and their firmware updated?"
msgstr "Leurs mots de passe par défaut ont-ils été changés et leur micrologiciel mis à jour ?"

msgid "Networks overlapping with a partner connected by VPN"
msgstr "Réseaux qui se chevauchent avec un partenaire relié par VPN"

msgid "A partner, customer or provider connected by VPN uses the same address range as one of your sites."
msgstr "Un partenaire, un client ou un prestataire relié par VPN utilise la même plage d'adresses qu'un de vos sites."

msgid "Misrouted or blocked traffic, improvised workarounds (address translation added in a hurry, overly broad rules) that open more than needed."
msgstr "Flux mal routés ou bloqués, contournements improvisés (traduction d'adresses ajoutée dans l'urgence, règles trop larges) qui ouvrent plus que nécessaire."

msgid "Do VPN tunnels connect your networks to third parties' networks?"
msgstr "Des tunnels VPN relient-ils vos réseaux à ceux de tiers ?"

msgid "Are the ranges on each side documented and distinct?"
msgstr "Les plages de chaque côté sont-elles documentées et distinctes ?"

msgid "Insufficiently isolated guest network"
msgstr "Réseau invités insuffisamment isolé"

msgid "The guest Wi-Fi or visitor network can reach internal devices."
msgstr "Le Wi-Fi invités ou le réseau des visiteurs peut joindre des équipements internes."

msgid "An unknown or compromised device reaches workstations, printers or servers; internal traffic is eavesdropped."
msgstr "Un appareil inconnu ou compromis atteint les postes, les imprimantes ou les serveurs ; écoute du trafic interne."

msgid "Does the guest network only have access to the Internet?"
msgstr "Le réseau invités n'a-t-il accès qu'à Internet ?"

msgid "Has the isolation been checked by a test from a guest device?"
msgstr "L'isolation a-t-elle été vérifiée par un test depuis un appareil invité ?"

msgid "Flat internal network, without segmentation"
msgstr "Réseau interne à plat, sans segmentation"

msgid "Workstations, servers, printers, telephony and industrial equipment share the same network."
msgstr "Postes, serveurs, imprimantes, téléphonie et équipements industriels partagent le même réseau."

msgid "A compromised workstation (ransomware, Trojan) spreads freely to servers and backups."
msgstr "Un poste compromis (rançongiciel, cheval de Troie) se propage librement vers les serveurs et les sauvegardes."

msgid "Does each use have its own network or VLAN, with filtering between them?"
msgstr "Les usages ont-ils chacun leur réseau ou VLAN, avec un filtrage entre eux ?"

msgid "Are the flows allowed between networks listed in the network flow matrix?"
msgstr "Les flux autorisés entre réseaux sont-ils listés dans la matrice des flux ?"

msgid "Single point of failure: power supply"
msgstr "Point de défaillance unique : alimentation électrique"

msgid "The server room or network closet depends on a single UPS, a single power feed or a single power supply per device."
msgstr "La salle serveurs ou le local réseau dépend d'un seul onduleur, d'une seule arrivée électrique ou d'une seule alimentation par équipement."

msgid "Total outage during a UPS failure or electrical work; equipment damaged by a sudden shutdown."
msgstr "Coupure générale lors d'une panne d'onduleur ou d'une intervention électrique ; matériel endommagé par un arrêt brutal."

msgid "Do critical devices have two power supplies, on two circuits?"
msgstr "Les équipements critiques ont-ils deux alimentations, sur deux circuits ?"

msgid "Is the UPS runtime tested and sufficient for a clean shutdown?"
msgstr "L'autonomie des onduleurs est-elle testée et suffisante pour un arrêt propre ?"

msgid "Single point of failure: hypervisor or shared storage"
msgstr "Point de défaillance unique : hyperviseur ou stockage partagé"

msgid "Several critical virtual servers rely on a single virtualization host or a single storage array."
msgstr "Plusieurs serveurs virtuels critiques reposent sur un seul hôte de virtualisation ou une seule baie de stockage."

msgid "Simultaneous outage of all hosted applications after a hardware failure or a failed update."
msgstr "Arrêt simultané de toutes les applications hébergées en cas de panne matérielle ou de mise à jour ratée."

msgid "Can a second host take over the critical virtual machines?"
msgstr "Un second hôte peut-il reprendre les machines virtuelles critiques ?"

msgid "Has the recovery time been measured during a test?"
msgstr "Le délai de reprise a-t-il été mesuré lors d'un test ?"

msgid "Single point of failure: carrier link"
msgstr "Point de défaillance unique : lien opérateur"

msgid "A site, or access to online services, depends on a single Internet link or a single carrier."
msgstr "Un site, ou l'accès aux services en ligne, dépend d'un seul lien Internet ou d'un seul opérateur."

msgid "Site cut off during an outage (works, carrier failure), telephony and hosted applications unavailable."
msgstr "Site isolé pendant une coupure (travaux, panne opérateur), téléphonie et applications hébergées inaccessibles."

msgid "Is there a second link, with another carrier and over another physical path?"
msgstr "Existe-t-il un second lien, chez un autre opérateur et par un autre chemin physique ?"

msgid "Has the failover been tested?"
msgstr "La bascule a-t-elle été testée ?"

msgid "Single point of failure: directory (domain controller)"
msgstr "Point de défaillance unique : annuaire (contrôleur de domaine)"

msgid "A site has only one domain controller, or the directory has only one server."
msgstr "Un site n'a qu'un seul contrôleur de domaine, ou l'annuaire n'a qu'un seul serveur."

msgid "No more logons or access to shares after a failure; long and tricky directory restore."
msgstr "Plus aucune connexion ni accès aux partages en cas de panne ; restauration longue et délicate de l'annuaire."

msgid "Does each site have at least two domain controllers, or reliable access to a second one?"
msgstr "Chaque site a-t-il au moins deux contrôleurs de domaine, ou un accès fiable à un second ?"

msgid "Has the directory restore ever been tested?"
msgstr "La restauration de l'annuaire a-t-elle déjà été testée ?"

msgid "Backups on the same site as the data"
msgstr "Sauvegardes sur le même site que les données"

msgid "Backups are stored in the same room, building or administration domain as the data they protect."
msgstr "Les sauvegardes sont stockées dans la même salle, le même bâtiment ou le même domaine d'administration que les données qu'elles protègent."

msgid "Simultaneous loss of data and backups in a fire, a flood or a ransomware attack that also encrypts the backups."
msgstr "Perte simultanée des données et des sauvegardes lors d'un incendie, d'un dégât des eaux ou d'un rançongiciel qui chiffre aussi les sauvegardes."

msgid "Is a copy kept off-site or offline, immutable?"
msgstr "Une copie est-elle conservée hors site ou hors ligne, non modifiable ?"

msgid "Is a full restore tested regularly?"
msgstr "Une restauration complète est-elle testée régulièrement ?"

msgid "Network diagram and address plan not kept up to date"
msgstr "Schéma réseau et plan d'adressage non tenus à jour"

msgid "The network diagram, the address plan and the list of flows no longer reflect reality."
msgstr "Le schéma réseau, le plan d'adressage et la liste des flux ne reflètent plus l'existant."

msgid "Decisions made on a wrong picture, longer incident diagnosis, forgotten devices outside any monitoring."
msgstr "Décisions prises sur une vision fausse, incident plus long à diagnostiquer, équipements oubliés hors de toute surveillance."

msgid "Is the date of the last diagram update known?"
msgstr "La date de la dernière mise à jour du schéma est-elle connue ?"

msgid "Is a periodic review of the diagram and flows scheduled?"
msgstr "Une revue périodique du schéma et des flux est-elle planifiée ?"

