msgstr "Ouvrir le registre des risques"

msgid "cause → consequence; click an item to open it"
msgstr "cause → conséquence ; cliquer sur un élément l'ouvre"

msgid "RTO (maximum downtime)"
msgstr "RTO (durée maximale d'interruption)"

msgid "RPO (maximum data loss)"
msgstr "RPO (perte de données maximale)"

