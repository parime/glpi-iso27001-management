msgstr "Scenariusz operacyjny uszczegóławia scenariusz strategiczny: najpierw wypełnij warsztat 3."

msgid "New operational scenario"
msgstr "Nowy scenariusz operacyjny"

msgid "e.g. Phishing of an administrator, then encryption of the servers"
msgstr "np. Phishing administratora, a następnie zaszyfrowanie serwerów"

msgid "Attack sequence"
msgstr "Przebieg ataku"

msgid "Know, get in, find, exploit: the main steps of the attack"
msgstr "Poznać, wejść, znaleźć, wykorzystać: główne etapy ataku"

msgid "Supporting asset targeted"
msgstr "Docelowy zasób wspierający"

msgid "Likelihood"
msgstr "Prawdopodobieństwo"

msgid "No operational scenario yet"
msgstr "Brak scenariuszy operacyjnych"

