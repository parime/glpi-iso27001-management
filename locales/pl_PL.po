msgstr "Klucz zapisany (pozostaw puste, aby go zachować)"

msgid "Encrypted with the GLPI key and never displayed again."
msgstr "Szyfrowany kluczem GLPI i nigdy więcej niewyświetlany."

msgid "Delete the saved key"
msgstr "Usuń zapisany klucz"

msgid "Test the key"
msgstr "Przetestuj klucz"

