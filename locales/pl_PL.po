msgstr "Nowy interesariusz"

msgid "e.g. Hosting provider (or choose a GLPI supplier)"
msgstr "np. Dostawca hostingu (lub wybierz dostawcę GLPI)"

msgid "GLPI supplier"
msgstr "Dostawca GLPI"

msgid "No stakeholder yet"
msgstr "Brak interesariuszy"

msgid "Think of your hosting provider, software vendors, IT service companies, key partners..."
msgstr "Pomyśl o dostawcy hostingu, producentach oprogramowania, firmach usług IT, kluczowych partnerach..."

msgid "Threat level = (dependence x penetration) / (maturity x trust)."
msgstr "Poziom zagrożenia = (zależność x penetracja) / (dojrzałość x zaufanie)."

msgid "Threat"
msgstr "Zagrożenie"

msgid "Remove this stakeholder and the scenarios that go through it?"
msgstr "Usunąć tego interesariusza i scenariusze przez niego przechodzące?"

msgid "Strategic scenarios"
msgstr "Scenariusze strategiczne"

msgid "A strategic scenario links a retained risk source to a feared event: fill in workshops 1 and 2 first."
msgstr "Scenariusz strategiczny łączy zachowane źródło ryzyka ze zdarzeniem niepożądanym: najpierw wypełnij warsztaty 1 i 2."

