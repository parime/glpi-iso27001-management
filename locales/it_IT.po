msgstr "Impatto peggiore dopo %s"

msgid "Items not meeting the objectives"
msgstr "Elementi che non rispettano gli obiettivi"

msgid "Consistency checks"
msgstr "Controlli di coerenza"

msgid "Dependencies"
msgstr "Dipendenze"

msgid "Choose an item to link."
msgstr "Scelga un elemento da collegare."

msgid "This item is already linked to the process."
msgstr "Questo elemento è già collegato al processo."

msgid "Business impact analysis"
msgstr "Analisi di impatto sul business (BIA)"

msgid "Financial"
msgstr "Finanziario"

msgid "Legal and regulatory"
msgstr "Legale e normativo"

msgid "Image and reputation"
msgstr "Immagine e reputazione"

msgid "Operational"
msgstr "Operativo"

