msgstr "Apri il registro dei rischi"

msgid "cause → consequence; click an item to open it"
msgstr "causa → conseguenza; fare clic su un elemento per aprirlo"

msgid "RTO (maximum downtime)"
msgstr "RTO (tempo massimo di interruzione)"

msgid "RPO (maximum data loss)"
