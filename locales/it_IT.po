msgstr "Immagine (PNG)"

msgid "Image (JPEG)"
msgstr "Immagine (JPEG)"

msgid "Vector image (SVG), sharp at any size"
msgstr "Immagine vettoriale (SVG), nitida a qualsiasi dimensione"

