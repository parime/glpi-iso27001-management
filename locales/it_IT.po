msgstr "Scaduta, non inclusa"

msgid "No file"
msgstr "Nessun file"

msgid "Size limit reached, not included"
msgstr "Limite di dimensione raggiunto, non inclusa"

msgid "This perimeter is not among your active entities."
msgstr "Questo perimetro non fa parte delle tue entità attive."

