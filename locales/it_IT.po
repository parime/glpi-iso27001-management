msgid ""
"Create one study per scope, then work through its workshops in order: "
"business values and feared events, risk sources, stakeholders and strategic "
"scenarios, then operational scenarios."
msgstr ""
"Create uno studio per ambito, poi seguite i workshop in ordine: valori di "
"business ed eventi temuti, fonti di rischio, parti interessate e scenari "
"strategici, quindi scenari operativi."

msgid "Remove this feared event and the scenarios built on it?"
msgstr "Rimuovere questo evento temuto e gli scenari basati su di esso?"

msgid "Remove this risk source and the scenarios built on it?"
msgstr "Rimuovere questa fonte di rischio e gli scenari basati su di essa?"

msgid "Danger zone"
msgstr "Zona di pericolo"

msgid "Act first: reduce the dependence or demand stronger guarantees."
msgstr "Agire per primi: ridurre la dipendenza o esigere garanzie più solide."

msgid "Control zone"
msgstr "Zona di controllo"

msgid "Check their security measures regularly."
msgstr "Controllare regolarmente le loro misure di sicurezza."

msgid "Watch zone"
msgstr "Zona di osservazione"

msgid "Keep an eye on them, no specific action needed."
msgstr "Da tenere sotto osservazione, nessuna azione specifica."

msgid "Dependence"
msgstr "Dipendenza"

msgid "How much you rely on them to operate"
msgstr "Quanto dipendete da loro per operare"

msgid "Penetration"
msgstr "Penetrazione"

msgid "How far they can access your systems and data"
msgstr "Fin dove possono accedere ai vostri sistemi e dati"

msgid "Cyber maturity"
msgstr "Maturità cyber"

msgid "How well they protect themselves"
msgstr "Quanto bene si proteggono"

msgid "Trust"
msgstr "Fiducia"

