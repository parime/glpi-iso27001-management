msgstr "Lista di distribuzione revisionata il"

msgid "Crisis communications"
msgstr "Comunicazioni di crisi"

#, php-format
msgid ""
"%d main recipient has no deputy: if they cannot be reached during a crisis, "
"nobody else is planned."
msgid_plural ""
"%d main recipients have no deputy: if they cannot be reached during a "
"crisis, nobody else is planned."
msgstr[0] ""
"%d destinatario principale non ha un sostituto: se non è raggiungibile "
"durante una crisi, non è previsto nessun altro."
msgstr[1] ""
"%d destinatari principali non hanno un sostituto: se non sono raggiungibili "
"durante una crisi, non è previsto nessun altro."

#, php-format
msgid "%d member without email"
msgid_plural "%d members without email"
msgstr[0] "%d membro senza e-mail"
msgstr[1] "%d membri senza e-mail"

#, php-format
