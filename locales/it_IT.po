msgstr "Correzione della configurazione: %1$s (%2$d regola/e non superata/e)"

msgid "OpenSCAP scans (XCCDF/ARF)"
msgstr "Scansioni OpenSCAP (XCCDF/ARF)"

msgid "No scan imported yet"
msgstr "Nessuna scansione ancora importata"

msgid "Import results"
msgstr "Importa risultati"

msgid "Average compliance: not measured"
msgstr "Conformità media: non misurata"

