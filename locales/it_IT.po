msgstr "%1$d macchine mostrate su %2$d macchine esposte."

#, php-format
msgid ""
"Exposure score from 0 to 100: the most severe vulnerability (10 if it is "
"actively exploited) counts for 70%, the number of priority vulnerabilities "
"for 30%. It is an order of treatment, not a standardised measure."
msgstr ""
"Punteggio di esposizione da 0 a 100: la vulnerabilità più grave (10 se "
"sfruttata attivamente) conta per il 70%, il numero di vulnerabilità "
"prioritarie per il 30%. È un ordine di trattamento, non una misura "
"standardizzata."

msgid "Subscribe"
msgstr "Iscriviti"

