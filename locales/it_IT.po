msgstr "scadenza %1$s, in ritardo di %2$d giorno/i"

#, php-format
msgid "deadline %s"
msgstr "scadenza %s"

#, php-format
msgid "oldest: %1$d days late, average %2$d"
msgstr "la più vecchia: %1$d giorni di ritardo, media %2$d"

msgid "overdue"
msgstr "superata"

#, php-format
msgid "previous period: %d %%"
msgstr "periodo precedente: %d %%"

#, php-format
msgid "waiver until %s"
msgstr "deroga fino al %s"

msgid "Theft of a laptop containing customer data"
msgstr "Furto di un portatile contenente dati dei clienti"

msgid "A laptop is stolen while travelling; its disk holds customer files."
msgstr ""
"Un portatile viene rubato durante un viaggio; il suo disco contiene file dei "
"clienti."

msgid "Disk encryption deployed on every laptop."
msgstr "Cifratura del disco distribuita su tutti i portatili."

msgid "Prolonged outage of the hosting provider"
msgstr "Interruzione prolungata del fornitore di hosting"

msgid "Penalties and recovery time written into the contract."
msgstr "Penali e tempi di ripristino inseriti nel contratto."

msgid "Targeted phishing of the accounting team"
msgstr "Phishing mirato al team contabilità"

msgid ""
"Header line without the \"reference\" and \"title\" columns: start from the "
"template."
msgstr ""
"Riga di intestazione senza le colonne \"reference\" e \"title\": partite dal "
"modello."

msgid ""
"Reference missing: each risk needs its own reference, so that a later import "
"updates it instead of creating a duplicate."
msgstr ""
"Riferimento mancante: ogni rischio deve avere un proprio riferimento, "
"affinché un'importazione successiva lo aggiorni invece di creare un "
"duplicato."

#, php-format
msgid "Reference longer than %d characters."
msgstr "Riferimento più lungo di %d caratteri."

#, php-format
msgid "Reference already used on line %s."
msgstr "Riferimento già usato alla riga %s."

#, php-format
msgid ""
"Owner not found: %s (expected: login, e-mail address or first and last name "
"of a GLPI user)."
msgstr ""
"Proprietario non trovato: %s (atteso: login, indirizzo e-mail o nome e "
"cognome di un utente GLPI)."

#, php-format
msgid "Several users match the owner %s: use their login or e-mail address."
msgstr ""
"Più utenti corrispondono al proprietario %s: usate il login o l'indirizzo e-"
"mail."

#, php-format
msgid ""
"Asset not found in GLPI: %s (expected: name or inventory number of an asset "
"you can see)."
msgstr ""
"Asset non trovato in GLPI: %s (atteso: nome o numero di inventario di un "
"asset che potete vedere)."

#, php-format
msgid "Several assets are named %s: use their inventory number."
msgstr "Più asset si chiamano %s: usate il numero di inventario."

#, php-format
msgid "Invalid review date: %s (expected: 31/12/2026 or 2026-12-31)."
msgstr "Data di revisione non valida: %s (atteso: 31/12/2026 o 2026-12-31)."

#, php-format
msgid "More than %s risks: the following lines were not read."
msgstr "Più di %s rischi: le righe seguenti non sono state lette."

#, php-format
msgid ""
"%s risks of the register already carry this reference: correct them in GLPI "
"first."
msgstr ""
"%s rischi del registro hanno già questo riferimento: correggeteli prima in "
"GLPI."

msgid ""
"A risk being mitigated or transferred cannot be closed without a treatment "
"plan: add its actions in GLPI first."
msgstr ""
"Un rischio in riduzione o trasferimento non può essere chiuso senza piano di "
"trattamento: aggiungete prima le sue azioni in GLPI."

msgid "You are not allowed to create risks."
msgstr "Non siete autorizzati a creare rischi."

msgid "You are not allowed to modify risks."
msgstr "Non siete autorizzati a modificare rischi."

#, php-format
msgid ""
"Unknown value for \"%1$s\": %2$s. Expected: %3$s, or a score within the "
"scale chosen below."
msgstr ""
"Valore sconosciuto per \"%1$s\": %2$s. Atteso: %3$s, o un punteggio nella "
"scala scelta qui sotto."

#, php-format
msgid "Unknown value for \"%1$s\": %2$s. Expected: %3$s."
msgstr "Valore sconosciuto per \"%1$s\": %2$s. Atteso: %3$s."

#, php-format
msgid "%1$s imports the risk register: %2$d risks added, %3$d updated."
msgstr ""
"%1$s importa il registro dei rischi: %2$d rischi aggiunti, %3$d aggiornati."

#, php-format
msgid "Import finished: %1$d risks added, %2$d updated, %3$d unchanged."
msgstr ""
"Importazione terminata: %1$d rischi aggiunti, %2$d aggiornati, %3$d "
"invariati."

