msgstr "[EXERCICE] %s"

msgid "This is a crisis exercise: no real incident is in progress."
msgstr "Ceci est un exercice de crise : aucun incident réel n'est en cours."

#, php-format
msgid "Target: %d min after the start of the exercise."
msgstr "Objectif : %d min après le début de l'exercice."

#, php-format
