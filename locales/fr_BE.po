msgstr "Sans date de fin"

msgid "Notice, law and data"
msgstr "Préavis, droit et données"

msgid "Required: critical or important function"
msgstr "Obligatoire : fonction critique ou importante"

#, php-format
msgid "Notice in the contract: %d month(s)."
msgstr "Préavis du contrat : %d mois."

msgid "Does the service store data, even temporarily?"
msgstr "Le service stocke-t-il des données, même temporairement ?"

msgid ""
"Countries: two-letter ISO codes separated by commas, for example FR, DE, IE. "
"Each country becomes a line of the register."
msgstr ""
"Pays : codes ISO à deux lettres séparés par des virgules, par exemple FR, "
"DE, IE. Chaque pays devient une ligne du registre."

msgid "Reliance, substitutability and exit"
msgstr "Dépendance, substituabilité et sortie"

