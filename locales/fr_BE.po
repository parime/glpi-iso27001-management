msgstr "Score : %s / 100"

msgid ""
"No source assessed for this asset yet: import or read the data of the "
"security modules to fill this view."
msgstr ""
"Aucune source évaluée pour cet actif pour l'instant : importez ou lisez les "
"données des modules de sécurité pour remplir cette vue."

#, php-format
msgid "%1$d sources assessed: %2$d critical, %3$d to watch."
msgstr "%1$d sources évaluées : %2$d critiques, %3$d à surveiller."

