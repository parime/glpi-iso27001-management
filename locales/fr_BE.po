msgstr "Principes d'architecture sécurisée"

msgid "Security clauses in the contract"
msgstr "Clauses de sécurité au contrat"

msgid "Security requirements of the application"
msgstr "Exigences de sécurité de l'application"

msgid "Separate access (accounts, rights)"
msgstr "Accès séparés (comptes, droits)"

msgid "Separate configuration (secrets, settings)"
msgstr "Configuration séparée (secrets, paramètres)"

msgid "Separate data (no production data outside production, or anonymised)"
