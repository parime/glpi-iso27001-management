msgid "%s ago"
msgstr "il y a %s"

msgid ""
"A server with an internal address requires an administrator to allow "
"internal addresses in the configuration page of the plugin."
msgstr ""
"Un serveur à adresse interne demande à un administrateur d'autoriser les "
"adresses internes dans la page de configuration du plugin."

msgid ""
"Acronis Cyber Protect: Devices, export the list (columns Name, Last backup, "
"Status)."
msgstr ""
"Acronis Cyber Protect : Terminaux, exportez la liste (colonnes Name, Last "
"backup, Status)."

msgid "Address of the Veeam server"
msgstr "Adresse du serveur Veeam"

msgid "Assets concerned with a recent backup"
msgstr "Actifs concernés avec une sauvegarde récente"

msgid "Assets that must be backed up"
msgstr "Actifs qui doivent être sauvegardés"

