msgid ""
"Empty: the number of the contract in GLPI. It must stay the same over time."
msgstr ""
"Vide : le numéro du contrat dans GLPI. Il doit rester le même dans le temps."

msgid "Only for a subsequent or associated arrangement."
msgstr "Seulement pour un accord ultérieur ou associé."

#, php-format
