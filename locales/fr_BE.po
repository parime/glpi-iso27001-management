msgid ""
"Chains of causes and consequences between risks, supplier risks and security "
"incidents. Links are created from the \"Domino effect\" tab of each one. "
"This is a representation: no probability is computed."
msgstr ""
"Chaînes de causes et de conséquences entre risques, risques fournisseurs et "
"incidents de sécurité. Les liens se créent depuis l'onglet « Effet domino » "
"de chacun. C'est une représentation : aucune probabilité n'est calculée."

msgid "No link yet."
msgstr "Aucun lien pour l'instant."

msgid "Open the risk register"
msgstr "Ouvrir le registre des risques"

msgid "cause → consequence; click an item to open it"
msgstr "cause → conséquence ; cliquer sur un élément l'ouvre"

msgid "RTO (maximum downtime)"
msgstr "RTO (durée maximale d'interruption)"

msgid "RPO (maximum data loss)"
msgstr "RPO (perte de données maximale)"

msgid "1 hour"
msgstr "1 heure"

msgid "4 hours"
msgstr "4 heures"

