msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Initial score"
msgstr "Pontuação inicial"

msgid "Residual score"
msgstr "Pontuação residual"

msgid "Score before and after treatment"
msgstr "Pontuação antes e depois do tratamento"

msgid "%1$d x %2$d"
msgstr "%1$d x %2$d"

msgid "%1$d x %2$d: %1$d levels of probability, %2$d levels of impact"
msgstr "%1$d x %2$d: %1$d níveis de probabilidade, %2$d níveis de impacto"

msgid "Probability and impact can each have from 3 to 5 levels, independently, for example 3 levels of probability and 5 levels of impact. The colours of the new grid are proposed from the score (probability rank x impact rank) and can be adjusted afterwards."
msgstr "A probabilidade e o impacto podem ter, cada um, de 3 a 5 níveis, de forma independente, por exemplo 3 níveis de probabilidade e 5 níveis de impacto. As cores da nova matriz são propostas a partir da pontuação (posição da probabilidade x posição do impacto) e podem ser ajustadas depois."

msgid "Score = probability rank x impact rank, before the treatment (initial) and after it (residual)."
msgstr "Pontuação = posição da probabilidade x posição do impacto, antes do tratamento (inicial) e depois (residual)."

msgid "The plugin matrix has %1$d levels of probability and %2$d levels of impact: a score on another scale is converted (the lowest and highest scores match)."
msgstr "A matriz do plugin tem %1$d níveis de probabilidade e %2$d níveis de impacto: uma nota em outra escala é convertida (as notas mais baixa e mais alta se correspondem)."
