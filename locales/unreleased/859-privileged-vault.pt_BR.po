msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#, php-format
msgid "%1$d lines: the first %2$d are shown, gaps first."
msgstr "%1$d linhas: as %2$d primeiras são exibidas, desvios primeiro."

#, php-format
msgid "%d line(s) imported."
msgstr "%d linha(s) importada(s)."

#, php-format
msgid "%d member(s) read from Bitwarden."
msgstr "%d membro(s) lido(s) do Bitwarden."

msgid "A password of a shared or privileged account kept in the vault that has not been changed for longer is reported on the privileged accounts page and in the access reviews."
msgstr "Uma senha de conta compartilhada ou privilegiada guardada no cofre e não alterada há mais tempo é sinalizada na página de contas privilegiadas e nas revisões de acesso."

msgid "A self-hosted server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration."
msgstr "Um servidor auto-hospedado em um endereço interno (rede privada) é recusado por padrão: um administrador pode permitir endereços internos na configuração do plugin."

msgid "Access refused by Bitwarden: the organization API is available on the Teams and Enterprise plans."
msgstr "Acesso recusado pelo Bitwarden: a API da organização está disponível nos planos Teams e Enterprise."

msgid "Address of the self-hosted server"
msgstr "Endereço do servidor auto-hospedado"

msgid "Admin Console > Settings > Organization info > API key: view the key (owner only) and copy the client ID and the client secret here. The organization API exists on the Teams and Enterprise plans."
msgstr "Console de administração > Configurações > Informações da organização > Chave de API: exiba a chave (somente o proprietário) e copie aqui o ID e o segredo do cliente. A API da organização existe nos planos Teams e Enterprise."

#, php-format
msgid "Administrators: %1$d, without two-step login: %2$d"
msgstr "Administradores: %1$d, sem login em duas etapas: %2$d"

msgid "Bitwarden asks to slow down: try again in a few minutes."
msgstr "O Bitwarden pede para ir mais devagar: tente novamente em alguns minutos."

msgid "Bitwarden cloud (European Union)"
msgstr "Nuvem Bitwarden (União Europeia)"

msgid "Bitwarden cloud (United States)"
msgstr "Nuvem Bitwarden (Estados Unidos)"

msgid "Bitwarden could not be reached: check the network access or the GLPI proxy."
msgstr "Não foi possível acessar o Bitwarden: verifique o acesso à rede ou o proxy do GLPI."

msgid "Bitwarden or Vaultwarden"
msgstr "Bitwarden ou Vaultwarden"

msgid "Bitwarden or Vaultwarden: produce the file with the Bitwarden command line (bw list items and bw list org-members) and keep only these columns, without the passwords."
msgstr "Bitwarden ou Vaultwarden: gere o arquivo com a linha de comando do Bitwarden (bw list items e bw list org-members) e mantenha apenas estas colunas, sem as senhas."

msgid "Bitwarden refused the client ID or the client secret of the organization API key."
msgstr "O Bitwarden recusou o ID ou o segredo do cliente da chave de API da organização."

msgid "Bitwarden returned an unexpected answer."
msgstr "O Bitwarden retornou uma resposta inesperada."

msgid "Bitwarden settings saved."
msgstr "Configurações do Bitwarden salvas."

msgid "Client ID"
msgstr "ID do cliente"

msgid "Collections"
msgstr "Coleções"

msgid "Connection to Bitwarden (read only)"
msgstr "Conexão com o Bitwarden (somente leitura)"

msgid "Connection to Bitwarden succeeded."
msgstr "Conexão com o Bitwarden bem-sucedida."

msgid "Custom role"
msgstr "Função personalizada"

msgid "Date of the last change unknown"
msgstr "Data da última alteração desconhecida"

msgid "Enabled administrator accounts read on the server management controllers (iLO, iDRAC, XClarity, IPMI). An account is found in the vault when an item has the same login name and cites the controller (name, host or IP address)."
msgstr "Contas de administração ativas lidas nos controladores de gerenciamento de servidores (iLO, iDRAC, XClarity, IPMI). Uma conta está no cofre quando um item tem o mesmo nome de login e cita o controlador (nome, host ou endereço IP)."

msgid "Enter the server, the client ID (organization.…) and the client secret of the organization API key first."
msgstr "Informe primeiro o servidor, o ID do cliente (organization.…) e o segredo do cliente da chave de API da organização."

msgid "Expected change delay (months)"
msgstr "Prazo de alteração esperado (meses)"

#, php-format
msgid "Expected change delay: %d months"
msgstr "Prazo de alteração esperado: %d meses"

msgid "GLPI reads the members of your Bitwarden organization from the privileged accounts page, on request: email address, role, status, two-step login and accessible collections. Never an item, a password or a note."
msgstr "O GLPI lê os membros da sua organização Bitwarden a partir da página de contas privilegiadas, sob demanda: endereço de e-mail, função, status, login em duas etapas e coleções acessíveis. Nunca um item, uma senha ou uma nota."

msgid "How often must shared passwords be changed?"
msgstr "Com que frequência as senhas compartilhadas devem ser alteradas?"

msgid "How to prepare Bitwarden:"
msgstr "Como preparar o Bitwarden:"

msgid "ISO/IEC 27001, controls A.5.17 and A.8.2"
msgstr "ISO/IEC 27001, controles A.5.17 e A.8.2"

msgid "Import a CSV file with a header, one line per item or per member. A new import of the same source and the same kind replaces the previous one in the current entity."
msgstr "Importe um arquivo CSV com cabeçalho, uma linha por item ou por membro. Uma nova importação da mesma origem e do mesmo tipo substitui a anterior na entidade atual."

msgid "Import the items and the members of the vault (or read the members from Bitwarden), then follow up the gaps: password not changed within the expected delay, access of a person who left, member unknown in GLPI, vault administrator without two-step login, server controller administrator account missing from the vault. Nothing is changed automatically. The gaps are also shown in the access review campaigns."
msgstr "Importe os itens e os membros do cofre (ou leia os membros do Bitwarden) e depois trate os desvios: senha não alterada no prazo esperado, acesso de uma pessoa que saiu, membro desconhecido no GLPI, administrador do cofre sem login em duas etapas, conta de administração de um controlador de servidor ausente do cofre. Nada é alterado automaticamente. Os desvios também aparecem nas campanhas de revisão de acesso."

msgid "Import the vault metadata"
msgstr "Importar os metadados do cofre"

msgid "Invited"
msgstr "Convidado"

#, php-format
msgid "Items still reachable by them: %d"
msgstr "Itens ainda ao seu alcance: %d"

msgid "Items: name; optional id, collections, username, uri, passwordRevisionDate (or revisionDate, last_changed) and holders (email addresses separated by commas)."
msgstr "Itens: name; opcionais id, collections, username, uri, passwordRevisionDate (ou revisionDate, last_changed) e holders (endereços de e-mail separados por vírgulas)."

msgid "Last change"
msgstr "Última alteração"

msgid "Login name"
msgstr "Nome de login"

msgid "Members are matched with GLPI accounts on the email address, the login, or the part of the address before the @. A person who left is a GLPI account disabled or deleted, or with a past departure date."
msgstr "Os membros são associados às contas do GLPI pelo endereço de e-mail, pelo login ou pela parte do endereço antes do @. Uma pessoa que saiu é uma conta do GLPI desativada ou excluída, ou com uma data de saída passada."

msgid "Members of the vault"
msgstr "Membros do cofre"

msgid "Members to review"
msgstr "Membros a revisar"

msgid "Members unknown in GLPI"
msgstr "Membros desconhecidos no GLPI"

msgid "Members: email; optional name, type or role (owner, admin, user, custom), status (active, invited, revoked), collections and twoFactorEnabled (yes/no)."
msgstr "Membros: email; opcionais name, type ou role (owner, admin, user, custom), status (active, invited, revoked), collections e twoFactorEnabled (sim/não)."

msgid "No administrator account missing from the vault."
msgstr "Nenhuma conta de administração ausente do cofre."

msgid "No email column found: the file of the members needs a column such as email."
msgstr "Nenhuma coluna de e-mail encontrada: o arquivo de membros precisa de uma coluna como email."

msgid "No item imported yet: import the items of the vault below."
msgstr "Nenhum item importado ainda: importe os itens do cofre abaixo."

msgid "No item name column found: the file needs a header with a column such as name."
msgstr "Nenhuma coluna de nome encontrada: o arquivo precisa de um cabeçalho com uma coluna como name."

msgid "No member imported yet: import the members of the vault or read them from Bitwarden below."
msgstr "Nenhum membro importado ainda: importe os membros do cofre ou leia-os do Bitwarden abaixo."

msgid "No member with a gap."
msgstr "Nenhum membro com desvio."

msgid "No shared account with a gap."
msgstr "Nenhuma conta compartilhada com desvio."

#, php-format
msgid "Not changed for more than %1$d months: %2$d"
msgstr "Não alterados há mais de %1$d meses: %2$d"

msgid "Not changed within the expected delay"
msgstr "Não alterado no prazo esperado"

msgid "Not known"
msgstr "Desconhecido"

msgid "Not saved: the client ID must start with organization. followed by an identifier, and the address of a self-hosted server must start with https:// (or http:// when internal addresses are allowed), without user name, password or parameters."
msgstr "Não salvo: o ID do cliente deve começar com organization. seguido de um identificador e o endereço de um servidor auto-hospedado deve começar com https:// (ou http:// quando endereços internos são permitidos), sem nome de usuário, senha nem parâmetros."

msgid "Nothing is changed in the vault nor in GLPI from this page: change the passwords and remove the accesses in the vault itself."
msgstr "Nada é alterado no cofre nem no GLPI a partir desta página: altere as senhas e remova os acessos no próprio cofre."

msgid "Only for a self-hosted server: GLPI calls its /identity and /api paths."
msgstr "Somente para um servidor auto-hospedado: o GLPI chama seus caminhos /identity e /api."

msgid "Only metadata is imported: names, collections, login names, addresses, dates and members. A file with a password, code, note or custom field column is refused as a whole. Nothing is ever written in the vault."
msgstr "Apenas metadados são importados: nomes, coleções, nomes de login, endereços, datas e membros. Um arquivo com uma coluna de senha, código, nota ou campo personalizado é recusado por inteiro. Nada é jamais escrito no cofre."

msgid "Other password vault"
msgstr "Outro cofre de senhas"

msgid "People who left with an access"
msgstr "Pessoas que saíram com um acesso"

#, php-format
msgid "People who left with an access: %d"
msgstr "Pessoas que saíram com um acesso: %d"

msgid "Person who left"
msgstr "Pessoa que saiu"

msgid "Privileged access management (PAM) solution"
msgstr "Solução de gestão de acessos privilegiados (PAM)"

msgid "Privileged access management (PAM) solution: export the accounts list or the safes members report without the passwords."
msgstr "Solução de gestão de acessos privilegiados (PAM): exporte a lista de contas ou o relatório de membros dos cofres sem as senhas."

#, php-format
msgid "Privileged accesses to review in the password vault: people who left, members unknown in GLPI, administrators without two-step login, passwords not changed for more than %d months. Remove the accesses and change the passwords in the vault itself."
msgstr "Acessos privilegiados a revisar no cofre de senhas: pessoas que saíram, membros desconhecidos no GLPI, administradores sem login em duas etapas, senhas não alteradas há mais de %d meses. Remova os acessos e altere as senhas no próprio cofre."

msgid "Privileged accounts and password vault"
msgstr "Contas privilegiadas e cofre de senhas"

msgid "Read now from Bitwarden"
msgstr "Ler agora do Bitwarden"

msgid "Read the members from Bitwarden"
msgstr "Ler os membros do Bitwarden"

msgid "Self-hosted Bitwarden server"
msgstr "Servidor Bitwarden auto-hospedado"

#, php-format
msgid "Server controller accounts missing from the vault: %d"
msgstr "Contas de controladores de servidores ausentes do cofre: %d"

msgid "Server controller administrator accounts missing from the vault"
msgstr "Contas de administração de controladores de servidores ausentes do cofre"

msgid "Shared accounts in the vault"
msgstr "Contas compartilhadas no cofre"

msgid "Shared accounts to review"
msgstr "Contas compartilhadas a revisar"

msgid "Shared and privileged accounts in the vault"
msgstr "Contas compartilhadas e privilegiadas no cofre"

msgid "Shared passwords not changed within the expected delay"
msgstr "Senhas compartilhadas não alteradas no prazo esperado"

msgid "Shows the shared and privileged accounts kept in your password vault (Bitwarden, Vaultwarden or a privileged access management solution) and who can reach them: when each password was last changed, the members of the vault and their role. Only metadata is read, never a password."
msgstr "Mostra as contas compartilhadas e privilegiadas guardadas no seu cofre de senhas (Bitwarden, Vaultwarden ou uma solução de gestão de acessos privilegiados) e quem pode acessá-las: última alteração de cada senha, membros do cofre e sua função. Apenas metadados são lidos, nunca uma senha."

msgid "Still reachable by a person who left"
msgstr "Ainda acessível a uma pessoa que saiu"

msgid "The Bitwarden API was not found at this address: check the server address (Vaultwarden does not provide this API, import a CSV file instead)."
msgstr "A API do Bitwarden não foi encontrada neste endereço: verifique o endereço do servidor (o Vaultwarden não oferece esta API, importe um arquivo CSV em vez disso)."

#, php-format
msgid "The file was refused because the column \"%s\" may contain secrets. Remove the passwords, codes, notes and custom fields from the export, then import it again. Nothing was imported."
msgstr "O arquivo foi recusado porque a coluna \"%s\" pode conter segredos. Remova da exportação as senhas, códigos, notas e campos personalizados e importe-o novamente. Nada foi importado."

msgid "The secret is encrypted with the GLPI key, never displayed again nor logged. GLPI only asks for a token and reads the list of the members."
msgstr "O segredo é cifrado com a chave do GLPI, nunca mais exibido nem registrado. O GLPI apenas solicita um token e lê a lista de membros."

msgid "The server and the API key are entered in the plugin configuration, Connectors tab."
msgstr "O servidor e a chave de API são informados na configuração do plugin, aba Conectores."

msgid "The server is on an internal address: an administrator must allow internal addresses in the plugin configuration (Outgoing connections)."
msgstr "O servidor está em um endereço interno: um administrador deve permitir endereços internos na configuração do plugin (Conexões de saída)."

msgid "Two-step login"
msgstr "Login em duas etapas"

msgid "Unknown in GLPI"
msgstr "Desconhecido no GLPI"

msgid "Vault administrator without two-step login"
msgstr "Administrador do cofre sem login em duas etapas"

#, php-format
msgid "Vault administrators without two-step login: %d"
msgstr "Administradores do cofre sem login em duas etapas: %d"

msgid "Vault items (shared accounts)"
msgstr "Itens do cofre (contas compartilhadas)"

msgid "Vault members (who has access)"
msgstr "Membros do cofre (quem tem acesso)"

msgid "Vaultwarden does not provide this API: import the CSV files of the members and of the items on the page instead."
msgstr "O Vaultwarden não oferece esta API: importe em vez disso os arquivos CSV dos membros e dos itens na página."

msgid "View all the privileged accounts"
msgstr "Ver todas as contas privilegiadas"

msgid "Who has access"
msgstr "Quem tem acesso"

msgid "With the organization API key of Bitwarden (Teams and Enterprise plans), GLPI reads the members, their role, their two-step login and their collections when you click the button. The result replaces the Bitwarden members import of the current entity. The items are not exposed by this API: import them as a CSV file."
msgstr "Com a chave de API da organização do Bitwarden (planos Teams e Enterprise), o GLPI lê os membros, sua função, seu login em duas etapas e suas coleções quando você clica no botão. O resultado substitui a importação de membros do Bitwarden da entidade atual. Os itens não são expostos por esta API: importe-os como arquivo CSV."

#, php-format
msgid "%d shared account in the vault"
msgid_plural "%d shared accounts in the vault"
msgstr[0] "%d conta compartilhada no cofre"
msgstr[1] "%d contas compartilhadas no cofre"
