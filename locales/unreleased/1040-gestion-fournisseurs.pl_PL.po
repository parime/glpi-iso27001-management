msgid "Supplier security"
msgstr "Bezpieczeństwo dostawców"

msgid "Assess the security of your suppliers and service providers: the supplier risks, the security questionnaires they answer and, when DORA applies, the register of information."
msgstr "Oceniaj bezpieczeństwo swoich dostawców i usługodawców: ryzyka dostawców, kwestionariusze bezpieczeństwa, na które odpowiadają, oraz, jeśli ma zastosowanie DORA, rejestr informacji."

msgid "Assess this supplier"
msgstr "Oceń tego dostawcę"

msgid "Last evaluation"
msgstr "Ostatnia ocena"

msgid "Next reassessment: %s"
msgstr "Następna ponowna ocena: %s"

msgid "No evaluation yet"
msgstr "Brak oceny"

msgid "No reassessment date planned"
msgstr "Nie zaplanowano daty ponownej oceny"

msgid "Reassessment overdue since %s"
msgstr "Ponowna ocena zaległa od %s"

msgid "Supplier risk register"
msgstr "Rejestr ryzyk dostawców"

msgid "The security assessment of this supplier: its supplier risks, their level, the last questionnaire it answered and the next reassessment. The full register is in Management > Supplier security."
msgstr "Ocena bezpieczeństwa tego dostawcy: jego ryzyka dostawcy, ich poziom, ostatni kwestionariusz, na który odpowiedział, i następna ponowna ocena. Pełny rejestr znajduje się w Zarządzanie > Bezpieczeństwo dostawców."

msgid "This supplier has not been assessed yet: no supplier risk is recorded for it in your entities."
msgstr "Ten dostawca nie został jeszcze oceniony: w Twoich jednostkach nie zarejestrowano dla niego żadnego ryzyka dostawcy."

msgid "%d questionnaire"
msgid_plural "%d questionnaires"
msgstr[0] "%d kwestionariusz"
msgstr[1] "%d kwestionariusze"
msgstr[2] "%d kwestionariuszy"
