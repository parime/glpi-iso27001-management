"Content-Type: text/plain; charset=UTF-8\n"

msgid "GitHub cannot be reached from the GLPI server (no Internet access, proxy or firewall)"
msgstr "No se puede acceder a GitHub desde el servidor GLPI (sin acceso a Internet, proxy o cortafuegos)"

msgid "the GitHub request limit is reached, a new attempt will be made within an hour"
msgstr "se ha alcanzado el límite de solicitudes de GitHub, se hará un nuevo intento dentro de una hora"

msgid "GitHub did not answer within 3 seconds"
msgstr "GitHub no respondió en 3 segundos"

msgid "no release is published on GitHub yet"
msgstr "todavía no hay ninguna versión publicada en GitHub"

msgid "the answer from GitHub could not be read"
msgstr "no se pudo leer la respuesta de GitHub"

msgid "Latest release on GitHub"
msgstr "Última versión en GitHub"

#, php-format
msgid "Update available: %s"
msgstr "Actualización disponible: %s"

msgid "Latest version unknown"
msgstr "Última versión desconocida"

msgid "Release notes"
msgstr "Notas de la versión"

msgid "Download the archive"
msgstr "Descargar el archivo"

#, php-format
msgid "Last check failed: %s."
msgstr "La última verificación falló: %s."

#, php-format
msgid "Result of the last successful check (%s) shown."
msgstr "Se muestra el resultado de la última verificación correcta (%s)."

#, php-format
msgid "Reason: %s."
msgstr "Motivo: %s."

#, php-format
msgid "Last successful check: %s."
msgstr "Última verificación correcta: %s."

msgid "No successful check yet."
msgstr "Todavía no hay ninguna verificación correcta."

msgid "See the releases on GitHub"
msgstr "Ver las versiones en GitHub"

#, php-format
msgid "Last checked: %s (checked again every 12 hours)."
msgstr "Última verificación: %s (se verifica de nuevo cada 12 horas)."

msgid "the check follows the GLPI automatic action \"checkupdate\", which is turned off (Setup > Automatic actions)"
msgstr "la comprobación sigue la acción automática «checkupdate» de GLPI, que está desactivada (Configuración > Acciones automáticas)"
