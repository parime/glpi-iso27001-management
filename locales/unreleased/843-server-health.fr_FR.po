msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Power supplies"
msgstr "Alimentations"

msgid "Disks"
msgstr "Disques"

msgid "Fans"
msgstr "Ventilateurs"

msgid "Temperatures"
msgstr "Températures"

msgid "Server health"
msgstr "Santé du serveur"

msgid "%d critical"
msgstr "%d critique(s)"

msgid "%d warning"
msgstr "%d avertissement(s)"

msgid "No health detail read yet: click \"Read now\" on the controller page, or enable the scheduled reading. Controllers imported by CSV have no health detail."
msgstr "Aucun détail de santé lu pour l'instant : cliquez sur « Lire maintenant » sur la page des contrôleurs, ou activez la lecture planifiée. Les contrôleurs importés par CSV n'ont pas de détail de santé."

msgid "Recent events of the controller log"
msgstr "Événements récents du journal du contrôleur"

msgid "No event in the log read on the controller."
msgstr "Aucun événement dans le journal lu sur le contrôleur."

msgid "Server management controllers: reads inventory, gaps, accounts and health by Redfish (read only)"
msgstr "Contrôleurs de gestion des serveurs : lit l'inventaire, les écarts, les comptes et la santé par Redfish (lecture seule)"

msgid "Scheduled reading: the automatic action \"bmcread\" reads every Redfish controller once a day (same read-only requests as \"Read now\", health and event log included). It is disabled after installation."
msgstr "Lecture planifiée : l'action automatique « bmcread » lit chaque contrôleur Redfish une fois par jour (mêmes requêtes en lecture seule que « Lire maintenant », santé et journal compris). Elle est désactivée après l'installation."

msgid "Set the automatic action"
msgstr "Régler l'action automatique"

msgid "%d component(s) in critical state"
msgstr "%d composant(s) en état critique"

msgid "%d component(s) with a warning"
msgstr "%d composant(s) en avertissement"

msgid "%1$d alert(s) in the controller log over the last %2$d days"
msgstr "%1$d alerte(s) dans le journal du contrôleur sur les %2$d derniers jours"

msgid "A component or a recent event of the server is critical."
msgstr "Un composant ou un événement récent du serveur est critique."

msgid "A component or a recent event of the server needs attention."
msgstr "Un composant ou un événement récent du serveur demande de l'attention."

msgid "Power supplies, disks, fans and temperatures read as healthy."
msgstr "Alimentations, disques, ventilateurs et températures lus en bon état."
