msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "These settings are now in Setup > Plugins > GRC Manager, %s tab."
msgstr "Te ustawienia znajdują się teraz w Konfiguracja > Wtyczki > GRC Manager, karta %s."

msgid "Connection to Zabbix %s succeeded."
msgstr "Połączenie z Zabbix %s powiodło się."

msgid "Connection to Uptime Kuma succeeded."
msgstr "Połączenie z Uptime Kuma powiodło się."

msgid "Connection to Veeam succeeded."
msgstr "Połączenie z Veeam powiodło się."

msgid "The DNS server answers the DNSSEC questions."
msgstr "Serwer DNS odpowiada na zapytania DNSSEC."

msgid "The DNS server did not answer the DNSSEC question: DNSSEC will show \"Unknown\". Enter another DNS server."
msgstr "Serwer DNS nie odpowiedział na zapytanie DNSSEC: DNSSEC pokaże „Nieznany”. Wprowadź inny serwer DNS."

msgid "See the results"
msgstr "Zobacz wyniki"

msgid "Set up the connection"
msgstr "Skonfiguruj połączenie"

msgid "Change the settings"
msgstr "Zmień ustawienia"

msgid "Read automatically every day"
msgstr "Odczyt automatyczny codziennie"

msgid "Read automatically every hour"
msgstr "Odczyt automatyczny co godzinę"

msgid "Read on click only"
msgstr "Odczyt tylko po kliknięciu"

msgid "Nothing has been read from Zabbix yet: set up the connection in the configuration, then click \"Read now\". Until then, every asset concerned is shown as not monitored."
msgstr "Z Zabbix nic jeszcze nie odczytano: skonfiguruj połączenie w konfiguracji, a następnie kliknij „Odczytaj teraz”. Do tego czasu każdy objęty zasób jest pokazywany jako niemonitorowany."

msgid "Nothing has been read from Uptime Kuma yet: set up the connection in the configuration, then click \"Read now\"."
msgstr "Z Uptime Kuma nic jeszcze nie odczytano: skonfiguruj połączenie w konfiguracji, a następnie kliknij „Odczytaj teraz”."
