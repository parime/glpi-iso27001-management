msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "%d more not shown: they appear once these are reviewed."
msgstr "%d więcej niewyświetlonych: pojawią się po przejrzeniu tych."

msgid "%d proposal(s) rejected: they will no longer be proposed."
msgstr "Odrzucone propozycje: %d. Nie będą już proponowane."

msgid "%d proposed link(s) accepted."
msgstr "Zaakceptowane proponowane powiązania: %d."

msgid "Accept the checked proposals"
msgstr "Zaakceptuj zaznaczone propozycje"

msgid "Catalogue not read yet: use \"Update now\"."
msgstr "Katalog jeszcze nieodczytany: użyj „Aktualizuj teraz”."

msgid "Catalogue read on %s (once a week, with \"Update now\" or the daily task)."
msgstr "Katalog odczytany %s (raz w tygodniu, przyciskiem „Aktualizuj teraz” lub zadaniem dziennym)."

msgid "For the names not linked yet, the endoflife.date catalogue (product names, aliases, CPE and package identifiers) gives a likely product. Nothing is applied until you accept it: check the proposals that are right, then accept them; reject the wrong ones so they are no longer proposed."
msgstr "Dla nazw jeszcze niepowiązanych katalog endoflife.date (nazwy produktów, aliasy, identyfikatory CPE i pakietów) podaje prawdopodobny produkt. Nic nie jest stosowane bez Twojej zgody: zaznacz trafne propozycje i zaakceptuj je; odrzuć błędne, aby nie były już proponowane."

msgid "Name or alias of the product"
msgstr "Nazwa lub alias produktu"

msgid "No proposal: every name found in the catalogue is already linked or reviewed."
msgstr "Brak propozycji: każda nazwa znaleziona w katalogu jest już powiązana lub przejrzana."

msgid "Package identifier (purl)"
msgstr "Identyfikator pakietu (purl)"

msgid "Product catalogue not read (%s): the proposals use the previous one."
msgstr "Katalog produktów nieodczytany (%s): propozycje korzystają z poprzedniego."

msgid "Product catalogue updated: links are proposed for the names not linked yet."
msgstr "Katalog produktów zaktualizowany: zaproponowano powiązania dla nazw jeszcze niepowiązanych."

msgid "Product for %s"
msgstr "Produkt dla %s"

msgid "Proposed links, to review"
msgstr "Proponowane powiązania do przejrzenia"

msgid "Proposed product"
msgstr "Proponowany produkt"

msgid "Reject the checked proposals"
msgstr "Odrzuć zaznaczone propozycje"

msgid "Select the proposal for %s"
msgstr "Zaznacz propozycję dla %s"

msgid "Select"
msgstr "Zaznacz"
