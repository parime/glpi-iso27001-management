msgid "%d decision(s) pre-filled: check each one, then click \"Save decisions\". Nothing is saved until then."
msgstr "%d décision(s) pré-remplie(s) : vérifiez chacune, puis cliquez sur « Enregistrer les décisions ». Rien n'est enregistré avant."

msgid "Suggested by the rules:"
msgstr "Proposé par les règles :"

msgid "Pre-fill with the suggestions"
msgstr "Reporter les suggestions"

msgid "Ticks \"Access approved\" or \"To remove\" on the accounts still to review that have a suggestion. Accounts to examine are left for you to decide."
msgstr "Coche « Accès validés » ou « À retirer » sur les comptes encore à revoir qui ont une suggestion. Les comptes à examiner vous sont laissés."

msgid "Pre-filled from the suggestion, not saved yet"
msgstr "Pré-rempli d'après la suggestion, pas encore enregistré"

msgid "Examine staff compliance gaps"
msgstr "Examiner les écarts de conformité du personnel"

msgid "From the staff compliance page: mandatory training overdue or expired, IT charter not signed, security policy not acknowledged, once the deadline has passed."
msgstr "D'après la page de conformité du personnel : formation obligatoire en retard ou expirée, charte informatique non signée, politique de sécurité non lue, une fois le délai dépassé."

msgid "Staff compliance: mandatory training not completed in time (%s)"
msgstr "Conformité du personnel : formation obligatoire non suivie dans le délai (%s)"

msgid "Staff compliance: mandatory training expired (%s)"
msgstr "Conformité du personnel : formation obligatoire expirée (%s)"

msgid "Staff compliance: IT charter sent but not signed (%s)"
msgstr "Conformité du personnel : charte informatique envoyée mais non signée (%s)"

msgid "Staff compliance: security policies not acknowledged (%s)"
msgstr "Conformité du personnel : politiques de sécurité non lues (%s)"

msgid "Staff compliance gap"
msgstr "Écart de conformité du personnel"
