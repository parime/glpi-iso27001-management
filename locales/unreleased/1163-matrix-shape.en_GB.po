msgid "%1$d x %2$d"
msgstr "%1$d x %2$d"

msgid "%1$d x %2$d: %1$d levels of probability, %2$d levels of impact"
msgstr "%1$d x %2$d: %1$d levels of probability, %2$d levels of impact"

msgid "Probability and impact can each have from 3 to 5 levels, independently, for example 3 levels of probability and 5 levels of impact. The colours of the new grid are proposed from the score (probability rank x impact rank) and can be adjusted afterwards."
msgstr "Probability and impact can each have from 3 to 5 levels, independently, for example 3 levels of probability and 5 levels of impact. The colours of the new grid are proposed from the score (probability rank x impact rank) and can be adjusted afterwards."

msgid "Score = probability rank x impact rank, before the treatment (initial) and after it (residual)."
msgstr "Score = probability rank x impact rank, before the treatment (initial) and after it (residual)."

msgid "The plugin matrix has %1$d levels of probability and %2$d levels of impact: a score on another scale is converted (the lowest and highest scores match)."
msgstr "The plugin matrix has %1$d levels of probability and %2$d levels of impact: a score on another scale is converted (the lowest and highest scores match)."
