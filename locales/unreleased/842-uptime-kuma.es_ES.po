msgstr "Anunciar a los usuarios"

msgid "Assets published on the Internet without a monitor (Uptime Kuma)"
msgstr "Activos publicados en Internet sin monitor (Uptime Kuma)"

msgid "Assets published on the Internet without a monitor"
msgstr "Activos publicados en Internet sin monitor"

msgid "Assets that receive an \"Internet publication\" flow in the network flow matrix, but that no Uptime Kuma monitor watches: an outage would only be noticed by the users."
msgstr "Activos que reciben un flujo «Publicación en Internet» en la matriz de flujos, pero que ningún monitor de Uptime Kuma vigila: una caída solo la notarían los usuarios."

#, php-format
msgid "Availability of the exposed services (%) (Uptime Kuma)"
msgstr "Disponibilidad de los servicios expuestos (%) (Uptime Kuma)"

