msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#, php-format
msgid "%1$d lines: the first %2$d are shown, gaps first."
msgstr "%1$d wierszy: pokazano pierwsze %2$d, najpierw odstępstwa."

#, php-format
msgid "%d line(s) imported."
msgstr "Zaimportowano wierszy: %d."

#, php-format
msgid "%d member(s) read from Bitwarden."
msgstr "Odczytano członków z Bitwarden: %d."

msgid "A password of a shared or privileged account kept in the vault that has not been changed for longer is reported on the privileged accounts page and in the access reviews."
msgstr "Hasło konta współdzielonego lub uprzywilejowanego przechowywane w sejfie i niezmieniane dłużej jest zgłaszane na stronie kont uprzywilejowanych i w przeglądach dostępu."

msgid "A self-hosted server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration."
msgstr "Serwer we własnym hostingu pod adresem wewnętrznym (sieć prywatna) jest domyślnie odrzucany: administrator może zezwolić na adresy wewnętrzne w konfiguracji wtyczki."

msgid "Access refused by Bitwarden: the organization API is available on the Teams and Enterprise plans."
msgstr "Bitwarden odmówił dostępu: API organizacji jest dostępne w planach Teams i Enterprise."

msgid "Address of the self-hosted server"
msgstr "Adres serwera we własnym hostingu"

msgid "Admin Console > Settings > Organization info > API key: view the key (owner only) and copy the client ID and the client secret here. The organization API exists on the Teams and Enterprise plans."
msgstr "Konsola administratora > Ustawienia > Informacje o organizacji > Klucz API: wyświetl klucz (tylko właściciel) i skopiuj tutaj identyfikator i sekret klienta. API organizacji jest dostępne w planach Teams i Enterprise."

#, php-format
msgid "Administrators: %1$d, without two-step login: %2$d"
msgstr "Administratorzy: %1$d, bez logowania dwuetapowego: %2$d"

msgid "Bitwarden asks to slow down: try again in a few minutes."
msgstr "Bitwarden prosi o spowolnienie: spróbuj ponownie za kilka minut."

msgid "Bitwarden cloud (European Union)"
msgstr "Chmura Bitwarden (Unia Europejska)"

msgid "Bitwarden cloud (United States)"
msgstr "Chmura Bitwarden (Stany Zjednoczone)"

msgid "Bitwarden could not be reached: check the network access or the GLPI proxy."
msgstr "Nie można połączyć się z Bitwarden: sprawdź dostęp do sieci lub proxy GLPI."

msgid "Bitwarden or Vaultwarden"
msgstr "Bitwarden lub Vaultwarden"

msgid "Bitwarden or Vaultwarden: produce the file with the Bitwarden command line (bw list items and bw list org-members) and keep only these columns, without the passwords."
msgstr "Bitwarden lub Vaultwarden: utwórz plik za pomocą wiersza poleceń Bitwarden (bw list items i bw list org-members) i zachowaj tylko te kolumny, bez haseł."

msgid "Bitwarden refused the client ID or the client secret of the organization API key."
msgstr "Bitwarden odrzucił identyfikator lub sekret klienta klucza API organizacji."

msgid "Bitwarden returned an unexpected answer."
msgstr "Bitwarden zwrócił nieoczekiwaną odpowiedź."

msgid "Bitwarden settings saved."
msgstr "Zapisano ustawienia Bitwarden."

msgid "Client ID"
msgstr "Identyfikator klienta"

msgid "Collections"
msgstr "Kolekcje"

msgid "Connection to Bitwarden (read only)"
msgstr "Połączenie z Bitwarden (tylko odczyt)"

msgid "Connection to Bitwarden succeeded."
msgstr "Połączenie z Bitwarden powiodło się."

msgid "Custom role"
msgstr "Rola niestandardowa"

msgid "Date of the last change unknown"
msgstr "Nieznana data ostatniej zmiany"

msgid "Enabled administrator accounts read on the server management controllers (iLO, iDRAC, XClarity, IPMI). An account is found in the vault when an item has the same login name and cites the controller (name, host or IP address)."
msgstr "Aktywne konta administracyjne odczytane z kontrolerów zarządzania serwerami (iLO, iDRAC, XClarity, IPMI). Konto jest w sejfie, gdy element ma tę samą nazwę logowania i wskazuje kontroler (nazwa, host lub adres IP)."

msgid "Enter the server, the client ID (organization.…) and the client secret of the organization API key first."
msgstr "Najpierw wprowadź serwer, identyfikator klienta (organization.…) i sekret klienta klucza API organizacji."

msgid "Expected change delay (months)"
msgstr "Oczekiwany termin zmiany (miesiące)"

#, php-format
msgid "Expected change delay: %d months"
msgstr "Oczekiwany termin zmiany: %d mies."

msgid "How often must shared passwords be changed?"
msgstr "Jak często należy zmieniać hasła współdzielone?"

msgid "How to prepare Bitwarden:"
msgstr "Jak przygotować Bitwarden:"

msgid "ISO/IEC 27001, controls A.5.17 and A.8.2"
msgstr "ISO/IEC 27001, zabezpieczenia A.5.17 i A.8.2"

msgid "Import a CSV file with a header, one line per item or per member. A new import of the same source and the same kind replaces the previous one in the current entity."
msgstr "Zaimportuj plik CSV z nagłówkiem, jeden wiersz na element lub członka. Nowy import z tego samego źródła i tego samego rodzaju zastępuje poprzedni w bieżącym podmiocie."

msgid "Import the items and the members of the vault (or read the members from Bitwarden), then follow up the gaps: password not changed within the expected delay, access of a person who left, member unknown in GLPI, vault administrator without two-step login, server controller administrator account missing from the vault. Nothing is changed automatically. The gaps are also shown in the access review campaigns."
msgstr "Zaimportuj elementy i członków sejfu (lub odczytaj członków z Bitwarden), a następnie obsłuż odstępstwa: hasło niezmienione w oczekiwanym terminie, dostęp osoby, która odeszła, członek nieznany w GLPI, administrator sejfu bez logowania dwuetapowego, brak w sejfie konta administracyjnego kontrolera serwera. Nic nie jest zmieniane automatycznie. Odstępstwa są też widoczne w kampaniach przeglądu dostępu."

msgid "Import the vault metadata"
msgstr "Importuj metadane sejfu"

msgid "Invited"
msgstr "Zaproszony"

#, php-format
msgid "Items still reachable by them: %d"
msgstr "Elementy nadal dla nich dostępne: %d"

msgid "Items: name; optional id, collections, username, uri, passwordRevisionDate (or revisionDate, last_changed) and holders (email addresses separated by commas)."
msgstr "Elementy: name; opcjonalnie id, collections, username, uri, passwordRevisionDate (lub revisionDate, last_changed) i holders (adresy e-mail oddzielone przecinkami)."

msgid "Last change"
msgstr "Ostatnia zmiana"

msgid "Login name"
msgstr "Nazwa logowania"

msgid "Members are matched with GLPI accounts on the email address, the login, or the part of the address before the @. A person who left is a GLPI account disabled or deleted, or with a past departure date."
msgstr "Członkowie są dopasowywani do kont GLPI po adresie e-mail, loginie lub części adresu przed @. Osoba, która odeszła, to konto GLPI wyłączone lub usunięte albo z minioną datą odejścia."

msgid "Members of the vault"
msgstr "Członkowie sejfu"

msgid "Members to review"
msgstr "Członkowie do przeglądu"

msgid "Members unknown in GLPI"
msgstr "Członkowie nieznani w GLPI"

msgid "Members: email; optional name, type or role (owner, admin, user, custom), status (active, invited, revoked), collections and twoFactorEnabled (yes/no)."
msgstr "Członkowie: email; opcjonalnie name, type lub role (owner, admin, user, custom), status (active, invited, revoked), collections i twoFactorEnabled (tak/nie)."

msgid "No administrator account missing from the vault."
msgstr "W sejfie nie brakuje żadnego konta administracyjnego."

msgid "No email column found: the file of the members needs a column such as email."
msgstr "Nie znaleziono kolumny e-mail: plik członków wymaga kolumny takiej jak email."

msgid "No item imported yet: import the items of the vault below."
msgstr "Nie zaimportowano jeszcze żadnego elementu: zaimportuj elementy sejfu poniżej."

msgid "No item name column found: the file needs a header with a column such as name."
msgstr "Nie znaleziono kolumny nazwy: plik wymaga nagłówka z kolumną taką jak name."

msgid "No member imported yet: import the members of the vault or read them from Bitwarden below."
msgstr "Nie zaimportowano jeszcze członków: zaimportuj członków sejfu lub odczytaj ich z Bitwarden poniżej."

msgid "No member with a gap."
msgstr "Brak członków z odstępstwami."

msgid "No shared account with a gap."
msgstr "Brak kont współdzielonych z odstępstwami."

#, php-format
msgid "Not changed for more than %1$d months: %2$d"
msgstr "Niezmieniane od ponad %1$d mies.: %2$d"

msgid "Not changed within the expected delay"
msgstr "Niezmienione w oczekiwanym terminie"

msgid "Not known"
msgstr "Nieznane"

msgid "Not saved: the client ID must start with organization. followed by an identifier, and the address of a self-hosted server must start with https:// (or http:// when internal addresses are allowed), without user name, password or parameters."
msgstr "Nie zapisano: identyfikator klienta musi zaczynać się od organization. i identyfikatora, a adres serwera we własnym hostingu musi zaczynać się od https:// (lub http://, gdy adresy wewnętrzne są dozwolone), bez nazwy użytkownika, hasła i parametrów."

msgid "Nothing is changed in the vault nor in GLPI from this page: change the passwords and remove the accesses in the vault itself."
msgstr "Z tej strony nic nie jest zmieniane w sejfie ani w GLPI: zmień hasła i usuń dostępy w samym sejfie."

msgid "Only for a self-hosted server: GLPI calls its /identity and /api paths."
msgstr "Tylko dla serwera we własnym hostingu: GLPI wywołuje jego ścieżki /identity i /api."

msgid "Only metadata is imported: names, collections, login names, addresses, dates and members. A file with a password, code, note or custom field column is refused as a whole. Nothing is ever written in the vault."
msgstr "Importowane są tylko metadane: nazwy, kolekcje, nazwy logowania, adresy, daty i członkowie. Plik z kolumną hasła, kodu, notatki lub pola niestandardowego jest odrzucany w całości. Nic nigdy nie jest zapisywane w sejfie."

msgid "Other password vault"
msgstr "Inny sejf haseł"

msgid "People who left with an access"
msgstr "Osoby, które odeszły, z dostępem"

#, php-format
msgid "People who left with an access: %d"
msgstr "Osoby, które odeszły, z dostępem: %d"

msgid "Person who left"
msgstr "Osoba, która odeszła"

msgid "Privileged access management (PAM) solution"
msgstr "Rozwiązanie do zarządzania dostępem uprzywilejowanym (PAM)"

msgid "Privileged access management (PAM) solution: export the accounts list or the safes members report without the passwords."
msgstr "Rozwiązanie PAM: wyeksportuj listę kont lub raport członków sejfów bez haseł."

#, php-format
msgid "Privileged accesses to review in the password vault: people who left, members unknown in GLPI, administrators without two-step login, passwords not changed for more than %d months. Remove the accesses and change the passwords in the vault itself."
msgstr "Dostępy uprzywilejowane do przeglądu w sejfie haseł: osoby, które odeszły, członkowie nieznani w GLPI, administratorzy bez logowania dwuetapowego, hasła niezmieniane od ponad %d mies. Usuń dostępy i zmień hasła w samym sejfie."

msgid "Privileged accounts and password vault"
msgstr "Konta uprzywilejowane i sejf haseł"

msgid "Read now from Bitwarden"
msgstr "Odczytaj teraz z Bitwarden"

msgid "Read the members from Bitwarden"
msgstr "Odczytaj członków z Bitwarden"

msgid "Reads the members of your Bitwarden organization when you click \"Read now\": email address, role, status, two-step login and accessible collections. Never an item, a password or a note."
msgstr "Odczytuje członków organizacji Bitwarden po kliknięciu „Odczytaj teraz”: adres e-mail, rolę, status, logowanie dwuetapowe i dostępne kolekcje. Nigdy elementu, hasła ani notatki."

msgid "Self-hosted Bitwarden server"
msgstr "Serwer Bitwarden we własnym hostingu"

#, php-format
msgid "Server controller accounts missing from the vault: %d"
msgstr "Konta kontrolerów serwerów nieobecne w sejfie: %d"

msgid "Server controller administrator accounts missing from the vault"
msgstr "Konta administracyjne kontrolerów serwerów nieobecne w sejfie"

msgid "Shared accounts in the vault"
msgstr "Konta współdzielone w sejfie"

msgid "Shared accounts to review"
msgstr "Konta współdzielone do przeglądu"

msgid "Shared and privileged accounts in the vault"
msgstr "Konta współdzielone i uprzywilejowane w sejfie"

msgid "Shared passwords not changed within the expected delay"
msgstr "Hasła współdzielone niezmienione w oczekiwanym terminie"

msgid "Shows the shared and privileged accounts kept in your password vault (Bitwarden, Vaultwarden or a privileged access management solution) and who can reach them: when each password was last changed, the members of the vault and their role. Only metadata is read, never a password."
msgstr "Pokazuje konta współdzielone i uprzywilejowane przechowywane w sejfie haseł (Bitwarden, Vaultwarden lub rozwiązanie PAM) i kto ma do nich dostęp: datę ostatniej zmiany każdego hasła, członków sejfu i ich role. Odczytywane są tylko metadane, nigdy hasło."

msgid "Still reachable by a person who left"
msgstr "Nadal dostępne dla osoby, która odeszła"

msgid "The Bitwarden API was not found at this address: check the server address (Vaultwarden does not provide this API, import a CSV file instead)."
msgstr "Nie znaleziono API Bitwarden pod tym adresem: sprawdź adres serwera (Vaultwarden nie udostępnia tego API, zaimportuj zamiast tego plik CSV)."

#, php-format
msgid "The file was refused because the column \"%s\" may contain secrets. Remove the passwords, codes, notes and custom fields from the export, then import it again. Nothing was imported."
msgstr "Plik został odrzucony, ponieważ kolumna „%s” może zawierać sekrety. Usuń z eksportu hasła, kody, notatki i pola niestandardowe, a następnie zaimportuj go ponownie. Nic nie zostało zaimportowane."

msgid "The secret is encrypted with the GLPI key, never displayed again nor logged. GLPI only asks for a token and reads the list of the members."
msgstr "Sekret jest szyfrowany kluczem GLPI, nigdy ponownie wyświetlany ani rejestrowany. GLPI tylko pobiera token i odczytuje listę członków."

msgid "The server and the API key are entered in the plugin configuration, Connectors tab."
msgstr "Serwer i klucz API wprowadza się w konfiguracji wtyczki, karta Konektory."

msgid "The server is on an internal address: an administrator must allow internal addresses in the plugin configuration (Outgoing connections)."
msgstr "Serwer ma adres wewnętrzny: administrator musi zezwolić na adresy wewnętrzne w konfiguracji wtyczki (Połączenia wychodzące)."

msgid "Two-step login"
msgstr "Logowanie dwuetapowe"

msgid "Unknown in GLPI"
msgstr "Nieznany w GLPI"

msgid "Vault administrator without two-step login"
msgstr "Administrator sejfu bez logowania dwuetapowego"

#, php-format
msgid "Vault administrators without two-step login: %d"
msgstr "Administratorzy sejfu bez logowania dwuetapowego: %d"

msgid "Vault items (shared accounts)"
msgstr "Elementy sejfu (konta współdzielone)"

msgid "Vault members (who has access)"
msgstr "Członkowie sejfu (kto ma dostęp)"

msgid "Vaultwarden does not provide this API: import the CSV files of the members and of the items on the page instead."
msgstr "Vaultwarden nie udostępnia tego API: zamiast tego zaimportuj na stronie pliki CSV członków i elementów."

msgid "View all the privileged accounts"
msgstr "Zobacz wszystkie konta uprzywilejowane"

msgid "Who has access"
msgstr "Kto ma dostęp"

msgid "With the organization API key of Bitwarden (Teams and Enterprise plans), GLPI reads the members, their role, their two-step login and their collections when you click the button. The result replaces the Bitwarden members import of the current entity. The items are not exposed by this API: import them as a CSV file."
msgstr "Za pomocą klucza API organizacji Bitwarden (plany Teams i Enterprise) GLPI po kliknięciu przycisku odczytuje członków, ich role, logowanie dwuetapowe i kolekcje. Wynik zastępuje import członków Bitwarden bieżącego podmiotu. To API nie udostępnia elementów: zaimportuj je jako plik CSV."

#, php-format
msgid "%d shared account in the vault"
msgid_plural "%d shared accounts in the vault"
msgstr[0] "%d konto współdzielone w sejfie"
msgstr[1] "%d konta współdzielone w sejfie"
msgstr[2] "%d kont współdzielonych w sejfie"
