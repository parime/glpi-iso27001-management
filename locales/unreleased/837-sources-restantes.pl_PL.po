msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Asset classification"
msgstr "Klasyfikacja zasobu"

msgid "Patch level"
msgstr "Poziom poprawek"

msgid "Software end of support"
msgstr "Koniec wsparcia oprogramowania"

msgid "Warranty and manufacturer end of life"
msgstr "Gwarancja i koniec życia według producenta"

msgid "Endpoint protection (EDR)"
msgstr "Ochrona punktów końcowych (EDR)"

msgid "Monitoring (Zabbix)"
msgstr "Monitorowanie (Zabbix)"

msgid "Log collection"
msgstr "Zbieranie logów"

msgid "Not classified yet: its criticality cannot set the backup, logging and patch targets."
msgstr "Jeszcze niesklasyfikowany: jego krytyczność nie może wyznaczyć celów kopii zapasowych, logów i poprawek."

#, php-format
msgid "RTO: %d h"
msgstr "RTO: %d godz."

#, php-format
msgid "RPO: %d h"
msgstr "RPO: %d godz."

#, php-format
msgid "Confidentiality %1$s, integrity %2$s, availability %3$s."
msgstr "Poufność %1$s, integralność %2$s, dostępność %3$s."

#, php-format
msgid "Target delay: %d days"
msgstr "Termin docelowy: %d dni"

#, php-format
msgid "Last known patch on %1$s, %2$d days past the target delay."
msgstr "Ostatnia znana poprawka %1$s, %2$d dni po terminie docelowym."

#, php-format
msgid "Last known patch on %s, within the target delay."
msgstr "Ostatnia znana poprawka %s, w terminie docelowym."

#, php-format
msgid "%d tracked products, all still supported or with an unknown date."
msgstr "Śledzone produkty: %d, wszystkie nadal wspierane lub z nieznaną datą."

#, php-format
msgid "%1$d products no longer supported, %2$d reaching end of support soon."
msgstr "Produkty bez wsparcia: %1$d, wkrótce koniec wsparcia: %2$d."

#, php-format
msgid "Last seen by the console: %s"
msgstr "Ostatnio widziany przez konsolę: %s"

#, php-format
msgid "%d SentinelOne alerts waiting to be reviewed for this computer."
msgstr "Alerty SentinelOne oczekujące na weryfikację dla tego komputera: %d."

msgid "No SentinelOne agent matched this computer."
msgstr "Żaden agent SentinelOne nie został dopasowany do tego komputera."

msgid "SentinelOne agent active, no alert waiting."
msgstr "Agent SentinelOne aktywny, brak oczekujących alertów."

msgid "SentinelOne agent inactive: the computer is no longer protected."
msgstr "Agent SentinelOne nieaktywny: komputer nie jest już chroniony."

#, php-format
msgid "Availability over %1$d days: %2$s %%"
msgstr "Dostępność w ciągu %1$d dni: %2$s %%"

msgid "An outage exceeded the RTO of a business process."
msgstr "Przerwa przekroczyła RTO procesu biznesowego."

#, php-format
msgid "%1$s: %2$d open high problems, %3$d other open problems."
msgstr "%1$s: otwarte problemy wysokie: %2$d, inne otwarte problemy: %3$d."

#, php-format
msgid "Allowed age: %s"
msgstr "Dopuszczalny wiek: %s"

#, php-format
msgid "%1$s: last success on %2$s."
msgstr "%1$s: ostatni sukces %2$s."

#, php-format
msgid "%1$s: last event on %2$s."
msgstr "%1$s: ostatnie zdarzenie %2$s."

#, php-format
msgid "Platforms: %s"
msgstr "Platformy: %s"
