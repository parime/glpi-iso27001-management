msgstr "Todos os níveis"

msgid "Level 7 and above"
msgstr "Nível 7 e acima"

msgid "Level 12 and above"
msgstr "Nível 12 e acima"

msgid "Wazuh rule %s"
msgstr "Regra Wazuh %s"

msgid "Wazuh alert"
msgstr "Alerta Wazuh"

msgid "Wazuh: %1$s (%2$s)"
msgstr "Wazuh: %1$s (%2$s)"

msgid "%1$d incident(s) created, %2$d incident(s) completed, %3$d group(s) ignored."
msgstr "%1$d incidente(s) criado(s), %2$d incidente(s) completado(s), %3$d grupo(s) ignorado(s)."

msgid "Computers with untreated critical vulnerabilities (Wazuh)"
msgstr "Computadores com vulnerabilidades críticas não tratadas (Wazuh)"

msgid "Created from %d Wazuh alert(s) selected in GRC (read from the Wazuh plugin)."
msgstr "Criado a partir de %d alerta(s) do Wazuh selecionado(s) no GRC (lidos do plugin Wazuh)."

msgid "Rule:"
msgstr "Regra:"

msgid "Rule level:"
msgstr "Nível da regra:"

msgid "Agent:"
msgstr "Agente:"

msgid "Computer:"
msgstr "Computador:"

msgid "First alert:"
msgstr "Primeiro alerta:"

msgid "Last alert:"
msgstr "Último alerta:"

msgid "Alerts:"
msgstr "Alertas:"

msgid "the %d most recent are listed."
msgstr "os %d mais recentes estão listados."

msgid "level %s"
msgstr "nível %s"

msgid "See the alerts of this computer in the Wazuh plugin"
msgstr "Ver os alertas deste computador no plugin Wazuh"

msgid "Wazuh alerts to review"
msgstr "Alertas do Wazuh a verificar"

msgid "Minimum rule level"
msgstr "Nível mínimo da regra"

msgid "No new Wazuh alert at this level in the last %d days."
msgstr "Nenhum alerta novo do Wazuh neste nível nos últimos %d dias."

msgid "Alerts of the last %d days on the computers you can see, read from the Wazuh plugin. Repeated alerts (same rule on the same computer) are grouped. Tick the groups that deserve a security incident: each one becomes an incident with its computer, rule level, agent, dates and MITRE ATT&CK techniques; new repetitions are added to the incident while it stays open. Nothing is changed in Wazuh."
msgstr "Alertas dos últimos %d dias nos computadores que você pode ver, lidos do plugin Wazuh. Os alertas repetidos (mesma regra no mesmo computador) são agrupados. Marque os grupos que merecem um incidente de segurança: cada um se torna um incidente com seu computador, o nível da regra, o agente, as datas e as técnicas MITRE ATT&CK; as novas repetições são adicionadas ao incidente enquanto ele permanecer aberto. Nada é alterado no Wazuh."

msgid "%1$d groups: the %2$d highest levels are shown."
msgstr "%1$d grupos: são exibidos os %2$d de nível mais alto."

msgid "Last alert"
msgstr "Último alerta"

msgid "Agent"
msgstr "Agente"

msgid "Already in an incident: new repetitions"
msgstr "Já em um incidente: novas repetições"

msgid "since %s"
msgstr "desde %s"

msgid "Alerts in Wazuh"
msgstr "Alertas no Wazuh"

msgid "Create the incidents of the selected groups"
msgstr "Criar os incidentes dos grupos selecionados"

msgid "No computer with an untreated critical vulnerability according to Wazuh."
msgstr "Nenhum computador com vulnerabilidade crítica não tratada segundo o Wazuh."

msgid "Computers with untreated critical vulnerabilities"
msgstr "Computadores com vulnerabilidades críticas não tratadas"

msgid "Critical vulnerabilities (CVSS 9 or more) still reported by Wazuh and not covered by an approved, current waiver."
msgstr "Vulnerabilidades críticas (CVSS 9 ou mais) ainda relatadas pelo Wazuh e não cobertas por uma exceção aprovada e vigente."

msgid "%1$d computers: the %2$d most exposed are shown."
msgstr "%1$d computadores: são exibidos os %2$d mais expostos."
