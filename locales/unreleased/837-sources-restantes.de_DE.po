msgid "Asset classification"
msgstr "Klassifizierung des Assets"

msgid "Patch level"
msgstr "Patch-Stand"

msgid "Software end of support"
msgstr "Supportende der Software"

msgid "Warranty and manufacturer end of life"
msgstr "Garantie und Lebensende laut Hersteller"

msgid "Endpoint protection (EDR)"
msgstr "Endpoint-Schutz (EDR)"

msgid "Monitoring (Zabbix)"
msgstr "Überwachung (Zabbix)"

msgid "Log collection"
msgstr "Protokollerfassung"

msgid "Not classified yet: its criticality cannot set the backup, logging and patch targets."
msgstr "Noch nicht klassifiziert: Seine Kritikalität kann die Ziele für Sicherung, Protokollierung und Patches nicht festlegen."

#, php-format
msgid "RTO: %d h"
msgstr "RTO: %d Std."

#, php-format
msgid "RPO: %d h"
msgstr "RPO: %d Std."

#, php-format
msgid "Confidentiality %1$s, integrity %2$s, availability %3$s."
msgstr "Vertraulichkeit %1$s, Integrität %2$s, Verfügbarkeit %3$s."

#, php-format
msgid "Target delay: %d days"
msgstr "Zielfrist: %d Tage"

#, php-format
msgid "Last known patch on %1$s, %2$d days past the target delay."
msgstr "Letzter bekannter Patch am %1$s, %2$d Tage über der Zielfrist."

#, php-format
msgid "Last known patch on %s, within the target delay."
msgstr "Letzter bekannter Patch am %s, innerhalb der Zielfrist."

#, php-format
msgid "%d tracked products, all still supported or with an unknown date."
msgstr "%d verfolgte Produkte, alle noch unterstützt oder mit unbekanntem Datum."

#, php-format
msgid "%1$d products no longer supported, %2$d reaching end of support soon."
msgstr "%1$d Produkte nicht mehr unterstützt, %2$d bald am Supportende."

#, php-format
msgid "Last seen by the console: %s"
msgstr "Zuletzt von der Konsole gesehen: %s"

#, php-format
msgid "%d SentinelOne alerts waiting to be reviewed for this computer."
msgstr "%d SentinelOne-Warnungen warten auf Prüfung für diesen Computer."

msgid "No SentinelOne agent matched this computer."
msgstr "Kein SentinelOne-Agent wurde diesem Computer zugeordnet."

msgid "SentinelOne agent active, no alert waiting."
msgstr "SentinelOne-Agent aktiv, keine wartende Warnung."

msgid "SentinelOne agent inactive: the computer is no longer protected."
msgstr "SentinelOne-Agent inaktiv: Der Computer ist nicht mehr geschützt."

#, php-format
msgid "Availability over %1$d days: %2$s %%"
msgstr "Verfügbarkeit über %1$d Tage: %2$s %%"

msgid "An outage exceeded the RTO of a business process."
msgstr "Ein Ausfall hat die RTO eines Geschäftsprozesses überschritten."

#, php-format
msgid "%1$s: %2$d open high problems, %3$d other open problems."
msgstr "%1$s: %2$d offene hohe Probleme, %3$d andere offene Probleme."

#, php-format
msgid "Allowed age: %s"
msgstr "Zulässiges Alter: %s"

#, php-format
msgid "%1$s: last success on %2$s."
msgstr "%1$s: letzter Erfolg am %2$s."

#, php-format
msgid "%1$s: last event on %2$s."
msgstr "%1$s: letztes Ereignis am %2$s."

#, php-format
msgid "Platforms: %s"
msgstr "Plattformen: %s"
