msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#, php-format
msgid "%1$d lines: the first %2$d are shown, gaps first."
msgstr "%1$d righe: sono mostrate le prime %2$d, prima le anomalie."

#, php-format
msgid "%d line(s) imported."
msgstr "%d riga/e importata/e."

#, php-format
msgid "%d member(s) read from Bitwarden."
msgstr "%d membro/i letto/i da Bitwarden."

msgid "A password of a shared or privileged account kept in the vault that has not been changed for longer is reported on the privileged accounts page and in the access reviews."
msgstr "Una password di un account condiviso o privilegiato conservata nella cassaforte e non cambiata da più tempo viene segnalata nella pagina degli account privilegiati e nelle revisioni degli accessi."

msgid "A self-hosted server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration."
msgstr "Un server self-hosted su un indirizzo interno (rete privata) è rifiutato per impostazione predefinita: un amministratore può consentire gli indirizzi interni nella configurazione del plugin."

msgid "Access refused by Bitwarden: the organization API is available on the Teams and Enterprise plans."
msgstr "Accesso rifiutato da Bitwarden: l'API dell'organizzazione è disponibile nei piani Teams ed Enterprise."

msgid "Address of the self-hosted server"
msgstr "Indirizzo del server self-hosted"

msgid "Admin Console > Settings > Organization info > API key: view the key (owner only) and copy the client ID and the client secret here. The organization API exists on the Teams and Enterprise plans."
msgstr "Console di amministrazione > Impostazioni > Informazioni sull'organizzazione > Chiave API: visualizzare la chiave (solo proprietario) e copiare qui l'ID e il segreto del client. L'API dell'organizzazione esiste nei piani Teams ed Enterprise."

#, php-format
msgid "Administrators: %1$d, without two-step login: %2$d"
msgstr "Amministratori: %1$d, senza accesso in due passaggi: %2$d"

msgid "Bitwarden asks to slow down: try again in a few minutes."
msgstr "Bitwarden chiede di rallentare: riprovare tra qualche minuto."

msgid "Bitwarden cloud (European Union)"
msgstr "Cloud Bitwarden (Unione europea)"

msgid "Bitwarden cloud (United States)"
msgstr "Cloud Bitwarden (Stati Uniti)"

msgid "Bitwarden could not be reached: check the network access or the GLPI proxy."
msgstr "Bitwarden non è raggiungibile: verificare l'accesso alla rete o il proxy di GLPI."

msgid "Bitwarden or Vaultwarden"
msgstr "Bitwarden o Vaultwarden"

msgid "Bitwarden or Vaultwarden: produce the file with the Bitwarden command line (bw list items and bw list org-members) and keep only these columns, without the passwords."
msgstr "Bitwarden o Vaultwarden: produrre il file con la riga di comando di Bitwarden (bw list items e bw list org-members) e conservare solo queste colonne, senza le password."

msgid "Bitwarden refused the client ID or the client secret of the organization API key."
msgstr "Bitwarden ha rifiutato l'ID o il segreto del client della chiave API dell'organizzazione."

msgid "Bitwarden returned an unexpected answer."
msgstr "Bitwarden ha restituito una risposta inattesa."

msgid "Bitwarden settings saved."
msgstr "Impostazioni di Bitwarden salvate."

msgid "Client ID"
msgstr "ID client"

msgid "Collections"
msgstr "Raccolte"

msgid "Connection to Bitwarden (read only)"
msgstr "Connessione a Bitwarden (sola lettura)"

msgid "Connection to Bitwarden succeeded."
msgstr "Connessione a Bitwarden riuscita."

msgid "Custom role"
msgstr "Ruolo personalizzato"

msgid "Date of the last change unknown"
msgstr "Data dell'ultima modifica sconosciuta"

msgid "Enabled administrator accounts read on the server management controllers (iLO, iDRAC, XClarity, IPMI). An account is found in the vault when an item has the same login name and cites the controller (name, host or IP address)."
msgstr "Account di amministrazione attivi letti sui controller di gestione dei server (iLO, iDRAC, XClarity, IPMI). Un account è presente nella cassaforte quando un elemento ha lo stesso nome di accesso e cita il controller (nome, host o indirizzo IP)."

msgid "Enter the server, the client ID (organization.…) and the client secret of the organization API key first."
msgstr "Inserire prima il server, l'ID client (organization.…) e il segreto client della chiave API dell'organizzazione."

msgid "Expected change delay (months)"
msgstr "Intervallo di modifica previsto (mesi)"

#, php-format
msgid "Expected change delay: %d months"
msgstr "Intervallo di modifica previsto: %d mesi"

msgid "GLPI reads the members of your Bitwarden organization from the privileged accounts page, on request: email address, role, status, two-step login and accessible collections. Never an item, a password or a note."
msgstr "GLPI legge i membri della vostra organizzazione Bitwarden dalla pagina degli account privilegiati, su richiesta: indirizzo e-mail, ruolo, stato, accesso in due passaggi e raccolte accessibili. Mai un elemento, una password o una nota."

msgid "How often must shared passwords be changed?"
msgstr "Ogni quanto vanno cambiate le password condivise?"

msgid "How to prepare Bitwarden:"
msgstr "Come preparare Bitwarden:"

msgid "ISO/IEC 27001, controls A.5.17 and A.8.2"
msgstr "ISO/IEC 27001, controlli A.5.17 e A.8.2"

msgid "Import a CSV file with a header, one line per item or per member. A new import of the same source and the same kind replaces the previous one in the current entity."
msgstr "Importare un file CSV con intestazione, una riga per elemento o per membro. Una nuova importazione della stessa origine e dello stesso tipo sostituisce la precedente nell'entità corrente."

msgid "Import the items and the members of the vault (or read the members from Bitwarden), then follow up the gaps: password not changed within the expected delay, access of a person who left, member unknown in GLPI, vault administrator without two-step login, server controller administrator account missing from the vault. Nothing is changed automatically. The gaps are also shown in the access review campaigns."
msgstr "Importare gli elementi e i membri della cassaforte (o leggere i membri da Bitwarden), poi gestire le anomalie: password non cambiata nell'intervallo previsto, accesso di una persona che è uscita, membro sconosciuto in GLPI, amministratore della cassaforte senza accesso in due passaggi, account di amministrazione di un controller di server assente dalla cassaforte. Nulla viene modificato automaticamente. Le anomalie compaiono anche nelle campagne di revisione degli accessi."

msgid "Import the vault metadata"
msgstr "Importare i metadati della cassaforte"

msgid "Invited"
msgstr "Invitato"

#, php-format
msgid "Items still reachable by them: %d"
msgstr "Elementi ancora alla loro portata: %d"

msgid "Items: name; optional id, collections, username, uri, passwordRevisionDate (or revisionDate, last_changed) and holders (email addresses separated by commas)."
msgstr "Elementi: name; facoltativi id, collections, username, uri, passwordRevisionDate (o revisionDate, last_changed) e holders (indirizzi e-mail separati da virgole)."

msgid "Last change"
msgstr "Ultima modifica"

msgid "Login name"
msgstr "Nome di accesso"

msgid "Members are matched with GLPI accounts on the email address, the login, or the part of the address before the @. A person who left is a GLPI account disabled or deleted, or with a past departure date."
msgstr "I membri sono abbinati agli account GLPI tramite l'indirizzo e-mail, il nome di accesso o la parte dell'indirizzo prima della @. Una persona uscita è un account GLPI disattivato o eliminato, o con una data di uscita passata."

msgid "Members of the vault"
msgstr "Membri della cassaforte"

msgid "Members to review"
msgstr "Membri da rivedere"

msgid "Members unknown in GLPI"
msgstr "Membri sconosciuti in GLPI"

msgid "Members: email; optional name, type or role (owner, admin, user, custom), status (active, invited, revoked), collections and twoFactorEnabled (yes/no)."
msgstr "Membri: email; facoltativi name, type o role (owner, admin, user, custom), status (active, invited, revoked), collections e twoFactorEnabled (sì/no)."

msgid "No administrator account missing from the vault."
msgstr "Nessun account di amministrazione assente dalla cassaforte."

msgid "No email column found: the file of the members needs a column such as email."
msgstr "Nessuna colonna e-mail trovata: il file dei membri richiede una colonna come email."

msgid "No item imported yet: import the items of the vault below."
msgstr "Nessun elemento importato: importare gli elementi della cassaforte qui sotto."

msgid "No item name column found: the file needs a header with a column such as name."
msgstr "Nessuna colonna del nome trovata: il file richiede un'intestazione con una colonna come name."

msgid "No member imported yet: import the members of the vault or read them from Bitwarden below."
msgstr "Nessun membro importato: importare i membri della cassaforte o leggerli da Bitwarden qui sotto."

msgid "No member with a gap."
msgstr "Nessun membro con anomalie."

msgid "No shared account with a gap."
msgstr "Nessun account condiviso con anomalie."

#, php-format
msgid "Not changed for more than %1$d months: %2$d"
msgstr "Non cambiati da più di %1$d mesi: %2$d"

msgid "Not changed within the expected delay"
msgstr "Non cambiato nell'intervallo previsto"

msgid "Not known"
msgstr "Sconosciuto"

msgid "Not saved: the client ID must start with organization. followed by an identifier, and the address of a self-hosted server must start with https:// (or http:// when internal addresses are allowed), without user name, password or parameters."
msgstr "Non salvato: l'ID client deve iniziare con organization. seguito da un identificativo e l'indirizzo di un server self-hosted deve iniziare con https:// (o http:// se gli indirizzi interni sono consentiti), senza nome utente, password né parametri."

msgid "Nothing is changed in the vault nor in GLPI from this page: change the passwords and remove the accesses in the vault itself."
msgstr "Da questa pagina non viene modificato nulla nella cassaforte né in GLPI: cambiare le password e rimuovere gli accessi nella cassaforte stessa."

msgid "Only for a self-hosted server: GLPI calls its /identity and /api paths."
msgstr "Solo per un server self-hosted: GLPI chiama i suoi percorsi /identity e /api."

msgid "Only metadata is imported: names, collections, login names, addresses, dates and members. A file with a password, code, note or custom field column is refused as a whole. Nothing is ever written in the vault."
msgstr "Vengono importati solo metadati: nomi, raccolte, nomi di accesso, indirizzi, date e membri. Un file con una colonna di password, codice, nota o campo personalizzato viene rifiutato per intero. Nella cassaforte non viene mai scritto nulla."

msgid "Other password vault"
msgstr "Altra cassaforte di password"

msgid "People who left with an access"
msgstr "Persone uscite con un accesso"

#, php-format
msgid "People who left with an access: %d"
msgstr "Persone uscite con un accesso: %d"

msgid "Person who left"
msgstr "Persona uscita"

msgid "Privileged access management (PAM) solution"
msgstr "Soluzione di gestione degli accessi privilegiati (PAM)"

msgid "Privileged access management (PAM) solution: export the accounts list or the safes members report without the passwords."
msgstr "Soluzione di gestione degli accessi privilegiati (PAM): esportare l'elenco degli account o il rapporto dei membri delle casseforti senza le password."

#, php-format
msgid "Privileged accesses to review in the password vault: people who left, members unknown in GLPI, administrators without two-step login, passwords not changed for more than %d months. Remove the accesses and change the passwords in the vault itself."
msgstr "Accessi privilegiati da rivedere nella cassaforte di password: persone uscite, membri sconosciuti in GLPI, amministratori senza accesso in due passaggi, password non cambiate da più di %d mesi. Rimuovere gli accessi e cambiare le password nella cassaforte stessa."

msgid "Privileged accounts and password vault"
msgstr "Account privilegiati e cassaforte di password"

msgid "Read now from Bitwarden"
msgstr "Leggi ora da Bitwarden"

msgid "Read the members from Bitwarden"
msgstr "Leggere i membri da Bitwarden"

msgid "Self-hosted Bitwarden server"
msgstr "Server Bitwarden self-hosted"

#, php-format
msgid "Server controller accounts missing from the vault: %d"
msgstr "Account di controller di server assenti dalla cassaforte: %d"

msgid "Server controller administrator accounts missing from the vault"
msgstr "Account di amministrazione dei controller di server assenti dalla cassaforte"

msgid "Shared accounts in the vault"
msgstr "Account condivisi nella cassaforte"

msgid "Shared accounts to review"
msgstr "Account condivisi da rivedere"

msgid "Shared and privileged accounts in the vault"
msgstr "Account condivisi e privilegiati nella cassaforte"

msgid "Shared passwords not changed within the expected delay"
msgstr "Password condivise non cambiate nell'intervallo previsto"

msgid "Shows the shared and privileged accounts kept in your password vault (Bitwarden, Vaultwarden or a privileged access management solution) and who can reach them: when each password was last changed, the members of the vault and their role. Only metadata is read, never a password."
msgstr "Mostra gli account condivisi e privilegiati conservati nella vostra cassaforte di password (Bitwarden, Vaultwarden o una soluzione di gestione degli accessi privilegiati) e chi può raggiungerli: ultima modifica di ogni password, membri della cassaforte e loro ruolo. Vengono letti solo metadati, mai una password."

msgid "Still reachable by a person who left"
msgstr "Ancora accessibile a una persona uscita"

msgid "The Bitwarden API was not found at this address: check the server address (Vaultwarden does not provide this API, import a CSV file instead)."
msgstr "L'API di Bitwarden non è stata trovata a questo indirizzo: verificare l'indirizzo del server (Vaultwarden non fornisce questa API, importare invece un file CSV)."

#, php-format
msgid "The file was refused because the column \"%s\" may contain secrets. Remove the passwords, codes, notes and custom fields from the export, then import it again. Nothing was imported."
msgstr "Il file è stato rifiutato perché la colonna «%s» può contenere segreti. Rimuovere dall'esportazione password, codici, note e campi personalizzati, poi importarlo di nuovo. Non è stato importato nulla."

msgid "The secret is encrypted with the GLPI key, never displayed again nor logged. GLPI only asks for a token and reads the list of the members."
msgstr "Il segreto è cifrato con la chiave di GLPI, mai più visualizzato né registrato. GLPI chiede solo un token e legge l'elenco dei membri."

msgid "The server and the API key are entered in the plugin configuration, Connectors tab."
msgstr "Il server e la chiave API si inseriscono nella configurazione del plugin, scheda Connettori."

msgid "The server is on an internal address: an administrator must allow internal addresses in the plugin configuration (Outgoing connections)."
msgstr "Il server è su un indirizzo interno: un amministratore deve consentire gli indirizzi interni nella configurazione del plugin (Connessioni in uscita)."

msgid "Two-step login"
msgstr "Accesso in due passaggi"

msgid "Unknown in GLPI"
msgstr "Sconosciuto in GLPI"

msgid "Vault administrator without two-step login"
msgstr "Amministratore della cassaforte senza accesso in due passaggi"

#, php-format
msgid "Vault administrators without two-step login: %d"
msgstr "Amministratori della cassaforte senza accesso in due passaggi: %d"

msgid "Vault items (shared accounts)"
msgstr "Elementi della cassaforte (account condivisi)"

msgid "Vault members (who has access)"
msgstr "Membri della cassaforte (chi ha accesso)"

msgid "Vaultwarden does not provide this API: import the CSV files of the members and of the items on the page instead."
msgstr "Vaultwarden non fornisce questa API: importare invece i file CSV dei membri e degli elementi nella pagina."

msgid "View all the privileged accounts"
msgstr "Vedere tutti gli account privilegiati"

msgid "Who has access"
msgstr "Chi ha accesso"

msgid "With the organization API key of Bitwarden (Teams and Enterprise plans), GLPI reads the members, their role, their two-step login and their collections when you click the button. The result replaces the Bitwarden members import of the current entity. The items are not exposed by this API: import them as a CSV file."
msgstr "Con la chiave API dell'organizzazione di Bitwarden (piani Teams ed Enterprise), GLPI legge i membri, il loro ruolo, l'accesso in due passaggi e le raccolte quando si fa clic sul pulsante. Il risultato sostituisce l'importazione dei membri Bitwarden dell'entità corrente. Gli elementi non sono esposti da questa API: importarli come file CSV."

#, php-format
msgid "%d shared account in the vault"
msgid_plural "%d shared accounts in the vault"
msgstr[0] "%d account condiviso nella cassaforte"
msgstr[1] "%d account condivisi nella cassaforte"
