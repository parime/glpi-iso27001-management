"Content-Type: text/plain; charset=UTF-8\n"

msgid "All levels"
msgstr "Wszystkie poziomy"

msgid "Level 7 and above"
msgstr "Poziom 7 i wyższy"

msgid "Level 12 and above"
msgstr "Poziom 12 i wyższy"

msgid "Wazuh rule %s"
msgstr "Reguła Wazuh %s"

msgid "Wazuh alert"
msgstr "Alert Wazuh"

msgid "Wazuh: %1$s (%2$s)"
msgstr "Wazuh: %1$s (%2$s)"

msgid "%1$d incident(s) created, %2$d incident(s) completed, %3$d group(s) ignored."
msgstr "Utworzone incydenty: %1$d, uzupełnione incydenty: %2$d, pominięte grupy: %3$d."

msgid "Computers with untreated critical vulnerabilities (Wazuh)"
msgstr "Komputery z nieobsłużonymi krytycznymi podatnościami (Wazuh)"

msgid "Created from %d Wazuh alert(s) selected in GRC (read from the Wazuh plugin)."
msgstr "Utworzono na podstawie alertów Wazuh wybranych w GRC (odczytanych z wtyczki Wazuh): %d."

msgid "Rule:"
msgstr "Reguła:"

msgid "Rule level:"
msgstr "Poziom reguły:"

msgid "Agent:"
msgstr "Agent:"

msgid "Computer:"
msgstr "Komputer:"

msgid "First alert:"
msgstr "Pierwszy alert:"

msgid "Last alert:"
msgstr "Ostatni alert:"

msgid "Alerts:"
msgstr "Alerty:"

msgid "the %d most recent are listed."
msgstr "wymieniono %d najnowszych."

msgid "level %s"
msgstr "poziom %s"

msgid "See the alerts of this computer in the Wazuh plugin"
msgstr "Zobacz alerty tego komputera we wtyczce Wazuh"

msgid "Wazuh alerts to review"
msgstr "Alerty Wazuh do sprawdzenia"

msgid "Minimum rule level"
msgstr "Minimalny poziom reguły"

msgid "No new Wazuh alert at this level in the last %d days."
msgstr "Brak nowych alertów Wazuh na tym poziomie w ciągu ostatnich %d dni."

msgid "Alerts of the last %d days on the computers you can see, read from the Wazuh plugin. Repeated alerts (same rule on the same computer) are grouped. Tick the groups that deserve a security incident: each one becomes an incident with its computer, rule level, agent, dates and MITRE ATT&CK techniques; new repetitions are added to the incident while it stays open. Nothing is changed in Wazuh."
msgstr "Alerty z ostatnich %d dni na komputerach, które widzisz, odczytane z wtyczki Wazuh. Powtarzające się alerty (ta sama reguła na tym samym komputerze) są grupowane. Zaznacz grupy, które zasługują na incydent bezpieczeństwa: każda staje się incydentem z komputerem, poziomem reguły, agentem, datami i technikami MITRE ATT&CK; nowe powtórzenia są dodawane do incydentu, dopóki pozostaje otwarty. W Wazuh nic nie jest zmieniane."

msgid "%1$d groups: the %2$d highest levels are shown."
msgstr "Grupy: %1$d; wyświetlono %2$d o najwyższym poziomie."

msgid "Last alert"
msgstr "Ostatni alert"

msgid "Agent"
msgstr "Agent"

msgid "Already in an incident: new repetitions"
msgstr "Już w incydencie: nowe powtórzenia"

msgid "since %s"
msgstr "od %s"

msgid "Alerts in Wazuh"
msgstr "Alerty w Wazuh"

msgid "Create the incidents of the selected groups"
msgstr "Utwórz incydenty z zaznaczonych grup"

msgid "No computer with an untreated critical vulnerability according to Wazuh."
msgstr "Według Wazuh żaden komputer nie ma nieobsłużonej krytycznej podatności."

msgid "Computers with untreated critical vulnerabilities"
msgstr "Komputery z nieobsłużonymi krytycznymi podatnościami"

msgid "Critical vulnerabilities (CVSS 9 or more) still reported by Wazuh and not covered by an approved, current waiver."
msgstr "Krytyczne podatności (CVSS 9 lub więcej) nadal zgłaszane przez Wazuh i nieobjęte zatwierdzonym, obowiązującym odstępstwem."

msgid "%1$d computers: the %2$d most exposed are shown."
msgstr "Komputery: %1$d; wyświetlono %2$d najbardziej narażonych."
