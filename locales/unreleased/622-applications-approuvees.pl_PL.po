msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "%1$d application(s) to review, %2$d ticket(s) opened."
msgstr "Aplikacje do przeglądu: %1$d, otwarte zgłoszenia: %2$d."

msgid "%1$d software not in the register; the %2$d most installed are shown. Choose a software category (for example online services) to narrow the list."
msgstr "Oprogramowanie spoza rejestru: %1$d; pokazano %2$d najczęściej instalowanych. Wybierz kategorię oprogramowania (na przykład usługi online), aby zawęzić listę."

msgid "%d due within 30 days"
msgstr "Do wykonania w ciągu 30 dni: %d"

msgid "%d online service(s)"
msgstr "Usługi online: %d"

msgid "0: no periodic review. When the review is due, a reassessment ticket is opened for the owner."
msgstr "0: brak przeglądu okresowego. W terminie przeglądu otwierane jest zgłoszenie ponownej oceny dla właściciela."

msgid "Allowed data level not set"
msgstr "Nie określono dozwolonego poziomu danych"

msgid "Allowed uses"
msgstr "Dozwolone zastosowania"

msgid "Allowed uses not described"
msgstr "Nie opisano dozwolonych zastosowań"

msgid "Application owner"
msgstr "Właściciel aplikacji"

msgid "Applications and online services you may use for your work, with what they may be used for and the most sensitive data you may put in them. For any other application, ask the IT department before using it."
msgstr "Aplikacje i usługi online, z których możesz korzystać w pracy, do czego mogą służyć i jakie najbardziej wrażliwe dane możesz w nich umieszczać. W przypadku każdej innej aplikacji zapytaj dział IT przed jej użyciem."

msgid "Applications in the register: %d"
msgstr "Aplikacje w rejestrze: %d"

msgid "Applications not to use"
msgstr "Aplikacje, których nie należy używać"

msgid "Approved applications and online services"
msgstr "Zatwierdzone aplikacje i usługi online"

msgid "Approved applications to complete"
msgstr "Zatwierdzone aplikacje do uzupełnienia"

msgid "Approved use"
msgstr "Dozwolone użycie"

msgid "Approved use sheet saved."
msgstr "Zapisano kartę dozwolonego użycia."

msgid "Approved with restrictions"
msgstr "Zatwierdzona z ograniczeniami"

msgid "Approved: %d"
msgstr "Zatwierdzone: %d"

msgid "Authorised applications"
msgstr "Dozwolone aplikacje"

msgid "Check that the allowed uses, the data level and the supplier are still right, then record the review in the \"Approved use\" tab of the application."
msgstr "Sprawdź, czy dozwolone zastosowania, poziom danych i dostawca są nadal właściwe, a następnie zapisz przegląd na karcie „Dozwolone użycie” aplikacji."

msgid "Classification above the allowed level"
msgstr "Klasyfikacja powyżej dozwolonego poziomu"

msgid "Comparison with the software inventory"
msgstr "Porównanie z inwentarzem oprogramowania"

msgid "Complete the approved applications (owner, allowed uses, data level), review them when due (a reassessment ticket is opened for the owner), and check the installed software that is refused or missing from the register. Nothing is uninstalled or changed automatically."
msgstr "Uzupełnij zatwierdzone aplikacje (właściciel, dozwolone zastosowania, poziom danych), przeglądaj je w terminie (dla właściciela otwierane jest zgłoszenie ponownej oceny) i sprawdź zainstalowane oprogramowanie odrzucone lub nieobecne w rejestrze. Nic nie jest automatycznie odinstalowywane ani zmieniane."

msgid "Departments or teams that use it, for example: Sales, Human resources."
msgstr "Działy lub zespoły, które z niej korzystają, na przykład: Sprzedaż, Kadry."

msgid "End of use"
msgstr "Koniec użytkowania"

msgid "Exceptions accepted for this application, from the waiver register."
msgstr "Wyjątki zaakceptowane dla tej aplikacji, z rejestru odstępstw."

msgid "For example: sharing files with customers and partners, team chat. Shown to users."
msgstr "Na przykład: udostępnianie plików klientom i partnerom, czat zespołowy. Widoczne dla użytkowników."

msgid "High: confidential data allowed"
msgstr "Wysoki: dozwolone dane poufne"

msgid "Hosting"
msgstr "Hosting"

msgid "ISO/IEC 27001, control A.5.23"
msgstr "ISO/IEC 27001, zabezpieczenie A.5.23"

msgid "Installed software not in the register"
msgstr "Zainstalowane oprogramowanie spoza rejestru"

msgid "Installed software that is refused or not yet approved"
msgstr "Zainstalowane oprogramowanie odrzucone lub jeszcze niezatwierdzone"

msgid "Leave empty while the application is in use."
msgstr "Pozostaw puste, dopóki aplikacja jest używana."

msgid "Lists the applications and online services that may be used, what for and with which data: approved, approved with restrictions, under evaluation or refused. Each decision is recorded in the \"Approved use\" tab of an appliance of GLPI, next to its secure development sheet. Users see the approved ones in their preferences, without any right on the plugin."
msgstr "Wyświetla aplikacje i usługi online, z których można korzystać, do czego i z jakimi danymi: zatwierdzone, zatwierdzone z ograniczeniami, w ocenie lub odrzucone. Każda decyzja jest zapisywana na karcie „Dozwolone użycie” aplikacji GLPI, obok jej karty bezpiecznego rozwoju. Użytkownicy widzą zatwierdzone w swoich preferencjach, bez żadnych uprawnień do wtyczki."

msgid "Low: public or internal data only"
msgstr "Niski: tylko dane publiczne lub wewnętrzne"

msgid "Medium: up to restricted data (customers, staff)"
msgstr "Średni: do danych o ograniczonym dostępie (klienci, pracownicy)"

msgid "Most sensitive data allowed"
msgstr "Najbardziej wrażliwe dozwolone dane"

msgid "No application has been published yet."
msgstr "Nie opublikowano jeszcze żadnej aplikacji."

msgid "No application in the register yet. Open an appliance of GLPI (Assets > Appliances) and fill in its \"Approved use\" tab."
msgstr "Brak aplikacji w rejestrze. Otwórz aplikację w GLPI (Zasoby > Aplikacje) i wypełnij jej kartę „Dozwolone użycie”."

msgid "No decision has been recorded yet for the use of this application."
msgstr "Nie zapisano jeszcze żadnej decyzji dotyczącej użycia tej aplikacji."

msgid "No periodic review"
msgstr "Brak przeglądu okresowego"

msgid "None found"
msgstr "Nie znaleziono"

msgid "On premises (our own servers)"
msgstr "Lokalnie (własne serwery)"

msgid "Online (cloud service, SaaS)"
msgstr "Online (usługa w chmurze, SaaS)"

msgid "Only for \"Approved with restrictions\": what is not allowed, for example no customer personal data, links limited to 30 days. Shown to users."
msgstr "Tylko dla „Zatwierdzona z ograniczeniami”: czego nie wolno, na przykład żadnych danych osobowych klientów, linki ograniczone do 30 dni. Widoczne dla użytkowników."

msgid "Open the application"
msgstr "Otwórz aplikację"

msgid "Opens a reassessment ticket for each approved application whose review is due"
msgstr "Otwiera zgłoszenie ponownej oceny dla każdej zatwierdzonej aplikacji, której termin przeglądu minął"

msgid "Owner, allowed uses or data level missing"
msgstr "Brak właściciela, dozwolonych zastosowań lub poziomu danych"

msgid "Reassess the approved application %s"
msgstr "Ponownie oceń zatwierdzoną aplikację %s"

msgid "Reassessment ticket #%d"
msgstr "Zgłoszenie ponownej oceny nr %d"

msgid "Receives the reassessment ticket. Empty: the technical owner of the application."
msgstr "Otrzymuje zgłoszenie ponownej oceny. Puste: właściciel techniczny aplikacji."

msgid "Refused: %d"
msgstr "Odrzucone: %d"

msgid "Register of approved applications and online services"
msgstr "Rejestr zatwierdzonych aplikacji i usług online"

msgid "Requires the right to read the software of GLPI."
msgstr "Wymaga uprawnienia do odczytu oprogramowania w GLPI."

msgid "Restrictions"
msgstr "Ograniczenia"

msgid "Restrictions not described"
msgstr "Nie opisano ograniczeń"

msgid "Review done today"
msgstr "Przegląd wykonany dzisiaj"

msgid "Review due soon"
msgstr "Zbliża się termin przeglądu"

msgid "Review every (months)"
msgstr "Przegląd co (miesiące)"

msgid "Review up to date"
msgstr "Przegląd aktualny"

msgid "Reviews overdue"
msgstr "Zaległe przeglądy"

msgid "Same scale as the confidentiality of the C/I/D classification of the plugin."
msgstr "Ta sama skala co poufność w klasyfikacji C/I/D wtyczki."

msgid "Say whether this application or online service may be used, for what and with which data. Approved applications are listed for every user in their preferences (\"Authorised applications\" tab)."
msgstr "Określ, czy z tej aplikacji lub usługi online można korzystać, do czego i z jakimi danymi. Zatwierdzone aplikacje są wyświetlane każdemu użytkownikowi w jego preferencjach (karta „Dozwolone aplikacje”)."

msgid "Software category"
msgstr "Kategoria oprogramowania"

msgid "Software found by the GLPI inventory, matched with the register through the linked software or the name of the application. Nothing is uninstalled or changed: open a ticket if action is needed."
msgstr "Oprogramowanie znalezione przez inwentarz GLPI, porównane z rejestrem przez powiązane oprogramowanie lub nazwę aplikacji. Nic nie jest odinstalowywane ani zmieniane: otwórz zgłoszenie, jeśli trzeba działać."

msgid "Software of the GLPI inventory that corresponds to this application: used to find where it is installed."
msgstr "Oprogramowanie z inwentarza GLPI odpowiadające tej aplikacji: służy do znalezienia jej instalacji."

msgid "Start of use"
msgstr "Początek użytkowania"

msgid "Supplier of GLPI (Management > Suppliers): its overall risk is assessed in the supplier risk register."
msgstr "Dostawca w GLPI (Zarządzanie > Dostawcy): jego ogólne ryzyko jest oceniane w rejestrze ryzyk dostawców."

msgid "The approved use sheet could not be saved."
msgstr "Nie udało się zapisać karty dozwolonego użycia."

msgid "The confidentiality of this application (%s) is higher than the allowed data level"
msgstr "Poufność tej aplikacji (%s) przekracza dozwolony poziom danych"

msgid "The periodic review of the application \"%1$s\" was due on %2$s."
msgstr "Przegląd okresowy aplikacji „%1$s” przypadał na %2$s."

msgid "To complete: %d"
msgstr "Do uzupełnienia: %d"

msgid "Under evaluation"
msgstr "W ocenie"

msgid "Under evaluation while the security team studies it; refused applications are shown to users as not to be used."
msgstr "W ocenie, dopóki zespół bezpieczeństwa ją analizuje; odrzucone aplikacje są pokazywane użytkownikom jako niedozwolone."

msgid "Use ended"
msgstr "Użytkowanie zakończone"

msgid "User departments"
msgstr "Działy użytkowników"

msgid "Waivers granted"
msgstr "Przyznane odstępstwa"

msgid "Waivers granted:"
msgstr "Przyznane odstępstwa:"

msgid "What is allowed"
msgstr "Co jest dozwolone"

msgid "matched by name"
msgstr "dopasowano po nazwie"

msgid "Approved application"
msgid_plural "Approved applications"
msgstr[0] "Zatwierdzona aplikacja"
msgstr[1] "Zatwierdzone aplikacje"
msgstr[2] "Zatwierdzone aplikacje"

msgid "%d waiver"
msgid_plural "%d waivers"
msgstr[0] "%d odstępstwo"
msgstr[1] "%d odstępstwa"
msgstr[2] "%d odstępstw"
