msgid "Asset classification"
msgstr "Classificazione dell'asset"

msgid "Patch level"
msgstr "Livello delle patch"

msgid "Software end of support"
msgstr "Fine del supporto del software"

msgid "Warranty and manufacturer end of life"
msgstr "Garanzia e fine vita del produttore"

msgid "Endpoint protection (EDR)"
msgstr "Protezione degli endpoint (EDR)"

msgid "Monitoring (Zabbix)"
msgstr "Monitoraggio (Zabbix)"

msgid "Log collection"
msgstr "Raccolta dei log"

msgid "Not classified yet: its criticality cannot set the backup, logging and patch targets."
msgstr "Non ancora classificato: la sua criticità non può fissare gli obiettivi di backup, log e patch."

#, php-format
msgid "RTO: %d h"
msgstr "RTO: %d h"

#, php-format
msgid "RPO: %d h"
msgstr "RPO: %d h"

#, php-format
msgid "Confidentiality %1$s, integrity %2$s, availability %3$s."
msgstr "Riservatezza %1$s, integrità %2$s, disponibilità %3$s."

#, php-format
msgid "Target delay: %d days"
msgstr "Termine obiettivo: %d giorni"

#, php-format
msgid "Last known patch on %1$s, %2$d days past the target delay."
msgstr "Ultima patch nota il %1$s, %2$d giorni oltre il termine obiettivo."

#, php-format
msgid "Last known patch on %s, within the target delay."
msgstr "Ultima patch nota il %s, entro il termine obiettivo."

#, php-format
msgid "%d tracked products, all still supported or with an unknown date."
msgstr "%d prodotti monitorati, tutti ancora supportati o con data sconosciuta."

#, php-format
msgid "%1$d products no longer supported, %2$d reaching end of support soon."
msgstr "%1$d prodotti non più supportati, %2$d presto a fine supporto."

#, php-format
msgid "Last seen by the console: %s"
msgstr "Visto l'ultima volta dalla console: %s"

#, php-format
msgid "%d SentinelOne alerts waiting to be reviewed for this computer."
msgstr "%d avvisi SentinelOne in attesa di verifica per questo computer."

msgid "No SentinelOne agent matched this computer."
msgstr "Nessun agente SentinelOne associato a questo computer."

msgid "SentinelOne agent active, no alert waiting."
msgstr "Agente SentinelOne attivo, nessun avviso in attesa."

msgid "SentinelOne agent inactive: the computer is no longer protected."
msgstr "Agente SentinelOne inattivo: il computer non è più protetto."

#, php-format
msgid "Availability over %1$d days: %2$s %%"
msgstr "Disponibilità su %1$d giorni: %2$s %%"

msgid "An outage exceeded the RTO of a business process."
msgstr "Un'interruzione ha superato l'RTO di un processo aziendale."

#, php-format
msgid "%1$s: %2$d open high problems, %3$d other open problems."
msgstr "%1$s: %2$d problemi alti aperti, %3$d altri problemi aperti."

#, php-format
msgid "Allowed age: %s"
msgstr "Età consentita: %s"

#, php-format
msgid "%1$s: last success on %2$s."
msgstr "%1$s: ultimo successo il %2$s."

#, php-format
msgid "%1$s: last event on %2$s."
msgstr "%1$s: ultimo evento il %2$s."

#, php-format
msgid "Platforms: %s"
msgstr "Piattaforme: %s"
