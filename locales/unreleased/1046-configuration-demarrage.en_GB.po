msgid "Getting started"
msgstr "Getting started"

msgid "All steps done"
msgstr "All steps done"

#, php-format
msgid "%1$d of %2$d steps done"
msgstr "%1$d of %2$d steps done"

msgid "The main settings to make before using the plugin. Each step is checked from what is already set up; nothing is changed from here."
msgstr "The main settings to make before using the plugin. Each step is checked from what is already set up; nothing is changed from here."

msgid "Open the setting"
msgstr "Open the setting"

msgid "Choose the frameworks"
msgstr "Choose the frameworks"

msgid "Tick the frameworks your organisation follows and save the choice: the other ones disappear from the screens."
msgstr "Tick the frameworks your organisation follows and save the choice: the other ones disappear from the screens."

msgid "Validate the risk matrix"
msgstr "Validate the risk matrix"

msgid "Check the probability x impact grid, its size and its labels, then save it, even unchanged."
msgstr "Check the probability x impact grid, its size and its labels, then save it, even unchanged."

msgid "Give the rights to a profile"
msgstr "Give the rights to a profile"

msgid "After installation, only the Super-Admin profile can use the plugin. Open a profile, then its GRC Manager tab, to give the rights to the people who work on the ISMS."
msgstr "After installation, only the Super-Admin profile can use the plugin. Open a profile, then its GRC Manager tab, to give the rights to the people who work on the ISMS."

msgid "Open the profiles"
msgstr "Open the profiles"

msgid "Choose the CISO group"
msgstr "Choose the CISO group"

msgid "The members of this group can see every audit and its documents."
msgstr "The members of this group can see every audit and its documents."

msgid "Test at least one connector"
msgstr "Test at least one connector"

msgid "Enter the address and the key of a tool you use (SentinelOne, Zabbix, Uptime Kuma, GitHub or GitLab, endoflife.date): the step is done after a first successful read."
msgstr "Enter the address and the key of a tool you use (SentinelOne, Zabbix, Uptime Kuma, GitHub or GitLab, endoflife.date): the step is done after a first successful read."

msgid "Scope the Statement of Applicability"
msgstr "Scope the Statement of Applicability"

#, php-format
msgid "Answer every question of the \"%s\" screen, in the GRC menu: the answers suggest which controls apply."
msgstr "Answer every question of the \"%s\" screen, in the GRC menu: the answers suggest which controls apply."
