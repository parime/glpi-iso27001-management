msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Power supplies"
msgstr "Fuentes de alimentación"

msgid "Disks"
msgstr "Discos"

msgid "Fans"
msgstr "Ventiladores"

msgid "Temperatures"
msgstr "Temperaturas"

msgid "Server health"
msgstr "Estado del servidor"

msgid "%d critical"
msgstr "%d crítico(s)"

msgid "%d warning"
msgstr "%d advertencia(s)"

msgid "No health detail read yet: click \"Read now\" on the controller page, or enable the scheduled reading. Controllers imported by CSV have no health detail."
msgstr "Aún no se ha leído ningún detalle de estado: haga clic en «Leer ahora» en la página de los controladores o active la lectura programada. Los controladores importados por CSV no tienen detalle de estado."

msgid "Recent events of the controller log"
msgstr "Eventos recientes del registro del controlador"

msgid "No event in the log read on the controller."
msgstr "Ningún evento en el registro leído en el controlador."

msgid "Server management controllers: reads inventory, gaps, accounts and health by Redfish (read only)"
msgstr "Controladores de gestión de servidores: lee el inventario, las desviaciones, las cuentas y el estado por Redfish (solo lectura)"

msgid "Scheduled reading: the automatic action \"bmcread\" reads every Redfish controller once a day (same read-only requests as \"Read now\", health and event log included). It is disabled after installation."
msgstr "Lectura programada: la acción automática «bmcread» lee cada controlador Redfish una vez al día (las mismas solicitudes de solo lectura que «Leer ahora», estado y registro de eventos incluidos). Está desactivada tras la instalación."

msgid "Set the automatic action"
msgstr "Configurar la acción automática"

msgid "%d component(s) in critical state"
msgstr "%d componente(s) en estado crítico"

msgid "%d component(s) with a warning"
msgstr "%d componente(s) con advertencia"

msgid "%1$d alert(s) in the controller log over the last %2$d days"
msgstr "%1$d alerta(s) en el registro del controlador en los últimos %2$d días"

msgid "A component or a recent event of the server is critical."
msgstr "Un componente o un evento reciente del servidor es crítico."

msgid "A component or a recent event of the server needs attention."
msgstr "Un componente o un evento reciente del servidor requiere atención."

msgid "Power supplies, disks, fans and temperatures read as healthy."
msgstr "Fuentes de alimentación, discos, ventiladores y temperaturas leídos en buen estado."
