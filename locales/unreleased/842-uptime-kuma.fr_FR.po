msgstr "Annoncer aux utilisateurs"

msgid "Assets published on the Internet without a monitor (Uptime Kuma)"
msgstr "Actifs publiés sur Internet sans sonde (Uptime Kuma)"

msgid "Assets published on the Internet without a monitor"
msgstr "Actifs publiés sur Internet sans sonde"

msgid "Assets that receive an \"Internet publication\" flow in the network flow matrix, but that no Uptime Kuma monitor watches: an outage would only be noticed by the users."
msgstr "Actifs qui reçoivent un flux « Publication sur Internet » dans la matrice des flux, mais qu'aucune sonde Uptime Kuma ne surveille : une panne ne serait remarquée que par les utilisateurs."

#, php-format
msgid "Availability of the exposed services (%) (Uptime Kuma)"
msgstr "Disponibilité des services exposés (%) (Uptime Kuma)"

