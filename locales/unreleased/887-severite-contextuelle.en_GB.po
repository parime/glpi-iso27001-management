msgid "A vulnerability found only on test or development machines can be fixed one step later, if the option is enabled in the remediation deadlines."
msgstr "A vulnerability found only on test or development machines can be fixed one step later, if the option is enabled in the remediation deadlines."

msgid "Adjust the level to the context of the machines"
msgstr "Adjust the level to the context of the machines"

msgid "All affected machines are in test or development and none is reachable from the Internet: the level is one step less urgent."
msgstr "All affected machines are in test or development and none is reachable from the Internet: the level is one step less urgent."

msgid "At least one affected machine is reachable from the Internet: the level, and therefore the deadline, is one step more urgent."
msgstr "At least one affected machine is reachable from the Internet: the level, and therefore the deadline, is one step more urgent."

msgid "By default, an asset targeted by an active Internet publication flow of the network flow matrix counts as reachable from the Internet: its vulnerabilities become one step more urgent."
msgstr "By default, an asset targeted by an active Internet publication flow of the network flow matrix counts as reachable from the Internet: its vulnerabilities become one step more urgent."

msgid "Deduced from the network flow matrix"
msgstr "Deduced from the network flow matrix"

msgid "Development"
msgstr "Development"

msgid "Environment"
msgstr "Environment"

msgid "Exposure to the Internet"
msgstr "Exposure to the Internet"

msgid "Internal network only"
msgstr "Internal network only"

msgid "Lowered: test or development machines only"
msgstr "Lowered: test or development machines only"

msgid "Not applicable or accepted risk: write the justification in a waiver. Once approved, the waiver replaces the deadline until its end date."
msgstr "Not applicable or accepted risk: write the justification in a waiver. Once approved, the waiver replaces the deadline until its end date."

msgid "Not reachable from the Internet"
msgstr "Not reachable from the Internet"

msgid "Not specified (counted as production)"
msgstr "Not specified (counted as production)"

msgid "One step more urgent when an affected machine is reachable from the Internet (declared in its C/I/A classification tab, or targeted by an Internet publication flow of the network flow matrix); one step less urgent when all affected machines are in test or development. Actively exploited vulnerabilities (KEV) never move, and a deadline already known is never pushed back."
msgstr "One step more urgent when an affected machine is reachable from the Internet (declared in its C/I/A classification tab, or targeted by an Internet publication flow of the network flow matrix); one step less urgent when all affected machines are in test or development. Actively exploited vulnerabilities (KEV) never move, and a deadline already known is never pushed back."

msgid "Production"
msgstr "Production"

msgid "Raised: exposed to the Internet"
msgstr "Raised: exposed to the Internet"

msgid "Reachable from the Internet"
msgstr "Reachable from the Internet"

msgid "Set aside with a justification"
msgstr "Set aside with a justification"

msgid "Test or acceptance"
msgstr "Test or acceptance"

msgid "(%d Internet publication flow in the network flow matrix)"
msgid_plural "(%d Internet publication flows in the network flow matrix)"
msgstr[0] "(%d Internet publication flow in the network flow matrix)"
msgstr[1] "(%d Internet publication flows in the network flow matrix)"
