msgid "%d control(s)"
msgstr "%d control(s)"

msgid "%d process(es)"
msgstr "%d process(es)"

msgid "%d person(s)"
msgstr "%d person(s)"

msgid "Audited controls, processes and risk categories. Objectives, criteria and the scope text are always copied."
msgstr "Audited controls, processes and risk categories. Objectives, criteria and the scope text are always copied."

msgid "Auditor, audit owner, team, people asked for evidence and auditees of the checklist. Someone who left (account disabled or without a profile in the entity) is not copied."
msgstr "Auditor, audit owner, team, people asked for evidence and auditees of the checklist. Someone who left (account disabled or without a profile in the entity) is not copied."

msgid "Audits prepared from this one"
msgstr "Audits prepared from this one"

msgid "Create the audit of the next cycle"
msgstr "Create the audit of the next cycle"

msgid "Give the new audit a title and a planned date."
msgstr "Give the new audit a title and a planned date."

msgid "Next cycle"
msgstr "Next cycle"

msgid "Only the audit team can copy the checklist."
msgstr "Only the audit team can copy the checklist."

msgid "Prepare the audit of the next cycle"
msgstr "Prepare the audit of the next cycle"

msgid "Prepares the audit of next year from this one, without typing everything again: objectives, criteria, scope, audited controls and processes, people, evidence requests and checklist questions are copied. Only the date, the title and, for an audit by the certification body, the type and the body change. The new audit starts from scratch: planned, with no result, finding, evidence file or conclusion."
msgstr "Prepares the audit of next year from this one, without typing everything again: objectives, criteria, scope, audited controls and processes, people, evidence requests and checklist questions are copied. Only the date, the title and, for an audit by the certification body, the type and the body change. The new audit starts from scratch: planned, with no result, finding, evidence file or conclusion."

msgid "Proposed one year after this audit. The due dates of the evidence requests move by the same number of days."
msgstr "Proposed one year after this audit. The due dates of the evidence requests move by the same number of days."

msgid "Proposed: the next step of the certification cycle (%s now)."
msgstr "Proposed: the next step of the certification cycle (%s now)."

msgid "Same references and descriptions, status \"Requested\", without the files sent last time. Nobody is notified: send the requests when you are ready."
msgstr "Same references and descriptions, status \"Requested\", without the files sent last time. Nobody is notified: send the requests when you are ready."

msgid "Same requirements and questions, every line back to \"Not audited\"."
msgstr "Same requirements and questions, every line back to \"Not audited\"."

msgid "The audit of the next cycle has been prepared: check its dates and people."
msgstr "The audit of the next cycle has been prepared: check its dates and people."

msgid "This audit is not changed."
msgstr "This audit is not changed."

msgid "This audit was prepared from a previous audit:"
msgstr "This audit was prepared from a previous audit:"

msgid "Title of the new audit"
msgstr "Title of the new audit"

msgid "What to copy"
msgstr "What to copy"

msgid "You need the right to create audits in the entity of this audit to prepare the next one."
msgstr "You need the right to create audits in the entity of this audit to prepare the next one."

msgid "planned on %s"
msgstr "planned on %s"

msgid "People involved"
msgstr "People involved"

msgid "%d person was not copied (account disabled or without a profile in the entity of the audit): choose someone else."
msgid_plural "%d people were not copied (account disabled or without a profile in the entity of the audit): choose someone else."
msgstr[0] "%d person was not copied (account disabled or without a profile in the entity of the audit): choose someone else."
msgstr[1] "%d people were not copied (account disabled or without a profile in the entity of the audit): choose someone else."
