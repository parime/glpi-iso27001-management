msgid "Asset classification"
msgstr "Classification de l'actif"

msgid "Patch level"
msgstr "Niveau de correctifs"

msgid "Software end of support"
msgstr "Fin de support des logiciels"

msgid "Warranty and manufacturer end of life"
msgstr "Garantie et fin de vie constructeur"

msgid "Endpoint protection (EDR)"
msgstr "Protection des postes (EDR)"

