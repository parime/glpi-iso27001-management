"Content-Type: text/plain; charset=UTF-8\n"

msgid "These settings are now in Setup > Plugins > GRC Manager, %s tab."
msgstr "Estos ajustes están ahora en Configuración > Plugins > GRC Manager, pestaña %s."

msgid "Connection to Zabbix %s succeeded."
msgstr "Conexión con Zabbix %s correcta."

msgid "Connection to Uptime Kuma succeeded."
msgstr "Conexión con Uptime Kuma correcta."

msgid "Connection to Veeam succeeded."
msgstr "Conexión con Veeam correcta."

msgid "The DNS server answers the DNSSEC questions."
msgstr "El servidor DNS responde a las consultas DNSSEC."

msgid "The DNS server did not answer the DNSSEC question: DNSSEC will show \"Unknown\". Enter another DNS server."
msgstr "El servidor DNS no ha respondido a la consulta DNSSEC: DNSSEC mostrará «Desconocido». Indique otro servidor DNS."

msgid "See the results"
msgstr "Ver los resultados"

msgid "Set up the connection"
msgstr "Configurar la conexión"

msgid "Change the settings"
msgstr "Modificar los ajustes"

msgid "Read automatically every day"
msgstr "Lectura automática cada día"

msgid "Read automatically every hour"
msgstr "Lectura automática cada hora"

msgid "Read on click only"
msgstr "Lectura solo al hacer clic"

msgid "Nothing has been read from Zabbix yet: set up the connection in the configuration, then click \"Read now\". Until then, every asset concerned is shown as not monitored."
msgstr "Todavía no se ha leído nada de Zabbix: configure la conexión en la configuración y luego haga clic en «Leer ahora». Mientras tanto, cada activo afectado aparece como no supervisado."

msgid "Nothing has been read from Uptime Kuma yet: set up the connection in the configuration, then click \"Read now\"."
msgstr "Todavía no se ha leído nada de Uptime Kuma: configure la conexión en la configuración y luego haga clic en «Leer ahora»."
