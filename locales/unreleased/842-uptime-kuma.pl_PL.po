msgstr "Monitory: %1$d, okres %2$d dni"

#, php-format
msgid "%1$d monitors: the first %2$d are shown, services down first."
msgstr "Monitory: %1$d, wyświetlono pierwsze %2$d, najpierw niedostępne usługi."

#, php-format
msgid "%1$s: %2$s %% available"
msgstr "%1$s: dostępność %2$s %%"

