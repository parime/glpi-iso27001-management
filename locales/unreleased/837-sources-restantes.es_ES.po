msgstr "Visto por última vez por la consola: %s"

#, php-format
msgid "%d SentinelOne alerts waiting to be reviewed for this computer."
msgstr "%d alertas de SentinelOne pendientes de revisión para este equipo."

msgid "No SentinelOne agent matched this computer."
msgstr "Ningún agente de SentinelOne coincide con este equipo."

msgid "SentinelOne agent active, no alert waiting."
msgstr "Agente de SentinelOne activo, ninguna alerta pendiente."

msgid "SentinelOne agent inactive: the computer is no longer protected."
msgstr "Agente de SentinelOne inactivo: el equipo ya no está protegido."

#, php-format
msgid "Availability over %1$d days: %2$s %%"
msgstr "Disponibilidad en %1$d días: %2$s %%"

msgid "An outage exceeded the RTO of a business process."
msgstr "Una interrupción superó el RTO de un proceso de negocio."

#, php-format
msgid "%1$s: %2$d open high problems, %3$d other open problems."
msgstr "%1$s: %2$d problemas altos abiertos, %3$d otros problemas abiertos."

#, php-format
