msgstr "Antigüedad permitida: %s"

#, php-format
msgid "%1$s: last success on %2$s."
msgstr "%1$s: último éxito el %2$s."

#, php-format
msgid "%1$s: last event on %2$s."
msgstr "%1$s: último evento el %2$s."

