{# Issue #779 : conformité des licences logicielles (A.5.32), par entité, dans les entités de la
   personne. Aucune donnée de GLPI n'est modifiée depuis cette page. #}
<div id="grc-license-compliance">
   <div class="row row-cards mb-3">
      {% for code, info in infos %}
         <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body" title="{{ info.help }}">
            <div class="d-flex align-items-center">
               <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-2 fs-3"><i class="{{ info.icon }}"></i></span>
               <div>
                  <div class="fw-bold fs-3">{{ counts[code] }}</div>
                  <div class="small">{{ info.label }}</div>
               </div>
            </div>
            <div class="small text-muted mt-1">{{ info.help }}</div>
         </div></div></div>
      {% endfor %}
   </div>

   {# Lot 2 : taux de couverture des logiciels commerciaux surveillés installés. #}
   {% if coverage is not null and coverage.watched > 0 %}
      {% set cov_color = coverage.percent >= 100 ? 'success' : (coverage.percent >= 80 ? 'warning' : 'danger') %}
      <div class="card card-sm mb-3" id="grc-license-coverage"><div class="card-body">
         <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="badge bg-{{ cov_color }}-subtle text-{{ cov_color }}-emphasis fs-3"><i class="ti ti-shield-check me-1"></i>{{ __('License coverage: %d%%', 'grcmanager')|format(coverage.percent) }}</span>
            <span>{{ __('%1$d of %2$d watched commercial software installed (per entity) have a valid license.', 'grcmanager')|format(coverage.licensed, coverage.watched) }}</span>
         </div>
         <div class="progress progress-sm" role="progressbar" aria-label="{{ __('License coverage', 'grcmanager') }}" aria-valuenow="{{ coverage.percent }}" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar bg-{{ cov_color }}" style="width: {{ coverage.percent }}%"></div>
         </div>
      </div></div>
   {% endif %}

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted small me-auto">
         <i class="ti ti-info-circle me-1"></i>{{ __('A license counts for an entity when it belongs to it, or when it is recursive and belongs to a parent entity. Nothing is changed in GLPI from this page.', 'grcmanager') }}
      </span>
      <a class="btn btn-sm btn-outline-secondary" href="{{ license_search_url }}"><i class="ti ti-license me-1"></i>{{ __('Licenses in GLPI', 'grcmanager') }}</a>
      <a class="btn btn-sm btn-outline-primary" href="{{ export_url }}"><i class="ti ti-file-spreadsheet me-1"></i>{{ __('Export (CSV)', 'grcmanager') }}</a>
   </div>

   {% if total > shown %}
      <p class="small">{{ __('%1$d findings: the first %2$d are shown, all of them are in the export.', 'grcmanager')|format(total, shown) }}</p>
   {% endif %}

   {% if groups is empty %}
      <div class="alert alert-success d-flex align-items-center">
         <i class="ti ti-circle-check me-2"></i>
         <div>{{ __('No finding in your entities: every watched commercial software has a license, no license is overused, and no expired license is still in use.', 'grcmanager') }}</div>
      </div>
   {% else %}
      {% for group in groups %}
         <div class="card mb-3">
            <div class="card-header">
               <h3 class="card-title"><i class="ti ti-building me-2"></i>{{ group.entity }}</h3>
               <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ _n('%d finding', '%d findings', group.rows|length, 'grcmanager')|format(group.rows|length) }}</span></div>
            </div>
            <div class="table-responsive">
               <table class="table table-vcenter card-table">
                  <thead><tr>
                     <th>{{ __('Finding', 'grcmanager') }}</th>
                     <th>{{ __('Software', 'grcmanager') }}</th>
                     <th>{{ __('Detail', 'grcmanager') }}</th>
                     <th>{{ __('Assets', 'grcmanager') }}</th>
                  </tr></thead>
                  <tbody>
                  {% for row in group.rows %}
                     <tr>
                        <td><span class="badge bg-{{ row.info.color }}-subtle text-{{ row.info.color }}-emphasis" title="{{ row.info.help }}"><i class="{{ row.info.icon }} me-1"></i>{{ row.info.label }}</span>
                           {% if row.subtree %}<div class="small text-muted mt-1"><i class="ti ti-sitemap me-1"></i>{{ __('Shared with the sub-entities', 'grcmanager') }}</div>{% endif %}
                           {% if row.overquota_allowed %}<div class="mt-1"><span class="badge bg-info-subtle text-info-emphasis"><i class="ti ti-receipt me-1"></i>{{ __('Over-quota allowed', 'grcmanager') }}</span></div>{% endif %}
                        </td>
                        <td>
                           <a href="{{ row.software_url }}">{{ row.software_name }}</a>
                           {% if row.manufacturer %}<div class="small text-muted">{{ row.manufacturer }}</div>{% endif %}
                           {% if row.licence_url %}<div class="small"><i class="ti ti-license me-1"></i><a href="{{ row.licence_url }}">{{ row.licence_name }}</a></div>{% endif %}
                        </td>
                        <td class="small">{{ row.detail }}</td>
                        <td class="small">
                           {% for asset in row.assets %}
                              {% if asset.url %}<a href="{{ asset.url }}">{{ asset.name }}</a>{% else %}{{ asset.name }}{% endif %}{% if not loop.last %}, {% endif %}
                           {% endfor %}
                           {% if row.more_assets > 0 %}<span class="text-muted">{{ __('and %d more', 'grcmanager')|format(row.more_assets) }}</span>{% endif %}
                        </td>
                     </tr>
                  {% endfor %}
                  </tbody>
               </table>
            </div>
         </div>
      {% endfor %}
   {% endif %}

   <div class="card mt-3" id="grc-license-watch">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-eye me-2"></i>{{ __('Watched commercial publishers', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="text-muted small">{{ __('Software from these publishers (manufacturer in GLPI) must have a license recorded. Software whose name contains one of the ignored words (free tools from the same publishers) is never reported as missing a license.', 'grcmanager') }}</p>
         {% if can_config %}
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="row g-3">
                  <div class="col-md-6">
                     <label class="form-label" for="grc-license-publishers">{{ __('Watched publishers (one per line)', 'grcmanager') }}</label>
                     <textarea class="form-control" id="grc-license-publishers" name="license_publishers" rows="8">{{ publishers }}</textarea>
                  </div>
                  <div class="col-md-6">
                     <label class="form-label" for="grc-license-ignored">{{ __('Ignored software (part of the name, one per line)', 'grcmanager') }}</label>
                     <textarea class="form-control" id="grc-license-ignored" name="license_ignored" rows="8">{{ ignored }}</textarea>
                  </div>
               </div>
               <div class="row g-3 mt-1">
                  <div class="col-md-6">
                     <label class="form-label" for="grc-license-expiring">{{ __('Warn before a license expires (days, 0 to turn off)', 'grcmanager') }}</label>
                     <input type="number" class="form-control" id="grc-license-expiring" name="license_expiring_days" min="0" max="{{ max_expiring_days }}" step="1" value="{{ expiring_days }}">
                  </div>
               </div>
               <div class="mt-3 d-flex gap-2">
                  <button type="submit" class="btn btn-primary" name="save_license_watch" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
                  <button type="submit" class="btn btn-outline-secondary" name="reset_license_watch" value="1"><i class="ti ti-restore me-1"></i>{{ __('Back to the default lists', 'grcmanager') }}</button>
               </div>
            </form>
         {% else %}
            <p class="small mb-2"><i class="ti ti-calendar-time me-1"></i>{{ expiring_days > 0 ? __('Warning %d days before a license expires.', 'grcmanager')|format(expiring_days) : __('No warning before a license expires.', 'grcmanager') }}</p>
            <div class="d-flex flex-wrap gap-1">
               {% for publisher in publisher_list %}<span class="badge bg-secondary-subtle text-secondary-emphasis">{{ publisher }}</span>{% endfor %}
            </div>
         {% endif %}
      </div>
   </div>
</div>
