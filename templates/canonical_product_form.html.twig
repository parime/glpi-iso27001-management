{# Produit du catalogue de correspondance CPE (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('manufacturer', item.fields['manufacturer'], __('Vendor / manufacturer', 'grcmanager'), {
      'add_field_html': hints.hint(__('Short name, e.g. "Apache", "Microsoft" - used only as a label, never for matching.', 'grcmanager')),
   }) }}
   {{ fields.textField('product', item.fields['product'], __('Product', 'grcmanager')) }}
{% endblock %}
