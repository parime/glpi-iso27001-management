{# Issue #170 : formulaire d'une dérogation de sécurité #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
   {{ fields.textField('name', item.fields['name'], __('Nom'), {'required': true}) }}
   {{ fields.htmlField('', '<span class="badge ' ~ state.class ~ '">' ~ state.label|e ~ '</span>', __('État', 'grcmanager')) }}

   {{ fields.dropdownArrayField('status', item.fields['status'], statuses, __('Statut')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Responsable (accepte le risque)', 'grcmanager'), {
      'right': 'all',
      'helper': __('La personne qui accepte le risque de la dérogation, prévenue avant sa fin.', 'grcmanager'),
   }) }}

   {{ fields.dateField('date_begin', item.fields['date_begin'], __('Date de début', 'grcmanager')) }}
   {{ fields.dateField('date_end', item.fields['date_end'], __('Date de fin', 'grcmanager'), {
      'required': true,
      'helper': __('Une dérogation est temporaire. Le responsable est prévenu 15 jours avant ; à l\'échéance, un ticket de réévaluation est ouvert. Rien n\'est prolongé ni clos automatiquement.', 'grcmanager'),
   }) }}

   {{ fields.dropdownField('PluginGrcmanagerControl', 'plugin_grcmanager_controls_id', item.fields['plugin_grcmanager_controls_id'], __('Mesure de l\'Annexe A', 'grcmanager')) }}
   {{ fields.dropdownField('PluginGrcmanagerPolicy', 'plugin_grcmanager_policies_id', item.fields['plugin_grcmanager_policies_id'], __('Politique', 'grcmanager')) }}

   {% if approver %}
      {{ fields.htmlField('', approver|e ~ ' — ' ~ item.fields['date_approval']|formatted_datetime, __('Validée par', 'grcmanager')) }}
   {% endif %}

   {{ fields.textareaField('description', item.fields['description'], __('Justification', 'grcmanager'), {
      'full_width': true,
      'helper': __('Pourquoi l\'exception est nécessaire (ex. application qui ne fonctionne que sur un système en fin de support).', 'grcmanager'),
   }) }}
   {{ fields.textareaField('compensating_measures', item.fields['compensating_measures'], __('Mesures compensatoires', 'grcmanager'), {
      'full_width': true,
      'helper': __('Ce qui réduit le risque pendant la dérogation (isolement réseau, surveillance renforcée, accès restreint...).', 'grcmanager'),
   }) }}

   {{ fields.smallTitle(__('Actifs concernés', 'grcmanager'), 'ti ti-device-desktop') }}
   {% for group in groups %}
      {{ fields.dropdownField(group.itemtype, group.field, group.values, group.label, {'multiple': true}) }}
   {% endfor %}
{% endblock %}
