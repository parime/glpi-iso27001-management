{# Issue #170 : formulaire d'une dérogation de sécurité #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('name', item.fields['name'], __('Nom'), {'required': true}) }}
   {{ fields.htmlField('', '<span class="badge ' ~ state.class ~ '">' ~ state.label|e ~ '</span>', _x('state', 'Status', 'grcmanager')) }}

   {{ fields.dropdownArrayField('status', item.fields['status'], statuses, __('Statut')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Owner (accepts the risk)', 'grcmanager'), {
      'right': 'all',
      'add_field_html': hints.hint(__('The person who accepts the waiver\'s risk, warned before it ends.', 'grcmanager')),
   }) }}

   {{ fields.dateField('date_begin', item.fields['date_begin'], __('Start date', 'grcmanager')) }}
   {{ fields.dateField('date_end', item.fields['date_end'], __('End date', 'grcmanager'), {
      'required': true,
      'add_field_html': hints.hint(__('A waiver is temporary. The owner is warned 15 days before; when it ends, a re-assessment ticket is opened. Nothing is extended or closed automatically.', 'grcmanager')),
   }) }}

   {{ fields.dropdownArrayField('plugin_grcmanager_controls_id', item.fields['plugin_grcmanager_controls_id'], controls, _x('measure', 'Annex A control', 'grcmanager')) }}
   {{ fields.dropdownArrayField('plugin_grcmanager_policies_id', item.fields['plugin_grcmanager_policies_id'], policies, __('Policy', 'grcmanager')) }}

   {% if requester %}
      {{ fields.htmlField('', requester|e, __('Requested by', 'grcmanager')) }}
   {% endif %}
   {% if approver %}
      {{ fields.htmlField('', approver|e ~ ' — ' ~ item.fields['date_approval']|formatted_datetime, __('Approved by', 'grcmanager')) }}
   {% endif %}

   {{ fields.textareaField('description', item.fields['description'], __('Justification', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Why the exception is needed (e.g. an application that only runs on an end-of-support system).', 'grcmanager')),
   }) }}
   {{ fields.textareaField('compensating_measures', item.fields['compensating_measures'], __('Compensating controls', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('What reduces the risk during the waiver (network isolation, closer monitoring, restricted access...).', 'grcmanager')),
   }) }}

   {{ fields.smallTitle(__('Assets concerned', 'grcmanager'), 'ti ti-device-desktop') }}
   {% for group in groups %}
      {{ fields.dropdownField(group.itemtype, group.field, group.values, group.label, {'multiple': true}) }}
   {% endfor %}
{% endblock %}
