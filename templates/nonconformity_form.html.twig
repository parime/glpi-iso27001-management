{# Formulaire d'une non-conformité ou observation (CAPA). Issue #163 : origine incident/CVE. #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {% if incident %}
      <input type="hidden" name="plugin_grcmanager_securityincidents_id" value="{{ incident.id }}">
      <input type="hidden" name="cve_id" value="{{ item.fields['cve_id'] }}">
      {{ fields.htmlField('', '<a href="' ~ incident.url|e ~ '"><i class="ti ti-shield-exclamation me-1"></i>' ~ incident.name|e ~ '</a>'
         ~ (item.fields['cve_id'] ? ' - <a href="https://nvd.nist.gov/vuln/detail/' ~ item.fields['cve_id']|e ~ '" target="_blank" rel="noopener">' ~ item.fields['cve_id']|e ~ '</a>' : ''),
         __('Origin', 'grcmanager')) }}
      {% if item.isNewItem() %}
         <div class="col-12 mb-2">
            <div class="alert alert-info mb-0"><i class="ti ti-bulb me-1"></i>{{ __('Action plan proposed from the CVE: review and adapt each field, then click "Add". Nothing is created before.', 'grcmanager') }}</div>
         </div>
      {% endif %}
   {% endif %}

   {# Issue #606 : constat proposé depuis une ligne de la grille d'audit, et lien retour vers la grille. #}
   {% if checklist_draft %}
      <input type="hidden" name="_grcmanager_checklistitem" value="{{ checklist_draft.line_id }}">
      <div class="col-12 mb-2">
         <div class="alert alert-info mb-0" id="grc-checklist-draft"><i class="ti ti-list-details me-1"></i>{{ __('Finding proposed from the audit checklist (%s): review and adapt each field, then click "Add". Nothing is created before, and the checklist line is linked to this finding once it is saved.', 'grcmanager')|format(checklist_draft.line_title) }}</div>
      </div>
   {% endif %}
   {% if checklist_lines is not empty %}
      {% set checklist_html %}
         {% for line in checklist_lines %}
            <div class="mb-1 grc-checklist-backlink"><a href="{{ line.url }}"><i class="ti ti-list-details me-1"></i>{{ line.title }}</a>
               <span class="badge {{ line.result_class }} ms-1"><i class="ti {{ line.result_icon }} me-1"></i>{{ line.result }}</span>
               <span class="text-muted small ms-1">{{ line.audit }}</span></div>
         {% endfor %}
      {% endset %}
      {{ fields.htmlField('', checklist_html, __('Audit checklist line', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #778 : action proposée depuis l'évaluation de la sécurité physique d'un site. #}
   {% if physical_draft %}
      <input type="hidden" name="_grcmanager_physicalsecuritycheck" value="{{ physical_draft.line_id }}">
      <div class="col-12 mb-2">
         <div class="alert alert-info mb-0" id="grc-physical-draft"><i class="ti ti-building-fortress me-1"></i>{{ __('Action proposed from the physical security assessment (%s): review and adapt each field, set an owner and a due date, then click "Add". Nothing is created before, and the assessment line is linked to this action once it is saved.', 'grcmanager')|format(physical_draft.line_title) }}</div>
      </div>
   {% endif %}
   {% if physical_lines is not empty %}
      {% set physical_html %}
         {% for line in physical_lines %}
            <div class="mb-1 grc-physical-backlink"><a href="{{ line.url }}"><i class="ti ti-building-fortress me-1"></i>{{ line.title }}</a>
               <span class="badge {{ line.state_class }} ms-1">{{ line.state }}</span>
               <span class="text-muted small ms-1">{{ line.site }}</span></div>
         {% endfor %}
      {% endset %}
      {{ fields.htmlField('', physical_html, __('Physical security', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true}) }}
   {# Issue #772 : constat d'un audit de certification : vocabulaire et référence de l'organisme. #}
   {% if certification %}
      {{ fields.dropdownArrayField('_certification_category', certification_category, certification_categories, __('Finding of the certification body', 'grcmanager'), {
         'add_field_html': hints.hint(__('A corrective action is required to close a nonconformity; it is optional for an area of concern or an opportunity for improvement.', 'grcmanager')),
      }) }}
   {% else %}
      {{ fields.dropdownArrayField('finding_type', item.fields['finding_type'] ?: 'nonconformity', finding_types, __('Finding type', 'grcmanager')) }}
   {% endif %}
   {{ fields.dropdownArrayField('plugin_grcmanager_audits_id', item.fields['plugin_grcmanager_audits_id'], audits, audit_label) }}
   {% if certification %}
      {{ fields.textField('body_reference', item.fields['body_reference'], __('Certification body reference', 'grcmanager'), {
         'placeholder': 'GVE-36',
         'add_field_html': hints.hint(__('Reference given to the finding in the certification body report.', 'grcmanager')),
      }) }}
   {% else %}
      {{ fields.dropdownArrayField('severity', item.fields['severity'] ?: 'minor', severities, __('Severity', 'grcmanager')) }}
   {% endif %}
   {# Issue #772, lot 2 : processus du programme d'audit proposés, pour rapprocher le constat du
      plan d'audit de l'organisme (texte libre accepté). #}
   {% set process_list %}
      <datalist id="grc-audited-process-list">
         {% for label in process_labels %}<option value="{{ label }}"></option>{% endfor %}
      </datalist>
   {% endset %}
   {{ fields.textField('audited_process', item.fields['audited_process'], __('Audited process', 'grcmanager'), {
      'additional_attributes': {'list': 'grc-audited-process-list', 'autocomplete': 'off'},
      'add_field_html': process_list,
   }) }}
   {{ fields.textField('requirement_reference', item.fields['requirement_reference'], __('Clause or control', 'grcmanager'), {
      'placeholder': 'A.8.8',
   }) }}
   {{ fields.dropdownField('Location', 'locations_id', item.fields['locations_id'], __('Site', 'grcmanager'), {
      'entity': item.fields['entities_id'],
   }) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: 'open', statuses, __('Status', 'grcmanager')) }}
   {{ fields.dateField('due_date', item.fields['due_date'], __('Due date', 'grcmanager')) }}
   {{ fields.dateField('closure_verification_date', item.fields['closure_verification_date'], __('Closure verification date', 'grcmanager')) }}

   {{ fields.textareaField('description', item.fields['description'], __('Description', 'grcmanager'), {'full_width': true}) }}
   {{ fields.textareaField('root_cause', item.fields['root_cause'], __('Root cause', 'grcmanager'), {'full_width': true}) }}
   {{ fields.textareaField('corrective_action', item.fields['corrective_action'], __('Corrective action', 'grcmanager'), {
      'full_width': true,
      'rows': 8,
      'add_field_html': hints.hint(corrective_hint),
   }) }}
   {{ fields.textareaField('preventive_action', item.fields['preventive_action'], __('Preventive action', 'grcmanager'), {
      'full_width': true,
      'rows': 4,
   }) }}
{% endblock %}
