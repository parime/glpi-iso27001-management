{# Issue #545 : catalogue de modèles de politiques prêts à adapter, importés en brouillon #}
{% import 'components/form/fields_macros.html.twig' as fields %}
<div class="container-fluid">
   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <h2 class="mb-0"><i class="ti ti-template me-1"></i>{{ __('Policy templates', 'grcmanager') }}</h2>
      <a class="btn btn-outline-secondary ms-auto" href="{{ policies_url }}"><i class="ti ti-list me-1"></i>{{ __('Policy library', 'grcmanager') }}</a>
      {% if coverage_url %}
         <a class="btn btn-outline-secondary" href="{{ coverage_url }}"><i class="ti ti-file-check me-1"></i>{{ __('Control coverage by policies', 'grcmanager') }}</a>
      {% endif %}
   </div>

   <div class="alert alert-info">
      <i class="ti ti-info-circle me-1"></i>{{ __('Each template is written by the project in its own words, without copying the text of the standard, and is offered under the %s licence: you may adapt it freely. Importing a template creates a new draft policy; review it, adapt it to your practice and have it approved like any other policy.', 'grcmanager')|format(license) }}
   </div>

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted">{{ __('Language of the templates:', 'grcmanager') }}</span>
      {% for code, label in languages %}
         {% if code == language %}
            <span class="badge bg-blue-subtle text-blue-emphasis"><i class="ti ti-language me-1"></i>{{ label }}</span>
         {% else %}
            <a class="badge bg-secondary-subtle text-secondary-emphasis" href="{{ action }}?language={{ code }}">{{ label }}</a>
         {% endif %}
      {% endfor %}
   </div>

   <form method="post" action="{{ action }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="language" value="{{ language }}">
      {% if can_import %}
         <div class="card mb-3">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-variable me-1"></i>{{ __('Values inserted into the text', 'grcmanager') }}</h3></div>
            <div class="card-body">
               <div class="row">
                  {{ fields.textField('organisation', organisation, __('Organisation name', 'grcmanager')) }}
                  {{ fields.dropdownField('User', 'ciso_users_id', ciso_users_id, __('Information security manager', 'grcmanager'), {'right': 'all'}) }}
                  {{ fields.numberField('review_months', review_months, __('Review period (months)', 'grcmanager'), {'min': review_min, 'max': review_max}) }}
               </div>
               <p class="text-muted small mb-0">{{ __('A value left empty is replaced by a reminder in square brackets, to be completed in the policy. The information security manager becomes the owner of the policies created.', 'grcmanager') }}</p>
            </div>
         </div>
      {% endif %}

      <div class="row row-cards">
         {% for key, template in templates %}
            <div class="col-md-6 col-xl-4">
               <div class="card h-100">
                  <div class="card-header">
                     <label class="form-check mb-0 w-100">
                        {% if can_import %}
                           <input class="form-check-input" type="checkbox" name="keys[]" value="{{ key }}">
                        {% endif %}
                        <span class="form-check-label fw-bold">{{ template.title }}</span>
                     </label>
                  </div>
                  <div class="card-body">
                     <p>{{ template.summary }}</p>
                     <div class="mb-2">
                        {% for code in template.controls %}
                           <span class="badge bg-azure-subtle text-azure-emphasis me-1" title="{{ control_titles[code] ?? code }}">{{ code }}</span>
                        {% endfor %}
                     </div>
                     <details>
                        <summary class="small">{{ __('Sections', 'grcmanager') }} ({{ template.sections|length }})</summary>
                        <ul class="small mb-0">
                           {% for section in template.sections %}
                              <li>{{ section.title }}{% if section.controls %} <span class="text-muted">({{ section.controls|join(', ') }})</span>{% endif %}</li>
                           {% endfor %}
                        </ul>
                     </details>
                  </div>
                  {% if imported[key] is defined %}
                     <div class="card-footer small">
                        <span class="badge bg-green-subtle text-green-emphasis me-1"><i class="ti ti-circle-check me-1"></i>{{ __('Already imported', 'grcmanager') }}</span>
                        {% for id, title in imported[key] %}
                           <a href="{{ policy_url }}?id={{ id }}">{{ title }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                     </div>
                  {% endif %}
               </div>
            </div>
         {% endfor %}
      </div>
      {% if can_import %}
         <div class="mt-3">
            <button type="submit" name="import" value="1" class="btn btn-primary"><i class="ti ti-file-import me-1"></i>{{ __('Create the ticked policies as drafts', 'grcmanager') }}</button>
         </div>
      {% endif %}
   </form>
</div>
