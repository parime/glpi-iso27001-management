{# Issue #771 : onglet « Contacts officiels » d'un incident de sécurité ou d'une violation de données.
   Lot 2 : échéance de chaque contact, prises de contact tracées et formulaire pour en tracer une. #}
<div class="d-flex align-items-center flex-wrap gap-2 mb-3">
   <div class="text-secondary me-auto">
      <i class="ti ti-info-circle me-1"></i>{{ intro }}
   </div>
   <a href="{{ export_url }}" class="btn btn-sm btn-outline-primary"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Print the register (PDF)', 'grcmanager') }}</a>
   <a href="{{ register_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-address-book me-1"></i>{{ __('Open the register', 'grcmanager') }}</a>
</div>

<div class="alert alert-info d-flex align-items-start">
   <i class="ti ti-help-circle me-2 mt-1"></i>
   <div>
      <strong>{{ __('Keep a trace of every official contact', 'grcmanager') }}</strong>
      <div>{{ __('When you call or write to an authority, a CSIRT or the police, record it here with the file number they gave you. If you decide that a contact did not need to be informed, record that decision and its reason: auditors ask for both. Nothing is sent from this page.', 'grcmanager') }}</div>
      {% if start %}
         <div class="small mt-1"><i class="ti ti-clock me-1"></i>{{ __('%1$s: %2$s. The deadline of each contact is computed from this date and its time limit in hours.', 'grcmanager')|format(start_label, start|formatted_datetime) }}</div>
      {% endif %}
   </div>
</div>

{% if contacts is empty %}
   <div class="alert alert-info d-flex align-items-center">
      <i class="ti ti-address-book me-2"></i>
      <div>
         {{ __('No official contact is marked for this type of event yet.', 'grcmanager') }}
         {% if can_create %}<a href="{{ add_url }}">{{ __('Add an official contact', 'grcmanager') }}</a>{% endif %}
      </div>
   </div>
{% else %}
   <div class="card mb-3">
      {% include '@grcmanager/_official_contact_rows.html.twig' with {'contacts': contacts, 'multi': false, 'notices': notices, 'can_record': can_record} only %}
   </div>
{% endif %}

{% if can_record %}
   <form method="post" action="{{ form_url }}" class="card mb-3" id="grcmanager-trace-contact-form">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="itemtype" value="{{ itemtype }}">
      <input type="hidden" name="items_id" value="{{ items_id }}">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-phone-outgoing me-2"></i>{{ __('Record a contact', 'grcmanager') }}</h3>
      </div>
      <div class="card-body row g-3">
         <div class="col-12 col-md-6">
            <label class="form-label" for="grcmanager-trace-contact">{{ _n('Official contact', 'Official contacts', 1, 'grcmanager') }}</label>
            <select class="form-select" id="grcmanager-trace-contact" name="{{ contact_fk }}" required>
               {% for id, name in choices %}
                  <option value="{{ id }}">{{ name }}</option>
               {% endfor %}
            </select>
         </div>
         <div class="col-12 col-md-6">
            <label class="form-label" for="grcmanager-trace-decision">{{ __('Decision', 'grcmanager') }}</label>
            <select class="form-select" id="grcmanager-trace-decision" name="decision">
               {% for key, label in decisions %}
                  <option value="{{ key }}">{{ label }}</option>
               {% endfor %}
            </select>
         </div>
         <div class="col-12 col-md-6">
            <label class="form-label" for="grcmanager-trace-date">{{ __('Date and time', 'grcmanager') }}</label>
            <input type="datetime-local" class="form-control" id="grcmanager-trace-date" name="date_notified" value="{{ now }}" max="{{ now }}" required>
         </div>
         <div class="col-12 col-md-6">
            <label class="form-label" for="grcmanager-trace-reference">{{ __('Reference', 'grcmanager') }}</label>
            <input type="text" class="form-control" id="grcmanager-trace-reference" name="reference" maxlength="255"
               placeholder="{{ __('File number, acknowledgement of receipt', 'grcmanager') }}">
         </div>
         <div class="col-12">
            <label class="form-label" for="grcmanager-trace-comment">{{ __('Comment', 'grcmanager') }}</label>
            <textarea class="form-control" id="grcmanager-trace-comment" name="comment" rows="2"
               placeholder="{{ __('Channel used, person reached; required reason when the contact was not needed', 'grcmanager') }}"></textarea>
         </div>
      </div>
      <div class="card-footer text-end">
         <button type="submit" name="add" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Record the contact', 'grcmanager') }}</button>
      </div>
   </form>
   <script>
      $(function () {
         $('.grcmanager-trace-contact').on('click', function () {
            $('#grcmanager-trace-contact').val($(this).data('contact'));
            document.getElementById('grcmanager-trace-contact-form').scrollIntoView({behavior: 'smooth'});
            $('#grcmanager-trace-reference').trigger('focus');
         });
      });
   </script>
{% endif %}

<h4 class="mt-3"><i class="ti ti-history me-1"></i>{{ _n('Recorded contact', 'Recorded contacts', 2, 'grcmanager') }}</h4>
{% if traces is empty %}
   <p class="text-secondary">{{ __('No contact recorded for this event yet.', 'grcmanager') }}</p>
{% else %}
   <div class="card">
      <div class="table-responsive">
         <table class="table table-hover card-table">
            <thead>
               <tr>
                  <th>{{ __('Date and time', 'grcmanager') }}</th>
                  <th>{{ _n('Official contact', 'Official contacts', 1, 'grcmanager') }}</th>
                  <th>{{ __('Decision', 'grcmanager') }}</th>
                  <th>{{ __('Reference', 'grcmanager') }}</th>
                  <th>{{ __('Comment', 'grcmanager') }}</th>
                  <th>{{ __('Recorded by', 'grcmanager') }}</th>
                  {% if can_record %}<th><span class="visually-hidden">{{ __('Actions') }}</span></th>{% endif %}
               </tr>
            </thead>
            <tbody>
               {% for trace in traces %}
                  <tr>
                     <td>{{ trace.date|formatted_datetime }}</td>
                     <td>{% if trace.contact_url %}<a href="{{ trace.contact_url }}">{{ trace.contact }}</a>{% else %}<span class="text-secondary">{{ trace.contact }}</span>{% endif %}</td>
                     <td>
                        {% if trace.decision == 'notified' %}
                           <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-phone-check me-1"></i>{{ trace.decision_label }}</span>
                        {% else %}
                           <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-file-check me-1"></i>{{ trace.decision_label }}</span>
                        {% endif %}
                     </td>
                     <td>{{ trace.reference ?: '-' }}</td>
                     <td>
                        {% if trace.from_communication|default(false) %}<span class="badge bg-purple-subtle text-purple-emphasis mb-1"><i class="ti ti-speakerphone me-1"></i>{{ __('From a crisis communication', 'grcmanager') }}</span><br>{% endif %}
                        {{ trace.comment ? trace.comment|nl2br : '-' }}
                     </td>
                     <td>{{ trace.author }}</td>
                     {% if can_record %}
                        <td class="text-end">
                           <form method="post" action="{{ form_url }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="id" value="{{ trace.id }}">
                              <button type="submit" name="purge" value="1" class="btn btn-sm btn-ghost-danger"
                                 title="{{ __('Remove this recorded contact (entered by mistake). The removal stays in the history.', 'grcmanager') }}"
                                 onclick="return confirm('{{ __('Remove this recorded contact?', 'grcmanager')|e('js') }}');">
                                 <i class="ti ti-trash"></i>
                              </button>
                           </form>
                        </td>
                     {% endif %}
                  </tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   </div>
{% endif %}
