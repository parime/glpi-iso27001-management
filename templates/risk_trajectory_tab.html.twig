{# Issue #871 : onglet « Trajectoire projetée » d'un risque (6.1.3 et 8.3), en lecture seule. #}
<div class="card" id="grc-risk-trajectory">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-chart-line me-2"></i>{{ __('Projected trajectory', 'grcmanager') }}</h3>
      <div class="card-actions">
         <a class="btn btn-sm btn-ghost-secondary" href="{{ heatmap_url }}"><i class="ti ti-grid-dots me-1"></i>{{ __('Trajectory of the whole register', 'grcmanager') }}</a>
      </div>
   </div>
   <div class="card-body">
      <div class="alert alert-info mb-3">
         <h4 class="alert-title"><i class="ti ti-help-circle me-1"></i>{{ __('What is this tab for?', 'grcmanager') }}</h4>
         <div class="text-secondary">{{ __('It shows how the level of this risk should go down as the treatment plan is carried out, and compares it with what has actually been done. The curve starts from the current level and reaches the target level once every action is completed; each action counts for an equal share. Useful to show an auditor that the treatment plan is followed (ISO/IEC 27001, clauses 6.1.3 and 8.3).', 'grcmanager') }}</div>
      </div>

      <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
         <div><span class="text-secondary small d-block">{{ __('Current level', 'grcmanager') }}</span>{% if current_level %}{% include '@grcmanager/_badge.html.twig' with current_level only %}{% endif %}</div>
         <div><span class="text-secondary small d-block">{{ __('Target level after treatment', 'grcmanager') }}</span>
            {% if target_level %}{% include '@grcmanager/_badge.html.twig' with target_level only %}{% else %}<span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-help me-1"></i>{{ __('To be assessed', 'grcmanager') }}</span>{% endif %}
         </div>
         <div><span class="text-secondary small d-block">{{ __('Progress of the plan', 'grcmanager') }}</span>
            <span class="badge {{ state.class }}" id="grc-risk-trajectory-state"><i class="ti {{ state.icon }} me-1"></i>{{ state.label }}</span>
         </div>
         {% if trajectory.total > 0 %}
            <div><span class="text-secondary small d-block">{{ __('Actions completed', 'grcmanager') }}</span>
               <span class="badge bg-blue-subtle text-blue-emphasis"><i class="ti ti-list-check me-1"></i>{{ __('%1$d of %2$d', 'grcmanager')|format(trajectory.done, trajectory.total) }}</span>
            </div>
         {% endif %}
         {% if planned_end %}
            <div><span class="text-secondary small d-block">{{ __('Last due date of the plan', 'grcmanager') }}</span>
               <span class="badge bg-purple-subtle text-purple-emphasis"><i class="ti ti-calendar-event me-1"></i>{{ planned_end }}</span>
            </div>
         {% endif %}
      </div>
      <p class="text-secondary small">{{ state.help }}</p>

      {% if not plan_relevant %}
         <p class="text-secondary mb-0"><i class="ti ti-info-circle me-1"></i>{{ __('A trajectory is drawn for risks whose treatment is to reduce or to transfer, which have a treatment plan.', 'grcmanager') }}</p>
      {% elseif charted %}
         {% if trajectory.unscheduled > 0 %}
            <div class="alert alert-warning py-2"><i class="ti ti-calendar-off me-1"></i>{{ _n('%d action has no due date: the planned curve does not reach the target level. Give it a due date.', '%d actions have no due date: the planned curve does not reach the target level. Give them a due date.', trajectory.unscheduled, 'grcmanager')|format(trajectory.unscheduled) }}</div>
         {% endif %}
         {% include '@grcmanager/_risk_trajectory_chart.html.twig' with {chart_id: 'grc-risk-trajectory-chart', chart: chart, height: 280} %}

         {% if milestones is not empty %}
            <h4 class="mt-3"><i class="ti ti-flag me-1"></i>{{ __('Milestones of the plan', 'grcmanager') }}</h4>
            <div class="table-responsive">
               <table class="table table-sm table-vcenter card-table" id="grc-risk-trajectory-milestones">
                  <thead>
                     <tr>
                        <th>{{ __('Due date', 'grcmanager') }}</th>
                        <th>{{ __('Actions due', 'grcmanager') }}</th>
                        <th>{{ __('Status') }}</th>
                        <th>{{ __('Expected level afterwards', 'grcmanager') }}</th>
                     </tr>
                  </thead>
                  <tbody>
                     {% for milestone in milestones %}
                        <tr>
                           <td class="text-nowrap">{{ milestone.date_text }}</td>
                           <td>{% for name in milestone.actions %}<div>{{ name }}</div>{% endfor %}</td>
                           <td class="text-nowrap">
                              {% if milestone.done == milestone.count %}
                                 <span class="badge bg-green-subtle text-green-emphasis"><i class="ti ti-check me-1"></i>{{ __('Done', 'grcmanager') }}</span>
                              {% elseif milestone.late > 0 %}
                                 <span class="badge bg-red-subtle text-red-emphasis"><i class="ti ti-clock-exclamation me-1"></i>{{ __('Overdue', 'grcmanager') }}</span>
                              {% else %}
                                 <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-clock me-1"></i>{{ __('To come', 'grcmanager') }}</span>
                              {% endif %}
                           </td>
                           <td class="text-nowrap">{% if milestone.level %}{% include '@grcmanager/_badge.html.twig' with milestone.level only %}{% endif %} <span class="text-secondary small">{{ __('score %s', 'grcmanager')|format(milestone.score) }}</span></td>
                        </tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
            <p class="text-secondary small mt-2 mb-0">{{ __('The expected level between two milestones is an estimate from the score; the level actually reached is the one you reassess on the risk form.', 'grcmanager') }}</p>
         {% endif %}
      {% endif %}
   </div>
</div>
