{# Issue #168 : choix du scénario et historique des exercices de crise #}
<div class="container-fluid">
   <h3 class="mt-2"><i class="ti ti-player-play me-1"></i>{{ __('Start a crisis exercise', 'grcmanager') }}</h3>
   <div class="row g-3 mb-4">
      {% for s in scenarios %}
         <div class="col-lg-4">
            <div class="card h-100">
               <div class="card-header"><h4 class="card-title mb-0"><i class="ti ti-alarm me-1 text-danger"></i>{{ s.label }}</h4></div>
               <div class="card-body">
                  <p>{{ s.description }}</p>
                  <ol class="small mb-0">
                     {% for step in s.steps %}
                        <li>{{ step.label }} <span class="badge bg-secondary-lt">T+{{ step.target }} min</span></li>
                     {% endfor %}
                  </ol>
               </div>
               {% if can_launch %}
                  <div class="card-footer">
                     <form method="post" action="{{ action }}" data-grc-confirm="{{ __('Start the exercise now? A fictitious "EXERCISE" incident will be created and the timer will start.', 'grcmanager') }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <label class="form-label" for="grc-objectives-{{ s.key }}"><i class="ti ti-target-arrow me-1"></i>{{ __('Objectives of the exercise (one per line)', 'grcmanager') }}</label>
                        <textarea id="grc-objectives-{{ s.key }}" name="objectives" class="form-control mb-1" rows="3" placeholder="{{ __('For example: convene the crisis team within 45 minutes', 'grcmanager') }}"></textarea>
                        <div class="form-hint mb-2">{{ __('Evaluated when the exercise is finished; they appear in the report.', 'grcmanager') }}</div>
                        <button type="submit" name="launch" value="{{ s.key }}" class="btn btn-danger"><i class="ti ti-player-play me-1"></i>{{ __('Start the exercise', 'grcmanager') }}</button>
                     </form>
                  </div>
               {% endif %}
            </div>
         </div>
      {% endfor %}
   </div>

   <h3><i class="ti ti-history me-1"></i>{{ __('Exercises carried out', 'grcmanager') }}</h3>
   {% if history is empty %}
      <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>{{ __('No exercise yet. The standard requires testing continuity plans at planned intervals: start a first exercise above.', 'grcmanager') }}</div>
   {% else %}
      <table class="table table-hover card-table">
         <thead><tr><th>{{ __('Scenario', 'grcmanager') }}</th><th>{{ __('Start', 'grcmanager') }}</th><th>{{ __('Duration', 'grcmanager') }}</th><th>{{ __('Steps on time', 'grcmanager') }}</th><th>{{ __('Average reaction time', 'grcmanager') }}</th><th>{{ __('Report', 'grcmanager') }}</th></tr></thead>
         <tbody>
            {% for e in history %}
               <tr>
                  <td><a href="{{ e.url }}">{{ e.scenario }}</a>{% if not e.ended %} <span class="badge bg-orange-lt">{{ __('In progress', 'grcmanager') }}</span>{% endif %}{% if e.validated %} <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-rosette-discount-check me-1"></i>{{ __('Review validated', 'grcmanager') }}</span>{% endif %}</td>
                  <td>{{ e.started_at|formatted_datetime }}</td>
                  <td>{{ e.duration }} min</td>
                  <td><span class="badge {{ e.summary.rate >= 80 ? 'bg-green-lt' : (e.summary.rate >= 50 ? 'bg-orange-lt' : 'bg-red-lt') }}">{{ e.summary.on_time }} / {{ e.summary.total }} ({{ e.summary.rate }} %)</span></td>
                  <td>{{ e.summary.average is null ? '-' : e.summary.average ~ ' min' }}</td>
                  <td>{% if e.document_url %}<a href="{{ e.document_url }}"><i class="ti ti-file-type-pdf me-1"></i>{{ _x('verb', 'Open', 'grcmanager') }}</a>{% else %}-{% endif %}</td>
               </tr>
            {% endfor %}
         </tbody>
      </table>
   {% endif %}
</div>
{% include '@grcmanager/_confirm_forms.html.twig' %}
