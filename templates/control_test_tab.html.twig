{# Issue #380 : onglet « Tests d'efficacité » d'une mesure de l'Annexe A, voir
   GlpiPlugin\\Grcmanager\\ControlTest::displayTabContentForItem(). #}
{% set controls_id = control.getID() %}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  {% if latest %}
    {% set last = results[latest.result]|default(null) %}
    <span class="text-muted">{{ __('Last test', 'grcmanager') }} :</span>
    <span>{{ latest.test_date|formatted_date }}</span>
    {% if last %}<span class="badge {{ last.class }}"><i class="ti {{ last.icon }} me-1"></i>{{ last.label }}</span>{% endif %}
  {% else %}
    <span class="badge bg-secondary-lt"><i class="ti ti-test-pipe me-1"></i>{{ __('Never tested', 'grcmanager') }}</span>
  {% endif %}
  <span class="text-muted ms-md-3">{{ __('Next test', 'grcmanager') }} :</span>
  {% if next_date %}<span>{{ next_date|formatted_date }}</span>{% endif %}
  <span class="badge {{ due_class }}">{{ due_label }}</span>
</div>

<div class="card mb-3">
  <div class="card-header"><h3 class="card-title"><i class="ti ti-calendar-repeat me-1"></i>{{ __('Test plan', 'grcmanager') }}</h3></div>
  <div class="card-body">
    {% if can_edit %}
      <form method="post" action="{{ form_url }}" class="row g-2 align-items-end">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="plugin_grcmanager_controls_id" value="{{ controls_id }}">
        <div class="col-md-3">
          <label class="form-label" for="grc-test-frequency">{{ __('Frequency', 'grcmanager') }}</label>
          <select id="grc-test-frequency" name="test_frequency_months" class="form-select">
            {% for months, label in frequencies %}<option value="{{ months }}" {{ months == frequency ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="grc-test-plan-method">{{ __('Method', 'grcmanager') }}</label>
          <select id="grc-test-plan-method" name="test_method" class="form-select">
            <option value="">-----</option>
            {% for key, label in methods %}<option value="{{ key }}" {{ key == plan_method ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">{{ __('Test owner', 'grcmanager') }}</label>
          {{ tester_dropdown|raw }}
        </div>
        <div class="col-md-2">
          <button type="submit" name="save_plan" value="1" class="btn btn-outline-primary w-100"><i class="ti ti-device-floppy me-1"></i>{{ __('Save the plan', 'grcmanager') }}</button>
        </div>
      </form>
    {% else %}
      <div class="d-flex flex-wrap gap-4">
        <div><span class="text-muted">{{ __('Frequency', 'grcmanager') }} :</span> {{ frequencies[frequency]|default('') }}</div>
        <div><span class="text-muted">{{ __('Method', 'grcmanager') }} :</span> {{ methods[plan_method]|default('-') }}</div>
        <div><span class="text-muted">{{ __('Test owner', 'grcmanager') }} :</span> {{ tester_name ?: '-' }}</div>
      </div>
    {% endif %}
    <small class="form-hint d-block mt-2">{{ __('The next test is due at the date of the last test plus this frequency, unless another date is entered with the test.', 'grcmanager') }}</small>
  </div>
</div>

{% if can_edit and technical_checks is not empty %}
<div class="card mb-3">
  <div class="card-header"><h3 class="card-title"><i class="ti ti-checklist me-1"></i>{{ __('Automated technical checks', 'grcmanager') }}</h3></div>
  <div class="card-body">
    {% for check in technical_checks %}
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <strong>{{ check.label }}</strong>
        {% if check.evaluated and check.result %}
          <span class="text-muted">{{ _n('%1$d gap out of %2$d', '%1$d gaps out of %2$d', check.gaps, 'grcmanager')|format(check.gaps, check.total) }}</span>
          <span class="badge {{ check.result.class }}"><i class="ti {{ check.result.icon }} me-1"></i>{{ check.result.label }}</span>
          {% if all_entities %}
            <form method="post" action="{{ form_url }}" class="ms-auto">
              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
              <input type="hidden" name="plugin_grcmanager_controls_id" value="{{ controls_id }}">
              <button type="submit" name="record_check" value="{{ check.key }}" class="btn btn-sm btn-outline-primary"><i class="ti ti-test-pipe me-1"></i>{{ __('Record as a test', 'grcmanager') }}</button>
            </form>
          {% endif %}
        {% else %}
          <span class="badge bg-secondary-lt">{{ __('Not evaluated', 'grcmanager') }}</span>
        {% endif %}
      </div>
    {% endfor %}
    <small class="form-hint d-block">
      {{ __('The result is computed again when it is recorded, as a technical test dated today: no gap gives an effective test, at least %d%% compliant a partially effective test, below an ineffective test.', 'grcmanager')|format(technical_threshold) }}
      {% if not all_entities %}{{ __('Select all entities to record it: the control covers the whole organisation.', 'grcmanager') }}{% endif %}
    </small>
  </div>
</div>
{% endif %}

{% if can_edit %}
{# Issue #607 : échantillon tiré au hasard dans GLPI (population des entités actives, graine conservée). #}
<div class="card mb-3" id="grc-sample-draw">
  <div class="card-header"><h3 class="card-title"><i class="ti ti-arrows-shuffle me-1"></i>{{ __('Draw a sample in GLPI', 'grcmanager') }}</h3></div>
  <div class="card-body">
    <p class="text-muted">{{ __('The items are drawn at random from what you can see in GLPI (your active entities and rights). The population, the criteria, the size, the seed, the date and the author are kept with the sample: the same draw can be checked again by the auditor.', 'grcmanager') }}</p>
    <form method="post" action="{{ sample_url }}" class="row g-2">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="plugin_grcmanager_controls_id" value="{{ controls_id }}">
      <div class="col-md-12">
        <label class="form-label" for="grc-sample-question">{{ __('Question checked on each item', 'grcmanager') }}</label>
        <input type="text" id="grc-sample-question" name="name" class="form-control" maxlength="255" required
               placeholder="{{ __('Example: does each closed change have an approved validation?', 'grcmanager') }}">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-sample-population">{{ __('Population', 'grcmanager') }}</label>
        <select id="grc-sample-population" name="itemtype" class="form-select" required>
          {% for itemtype, population in sample_form.populations %}
            <option value="{{ itemtype }}" {{ population.allowed ? '' : 'disabled' }}>{{ population.label }}{{ population.allowed ? '' : ' - ' ~ __('not allowed', 'grcmanager') }}</option>
          {% endfor %}
        </select>
        <small class="form-hint">{{ __('Tickets and changes require the right to see all of them.', 'grcmanager') }}</small>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-sample-entity">{{ _n('Entity', 'Entities', 1) }}</label>
        <select id="grc-sample-entity" name="entities_id" class="form-select">
          <option value="0">{{ __('All my active entities', 'grcmanager') }}</option>
          {% for id, name in sample_form.entities %}<option value="{{ id }}">{{ name }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-sample-start">{{ __('Period covered: from', 'grcmanager') }}</label>
        <input type="date" id="grc-sample-start" name="period_start" class="form-control">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-sample-end">{{ __('to', 'grcmanager') }}</label>
        <input type="date" id="grc-sample-end" name="period_end" class="form-control">
        <small class="form-hint">{{ __('Creation date of users and computers; opening date of tickets and changes, or closing date if closed only.', 'grcmanager') }}</small>
      </div>
      <div class="col-md-4">
        <label class="form-label">{{ __('Category (tickets and changes)', 'grcmanager') }}</label>
        {{ sample_form.category_dropdown|raw }}
      </div>
      <div class="col-md-4 d-flex flex-column justify-content-center">
        <label class="form-check mb-1">
          <input class="form-check-input" type="checkbox" name="closed_only" value="1">
          <span class="form-check-label">{{ __('Closed tickets or changes only', 'grcmanager') }}</span>
        </label>
        <label class="form-check mb-0">
          <input class="form-check-input" type="checkbox" name="active_only" value="1">
          <span class="form-check-label">{{ __('Active user accounts only', 'grcmanager') }}</span>
        </label>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="grc-sample-frequency">{{ __('How often the control operates', 'grcmanager') }}</label>
        <select id="grc-sample-frequency" name="operating_frequency" class="form-select">
          {% for key, label in sample_form.frequencies %}<option value="{{ key }}" {{ key == sample_form.default_frequency ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-sample-size">{{ __('Sample size', 'grcmanager') }}</label>
        <input type="number" id="grc-sample-size" name="sample_size" class="form-control" min="1" max="{{ sample_form.max_sample }}">
        <small class="form-hint">{{ __('Empty: the size proposed for this frequency.', 'grcmanager') }}</small>
      </div>
      <div class="col-md-5">
        <label class="form-label" for="grc-sample-seed">{{ __('Seed (optional)', 'grcmanager') }}</label>
        <input type="text" id="grc-sample-seed" name="seed" class="form-control" maxlength="64" pattern="[A-Za-z0-9_\-]{1,64}">
        <small class="form-hint">{{ __('Empty: a random seed is generated. Enter the seed of an earlier draw to reproduce it.', 'grcmanager') }}</small>
      </div>
      <div class="col-md-4 d-flex align-items-end justify-content-end">
        <button type="submit" name="draw" value="1" class="btn btn-primary"><i class="ti ti-arrows-shuffle me-1"></i>{{ __('Draw the sample', 'grcmanager') }}</button>
      </div>
    </form>
  </div>
</div>
{% endif %}

{% if open_samples is not empty %}
<div class="card mb-3" id="grc-open-samples">
  <div class="card-header"><h3 class="card-title"><i class="ti ti-list-check me-1"></i>{{ __('Samples in progress', 'grcmanager') }}</h3></div>
  <div class="list-group list-group-flush">
    {% for sample in open_samples %}
      <a href="{{ sample.url }}" class="list-group-item list-group-item-action d-flex flex-wrap align-items-center gap-2">
        <span class="badge bg-orange-subtle text-orange-emphasis"><i class="ti ti-progress me-1"></i>{{ __('In progress', 'grcmanager') }}</span>
        <strong>{{ sample.name }}</strong>
        <span class="text-muted">{{ populations[sample.itemtype]|default(sample.itemtype) }} - {{ __('%1$d out of %2$d', 'grcmanager')|format(sample.sample_size, sample.population_count) }}</span>
        <span class="text-muted ms-auto">{{ sample.date_draw|formatted_datetime }}</span>
      </a>
    {% endfor %}
  </div>
</div>
{% endif %}

{% if can_edit %}
<form method="post" action="{{ form_url }}" class="card card-body mb-3" enctype="multipart/form-data">
  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
  <input type="hidden" name="plugin_grcmanager_controls_id" value="{{ controls_id }}">
  <h3 class="card-title"><i class="ti ti-plus me-1"></i>{{ __('Record a test', 'grcmanager') }}</h3>
  <div class="row g-2">
    <div class="col-md-3">
      <label class="form-label" for="grc-test-date">{{ __('Test date', 'grcmanager') }}</label>
      <input type="date" id="grc-test-date" name="test_date" class="form-control" value="{{ today }}" max="{{ today }}" required>
    </div>
    <div class="col-md-3">
      <label class="form-label" for="grc-test-method">{{ __('Method', 'grcmanager') }}</label>
      <select id="grc-test-method" name="method" class="form-select">
        {% for key, label in methods %}<option value="{{ key }}" {{ key == plan_method ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label" for="grc-test-result">{{ __('Result', 'grcmanager') }}</label>
      <select id="grc-test-result" name="result" class="form-select" required>
        <option value="">-----</option>
        {% for key, result in results %}<option value="{{ key }}">{{ result.label }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label">{{ __('Tester', 'grcmanager') }}</label>
      {{ user_dropdown|raw }}
    </div>
    <div class="col-md-6">
      <label class="form-label" for="grc-test-comment">{{ __('Finding', 'grcmanager') }}</label>
      <textarea id="grc-test-comment" name="comment" class="form-control" rows="3"
                placeholder="{{ __('Sample checked, observed gaps, people interviewed...', 'grcmanager') }}"></textarea>
      <small class="form-hint">{{ __('Required if the control is not fully effective. An ineffective control opens a non-conformity.', 'grcmanager') }}</small>
    </div>
    <div class="col-md-3">
      <label class="form-label" for="grc-test-document">{{ __('Evidence', 'grcmanager') }}</label>
      <select id="grc-test-document" name="documents_id" class="form-select">
        <option value="0">-----</option>
        {% for doc in documents %}<option value="{{ doc.documents_id }}">{{ doc.name }}</option>{% endfor %}
      </select>
      {% if can_upload %}
        <label class="form-label mt-2" for="grc-test-file">{{ __('Or send a file', 'grcmanager') }}</label>
        <input type="file" id="grc-test-file" name="evidence_file" class="form-control">
        <small class="form-hint">{{ __('It becomes a document of the control, readable only by those who read the control.', 'grcmanager') }} {{ max_upload }}</small>
      {% else %}
        <small class="form-hint">{{ __('A document of the control:', 'grcmanager') }} <a href="{{ documents_url }}">{{ __('add it first in the Documents tab', 'grcmanager') }}</a>.</small>
      {% endif %}
    </div>
    <div class="col-md-3">
      <label class="form-label" for="grc-test-next">{{ __('Next test', 'grcmanager') }}</label>
      <input type="date" id="grc-test-next" name="next_test_date" class="form-control" min="{{ today }}">
      <small class="form-hint">{{ __('Empty: computed from the test plan.', 'grcmanager') }}</small>
    </div>
    <div class="col-12 d-flex flex-wrap align-items-center justify-content-end gap-2">
      {% if review_enabled %}<small class="text-muted me-auto"><i class="ti ti-user-check me-1"></i>{{ __('Another person will have to review this test before it counts for the "Verified" status.', 'grcmanager') }}</small>{% endif %}
      <button type="submit" name="add" value="1" class="btn btn-primary"><i class="ti ti-plus me-1"></i>{{ __('Record the test', 'grcmanager') }}</button>
    </div>
  </div>
</form>
{% endif %}

{% if tests is empty %}
  <div class="empty">
    <div class="empty-icon"><i class="ti ti-test-pipe fs-1"></i></div>
    <p class="empty-title">{{ __('No effectiveness test recorded yet', 'grcmanager') }}</p>
    <p class="empty-subtitle text-muted">{{ __('A control in place is not yet a control that works: test it (inspection, sampling, technical test or interview), keep the evidence and schedule the next test.', 'grcmanager') }}</p>
  </div>
{% else %}
  <table class="table table-sm align-middle">
    <thead><tr>
      <th>{{ __('Test date', 'grcmanager') }}</th><th>{{ __('Method', 'grcmanager') }}</th><th>{{ __('Result', 'grcmanager') }}</th>
      <th>{{ __('Tester', 'grcmanager') }}</th><th>{{ __('Finding', 'grcmanager') }}</th><th>{{ __('Evidence', 'grcmanager') }}</th>
      <th>{{ __('Next test', 'grcmanager') }}</th><th></th>
    </tr></thead>
    <tbody>
      {% for test in tests %}
        {% set result = results[test.result]|default(null) %}
        <tr>
          <td class="text-nowrap">{{ test.test_date|formatted_date }}</td>
          <td>{{ methods[test.method]|default(test.method) }}</td>
          <td>
            {% if result %}<span class="badge {{ result.class }}"><i class="ti {{ result.icon }} me-1"></i>{{ result.label }}</span>{% endif %}
            {% if test.nc_url %}<div class="small"><a href="{{ test.nc_url }}"><i class="ti ti-alert-triangle me-1"></i>{{ __('Non-conformity #%d', 'grcmanager')|format(test.plugin_grcmanager_nonconformities_id) }}</a></div>{% endif %}
            {% if test.review %}
              <div class="mt-1"><span class="badge {{ test.review.class }} grc-review-{{ test.review_status }}"><i class="ti {{ test.review.icon }} me-1"></i>{{ test.review.label }}</span></div>
              {% if test.reviewer_name %}<div class="small text-muted">{{ test.reviewer_name }}{% if test.review_date %}, {{ test.review_date|formatted_datetime }}{% endif %}</div>{% endif %}
              {% if test.review_comment %}<div class="small">{{ test.review_comment|nl2br }}</div>{% endif %}
            {% endif %}
            {% if test.can_review %}
              <form method="post" action="{{ form_url }}" class="mt-2 grc-review-form">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="id" value="{{ test.id }}">
                <textarea name="review_comment" class="form-control form-control-sm mb-1" rows="2" aria-label="{{ __('Review comment', 'grcmanager') }}" placeholder="{{ __('Review comment (required to return the test)', 'grcmanager') }}"></textarea>
                <div class="d-flex gap-1">
                  <button type="submit" name="review" value="approve" class="btn btn-sm btn-outline-success"><i class="ti ti-check me-1"></i>{{ __('Approve', 'grcmanager') }}</button>
                  <button type="submit" name="review" value="return" class="btn btn-sm btn-outline-danger"><i class="ti ti-arrow-back-up me-1"></i>{{ __('Return', 'grcmanager') }}</button>
                </div>
              </form>
            {% endif %}
          </td>
          <td>{{ test.user_name }}</td>
          <td>
            {{ test.comment|nl2br }}
            {% if test.sample %}<div class="small mt-1"><a href="{{ test.sample.url }}"><i class="ti ti-arrows-shuffle me-1"></i>{{ __('Sample: %1$d out of %2$d', 'grcmanager')|format(test.sample.sample_size, test.sample.population_count) }}</a></div>{% endif %}
          </td>
          <td>{% if test.document_url %}<a href="{{ test.document_url }}"><i class="ti ti-file me-1"></i>{{ test.document_name }}</a>{% endif %}</td>
          <td class="text-nowrap">{{ test.next_test_date ? test.next_test_date|formatted_date }}</td>
          <td class="text-end text-nowrap">
            <a href="{{ test.pdf_url }}" class="btn btn-sm btn-ghost-secondary" title="{{ __('Test record for the auditor (PDF)', 'grcmanager') }}" aria-label="{{ __('Test record for the auditor (PDF)', 'grcmanager') }}"><i class="ti ti-file-type-pdf"></i></a>
            {% if test.can_purge %}
              <form method="post" action="{{ form_url }}" onsubmit="return confirm('{{ __('Delete this test?', 'grcmanager')|e('js') }}');">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="id" value="{{ test.id }}">
                <button type="submit" name="purge" value="1" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}" aria-label="{{ __('Remove', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
              </form>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
