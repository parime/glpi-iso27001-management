{# Issue #543 : cadre de preuve des rapports de scanners (mesure A.8.8), dans les entités de la
   personne. Reçoit « evidence » (ScannerImport::evidence()), affiché par control_form.html.twig. #}
<div id="grc-scanner-import-evidence">
   {% for key, info in evidence.levels %}
      {% set n = evidence.counts[key] %}
      <span class="badge bg-{{ n > 0 ? info.color : 'success' }}-subtle text-{{ n > 0 ? info.color : 'success' }}-emphasis me-1"><i class="ti ti-bug me-1"></i>{{ __('Open findings: %s', 'grcmanager')|format(info.label) }} {{ n }}</span>
   {% endfor %}
   {% if evidence.counts.unmatched > 0 %}<span class="badge bg-warning-subtle text-warning-emphasis me-1"><i class="ti ti-link-off me-1"></i>{{ __('Hosts not matched to a computer', 'grcmanager') }} {{ evidence.counts.unmatched }}</span>{% endif %}
   <span class="small text-muted me-2">{{ __('Last scan imported: %s', 'grcmanager')|format(evidence.last_scan) }}</span>
   <a href="{{ evidence.url }}">{{ __('View the details', 'grcmanager') }}</a>
</div>
