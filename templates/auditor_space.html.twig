{# Issue #538 : espace de l'auditeur, en lecture seule. Sans audit choisi : les audits que la personne
   peut consulter. Avec un audit : ses mesures, l'avancement, les demandes soumises et leurs pièces
   soumises (téléchargement historisé), et les constats. Rien d'autre du plugin. #}
<div class="container-fluid my-2">
{% if audit is null %}
   <div class="card">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-eye-check me-2"></i>{{ __('Auditor space', 'grcmanager') }}</h3></div>
      <div class="card-body">
         {% if audits is empty %}
            <div class="alert alert-info mb-0" id="grc-auditor-none"><i class="ti ti-info-circle me-1"></i>{{ __('You have no access to an audit at the moment. Your access is given by the organisation being audited, for a limited time.', 'grcmanager') }}</div>
         {% else %}
            <p class="text-muted">{{ __('Audits you can consult, in read only:', 'grcmanager') }}</p>
            <div class="list-group" id="grc-auditor-audits">
            {% for a in audits %}
               <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="{{ list_url }}?id={{ a.id }}">
                  <i class="ti ti-clipboard-check"></i>
                  <span class="flex-grow-1">{{ a.title }}</span>
                  <span class="badge bg-green-lt"><i class="ti ti-lock-open me-1"></i>{{ __('Access until %s', 'grcmanager')|format(a.end_text) }}</span>
               </a>
            {% endfor %}
            </div>
         {% endif %}
      </div>
   </div>
{% else %}
   <div class="card mb-3">
      <div class="card-header">
         <div>
            <h3 class="card-title mb-1" id="grc-auditor-title"><i class="ti ti-clipboard-check me-2"></i>{{ audit.title }}</h3>
            <div class="text-muted small"><i class="ti ti-lock me-1"></i>{{ __('Read only. Your access ends on %s.', 'grcmanager')|format(access_end) }}</div>
         </div>
         <div class="card-actions d-flex flex-wrap gap-1">
            <span class="badge bg-blue-lt"><i class="ti ti-flag me-1"></i>{{ audit.status }}</span>
            <span class="badge bg-{{ progress.color }}-lt" id="grc-auditor-progress"><i class="ti ti-chart-pie me-1"></i>{{ __('%d %% accepted', 'grcmanager')|format(progress.percent) }}</span>
            {% if audits|length > 1 %}<a class="btn btn-sm btn-ghost-secondary" href="{{ list_url }}"><i class="ti ti-list me-1"></i>{{ __('My audits', 'grcmanager') }}</a>{% endif %}
         </div>
      </div>
      <div class="card-body">
         <div class="row g-2">
            {% if audit.auditor %}<div class="col-md-4"><span class="text-muted">{{ __('Lead auditor', 'grcmanager') }}</span><div>{{ audit.auditor }}</div></div>{% endif %}
            <div class="col-md-4"><span class="text-muted">{{ __('Planned date', 'grcmanager') }}</span><div>{{ audit.planned ?: '-' }}</div></div>
            <div class="col-md-4"><span class="text-muted">{{ __('Actual date', 'grcmanager') }}</span><div>{{ audit.actual ?: '-' }}</div></div>
            {% if audit.scope %}<div class="col-12"><span class="text-muted">{{ __('Scope', 'grcmanager') }}</span><div>{{ audit.scope|nl2br }}</div></div>{% endif %}
         </div>
         {% if progress.total > 0 %}
         <div class="mt-3">
            <div class="progress progress-separated mb-1" style="height: .75rem">
               <div class="progress-bar bg-green" role="progressbar" style="width: {{ (progress.accepted * 100 / progress.total)|round }}%" aria-label="{{ __('Accepted', 'grcmanager') }}"></div>
               <div class="progress-bar bg-blue" role="progressbar" style="width: {{ (progress.submitted * 100 / progress.total)|round }}%" aria-label="{{ __('Submitted', 'grcmanager') }}"></div>
            </div>
            <div class="text-muted small">{{ __('%1$d of %2$d request(s) accepted (%3$d %%).', 'grcmanager')|format(progress.accepted, progress.total, progress.percent) }} {{ __('%d submitted, waiting for review.', 'grcmanager')|format(progress.submitted) }}</div>
         </div>
         {% endif %}
      </div>
   </div>

   <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-file-search me-2"></i>{{ __('Submitted evidence', 'grcmanager') }}</h3></div>
      {% if requests is empty %}
         <div class="card-body"><div class="alert alert-info mb-0" id="grc-auditor-no-evidence"><i class="ti ti-hourglass me-1"></i>{{ __('No evidence has been submitted yet.', 'grcmanager') }}</div></div>
      {% else %}
      <div class="table-responsive">
      <table class="table table-sm table-vcenter card-table" id="grc-auditor-requests">
         <thead>
            <tr>
               <th>{{ __('Request', 'grcmanager') }}</th>
               <th>{{ __('Status', 'grcmanager') }}</th>
               <th>{{ __('Documents', 'grcmanager') }}</th>
            </tr>
         </thead>
         <tbody>
         {% for row in requests %}
            <tr class="grc-evreq-status-{{ row.status }}">
               <td>
                  <div class="fw-bold">{{ row.label }}</div>
                  {% if row.control %}<span class="badge bg-azure-lt"><i class="ti ti-shield-check me-1"></i>{{ row.control }}</span>{% endif %}
                  {% if row.description and row.description != row.label %}<div class="text-muted small mt-1">{{ row.description|nl2br }}</div>{% endif %}
               </td>
               <td>
                  <span class="badge {{ row.status_class }}"><i class="ti {{ row.status_icon }} me-1"></i>{{ row.status_label }}</span>
                  {% if row.submitted_text %}<div class="text-muted small">{{ __('Submitted on %s', 'grcmanager')|format(row.submitted_text) }}</div>{% endif %}
                  {% if row.review_comment %}<div class="text-muted small"><i class="ti ti-message-circle me-1"></i>{{ row.review_comment }}</div>{% endif %}
               </td>
               <td>
                  {% for piece in row.pieces %}
                     <div class="text-nowrap"><i class="ti ti-file-download me-1"></i>{% if piece.url %}<a href="{{ piece.url }}" class="grc-auditor-piece">{{ piece.name }}</a>{% else %}{{ piece.name }}{% endif %}</div>
                  {% endfor %}
                  {% if row.submission_comment %}<div class="text-muted small mt-1"><i class="ti ti-message me-1"></i>{{ row.submission_comment }}</div>{% endif %}
               </td>
            </tr>
         {% endfor %}
         </tbody>
      </table>
      </div>
      {% endif %}
   </div>

   <div class="row g-3">
      <div class="col-12 col-xl-5">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-shield-check me-2"></i>{{ __('Audited controls', 'grcmanager') }}</h3></div>
            {% if controls is empty %}
               <div class="card-body text-muted">{{ __('No control is linked to this audit.', 'grcmanager') }}</div>
            {% else %}
            <ul class="list-group list-group-flush" id="grc-auditor-controls">
               {% for c in controls %}
                  <li class="list-group-item d-flex align-items-center gap-2">
                     <span class="badge bg-azure-lt">{{ c.code }}</span>
                     <span class="flex-grow-1">{{ c.title }}</span>
                     <span class="badge {{ c.status == 'verified' ? 'bg-green-lt' : (c.status == 'implemented' ? 'bg-teal-lt' : (c.status == 'in_progress' ? 'bg-blue-lt' : 'bg-secondary-lt')) }}">{{ c.implementation }}</span>
                  </li>
               {% endfor %}
            </ul>
            {% endif %}
         </div>
      </div>
      <div class="col-12 col-xl-7">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-alert-octagon me-2"></i>{{ __('Findings', 'grcmanager') }}</h3></div>
            {% if findings is empty %}
               <div class="card-body text-muted">{{ __('No finding for this audit.', 'grcmanager') }}</div>
            {% else %}
            <div class="table-responsive">
            <table class="table table-sm card-table" id="grc-auditor-findings">
               <thead><tr><th>{{ __('Title', 'grcmanager') }}</th><th>{{ __('Finding type', 'grcmanager') }}</th><th>{{ __('Severity', 'grcmanager') }}</th><th>{{ __('Status', 'grcmanager') }}</th><th>{{ __('Due date', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for f in findings %}
                  <tr><td>{{ f.title }}</td><td>{{ f.type }}</td><td>{{ f.severity }}</td><td>{{ f.status }}</td><td>{{ f.due_date }}</td></tr>
               {% endfor %}
               </tbody>
            </table>
            </div>
            {% endif %}
         </div>
      </div>
   </div>
{% endif %}
</div>
