{# Issue #372 : échéances NIS2 / RGPD non encore notifiées, en tête du panneau de l'incident
   (elles étaient seulement dans la section « Notifications réglementaires », plus bas). #}
{# Issue #372 : en-tête de pastilles (référence, gravité, catégorie, source), puis compteurs vers
   leurs onglets (journal des actions, IOC, éléments et tickets liés). #}
<div class="d-flex flex-wrap align-items-center gap-1 mb-2">
  {% if reference %}<span class="badge bg-dark-lt fs-5"><i class="ti ti-hash me-1"></i>{{ reference }}</span>{% endif %}
  {% if is_exercise %}<span class="badge bg-purple-lt"><i class="ti ti-school me-1"></i>{{ __('Crisis exercise', 'grcmanager') }}</span>{% endif %}
  {% if severity %}
    <span class="badge {{ severity == 'critical' ? 'bg-red-lt' : (severity == 'major' ? 'bg-orange-lt' : 'bg-yellow-lt') }}">
      <i class="ti ti-alert-triangle me-1"></i>{{ __('Severity', 'grcmanager') }} : {{ severities[severity]|default(severity) }}
    </span>
  {% endif %}
  {% if category %}<span class="badge bg-blue-lt"><i class="ti ti-category me-1"></i>{{ category }}</span>{% endif %}
  {% if source and source != constant('Dropdown::EMPTY_VALUE') %}<span class="badge bg-secondary-lt"><i class="ti ti-radar me-1"></i>{{ source }}</span>{% endif %}
  {% for c in counters|default([]) %}
    <a href="{{ c.url }}" class="badge {{ c.count > 0 ? 'bg-azure-lt' : 'bg-secondary-lt text-muted' }} text-decoration-none grcmanager-counter">
      <i class="{{ c.icon }} me-1"></i>{{ c.label }}<span class="ms-1 fw-bold">{{ c.count }}</span>
    </a>
  {% endfor %}
</div>
{# Issue #370 : frise des phases de réponse NIST. #}
{% if phases is defined %}
<ol class="grc-phases d-flex flex-wrap gap-1 list-unstyled mb-2" aria-label="{{ __('Response phases', 'grcmanager') }}">
  {% for p in phases %}
    <li class="badge {{ p.current ? 'bg-green text-white' : (p.done ? 'bg-green-lt' : 'bg-secondary-lt text-muted') }}"
        title="{{ p.at ? p.at|formatted_datetime : __('Not reached', 'grcmanager') }}">
      <i class="ti {{ p.done ? 'ti-circle-check' : 'ti-circle-dashed' }} me-1"></i>{{ phase_labels[p.key] }}
      {% if p.done and p.key != 'detection' and p.hours is not null %}<span class="ms-1 opacity-75">+{{ p.hours }} h</span>{% endif %}
      {% if p.out_of_order %}<i class="ti ti-alert-triangle text-orange ms-1" title="{{ __('Dated before the previous phase', 'grcmanager') }}"></i>{% endif %}
    </li>
  {% endfor %}
</ol>
{% endif %}
{# Bandeaux : bleu, puis orange quand moins d'un quart du délai reste, puis rouge une fois
   dépassée ; lien vers la section « Notifications réglementaires » où se saisit la date. #}
{% for d in banners %}
  <div class="alert {{ d.status == 'overdue' ? 'alert-danger' : (d.status == 'due_soon' ? 'alert-warning' : 'alert-info') }} d-flex align-items-start gap-2 py-2 px-3 mb-2" role="status">
    <i class="ti {{ d.status == 'overdue' ? 'ti-alarm-off' : 'ti-alarm' }} fs-3"></i>
    <div class="flex-grow-1">
      <div class="fw-bold">{{ d.label }}</div>
      <div class="small">
        {% if d.status == 'overdue' %}
          {{ __('Overdue since %s', 'grcmanager')|format(d.due|formatted_datetime) }}
        {% else %}
          {{ __('Due no later than %1$s (%2$d h left)', 'grcmanager')|format(d.due|formatted_datetime, d.hours_left) }}
        {% endif %}
      </div>
    </div>
    <a href="#grcmanager-regulatory-heading" class="alert-link small text-nowrap grcmanager-banner-link">
      <i class="ti ti-arrow-down me-1"></i>{{ __('Regulatory notifications', 'grcmanager') }}
    </a>
  </div>
{% endfor %}
