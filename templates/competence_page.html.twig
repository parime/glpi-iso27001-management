{# Issue #774 : compétences (article 7.2) : fonctions du SMSI, matrice personnes x compétences,
   écarts et action proposée, dossier PDF archivé comme preuve. #}
{% set summary = data.summary %}
<div class="card mb-3">
   <div class="card-body d-flex flex-wrap align-items-center gap-2">
      <div class="me-auto">
         <span class="badge bg-primary-subtle text-primary-emphasis me-1"><i class="ti ti-id-badge-2 me-1"></i>{{ _n('%d function', '%d functions', data.functions|length, 'grcmanager')|format(data.functions|length) }}</span>
         {% if can_people %}
            <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-users me-1"></i>{{ _n('%d person', '%d people', summary.people, 'grcmanager')|format(summary.people) }}</span>
            {% if summary.gaps > 0 %}
               <span class="badge bg-danger-subtle text-danger-emphasis me-1"><i class="ti ti-alert-octagon me-1"></i>{{ _n('%d gap', '%d gaps', summary.gaps, 'grcmanager')|format(summary.gaps) }}</span>
            {% elseif summary.required > 0 %}
               <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-circle-check me-1"></i>{{ __('No gap', 'grcmanager') }}</span>
            {% endif %}
            {% if summary.rate is not null %}
               <span class="badge bg-info-subtle text-info-emphasis">{{ __('Coverage: %d %%', 'grcmanager')|format(summary.rate) }}</span>
            {% endif %}
         {% endif %}
      </div>
      {% if can_create %}
         <a href="{{ function_form }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-plus me-1"></i>{{ __('Add a function', 'grcmanager') }}</a>
         <form method="post" action="{{ page_url }}" class="d-inline">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <button type="submit" name="add_defaults" value="1" class="btn btn-sm btn-outline-secondary" title="{{ __('Adds the proposed functions and competences that are missing, without changing the existing ones.', 'grcmanager') }}">
               <i class="ti ti-list-details me-1"></i>{{ __('Add the missing default functions', 'grcmanager') }}
            </button>
         </form>
      {% endif %}
      <a href="{{ competence_list }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-certificate me-1"></i>{{ __('Competence catalogue', 'grcmanager') }}</a>
      {% if declaration_list %}
         <a href="{{ declaration_list }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-file-certificate me-1"></i>{{ __('Declared competences', 'grcmanager') }}</a>
      {% endif %}
      {% if can_people %}
         <a href="{{ dossier_url }}" class="btn btn-sm btn-outline-primary"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Download as PDF', 'grcmanager') }}</a>
         {% if can_update %}
            <form method="post" action="{{ page_url }}" class="d-inline">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <button type="submit" name="archive" value="1" class="btn btn-sm btn-primary" title="{{ __('Attaches a dated PDF of the job descriptions and gaps to requirement 7.2 of the ISMS.', 'grcmanager') }}">
                  <i class="ti ti-archive me-1"></i>{{ __('Archive as evidence', 'grcmanager') }}
               </button>
            </form>
         {% endif %}
      {% endif %}
   </div>
</div>

<div class="card mb-3">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-id-badge-2 me-1"></i>{{ __('ISMS functions', 'grcmanager') }}</h3></div>
   {% if data.functions is empty %}
      <div class="card-body text-secondary">
         <i class="ti ti-info-circle me-1"></i>{{ __('No function yet. Add the default functions (CISO, DPO, administrator...), then say who holds each one.', 'grcmanager') }}
      </div>
   {% else %}
      <div class="table-responsive">
         <table class="table table-sm table-hover align-middle mb-0">
            <thead>
               <tr>
                  <th>{{ __('Function', 'grcmanager') }}</th>
                  <th class="text-center">{{ __('Required competences', 'grcmanager') }}</th>
                  {% if can_people %}
                     <th class="text-center">{{ __('Holders', 'grcmanager') }}</th>
                     <th class="text-center">{{ __('Holders with a gap', 'grcmanager') }}</th>
                  {% endif %}
                  <th class="text-end">{{ __('Job description', 'grcmanager') }}</th>
               </tr>
            </thead>
            <tbody>
               {% for function in data.functions %}
                  <tr>
                     <td><a href="{{ function.url }}" class="fw-bold">{{ function.label }}</a></td>
                     <td class="text-center">
                        {% if function.requirements == 0 %}
                           <span class="badge bg-warning-subtle text-warning-emphasis">{{ __('None', 'grcmanager') }}</span>
                        {% else %}
                           {{ function.requirements }}
                        {% endif %}
                     </td>
                     {% if can_people %}
                        <td class="text-center">
                           {% if function.people == 0 %}
                              <span class="badge bg-warning-subtle text-warning-emphasis">{{ __('Nobody', 'grcmanager') }}</span>
                           {% else %}
                              {{ function.people }}
                           {% endif %}
                        </td>
                        <td class="text-center">
                           {% if function.with_gaps > 0 %}
                              <span class="badge bg-danger-subtle text-danger-emphasis">{{ function.with_gaps }}</span>
                           {% elseif function.people > 0 %}
                              <i class="ti ti-circle-check text-success" title="{{ __('No gap', 'grcmanager') }}"></i>
                           {% endif %}
                        </td>
                     {% endif %}
                     <td class="text-end"><a href="{{ function.pdf_url }}" class="btn btn-sm btn-ghost-secondary"><i class="ti ti-file-type-pdf me-1"></i>PDF</a></td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}
</div>

{% if not can_people %}
   <div class="alert alert-info"><i class="ti ti-lock me-1"></i>{{ __('Reading the users of GLPI is needed to see the competences of the people.', 'grcmanager') }}</div>
{% else %}
   <div class="card mb-3">
      <div class="card-header d-flex flex-wrap gap-2 align-items-center">
         <h3 class="card-title me-auto"><i class="ti ti-table me-1"></i>{{ __('People and competences', 'grcmanager') }}</h3>
         {% for key, style in statuses %}
            <span class="badge {{ style.class }}"><i class="ti {{ style.icon }} me-1"></i>{{ style.label }}</span>
         {% endfor %}
      </div>
      {% if data.rows is empty %}
         <div class="card-body text-secondary"><i class="ti ti-info-circle me-1"></i>{{ __('Nobody holds a function yet: add users, groups or job titles to the functions.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover align-middle mb-0">
               <thead>
                  <tr>
                     <th>{{ __('Person', 'grcmanager') }}</th>
                     {% for label in data.columns %}
                        <th class="text-center small">{{ label }}</th>
                     {% endfor %}
                  </tr>
               </thead>
               <tbody>
                  {% for row in data.rows %}
                     <tr>
                        <td>
                           <a href="{{ row.url }}" class="fw-bold">{{ row.name }}</a>
                           <div class="small text-secondary">{{ row.functions|join(', ') }}</div>
                        </td>
                        {% for id, label in data.columns %}
                           {% set cell = row.cells[id] ?? null %}
                           <td class="text-center">
                              {% if cell %}
                                 {% set style = statuses[cell.status] %}
                                 <span class="badge {{ style.class }}" title="{{ style.label }} - {{ __('Expected level', 'grcmanager') }} : {{ cell.required_label }}{{ cell.acquired_label ? ' - ' ~ __('Level acquired', 'grcmanager') ~ ' : ' ~ cell.acquired_label : '' }}">
                                    <i class="ti {{ style.icon }} me-1"></i>{{ cell.acquired_label ?: '-' }} / {{ cell.required_label }}
                                 </span>
                              {% endif %}
                           </td>
                        {% endfor %}
                     </tr>
                  {% endfor %}
               </tbody>
            </table>
         </div>
         <div class="card-footer small text-secondary">{{ __('Each cell shows the level acquired / the level expected. Nothing is changed automatically.', 'grcmanager') }}</div>
      {% endif %}
   </div>

   <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-alert-triangle me-1"></i>{{ __('Gaps and proposed actions', 'grcmanager') }}</h3></div>
      {% if data.gaps is empty %}
         <div class="card-body text-secondary"><i class="ti ti-circle-check me-1 text-success"></i>{{ __('No gap: every holder has the competences expected by their functions.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
               <thead>
                  <tr>
                     <th>{{ __('Person', 'grcmanager') }}</th>
                     <th>{{ __('Competence', 'grcmanager') }}</th>
                     <th>{{ __('Gap', 'grcmanager') }}</th>
                     <th>{{ __('Proposed action', 'grcmanager') }}</th>
                  </tr>
               </thead>
               <tbody>
                  {% for gap in data.gaps %}
                     {% set style = statuses[gap.status] %}
                     <tr>
                        <td>{{ gap.name }}</td>
                        <td><a href="{{ gap.competence_url }}">{{ gap.competence }}</a></td>
                        <td>
                           <span class="badge {{ style.class }}"><i class="ti {{ style.icon }} me-1"></i>{{ style.label }}</span>
                           <span class="small text-secondary">{{ __('Expected level', 'grcmanager') }} : {{ gap.required }}</span>
                        </td>
                        <td>
                           {% for training in gap.trainings %}
                              <div><i class="ti ti-school me-1"></i>{{ __('Plan the training', 'grcmanager') }} <a href="{{ training.url }}">{{ training.title }}</a></div>
                           {% endfor %}
                           {% if gap.action %}<div class="small">{{ gap.action }}</div>{% endif %}
                           {% if gap.declare_url %}
                              <a href="{{ gap.declare_url }}" class="small"><i class="ti ti-file-plus me-1"></i>{{ __('Declare a competence with its evidence', 'grcmanager') }}</a>
                           {% endif %}
                        </td>
                     </tr>
                  {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-file-certificate me-1"></i>{{ __('Archived competence files', 'grcmanager') }}</h3></div>
      {% if exports is empty %}
         <div class="card-body text-secondary">{{ __('No archived file yet. Archive it before the audit: the dated PDF is attached to requirement 7.2.', 'grcmanager') }}</div>
      {% else %}
         <div class="list-group list-group-flush">
            {% for export in exports %}
               <a href="{{ export.url }}" class="list-group-item list-group-item-action">
                  <i class="ti ti-file-type-pdf me-1 text-danger"></i>{{ export.date }} <span class="text-secondary">- {{ export.user }}</span>
               </a>
            {% endfor %}
         </div>
      {% endif %}
   </div>
{% endif %}
