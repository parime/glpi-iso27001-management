{# Issue #142 : calendrier de conformité, échéances groupées par mois (issue #199 : passé de PHP à Twig) #}
<div class="card"><div class="card-body">
   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <div class="btn-group">
         <a class="btn btn-sm {{ mine ? 'btn-outline-secondary' : 'btn-secondary' }}" href="{{ url }}">{{ __('All deadlines', 'grcmanager') }}</a>
         <a class="btn btn-sm {{ mine ? 'btn-secondary' : 'btn-outline-secondary' }}" href="{{ url }}?mine=1">{{ __('My deadlines', 'grcmanager') }}</a>
      </div>
      {% if can_create %}
         <a class="btn btn-sm btn-primary" href="{{ form_url }}"><i class="ti ti-plus me-1"></i>{{ __('Add an event', 'grcmanager') }}</a>
      {% endif %}
      <a class="btn btn-sm btn-outline-primary ms-auto" href="{{ ics_url }}"><i class="ti ti-calendar-down me-1"></i>{{ __('Export (iCal)', 'grcmanager') }}</a>
      {% if subscription_url %}
         <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#grcmanager-ical-subscription"><i class="ti ti-calendar-share me-1"></i>{{ __('Subscribe', 'grcmanager') }}</button>
      {% endif %}
   </div>
   {% if subscription_url %}
      <div class="collapse mb-3" id="grcmanager-ical-subscription">
         <label class="form-label" for="grcmanager-ical-url">{{ __('Subscription link for your calendar (Outlook, Thunderbird, Google Calendar…)', 'grcmanager') }}</label>
         <input type="text" class="form-control" id="grcmanager-ical-url" readonly value="{{ subscription_url }}" onfocus="this.select()">
         <div class="form-hint">{{ __('Personal link: it gives access to your deadlines with your rights, without a password. Do not share it. To revoke it, regenerate your personal token in your preferences.', 'grcmanager') }}</div>
      </div>
   {% endif %}
   <p class="text-muted small"><i class="ti ti-info-circle me-1"></i>{{ __('Events entered here and deadlines from the other registers (audits, management reviews, access reviews, periodic reviews, policies, obligations, evidence). Each deadline also appears in the GLPI planning of its owner.', 'grcmanager') }}</p>

   {% for month in months %}
      <h3 class="mt-3">{{ month.label }}</h3>
      <div class="table-responsive">
         <table class="table table-sm table-hover align-middle"><tbody>
            {% for e in month.events %}
               <tr>
                  <td class="text-nowrap" style="width: 9rem;">{{ e.date|formatted_date }}</td>
                  <td style="width: 16rem;"><span class="badge bg-blue-lt"><i class="ti {{ e.icon }} me-1"></i>{{ e.label }}</span></td>
                  <td>
                     <a href="{{ e.url }}">{{ e.name }}</a>
                     {% if e.done %} <span class="badge bg-green-lt">{{ _x('masculine', 'Done', 'grcmanager') }}</span>{% endif %}
                     {% if e.late %} <span class="badge bg-red-lt">{{ __('Deadline passed', 'grcmanager') }}</span>{% endif %}
                  </td>
                  <td class="text-muted">{{ e.owner }}</td>
               </tr>
            {% endfor %}
         </tbody></table>
      </div>
   {% else %}
      <div class="alert alert-info mb-0">{{ __('No deadline in this period.', 'grcmanager') }}</div>
   {% endfor %}
</div></div>
