{# Issue #732 : bilan après exercice (objectifs, constats, plan d'amélioration, validation) #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set outcome_badges = {
   'met': ['bg-success-subtle text-success-emphasis', 'ti-circle-check'],
   'partial': ['bg-warning-subtle text-warning-emphasis', 'ti-circle-half-2'],
   'not_met': ['bg-danger-subtle text-danger-emphasis', 'ti-circle-x'],
   '': ['bg-secondary-subtle text-secondary-emphasis', 'ti-hourglass']
} %}
{% set severity_badges = {
   'minor': ['bg-info-subtle text-info-emphasis', 'ti-info-circle'],
   'major': ['bg-warning-subtle text-warning-emphasis', 'ti-alert-triangle'],
   'critical': ['bg-danger-subtle text-danger-emphasis', 'ti-alert-octagon']
} %}
{% set action_badges = {
   'done': ['bg-success-subtle text-success-emphasis', 'ti-circle-check', __('Done', 'grcmanager')],
   'overdue': ['bg-danger-subtle text-danger-emphasis', 'ti-clock-exclamation', __('Overdue', 'grcmanager')],
   'open': ['bg-primary-subtle text-primary-emphasis', 'ti-progress', __('In progress', 'grcmanager')],
   'hidden': ['bg-secondary-subtle text-secondary-emphasis', 'ti-lock', __('Not visible to you', 'grcmanager')],
   'missing': ['bg-secondary-subtle text-secondary-emphasis', 'ti-trash', __('Deleted', 'grcmanager')]
} %}
{% set editable = can_act and not review.validated %}
{% set v = {'full_width': true, 'is_horizontal': false} %}

<h3 class="mt-4" id="grc-crisis-review"><i class="ti ti-clipboard-check me-1"></i>{{ __('Exercise review', 'grcmanager') }}
   {% if review.validated %}
      <span class="badge bg-success-subtle text-success-emphasis ms-2"><i class="ti ti-rosette-discount-check me-1"></i>{{ __('Validated', 'grcmanager') }}</span>
   {% else %}
      <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2"><i class="ti ti-pencil me-1"></i>{{ __('Draft', 'grcmanager') }}</span>
   {% endif %}
</h3>
{% if review.validated %}
   <div class="alert alert-success"><i class="ti ti-lock me-1"></i>{{ __('Review validated on %1$s by %2$s: it can no longer be changed unless it is returned to draft.', 'grcmanager')|format(review.validated_at|formatted_datetime, review.validator) }}</div>
{% endif %}

<h4 class="mt-3" id="grc-crisis-objectives"><i class="ti ti-target-arrow me-1"></i>{{ __('Objectives of the exercise', 'grcmanager') }}
   <span class="small text-muted ms-1">{{ __('%1$d achieved, %2$d partially, %3$d not achieved, %4$d to evaluate', 'grcmanager')|format(review.objectives_summary.met, review.objectives_summary.partial, review.objectives_summary.not_met, review.objectives_summary.pending) }}</span>
</h4>
{% if review.objectives is empty %}
   <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>{{ __('No objective defined. Objectives say what the exercise must demonstrate (for example: "the crisis team is convened within 45 minutes"); they are evaluated when the exercise is finished.', 'grcmanager') }}</div>
{% else %}
   <table class="table table-vcenter card-table">
      <thead><tr><th>#</th><th>{{ __('Objective', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th><th>{{ __('Comment', 'grcmanager') }}</th><th></th></tr></thead>
      <tbody>
         {% for o in review.objectives %}
            <tr>
               <td>{{ loop.index }}</td>
               <td>{{ o.name }}</td>
               {% if editable and exercise.ended %}
                  <td colspan="3">
                     <form method="post" action="{{ action }}" class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="id" value="{{ exercise.id }}">
                        <select name="outcome" class="form-select form-select-sm w-auto" required aria-label="{{ __('Outcome', 'grcmanager') }}">
                           <option value="">{{ __('To evaluate', 'grcmanager') }}</option>
                           {% for key, label in outcomes %}<option value="{{ key }}" {{ o.outcome == key ? 'selected' }}>{{ label }}</option>{% endfor %}
                        </select>
                        <input type="text" name="comment" class="form-control form-control-sm flex-grow-1" style="min-width: 14rem" maxlength="2000" value="{{ o.comment }}" placeholder="{{ __('What was observed', 'grcmanager') }}" aria-label="{{ __('Comment', 'grcmanager') }}">
                        <button type="submit" name="evaluate_objective" value="{{ o.id }}" class="btn btn-sm btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
                     </form>
                  </td>
               {% else %}
                  <td><span class="badge {{ outcome_badges[o.outcome][0] }}"><i class="ti {{ outcome_badges[o.outcome][1] }} me-1"></i>{{ o.outcome ? outcomes[o.outcome] : __('To evaluate', 'grcmanager') }}</span></td>
                  <td>{{ o.comment ?: '-' }}</td>
                  <td class="text-end">
                     {% if editable and not exercise.ended %}
                        <form method="post" action="{{ action }}" class="d-inline">
                           <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                           <input type="hidden" name="id" value="{{ exercise.id }}">
                           <button type="submit" name="delete_objective" value="{{ o.id }}" class="btn btn-sm btn-ghost-danger" title="{{ __('Delete', 'grcmanager') }}" aria-label="{{ __('Delete', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
                        </form>
                     {% endif %}
                  </td>
               {% endif %}
            </tr>
         {% endfor %}
      </tbody>
   </table>
{% endif %}
{% if editable and not exercise.ended %}
   <form method="post" action="{{ action }}" class="d-flex gap-2 mb-2">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="id" value="{{ exercise.id }}">
      <input type="text" class="form-control" name="objective" required maxlength="255" placeholder="{{ __('New objective, for example: restore the file server within 4 hours', 'grcmanager') }}" aria-label="{{ __('New objective', 'grcmanager') }}">
      <button type="submit" name="add_objective" value="1" class="btn btn-primary text-nowrap"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
   </form>
{% elseif editable and review.objectives is not empty and review.objectives_summary.pending > 0 %}
   <div class="form-hint">{{ __('Evaluate each objective: the review can be validated once they are all evaluated.', 'grcmanager') }}</div>
{% endif %}

<h4 class="mt-4" id="grc-crisis-findings"><i class="ti ti-zoom-exclamation me-1"></i>{{ __('Findings and improvement plan', 'grcmanager') }}
   <span class="small text-muted ms-1">{{ __('%1$d finding(s), %2$d action(s) decided, %3$d done', 'grcmanager')|format(review.plan_summary.findings, review.plan_summary.actions, review.plan_summary.done) }}</span>
   {% if review.plan_summary.overdue > 0 %}
      <span class="badge bg-danger-subtle text-danger-emphasis ms-1"><i class="ti ti-clock-exclamation me-1"></i>{{ _n('%d action overdue', '%d actions overdue', review.plan_summary.overdue, 'grcmanager')|format(review.plan_summary.overdue) }}</span>
   {% endif %}
</h4>
{% if review.findings is empty %}
   <p class="text-muted">{{ __('No finding yet. Record each gap observed during or after the exercise (delay, missing contact, unusable procedure…).', 'grcmanager') }}</p>
{% else %}
   <table class="table table-vcenter card-table">
      <thead><tr><th>{{ __('Finding', 'grcmanager') }}</th><th>{{ __('Severity', 'grcmanager') }}</th><th>{{ __('Improvement action', 'grcmanager') }}</th><th></th></tr></thead>
      <tbody>
         {% for f in review.findings %}
            <tr>
               <td>
                  <strong>{{ f.name }}</strong>
                  {% if f.description %}<div class="small text-muted">{{ f.description|nl2br }}</div>{% endif %}
               </td>
               <td><span class="badge {{ severity_badges[f.severity][0] }}"><i class="ti {{ severity_badges[f.severity][1] }} me-1"></i>{{ severities[f.severity] }}</span></td>
               <td>
                  {% if f.action is not null %}
                     <div class="small text-muted">{{ f.action.label }}</div>
                     {% if f.action.url is defined %}
                        <a href="{{ f.action.url }}">{{ f.action.title }}</a>
                        <div class="small">{{ f.action.responsible ?: __('No owner', 'grcmanager') }} - {{ f.action.due_date ? f.action.due_date|formatted_date : __('No due date', 'grcmanager') }} - {{ f.action.status }}</div>
                     {% endif %}
                     <span class="badge {{ action_badges[f.action.state][0] }}"><i class="ti {{ action_badges[f.action.state][1] }} me-1"></i>{{ action_badges[f.action.state][2] }}</span>
                  {% elseif editable and action_types is not empty %}
                     <details>
                        <summary class="btn btn-sm btn-outline-primary"><i class="ti ti-list-check me-1"></i>{{ __('Create an improvement action', 'grcmanager') }}</summary>
                        <form method="post" action="{{ action }}" class="row g-2 mt-1 grc-crisis-action">
                           <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                           <input type="hidden" name="id" value="{{ exercise.id }}">
                           {{ fields.dropdownArrayField('action_type', action_types|keys|first, action_types, __('Type', 'grcmanager'), v|merge({'field_class': 'col-12'})) }}
                           {% if action_types.treatment is defined %}
                              {{ fields.dropdownArrayField('plugin_grcmanager_risks_id', 0, risk_choices, __('Risk (treatment action only)', 'grcmanager'), v|merge({'field_class': 'col-12', 'display_emptychoice': true})) }}
                           {% endif %}
                           {{ fields.dropdownField('User', 'users_id', 0, __('Owner', 'grcmanager'), v|merge({'field_class': 'col-md-7', 'right': 'all', 'entity': user_entity})) }}
                           {{ fields.dateField('due_date', '', __('Due date', 'grcmanager'), v|merge({'field_class': 'col-md-5'})) }}
                           <div class="col-12">
                              <button type="submit" name="create_action" value="{{ f.id }}" class="btn btn-sm btn-primary"><i class="ti ti-plus me-1"></i>{{ __('Create the action', 'grcmanager') }}</button>
                           </div>
                        </form>
                     </details>
                  {% else %}
                     <span class="text-muted">-</span>
                  {% endif %}
               </td>
               <td class="text-end">
                  {% if editable and f.action is null %}
                     <form method="post" action="{{ action }}" class="d-inline">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="id" value="{{ exercise.id }}">
                        <button type="submit" name="delete_finding" value="{{ f.id }}" class="btn btn-sm btn-ghost-danger" title="{{ __('Delete', 'grcmanager') }}" aria-label="{{ __('Delete', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
                     </form>
                  {% endif %}
               </td>
            </tr>
         {% endfor %}
      </tbody>
   </table>
   {% if editable %}
      <div class="form-hint">{{ __('An improvement action is only created when you click it: a non-conformity linked to the exercise incident, or a treatment action of an existing risk. Its progress is shown here.', 'grcmanager') }}</div>
   {% endif %}
{% endif %}
{% if editable %}
   <form method="post" action="{{ action }}" class="row g-2 align-items-end mt-1 mb-2">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="id" value="{{ exercise.id }}">
      <div class="col-md-4">
         <label class="form-label" for="grc-finding-name">{{ __('New finding', 'grcmanager') }}</label>
         <input type="text" id="grc-finding-name" name="name" class="form-control" required maxlength="255">
      </div>
      <div class="col-md-4">
         <label class="form-label" for="grc-finding-description">{{ __('Description', 'grcmanager') }}</label>
         <input type="text" id="grc-finding-description" name="description" class="form-control" maxlength="2000">
      </div>
      <div class="col-md-2">
         <label class="form-label" for="grc-finding-severity">{{ __('Severity', 'grcmanager') }}</label>
         <select id="grc-finding-severity" name="severity" class="form-select">
            {% for key, label in severities %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
         </select>
      </div>
      <div class="col-md-2">
         <button type="submit" name="add_finding" value="1" class="btn btn-primary w-100"><i class="ti ti-plus me-1"></i>{{ __('Record', 'grcmanager') }}</button>
      </div>
   </form>
{% endif %}

<h4 class="mt-4" id="grc-crisis-validation"><i class="ti ti-rosette-discount-check me-1"></i>{{ __('Review validation', 'grcmanager') }}</h4>
{% if not review.validated %}
   {% if can_validate %}
      {% if review.refusal %}
         <div class="alert alert-warning"><i class="ti ti-alert-triangle me-1"></i>{{ review.refusal_message }}</div>
      {% else %}
         <form method="post" action="{{ action }}" class="d-flex flex-wrap gap-2 mb-2" data-grc-confirm="{{ __('Validate the review? It will no longer be editable and the validated report will be archived.', 'grcmanager') }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ exercise.id }}">
            <input type="text" class="form-control flex-grow-1" style="min-width: 16rem" name="comment" maxlength="2000" placeholder="{{ __('Comment (optional)', 'grcmanager') }}" aria-label="{{ __('Comment', 'grcmanager') }}">
            <button type="submit" name="validate_review" value="1" class="btn btn-success"><i class="ti ti-rosette-discount-check me-1"></i>{{ __('Validate the review', 'grcmanager') }}</button>
         </form>
      {% endif %}
   {% else %}
      <p class="text-muted"><i class="ti ti-lock me-1"></i>{{ __('The review is validated by a person holding the "Validate exercise reviews" right (Business continuity, in the GRC Manager tab of profiles).', 'grcmanager') }}</p>
   {% endif %}
{% elseif can_validate %}
   <form method="post" action="{{ action }}" class="d-flex flex-wrap gap-2 mb-2" data-grc-confirm="{{ __('Return the review to draft? The reason is recorded in the validation history.', 'grcmanager') }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="id" value="{{ exercise.id }}">
      <input type="text" class="form-control flex-grow-1" style="min-width: 16rem" name="reason" required maxlength="2000" placeholder="{{ __('Reason for returning to draft (required)', 'grcmanager') }}" aria-label="{{ __('Reason', 'grcmanager') }}">
      <button type="submit" name="reopen_review" value="1" class="btn btn-outline-warning"><i class="ti ti-arrow-back-up me-1"></i>{{ __('Return to draft', 'grcmanager') }}</button>
   </form>
{% endif %}
{% if review.history is not empty %}
   <ul class="list-unstyled small">
      {% for h in review.history|reverse %}
         <li class="mb-1">
            {% if h.action == 'validated' %}
               <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-rosette-discount-check me-1"></i>{{ __('Validated', 'grcmanager') }}</span>
            {% else %}
               <span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-arrow-back-up me-1"></i>{{ __('Returned to draft', 'grcmanager') }}</span>
            {% endif %}
            <span class="text-muted text-nowrap">{{ h.date|formatted_datetime }}</span> - <strong>{{ h.user }}</strong>{% if h.comment %} : {{ h.comment }}{% endif %}
         </li>
      {% endfor %}
   </ul>
{% endif %}
