{# Issue #162 : contenu du ticket de mise en conformité d'un contrôle technique #}
<p>{{ __('Gaps found by the automated technical checks (GRC & Compliance): %s.', 'grcmanager')|format(label) }}</p>
<p>{{ help }}</p>
<p>{{ __('References', 'grcmanager') }} : {{ references|join(', ') }}</p>
<table border="1" cellpadding="4">
   <tr><th>{{ __('Item', 'grcmanager') }}</th><th>{{ __('Gap', 'grcmanager') }}</th></tr>
   {% for g in gaps %}<tr><td>{{ g.name }}</td><td>{{ g.detail }}</td></tr>{% endfor %}
</table>
{% if more > 0 %}<p>{{ __('… and %d more, visible in the automated technical checks.', 'grcmanager')|format(more) }}</p>{% endif %}
<p>{{ __('Fix each item, then run the checks again to verify. Nothing was changed automatically.', 'grcmanager') }}</p>
