{# Issue #185 : onglet « Cellule de crise » d'un incident de sécurité #}
<div class="container-fluid">
   {% if cell %}
      <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
         <h4 class="mb-0"><i class="ti ti-alarm me-1 text-danger"></i>{{ cell.exercise.scenario }}</h4>
         {% if cell.exercise.ended %}
            <span class="badge bg-green-lt"><i class="ti ti-flag-check me-1"></i>{{ __('Completed', 'grcmanager') }} — {{ cell.exercise.duration }} min</span>
         {% else %}
            <span class="badge bg-red-lt"><i class="ti ti-clock me-1"></i>{{ __('Active for %d min', 'grcmanager')|format(cell.exercise.duration) }}</span>
         {% endif %}
      </div>
      <p class="mb-2">
         {{ __('Steps done', 'grcmanager') }} : <strong>{{ cell.summary.done }} / {{ cell.summary.total }}</strong>
         {% if cell.recovery is not empty %}
            — {{ __('Items restored', 'grcmanager') }} : <strong>{{ cell.recovery|filter(r => r.restored_at)|length }} / {{ cell.recovery|length }}</strong>
         {% endif %}
      </p>
      <a href="{{ room_url }}" class="btn btn-primary"><i class="ti ti-door-enter me-1"></i>{{ __('Open the crisis room', 'grcmanager') }}</a>
      {% if cell.exercise.document_url %}
         <a href="{{ cell.exercise.document_url }}" class="btn btn-outline-secondary ms-2"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Report', 'grcmanager') }}</a>
      {% endif %}
   {% elseif drill %}
      <p class="text-muted">{{ __('No crisis room for this exercise incident.', 'grcmanager') }}</p>
   {% else %}
      <p>{{ __('For a major incident, the crisis team follows the response plan step by step (each with a target time), tracks the recovery of affected items against their RTO, and keeps the chronological crisis log.', 'grcmanager') }}</p>
      {% if can_activate %}
         <form method="post" action="{{ action }}" class="d-flex flex-wrap align-items-end gap-2" data-grc-confirm="{{ __('Activate the crisis team now? The timer starts and one task is created per plan step.', 'grcmanager') }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="incident" value="{{ incident_id }}">
            <div>
               <label class="form-label" for="grc-crisis-scenario">{{ __('Response plan', 'grcmanager') }}</label>
               <select class="form-select" id="grc-crisis-scenario" name="scenario">
                  {% for key, label in scenarios %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
               </select>
            </div>
            <button type="submit" name="activate" value="1" class="btn btn-danger"><i class="ti ti-alarm me-1"></i>{{ __('Activate the crisis team', 'grcmanager') }}</button>
         </form>
         <div class="form-hint">{{ __('First link the affected items to the incident ("Items" tab): the crisis room will track their recovery and that of what depends on them.', 'grcmanager') }}</div>
         {% include '@grcmanager/_confirm_forms.html.twig' %}
      {% endif %}
   {% endif %}
</div>
