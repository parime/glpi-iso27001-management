{# Issue #865 : aperçu d'un fichier de réponses du fournisseur avant enregistrement
   (front/supplierevaluationfile.php). Rien n'est enregistré sans le bouton « Enregistrer ». #}
<div class="card" id="grc-evaluation-import">
   <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <h3 class="card-title mb-0"><i class="ti ti-file-import me-1"></i>{{ __('Review the supplier file', 'grcmanager') }}</h3>
      <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-file-text me-1"></i>{{ file_name }}</span>
      <a href="{{ evaluation_url }}" class="ms-auto"><i class="ti ti-arrow-left me-1"></i>{{ evaluation_name }}</a>
   </div>
   <div class="card-body">
   {% if error %}
      <div class="alert alert-danger" id="grc-import-error"><i class="ti ti-file-alert me-2"></i>{{ error }}</div>
      <a href="{{ evaluation_url }}" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>{{ __('Back to the evaluation', 'grcmanager') }}</a>
      {% if draft_id is defined %}
         <form method="post" action="{{ action }}" class="d-inline">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ evaluation_id }}">
            <input type="hidden" name="draft_id" value="{{ draft_id }}">
            <button type="submit" name="cancel" value="1" class="btn btn-outline-danger"><i class="ti ti-trash me-1"></i>{{ __('Discard these answers', 'grcmanager') }}</button>
         </form>
      {% endif %}
   {% else %}
      {% if warnings is not empty %}
         <div class="alert alert-warning" id="grc-import-warnings">
            <h4 class="alert-title"><i class="ti ti-alert-triangle me-1"></i>{{ _n('%d point to check', '%d points to check', warnings|length, 'grcmanager')|format(warnings|length) }}</h4>
            <ul class="mb-0">{% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
         </div>
      {% endif %}
      {% if changes is empty %}
         <div class="alert alert-info"><i class="ti ti-info-circle me-2"></i>{{ __('The file brings no new answer and no new comment.', 'grcmanager') }}</div>
      {% else %}
         <p class="text-muted">{{ _n('%d question changes. Check the answers, then save them: they will be marked as coming from the supplier file.', '%d questions change. Check the answers, then save them: they will be marked as coming from the supplier file.', changes|length, 'grcmanager')|format(changes|length) }}</p>
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table" id="grc-import-changes">
               <thead>
                  <tr>
                     <th>{{ __('Question', 'grcmanager') }}</th>
                     <th>{{ __('Current answer', 'grcmanager') }}</th>
                     <th>{{ __('Answer in the file', 'grcmanager') }}</th>
                     <th>{{ __('Comment in the file', 'grcmanager') }}</th>
                     <th>{{ __('Evidence file name', 'grcmanager') }}</th>
                  </tr>
               </thead>
               <tbody>
               {% for change in changes %}
                  <tr>
                     <td><span class="text-muted me-1">{{ change.code }}</span>{{ change.question }}</td>
                     <td>{% if change.old_answer %}<span class="badge bg-secondary-subtle text-secondary-emphasis">{{ (change.answer_type == scale_type ? scale_labels : labels)[change.old_answer] ?? change.old_answer }}</span>{% else %}<span class="text-muted">-</span>{% endif %}</td>
                     <td>{% if change.answer is not null %}<span class="badge bg-green-subtle text-green-emphasis"><i class="ti ti-arrow-right me-1"></i>{{ (change.answer_type == scale_type ? scale_labels : labels)[change.answer] ?? change.answer }}</span>{% else %}<span class="text-muted small">{{ __('unchanged', 'grcmanager') }}</span>{% endif %}</td>
                     <td class="small">{% if change.comment is not null %}{{ change.comment|nl2br }}{% else %}<span class="text-muted">{{ __('unchanged', 'grcmanager') }}</span>{% endif %}</td>
                     <td class="small">{% if change.evidence %}<i class="ti ti-paperclip me-1"></i>{{ change.evidence }}{% else %}<span class="text-muted">-</span>{% endif %}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
      <form method="post" action="{{ action }}" enctype="multipart/form-data" class="mt-3" id="grc-import-confirm-form">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="id" value="{{ evaluation_id }}">
         {% if draft_id is defined %}
            <input type="hidden" name="draft_id" value="{{ draft_id }}">
            {% if received_files is not empty %}
               <div class="mb-3" id="grc-import-received-files">
                  <h4><i class="ti ti-paperclip me-1"></i>{{ __('Documents sent by the supplier', 'grcmanager') }}</h4>
                  <p class="text-muted small">{{ __('They are checked again like any evidence when you save, then attached to their question.', 'grcmanager') }}</p>
                  <ul class="mb-0">{% for name in received_files %}<li>{{ name }}</li>{% endfor %}</ul>
               </div>
            {% endif %}
         {% endif %}
         {% if evidence_names is not empty and can_upload %}
            <div class="mb-3">
               <label class="form-label" for="grc-import-evidence"><i class="ti ti-paperclip me-1"></i>{{ __('Documents sent by the supplier', 'grcmanager') }}</label>
               <input type="file" id="grc-import-evidence" name="evidence_files[]" class="form-control" multiple>
               <div class="form-hint">{{ __('Each document is attached to the questions whose column "Evidence file name" gives its name. It is checked like any evidence (types allowed by GLPI, size, real content). Expected: %s', 'grcmanager')|format(evidence_names|join(', ')) }}</div>
            </div>
         {% endif %}
         <div class="d-flex flex-wrap gap-2">
            {% if changes is not empty %}
               <button type="submit" name="confirm" value="1" class="btn btn-primary" id="grc-import-confirm"><i class="ti ti-device-floppy me-1"></i>{{ __('Save these answers', 'grcmanager') }}</button>
            {% endif %}
            {% if draft_id is defined %}
               <button type="submit" name="cancel" value="1" class="btn btn-outline-danger"><i class="ti ti-trash me-1"></i>{{ __('Discard these answers', 'grcmanager') }}</button>
            {% else %}
               <button type="submit" name="cancel" value="1" class="btn btn-outline-secondary"><i class="ti ti-x me-1"></i>{{ __('Cancel', 'grcmanager') }}</button>
            {% endif %}
         </div>
      </form>
   {% endif %}
   </div>
</div>
