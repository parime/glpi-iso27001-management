{# Issue #846 : droits d'accès aux partages de fichiers Windows (A.5.15, A.5.18, A.8.3), partages des
   entités de la personne. Lecture seule : rien n'est modifié sur les serveurs de fichiers. #}
{% import '@grcmanager/share_access_macros.html.twig' as share %}

<div id="grc-share-access">
   <div class="row row-cards mb-3">
      {% set cards = [
         {'id': 'grc-share-count', 'icon': 'ti ti-folders', 'color': 'azure', 'value': summary.shares, 'label': __('Shares', 'grcmanager'), 'help': __('%d right(s) imported', 'grcmanager')|format(summary.aces)},
         {'id': 'grc-share-gaps', 'icon': 'ti ti-alert-triangle', 'color': summary.gap_shares > 0 ? 'danger' : 'success', 'value': summary.gap_shares, 'label': __('Shares with a gap', 'grcmanager'), 'help': __('%d with a high weighted score', 'grcmanager')|format(summary.high)},
         {'id': 'grc-share-owners', 'icon': 'ti ti-user-star', 'color': summary.without_owner > 0 ? 'warning' : 'success', 'value': summary.without_owner, 'label': __('Shares without an owner', 'grcmanager'), 'help': __('The owner reviews the rights of the share.', 'grcmanager')},
         {'id': 'grc-share-reviewed', 'icon': 'ti ti-checklist', 'color': summary.shares > 0 and summary.reviewed == summary.shares ? 'success' : 'warning', 'value': summary.reviewed ~ ' / ' ~ summary.shares, 'label': __('Shares reviewed in the last 12 months', 'grcmanager'), 'help': ''},
      ] %}
      {% for card in cards %}
         <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
            <div class="d-flex align-items-center">
               <span class="badge bg-{{ card.color }}-subtle text-{{ card.color }}-emphasis me-2 fs-3"><i class="{{ card.icon }}"></i></span>
               <div>
                  <div class="fw-bold fs-3" id="{{ card.id }}">{{ card.value }}</div>
                  <div class="small">{{ card.label }}</div>
               </div>
            </div>
            {% if card.help %}<div class="small text-muted mt-1">{{ card.help }}</div>{% endif %}
         </div></div></div>
      {% endfor %}
   </div>

   {% if summary.shares > 0 %}
      <div class="mb-3" id="grc-share-gap-summary">
         {% for code, info in gap_infos %}
            {% if summary.gaps[code] > 0 %}<span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-1 mb-1" title="{{ info.help }}"><i class="ti ti-alert-triangle me-1"></i>{{ info.label }} : {{ summary.gaps[code] }}</span>{% endif %}
         {% endfor %}
      </div>
   {% endif %}

   {# Partages : les plus exposés d'abord (score pondéré par la classification). #}
   <div class="card mb-3" id="grc-share-list">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-folder-share me-2"></i>{{ __('Shares and their gaps', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_rows }}</span></div>
      </div>
      {% if rows is empty %}
         <div class="card-body text-muted">
            <i class="ti ti-info-circle me-1"></i>{{ __('No share imported yet. Run the PowerShell script below on a file server, then import the CSV file it produces.', 'grcmanager') }}
         </div>
      {% else %}
         {% if total_rows > rows|length %}
            <div class="card-body small pb-0">{{ __('%1$d shares: the first %2$d are shown, the most exposed first.', 'grcmanager')|format(total_rows, rows|length) }}</div>
         {% endif %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Share', 'grcmanager') }}</th>
                  <th>{{ __('Classification', 'grcmanager') }}</th>
                  <th>{{ __('Owner', 'grcmanager') }}</th>
                  <th class="text-end">{{ __('Rights', 'grcmanager') }}</th>
                  <th>{{ __('Gaps', 'grcmanager') }}</th>
                  <th>{{ __('Weighted score', 'grcmanager') }}</th>
                  <th>{{ __('Review', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for row in rows %}
                  <tr{% if not row.is_present %} class="text-muted"{% endif %}>
                     <td>
                        <a href="{{ row.url }}"><i class="ti ti-folder me-1"></i>{{ row.label }}</a>
                        {% if row.share_path %}<div class="small text-muted">{{ row.share_path }}</div>{% endif %}
                        {% if not row.is_present %}<span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-folder-off me-1"></i>{{ __('Absent from the last import', 'grcmanager') }}</span>{% endif %}
                     </td>
                     <td>{{ share.classification(row.classification, cid_levels) }}</td>
                     <td class="small">
                        {% if row.owner_name %}<i class="ti ti-user-star me-1"></i>{{ row.owner_name }}{% else %}<span class="badge bg-warning-subtle text-warning-emphasis">{{ __('None', 'grcmanager') }}</span>{% endif %}
                     </td>
                     <td class="text-end">{{ row.aces }}</td>
                     <td>
                        {% for code, count in row.gaps %}
                           {% set info = gap_infos[code] %}
                           <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-1 mb-1" title="{{ info.help }}">{{ info.label }}{% if count > 1 %} : {{ count }}{% endif %}</span>
                        {% endfor %}
                     </td>
                     <td>{{ share.score(row.score, scores[row.score_level]) }}</td>
                     <td class="small">
                        {% if row.review_open %}
                           <span class="badge bg-azure-subtle text-azure-emphasis"><i class="ti ti-progress me-1"></i>{{ __('In progress', 'grcmanager') }}{% if row.pending > 0 %} : {{ __('%d to review', 'grcmanager')|format(row.pending) }}{% endif %}</span>
                        {% elseif row.last_review %}
                           <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-check me-1"></i>{{ row.last_review }}</span>
                        {% else %}
                           <span class="text-muted">{{ __('Never reviewed', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Historique des imports : suivi des droits ajoutés et retirés. #}
   {% if imports is not empty %}
      <div class="card mb-3" id="grc-share-history">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-history me-2"></i>{{ __('Imports and changes over time', 'grcmanager') }}</h3>
         </div>
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Date') }}</th><th>{{ __('Server', 'grcmanager') }}</th>
                  <th class="text-end">{{ __('Shares', 'grcmanager') }}</th><th class="text-end">{{ __('Rights', 'grcmanager') }}</th>
                  <th class="text-end">{{ __('New rights', 'grcmanager') }}</th><th class="text-end">{{ __('Removed rights', 'grcmanager') }}</th>
                  <th>{{ __('Imported by', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for import in imports %}
                  <tr>
                     <td>{{ import.date }}</td>
                     <td><i class="ti ti-server me-1"></i>{{ import.server }}</td>
                     <td class="text-end">{{ import.shares }}</td>
                     <td class="text-end">{{ import.aces }}</td>
                     <td class="text-end">{% if import.added > 0 %}<span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-plus me-1"></i>{{ import.added }}</span>{% else %}0{% endif %}</td>
                     <td class="text-end">{% if import.removed > 0 %}<span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-minus me-1"></i>{{ import.removed }}</span>{% else %}0{% endif %}</td>
                     <td class="small">{{ import.user }}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      </div>
   {% endif %}

   {# Import du CSV produit par le script PowerShell fourni. #}
   <div class="card mb-3" id="grc-share-import">
      <div class="card-header">
         <h3 class="card-title d-flex align-items-center flex-wrap gap-2">
            <i class="ti ti-file-import"></i>{{ __('Import the rights of a file server', 'grcmanager') }}
            <span class="badge bg-azure-subtle text-azure-emphasis"><i class="ti ti-eye me-1"></i>{{ __('Read only', 'grcmanager') }}</span>
         </h3>
      </div>
      <div class="card-body">
         <p class="small">{{ __('GLPI never connects to your file servers and never changes a right. An administrator runs the PowerShell script on the file server, with an account that can read the folders, then imports the CSV file here. A new import of the same server replaces the previous one in the current entity and shows the rights added and removed since then; the classification, the owner and the review decisions are kept.', 'grcmanager') }}</p>
         <ol class="small text-muted">
            <li>{{ __('Download the script and copy it to the file server.', 'grcmanager') }}</li>
            <li>{{ __('In PowerShell, run for example: ./Export-GrcShareAccess.ps1 -Depth 2 -OutFile shares.csv (Depth: how many folder levels under each share are read).', 'grcmanager') }}</li>
            <li>{{ __('Import the shares.csv file below. Files produced by other tools are accepted if they have a header with columns such as Server, Share, Folder, Identity, Rights, AccessType, IsInherited and InheritanceProtected.', 'grcmanager') }}</li>
         </ol>
         <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn btn-sm btn-outline-secondary" href="{{ script_url }}"><i class="ti ti-terminal-2 me-1"></i>{{ __('Download the PowerShell script', 'grcmanager') }}</a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ example_url }}"><i class="ti ti-file-type-csv me-1"></i>{{ __('Download an example file', 'grcmanager') }}</a>
         </div>
         {% if can_manage %}
            {% if servers is not empty %}
               <table class="table table-sm mb-3">
                  <thead><tr><th>{{ __('Server imported in this entity', 'grcmanager') }}</th><th></th></tr></thead>
                  <tbody>
                  {% for server in servers %}
                     <tr>
                        <td><i class="ti ti-server me-1"></i>{{ server }}</td>
                        <td class="text-end">
                           <form method="post" action="{{ action }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="server" value="{{ server }}">
                              <button type="submit" class="btn btn-sm btn-outline-danger" name="clear_shares" value="1"><i class="ti ti-trash me-1"></i>{{ __('Delete the import', 'grcmanager') }}</button>
                           </form>
                        </td>
                     </tr>
                  {% endfor %}
                  </tbody>
               </table>
            {% endif %}
            <form method="post" action="{{ action }}" enctype="multipart/form-data" class="row g-2 align-items-end">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="col-md-8">
                  <label class="form-label" for="grc-share-file">{{ __('CSV file', 'grcmanager') }}</label>
                  <input type="file" class="form-control" id="grc-share-file" name="share_file" accept=".csv,.txt,text/csv" required>
               </div>
               <div class="col-md-4">
                  <button type="submit" class="btn btn-primary" name="import_shares" value="1"><i class="ti ti-upload me-1"></i>{{ __('Import', 'grcmanager') }}</button>
               </div>
            </form>
         {% else %}
            <p class="small text-muted mb-0">{{ __('Only users who can modify the plugin data and the sensitive registers can import.', 'grcmanager') }}</p>
         {% endif %}
      </div>
   </div>

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted small me-auto">
         <i class="ti ti-shield-lock me-1"></i>{{ __('The score adds 3 for each serious gap and 1 for the others, then multiplies by 3 for a share classified high and by 2 for medium. Nothing is changed on the file servers from this page.', 'grcmanager') }}
      </span>
      <a class="btn btn-sm btn-outline-secondary" href="{{ hygiene_url }}"><i class="ti ti-user-search me-1"></i>{{ __('Account hygiene', 'grcmanager') }}</a>
      <a class="btn btn-sm btn-outline-primary" href="{{ review_url }}"><i class="ti ti-checklist me-1"></i>{{ __('Access reviews', 'grcmanager') }}</a>
   </div>
</div>
