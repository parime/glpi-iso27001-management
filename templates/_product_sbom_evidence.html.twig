{# Issue #869 : preuves des nomenclatures logicielles (SBOM) et des déclarations VEX sur une mesure. #}
<div id="grc-sbom-evidence">
   <span class="badge {{ evidence.products > 0 ? 'bg-success-subtle text-success-emphasis' : 'bg-secondary-subtle text-secondary-emphasis' }} me-1"><i class="ti ti-packages me-1"></i>{{ __('%d product(s) with an SBOM', 'grcmanager')|format(evidence.products) }}</span>
   {% if evidence.register > 0 %}
      <span class="badge {{ evidence.register_without > 0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-apps me-1"></i>{{ __('%d application(s) of the register without an SBOM', 'grcmanager')|format(evidence.register_without) }}</span>
   {% endif %}
   {% if evidence.code != 'A.5.21' %}
      <span class="badge bg-azure-subtle text-azure-emphasis me-1"><i class="ti ti-bug me-1"></i>{{ __('%d known vulnerability(ies) in the components', 'grcmanager')|format(evidence.indicators.total) }}</span>
      <span class="badge {{ evidence.indicators.without_statement > 0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-help-hexagon me-1"></i>{{ __('%d without VEX statement', 'grcmanager')|format(evidence.indicators.without_statement) }}</span>
      <span class="badge {{ evidence.indicators.affected > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-alert-octagon me-1"></i>{{ __('%d affected', 'grcmanager')|format(evidence.indicators.affected) }}</span>
      <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-shield-check me-1"></i>{{ __('%d not affected or fixed', 'grcmanager')|format(evidence.indicators.not_affected + evidence.indicators.fixed) }}</span>
   {% endif %}
   <span class="small text-muted me-2">{{ __('Computed on %s', 'grcmanager')|format(evidence.date) }}</span>
   <a href="{{ evidence.url }}">{{ __('View the details', 'grcmanager') }}</a>
</div>
