{# Issue #859 : macros communes de la page des comptes à privilèges et de l'onglet de la revue des accès. #}
{% macro gaps(codes, infos) %}
   {% for code in codes %}
      {% set info = infos[code] %}
      <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-1 mb-1"><i class="{{ info.icon }} me-1"></i>{{ info.label }}</span>
   {% else %}
      <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-check me-1"></i>{{ __('No gap', 'grcmanager') }}</span>
   {% endfor %}
{% endmacro %}
{% macro two_factor(value) %}
   {% if value is null %}
      <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ __('Not known', 'grcmanager') }}</span>
   {% elseif value %}
      <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-shield-check me-1"></i>{{ __('Yes') }}</span>
   {% else %}
      <span class="badge bg-danger-subtle text-danger-emphasis"><i class="ti ti-shield-x me-1"></i>{{ __('No') }}</span>
   {% endif %}
{% endmacro %}
