{# Issue #1042 : connexion à Zabbix et actifs à superviser (déplacés de front/zabbixmonitoring.php).
   Le jeton n'est jamais renvoyé au navigateur : le champ reste vide, un badge indique s'il est enregistré. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set z = zabbix %}
{% set disabled = can_edit_config ? '' : 'disabled' %}
<div class="card mb-3" id="grc-zabbix-config">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-activity-heartbeat"></i>{{ __('Connection to Zabbix (read only)', 'grcmanager') }}
      {% if z.configured %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-x me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
      {% endif %}
      {% if z.enabled %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-player-play me-1"></i>{{ __('Enabled', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-player-pause me-1"></i>{{ __('Disabled', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="small mb-2">
      {% if z.last_read %}
        <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('Last reading: %s', 'grcmanager')|format(z.last_read) }}</span>
      {% else %}
        {{ __('No reading yet.', 'grcmanager') }}
      {% endif %}
      <a href="{{ z.page_url }}" class="ms-1"><i class="ti ti-arrow-right me-1"></i>{{ __('See the results', 'grcmanager') }}</a>
      {% if z.last_error %}<span class="d-block text-danger mt-1"><i class="ti ti-alert-triangle me-1"></i>{{ z.last_error }}</span>{% endif %}
    </p>
    <p class="small text-muted mb-1">{{ __('How to prepare Zabbix:', 'grcmanager') }}</p>
    <ol class="small text-muted">
      <li>{{ __('Users > User roles: create a role of type User with API access limited to the methods host.get, problem.get, event.get, service.get, sla.get and sla.getsli.', 'grcmanager') }}</li>
      <li>{{ __('Users > Users: create a user with this role, in a user group with read permission on the host groups to monitor (and on the services).', 'grcmanager') }}</li>
      <li>{{ __('Users > API tokens: create a token for this user, then copy it here with the address of the Zabbix interface.', 'grcmanager') }}</li>
    </ol>
    {% if not z.allow_private %}
      <div class="alert alert-info small py-2">
        <i class="ti ti-info-circle me-1"></i>{{ __('A Zabbix server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration.', 'grcmanager') }}
        <a href="#grc-outgoing-http">{{ __('Outgoing connections', 'grcmanager') }}</a>
      </div>
    {% endif %}
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-6">
        <label class="form-label" for="grc-zabbix-url">{{ __('Address of the Zabbix interface', 'grcmanager') }}</label>
        <input type="url" class="form-control" id="grc-zabbix-url" name="zabbix_url" value="{{ z.url }}" maxlength="255" placeholder="https://zabbix.example.test/zabbix" autocomplete="off" {{ disabled }}>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="grc-zabbix-token">{{ __('API token', 'grcmanager') }}</label>
        <input type="password" class="form-control" id="grc-zabbix-token" name="zabbix_api_token" value="" autocomplete="new-password" placeholder="{{ z.has_token ? __('Token saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ disabled }}>
      </div>
      <div class="col-12 form-hint">
        {% if z.has_token %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Token saved', 'grcmanager') }}</span>{% endif %}
        {{ __('The token is encrypted with the GLPI key, never displayed again nor logged. Only the address of this server is called, and only to read.', 'grcmanager') }}
        {% if z.has_token and can_edit_config %}
          <span class="form-check form-check-inline ms-2">
            <input type="checkbox" class="form-check-input" id="grc-zabbix-clear" name="zabbix_clear_token" value="1">
            <label class="form-check-label" for="grc-zabbix-clear">{{ __('Delete the saved token', 'grcmanager') }}</label>
          </span>
        {% endif %}
      </div>
      <div class="col-md-6">
        {{ fields.dropdownField('Entity', 'zabbix_entities_id', z.entity, __('Entity of the readings', 'grcmanager'), {
          'helper': __('The readings are visible in this entity and its sub-entities; hosts not matched with an asset are only listed in this entity.', 'grcmanager'),
          'full_width': true,
          'readonly': not can_edit_config,
        }) }}
      </div>
      <div class="col-md-6">
        <div class="form-check form-switch">
          <input type="checkbox" class="form-check-input" role="switch" id="grc-zabbix-enabled" name="zabbix_enabled" value="1" {{ z.enabled ? 'checked' }} {{ disabled }}>
          <label class="form-check-label" for="grc-zabbix-enabled">{{ __('Read automatically every day (automatic action "zabbix")', 'grcmanager') }}</label>
        </div>
      </div>
      {% if can_edit_config %}
        <div class="col-12 d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary" name="save_zabbix" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
          {% if z.configured %}
            <button type="submit" class="btn btn-outline-secondary" name="test_zabbix" value="1"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>

    <h5 class="mt-4"><i class="ti ti-adjustments me-1"></i>{{ __('Which assets must be monitored?', 'grcmanager') }}</h5>
    <p class="small mb-2">{{ __('Critical assets are those with a high confidentiality, integrity or availability level (C/I/A classification tab), or published on the Internet (network flow matrix).', 'grcmanager') }}</p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-6">
        <label class="form-label" for="grc-zabbix-scope">{{ __('Assets concerned', 'grcmanager') }}</label>
        <select class="form-select" id="grc-zabbix-scope" name="zabbix_scope" {{ disabled }}>
          {% for key, label in z.scopes %}
            <option value="{{ key }}" {{ key == z.settings.scope ? 'selected' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-zabbix-period">{{ __('Period of the problems (days)', 'grcmanager') }}</label>
        <input type="number" class="form-control" id="grc-zabbix-period" name="zabbix_period_days" value="{{ z.settings.period_days }}" min="1" max="90" {{ disabled }}>
      </div>
      {% if can_edit_config %}
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary" name="save_zabbix_settings" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>
