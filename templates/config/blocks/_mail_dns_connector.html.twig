{# Issue #1042 : serveur DNS de la question DNSSEC (déplacé de front/maildomainsecurity.php). #}
{% set d = mail_dns %}
{% set disabled = can_edit_config ? '' : 'disabled' %}
<div class="card mb-3" id="grc-mail-dns-config">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-server-cog"></i>{{ __('DNS server used for DNSSEC (optional)', 'grcmanager') }}
      {% if d.server %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ d.server }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ __('DNS server of the GLPI server', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="text-muted small">
      {{ __('By default, the DNS server of the GLPI server is asked. Some of them (inside Docker, for example) do not relay the DNSSEC records: DNSSEC then shows "Unknown". Enter the IP address of another DNS server of your organisation or of your provider to fix it.', 'grcmanager') }}
      <span class="ms-1 text-secondary"><i class="ti ti-arrow-right me-1"></i>{{ __('Results in the menu: %s', 'grcmanager')|format(d.page_path) }}</span>
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-4">
        <label class="form-label" for="grc-mail-dns">{{ __('IP address of the DNS server', 'grcmanager') }}</label>
        <input type="text" class="form-control" id="grc-mail-dns" name="dns_server" maxlength="45" placeholder="{{ __('DNS server of the GLPI server', 'grcmanager') }}" value="{{ d.server }}" {{ disabled }}>
      </div>
      {% if can_edit_config %}
        <div class="col-md-8 d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary" name="save_dns_server" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
          <button type="submit" class="btn btn-outline-secondary" name="test_dns_server" value="1"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>
