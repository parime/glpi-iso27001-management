{# Issue #707 : connecteur SentinelOne en lecture seule (voir front/config.php, SentinelOneAlert).
   Le jeton n'est jamais renvoyé au navigateur : le champ reste vide, un texte indique s'il est enregistré. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set s1 = sentinelone %}
<div class="card mb-3" id="grc-sentinelone">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-shield-search"></i>{{ __('SentinelOne connector', 'grcmanager') }}
      <span class="badge bg-azure-subtle text-azure-emphasis"><i class="ti ti-eye me-1"></i>{{ __('Read only', 'grcmanager') }}</span>
      {% if s1.enabled %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-player-play me-1"></i>{{ __('Enabled', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-player-pause me-1"></i>{{ __('Disabled', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="text-muted">
      {{ __('Every hour, the threats and alerts detected by SentinelOne are fetched and proposed as security incidents on the EDR import screen: nothing is created without your validation. The agents are matched with the GLPI computers (serial number, then exact name) and the application vulnerabilities join the fleet vulnerabilities. Nothing is ever sent to SentinelOne (no isolation, no resolution).', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="form-check form-switch mb-2">
        <input type="hidden" name="sentinelone_enabled" value="0">
        <input type="checkbox" class="form-check-input" role="switch" id="grc-s1-enabled" name="sentinelone_enabled" value="1" {{ s1.enabled ? 'checked' }} {{ can_edit_config ? '' : 'disabled' }}>
        <label class="form-check-label" for="grc-s1-enabled">{{ __('Fetch automatically from SentinelOne', 'grcmanager') }}</label>
        <div class="form-hint">{{ __('Turns on the automatic action that reads SentinelOne every hour. Off by default.', 'grcmanager') }}</div>
      </div>
      <div class="row g-2">
        <div class="col-md-6">
          <label class="form-label" for="grc-s1-url">{{ __('Console address', 'grcmanager') }}</label>
          <input type="url" class="form-control" id="grc-s1-url" name="sentinelone_url" value="{{ s1.url }}" placeholder="https://euce1-100.sentinelone.net" maxlength="255" {{ can_edit_config ? '' : 'disabled' }}>
          <div class="form-hint">{{ __('The address you use to open the SentinelOne console, in HTTPS.', 'grcmanager') }}</div>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="grc-s1-token">{{ __('API token', 'grcmanager') }}</label>
          <input type="password" class="form-control" id="grc-s1-token" name="sentinelone_api_token" value="" autocomplete="new-password" placeholder="{{ s1.has_token ? __('Token saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ can_edit_config ? '' : 'disabled' }}>
          <div class="form-hint">
            {% if s1.has_token %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Token saved', 'grcmanager') }}</span>{% endif %}
            {{ __('Token of a service user with the Viewer role only. Encrypted with the GLPI key, never displayed again nor logged.', 'grcmanager') }}
          </div>
          {% if s1.has_token %}
            <div class="form-check mt-1">
              <input type="checkbox" class="form-check-input" id="grc-s1-clear" name="sentinelone_clear_token" value="1" {{ can_edit_config ? '' : 'disabled' }}>
              <label class="form-check-label" for="grc-s1-clear">{{ __('Delete the saved token', 'grcmanager') }}</label>
            </div>
          {% endif %}
        </div>
      </div>
      <div class="mt-2" style="max-width: 32rem">
        {{ fields.dropdownField('Entity', 'sentinelone_entities_id', s1.entities_id, __('Entity of the alerts whose computer is not found in GLPI', 'grcmanager'), {
          'field_class': 'col-12',
          'label_class': 'col-12',
          'input_class': 'col-12',
        }) }}
      </div>
      {% if can_edit_config %}
        <div class="d-flex flex-wrap gap-2 mt-2">
          <button type="submit" name="update_sentinelone_config" class="btn btn-primary">{{ __('Save') }}</button>
          {% if s1.configured %}
            <button type="submit" name="test_sentinelone_config" class="btn btn-outline-secondary"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
            <button type="submit" name="fetch_sentinelone_now" class="btn btn-outline-secondary"><i class="ti ti-refresh me-1"></i>{{ __('Fetch now', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>

    {% if s1.cron_url %}
      <div class="form-hint mt-2">
        <i class="ti ti-clock me-1"></i>{{ __('Automatic action', 'grcmanager') }} :
        {% if s1.cron_active %}
          <span class="badge bg-success-subtle text-success-emphasis">{{ __('active', 'grcmanager') }}</span>
        {% else %}
          <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ __('disabled', 'grcmanager') }}</span>
        {% endif %}
        <a href="{{ s1.cron_url }}">{{ __('Open the automatic action', 'grcmanager') }}</a>
      </div>
    {% endif %}

    {% if s1.last_run %}
      <h5 class="mt-3"><i class="ti ti-history me-1"></i>{{ __('Last read: %s', 'grcmanager')|format(s1.last_run.date) }}</h5>
      <ul class="list-unstyled mb-2">
        {% for key, step in s1.last_run.steps %}
          <li class="mb-1">
            <strong>{{ s1.step_labels[key] ?? key }}</strong> :
            {% if step.error is empty %}
              <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-check me-1"></i>{{ __('%d read', 'grcmanager')|format(step.items) }}</span>
              {% if step.new is defined and step.new > 0 %}<span class="badge bg-blue-subtle text-blue-emphasis">{{ __('%d new', 'grcmanager')|format(step.new) }}</span>{% endif %}
              {% if not step.complete %}<span class="badge bg-warning-subtle text-warning-emphasis">{{ __('continued at the next run', 'grcmanager') }}</span>{% endif %}
            {% else %}
              <span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-alert-triangle me-1"></i>{{ s1.error_labels[step.error] ?? step.error }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      {% if s1.review_url %}
        <a href="{{ s1.review_url }}" class="btn btn-sm btn-outline-primary"><i class="ti ti-list-check me-1"></i>{{ __('Review the proposed alerts', 'grcmanager') }}</a>
      {% endif %}
    {% endif %}

    {% if s1.agents.agents > 0 %}
      <h5 class="mt-3"><i class="ti ti-device-desktop me-1"></i>{{ __('Agents', 'grcmanager') }}</h5>
      <p class="mb-1">
        <span class="badge bg-blue-subtle text-blue-emphasis">{{ __('%d agent(s) in the console', 'grcmanager')|format(s1.agents.agents) }}</span>
        {% if s1.agents.total > 0 %}
          <span class="badge bg-warning-subtle text-warning-emphasis">{{ __('%d without a matching GLPI computer', 'grcmanager')|format(s1.agents.total) }}</span>
        {% else %}
          <span class="badge bg-success-subtle text-success-emphasis">{{ __('all matched with a GLPI computer', 'grcmanager') }}</span>
        {% endif %}
      </p>
      {% if s1.agents.rows is not empty %}
        <p class="text-muted small mb-1">{{ __('These agents are never matched by a similar name: create or rename the computer in the inventory, or fill in its serial number.', 'grcmanager') }}</p>
        <div class="table-responsive">
          <table class="table table-sm table-vcenter small mb-0">
            <thead><tr><th>{{ __('Computer name in SentinelOne', 'grcmanager') }}</th><th>{{ __('Serial number') }}</th><th>{{ __('Operating system') }}</th></tr></thead>
            <tbody>
              {% for agent in s1.agents.rows %}
                <tr><td>{{ agent.computer_name }}</td><td>{{ agent.serial ?: '-' }}</td><td>{{ agent.os ?: '-' }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>
