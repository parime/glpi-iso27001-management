{# Issue #1043 : application Microsoft Entra ID / Microsoft Graph (déplacée de front/mfacoverage.php),
   utilisée par la couverture MFA et les droits SharePoint, OneDrive et Teams. Le secret n'est jamais
   renvoyé au navigateur : le champ reste vide, un badge indique s'il est enregistré. #}
{% set g = entra_graph %}
{% set disabled = can_edit_config ? '' : 'disabled' %}
<div class="card mb-3" id="grc-entra-graph-config">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-brand-azure"></i>{{ __('Microsoft Entra ID and Microsoft Graph', 'grcmanager') }}
      <span class="badge bg-azure-subtle text-azure-emphasis"><i class="ti ti-eye me-1"></i>{{ __('Read only', 'grcmanager') }}</span>
      {% if g.configured %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-off me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="small mb-2">
      {% if g.last_read %}
        <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('Last reading: %s', 'grcmanager')|format(g.last_read) }}</span>
      {% else %}
        {{ __('No reading yet.', 'grcmanager') }}
      {% endif %}
      <a href="{{ g.mfa_url }}" class="ms-1"><i class="ti ti-arrow-right me-1"></i>{{ __('MFA coverage', 'grcmanager') }}</a>
      {% if g.share_url %}
        <a href="{{ g.share_url }}" class="ms-2"><i class="ti ti-arrow-right me-1"></i>{{ __('SharePoint, OneDrive and Teams rights', 'grcmanager') }}</a>
      {% endif %}
    </p>
    <p class="small">{{ __('The same application reads the MFA methods of the accounts and the sharing rights of SharePoint, OneDrive and Teams, when you click the button on these pages. Nothing is ever written in Entra ID or Microsoft 365 and nothing runs automatically.', 'grcmanager') }}</p>
    <ol class="small text-muted">
      <li>{{ __('In the Entra admin center, App registrations > New registration: create an application (for example "GLPI GRC - MFA report").', 'grcmanager') }}</li>
      <li>{{ __('API permissions > Add a permission > Microsoft Graph > Application permissions: AuditLog.Read.All, then Grant admin consent. The report requires an Entra ID P1 or P2 licence.', 'grcmanager') }}</li>
      <li>{{ __('For the sharing rights, also grant Sites.Read.All, Files.Read.All, User.Read.All and GroupMember.Read.All.', 'grcmanager') }}</li>
      <li>{{ __('Certificates & secrets > New client secret, then copy here the tenant ID, the application (client) ID and the secret value.', 'grcmanager') }}</li>
    </ol>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-4">
        <label class="form-label" for="grc-mfa-graph-tenant">{{ __('Tenant (directory) ID or domain', 'grcmanager') }}</label>
        <input type="text" class="form-control" id="grc-mfa-graph-tenant" name="mfa_graph_tenant" value="{{ g.tenant }}" maxlength="253" placeholder="example.onmicrosoft.com" autocomplete="off" {{ disabled }}>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="grc-mfa-graph-client">{{ __('Application (client) ID', 'grcmanager') }}</label>
        <input type="text" class="form-control" id="grc-mfa-graph-client" name="mfa_graph_client_id" value="{{ g.client_id }}" maxlength="36" placeholder="00000000-0000-0000-0000-000000000000" autocomplete="off" {{ disabled }}>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="grc-mfa-graph-secret">{{ __('Client secret', 'grcmanager') }}</label>
        <input type="password" class="form-control" id="grc-mfa-graph-secret" name="mfa_graph_secret" value="" autocomplete="new-password" placeholder="{{ g.has_secret ? __('Secret saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ disabled }}>
      </div>
      <div class="col-12 form-hint">
        {% if g.has_secret %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Secret saved', 'grcmanager') }}</span>{% endif %}
        {{ __('The secret is encrypted with the GLPI key, never displayed again nor logged.', 'grcmanager') }}
        {% if g.has_secret and can_edit_config %}
          <span class="form-check form-check-inline ms-2">
            <input type="checkbox" class="form-check-input" id="grc-mfa-graph-clear" name="mfa_graph_clear_secret" value="1">
            <label class="form-check-label" for="grc-mfa-graph-clear">{{ __('Delete the saved secret', 'grcmanager') }}</label>
          </span>
        {% endif %}
      </div>
      {% if can_edit_config %}
        <div class="col-12 d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary" name="save_mfa_graph" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
          {% if g.configured %}
            <button type="submit" class="btn btn-outline-secondary" name="test_mfa_graph" value="1"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>
  </div>
</div>
