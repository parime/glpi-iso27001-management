{# Issue #1044 : journalisation attendue (issue #853), déplacée de la page de couverture de la
   journalisation, qui garde les imports et les déclarations de plateforme. #}
{% set lg = logging %}
<div class="card mb-3" id="grc-log-settings">
  <div class="card-body">
    <h4 class="d-flex align-items-center"><i class="ti ti-file-text me-2"></i>{{ __('Which assets must send their logs?', 'grcmanager') }}</h4>
    <div class="alert alert-info mb-3">
      <div class="d-flex">
        <i class="ti ti-help-circle me-2 fs-2"></i>
        <div>
          <div class="fw-bold">{{ __('What is this for?', 'grcmanager') }}</div>
          {{ __('An asset is critical when one axis of its C/I/A classification is high (tab of the asset form), or when a network flow publishes it on the Internet. Servers are recognized from the computer type or the operating system name.', 'grcmanager') }}
        </div>
      </div>
    </div>
    <p class="mb-2"><span class="badge bg-info-subtle text-info-emphasis me-1"><i class="ti ti-info-circle me-1"></i>{{ __('Current rule', 'grcmanager') }}</span>{{ lg.scopes[lg.settings.scope] }} · {{ __('No event for more than %d days: logs stopped', 'grcmanager')|format(lg.settings.stale_days) }} · {{ __('Retention required by the policy: %d days', 'grcmanager')|format(lg.settings.policy_days) }}</p>
    {% if lg.can_manage %}
      <form method="post">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <div class="row g-3 align-items-end">
          <div class="col-md-4">
            <label class="form-label" for="grc-log-scope">{{ __('Assets concerned', 'grcmanager') }}</label>
            <select class="form-select" id="grc-log-scope" name="log_scope">
              {% for value, label in lg.scopes %}
                <option value="{{ value }}" {{ lg.settings.scope == value ? 'selected' }}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="grc-log-stale">{{ __('Logs stopped after (days without event)', 'grcmanager') }}</label>
            <input type="number" class="form-control" id="grc-log-stale" name="log_stale_days" min="1" max="365" value="{{ lg.settings.stale_days }}">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="grc-log-policy">{{ __('Retention required by the policy (days)', 'grcmanager') }}</label>
            <input type="number" class="form-control" id="grc-log-policy" name="log_policy_days" min="1" max="3650" value="{{ lg.settings.policy_days }}">
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary" name="save_log_settings" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</div>
