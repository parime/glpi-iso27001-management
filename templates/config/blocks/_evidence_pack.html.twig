{# Issue #1045 : limite de taille du dossier de preuves (venue de front/evidencepack.php). #}
<div class="card mb-3" id="grc-evidence-pack-settings">
  <div class="card-body">
    <h4><i class="ti ti-file-zip me-1"></i>{{ pack_title }}</h4>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <label class="form-label" for="grc-pack-max">{{ __('Maximum size of the archive (MB)', 'grcmanager') }}</label>
      <div class="input-group" style="max-width: 24rem">
        <input type="number" id="grc-pack-max" name="max_mb" value="{{ pack_max_mb }}" min="{{ pack_min_mb }}" max="{{ pack_limit_mb }}" class="form-control" {{ pack_can_edit ? '' : 'disabled' }}>
        {% if pack_can_edit %}
          <button type="submit" name="update_evidence_pack" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
        {% endif %}
      </div>
      <small class="form-hint d-block mt-1">{{ __('Files that would exceed this size are listed in the index as not included.', 'grcmanager') }}</small>
    </form>
  </div>
</div>
