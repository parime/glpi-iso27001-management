{# Issue #1044 : délais cibles des correctifs de sécurité par criticité (issue #854), déplacés de
   la page d'exploitation, qui garde les taux par criticité. #}
{% set pt = patch %}
<div class="card mb-3" id="grc-patch-targets">
  <div class="card-body">
    <h4 class="d-flex align-items-center"><i class="ti ti-clock-shield me-2"></i>{{ __('Target delays by criticality', 'grcmanager') }}</h4>
    <div class="alert alert-info mb-3">
      <div class="d-flex">
        <i class="ti ti-help-circle me-2 fs-2"></i>
        <div>
          <div class="fw-bold">{{ __('What is this for?', 'grcmanager') }}</div>
          {{ __('The criticality of a computer comes from its C/I/A classification (tab of the computer form): the highest of the three levels counts. A computer that a network flow publishes on the Internet is critical. A computer is late when its last known patch is older than the delay of its criticality.', 'grcmanager') }}
        </div>
      </div>
    </div>
    <form method="post">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="table-responsive">
        <table class="table table-sm table-vcenter">
          <thead><tr>
            <th>{{ __('Criticality', 'grcmanager') }}</th>
            <th style="width: 200px;">{{ __('Target delay (days)', 'grcmanager') }}</th>
          </tr></thead>
          <tbody>
          {% for tier, info in pt.tiers %}
            <tr>
              <td><span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis">{{ info.label }}</span> <span class="small text-muted">{{ info.help }}</span></td>
              <td>
                {% if pt.can_manage %}
                  <input type="number" class="form-control form-control-sm w-auto" name="patch_targets[{{ tier }}]" min="{{ pt.min_target }}" max="{{ pt.max_target }}" value="{{ pt.targets[tier] }}" aria-label="{{ __('Target delay (days)', 'grcmanager') }} {{ info.label }}">
                {% else %}
                  {{ pt.targets[tier] }}
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% if pt.can_manage %}
        <button type="submit" class="btn btn-primary" name="save_patch_targets" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
      {% endif %}
    </form>
  </div>
</div>
