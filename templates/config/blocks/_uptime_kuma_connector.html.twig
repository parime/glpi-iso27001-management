{# Issue #1042 : connexion à Uptime Kuma et seuils (déplacés de front/uptimekuma.php).
   La clé n'est jamais renvoyée au navigateur : le champ reste vide, un badge indique si elle est enregistrée. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set k = kuma %}
{% set disabled = can_edit_config ? '' : 'disabled' %}
<div class="card mb-3" id="grc-kuma-config">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-world-check"></i>{{ __('Connection to Uptime Kuma (read only)', 'grcmanager') }}
      {% if k.configured %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-x me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
      {% endif %}
      {% if k.enabled %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-player-play me-1"></i>{{ __('Enabled', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-player-pause me-1"></i>{{ __('Disabled', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="small mb-2">
      {% if k.last_read %}
        <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('Last reading: %s', 'grcmanager')|format(k.last_read) }}</span>
      {% else %}
        {{ __('No reading yet.', 'grcmanager') }}
      {% endif %}
      <span class="ms-1 text-secondary"><i class="ti ti-arrow-right me-1"></i>{{ __('Results in the menu: %s', 'grcmanager')|format(k.page_path) }}</span>
      {% if k.last_error %}<span class="d-block text-danger mt-1"><i class="ti ti-alert-triangle me-1"></i>{{ k.last_error }}</span>{% endif %}
    </p>
    <p class="small text-muted mb-1">{{ __('How to prepare Uptime Kuma (one of the two, or both):', 'grcmanager') }}</p>
    <ol class="small text-muted">
      <li>{{ __('Settings > API Keys: create a key (it only gives access to the /metrics page, in read only) and copy it here. All the monitors are then read, with their certificates.', 'grcmanager') }}</li>
      <li>{{ __('Or list public status pages: their identifier is the end of their address (for example "customers" for https://status.example.test/status/customers). Only the monitors shown on these pages are read, with their recent history.', 'grcmanager') }}</li>
    </ol>
    {% if not k.allow_private %}
      <div class="alert alert-info small py-2">
        <i class="ti ti-info-circle me-1"></i>{{ __('An Uptime Kuma server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration.', 'grcmanager') }}
        <a href="#grc-outgoing-http">{{ __('Outgoing connections', 'grcmanager') }}</a>
      </div>
    {% endif %}
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-6">
        <label class="form-label" for="grc-kuma-url">{{ __('Address of Uptime Kuma', 'grcmanager') }}</label>
        <input type="url" class="form-control" id="grc-kuma-url" name="uptimekuma_url" value="{{ k.url }}" maxlength="255" placeholder="https://status.example.test" autocomplete="off" {{ disabled }}>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="grc-kuma-key">{{ __('API key', 'grcmanager') }}</label>
        <input type="password" class="form-control" id="grc-kuma-key" name="uptimekuma_api_key" value="" autocomplete="new-password" placeholder="{{ k.has_key ? __('Key saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ disabled }}>
      </div>
      <div class="col-12 form-hint">
        {% if k.has_key %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Key saved', 'grcmanager') }}</span>{% endif %}
        {{ __('The key is encrypted with the GLPI key, never displayed again nor logged. Only the address of this server is called, and only to read.', 'grcmanager') }}
        {% if k.has_key and can_edit_config %}
          <span class="form-check form-check-inline ms-2">
            <input type="checkbox" class="form-check-input" id="grc-kuma-clear" name="uptimekuma_clear_key" value="1">
            <label class="form-check-label" for="grc-kuma-clear">{{ __('Delete the saved key', 'grcmanager') }}</label>
          </span>
        {% endif %}
      </div>
      <div class="col-md-6">
        <label class="form-label" for="grc-kuma-pages">{{ __('Public status pages (optional)', 'grcmanager') }}</label>
        <input type="text" class="form-control" id="grc-kuma-pages" name="uptimekuma_status_pages" value="{{ k.pages }}" maxlength="1000" placeholder="customers, intranet" autocomplete="off" {{ disabled }}>
        <div class="form-hint">{{ __('Identifiers separated by commas.', 'grcmanager') }}</div>
      </div>
      <div class="col-md-6">
        {{ fields.dropdownField('Entity', 'uptimekuma_entities_id', k.entity, __('Entity of the readings', 'grcmanager'), {
          'helper': __('The readings are visible in this entity and its sub-entities; monitors not matched with an asset are only listed in this entity.', 'grcmanager'),
          'full_width': true,
          'readonly': not can_edit_config,
        }) }}
      </div>
      <div class="col-12">
        <div class="form-check form-switch">
          <input type="checkbox" class="form-check-input" role="switch" id="grc-kuma-enabled" name="uptimekuma_enabled" value="1" {{ k.enabled ? 'checked' }} {{ disabled }}>
          <label class="form-check-label" for="grc-kuma-enabled">{{ __('Read automatically every hour (automatic action "uptimekuma"): the availability is more precise with regular readings', 'grcmanager') }}</label>
        </div>
      </div>
      {% if can_edit_config %}
        <div class="col-12 d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary" name="save_uptimekuma" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
          {% if k.configured %}
            <button type="submit" class="btn btn-outline-secondary" name="test_uptimekuma" value="1"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>

    <h5 class="mt-4"><i class="ti ti-adjustments me-1"></i>{{ __('Thresholds', 'grcmanager') }}</h5>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-3">
        <label class="form-label" for="grc-kuma-period">{{ __('Period of the availability (days)', 'grcmanager') }}</label>
        <input type="number" class="form-control" id="grc-kuma-period" name="uptimekuma_period_days" value="{{ k.settings.period_days }}" min="1" max="90" {{ disabled }}>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-kuma-cert">{{ __('Warn before a certificate expires (days)', 'grcmanager') }}</label>
        <input type="number" class="form-control" id="grc-kuma-cert" name="uptimekuma_cert_days" value="{{ k.settings.cert_days }}" min="1" max="180" {{ disabled }}>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-kuma-outage">{{ __('Long outage, from (minutes)', 'grcmanager') }}</label>
        <input type="number" class="form-control" id="grc-kuma-outage" name="uptimekuma_outage_minutes" value="{{ k.settings.outage_minutes }}" min="1" max="1440" {{ disabled }}>
      </div>
      {% if can_edit_config %}
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary" name="save_uptimekuma_settings" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>
