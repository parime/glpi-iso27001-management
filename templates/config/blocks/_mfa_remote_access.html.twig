{% import 'components/form/fields_macros.html.twig' as fields %}
{# Issue #1043 : groupes GLPI dont les membres ont un accès distant (déplacés de front/mfacoverage.php). #}
{% set r = mfa_remote %}
<div class="card mb-3" id="grc-mfa-remote-config">
  <div class="card-body">
    <h4><i class="ti ti-world-share me-2"></i>{{ __('Which accounts have remote access?', 'grcmanager') }}</h4>
    <p class="small mb-2">
      {% if r.names is empty %}
        {{ __('No group chosen: only the accounts marked remote_access in an import count as remote access accounts.', 'grcmanager') }}
      {% else %}
        {{ __('Members of these groups have remote access: %s.', 'grcmanager')|format(r.names|join(', ')) }}
      {% endif %}
      <a href="{{ r.mfa_url }}" class="ms-1"><i class="ti ti-arrow-right me-1"></i>{{ __('MFA coverage', 'grcmanager') }}</a>
    </p>
    {% if can_edit_config %}
      <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        {{ fields.dropdownField('Group', 'mfa_remote_groups', r.groups, __('Remote access groups (VPN, remote desktop...)', 'grcmanager'), {
          'multiple': true,
          'entity': -1,
        }) }}
        <button type="submit" class="btn btn-primary" name="save_mfa_remote" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
      </form>
    {% endif %}
  </div>
</div>
