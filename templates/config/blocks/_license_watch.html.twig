{# Issue #1044 : éditeurs surveillés, logiciels ignorés et horizon d'alerte des licences
   (issue #779), déplacés de la page de conformité des licences. #}
{% set lw = license %}
<div class="card mb-3" id="grc-license-watch">
  <div class="card-body">
    <h4 class="d-flex align-items-center"><i class="ti ti-license me-2"></i>{{ __('Watched commercial publishers', 'grcmanager') }}</h4>
    <div class="alert alert-info mb-3">
      <div class="d-flex">
        <i class="ti ti-help-circle me-2 fs-2"></i>
        <div>
          <div class="fw-bold">{{ __('What is this for?', 'grcmanager') }}</div>
          {{ __('Software from these publishers (manufacturer in GLPI) must have a license recorded. Software whose name contains one of the ignored words (free tools from the same publishers) is never reported as missing a license.', 'grcmanager') }}
        </div>
      </div>
    </div>
    {% if lw.can_manage %}
      <form method="post">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="grc-license-publishers">{{ __('Watched publishers (one per line)', 'grcmanager') }}</label>
            <textarea class="form-control" id="grc-license-publishers" name="license_publishers" rows="8">{{ lw.publishers }}</textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="grc-license-ignored">{{ __('Ignored software (part of the name, one per line)', 'grcmanager') }}</label>
            <textarea class="form-control" id="grc-license-ignored" name="license_ignored" rows="8">{{ lw.ignored }}</textarea>
          </div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-md-6">
            <label class="form-label" for="grc-license-expiring">{{ __('Warn before a license expires (days, 0 to turn off)', 'grcmanager') }}</label>
            <input type="number" class="form-control" id="grc-license-expiring" name="license_expiring_days" min="0" max="{{ lw.max_expiring_days }}" step="1" value="{{ lw.expiring_days }}">
          </div>
        </div>
        <div class="mt-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary" name="save_license_watch" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
          <button type="submit" class="btn btn-outline-secondary" name="reset_license_watch" value="1"><i class="ti ti-restore me-1"></i>{{ __('Back to the default lists', 'grcmanager') }}</button>
        </div>
      </form>
    {% else %}
      <p class="small mb-2"><i class="ti ti-calendar-time me-1"></i>{{ lw.expiring_days > 0 ? __('Warning %d days before a license expires.', 'grcmanager')|format(lw.expiring_days) : __('No warning before a license expires.', 'grcmanager') }}</p>
      <div class="d-flex flex-wrap gap-1">
        {% for publisher in lw.publisher_list %}<span class="badge bg-secondary-subtle text-secondary-emphasis">{{ publisher }}</span>{% endfor %}
      </div>
    {% endif %}
  </div>
</div>
