{# Issue #1043 : connexion à GitHub et GitLab (déplacée de front/codesecurity.php). Les jetons ne sont
   jamais renvoyés au navigateur : les champs restent vides, un badge indique s'ils sont enregistrés. #}
{% set c = code_hosting %}
{% set disabled = can_edit_config ? '' : 'disabled' %}
<div class="card mb-3" id="grc-codesecurity-config">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-code"></i>{{ __('Connection to GitHub and GitLab (read only)', 'grcmanager') }}
      {% if c.configured %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-off me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="small mb-2">
      {% if c.last_read %}
        <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('Last reading: %s', 'grcmanager')|format(c.last_read) }}</span>
      {% else %}
        {{ __('No reading yet.', 'grcmanager') }}
      {% endif %}
      <a href="{{ c.page_url }}" class="ms-1"><i class="ti ti-arrow-right me-1"></i>{{ __('See the results', 'grcmanager') }}</a>
    </p>
    <p class="small text-muted mb-1">{{ __('How to prepare the tokens (one of the two, or both):', 'grcmanager') }}</p>
    <ol class="small text-muted">
      <li>{{ __('GitHub: create a fine-grained personal access token limited to the repositories concerned, with the read-only permissions "Dependabot alerts", "Secret scanning alerts" and "Code scanning alerts".', 'grcmanager') }}</li>
      <li>{{ __('GitLab: create a project or group access token with the "read_api" scope and at least the Developer role (the vulnerability report requires GitLab Ultimate).', 'grcmanager') }}</li>
    </ol>
    {% if not c.allow_private %}
      <div class="alert alert-info small py-2">
        <i class="ti ti-info-circle me-1"></i>{{ __('A server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration.', 'grcmanager') }}
        <a href="#grc-outgoing-http">{{ __('Outgoing connections', 'grcmanager') }}</a>
      </div>
    {% endif %}
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-12"><h5 class="mb-0"><i class="ti ti-brand-github me-1"></i>GitHub</h5></div>
      <div class="col-md-6">
        <label class="form-label" for="grc-cs-github-token">{{ __('Read-only token', 'grcmanager') }}</label>
        <input type="password" class="form-control" id="grc-cs-github-token" name="codesecurity_github_token" value="" autocomplete="new-password" placeholder="{{ c.has_github ? __('Token saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ disabled }}>
        {% if c.has_github %}
          <span class="badge bg-success-subtle text-success-emphasis mt-1"><i class="ti ti-lock me-1"></i>{{ __('Token saved', 'grcmanager') }}</span>
          {% if can_edit_config %}
            <span class="form-check form-check-inline ms-2">
              <input type="checkbox" class="form-check-input" id="grc-cs-github-clear" name="codesecurity_github_clear" value="1">
              <label class="form-check-label" for="grc-cs-github-clear">{{ __('Delete the saved token', 'grcmanager') }}</label>
            </span>
          {% endif %}
        {% endif %}
      </div>
      <div class="col-md-6">
        <label class="form-label" for="grc-cs-github-url">{{ __('GitHub Enterprise Server address (optional)', 'grcmanager') }}</label>
        <input type="url" class="form-control" id="grc-cs-github-url" name="codesecurity_github_url" value="{{ c.github_url }}" maxlength="255" placeholder="https://github.example.test" autocomplete="off" {{ disabled }}>
        <div class="form-hint">{{ __('Leave empty for github.com.', 'grcmanager') }}</div>
      </div>
      <div class="col-12"><h5 class="mb-0 mt-2"><i class="ti ti-brand-gitlab me-1"></i>GitLab</h5></div>
      <div class="col-md-6">
        <label class="form-label" for="grc-cs-gitlab-token">{{ __('Read-only token', 'grcmanager') }}</label>
        <input type="password" class="form-control" id="grc-cs-gitlab-token" name="codesecurity_gitlab_token" value="" autocomplete="new-password" placeholder="{{ c.has_gitlab ? __('Token saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ disabled }}>
        {% if c.has_gitlab %}
          <span class="badge bg-success-subtle text-success-emphasis mt-1"><i class="ti ti-lock me-1"></i>{{ __('Token saved', 'grcmanager') }}</span>
          {% if can_edit_config %}
            <span class="form-check form-check-inline ms-2">
              <input type="checkbox" class="form-check-input" id="grc-cs-gitlab-clear" name="codesecurity_gitlab_clear" value="1">
              <label class="form-check-label" for="grc-cs-gitlab-clear">{{ __('Delete the saved token', 'grcmanager') }}</label>
            </span>
          {% endif %}
        {% endif %}
      </div>
      <div class="col-md-6">
        <label class="form-label" for="grc-cs-gitlab-url">{{ __('GitLab server address (optional)', 'grcmanager') }}</label>
        <input type="url" class="form-control" id="grc-cs-gitlab-url" name="codesecurity_gitlab_url" value="{{ c.gitlab_url }}" maxlength="255" placeholder="https://gitlab.example.test" autocomplete="off" {{ disabled }}>
        <div class="form-hint">{{ __('Leave empty for gitlab.com.', 'grcmanager') }}</div>
      </div>
      <div class="col-12 form-hint">{{ __('The tokens are encrypted with the GLPI key, never displayed again nor logged. Only the security alerts are read; the value of an exposed secret is never requested.', 'grcmanager') }}</div>
      <div class="col-12">
        <div class="form-check form-switch">
          <input type="checkbox" class="form-check-input" role="switch" id="grc-cs-enabled" name="codesecurity_enabled" value="1" {{ c.enabled ? 'checked' }} {{ disabled }}>
          <label class="form-check-label" for="grc-cs-enabled">{{ __('Read automatically every day (automatic action "codesecurity")', 'grcmanager') }}</label>
        </div>
      </div>
      {% if can_edit_config %}
        <div class="col-12 d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary" name="save_codesecurity" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
          {% if c.configured %}
            <button type="submit" class="btn btn-outline-secondary" name="test_codesecurity" value="1"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>
  </div>
</div>
