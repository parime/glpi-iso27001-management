{% import 'components/form/fields_macros.html.twig' as fields %}
{# Issue #656 : groupe Direction de l'appétence au risque (issue #378). Réglage déplacé de la page
   « Appétence et tolérance au risque » vers la page de configuration du plugin (charte commune,
   section 9 : aucun réglage ailleurs). Registre sensible : modifiable avec son droit. #}
<div class="card mb-3" id="grc-risk-appetite-config">
  <div class="card-body">
    <h4><i class="ti ti-building me-1"></i>{{ risk_appetite_title }}</h4>
    <p class="text-muted">
      {% if direction_groups_id %}
        {{ __('Beyond the tolerance, only management can accept a risk: the members of the group below. Their acceptances and approvals are marked "Management".', 'grcmanager') }}
      {% else %}
        {{ __('No management group is set: anyone who can edit the register can accept a risk beyond the tolerance. Choose the group whose members represent management.', 'grcmanager') }}
      {% endif %}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      {{ fields.dropdownField('Group', 'direction_groups_id', direction_groups_id, __('Management group', 'grcmanager'), {'entity': -1, 'readonly': not can_edit_sensitive}) }}
      {% if can_edit_sensitive %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_risk_appetite_config" class="btn btn-primary">{{ __('Save') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>
