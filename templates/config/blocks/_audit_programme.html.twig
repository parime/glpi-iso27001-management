{# Issue #1045 : réglages du programme d'audit interne (venus de front/auditprogramme.php). #}
<div class="card mb-3" id="grc-audit-programme-settings">
  <div class="card-body">
    <h4><i class="ti ti-calendar-stats me-1"></i>{{ __('Programme settings', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('Certification cycle shown by default in the internal audit programme, and the trainings that make an auditor qualified.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-3 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <fieldset class="row g-3 m-0 p-0" {{ programme_can_edit ? '' : 'disabled' }}>
        <div class="col-md-4">
          <label class="form-label" for="grc-programme-cycle-start">{{ __('Default certification cycle', 'grcmanager') }}</label>
          <select name="cycle_start" id="grc-programme-cycle-start" class="form-select">
            {% for value, label in programme_start_choices %}
              <option value="{{ value }}"{% if value == programme_start %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-8">
          <label class="form-label" for="grc-programme-trainings">{{ __('Trainings that qualify an internal auditor', 'grcmanager') }}</label>
          {% if programme_trainings is empty %}
            <div class="text-muted small">{{ __('No training recorded yet.', 'grcmanager') }}</div>
          {% else %}
            <select name="training_ids[]" id="grc-programme-trainings" class="form-select" multiple size="4">
              {% for id, title in programme_trainings %}
                <option value="{{ id }}"{% if id in programme_qualifying %} selected{% endif %}>{{ title }}</option>
              {% endfor %}
            </select>
            <div class="form-hint">{{ __('For example "ISO 27001 internal auditor". The Team tab of each audit shows whether its auditors have followed one of them.', 'grcmanager') }}</div>
          {% endif %}
        </div>
      </fieldset>
      {% if programme_can_edit %}
        <div class="col-12">
          <button type="submit" name="update_audit_programme" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>
