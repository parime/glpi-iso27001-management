{# Issue #1044 : règle « doit être chiffré » du chiffrement des disques (issue #847), déplacée de
   la page d'exploitation. La déclaration des clés de récupération y reste. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set enc = encryption %}
<div class="card mb-3" id="grc-encryption-rule">
  <div class="card-body">
    <h4 class="d-flex align-items-center"><i class="ti ti-lock me-2"></i>{{ __('Which computers must be encrypted?', 'grcmanager') }}</h4>
    <div class="alert alert-info mb-3">
      <div class="d-flex">
        <i class="ti ti-help-circle me-2 fs-2"></i>
        <div>
          <div class="fw-bold">{{ __('What is this for?', 'grcmanager') }}</div>
          {{ __('A computer is a laptop or a tablet when its type in GLPI is one of those reported by the inventory agent (Laptop, Notebook, Portable, Tablet, Convertible...). The classification threshold uses the C/I/A classification of the computer (tab of the computer form).', 'grcmanager') }}
        </div>
      </div>
    </div>
    <p class="mb-2"><span class="badge bg-info-subtle text-info-emphasis me-1"><i class="ti ti-info-circle me-1"></i>{{ __('Current rule', 'grcmanager') }}</span>{{ enc.summary }}</p>
    {% if enc.can_manage %}
      <form method="post">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="grc-encryption-scope">{{ __('Computers concerned', 'grcmanager') }}</label>
            <select class="form-select" id="grc-encryption-scope" name="encryption_scope">
              {% for value, label in enc.scopes %}
                <option value="{{ value }}" {{ enc.rule.scope == value ? 'selected' }}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="grc-encryption-confidentiality">{{ __('Also every computer classified with', 'grcmanager') }}</label>
            <select class="form-select" id="grc-encryption-confidentiality" name="encryption_confidentiality">
              {% for value, label in enc.thresholds %}
                <option value="{{ value }}" {{ enc.rule.confidentiality == value ? 'selected' }}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        {{ fields.dropdownField('ComputerType', 'encryption_types', enc.rule.types, __('Computer types (when "Computers of the selected types" is chosen)', 'grcmanager'), {
          'multiple': true,
          'entity': -1,
          'helper': __('For example the types used for servers and desktops that hold sensitive data.', 'grcmanager'),
        }) }}
        <button type="submit" class="btn btn-primary" name="save_encryption_rule" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
      </form>
    {% endif %}
  </div>
</div>
