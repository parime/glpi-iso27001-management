{# Issue #1042 : connexion à Veeam Backup & Replication (déplacée de front/backupcoverage.php).
   Le mot de passe n'est jamais renvoyé au navigateur : le champ reste vide, un badge indique s'il est enregistré. #}
{% set v = veeam %}
{% set disabled = can_edit_config ? '' : 'disabled' %}
<div class="card mb-3" id="grc-veeam-config">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-database"></i>{{ __('Read Veeam Backup & Replication directly', 'grcmanager') }}
      <span class="badge bg-azure-subtle text-azure-emphasis"><i class="ti ti-eye me-1"></i>{{ __('Read only', 'grcmanager') }}</span>
      {% if v.configured %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-off me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="small mb-2">
      {% if v.last_read %}
        <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('Last reading: %s', 'grcmanager')|format(v.last_read) }}</span>
      {% else %}
        {{ __('No reading yet.', 'grcmanager') }}
      {% endif %}
      <span class="ms-1 text-secondary"><i class="ti ti-arrow-right me-1"></i>{{ __('Results in the menu: %s', 'grcmanager')|format(v.page_path) }}</span>
    </p>
    <p class="small">{{ __('When you click the button, GLPI reads from the REST API of Veeam the restore points of the last %d days (so the last successful backup of each machine) and the last result of each job. The result replaces the Veeam import of the current entity. No backup is ever started, nothing is changed in Veeam and nothing runs automatically.', 'grcmanager')|format(v.lookback) }}</p>
    <ol class="small text-muted">
      <li>{{ __('In the Veeam console, Users and Roles: add a dedicated account with the Veeam Backup Viewer role (read only).', 'grcmanager') }}</li>
      <li>{{ __('Check that the REST API service runs (port 9419 by default) and that its certificate is trusted by the GLPI server.', 'grcmanager') }}</li>
      <li>{{ __('A server with an internal address requires an administrator to allow internal addresses in the configuration page of the plugin.', 'grcmanager') }} <a href="#grc-outgoing-http">{{ __('Outgoing connections', 'grcmanager') }}</a></li>
    </ol>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-4">
        <label class="form-label" for="grc-veeam-url">{{ __('Address of the Veeam server', 'grcmanager') }}</label>
        <input type="text" class="form-control" id="grc-veeam-url" name="veeam_url" value="{{ v.url }}" maxlength="255" placeholder="https://veeam.example.test:9419" autocomplete="off" {{ disabled }}>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-veeam-user">{{ __('Read-only account', 'grcmanager') }}</label>
        <input type="text" class="form-control" id="grc-veeam-user" name="veeam_username" value="{{ v.username }}" maxlength="255" placeholder="EXAMPLE\glpi-reader" autocomplete="off" {{ disabled }}>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-veeam-password">{{ __('Password') }}</label>
        <input type="password" class="form-control" id="grc-veeam-password" name="veeam_password" value="" autocomplete="new-password" placeholder="{{ v.has_password ? __('Password saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ disabled }}>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="grc-veeam-version">{{ __('REST API revision', 'grcmanager') }}</label>
        <select class="form-select" id="grc-veeam-version" name="veeam_api_version" {{ disabled }}>
          {% for version in v.api_versions %}<option value="{{ version }}" {{ v.api_version == version ? 'selected' }}>{{ version }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-12 form-hint">
        {% if v.has_password %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Password saved', 'grcmanager') }}</span>{% endif %}
        {{ __('The password is encrypted with the GLPI key, never displayed again nor logged. Revision 1.1-rev2 works from Veeam 12.1; choose 1.2 or 1.3 for more recent versions.', 'grcmanager') }}
        {% if v.has_password and can_edit_config %}
          <span class="form-check form-check-inline ms-2">
            <input type="checkbox" class="form-check-input" id="grc-veeam-clear" name="veeam_clear_password" value="1">
            <label class="form-check-label" for="grc-veeam-clear">{{ __('Delete the saved password', 'grcmanager') }}</label>
          </span>
        {% endif %}
      </div>
      {% if can_edit_config %}
        <div class="col-12 d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary" name="save_veeam" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
          {% if v.configured %}
            <button type="submit" class="btn btn-outline-secondary" name="test_veeam" value="1"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>
  </div>
</div>
