{# Issue #859 : délai de renouvellement attendu des secrets du coffre-fort. #}
{% set p = vault_policy %}
<div class="card mb-3" id="grc-vault-rotation-config">
  <div class="card-body">
    <h4><i class="ti ti-refresh-alert me-2"></i>{{ __('How often must shared passwords be changed?', 'grcmanager') }}</h4>
    <p class="small mb-2">{{ __('A password of a shared or privileged account kept in the vault that has not been changed for longer is reported on the privileged accounts page and in the access reviews.', 'grcmanager') }}</p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-4">
        <label class="form-label" for="grc-vault-rotation">{{ __('Expected change delay (months)', 'grcmanager') }}</label>
        <input type="number" class="form-control" id="grc-vault-rotation" name="vault_rotation_months" value="{{ p.months }}" min="{{ p.min }}" max="{{ p.max }}" {{ can_edit_config ? '' : 'disabled' }}>
      </div>
      {% if can_edit_config %}
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary" name="save_vault_rotation" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>
