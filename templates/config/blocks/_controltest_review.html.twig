{# Issue #607 : relecture des tests d'efficacité par une seconde personne avant l'état « Vérifié ». #}
<div class="card mb-3" id="grc-controltest-review">
  <div class="card-body">
    <h4><i class="ti ti-user-check me-1"></i>{{ __('Review of effectiveness tests', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('When enabled, an effective test only gives the "Verified" status once another person (neither the tester nor the person who recorded it) has approved it. A partially effective or ineffective test still withdraws the "Verified" status at once.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="controltest_review" value="0">
      <label class="form-check form-switch">
        <input class="form-check-input" type="checkbox" name="controltest_review" value="1" {{ controltest_review ? 'checked' }} {{ can_edit_config ? '' : 'disabled' }}>
        <span class="form-check-label">{{ __('Require a review of each new effectiveness test', 'grcmanager') }}</span>
      </label>
      {% if can_edit_config %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_controltest_review" class="btn btn-primary">{{ __('Save') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>
