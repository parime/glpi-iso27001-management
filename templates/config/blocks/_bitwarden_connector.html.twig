{# Issue #859 : connexion à l'API publique d'organisation de Bitwarden (lecture des membres).
   Le secret n'est jamais renvoyé au navigateur : le champ reste vide, un badge indique s'il est enregistré. #}
{% set bw = bitwarden %}
{% set disabled = can_edit_config ? '' : 'disabled' %}
<div class="card mb-3" id="grc-bitwarden-config">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-lock-access"></i>{{ __('Connection to Bitwarden (read only)', 'grcmanager') }}
      {% if bw.configured %}
        <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-x me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
      {% endif %}
    </h4>
    <p class="small mb-2">
      {{ __('GLPI reads the members of your Bitwarden organization from the privileged accounts page, on request: email address, role, status, two-step login and accessible collections. Never an item, a password or a note.', 'grcmanager') }}
      <span class="d-block text-secondary mt-1"><i class="ti ti-arrow-right me-1"></i>{{ __('Results in the menu: %s', 'grcmanager')|format(bw.page_path) }}</span>
    </p>
    <p class="small text-muted mb-1">{{ __('How to prepare Bitwarden:', 'grcmanager') }}</p>
    <ol class="small text-muted">
      <li>{{ __('Admin Console > Settings > Organization info > API key: view the key (owner only) and copy the client ID and the client secret here. The organization API exists on the Teams and Enterprise plans.', 'grcmanager') }}</li>
      <li>{{ __('Vaultwarden does not provide this API: import the CSV files of the members and of the items on the page instead.', 'grcmanager') }}</li>
    </ol>
    {% if not bw.allow_private %}
      <div class="alert alert-info small py-2">
        <i class="ti ti-info-circle me-1"></i>{{ __('A self-hosted server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration.', 'grcmanager') }}
        <a href="#grc-outgoing-http">{{ __('Outgoing connections', 'grcmanager') }}</a>
      </div>
    {% endif %}
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-4">
        <label class="form-label" for="grc-bitwarden-server">{{ __('Server', 'grcmanager') }}</label>
        <select class="form-select" id="grc-bitwarden-server" name="bitwarden_server" {{ disabled }}>
          {% for value, label in bw.servers %}<option value="{{ value }}" {{ value == bw.server ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-8">
        <label class="form-label" for="grc-bitwarden-url">{{ __('Address of the self-hosted server', 'grcmanager') }}</label>
        <input type="url" class="form-control" id="grc-bitwarden-url" name="bitwarden_url" value="{{ bw.url }}" maxlength="255" placeholder="https://vault.example.test" autocomplete="off" {{ disabled }}>
        <div class="form-hint">{{ __('Only for a self-hosted server: GLPI calls its /identity and /api paths.', 'grcmanager') }}</div>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="grc-bitwarden-client">{{ __('Client ID', 'grcmanager') }}</label>
        <input type="text" class="form-control" id="grc-bitwarden-client" name="bitwarden_client_id" value="{{ bw.client_id }}" maxlength="64" placeholder="organization.00000000-0000-0000-0000-000000000000" autocomplete="off" {{ disabled }}>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="grc-bitwarden-secret">{{ __('Client secret', 'grcmanager') }}</label>
        <input type="password" class="form-control" id="grc-bitwarden-secret" name="bitwarden_secret" value="" autocomplete="new-password" placeholder="{{ bw.has_secret ? __('Secret saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ disabled }}>
      </div>
      <div class="col-12 form-hint">
        {% if bw.has_secret %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Secret saved', 'grcmanager') }}</span>{% endif %}
        {{ __('The secret is encrypted with the GLPI key, never displayed again nor logged. GLPI only asks for a token and reads the list of the members.', 'grcmanager') }}
        {% if bw.has_secret and can_edit_config %}
          <span class="form-check form-check-inline ms-2">
            <input type="checkbox" class="form-check-input" id="grc-bitwarden-clear" name="bitwarden_clear_secret" value="1">
            <label class="form-check-label" for="grc-bitwarden-clear">{{ __('Delete the saved secret', 'grcmanager') }}</label>
          </span>
        {% endif %}
      </div>
      {% if can_edit_config %}
        <div class="col-12 d-flex flex-wrap gap-2">
          <button type="submit" class="btn btn-primary" name="save_bitwarden" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
          {% if bw.configured %}
            <button type="submit" class="btn btn-outline-secondary" name="test_bitwarden" value="1"><i class="ti ti-plug-connected me-1"></i>{{ __('Test the connection', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>
  </div>
</div>
