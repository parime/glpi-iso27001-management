{# Issue #599 : catégorie NIS2 de chaque entité GLPI (entité importante ou essentielle), qui crée son
   registre ReCyF. Affiché quand le référentiel « NIS2 » est actif. #}
{% if recyf_enabled %}
<div class="card mb-3" id="grcmanager-recyf">
  <div class="card-body">
    <h4><i class="ti ti-shield-check me-1"></i>{{ __('NIS2 France: ReCyF register', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('For each GLPI entity subject to NIS2 in France, choose whether it is an important or an essential entity. Its ReCyF register is created with one record per measure, and NIS2 is then assessed on these measures; sub-entities without a choice follow their parent. Changing or removing the choice never deletes what was entered.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="table-responsive">
        <table class="table table-sm table-vcenter" style="max-width: 820px;">
          <thead>
            <tr>
              <th>{{ __('Entity', 'grcmanager') }}</th>
              <th>{{ __('Classification', 'grcmanager') }}</th>
            </tr>
          </thead>
          <tbody>
            {% for row in recyf_entities %}
              <tr>
                <td><label for="grc-recyf-{{ row.id }}">{{ row.name }}</label></td>
                <td>
                  <select class="form-select form-select-sm" id="grc-recyf-{{ row.id }}" name="recyf_category[{{ row.id }}]" {{ can_edit_config ? '' : 'disabled' }}>
                    <option value="">{{ __('Not subject (or follows its parent)', 'grcmanager') }}</option>
                    {% for value, label in recyf_categories %}
                      <option value="{{ value }}" {{ row.category == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                  </select>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="d-flex flex-wrap gap-2 mt-2">
        {% if can_edit_config %}
          <button type="submit" name="update_recyf_entities" class="btn btn-primary">{{ __('Save') }}</button>
        {% endif %}
      </div>
    </form>
  </div>
</div>
{% endif %}
