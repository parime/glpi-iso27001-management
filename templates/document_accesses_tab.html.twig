{# Issue #140 : historique des téléchargements des documents de l'audit et de ses constats. #}
<p class="text-muted">{{ __('Every download of a document of the audit or its findings, by a team member or the CISO group.', 'grcmanager') }}</p>
{% if accesses is empty %}
  <div class="alert alert-info">{{ __('No document of this audit has been downloaded yet.', 'grcmanager') }}</div>
{% else %}
  <table class="table table-hover card-table">
    <thead>
      <tr>
        <th>{{ __('Date', 'grcmanager') }}</th>
        <th>{{ __('User', 'grcmanager') }}</th>
        <th>{{ __('Document', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for access in accesses %}
        <tr>
          <td>{{ access.date }}</td>
          <td>{{ access.user }}</td>
          <td>{{ access.document ?: '#' ~ access.documents_id }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
