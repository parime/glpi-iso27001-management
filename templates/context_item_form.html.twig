{# Issue #608 : enjeu interne ou externe, ou partie intéressée (ISO 27001, articles 4.1 et 4.2). #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   <input type="hidden" name="{{ links_marker }}" value="1">
   <input type="hidden" name="kind" value="{{ item.fields['kind'] }}">

   {% if is_party %}
      {{ fields.smallTitle(__('Interested party', 'grcmanager'), 'ti ti-users-group') }}
      {{ fields.textField('name', item.fields['name'], __('Name'), {
         'add_field_html': hints.hint(__('For example "Key account customers" or "Data protection authority". Leave empty to use the name of the supplier or group chosen below.', 'grcmanager')),
      }) }}
      {{ fields.dropdownArrayField('party_type', item.fields['party_type'] ?: 'customer', party_types, __('Type of interested party', 'grcmanager')) }}
      {{ fields.dropdownField('Supplier', 'suppliers_id', item.fields['suppliers_id'], __('Supplier in GLPI', 'grcmanager'), {
         'add_field_html': hints.hint(__('Optional: when the party is a supplier already recorded in GLPI.', 'grcmanager')),
      }) }}
      {{ fields.dropdownField('Group', 'groups_id', item.fields['groups_id'], __('Group in GLPI', 'grcmanager'), {
         'add_field_html': hints.hint(__('Optional: when the party is a team or a department recorded as a group.', 'grcmanager')),
      }) }}
      {{ fields.textareaField('expectations', item.fields['expectations'], __('Needs and expectations', 'grcmanager'), {
         'full_width': true,
         'add_field_html': hints.hint(__('What this party expects from you about information security, e.g. "incident notification within 24 hours".', 'grcmanager')),
      }) }}

      {# Issue #771 : contact officiel (autorité, CSIRT, forces de l'ordre, groupe d'intérêt), A.5.5 et A.5.6. #}
      {{ fields.smallTitle(__('Official contact (A.5.5, A.5.6)', 'grcmanager'), 'ti ti-address-book') }}
      {{ fields.checkboxField('is_official_contact', item.fields['is_official_contact'] ?? 0, _n('Official contact', 'Official contacts', 1, 'grcmanager'), {
         'id': 'grcmanager-is-official-contact',
         'add_field_html': hints.hint(__('Tick if your organization may have to contact this party officially (authority, CSIRT, police, insurer, special interest group). It then appears in the register of official contacts.', 'grcmanager')),
      }) }}
      <div class="row col-12 grcmanager-official-contact">
         {{ fields.dropdownArrayField('contact_category', item.fields['contact_category'] ?: 'supervisory_authority', contact_categories, __('Contact category', 'grcmanager')) }}
         {{ fields.textField('contact_delay', item.fields['contact_delay'] ?? '', __('Time limit', 'grcmanager'), {
            'add_field_html': hints.hint(__('For example "72 hours after becoming aware of the breach" or "24 hours for the early warning".', 'grcmanager')),
         }) }}
         {# Issue #771, lot 2 : délai chiffré, qui donne l'échéance dans l'onglet des incidents et des violations. #}
         {{ fields.numberField('contact_delay_hours', item.fields['contact_delay_hours'] ?? 0, __('Time limit in hours', 'grcmanager'), {
            'min': 0,
            'max': 8760,
            'step': 1,
            'add_field_html': hints.hint(__('Optional: 72 for a personal data breach, 24 for an early warning. The deadline is then computed from the detection of the incident or the awareness of the breach. Leave 0 when there is no set time limit.', 'grcmanager')),
         }) }}
         {{ fields.textareaField('contact_details', item.fields['contact_details'] ?? '', __('Contact details', 'grcmanager'), {
            'full_width': true,
            'add_field_html': hints.hint(__('Phone numbers (including outside office hours), e-mail, online form, postal address. This information must stay usable during a crisis: the register can be printed.', 'grcmanager')),
         }) }}
         {{ fields.textareaField('when_to_contact', item.fields['when_to_contact'] ?? '', __('When to contact', 'grcmanager'), {
            'full_width': true,
            'add_field_html': hints.hint(__('Type of event and legal obligation, e.g. "Personal data breach with a risk for the persons (GDPR, article 33)".', 'grcmanager')),
         }) }}
         {{ fields.dropdownField('User', 'users_id_internal', item.fields['users_id_internal'] ?? 0, __('Authorised internal contact', 'grcmanager'), {
            'right': 'all',
            'add_field_html': hints.hint(__('The person allowed to contact this party on behalf of the organization (CISO, DPO, management).', 'grcmanager')),
         }) }}
         {{ fields.dropdownField('Group', 'groups_id_internal', item.fields['groups_id_internal'] ?? 0, __('Authorised internal group', 'grcmanager'), {
            'add_field_html': hints.hint(__('Optional: the team that can replace this person, e.g. the crisis team.', 'grcmanager')),
         }) }}
         {{ fields.checkboxField('on_security_incident', item.fields['on_security_incident'] ?? 0, __('To contact for a security incident', 'grcmanager'), {
            'add_field_html': hints.hint(__('Shown in the "Official contacts" tab of every security incident.', 'grcmanager')),
         }) }}
         {{ fields.checkboxField('on_data_breach', item.fields['on_data_breach'] ?? 0, __('To contact for a personal data breach', 'grcmanager'), {
            'add_field_html': hints.hint(__('Shown in the "Official contacts" tab of every personal data breach.', 'grcmanager')),
         }) }}
         {{ fields.dateField('contact_verified_date', item.fields['contact_verified_date'] ?? '', __('Last verification', 'grcmanager'), {
            'add_field_html': hints.hint(__('Date on which the contact details were last checked. A contact not verified for 12 months is flagged and its owner receives a reminder.', 'grcmanager')),
         }) }}
         {% if not item.isNewItem() %}
            <div class="form-field row col-12 col-sm-6 mb-2">
               <label class="col-form-label col-xxl-5 text-xxl-end">{{ __('Verification', 'grcmanager') }}</label>
               <div class="col-xxl-7 field-container d-flex align-items-center flex-wrap gap-2">
                  {% if contact_status == 'ok' %}
                     <span class="badge bg-success-subtle text-success-emphasis">
                        <i class="ti ti-circle-check me-1"></i>{{ __('Up to date, next verification by %s', 'grcmanager')|format(contact_next|formatted_date) }}
                     </span>
                  {% elseif contact_status == 'overdue' %}
                     <span class="badge bg-danger-subtle text-danger-emphasis">
                        <i class="ti ti-alert-triangle me-1"></i>{{ __('Not verified for more than 12 months', 'grcmanager') }}
                     </span>
                  {% else %}
                     <span class="badge bg-warning-subtle text-warning-emphasis">
                        <i class="ti ti-alert-triangle me-1"></i>{{ __('Never verified', 'grcmanager') }}
                     </span>
                  {% endif %}
                  {% if contact_verifier %}
                     <span class="text-muted small">{{ __('Verified by %s', 'grcmanager')|format(contact_verifier) }}</span>
                  {% endif %}
                  {% if can_review %}
                     <button type="submit" name="{{ contact_verified_marker }}" value="1" class="btn btn-sm btn-outline-success"
                        title="{{ __('Records today as the verification date, with your name. Your other changes on this form are saved too.', 'grcmanager') }}">
                        <i class="ti ti-phone-check me-1"></i>{{ __('Record the verification', 'grcmanager') }}
                     </button>
                  {% endif %}
               </div>
            </div>
         {% endif %}
         <div class="col-12 mb-2">
            <a href="{{ contacts_url }}"><i class="ti ti-address-book me-1"></i>{{ __('Open the register of official contacts', 'grcmanager') }}</a>
         </div>
      </div>
      <script>
         $(function () {
            var box = $('#grcmanager-is-official-contact');
            var toggle = function () {
               $('.grcmanager-official-contact').toggleClass('d-none', !box.is(':checked'));
            };
            box.on('change', toggle);
            toggle();
         });
      </script>
   {% else %}
      {{ fields.smallTitle(__('Internal or external issue', 'grcmanager'), 'ti ti-world') }}
      {% if is_climate %}
         <div class="col-12">
            <div class="alert alert-info d-flex align-items-start">
               <i class="ti ti-temperature me-2 mt-1"></i>
               <div>{{ __('Since the 2024 amendment of ISO 27001, the organization must determine whether climate change is a relevant issue. Answer yes or no, and write why: requirement 4.1 cannot be marked compliant until this is done.', 'grcmanager') }}</div>
            </div>
         </div>
      {% endif %}
      {{ fields.textField('name', item.fields['name'], __('Name'), {
         'add_field_html': hints.hint(__('A short title, e.g. "New cyber security law" or "Growth of remote work".', 'grcmanager')),
      }) }}
      {{ fields.dropdownArrayField('nature', item.fields['nature'] ?: 'internal', natures, __('Internal or external', 'grcmanager')) }}
      {{ fields.dropdownArrayField('category', item.fields['category'] ?: 'other', categories, __('Category', 'grcmanager')) }}
      {{ fields.textareaField('effect', item.fields['effect'], __('Effect on the ISMS', 'grcmanager'), {
         'full_width': true,
         'add_field_html': hints.hint(__('How this issue can affect the ability of the ISMS to achieve its intended results.', 'grcmanager')),
      }) }}
   {% endif %}

   {{ fields.smallTitle(__('Decision of the ISMS', 'grcmanager'), 'ti ti-scale') }}
   {{ fields.dropdownArrayField('relevance', item.fields['relevance'] ?: 'to_assess', relevances, is_climate ? __('Is climate change relevant?', 'grcmanager') : __('Decision', 'grcmanager'), {
      'add_field_html': hints.hint(is_climate
         ? __('"Retained by the ISMS" means relevant; "Not retained" means not relevant. A justification is required in both cases.', 'grcmanager')
         : __('Retained: the ISMS takes it into account. Not retained: write why.', 'grcmanager')),
   }) }}
   {% if is_party %}
      {{ fields.textareaField('requirements', item.fields['requirements'], __('Requirements retained by the ISMS', 'grcmanager'), {
         'full_width': true,
         'add_field_html': hints.hint(__('Which of these expectations become requirements of the ISMS. Link below the obligations and the controls that answer them.', 'grcmanager')),
      }) }}
   {% endif %}
   {{ fields.textareaField('justification', item.fields['justification'], __('Justification', 'grcmanager'), {
      'full_width': true,
   }) }}

   {{ fields.smallTitle(__('Links with the ISMS', 'grcmanager'), 'ti ti-link') }}
   {% set link_labels = {
      '_linked_risks': __('Related risks', 'grcmanager'),
      '_linked_obligations': __('Related obligations', 'grcmanager'),
      '_linked_controls': __('Controls that respond', 'grcmanager'),
   } %}
   {% for field, link in links %}
      {% if link.allowed %}
         {{ fields.dropdownArrayField(field, '', link.choices, link_labels[field], {
            'multiple': true, 'values': link.values, 'full_width': true,
            'add_field_html': link.hidden > 0
               ? hints.hint(_n('%d other linked item is not shown to you.', '%d other linked items are not shown to you.', link.hidden, 'grcmanager')|format(link.hidden))
               : '',
         }) }}
      {% endif %}
   {% endfor %}

   {{ fields.smallTitle(__('Follow-up', 'grcmanager'), 'ti ti-calendar-repeat') }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], _x('owner', 'Owner', 'grcmanager'), {
      'right': 'all',
   }) }}
   {{ fields.dateField('review_date', item.fields['review_date'], __('Review date', 'grcmanager'), {
      'add_field_html': hints.hint(__('The owner receives a reminder 30 days before this date.', 'grcmanager')),
   }) }}
   {% if not item.isNewItem() %}
      {# Lot 2 : revue périodique tracée (date et auteur), conservée dans l'historique de la fiche. #}
      <div class="form-field row col-12 col-sm-6 mb-2">
         <label class="col-form-label col-xxl-5 text-xxl-end">{{ __('Last review', 'grcmanager') }}</label>
         <div class="col-xxl-7 field-container d-flex align-items-center flex-wrap gap-2">
            {% if item.fields['last_review_date'] %}
               <span class="badge bg-success-subtle text-success-emphasis">
                  <i class="ti ti-circle-check me-1"></i>{{ __('%1$s by %2$s', 'grcmanager')|format(item.fields['last_review_date']|formatted_date, last_reviewer ?: '-') }}
               </span>
            {% else %}
               <span class="badge bg-warning-subtle text-warning-emphasis">
                  <i class="ti ti-alert-triangle me-1"></i>{{ __('Never reviewed', 'grcmanager') }}
               </span>
            {% endif %}
            {% if can_review %}
               <button type="submit" name="{{ review_marker }}" value="1" class="btn btn-sm btn-outline-success"
                  title="{{ __('Records today as the review date, with your name, and sets the next review one year later. Your other changes on this form are saved too.', 'grcmanager') }}">
                  <i class="ti ti-calendar-check me-1"></i>{{ __('Record the review', 'grcmanager') }}
               </button>
            {% endif %}
         </div>
      </div>
   {% endif %}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), {'full_width': true}) }}
{% endblock %}
