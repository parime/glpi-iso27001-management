{# Issue #772, lot 2 : plan d'audit de l'organisme de certification. Programme d'échantillonnage
   (processus x années du cycle), cases rattachées à l'audit de certification de chaque année, et
   processus échantillonnés de l'audit de l'année. #}
{% set p = plan %}
<div class="container-fluid" id="grc-certification-sampling">
   <div class="card mb-3">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-table-options me-2"></i>{{ __('Sampling programme of the certification body', 'grcmanager') }}</h3>
         <div class="card-actions d-flex gap-2">
            {% if new_audit_url %}<a href="{{ new_audit_url }}" class="btn btn-sm btn-primary"><i class="ti ti-plus me-1"></i>{{ __('Add an audit', 'grcmanager') }}</a>{% endif %}
            {% if findings_url %}<a href="{{ findings_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-certificate-2 me-1"></i>{{ __('Findings of previous audits', 'grcmanager') }}</a>{% endif %}
         </div>
      </div>
      <div class="card-body">
         <form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3" id="grc-sampling-cycle">
            <label class="form-label mb-0" for="grc-sampling-start">{{ __('Certification cycle', 'grcmanager') }}</label>
            <select name="start" id="grc-sampling-start" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
               {% for value, label in start_choices %}
                  <option value="{{ value }}"{% if value == p.start %} selected{% endif %}>{{ label }}</option>
               {% endfor %}
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-primary">{{ __('Show', 'grcmanager') }}</button></noscript>
            <span class="text-muted small">{{ __('The default cycle is set in the multi-year audit programme.', 'grcmanager') }}
               <a href="{{ programme_url }}">{{ __('Multi-year audit programme', 'grcmanager') }}</a></span>
         </form>

         {% if p.rows is empty %}
            <div class="alert alert-info mb-0" id="grc-sampling-no-process"><i class="ti ti-info-circle me-1"></i>{{ __('No ISMS process yet. The processes of the audit plan are those of the internal audit programme: the ISMS activities of the responsibility matrix (for example context and scope, ISMS planning, customer relations and contracts, asset management, access control, physical security, operations, continuity, incidents, human resources, suppliers, information protection, legal compliance, evaluation and improvement).', 'grcmanager') }}
               {% if raci_url %}<a href="{{ raci_url }}">{{ __('Responsibility matrix', 'grcmanager') }}</a>{% endif %}</div>
         {% else %}
            {% if p.columns is empty %}
               <div class="alert alert-warning" id="grc-sampling-no-audit"><i class="ti ti-alert-triangle me-1"></i>{{ __('No certification audit in this cycle. Add each audit of the cycle (initial or recertification, surveillance 1, surveillance 2) with its planned date: its column then appears here.', 'grcmanager') }}</div>
            {% elseif p.never > 0 %}
               <div class="alert alert-info" id="grc-sampling-never"><i class="ti ti-info-circle me-1"></i>{{ __('%d process(es) not sampled by the certification body over the cycle: the body usually covers every process within the three years.', 'grcmanager')|format(p.never) }}</div>
            {% endif %}
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="start" value="{{ p.start }}">
               {% for c in p.columns %}{% if c.can_edit %}<input type="hidden" name="audit_ids[]" value="{{ c.id }}">{% endif %}{% endfor %}
               <div class="table-responsive">
               <table class="table table-sm table-vcenter table-bordered" id="grc-sampling-matrix">
                  <thead>
                     <tr>
                        <th rowspan="2">{{ __('Process', 'grcmanager') }}</th>
                        {% for year in p.years %}
                           <th class="text-center{% if year == p.current_year %} bg-azure-lt{% endif %}" colspan="{{ max(1, p.by_year[year]) }}">{{ year }}</th>
                        {% endfor %}
                        <th rowspan="2">{{ __('Findings not lifted', 'grcmanager') }}</th>
                     </tr>
                     <tr>
                        {% for year in p.years %}
                           {% set year_columns = p.columns|filter(c => c.year == year) %}
                           {% for c in year_columns %}
                              <th class="text-center small grc-sampling-audit" data-audit="{{ c.id }}">
                                 <a href="{{ c.url }}">{{ c.title }}</a>
                                 <div class="text-muted fw-normal">{{ c.type_label }}{% if c.date %}, {{ c.date }}{% endif %}</div>
                              </th>
                           {% else %}
                              <th class="text-center small text-muted fw-normal grc-sampling-missing">{{ __('No certification audit', 'grcmanager') }}</th>
                           {% endfor %}
                        {% endfor %}
                     </tr>
                  </thead>
                  <tbody>
                  {% for row in p.rows %}
                     <tr class="grc-sampling-row" data-process="{{ row.id }}">
                        <td class="fw-bold">{{ row.label }}</td>
                        {% for year in p.years %}
                           {% set year_columns = p.columns|filter(c => c.year == year) %}
                           {% for c in year_columns %}
                              <td class="text-center">
                                 {% if c.can_edit and row.editable[c.id] %}
                                    <input type="checkbox" class="form-check-input grc-sampling-cell" name="sampled[{{ c.id }}][]" value="{{ row.id }}"{% if row.cells[c.id] %} checked{% endif %}
                                       aria-label="{{ __('%1$s sampled during %2$s', 'grcmanager')|format(row.label, c.title) }}">
                                 {% elseif row.cells[c.id] %}
                                    <i class="ti ti-check text-success" title="{{ __('Sampled', 'grcmanager') }}"></i>
                                 {% else %}
                                    <span class="text-muted">-</span>
                                 {% endif %}
                              </td>
                           {% else %}
                              <td class="text-center text-muted">-</td>
                           {% endfor %}
                        {% endfor %}
                        <td class="text-center">
                           {% if row.open_findings > 0 %}
                              {% if findings_url %}<a href="{{ row.findings_url }}" class="badge bg-danger-subtle text-danger-emphasis">{{ row.open_findings }}</a>{% else %}<span class="badge bg-danger-subtle text-danger-emphasis">{{ row.open_findings }}</span>{% endif %}
                           {% else %}
                              <span class="text-muted">0</span>
                           {% endif %}
                        </td>
                     </tr>
                  {% endfor %}
                  </tbody>
               </table>
               </div>
               {% if p.can_edit_any %}
                  <button type="submit" name="save_sampling" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
               {% endif %}
            </form>
         {% endif %}
      </div>
   </div>

   <div class="card mb-3" id="grc-sampling-year">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-calendar-event me-2"></i>{{ __('Audit of the year', 'grcmanager') }}</h3>
         {% if year_audit %}
            <div class="card-actions"><a href="{{ year_audit.getLinkURL() }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-certificate me-1"></i>{{ year_audit.fields['title'] }}</a></div>
         {% endif %}
      </div>
      <div class="card-body">
         {% if year_audit %}
            {{ include('@grcmanager/certification_sampling_processes.html.twig', {'processes': year_processes}) }}
         {% else %}
            <div class="text-muted">{{ __('No certification audit recorded yet.', 'grcmanager') }}</div>
         {% endif %}
      </div>
   </div>
</div>
