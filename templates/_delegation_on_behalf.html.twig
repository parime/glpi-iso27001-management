{# Issue #618 : décision attendue d'un titulaire absent que l'utilisateur remplace. Variables :
   name (titulaire), until (fin de l'absence déclarée). #}
<span class="badge bg-purple-subtle text-purple-emphasis" title="{{ __('Decision delegated for the declared absence period: it will be recorded as yours, on behalf of the absent person.', 'grcmanager') }}">
   <i class="ti ti-user-share me-1"></i>{{ __('On behalf of %1$s, absent until %2$s', 'grcmanager')|format(name, until) }}
</span>
