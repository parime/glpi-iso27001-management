{# Issue #379 : évaluation de conformité par référentiel. Score = mesures mises en œuvre ET prouvées
   (une preuve non expirée), sur les mesures applicables du référentiel : voir
   FrameworkAssessmentRules. Lecture seule.
   Issue #789 : chaque référentiel est évalué sur ses propres mesures (voir FrameworkAssessment :
   état propre, état déduit de la correspondance avec l'Annexe A si ISO 27001 est activé, ou aucune
   évaluation) ; le référentiel détaillé est choisi dans la liste et retenu pour la session. #}
{% macro rate_bar(value, color) %}
   {% if value is null %}
      <span class="text-muted">-</span>
   {% else %}
      <div class="d-flex align-items-center gap-2">
         <div class="progress progress-sm flex-fill" style="min-width: 80px;">
            <div class="progress-bar bg-{{ color }}" style="width: {{ value }}%" role="progressbar" aria-label="{{ __('Implementation rate', 'grcmanager') }}"
                 aria-valuenow="{{ value }}" aria-valuemin="0" aria-valuemax="100"></div>
         </div>
         <span class="text-nowrap">{{ value|number_format(1, ',') }} %</span>
      </div>
   {% endif %}
{% endmacro %}
{% macro basis_badge(basis, bases, catalog) %}
   {% if basis == bases.own and catalog == 'recyf' %}
      <span class="badge bg-teal-lt"><i class="ti ti-shield-check me-1"></i>{{ __('ReCyF measures (ANSSI)', 'grcmanager') }}</span>
   {% elseif basis == bases.own %}
      <span class="badge bg-teal-lt"><i class="ti ti-list-details me-1"></i>{{ __('Own measures', 'grcmanager') }}</span>
   {% elseif basis == bases.mapped %}
      <span class="badge bg-azure-lt"><i class="ti ti-arrows-exchange me-1"></i>{{ __('Own measures, status from the Annex A mapping', 'grcmanager') }}</span>
   {% else %}
      <span class="badge bg-secondary-lt"><i class="ti ti-circle-off me-1"></i>{{ __('No status of its own', 'grcmanager') }}</span>
   {% endif %}
{% endmacro %}
{# Issue #599 : NIS2 sans registre ReCyF, comment l'évaluer sur les mesures de l'ANSSI. #}
{% macro recyf_hint(recyf) %}
   <div class="alert alert-info small mt-3" role="note">
      {# Issue #1053 : ReCyF est la déclinaison France de NIS2, cochée dans la configuration. #}
      {% if recyf.enabled %}
      <i class="ti ti-bulb me-1"></i>{{ __('In France, NIS2 can be assessed on the measures of ReCyF, the framework of ANSSI: classify your entity as important or essential, and NIS2 is then assessed on its ReCyF register instead of the ISO 27001 Annex A.', 'grcmanager') }}
      {% else %}
      <i class="ti ti-bulb me-1"></i>{{ __('In France, NIS2 can be assessed on the measures of ReCyF, the framework of ANSSI: tick France (ReCyF) under NIS2 in the configuration, then classify your entity as important or essential.', 'grcmanager') }}
      {% endif %}
      <div class="mt-2 d-flex flex-wrap gap-2">
         {% if recyf.can_configure %}
            <a class="btn btn-sm btn-primary" href="{{ recyf.config_url }}"><i class="ti ti-settings me-1"></i>{{ recyf.enabled ? __('Classify the entities', 'grcmanager') : __('Configure the frameworks', 'grcmanager') }}</a>
         {% endif %}
         {% if recyf.enabled %}
         <a class="btn btn-sm btn-outline-secondary" href="{{ recyf.register_url }}"><i class="ti ti-shield-check me-1"></i>{{ __('Open the ReCyF register', 'grcmanager') }}</a>
         {% endif %}
      </div>
   </div>
{% endmacro %}
{% set evidence_badges = {
   'proven':  ['bg-green-lt', 'ti-file-check', __('Proven', 'grcmanager')],
   'expired': ['bg-red-lt', 'ti-file-alert', __('Evidence expired', 'grcmanager')],
   'none':    ['bg-secondary-lt', 'ti-file-off', __('No evidence', 'grcmanager')],
} %}
<div class="container-fluid my-2">
   <div class="card mb-3">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-list-check me-2"></i>{{ __('Assessment by framework', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="text-muted small">
            <i class="ti ti-info-circle me-1"></i>{{ __('Each framework is assessed on its own measures. When the plugin does not track their status (NIS2 requirements, ANSSI measures, CIS controls...), the status of each measure comes from the ISO 27001 Annex A controls it is mapped to, and only while ISO 27001 is enabled. The score counts the applicable measures that are implemented (or compliant) and, when evidence is tracked, proven by at least one evidence document that has not expired.', 'grcmanager') }}
         </p>
         {% if assessments is empty %}
            <p class="text-muted">{{ __('No framework is enabled.', 'grcmanager') }} <a href="{{ config_url }}">{{ __('Configure the frameworks', 'grcmanager') }}</a></p>
         {% else %}
         <form method="get" action="{{ page_url }}" class="d-flex flex-wrap align-items-end gap-2 mb-3" id="grc-assessment-select">
            <div>
               <label class="form-label" for="grc-assessment-framework">{{ __('Framework to detail', 'grcmanager') }}</label>
               <select class="form-select" id="grc-assessment-framework" name="framework">
                  <option value=""{% if selected is null %} selected{% endif %}>{{ __('Summary only', 'grcmanager') }}</option>
                  {# Issue #1053 : référentiels rangés par famille. #}
                  {% for family in families %}
                     <optgroup label="{{ family.label }}">
                     {% for row in family.rows %}
                        <option value="{{ row.assessment.key }}"{% if selected == row.assessment.key %} selected{% endif %}>{{ row.nested ? '- ' : '' }}{{ row.label }}</option>
                     {% endfor %}
                     </optgroup>
                  {% endfor %}
               </select>
            </div>
            <button type="submit" class="btn btn-primary"><i class="ti ti-eye me-1"></i>{{ __('Show') }}</button>
         </form>
         <div class="table-responsive">
         <table class="table table-sm table-vcenter" id="grc-framework-assessment">
            <thead>
               <tr>
                  <th>{{ __('Framework', 'grcmanager') }}</th>
                  <th>{{ __('Assessed on', 'grcmanager') }}</th>
                  <th class="text-end text-nowrap">{{ __('Applicable measures', 'grcmanager') }}</th>
                  <th>{{ __('Implementation', 'grcmanager') }}</th>
                  <th>{{ __('Evidence', 'grcmanager') }}</th>
                  <th>{{ __('Score', 'grcmanager') }}</th>
                  <th class="text-end text-nowrap">{{ __('Gaps', 'grcmanager') }}</th>
               </tr>
            </thead>
            <tbody>
            {% for family in families %}
               <tr class="table-light">
                  <th colspan="7" scope="colgroup"><i class="ti {{ family.icon }} me-1" aria-hidden="true"></i>{{ family.label }}</th>
               </tr>
            {% for row in family.rows %}
               {% set label = row.label %}
               {% set a = row.assessment %}
               {% set score_color = a.score is null ? 'secondary' : (a.score >= 80 ? 'green' : (a.score >= 50 ? 'yellow' : 'red')) %}
               <tr{% if detail and detail.key == a.key %} class="table-active"{% endif %}>
                  <td class="fw-bold{{ row.nested ? ' ps-4' : '' }}">{% if row.nested %}<i class="ti ti-corner-down-right me-1 text-muted" aria-hidden="true"></i><span class="visually-hidden">{{ __('National implementation', 'grcmanager') }}: </span>{% endif %}{{ label }}</td>
                  <td>{{ _self.basis_badge(a.basis, bases, a.catalog ?? '') }}</td>
                  {% if a.basis == bases.none %}
                     <td colspan="5" class="text-muted small">
                        <a href="{{ page_url }}?framework={{ a.key|url_encode }}#grc-assessment-gaps">{{ __('Not assessed: ISO 27001 is disabled', 'grcmanager') }}</a>
                     </td>
                  {% else %}
                  <td class="text-end">{{ a.applicable }}</td>
                  <td>{{ _self.rate_bar(a.implementation_rate, 'blue') }}</td>
                  <td>{{ _self.rate_bar(a.evidence_rate, 'azure') }}</td>
                  <td>{{ _self.rate_bar(a.score, score_color) }}</td>
                  <td class="text-end">
                     {% if a.gaps is empty %}
                        <span class="badge bg-green-lt"><i class="ti ti-check me-1"></i>0</span>
                     {% else %}
                        <a class="badge bg-orange-lt" href="{{ page_url }}?framework={{ a.key|url_encode }}#grc-assessment-gaps">
                           <i class="ti ti-list-search me-1"></i>{{ a.gaps|length }}
                        </a>
                     {% endif %}
                  </td>
                  {% endif %}
               </tr>
            {% endfor %}
            {% endfor %}
            </tbody>
         </table>
         </div>
         {% endif %}
      </div>
   </div>

   {% if detail %}
   <div class="card" id="grc-assessment-gaps">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-list-search me-2"></i>{{ __('Gaps for %s', 'grcmanager')|format(detail.label) }}</h3>
         <div class="card-actions">{{ _self.basis_badge(detail.basis, bases, detail.catalog ?? '') }}</div>
      </div>
      <div class="card-body">
         {% if detail.basis == bases.none %}
            <div class="alert alert-warning" role="note">
               <i class="ti ti-alert-triangle me-1"></i>{{ __('The plugin does not track a status of its own for the %1$d measures of %2$s. Their status can only come from the mapping to the ISO 27001 Annex A controls, and ISO 27001 is disabled: this framework is therefore not assessed. Enable ISO 27001 in the configuration to use the mapping, or import the framework as a custom framework to assess its requirements directly.', 'grcmanager')|format(detail.measures, detail.label) }}
            </div>
            <div class="d-flex flex-wrap gap-2">
               <a class="btn btn-sm btn-outline-secondary" href="{{ config_url }}"><i class="ti ti-settings me-1"></i>{{ __('Configure the frameworks', 'grcmanager') }}</a>
               <a class="btn btn-sm btn-outline-secondary" href="{{ custom_url }}"><i class="ti ti-file-spreadsheet me-1"></i>{{ _n('Custom framework', 'Custom frameworks', 2, 'grcmanager') }}</a>
               {% if detail.manage_url %}<a class="btn btn-sm btn-outline-secondary" href="{{ detail.manage_url }}"><i class="ti ti-books me-1"></i>{{ __('See its measures', 'grcmanager') }}</a>{% endif %}
            </div>
            {% if detail.key == nis2_key %}{{ _self.recyf_hint(recyf) }}{% endif %}
         {% else %}
            {% if detail.basis == bases.mapped %}
               <p class="text-muted small">{{ __('%1$d of %2$d applicable measures of this framework are implemented and proven. The plugin does not track their status directly: each one takes the status of the Annex A controls it is mapped to (indicative mapping). Open a mapped control to update it.', 'grcmanager')|format(detail.compliant, detail.applicable) }}</p>
            {% elseif (detail.catalog ?? '') == 'recyf' %}
               <p class="text-muted small">{{ __('NIS2 is assessed on the measures of the ReCyF register of your entity (ANSSI): %1$d of %2$d applicable measures are implemented and proven. Open a measure to update its status or attach evidence in its Documents tab.', 'grcmanager')|format(detail.compliant, detail.applicable) }}</p>
            {% elseif detail.key == iso_key %}
               <p class="text-muted small">{{ __('%1$d of %2$d applicable controls are implemented and proven. Open a control to update its status or attach the missing evidence.', 'grcmanager')|format(detail.compliant, detail.applicable) }}</p>
            {% else %}
               <p class="text-muted small">{{ __('%1$d of %2$d applicable measures of this framework are compliant. Open a measure to update its status.', 'grcmanager')|format(detail.compliant, detail.applicable) }}</p>
            {% endif %}
            {% if detail.key == nis2_key and (detail.catalog ?? '') != 'recyf' %}{{ _self.recyf_hint(recyf) }}{% endif %}
            {% if detail.manage_url %}
               <p><a class="btn btn-sm btn-outline-secondary" href="{{ detail.manage_url }}"><i class="ti ti-books me-1"></i>{{ __('See its measures', 'grcmanager') }}</a></p>
            {% endif %}
            {% if detail.gaps is empty %}
               <p class="text-success mb-0"><i class="ti ti-circle-check me-1"></i>{{ __('No gap: every applicable measure is compliant.', 'grcmanager') }}</p>
            {% else %}
            <div class="table-responsive">
            <table class="table table-sm table-vcenter">
               <thead>
                  <tr>
                     <th>{{ __('Measure', 'grcmanager') }}</th>
                     {% if detail.basis == bases.mapped %}<th>{{ __('Mapped Annex A controls', 'grcmanager') }}</th>{% endif %}
                     <th>{{ __('Status', 'grcmanager') }}</th>
                     <th>{{ __('Evidence', 'grcmanager') }}</th>
                  </tr>
               </thead>
               <tbody>
               {% for gap in detail.gaps %}
                  <tr>
                     <td>
                        {% if gap.url %}<a href="{{ gap.url }}"><code>{{ gap.code }}</code> {{ gap.title }}</a>
                        {% else %}<code>{{ gap.code }}</code> {{ gap.title }}{% endif %}
                     </td>
                     {% if detail.basis == bases.mapped %}
                        <td>{% for control in gap.controls %}<a class="badge bg-blue-lt me-1" href="{{ control.url }}">{{ control.code }}</a>{% endfor %}</td>
                     {% endif %}
                     <td>{{ gap.status_label }}</td>
                     <td>
                        {% if gap.evidence is null %}
                           <span class="text-muted">{{ __('Not tracked', 'grcmanager') }}</span>
                        {% else %}
                           {% set badge = evidence_badges[gap.evidence] %}
                           <span class="badge {{ badge[0] }}"><i class="ti {{ badge[1] }} me-1"></i>{{ badge[2] }}</span>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
            </div>
            {% endif %}
         {% endif %}
      </div>
   </div>
   {% endif %}
</div>
