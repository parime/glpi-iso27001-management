{# Issue #842 : services exposés lus dans Uptime Kuma (A.8.16, A.5.30, A.8.24), actifs des entités de la
   personne. Lecture seule : rien n'est modifié dans Uptime Kuma ; la clé d'API n'est jamais réaffichée. #}
{% macro stat_card(id, icon, color, value, title, help) %}
   <div class="col-sm-6 col-lg"><div class="card card-sm h-100"><div class="card-body">
      <div class="d-flex align-items-center">
         <span class="badge bg-{{ color }}-subtle text-{{ color }}-emphasis me-2 fs-3"><i class="{{ icon }}"></i></span>
         <div>
            <div class="fw-bold fs-3" id="{{ id }}">{{ value }}</div>
            <div class="small">{{ title }}</div>
         </div>
      </div>
      {% if help %}<div class="small text-muted mt-1">{{ help }}</div>{% endif %}
   </div></div></div>
{% endmacro %}
{% macro status_badge(statuses, status) %}
   {% set info = statuses[status] %}
   <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis"><i class="{{ info.icon }} me-1"></i>{{ info.label }}</span>
{% endmacro %}
{% macro cert_badge(cert_infos, monitor) %}
   {% set info = cert_infos[monitor.cert_status] %}
   <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis"><i class="{{ info.icon }} me-1"></i>{{ info.label }}</span>
{% endmacro %}

<div id="grc-kuma">
   {% set av = summary.availability %}
   {% set av_color = av is null ? 'secondary' : (av >= 99.9 ? 'success' : (av >= 99 ? 'warning' : 'danger')) %}
   <div class="row row-cards mb-3">
      {{ _self.stat_card('grc-kuma-availability', 'ti ti-world-check', av_color, av is null ? '-' : av|number_format(2) ~ ' %', __('Availability of the exposed services', 'grcmanager'), __('%1$d monitor(s), over %2$d days', 'grcmanager')|format(summary.monitors, summary.period_days)) }}
      {{ _self.stat_card('grc-kuma-down', 'ti ti-circle-x', summary.down_now > 0 ? 'danger' : 'success', summary.down_now, __('Services down now', 'grcmanager'), __('including %d critical', 'grcmanager')|format(summary.down_critical)) }}
      {{ _self.stat_card('grc-kuma-certs', 'ti ti-certificate', summary.certs_action > 0 ? 'warning' : (summary.certs_total > 0 ? 'success' : 'secondary'), summary.certs_action, __('TLS certificates to renew', 'grcmanager'), __('Expired, not valid or expiring within %d days', 'grcmanager')|format(summary.cert_days)) }}
      {{ _self.stat_card('grc-kuma-exposed', 'ti ti-world-off', summary.exposed_without > 0 ? 'danger' : 'success', summary.exposed_without, __('Exposed assets without a monitor', 'grcmanager'), __('Published on the Internet (network flow matrix)', 'grcmanager')) }}
      {{ _self.stat_card('grc-kuma-rto', 'ti ti-clock-exclamation', summary.rto_gaps > 0 ? 'danger' : 'success', summary.rto_gaps, __('Outages longer than the RTO', 'grcmanager'), __('Recovery time objective of the business processes', 'grcmanager')) }}
   </div>

   {% if not readings %}
      <div class="alert alert-info d-flex align-items-start gap-2 mb-3" id="grc-kuma-empty">
         <i class="ti ti-info-circle fs-2"></i>
         <div>{{ __('Nothing has been read from Uptime Kuma yet: set up the connection in the configuration, then click "Read now".', 'grcmanager') }}</div>
      </div>
   {% elseif last_read.error_label %}
      <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
         <i class="ti ti-alert-triangle fs-2"></i>
         <div>{{ __('The last reading failed: the page shows the previous successful reading.', 'grcmanager') }} {{ last_read.error_label }}</div>
      </div>
   {% endif %}

   {# Sondes : en panne d'abord, critiques en tête. #}
   <div class="card mb-3" id="grc-kuma-monitors">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-heart-rate-monitor me-2"></i>{{ __('Monitored services', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_monitors }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Each monitor of Uptime Kuma is matched with a GLPI asset (computer, network device or appliance) by the monitored host name or by its name. The availability is computed from the status readings of the last %1$d days (each reading of GLPI, and the history of the status pages). An outage of %2$d minutes or more can be turned into a security incident: it is only created when you click.', 'grcmanager')|format(summary.period_days, summary.outage_minutes) }}</div>
      {% if monitors is empty %}
         <div class="card-body text-muted">{{ __('No monitor read in your entities.', 'grcmanager') }}</div>
      {% else %}
         {% if total_monitors > monitors|length %}
            <div class="card-body small pb-0">{{ __('%1$d monitors: the first %2$d are shown, services down first.', 'grcmanager')|format(total_monitors, monitors|length) }}</div>
         {% endif %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Service', 'grcmanager') }}</th>
                  <th>{{ __('Status', 'grcmanager') }}</th>
                  <th>{{ __('Availability', 'grcmanager') }}</th>
                  <th>{{ __('Response time', 'grcmanager') }}</th>
                  <th>{{ __('GLPI asset', 'grcmanager') }}</th>
                  <th>{{ __('Longest outage and RTO', 'grcmanager') }}</th>
                  <th>{{ __('Follow-up', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for monitor in monitors %}
                  <tr>
                     <td>
                        <span class="fw-bold">{{ monitor.name }}</span>
                        <div class="small text-muted text-break">{{ monitor.url ?: monitor.host }}</div>
                        {% if monitor.type %}<span class="badge bg-secondary-subtle text-secondary-emphasis me-1">{{ monitor.type }}</span>{% endif %}
                        {% if monitor.critical %}<span class="badge bg-red-subtle text-red-emphasis me-1"><i class="ti ti-flame me-1"></i>{{ __('Critical', 'grcmanager') }}</span>{% endif %}
                        {% if monitor.exposed %}<span class="badge bg-purple-subtle text-purple-emphasis me-1"><i class="ti ti-world me-1"></i>{{ __('Published on the Internet', 'grcmanager') }}</span>{% endif %}
                     </td>
                     <td>
                        {{ _self.status_badge(statuses, monitor.status) }}
                        {% if monitor.down_since_label %}<div class="small text-danger mt-1">{{ __('Down since %s', 'grcmanager')|format(monitor.down_since_label) }}</div>{% endif %}
                     </td>
                     <td>
                        {% if monitor.availability is null %}
                           <span class="text-muted">-</span>
                        {% else %}
                           {% set m_color = monitor.availability >= 99.9 ? 'success' : (monitor.availability >= 99 ? 'warning' : 'danger') %}
                           <span class="badge bg-{{ m_color }}-subtle text-{{ m_color }}-emphasis">{{ monitor.availability|number_format(2) }} %</span>
                        {% endif %}
                        {% if monitor.uptime_24h is not null %}<div class="small text-muted mt-1">{{ __('24 hours (Uptime Kuma): %s %%', 'grcmanager')|format(monitor.uptime_24h|number_format(2)) }}</div>{% endif %}
                     </td>
                     <td class="small">
                        {{ monitor.avg_response is null ? '-' : __('%d ms on average', 'grcmanager')|format(monitor.avg_response) }}
                     </td>
                     <td>
                        {% if monitor.asset_url %}
                           <a href="{{ monitor.asset_url }}">{{ monitor.asset_name }}</a>
                           <div class="small text-muted">{{ monitor.asset_type }}{% if monitor.entity %} · {{ monitor.entity }}{% endif %}</div>
                        {% else %}
                           <span class="badge bg-orange-subtle text-orange-emphasis"><i class="ti ti-help-hexagon me-1"></i>{{ __('No asset found', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                     <td class="small">
                        {{ monitor.longest_label ?: '-' }}
                        {% for process in monitor.processes %}
                           <div>
                              <a href="{{ process.url }}">{{ process.name }}</a>
                              {% if process.rto %}<span class="text-muted">· RTO {{ process.rto }}</span>{% endif %}
                              {% if process.criticity %}<span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">{{ process.criticity }}</span>{% endif %}
                              {% if process.exceeded %}<span class="badge bg-danger-subtle text-danger-emphasis ms-1"><i class="ti ti-clock-exclamation me-1"></i>{{ __('Outage longer than the RTO', 'grcmanager') }}</span>{% endif %}
                           </div>
                        {% endfor %}
                        {% if can_manage and process_choices is not empty %}
                           <form method="post" action="{{ action }}" class="d-flex gap-1 mt-1">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="uptimekuma_monitor" value="{{ monitor.id }}">
                              <select class="form-select form-select-sm" name="uptimekuma_process" aria-label="{{ __('Business process', 'grcmanager') }}" title="{{ __('Business process that depends on this service', 'grcmanager') }}">
                                 <option value="0">-----</option>
                                 {% for id, name in process_choices %}
                                    <option value="{{ id }}" {{ id == monitor.process_id ? 'selected' }}>{{ name }}</option>
                                 {% endfor %}
                              </select>
                              <button type="submit" class="btn btn-sm btn-outline-primary" name="link_uptimekuma_process" value="1" title="{{ __('Save', 'grcmanager') }}"><i class="ti ti-device-floppy"></i></button>
                           </form>
                        {% endif %}
                     </td>
                     <td>
                        {% if monitor.incident_url %}
                           <a class="badge bg-purple-subtle text-purple-emphasis me-1 mb-1" href="{{ monitor.incident_url }}"><i class="ti ti-shield-exclamation me-1"></i>{{ __('Security incident', 'grcmanager') }}</a>
                           {% if monitor.crisis_url %}<a class="badge bg-blue-subtle text-blue-emphasis me-1 mb-1" href="{{ monitor.crisis_url }}"><i class="ti ti-speakerphone me-1"></i>{{ __('Announce to the users', 'grcmanager') }}</a>{% endif %}
                        {% endif %}
                        {% if monitor.can_propose and can_incident %}
                           <form method="post" action="{{ action }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <button type="submit" class="btn btn-sm btn-outline-danger mb-1" name="uptimekuma_incident" value="{{ monitor.id }}"><i class="ti ti-shield-plus me-1"></i>{{ __('Propose as security incident', 'grcmanager') }}</button>
                           </form>
                        {% endif %}
                        {% if not monitor.incident_url and not (monitor.can_propose and can_incident) %}<span class="text-muted">-</span>{% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Certificats TLS : expirés et proches de l'échéance d'abord. #}
   <div class="card mb-3" id="grc-kuma-certificates">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-certificate me-2"></i>{{ __('TLS certificates', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ certificates|length }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Expiry dates read by Uptime Kuma on the HTTPS monitors. A certificate is flagged %d days before it expires; GLPI never renews a certificate. To be warned, create a risk indicator "TLS certificates to renew (Uptime Kuma)" with an alert threshold.', 'grcmanager')|format(summary.cert_days) }} <a href="{{ kri_url }}">{{ __('Risk indicators', 'grcmanager') }}</a></div>
      {% if certificates is empty %}
         <div class="card-body text-muted">{{ __('No certificate read: certificates are read on the HTTPS monitors, and on a status page only when "Show Certificate Expiry" is enabled on it.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
               <thead><tr><th>{{ __('Service', 'grcmanager') }}</th><th>{{ __('Certificate', 'grcmanager') }}</th><th>{{ __('Days remaining', 'grcmanager') }}</th><th>{{ __('Expires around', 'grcmanager') }}</th><th>{{ __('GLPI asset', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for monitor in certificates %}
                  <tr>
                     <td>{{ monitor.name }}<div class="small text-muted text-break">{{ monitor.url ?: monitor.host }}</div></td>
                     <td>{{ _self.cert_badge(cert_infos, monitor) }}</td>
                     <td>{{ monitor.cert_days is null ? '-' : monitor.cert_days }}</td>
                     <td class="small">{{ monitor.cert_expiry_label ?: '-' }}</td>
                     <td>{% if monitor.asset_url %}<a href="{{ monitor.asset_url }}">{{ monitor.asset_name }}</a>{% else %}<span class="text-muted">-</span>{% endif %}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Actifs publiés sur Internet sans sonde. #}
   <div class="card mb-3" id="grc-kuma-exposed">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-world-off me-2"></i>{{ __('Assets published on the Internet without a monitor', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_exposed }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Assets that receive an "Internet publication" flow in the network flow matrix, but that no Uptime Kuma monitor watches: an outage would only be noticed by the users.', 'grcmanager') }} <a href="{{ flows_url }}">{{ __('Network flow matrix', 'grcmanager') }}</a></div>
      {% if exposed is empty %}
         <div class="card-body text-muted">{{ __('Every asset published on the Internet has a monitor.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
               <thead><tr><th>{{ __('Asset', 'grcmanager') }}</th><th>{{ __('Type', 'grcmanager') }}</th><th>{{ __('Entity', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for asset in exposed %}
                  <tr>
                     <td><a href="{{ asset.url }}">{{ asset.name }}</a> <span class="badge bg-danger-subtle text-danger-emphasis ms-1"><i class="ti ti-eye-off me-1"></i>{{ __('Not monitored', 'grcmanager') }}</span></td>
                     <td class="small">{{ asset.type }}</td>
                     <td class="small text-muted">{{ asset.entity }}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Dernière lecture et lecture sur clic ; la connexion se règle dans la configuration (issue #1042). #}
   <div class="card mb-3" id="grc-kuma-connection">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-plug-connected me-2"></i>{{ __('Connection to Uptime Kuma (read only)', 'grcmanager') }}</h3>
         <div class="card-actions">
            {% if connection.configured %}
               <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
            {% else %}
               <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-x me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
            {% endif %}
         </div>
      </div>
      <div class="card-body">
         <p class="small mb-2">
            {% if last_read.date_label %}
               <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('Last reading: %s', 'grcmanager')|format(last_read.date_label) }}</span>
               {{ __('%1$d monitor(s), %2$d status page(s).', 'grcmanager')|format(last_read.monitors, last_read.pages) }}
               {% if last_read.truncated %}<span class="badge bg-warning-subtle text-warning-emphasis ms-1">{{ __('Only the first monitors were read', 'grcmanager') }}</span>{% endif %}
            {% else %}
               {{ __('No reading yet.', 'grcmanager') }}
            {% endif %}
            {% if last_read.error_label %}<span class="d-block text-danger mt-1"><i class="ti ti-alert-triangle me-1"></i>{{ last_read.error_label }}</span>{% endif %}
         </p>
         <p class="small mb-2">
            <span class="badge bg-secondary-subtle text-secondary-emphasis me-1">{{ __('%d days', 'grcmanager')|format(settings.period_days) }}</span>
            <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-certificate me-1"></i>{{ __('%d days', 'grcmanager')|format(settings.cert_days) }}</span>
            <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('%d minutes', 'grcmanager')|format(settings.outage_minutes) }}</span>
            <span class="badge {{ connection.enabled ? 'bg-success-subtle text-success-emphasis' : 'bg-secondary-subtle text-secondary-emphasis' }}"><i class="ti ti-refresh me-1"></i>{{ connection.enabled ? __('Read automatically every hour', 'grcmanager') : __('Read on click only', 'grcmanager') }}</span>
         </p>
         <div class="d-flex flex-wrap gap-2">
            {% if can_manage %}
               <form method="post" action="{{ action }}" class="d-flex flex-wrap gap-2">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  {% if connection.configured %}
                     <button type="submit" class="btn btn-primary" name="read_uptimekuma" value="1"><i class="ti ti-refresh me-1"></i>{{ __('Read now', 'grcmanager') }}</button>
                  {% endif %}
                  {% if readings %}
                     <button type="submit" class="btn btn-outline-danger" name="clear_uptimekuma" value="1"><i class="ti ti-trash me-1"></i>{{ __('Delete the readings', 'grcmanager') }}</button>
                  {% endif %}
               </form>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ connector_url }}" id="grc-kuma-settings"><i class="ti ti-settings me-1"></i>{{ __('Set up the connection', 'grcmanager') }}</a>
         </div>
      </div>
   </div>

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted small me-auto"><i class="ti ti-lock me-1"></i>{{ __('Read only: nothing is ever changed in Uptime Kuma from GLPI, and no certificate is renewed.', 'grcmanager') }}</span>
      <a class="btn btn-sm btn-outline-secondary" href="{{ processes_url }}"><i class="ti ti-building-factory-2 me-1"></i>{{ __('Business processes', 'grcmanager') }}</a>
      <a class="btn btn-sm btn-outline-primary" href="{{ audit_url }}"><i class="ti ti-shield-check me-1"></i>{{ __('Technical security', 'grcmanager') }}</a>
   </div>
</div>
