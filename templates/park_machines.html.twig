{# Issue #181 : machines les plus exposées aux vulnérabilités de leurs logiciels surveillés #}
<div class="container-fluid">
   {% if rows is empty %}
      <div class="alert alert-info">
         <i class="ti ti-info-circle me-1"></i>{{ __('No machine has a known vulnerability among the watched software.', 'grcmanager') }}
      </div>
   {% else %}
      <p class="text-muted">
         {{ __('Exposure score from 0 to 100: the most severe vulnerability (10 if it is actively exploited) counts for 70%, the number of priority vulnerabilities for 30%. It is an order of treatment, not a standardised measure.', 'grcmanager') }}
      </p>
      <table class="table table-sm table-hover align-middle">
         <thead>
            <tr>
               <th>{{ __('Machine', 'grcmanager') }}</th>
               <th>{{ __('Type', 'grcmanager') }}</th>
               <th class="text-end">{{ _x('score', 'Score', 'grcmanager') }}</th>
               <th class="text-end">{{ __('Exploited (KEV)', 'grcmanager') }}</th>
               <th class="text-end">{{ __('Priority', 'grcmanager') }}</th>
               <th class="text-end">{{ __('Vulnerabilities', 'grcmanager') }}</th>
               <th class="text-end">{{ __('Max CVSS', 'grcmanager') }}</th>
               <th class="text-end">{{ __('Max EPSS', 'grcmanager') }}</th>
            </tr>
         </thead>
         <tbody>
            {% for r in rows %}
               {% set color = r.score >= 80 ? 'bg-red-lt' : (r.score >= 50 ? 'bg-orange-lt' : 'bg-secondary-lt') %}
               <tr>
                  <td><a href="{{ r.url }}">{{ r.name }}</a></td>
                  <td>{{ r.type }}</td>
                  <td class="text-end"><span class="badge {{ color }}">{{ r.score }}</span></td>
                  <td class="text-end">{% if r.kev > 0 %}<span class="badge bg-red-lt">{{ r.kev }}</span>{% else %}0{% endif %}</td>
                  <td class="text-end">{{ r.priority }}</td>
                  <td class="text-end">{{ r.cves }}</td>
                  <td class="text-end">{{ r.max_cvss is not null ? r.max_cvss|number_format(1) : '—' }}</td>
                  <td class="text-end">{{ r.max_epss is not null ? (r.max_epss * 100)|round ~ ' %' : '—' }}</td>
               </tr>
            {% endfor %}
         </tbody>
      </table>
      {% if total > rows|length %}
         <p class="text-muted small">{{ __('%1$d machines shown out of %2$d exposed machines.', 'grcmanager')|format(rows|length, total) }}</p>
      {% endif %}
   {% endif %}
</div>
