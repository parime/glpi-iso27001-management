{# Formation / sensibilisation, A.6.3 (issue #199 : formulaire passé de PHP à Twig ; issue #139 : notes et seuil de réussite) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {% if is_retake %}
      <div class="col-12 mb-3">
         <div class="alert alert-info mb-0">
            <i class="ti ti-repeat me-1"></i>
            {{ __('Proposed retake session: participants who failed are preselected. Check the date and the list, then click "Add". Nothing is saved before that.', 'grcmanager') }}
         </div>
      </div>
   {% endif %}
   {% if is_new_session %}
      <div class="col-12 mb-3">
         <div class="alert alert-info mb-0">
            <i class="ti ti-calendar-plus me-1"></i>
            {{ __('New session of this training: fill in its date, trainer, location and participants, then click "Add". Nothing is saved before.', 'grcmanager') }}
         </div>
      </div>
   {% endif %}
   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.dropdownArrayField('plugin_grcmanager_trainings_id', item.fields['plugin_grcmanager_trainings_id'] ?: 0, main_trainings, __('Session of the training', 'grcmanager'), {
      'add_field_html': main_url ? '<a href="' ~ main_url|e('html_attr') ~ '" class="ms-2"><i class="ti ti-arrow-up-right"></i> ' ~ __('View the training', 'grcmanager')|e ~ '</a>' : '',
   }) }}
   {{ fields.dropdownField('User', 'users_id_trainer', item.fields['users_id_trainer'], __('Trainer', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.textField('location', item.fields['location'], __('Location or link', 'grcmanager'), {
      'add_field_html': hints.hint(__('Room, address or link to the video call / online module.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('format', item.fields['format'] ?: 'in_person', formats, __('Format', 'grcmanager')) }}
   {{ fields.dateField('date_delivered', item.fields['date_delivered'], __('Completion date', 'grcmanager')) }}
   {{ fields.textField('target_audience', item.fields['target_audience'], __('Target audience', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Free text (e.g. "All staff", "Technical team", the name of a group or department).', 'grcmanager')),
   }) }}
   {{ fields.checkboxField('is_mandatory', is_mandatory, __('Mandatory', 'grcmanager')) }}
   {{ fields.numberField('renewal_period_months', item.fields['renewal_period_months'] ?: 0, __('Renewal (months)', 'grcmanager'), {
      'min': 0,
      'add_field_html': hints.hint(__('0 = no renewal required.', 'grcmanager')),
   }) }}
   {{ fields.numberField('max_score', item.fields['max_score'] ?: 0, __('Maximum quiz score', 'grcmanager'), {
      'min': 0,
      'add_field_html': hints.hint(__('E.g. 40 for a quiz scored out of 40. 0 = no score.', 'grcmanager')),
   }) }}
   {{ fields.numberField('pass_threshold', item.fields['pass_threshold'] ?: 0, __('Pass threshold (%)', 'grcmanager'), {
      'min': 0,
      'max': 100,
      'add_field_html': hints.hint(__('E.g. 80: passed from 80% of the maximum score. With a maximum score and a threshold, each participant\'s result is computed from their score.', 'grcmanager')),
   }) }}
   {{ fields.textareaField('description', item.fields['description'], __('Description', 'grcmanager'), {'full_width': true}) }}
   {{ fields.dropdownField('User', 'participants', participant_ids, __('Participants', 'grcmanager'), {
      'multiple': true,
      'right': 'all',
      'full_width': true,
      'add_field_html': hints.hint(__('Save to add the newly selected participants: their individual tracking appears below once saved.', 'grcmanager')),
   }) }}

   {% if participants is not empty %}
      <div class="col-12 mb-2 d-flex flex-wrap align-items-center gap-2">
         {% if session_rate.rate is not null %}
            <span class="badge {{ session_rate.rate >= 80 ? 'bg-green-lt' : (session_rate.rate >= 50 ? 'bg-yellow-lt' : 'bg-red-lt') }} fs-4">
               <i class="ti ti-certificate me-1"></i>
               {{ __('Session pass rate: %1$s out of %2$s (%3$s %%)', 'grcmanager')|format(session_rate.passed, session_rate.assessed, session_rate.rate) }}
            </span>
         {% endif %}
         <a href="{{ report_url }}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Session PDF report', 'grcmanager') }}</a>
         {% if retake_count > 0 %}
            <a href="{{ retake_url }}" class="btn btn-outline-primary btn-sm">
               <i class="ti ti-repeat me-1"></i>{{ _n('Prepare a retake session (%s participant)', 'Prepare a retake session (%s participants)', retake_count, 'grcmanager')|format(retake_count) }}
            </a>
         {% endif %}
      </div>
      <div class="col-12 mb-3">
         <table class="table card-table">
            <thead>
               <tr>
                  <th>{{ user_label }}</th>
                  <th>{{ __('Completion status', 'grcmanager') }}</th>
                  <th>{{ __('Completion date', 'grcmanager') }}</th>
                  {% if is_scored %}<th>{{ __('Score', 'grcmanager') }}</th>{% endif %}
                  <th>{{ __('Assessment', 'grcmanager') }}</th>
               </tr>
            </thead>
            <tbody>
               {% for p in participants %}
                  <tr>
                     <td>{{ p.name }}</td>
                     <td>
                        <select name="participant_status[{{ p.users_id }}]" class="form-select" aria-label="{{ __('Completion status', 'grcmanager') }} — {{ p.name }}">
                           {% for value, label in completion_statuses %}<option value="{{ value }}" {{ value == p.completion_status ? 'selected' }}>{{ label }}</option>{% endfor %}
                        </select>
                     </td>
                     <td><input type="date" name="participant_date[{{ p.users_id }}]" value="{{ p.completion_date ? p.completion_date|slice(0, 10) }}" class="form-control" aria-label="{{ __('Completion date', 'grcmanager') }} — {{ p.name }}"></td>
                     {% if is_scored %}
                        <td style="min-width: 170px;">
                           <div class="input-group">
                              <input type="text" inputmode="decimal" name="participant_score[{{ p.users_id }}]" value="{{ p.score_input }}" class="form-control" style="max-width: 90px;" aria-label="{{ __('Score', 'grcmanager') }} — {{ p.name }}">
                              <span class="input-group-text">/ {{ item.fields['max_score'] }}</span>
                           </div>
                           {% if p.score_label %}<div class="text-muted small mt-1">{{ p.score_label }}</div>{% endif %}
                        </td>
                        <td>
                           {# Calculé depuis la note : le choix manuel est conservé si aucune note n'est saisie. #}
                           <input type="hidden" name="participant_result[{{ p.users_id }}]" value="{{ p.assessment_result }}">
                           {% if p.assessment_result == 'passed' %}
                              <span class="badge bg-green-lt"><i class="ti ti-check me-1"></i>{{ assessment_results['passed'] }}</span>
                           {% elseif p.assessment_result == 'failed' %}
                              <span class="badge bg-red-lt"><i class="ti ti-repeat me-1"></i>{{ __('To retake', 'grcmanager') }}</span>
                           {% else %}
                              <span class="text-muted">{{ __('Enter the score', 'grcmanager') }}</span>
                           {% endif %}
                        </td>
                     {% else %}
                        <td>
                           <select name="participant_result[{{ p.users_id }}]" class="form-select" aria-label="{{ __('Assessment', 'grcmanager') }} — {{ p.name }}">
                              {% for value, label in assessment_results %}<option value="{{ value }}" {{ value == p.assessment_result ? 'selected' }}>{{ label }}</option>{% endfor %}
                           </select>
                        </td>
                     {% endif %}
                  </tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}
{% endblock %}
