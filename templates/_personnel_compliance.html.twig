{# Issue #546 : badge d'état et composantes d'une fiche de conformité sécurité (onglet et liste). #}
{% macro state_badge(state) %}
   <span class="badge bg-{{ state.color }}-subtle text-{{ state.color }}-emphasis"><i class="{{ state.icon }} me-1"></i>{{ state.label }}</span>
{% endmacro %}

{% macro components_table(row) %}
   <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
         <thead>
            <tr>
               <th>{{ __('Component', 'grcmanager') }}</th>
               <th>{{ __('Status', 'grcmanager') }}</th>
               <th>{{ __('Detail', 'grcmanager') }}</th>
               <th>{{ __('Due date', 'grcmanager') }}</th>
               <th class="text-end">{{ __('Weight', 'grcmanager') }}</th>
            </tr>
         </thead>
         <tbody>
            {% for c in row.components %}
               <tr>
                  <td>
                     <i class="{{ c.icon }} me-1 text-muted"></i>{{ c.label }}
                     <span class="badge bg-blue-subtle text-blue-emphasis ms-1">{{ c.reference }}</span>
                  </td>
                  <td><span class="badge bg-{{ c.state.color }}-subtle text-{{ c.state.color }}-emphasis"><i class="{{ c.state.icon }} me-1"></i>{{ c.state.label }}</span></td>
                  <td>{{ c.detail }}</td>
                  <td>
                     {% if c.deadline_text %}
                        {{ c.deadline_text }}
                        {% if c.soon %}<span class="badge bg-warning-subtle text-warning-emphasis ms-1"><i class="ti ti-calendar-due me-1"></i>{{ __('Soon', 'grcmanager') }}</span>{% endif %}
                     {% endif %}
                  </td>
                  <td class="text-end">{{ c.weight }}</td>
               </tr>
            {% endfor %}
         </tbody>
      </table>
   </div>
{% endmacro %}
