{# Campagne de revue des accès, A.5.18 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
   {{ fields.textField('name', item.fields['name'], __('Nom'), {
      'full_width': true,
      'additional_attributes': {'placeholder': __('E.g.: Access review Q4 2026', 'grcmanager')},
   }) }}
   {{ fields.dropdownArrayField('frequency', item.fields['frequency'] ?: 'annual', frequencies, __('Frequency', 'grcmanager')) }}
   {{ fields.htmlField('', '<span class="badge ' ~ status_class ~ '">' ~ status_label|e ~ '</span>', __('Status', 'grcmanager')) }}
   {{ fields.dateField('date_start', date_start, __('Start date', 'grcmanager')) }}
   {{ fields.dateField('due_date', due_date, __('Due date', 'grcmanager')) }}
   {{ fields.dropdownField('User', 'users_id', pilot, _x('process pilot', 'Owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dropdownArrayField('plugin_grcmanager_controls_id', control_id, controls, __('SoA control', 'grcmanager')) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comment', 'grcmanager'), {'full_width': true}) }}
   {% if is_new %}
      <div class="col-12 mb-3 text-muted small"><i class="ti ti-info-circle me-1"></i>{{ __('Once saved, open the "Accounts to review" tab to launch the campaign. Reviewers are notified; the plugin never changes any right.', 'grcmanager') }}</div>
   {% endif %}
{% endblock %}
