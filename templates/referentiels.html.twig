{# ROADMAP.md "Version 2.2" (bibliothèque de contrôles étendue) : 3 bibliothèques de référence
   purement consultables (Annexe A ISO 27001, NIST CSF 2.0, CIS Controls v8) — voir
   front/referentiels.php pour la construction des données et
   GlpiPlugin\Grcmanager\Services\Control\{NistCsfCatalogDefaults,CisControlsCatalogDefaults,
   ControlCrosswalkDefaults} pour leur source. Rien n'est éditable ici : un admin gère
   l'applicabilité/le statut de l'Annexe A depuis son propre écran (Contrôles), cette page ne fait
   que consulter et faire le lien entre référentiels. #}

<div class="text-muted mb-3">
  {{ __('Consultable reference libraries, alongside your Statement of Applicability (ISO 27001 Annex A).', 'grcmanager') }}
</div>

<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">{{ __('ISO 27001 Annex A / ISO 27002', 'grcmanager') }}</h3>
    <input type="search" class="form-control form-control-sm w-auto grcmanager-ref-filter"
           data-target="grcmanager-annexa-table" placeholder="{{ __('Filter…', 'grcmanager') }}">
  </div>
  <div class="table-responsive">
    <table class="table table-vcenter card-table" id="grcmanager-annexa-table">
      <thead>
        <tr>
          <th>{{ __('Code') }}</th>
          <th>{{ __('Theme', 'grcmanager') }}</th>
          <th>{{ __('Intitulé') }}</th>
          <th>{{ __('Equivalent NIST CSF 2.0', 'grcmanager') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for control in annex_a %}
          <tr>
            <td>
              {% if control.id %}
                <a href="{{ path('/plugins/grcmanager/front/control.form.php') }}?id={{ control.id }}">{{ control.code }}</a>
              {% else %}
                {{ control.code }}
              {% endif %}
            </td>
            <td>{{ control.theme }}</td>
            <td>{{ control.title }}</td>
            <td>
              {% for nist_code in control.crosswalk %}
                <span class="badge bg-blue-lt">{{ nist_code }}</span>
              {% endfor %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">{{ __('NIST Cybersecurity Framework (CSF) 2.0', 'grcmanager') }}</h3>
    <input type="search" class="form-control form-control-sm w-auto grcmanager-ref-filter"
           data-target="grcmanager-nist-body" placeholder="{{ __('Filter…', 'grcmanager') }}">
  </div>
  <div class="card-body" id="grcmanager-nist-body">
    {% for function in nist_csf %}
      <details class="mb-2">
        <summary class="fw-bold">{{ function.code }} — {{ function.name }}</summary>
        {% for category in function.categories %}
          <div class="ms-3 mt-2">
            <div class="text-muted small mb-1">{{ category.code }} — {{ category.name }}</div>
            <table class="table table-sm">
              <tbody>
                {% for sub in category.subcategories %}
                  <tr>
                    <td class="text-nowrap"><code>{{ sub.code }}</code></td>
                    <td>{{ sub.text }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endfor %}
      </details>
    {% endfor %}
  </div>
</div>

<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">{{ __('CIS Controls v8', 'grcmanager') }}</h3>
    <input type="search" class="form-control form-control-sm w-auto grcmanager-ref-filter"
           data-target="grcmanager-cis-body" placeholder="{{ __('Filter…', 'grcmanager') }}">
  </div>
  <div class="card-body" id="grcmanager-cis-body">
    {% for control in cis_controls %}
      <details class="mb-2">
        <summary class="fw-bold">{{ control.number }}. {{ control.name }}</summary>
        <table class="table table-sm ms-3 mt-2">
          <tbody>
            {% for safeguard in control.safeguards %}
              <tr>
                <td class="text-nowrap"><code>{{ safeguard.code }}</code></td>
                <td>{{ safeguard.text }}</td>
                <td class="text-nowrap"><span class="badge bg-secondary-lt">IG{{ safeguard.ig }}</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </details>
    {% endfor %}
  </div>
  {# Mention de source exigée par la licence CC BY-NC-ND 4.0 des CIS Controls — voir le docblock de
     CisControlsCatalogDefaults et la section « Avertissement » du README. #}
  <div class="card-footer text-muted small">
    <i class="ti ti-license me-1"></i>
    {{ __('Source: CIS Critical Security Controls® v8, © Center for Internet Security, Inc., titles reproduced unmodified under the CC BY-NC-ND 4.0 license. This project is not affiliated with or endorsed by CIS.', 'grcmanager') }}
    <a href="https://www.cisecurity.org/controls" target="_blank" rel="noopener noreferrer">cisecurity.org/controls</a>
    · <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-ND 4.0</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">{{ __('NIS2 Directive (EU) 2022/2555', 'grcmanager') }}</h3>
    <input type="search" class="form-control form-control-sm w-auto grcmanager-ref-filter"
           data-target="grcmanager-nis2-body" placeholder="{{ __('Filter…', 'grcmanager') }}">
  </div>
  <div class="card-body" id="grcmanager-nis2-body">
    {% for article in nis2 %}
      <details class="mb-2"{% if article.article == '21' %} open{% endif %}>
        <summary class="fw-bold">{{ __('Article', 'grcmanager') }} {{ article.article }} — {{ article.title }}</summary>
        <table class="table table-sm ms-3 mt-2">
          <tbody>
            {% for requirement in article.requirements %}
              <tr>
                <td class="text-nowrap"><code>{{ requirement.reference }}</code></td>
                <td>
                  {{ requirement.text }}
                  {% if requirement.summary %}
                    <span class="badge bg-secondary-lt ms-1">{{ __('summary', 'grcmanager') }}</span>
                  {% endif %}
                </td>
                <td>
                  {% for control in requirement.controls %}
                    {% if control.id %}
                      <a class="badge bg-azure-lt" href="{{ path('/plugins/grcmanager/front/control.form.php') }}?id={{ control.id }}">{{ control.code }}</a>
                    {% else %}
                      <span class="badge bg-azure-lt">{{ control.code }}</span>
                    {% endif %}
                  {% endfor %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </details>
    {% endfor %}
  </div>
  {# Mention de source exigée pour la réutilisation des textes EUR-Lex (décision 2011/833/UE) :
     voir le docblock de Nis2CatalogDefaults et la section « Avertissement » du README. #}
  <div class="card-footer text-muted small">
    <i class="ti ti-license me-1"></i>
    {{ __('Source: Directive (EU) 2022/2555 (NIS2), © European Union, EUR-Lex. Mapping to ISO 27001 Annex A is indicative and made by this project.', 'grcmanager') }}
    <a href="{{ nis2_source }}" target="_blank" rel="noopener noreferrer">eur-lex.europa.eu</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">{{ __('ANSSI IT hygiene guide (42 measures)', 'grcmanager') }}</h3>
    <input type="search" class="form-control form-control-sm w-auto grcmanager-ref-filter"
           data-target="grcmanager-anssi-body" placeholder="{{ __('Filter…', 'grcmanager') }}">
  </div>
  <div class="card-body" id="grcmanager-anssi-body">
    {% for theme in anssi %}
      <details class="mb-2">
        <summary class="fw-bold">{{ theme.code }} — {{ theme.title }}
          <span class="badge bg-secondary-lt ms-1">{{ theme.measures|length }}</span></summary>
        <table class="table table-sm ms-3 mt-2">
          <tbody>
            {% for measure in theme.measures %}
              <tr>
                <td class="text-nowrap"><span class="badge bg-teal-lt">{{ measure.number }}</span></td>
                <td>{{ measure.text }}</td>
                <td>
                  {% for control in measure.controls %}
                    {% if control.id %}
                      <a class="badge bg-azure-lt" href="{{ path('/plugins/grcmanager/front/control.form.php') }}?id={{ control.id }}">{{ control.code }}</a>
                    {% else %}
                      <span class="badge bg-azure-lt">{{ control.code }}</span>
                    {% endif %}
                  {% else %}
                    <span class="text-muted small">{{ __('ISO 27001 §6.1 (outside Annex A)', 'grcmanager') }}</span>
                  {% endfor %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </details>
    {% endfor %}
  </div>
  {# Mention de paternité exigée par la Licence Ouverte (Etalab) — voir le docblock de
     AnssiHygieneCatalogDefaults et la section « Avertissement » du README. #}
  <div class="card-footer text-muted small">
    <i class="ti ti-license me-1"></i>
    {{ __('Source: ANSSI, Guide d\'hygiène informatique (IT hygiene guide), version 2.0, September 2017, Licence Ouverte / Open Licence (Etalab). Mapping to ISO 27001 Annex A is indicative and made by this project.', 'grcmanager') }}
    {% if anssi_lang != 'fr' %}
      {{ __('Indicative English translation made by this project.', 'grcmanager') }}
    {% endif %}
    <a href="{{ anssi_source }}" target="_blank" rel="noopener noreferrer">cyber.gouv.fr</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">{{ __('ISO/IEC 27090:2026 — Security of AI systems', 'grcmanager') }}</h3>
    <input type="search" class="form-control form-control-sm w-auto grcmanager-ref-filter"
           data-target="grcmanager-iso27090-body" placeholder="{{ __('Filter…', 'grcmanager') }}">
  </div>
  <div class="card-body" id="grcmanager-iso27090-body">
    <p class="text-muted small">{{ __('Guidance, not certifiable, to be applied alongside ISO/IEC 27001 and ISO/IEC 42001. The typical AI risks of the risk catalog refer to these sections.', 'grcmanager') }}</p>
    {% for chapter in iso27090 %}
      <details class="mb-2"{% if chapter.chapter == '6' %} open{% endif %}>
        <summary class="fw-bold">{{ chapter.chapter }} — {{ chapter.title }}</summary>
        <table class="table table-sm ms-3 mt-2">
          <tbody>
            {% for topic in chapter.topics %}
              <tr>
                <td class="text-nowrap"><code>{{ topic.code }}</code></td>
                <td>{{ topic.text }}</td>
                <td>
                  {% for control in topic.controls %}
                    {% if control.id %}
                      <a class="badge bg-azure-lt" href="{{ path('/plugins/grcmanager/front/control.form.php') }}?id={{ control.id }}">{{ control.code }}</a>
                    {% else %}
                      <span class="badge bg-azure-lt">{{ control.code }}</span>
                    {% endif %}
                  {% endfor %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </details>
    {% endfor %}
  </div>
  {# Texte de la norme protégé (© ISO/IEC 2026) : numéros de section seulement, objet résumé par ce
     projet — voir le docblock d'Iso27090CatalogDefaults. #}
  <div class="card-footer text-muted small">
    <i class="ti ti-license me-1"></i>
    {{ __('ISO/IEC 27090:2026 is protected by copyright: only its section numbers are used here; summaries and the mapping to ISO 27001 Annex A are written by this project, which is not affiliated with ISO or IEC.', 'grcmanager') }}
    <a href="{{ iso27090_source }}" target="_blank" rel="noopener noreferrer">iso.org</a>
  </div>
</div>

<script>
  document.querySelectorAll('.grcmanager-ref-filter').forEach(function (input) {
    input.addEventListener('input', function () {
      var query = input.value.toLowerCase();
      var target = document.getElementById(input.dataset.target);
      if (!target) {
        return;
      }
      target.querySelectorAll('tr').forEach(function (row) {
        if (row.querySelector('th')) {
          return;
        }
        row.hidden = query.length > 0 && !row.textContent.toLowerCase().includes(query);
      });
      target.querySelectorAll('details').forEach(function (details) {
        var hasVisibleRow = Array.prototype.some.call(
          details.querySelectorAll('tr'),
          function (row) { return !row.hidden; }
        );
        details.hidden = query.length > 0 && !hasVisibleRow;
        if (query.length > 0 && hasVisibleRow) {
          details.open = true;
        }
      });
    });
  });
</script>
