    title: custom.title ~ ' (' ~ __('custom framework', 'grcmanager') ~ ')',
    intro: __('Framework imported by your organisation from a file. Each requirement shows the ISO 27001 Annex A controls that meet it: they give its compliance rate on the dashboard.', 'grcmanager'),
    footer: __('Content provided by your organisation, imported in this plugin.', 'grcmanager'),
  }) }}
{% endfor %}
<div class="card card-sm mb-3">
  <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div><i class="ti ti-file-spreadsheet me-1 text-indigo"></i>{{ __('An internal, sector or contractual framework is missing? Import it from a spreadsheet.', 'grcmanager') }}</div>
    <a href="{{ custom_frameworks_url }}" class="btn btn-sm btn-outline-primary"><i class="ti ti-file-import me-1"></i>{{ can_import_framework ? __('Import a custom framework', 'grcmanager') : __('Custom frameworks', 'grcmanager') }}</a>
  </div>
</div>

<script>
  document.querySelectorAll('.grcmanager-ref-filter').forEach(function (input) {
    input.addEventListener('input', function () {
      var query = input.value.toLowerCase();
      var target = document.getElementById(input.dataset.target);
      if (!target) {
        return;
      }
      target.querySelectorAll('tr').forEach(function (row) {
        if (row.querySelector('th')) {
          return;
        }
        row.hidden = query.length > 0 && !row.textContent.toLowerCase().includes(query);
      });
      target.querySelectorAll('details').forEach(function (details) {
        var hasVisibleRow = Array.prototype.some.call(
          details.querySelectorAll('tr'),
          function (row) { return !row.hidden; }
        );
        details.hidden = query.length > 0 && !hasVisibleRow;
        if (query.length > 0 && hasVisibleRow) {
          details.open = true;
        }
      });
    });
  });
</script>
