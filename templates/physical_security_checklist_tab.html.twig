{# Issue #778 : onglet « Grille de sécurité physique » d'une évaluation : une ligne par mesure A.7.1 à
   A.7.14 (état, constat, preuves, action CAPA), avec l'état de l'évaluation précédente du site. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set v = {'is_horizontal': false} %}

<div class="card" id="grc-physical-checklist">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-list-check me-2"></i>{{ __('Physical security checklist', 'grcmanager') }}</h3>
      <div class="card-actions d-flex flex-wrap gap-1 align-items-center">
         <span class="badge bg-blue-subtle text-blue-emphasis" id="grc-physical-progress"><i class="ti ti-chart-pie me-1"></i>{{ __('%1$d of %2$d controls assessed', 'grcmanager')|format(summary.assessed, summary.total) }}</span>
         {% if summary.score is not null %}
            <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-gauge me-1"></i>{{ __('Score: %d%%', 'grcmanager')|format(summary.score) }}</span>
         {% endif %}
         {% for key, state in states %}
            {% if summary.counts[key] > 0 and key != 'not_assessed' %}
               <span class="badge {{ state[1] }}"><i class="ti {{ state[2] }} me-1"></i>{{ __('%1$s: %2$d', 'grcmanager')|format(state[0], summary.counts[key]) }}</span>
            {% endif %}
         {% endfor %}
      </div>
   </div>
   <div class="card-body">
      <p class="text-muted small mb-2">
         <i class="ti ti-info-circle me-1"></i>{{ __('For each control, walk through the site and record what you see: the state, the finding (what is missing or wrong) and the evidence (text, and photos or reports added to the "Documents" tab). For a partially compliant or non-compliant control, "Create the action" opens a pre-filled non-conformity that you review and save yourself.', 'grcmanager') }}
      </p>
      <div class="table-responsive">
      <table class="table table-sm table-vcenter card-table" id="grc-physical-lines">
         <thead>
            <tr>
               <th>{{ __('Control', 'grcmanager') }}</th>
               <th>{{ __('State', 'grcmanager') }}</th>
               <th>{{ __('Finding', 'grcmanager') }}</th>
               <th>{{ __('Evidence', 'grcmanager') }}</th>
               <th>{{ __('Action', 'grcmanager') }}</th>
            </tr>
         </thead>
         <tbody>
         {% for row in rows %}
            <tr id="grc-physical-line-{{ row.id }}" class="grc-physical-row grc-physical-state-{{ row.state }}">
               <td>
                  <div class="fw-bold text-nowrap">{{ row.code }}</div>
                  <div class="small">{{ row.title }}</div>
               </td>
               <td>
                  <span class="badge {{ row.state_class }} grc-physical-badge"><i class="ti {{ row.state_icon }} me-1"></i>{{ row.state_label }}</span>
                  {% if row.previous is not null %}
                     <div class="text-muted small mt-1" title="{{ __('State at the previous assessment of the site', 'grcmanager') }}"><i class="ti ti-history me-1"></i>{{ row.previous[0] }}</div>
                  {% endif %}
               </td>
               <td>{% if row.finding %}<div class="small">{{ row.finding|nl2br }}</div>{% else %}<span class="text-muted small">-</span>{% endif %}</td>
               <td>
                  {% if row.evidence %}<div class="small">{{ row.evidence|nl2br }}</div>{% endif %}
                  {% for doc in row.documents %}
                     <div class="text-nowrap small"><i class="ti ti-paperclip me-1"></i><a href="{{ doc.url }}">{{ doc.name }}</a></div>
                  {% endfor %}
                  {% if not row.evidence and row.documents is empty %}<span class="text-muted small">-</span>{% endif %}
               </td>
               <td>
                  {% if row.finding_id %}
                     <a href="{{ row.finding_url }}" class="grc-physical-finding"><i class="ti ti-alert-hexagon me-1"></i>{{ row.finding_title }}</a>
                     {% if row.finding_status %}<div class="text-muted small">{{ row.finding_status }}</div>{% endif %}
                  {% elseif row.can_raise and can_create_finding %}
                     <a href="{{ finding_url }}?physicalsecuritycheck={{ row.id }}" class="btn btn-sm btn-outline-danger grc-physical-raise"><i class="ti ti-alert-hexagon me-1"></i>{{ __('Create the action', 'grcmanager') }}</a>
                  {% elseif row.can_raise %}
                     <span class="badge bg-yellow-subtle text-yellow-emphasis"><i class="ti ti-hourglass me-1"></i>{{ __('No action yet', 'grcmanager') }}</span>
                  {% else %}
                     <span class="text-muted small">-</span>
                  {% endif %}
               </td>
            </tr>
            {% if can_edit %}
            <tr class="grc-physical-edit-row">
               <td colspan="5" class="border-top-0 pt-0">
                  <details class="grc-physical-edit"{% if loop.first and summary.assessed == 0 %} open{% endif %}>
                     <summary class="btn btn-sm btn-ghost-secondary"><i class="ti ti-pencil me-1"></i>{{ __('Fill in', 'grcmanager') }}</summary>
                     <form method="post" action="{{ action }}" class="row g-2 mt-1">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="plugin_grcmanager_physicalsecurityassessments_id" value="{{ assessment_id }}">
                        <input type="hidden" name="id" value="{{ row.id }}">
                        {{ fields.dropdownArrayField('state', row.state, state_labels, __('State', 'grcmanager'), v|merge({'field_class': 'col-md-4', 'rand': 'grcpsstate' ~ row.id})) }}
                        {% if documents is not empty %}
                           {{ fields.dropdownArrayField('documents', null, documents, __('Documents of the assessment', 'grcmanager'), v|merge({'field_class': 'col-md-8', 'multiple': true, 'values': row.document_ids, 'rand': 'grcpsdoc' ~ row.id})) }}
                        {% else %}
                           <div class="col-md-8 form-hint align-self-center">{{ __('Add photos or reports to the "Documents" tab of the assessment to cite them here.', 'grcmanager') }}</div>
                        {% endif %}
                        {{ fields.textareaField('finding', row.finding, __('Finding', 'grcmanager'), v|merge({'field_class': 'col-md-6', 'rows': 3})) }}
                        {{ fields.textareaField('evidence', row.evidence, __('Evidence examined', 'grcmanager'), v|merge({'field_class': 'col-md-6', 'rows': 3})) }}
                        <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                           <button type="submit" name="save_check" value="1" class="btn btn-sm btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
                           {% if row.updater %}<span class="form-hint ms-auto">{{ __('Last change: %1$s, %2$s', 'grcmanager')|format(row.updater, row.updated) }}</span>{% endif %}
                        </div>
                     </form>
                  </details>
               </td>
            </tr>
            {% endif %}
         {% endfor %}
         </tbody>
      </table>
      </div>
   </div>
</div>
