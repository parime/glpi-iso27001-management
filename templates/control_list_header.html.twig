{# En-tête de la liste des mesures de l'Annexe A : SoA, exports, approbation (issue #199 : passé de PHP à Twig) #}
{# Issue #536 : périmètre de la SoA affichée (entité GLPI), et création de la SoA propre à l'entité. #}
{% if perimeter %}
   <div class="card mb-2">
      <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
         <div>
            <i class="ti ti-sitemap me-2"></i>
            {% if perimeter.own %}
               <span class="badge bg-green-lt me-1"><i class="ti ti-circle-check me-1"></i>{{ __('Own SoA', 'grcmanager') }}</span>
               {{ __('Statement of Applicability of the entity "%s".', 'grcmanager')|format(perimeter.entity) }}
            {% else %}
               <span class="badge bg-azure-lt me-1"><i class="ti ti-arrow-up-right me-1"></i>{{ __('Inherited SoA', 'grcmanager') }}</span>
               {{ __('The entity "%1$s" follows the SoA of the entity "%2$s".', 'grcmanager')|format(perimeter.entity, perimeter.soa) }}
            {% endif %}
         </div>
         {% if perimeter.can_create %}
            <form method="post" action="{{ perimeter.form_url }}" class="m-0"
                  data-grc-confirm="{{ __('Create a separate SoA for this entity? Its 93 controls start from the current applicability and justifications, and every control has to be implemented again in this entity.', 'grcmanager') }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ perimeter.csrf_token }}">
               <button type="submit" name="create_entity_soa" value="1" class="btn btn-outline-primary btn-sm">
                  <i class="ti ti-copy-plus me-1"></i>{{ __('Create the SoA of this entity', 'grcmanager') }}
               </button>
            </form>
            {% include '@grcmanager/_confirm_forms.html.twig' %}
         {% endif %}
      </div>
   </div>
{% endif %}
<div class="alert alert-info d-flex align-items-center justify-content-between mb-2">
   <div><i class="ti ti-info-circle me-2"></i>{{ __('Statement of Applicability (SoA) - ISO/IEC 27001:2022 clause 6.1.3, Annex A (93 controls).', 'grcmanager') }}</div>
   <div class="d-flex gap-2">
      {# ROADMAP « Version 1.5 » : export PDF mis en forme, en plus de l'export natif de la liste. #}
      <a href="{{ report_url }}" class="btn btn-outline-secondary btn-sm" target="_blank"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Export PDF', 'grcmanager') }}</a>
      {# ROADMAP « Version 1.5 » : CSV réimportable après modification dans un tableur. #}
      <a href="{{ csv_url }}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-file-spreadsheet me-1"></i>{{ __('CSV import/export', 'grcmanager') }}</a>
      {# Issue #112 : approbation de la SoA par la direction (versions figées). #}
      <a href="{{ approval_url }}" class="btn btn-outline-primary btn-sm"><i class="ti ti-signature me-1"></i>{{ __('Management approval', 'grcmanager') }}</a>
   </div>
</div>
{# Issue #112 : version qui attend la réponse de la personne, ou SoA modifiée depuis la dernière version approuvée. #}
{% if pending_version %}
   <div class="alert alert-primary"><i class="ti ti-signature me-2"></i>{{ __('Version %d of the SoA is awaiting your approval.', 'grcmanager')|format(pending_version) }} <a href="{{ approval_url }}">{{ __('Answer', 'grcmanager') }}</a></div>
{% endif %}
{% if changed_since %}
   <div class="alert alert-warning"><i class="ti ti-alert-triangle me-2"></i>{{ __('The SoA has changed since approved version %d: a new approval is required.', 'grcmanager')|format(changed_since) }} <a href="{{ approval_url }}">{{ __('Management approval', 'grcmanager') }}</a></div>
{% endif %}
{# Issue #609 : synthèse de la SoA par thème ; mises en œuvre, en cours et prévues parmi les mesures applicables. #}
{% if theme_summary is not empty %}
   {% set totals = theme_summary.totals %}
   <div class="card mb-2">
      <div class="card-header py-2">
         <a class="d-flex align-items-center text-reset text-decoration-none w-100" data-bs-toggle="collapse" href="#grcmanager-theme-summary" role="button" aria-expanded="false" aria-controls="grcmanager-theme-summary">
            <i class="ti ti-layout-list me-2"></i>
            <strong class="me-2">{{ __('Summary by theme', 'grcmanager') }}</strong>
            <span class="badge bg-green-lt me-1"><i class="ti ti-circle-check me-1"></i>{{ __('%d applicable', 'grcmanager')|format(totals.applicable) }}</span>
            <span class="badge bg-secondary-lt me-1"><i class="ti ti-circle-x me-1"></i>{{ __('%d excluded', 'grcmanager')|format(totals.excluded) }}</span>
            <span class="badge bg-teal-lt me-1"><i class="ti ti-check me-1"></i>{{ __('%d implemented', 'grcmanager')|format(totals.implemented) }}</span>
            <i class="ti ti-chevron-down ms-auto"></i>
         </a>
      </div>
      <div class="collapse" id="grcmanager-theme-summary">
         <div class="card-body">
            <div class="table-responsive">
               <table class="table table-sm table-vcenter mb-0">
                  <thead>
                     <tr>
                        <th>{{ __('Theme', 'grcmanager') }}</th>
                        <th class="text-end">{{ __('Controls', 'grcmanager') }}</th>
                        <th class="text-end">{{ __('Applicable', 'grcmanager') }}</th>
                        <th class="text-end">{{ __('Excluded', 'grcmanager') }}</th>
                        <th class="text-end">{{ __('Implemented', 'grcmanager') }}</th>
                        <th class="text-end">{{ __('In progress', 'grcmanager') }}</th>
                        <th class="text-end">{{ __('Planned', 'grcmanager') }}</th>
                     </tr>
                  </thead>
                  <tbody>
                     {% for line in theme_summary.lines %}
                        <tr>
                           <td><a href="{{ line.url }}" title="{{ __('Show the controls of this theme', 'grcmanager') }}"><span class="badge bg-azure-lt">{{ line.label }}</span></a></td>
                           <td class="text-end">{{ line.total }}</td>
                           <td class="text-end">{{ line.applicable }}{% if line.partial > 0 %} <span class="text-secondary small">({{ __('%d partially', 'grcmanager')|format(line.partial) }})</span>{% endif %}</td>
                           <td class="text-end">{{ line.excluded }}</td>
                           <td class="text-end">{{ line.implemented }}</td>
                           <td class="text-end">{{ line.in_progress }}</td>
                           <td class="text-end">{{ line.not_started }}</td>
                        </tr>
                     {% endfor %}
                  </tbody>
                  <tfoot>
                     <tr class="fw-bold">
                        <td>{{ __('Total', 'grcmanager') }}</td>
                        <td class="text-end">{{ totals.total }}</td>
                        <td class="text-end">{{ totals.applicable }}{% if totals.partial > 0 %} <span class="text-secondary small">({{ __('%d partially', 'grcmanager')|format(totals.partial) }})</span>{% endif %}</td>
                        <td class="text-end">{{ totals.excluded }}</td>
                        <td class="text-end">{{ totals.implemented }}</td>
                        <td class="text-end">{{ totals.in_progress }}</td>
                        <td class="text-end">{{ totals.not_started }}</td>
                     </tr>
                  </tfoot>
               </table>
            </div>
            <small class="form-hint d-block mt-2"><i class="ti ti-info-circle me-1"></i>{{ __('"Implemented" counts implemented and verified controls; "Planned" counts applicable controls not started yet. Click a theme to filter the list below.', 'grcmanager') }}</small>
         </div>
      </div>
   </div>
{% endif %}
{# Issue #610 : synthèse de la SoA par attribut des mesures (ISO/IEC 27002:2022), mesures non applicables écartées. #}
{% if attribute_summary is not empty %}
   <div class="card mb-2">
      <div class="card-header py-2">
         <a class="d-flex align-items-center text-reset text-decoration-none w-100" data-bs-toggle="collapse" href="#grcmanager-attribute-summary" role="button" aria-expanded="false" aria-controls="grcmanager-attribute-summary">
            <i class="ti ti-chart-bar me-2"></i>
            <strong class="me-2">{{ __('Summary by attribute', 'grcmanager') }}</strong>
            <span class="text-secondary small">{{ __('Implementation rate by control type, security property, cybersecurity concept, operational capability and security domain.', 'grcmanager') }}</span>
            <i class="ti ti-chevron-down ms-auto"></i>
         </a>
      </div>
      <div class="collapse" id="grcmanager-attribute-summary">
         <div class="card-body">
            {# Issue #663 : onglets reliés à leur panneau, navigables aux flèches (Bootstrap), focus visible. #}
            <ul class="nav nav-tabs mb-3" role="tablist">
               {% for attribute in attribute_summary %}
                  <li class="nav-item" role="presentation">
                     <button type="button" class="nav-link{{ loop.first ? ' active' : '' }}" data-bs-toggle="tab" data-bs-target="#grcmanager-attr-{{ attribute.attribute }}" role="tab"
                             id="grcmanager-attr-tab-{{ attribute.attribute }}" aria-controls="grcmanager-attr-{{ attribute.attribute }}"
                             aria-selected="{{ loop.first ? 'true' : 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>
                        <i class="ti {{ attribute.icon }} me-1" aria-hidden="true"></i>{{ attribute.label }}
                     </button>
                  </li>
               {% endfor %}
            </ul>
            <div class="tab-content">
               {% for attribute in attribute_summary %}
                  <div class="tab-pane{{ loop.first ? ' show active' : '' }}" id="grcmanager-attr-{{ attribute.attribute }}" role="tabpanel"
                       aria-labelledby="grcmanager-attr-tab-{{ attribute.attribute }}" tabindex="0">
                     <div class="table-responsive">
                        <table class="table table-sm table-vcenter mb-0">
                           <thead>
                              <tr>
                                 <th>{{ attribute.label }}</th>
                                 <th class="text-end">{{ __('Applicable controls', 'grcmanager') }}</th>
                                 <th class="text-end">{{ __('Implemented', 'grcmanager') }}</th>
                                 <th class="text-end">{{ __('In progress', 'grcmanager') }}</th>
                                 <th class="w-25">{{ __('Implementation rate', 'grcmanager') }}</th>
                              </tr>
                           </thead>
                           <tbody>
                              {% for line in attribute.lines %}
                                 {% set rate = line.rate ?? 0 %}
                                 <tr>
                                    <td>
                                       <a href="{{ line.url }}" title="{{ __('Show the applicable controls with this value', 'grcmanager') }}">
                                          <span class="badge {{ attribute.class }}"><i class="ti {{ attribute.icon }} me-1"></i>{{ line.label }}</span>
                                       </a>
                                    </td>
                                    <td class="text-end">{{ line.applicable }} / {{ line.total }}</td>
                                    <td class="text-end">{{ line.implemented }}</td>
                                    <td class="text-end">{{ line.in_progress }}</td>
                                    <td>
                                       {% if line.rate is null %}
                                          <span class="badge bg-secondary-lt"><i class="ti ti-minus me-1"></i>{{ __('No applicable control', 'grcmanager') }}</span>
                                       {% else %}
                                          <div class="d-flex align-items-center gap-2">
                                             <div class="progress progress-sm flex-grow-1">
                                                <div class="progress-bar {{ rate >= 80 ? 'bg-green' : (rate >= 40 ? 'bg-yellow' : 'bg-red') }}" style="width: {{ rate }}%" role="progressbar" aria-label="{{ __('Implementation rate', 'grcmanager') }}" aria-valuenow="{{ rate }}" aria-valuemin="0" aria-valuemax="100"></div>
                                             </div>
                                             <span class="small text-nowrap">{{ rate|round }} %</span>
                                          </div>
                                       {% endif %}
                                    </td>
                                 </tr>
                              {% endfor %}
                           </tbody>
                        </table>
                     </div>
                  </div>
               {% endfor %}
            </div>
            <small class="form-hint d-block mt-2"><i class="ti ti-info-circle me-1"></i>{{ __('Controls marked not applicable are left out of the rate; "in progress" counts for half. A control can carry several values of the same attribute. Click a value to filter the list below.', 'grcmanager') }}</small>
         </div>
      </div>
   </div>
{% endif %}
