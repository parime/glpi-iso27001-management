{# En-tête de la liste des mesures de l'Annexe A : SoA, exports, approbation (issue #199 : passé de PHP à Twig) #}
<div class="alert alert-info d-flex align-items-center justify-content-between mb-2">
   <div><i class="ti ti-info-circle me-2"></i>{{ __('Statement of Applicability (SoA) - ISO/IEC 27001:2022 clause 6.1.3, Annex A (93 controls).', 'grcmanager') }}</div>
   <div class="d-flex gap-2">
      {# ROADMAP « Version 1.5 » : export PDF mis en forme, en plus de l'export natif de la liste. #}
      <a href="{{ report_url }}" class="btn btn-outline-secondary btn-sm" target="_blank"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Export PDF', 'grcmanager') }}</a>
      {# ROADMAP « Version 1.5 » : CSV réimportable après modification dans un tableur. #}
      <a href="{{ csv_url }}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-file-spreadsheet me-1"></i>{{ __('CSV import/export', 'grcmanager') }}</a>
      {# Issue #112 : approbation de la SoA par la direction (versions figées). #}
      <a href="{{ approval_url }}" class="btn btn-outline-primary btn-sm"><i class="ti ti-signature me-1"></i>{{ __('Management approval', 'grcmanager') }}</a>
   </div>
</div>
{# Issue #112 : version qui attend la réponse de la personne, ou SoA modifiée depuis la dernière version approuvée. #}
{% if pending_version %}
   <div class="alert alert-primary"><i class="ti ti-signature me-2"></i>{{ __('Version %d of the SoA is awaiting your approval.', 'grcmanager')|format(pending_version) }} <a href="{{ approval_url }}">{{ __('Answer', 'grcmanager') }}</a></div>
{% endif %}
{% if changed_since %}
   <div class="alert alert-warning"><i class="ti ti-alert-triangle me-2"></i>{{ __('The SoA has changed since approved version %d: a new approval is required.', 'grcmanager')|format(changed_since) }} <a href="{{ approval_url }}">{{ __('Management approval', 'grcmanager') }}</a></div>
{% endif %}
