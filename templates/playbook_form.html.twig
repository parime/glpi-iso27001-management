{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('name', item.fields['name'], __('Nom'), {
      'required': true,
      'add_field_html': hints.hint(__('Example: "Ransomware", "Compromised account".', 'grcmanager')),
   }) }}
   {{ fields.checkboxField('is_active', item.isNewItem() ? 1 : item.fields['is_active'], __('Active')) }}
   {{ fields.dropdownArrayField('category', item.fields['category'], categories, __('Incident type', 'grcmanager'), {
      'add_field_html': hints.hint(__('The playbook is suggested first on incidents of this type.', 'grcmanager')),
   }) }}
   {{ fields.textareaField('description', item.fields['description'], __('Description'), {
      'full_width': true,
   }) }}
{% endblock %}
