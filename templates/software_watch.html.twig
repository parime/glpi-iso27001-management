{# Issue #160 : logiciels à surveiller — correspondance logiciel du parc / CPE, en un clic #}
<div class="container-fluid">
   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <h2 class="mb-0"><i class="ti ti-radar me-1"></i>{{ __('Logiciels à surveiller', 'grcmanager') }}</h2>
      <a class="btn btn-outline-secondary ms-auto" href="{{ park_url }}"><i class="ti ti-bug me-1"></i>{{ __('Vulnérabilités du parc', 'grcmanager') }}</a>
   </div>

   <div class="alert alert-info">
      <i class="ti ti-info-circle me-1"></i>{{ __('Choisissez les logiciels du parc à surveiller. Pour chacun, cherchez son identifiant CPE (le nom officiel utilisé par la base de vulnérabilités NVD), puis confirmez. Commencez par les logiciels exposés : navigateurs, accès distant, VPN, bureautique, lecteurs PDF.', 'grcmanager') }}
   </div>

   {% if not enabled %}
      <div class="alert alert-warning">
         <i class="ti ti-plug-connected-x me-1"></i>{{ __('L\'interrogation de NVD est désactivée : les suggestions de CPE et la vérification des versions ne fonctionnent pas encore.', 'grcmanager') }}
         <a href="{{ config_url }}">{{ __('Activer l\'enrichissement NVD dans la configuration du plugin', 'grcmanager') }}</a>
      </div>
   {% endif %}

   <form method="get" action="{{ action }}" class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <div class="btn-group" role="group">
         {% for key, label in filters %}
            <a class="btn {{ key == filter ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ action }}?filter={{ key }}&search={{ search|url_encode }}">{{ label }}</a>
         {% endfor %}
      </div>
      <input type="hidden" name="filter" value="{{ filter }}">
      <input type="search" class="form-control w-auto" name="search" value="{{ search }}" placeholder="{{ __('Rechercher un logiciel', 'grcmanager') }}" aria-label="{{ __('Rechercher un logiciel', 'grcmanager') }}">
      <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-search me-1"></i>{{ __('Rechercher', 'grcmanager') }}</button>
   </form>

   <div class="card">
      {% if rows is empty %}
         <div class="card-body text-muted"><i class="ti ti-circle-check me-1 text-green"></i>{{ __('Aucun logiciel dans cette liste.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead>
                  <tr>
                     <th>{{ __('Logiciel', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Installations', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Versions', 'grcmanager') }}</th>
                     <th>{{ __('État', 'grcmanager') }}</th>
                     <th>{{ __('Produit surveillé', 'grcmanager') }}</th>
                     {% if can_update %}<th class="text-end">{{ __('Actions', 'grcmanager') }}</th>{% endif %}
                  </tr>
               </thead>
               <tbody>
               {% for row in rows %}
                  <tr id="sw-{{ loop.index }}">
                     <td>
                        <strong>{{ row.name }}</strong>
                        {% if row.exposed %}<span class="badge bg-orange-lt ms-1" title="{{ __('Logiciel souvent exposé (contenus venant d\'Internet ou accès distant)', 'grcmanager') }}"><i class="ti ti-world me-1"></i>{{ __('Exposé', 'grcmanager') }}</span>{% endif %}
                     </td>
                     <td class="text-end">{{ row.installs }}</td>
                     <td class="text-end">{{ row.versions }}</td>
                     <td>
                        {% if row.status == 'watched' %}
                           <span class="badge bg-green-lt"><i class="ti ti-eye-check me-1"></i>{{ __('Surveillé', 'grcmanager') }}</span>
                        {% elseif row.status == 'ignored' %}
                           <span class="badge bg-secondary-lt"><i class="ti ti-eye-off me-1"></i>{{ __('Ignoré', 'grcmanager') }}</span>
                        {% else %}
                           <span class="badge bg-blue-lt"><i class="ti ti-help me-1"></i>{{ __('À examiner', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                     <td>
                        {% if row.status == 'watched' %}
                           <a href="{{ catalog_url }}?id={{ row.canonical_id }}">{{ row.product }}</a>
                           <div class="text-muted small"><code>{{ row.prefix }}</code></div>
                        {% endif %}
                     </td>
                     {% if can_update %}
                        <td class="text-end text-nowrap">
                           {% if row.status == 'todo' %}
                              <a class="btn btn-sm btn-primary" href="{{ action }}?filter={{ filter }}&search={{ search|url_encode }}&suggest={{ row.name|url_encode }}#sw-{{ loop.index }}"><i class="ti ti-search me-1"></i>{{ __('Chercher le CPE', 'grcmanager') }}</a>
                           {% endif %}
                           {% if row.status != 'watched' %}
                              <form method="post" action="{{ action }}" class="d-inline">
                                 <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                 <input type="hidden" name="software" value="{{ row.name }}">
                                 <input type="hidden" name="filter" value="{{ filter }}">
                                 <input type="hidden" name="search" value="{{ search }}">
                                 {% if row.status == 'ignored' %}
                                    <button type="submit" name="unignore" value="1" class="btn btn-sm btn-outline-secondary"><i class="ti ti-eye me-1"></i>{{ __('Ne plus ignorer', 'grcmanager') }}</button>
                                 {% else %}
                                    <button type="submit" name="ignore" value="1" class="btn btn-sm btn-outline-secondary" title="{{ __('Logiciel sans enjeu de sécurité (pilote, utilitaire interne...)', 'grcmanager') }}"><i class="ti ti-eye-off me-1"></i>{{ __('Ignorer', 'grcmanager') }}</button>
                                 {% endif %}
                              </form>
                           {% endif %}
                        </td>
                     {% endif %}
                  </tr>
                  {% if can_update and row.status == 'todo' and row.name == suggest_for %}
                     <tr class="bg-light">
                        <td colspan="6">
                           <form method="post" action="{{ action }}">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="software" value="{{ row.name }}">
                              <input type="hidden" name="filter" value="{{ filter }}">
                              <input type="hidden" name="search" value="{{ search }}">
                              {% if suggest_error %}
                                 <div class="alert alert-warning mb-2"><i class="ti ti-cloud-off me-1"></i>{{ __('NVD ne répond pas pour le moment. Réessayez dans une minute, ou saisissez le CPE ci-dessous.', 'grcmanager') }}</div>
                              {% elseif suggestions is not empty %}
                                 <div class="mb-2 fw-bold">{{ __('Suggestions du dictionnaire NVD :', 'grcmanager') }}</div>
                                 {% for s in suggestions %}
                                    <label class="form-check">
                                       <input class="form-check-input" type="radio" name="cpe" value="{{ s.prefix }}" {{ loop.first ? 'checked' : '' }}>
                                       <span class="form-check-label">{{ s.title }} <code class="ms-1">{{ s.prefix }}</code></span>
                                    </label>
                                 {% endfor %}
                              {% elseif enabled %}
                                 <div class="text-muted mb-2">{{ __('Aucune suggestion trouvée : saisissez le CPE ci-dessous, ou ignorez ce logiciel.', 'grcmanager') }}</div>
                              {% endif %}
                              <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                 <input type="text" class="form-control w-auto" size="50" name="cpe_manual" placeholder="cpe:2.3:a:editeur:produit" aria-label="{{ __('CPE saisi à la main', 'grcmanager') }}">
                                 <button type="submit" name="confirm" value="1" class="btn btn-success"><i class="ti ti-check me-1"></i>{{ __('Confirmer', 'grcmanager') }}</button>
                                 <a class="btn btn-link" href="https://nvd.nist.gov/products/cpe/search" target="_blank" rel="noopener">{{ __('Chercher sur le site de NVD', 'grcmanager') }}</a>
                              </div>
                           </form>
                        </td>
                     </tr>
                  {% endif %}
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>
</div>
