{# Issue #25 : risques liés à un actif (onglet « Risques ») ; issue #199 : passé de PHP à Twig. #}
{% if risks is empty %}
   <p class="p-2 text-muted">{{ __('No risk linked to this asset.', 'grcmanager') }}</p>
{% else %}
   <table class="table table-striped">
      <thead><tr><th>{{ __('Title', 'grcmanager') }}</th><th>{{ __('Risk level', 'grcmanager') }}</th></tr></thead>
      <tbody>
         {% for risk in risks %}
            {% set level_html = risk.level_html %}
            <tr><td><a href="{{ risk.url }}">{{ risk.title }}</a></td><td>{{ level_html|raw }}</td></tr>
         {% endfor %}
      </tbody>
   </table>
{% endif %}
