{# Issue #177, phase 2 : graphe de l'impact d'une panne (Cytoscape, fourni par GLPI). Paramètre : elements. #}
{% set cy_id = 'grc-impact-' ~ random() %}
<div id="{{ cy_id }}" class="border rounded bg-white mb-1" style="height: 340px; width: 100%;" data-elements="{{ elements|json_encode }}"></div>
<div class="d-flex flex-wrap gap-3 small text-muted mb-2">
   <span><span class="badge" style="background:#d63939">&nbsp;</span> {{ __('Disponibilité élevée', 'grcmanager') }}</span>
   <span><span class="badge" style="background:#f59f00">&nbsp;</span> {{ __('Disponibilité moyenne', 'grcmanager') }}</span>
   <span><i class="ti ti-arrow-right"></i> {{ __('une panne de la source touche l\'élément pointé', 'grcmanager') }}</span>
</div>
<script>
   (function () {
      // Données passées par un attribut échappé, jamais injectées telles quelles dans le script.
      const container = document.getElementById('{{ cy_id }}');
      const render = function () {
         const cy = window.cytoscape({
            container: container,
            elements: JSON.parse(container.dataset.elements),
            wheelSensitivity: 0.2,
            maxZoom: 1.3,
            style: [
               {selector: 'node', style: {
                  'label': 'data(label)', 'text-wrap': 'wrap', 'text-max-width': 140, 'font-size': 11,
                  'text-valign': 'bottom', 'text-margin-y': 6, 'width': 24, 'height': 24,
                  'background-color': '#74b816', 'color': '#1d273b', 'shape': 'round-rectangle'
               }},
               {selector: 'node.availability-high', style: {'background-color': '#d63939'}},
               {selector: 'node.availability-medium', style: {'background-color': '#f59f00'}},
               {selector: 'node.availability-', style: {'background-color': '#adb5bd'}},
               {selector: 'node.center', style: {'width': 36, 'height': 36, 'font-weight': 'bold'}},
               {selector: 'edge', style: {
                  'width': 2, 'line-color': '#adb5bd', 'target-arrow-color': '#adb5bd',
                  'target-arrow-shape': 'triangle', 'curve-style': 'bezier'
               }}
            ],
            layout: {name: 'preset'}
         });
         try {
            cy.layout({name: 'dagre', rankDir: 'LR', nodeSep: 30, rankSep: 170, padding: 20}).run();
         } catch (e) {
            cy.layout({name: 'breadthfirst', directed: true, padding: 20}).run();
         }
         cy.on('tap', 'node', function (event) {
            const url = event.target.data('url');
            if (url) {
               window.location.href = url;
            }
         });
      };
      if (typeof window.cytoscape === 'undefined') {
         const script = document.createElement('script');
         script.src = '{{ config('root_doc') }}/lib/cytoscape.min.js';
         script.onload = render;
         document.head.appendChild(script);
      } else {
         render();
      }
   })();
</script>
