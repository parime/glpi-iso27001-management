{# Mesure de l'Annexe A dans la SoA (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% macro referentials_hint(text, url) %}
   <small class="form-hint d-block mt-1">{{ text }} <a href="{{ url }}">{{ __('the Reference frameworks screen', 'grcmanager') }}</a> {{ __('for details.', 'grcmanager') }}</small>
{% endmacro %}

{% block form_fields %}
   {{ fields.htmlField('', '<strong>' ~ code|e ~ '</strong>', __('Control', 'grcmanager')) }}
   {{ fields.htmlField('', theme_badge, __('Theme', 'grcmanager')) }}
   {{ fields.htmlField('', title|e, _x('label', 'Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.dropdownArrayField('applicability', item.fields['applicability'] ?: 'yes', applicabilities, __('Applicability', 'grcmanager')) }}
   {{ fields.dropdownArrayField('implementation_status', item.fields['implementation_status'] ?: 'not_started', implementation_statuses, __('Implementation status', 'grcmanager')) }}
   {{ fields.textareaField('justification', item.fields['justification'], __('Justification', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Required if the control is not fully applicable.', 'grcmanager')),
   }) }}
   {# Issue #609 : motifs de sélection (ISO/IEC 27001:2022, 6.1.3 d), plusieurs possibles ; les motifs déduits des risques et obligations liés sont cochés tant que personne ne les a renseignés. #}
   <input type="hidden" name="_grcmanager_selection" value="1">
   {% set reasons_html %}
      <div>
         {% for key, label in selection_reasons %}
            <label class="form-check form-check-inline mb-1">
               <input class="form-check-input" type="checkbox" name="selection_reasons[]" value="{{ key }}"{{ key in checked_reasons ? ' checked' : '' }}>
               <span class="form-check-label">{{ label }}
                  {% if key in suggested_reasons %}<span class="badge bg-azure-lt ms-1" title="{{ __('Deduced from the risks linked to this control and from the obligations of the register attached to them.', 'grcmanager') }}"><i class="ti ti-link me-1"></i>{{ __('From the links', 'grcmanager') }}</span>{% endif %}
               </span>
            </label>
         {% endfor %}
      </div>
      {% if reasons_never_set and suggested_reasons is not empty %}
         {{ hints.hint(__('The ticked reasons are deduced from the linked risks and obligations: check them, then save.', 'grcmanager')) }}
      {% else %}
         {{ hints.hint(__('Why this control is included: several reasons are possible. Linking a new risk ticks the risk assessment reason.', 'grcmanager')) }}
      {% endif %}
   {% endset %}
   {{ fields.htmlField('', reasons_html, __('Reasons for selection', 'grcmanager'), {'full_width': true}) }}
   {# Issue #609 : détail d'une exclusion (mesure non applicable ou partiellement applicable), masqué pour une mesure applicable. #}
   <input type="hidden" name="_grcmanager_exclusion" value="1">
   {{ fields.dropdownArrayField('exclusion_category', item.fields['exclusion_category'], exclusion_categories, __('Exclusion category', 'grcmanager'), {
      'display_emptychoice': true,
      'add_field_class': 'grcmanager-exclusion',
      'add_field_html': hints.hint(__('Why the control is left out, for example: no premises of its own, hosting by a certified provider.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('residual_risk', item.fields['residual_risk'], residual_levels, __('Residual risk', 'grcmanager'), {
      'display_emptychoice': true,
      'add_field_class': 'grcmanager-exclusion',
      'add_field_html': hints.hint(__('Risk that remains once the compensating measures are in place.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('compensating_controls', null, compensating_options, __('Compensating controls', 'grcmanager'), {
      'multiple': true,
      'values': compensating_controls,
      'full_width': true,
      'add_field_class': 'grcmanager-exclusion',
      'add_field_html': hints.hint(__('Controls of this SoA that make up for the exclusion, for example A.5.20 for an audit clause in the provider contract.', 'grcmanager')),
   }) }}
   {{ fields.textareaField('compensating_measures', item.fields['compensating_measures'], __('Compensating measures', 'grcmanager'), {
      'full_width': true,
      'add_field_class': 'grcmanager-exclusion',
      'add_field_html': hints.hint(__('Other compensating measures, in your own words (contract clause, provider certificate...).', 'grcmanager')),
   }) }}
   <script>
      $(function () {
         var applicability = $('select[name="applicability"]');
         var toggle = function () {
            $('.grcmanager-exclusion').toggleClass('d-none', applicability.val() === 'yes');
         };
         applicability.on('change', toggle);
         toggle();
      });
   </script>
   {# Issue #610 : attributs ISO/IEC 27002:2022 livrés avec le catalogue, modifiables. #}
   <input type="hidden" name="_grcmanager_attributes" value="1">
   {% for attribute in attributes %}
   {{ fields.dropdownArrayField(attribute.field, null, attribute.options, attribute.label, {
      'multiple': true,
      'values': attribute.values,
      'add_field_html': loop.first ? hints.hint(__('Attributes delivered with the catalogue: they filter the SoA and feed the summary by attribute. You can adjust them.', 'grcmanager')) : '',
   }) }}
   {% endfor %}
   {# Registre sensible : champ absent sans son droit (les liens existants sont conservés). #}
   {% if can_view_risks %}
   {{ fields.dropdownArrayField('linked_risks', null, risks, __('Linked risks', 'grcmanager'), {
      'multiple': true,
      'values': linked_risks,
      'full_width': true,
      'add_field_html': hints.hint(__('Risk(s) from the register justifying or driving this control\'s implementation.', 'grcmanager')),
   }) }}
   {% endif %}

   {# Correspondance publiée par le NIST (ROADMAP « Version 2.2 ») : ligne absente si le NIST n'en publie aucune. #}
   {% if nist is not empty %}
      {% set nist_html %}
         {% for c in nist %}<span class="badge bg-blue-lt me-1">NIST CSF {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Mapping published by NIST: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', nist_html, __('Equivalent reference frameworks', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issues #110 et #111 : correspondances indicatives établies par ce projet. #}
   {% if nis2 is not empty %}
      {% set nis2_html %}
         {% for c in nis2 %}<span class="badge bg-purple-lt me-1">NIS2 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', nis2_html, __('NIS2 requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : exigences DORA, correspondance indicative établie par ce projet. #}
   {% if dora is not empty %}
      {% set dora_html %}
         {% for c in dora %}<span class="badge bg-indigo-lt me-1">DORA {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', dora_html, __('DORA requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : objectifs ISO/IEC 27701 (vie privée), correspondance indicative établie par ce projet. #}
   {% if iso27701 is not empty %}
      {% set iso27701_html %}
         {% for c in iso27701 %}<span class="badge bg-pink-lt me-1">ISO 27701 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', iso27701_html, __('ISO 27701 objectives', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : articles ISO 22301 (continuité), correspondance indicative établie par ce projet. #}
   {% if iso22301 is not empty %}
      {% set iso22301_html %}
         {% for c in iso22301 %}<span class="badge bg-orange-lt me-1">ISO 22301 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', iso22301_html, __('ISO 22301 requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : groupes ISO/IEC 42001 (IA), correspondance indicative établie par ce projet. #}
   {% if iso42001 is not empty %}
      {% set iso42001_html %}
         {% for c in iso42001 %}<span class="badge bg-teal-lt me-1">ISO 42001 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', iso42001_html, __('ISO 42001 control groups', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : exigences PCI DSS, correspondance indicative établie par ce projet. #}
   {% if pci_dss is not empty %}
      {% set pci_dss_html %}
         {% for c in pci_dss %}<span class="badge bg-lime-lt me-1">PCI DSS {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', pci_dss_html, __('PCI DSS requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : critères SOC 2, correspondance indicative établie par ce projet. #}
   {% if soc2 is not empty %}
      {% set soc2_html %}
         {% for c in soc2 %}<span class="badge bg-purple-lt me-1">SOC 2 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', soc2_html, __('SOC 2 criteria', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : articles de l'AI Act, correspondance indicative établie par ce projet. #}
   {% if ai_act is not empty %}
      {% set ai_act_html %}
         {% for c in ai_act %}<span class="badge bg-cyan-lt me-1">AI Act {{ __('Art. %s', 'grcmanager')|format(c) }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', ai_act_html, __('AI Act articles', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : exigences HDS v2.0, correspondance indicative établie par ce projet. #}
   {% if hds is not empty %}
      {% set hds_html %}
         {% for c in hds %}<span class="badge bg-pink-lt me-1">HDS {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', hds_html, __('HDS requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #537 : exigences des référentiels personnalisés actifs qui citent cette mesure. #}
   {% for custom in custom_frameworks %}
      {% set custom_html %}
         {% for c in custom.codes %}<span class="badge bg-indigo-lt me-1"><i class="ti ti-file-spreadsheet me-1"></i>{{ c }}</span>{% endfor %}
         <small class="form-hint d-block mt-1">{{ __('Mapping given by the imported file: see', 'grcmanager') }} <a href="{{ custom.url }}">{{ __('the requirements of this framework', 'grcmanager') }}</a>.</small>
      {% endset %}
      {{ fields.htmlField('', custom_html, custom.label, {'full_width': true}) }}
   {% endfor %}
   {% if anssi is not empty %}
      {% set anssi_html %}
         {% for m in anssi %}<span class="badge bg-teal-lt me-1" title="{{ m.title }}">{{ __('Measure %d', 'grcmanager')|format(m.number) }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', anssi_html, __('ANSSI hygiene', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #143 : contrôles CIS, correspondance indicative établie par ce projet. #}
   {% if cis is not empty %}
      {% set cis_html %}
         {% for c in cis %}<span class="badge bg-orange-lt me-1" title="{{ c.title }}">CIS {{ c.number }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', cis_html, __('CIS Controls v8', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #109 et assetsign #204 : preuves issues d'assetsign, ligne absente si le plugin n'est pas actif. #}
   {% if assetsign_sheets is not empty or assetsign_charter is not null %}
      {% set assetsign_html %}
         {% for s in assetsign_sheets %}
            <div class="mb-1"><strong>{{ s.label }}</strong> :
               <span class="badge bg-green-lt me-1"><i class="ti ti-check me-1"></i>{{ __('%d signed', 'grcmanager')|format(s.signed) }}</span>
               <span class="badge bg-yellow-lt me-1"><i class="ti ti-hourglass me-1"></i>{{ __('%d pending', 'grcmanager')|format(s.pending) }}</span>
               <span class="badge bg-red-lt me-1"><i class="ti ti-clock-x me-1"></i>{{ __('%d expired', 'grcmanager')|format(s.expired) }}</span>
               {% if s.url %} <a href="{{ s.url }}">{{ __('View forms', 'grcmanager') }}</a>{% endif %}
            </div>
         {% endfor %}
         {% if assetsign_charter is not null %}
            <div class="mb-1"><strong>{{ __('Signed IT charter', 'grcmanager') }}</strong> :
               {% if assetsign_charter is empty %}<span class="text-muted">{{ __('no charter campaign launched', 'grcmanager') }}</span>{% endif %}
            </div>
            {% if assetsign_charter is not empty %}
               <ul class="mb-1">
                  {% for line in assetsign_charter %}
                     <li>{{ line.entity }} : <span class="badge {{ line.rate >= 90 ? 'bg-green-lt' : (line.rate >= 60 ? 'bg-yellow-lt' : 'bg-red-lt') }} me-1">{{ __('%1$d / %2$d (%3$d %%)', 'grcmanager')|format(line.signed, line.total, line.rate) }}</span><span class="text-muted">{{ line.campaign }}</span></li>
                  {% endfor %}
               </ul>
               {% if campaigns_url %}<a href="{{ campaigns_url }}">{{ __('View campaigns', 'grcmanager') }}</a>{% endif %}
            {% endif %}
         {% endif %}
         <small class="form-hint d-block mt-1">{{ __('Counters computed live from the assetsign plugin, on your active entities.', 'grcmanager') }}</small>
      {% endset %}
      {{ fields.htmlField('', assetsign_html, __('assetsign evidence', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #368 : couverture Wazuh, lue en direct dans le plugin Wazuh ; ligne absente s'il n'est pas exploitable. #}
   {% if wazuh is not null %}
      {% set wazuh_html %}
         <div class="mb-1">
            <span class="badge bg-blue-lt me-1"><i class="ti ti-heartbeat me-1"></i>{{ __('%1$d active agent(s) out of %2$d', 'grcmanager')|format(wazuh.active, wazuh.agents) }}</span>
            {% if wazuh.rate is null %}
               <span class="text-muted">{{ __('no computer in your entities', 'grcmanager') }}</span>
            {% else %}
               <span class="badge {{ wazuh.rate >= 90 ? 'bg-green-lt' : (wazuh.rate >= 60 ? 'bg-yellow-lt' : 'bg-red-lt') }} me-1"><i class="ti ti-device-desktop me-1"></i>{{ __('%1$d of %2$d computers covered (%3$s %%)', 'grcmanager')|format(wazuh.covered, wazuh.computers, wazuh.rate|number_format(1, ',')) }}</span>
            {% endif %}
            {% if wazuh_agents_url %}<a href="{{ wazuh_agents_url }}">{{ __('View agents', 'grcmanager') }}</a>{% endif %}
         </div>
         <small class="form-hint d-block">{{ __('Read live from the Wazuh plugin: a computer is covered when an active agent is linked to it.', 'grcmanager') }}</small>
      {% endset %}
      {{ fields.htmlField('', wazuh_html, __('Wazuh coverage', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #707 : couverture SentinelOne, d'après la dernière lecture de la tâche automatique. #}
   {% if sentinelone_coverage is not null %}
      {% set s1 = sentinelone_coverage %}
      {% set s1_html %}
         <div class="mb-1" id="grc-sentinelone-coverage">
            <span class="badge bg-purple-subtle text-purple-emphasis me-1"><i class="ti ti-shield-search me-1"></i>{{ __('%1$d active agent(s) out of %2$d', 'grcmanager')|format(s1.active, s1.agents) }}</span>
            {% if s1.rate is null %}
               <span class="text-muted">{{ __('no computer in your entities', 'grcmanager') }}</span>
            {% else %}
               <span class="badge {{ s1.rate >= 90 ? 'bg-green-subtle text-green-emphasis' : (s1.rate >= 60 ? 'bg-yellow-subtle text-yellow-emphasis' : 'bg-red-subtle text-red-emphasis') }} me-1"><i class="ti ti-device-desktop me-1"></i>{{ __('%1$d of %2$d computers covered (%3$s %%)', 'grcmanager')|format(s1.covered, s1.computers, s1.rate|number_format(1, ',')) }}</span>
            {% endif %}
         </div>
         <small class="form-hint d-block">{{ __('From the last reading of SentinelOne: a computer is covered when an active agent is matched with it (serial number or exact name).', 'grcmanager') }}</small>
      {% endset %}
      {{ fields.htmlField('', s1_html, __('SentinelOne coverage', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Docker Inventory #10 : preuves du plugin Inventaire Docker, lues par son API ; ligne absente sans lui. #}
   {% if docker is not null %}
      {% set docker_html %}
         <div id="grc-docker-evidence">
         {% if docker.inventory is defined %}
            {% set inv = docker.inventory %}
            <div class="mb-1" data-docker-section="inventory">
               <span class="badge bg-blue-lt me-1"><i class="ti ti-box me-1"></i>
                  {{- __('%d service(s)', 'grcmanager')|format(inv.services) }}</span>
               <span class="badge bg-azure-lt me-1"><i class="ti ti-stack-2 me-1"></i>
                  {{- __('%d stack(s)', 'grcmanager')|format(inv.stacks) }}</span>
               <span class="badge bg-cyan-lt me-1"><i class="ti ti-server me-1"></i>
                  {{- __('%d node(s)', 'grcmanager')|format(inv.nodes) }}</span>
               {% if inv.retired_services > 0 %}
                  <span class="badge bg-secondary-lt me-1"><i class="ti ti-archive me-1"></i>
                     {{- __('%d retired', 'grcmanager')|format(inv.retired_services) }}</span>
               {% endif %}
               {% if inv.services_url %}<a href="{{ inv.services_url }}">{{ __('View services', 'grcmanager') }}</a>{% endif %}
            </div>
            {% if inv.connections is not empty %}
               <ul class="mb-1">
                  {% for c in inv.connections %}
                     <li>
                        {% if c.url %}<a href="{{ c.url }}">{{ c.name }}</a>{% else %}{{ c.name }}{% endif %}
                        <span class="text-muted">({{ c.type_label }})</span> :
                        {% if c.freshness == 'never' %}
                           <span class="badge bg-red-lt"><i class="ti ti-clock-x me-1"></i>
                              {{- __('no successful import yet', 'grcmanager') }}</span>
                           {% if c.last_status_label %}
                              <span class="text-muted">{{ __('last reading: %s', 'grcmanager')|format(c.last_status_label) }}</span>
                           {% endif %}
                        {% elseif c.freshness == 'stale' %}
                           <span class="badge bg-yellow-lt"
                                 title="{{ __('More than 48 hours ago: the inventory may be out of date.', 'grcmanager') }}">
                              <i class="ti ti-clock-exclamation me-1"></i>
                              {{- __('last successful import: %s', 'grcmanager')|format(c.last_success_date|formatted_datetime) }}</span>
                        {% else %}
                           <span class="badge bg-green-lt"><i class="ti ti-clock-check me-1"></i>
                              {{- __('last successful import: %s', 'grcmanager')|format(c.last_success_date|formatted_datetime) }}</span>
                        {% endif %}
                     </li>
                  {% endfor %}
               </ul>
            {% elseif not inv.can_view_connections %}
               <small class="text-muted d-block">
                  {{- __('The import dates of the connections are shown to the administrators of the Docker inventory.', 'grcmanager') -}}
               </small>
            {% endif %}
         {% endif %}

         {% if docker.gaps is defined %}
            {% set gaps = docker.gaps %}
            <div class="mb-1" data-docker-section="gaps"><strong>{{ __('Version gaps', 'grcmanager') }}</strong> :
               {% for g in gaps.counts %}
                  <span class="badge bg-{{ g.color }}-lt me-1"><i class="{{ g.icon }} me-1"></i>{{ g.label }} : {{ g.count }}</span>
               {% endfor %}
               {% if gaps.page_url %}<a href="{{ gaps.page_url }}">{{ __('View versions', 'grcmanager') }}</a>{% endif %}
            </div>
            {% if gaps.rows is not empty %}
               <ul class="mb-1">
                  {% for r in gaps.rows %}
                     <li>
                        {% if r.url %}<a href="{{ r.url }}">{{ r.service }}</a>{% else %}{{ r.service }}{% endif %}
                        {% if r.stack %}<span class="text-muted">({{ r.stack }})</span>{% endif %} :
                        <code>{{ r.image }}:{{ r.deployed_tag }}</code> <i class="ti ti-arrow-right"></i> <code>{{ r.latest_tag }}</code>
                        <span class="badge bg-{{ r.gap.color }}-lt"><i class="{{ r.gap.icon }} me-1"></i>{{ r.gap.label }}</span>
                     </li>
                  {% endfor %}
               </ul>
               {% if gaps.total > gaps.rows|length %}
                  <small class="text-muted d-block">
                     {{- __('%1$d services to update: the %2$d most urgent are shown.', 'grcmanager')|format(gaps.total, gaps.rows|length) -}}
                  </small>
               {% endif %}
            {% endif %}
         {% endif %}

         {% if docker.vulnerabilities is defined %}
            {% set vul = docker.vulnerabilities %}
            <div class="mb-1" data-docker-section="vulnerabilities">
               <strong>{{ __('Image vulnerabilities (Harbor)', 'grcmanager') }}</strong> :
               {% if not vul.has_harbor %}
                  <span class="text-muted">{{ __('no Harbor connection: the images are not analysed', 'grcmanager') }}</span>
               {% else %}
                  {% for v in vul.counts %}
                     {% if v.count > 0 %}
                        <span class="badge bg-{{ v.color }}-lt me-1"><i class="{{ v.icon }} me-1"></i>{{ v.label }} : {{ v.count }}</span>
                     {% endif %}
                  {% endfor %}
                  {% if vul.page_url %}<a href="{{ vul.page_url }}">{{ __('View Harbor images', 'grcmanager') }}</a>{% endif %}
               {% endif %}
            </div>
            {% if vul.rows is not empty %}
               <ul class="mb-1">
                  {% for r in vul.rows %}
                     <li>
                        {% if r.url %}<a href="{{ r.url }}">{{ r.service }}</a>{% else %}{{ r.service }}{% endif %}
                        <code>{{ r.image }}:{{ r.tag }}</code> :
                        {% if r.critical > 0 %}
                           <span class="badge bg-red-lt me-1"><i class="ti ti-alert-octagon me-1"></i>
                              {{- __('%d critical', 'grcmanager')|format(r.critical) }}</span>
                        {% endif %}
                        {% if r.high > 0 %}
                           <span class="badge bg-orange-lt me-1"><i class="ti ti-alert-triangle me-1"></i>
                              {{- __('%d high', 'grcmanager')|format(r.high) }}</span>
                        {% endif %}
                     </li>
                  {% endfor %}
               </ul>
            {% endif %}
            {% if vul.has_harbor %}
               <small class="form-hint d-block">
                  {{- __('Services counted by the most severe vulnerability of the image they run.', 'grcmanager') -}}
               </small>
            {% endif %}
         {% endif %}

         {% if docker.configuration is defined %}
            {% set conf = docker.configuration %}
            <div class="mb-1" data-docker-section="configuration">
               <span class="badge bg-blue-lt me-1"><i class="ti ti-settings me-1"></i>
                  {{- __('%d service(s)', 'grcmanager')|format(conf.total) }}</span>
               {% if conf.managed_share is null %}
                  <span class="text-muted">{{ __('image origin not evaluated: no controlled registry declared', 'grcmanager') }}</span>
               {% else %}
                  {% set share_class = conf.managed_share >= 90 ? 'bg-green-lt' : (conf.managed_share >= 60 ? 'bg-yellow-lt' : 'bg-red-lt') %}
                  <span class="badge {{ share_class }} me-1"><i class="ti ti-building-warehouse me-1"></i>
                     {{- __('%1$d of %2$d images from a controlled registry (%3$s %%)', 'grcmanager')
                        |format(conf.managed, conf.evaluated, conf.managed_share|number_format(1, ',')) }}</span>
               {% endif %}
               {% if conf.services_url %}<a href="{{ conf.services_url }}">{{ __('View services', 'grcmanager') }}</a>{% endif %}
            </div>
            {% if conf.rows is not empty %}
               <div class="table-responsive mb-1">
                  <table class="table table-sm table-vcenter mb-0">
                     <thead>
                        <tr>
                           <th>{{ __('Service', 'grcmanager') }}</th>
                           <th>{{ __('Image', 'grcmanager') }}</th>
                           <th>{{ __('Origin', 'grcmanager') }}</th>
                           <th>{{ __('Replicas', 'grcmanager') }}</th>
                           <th>{{ __('Ports', 'grcmanager') }}</th>
                        </tr>
                     </thead>
                     <tbody>
                        {% for r in conf.rows %}
                           <tr>
                              <td>
                                 {% if r.url %}<a href="{{ r.url }}">{{ r.service }}</a>{% else %}{{ r.service }}{% endif %}
                                 {% if r.stack %}<span class="text-muted">({{ r.stack }})</span>{% endif %}
                              </td>
                              <td>
                                 <code>{{ r.image }}{% if r.tag %}:{{ r.tag }}{% endif %}</code>
                                 {% if r.digest %}
                                    <small class="d-block text-muted" title="{{ __('Fingerprint', 'grcmanager') }}">
                                       <i class="ti ti-fingerprint me-1"></i>{{ r.digest }}</small>
                                 {% endif %}
                              </td>
                              <td>
                                 <span class="badge bg-{{ r.provenance.color }}-lt">
                                    <i class="{{ r.provenance.icon }} me-1"></i>{{ r.provenance.label }}</span>
                              </td>
                              <td><span class="badge {{ r.replicas_ok ? 'bg-green-lt' : 'bg-yellow-lt' }}">{{ r.replicas }}</span></td>
                              <td>
                                 {% for p in r.ports %}<span class="badge bg-azure-lt me-1">{{ p }}</span>
                                 {% else %}<span class="text-muted">-</span>{% endfor %}
                              </td>
                           </tr>
                        {% endfor %}
                     </tbody>
                  </table>
               </div>
               {% if conf.total > conf.rows|length %}
                  <small class="text-muted d-block">
                     {{- __('%1$d services: the first %2$d are shown.', 'grcmanager')|format(conf.total, conf.rows|length) -}}
                  </small>
               {% endif %}
            {% endif %}
         {% endif %}

         {% if docker.changes is defined %}
            {% set chg = docker.changes %}
            <div class="mb-1" data-docker-section="changes">
               <span class="badge {{ chg.total > 0 ? 'bg-blue-lt' : 'bg-secondary-lt' }} me-1"><i class="ti ti-git-commit me-1"></i>
                  {{- __('%1$d version change(s) observed over the last %2$d days', 'grcmanager')|format(chg.total, chg.days) }}</span>
            </div>
            {% if chg.rows is not empty %}
               <ul class="mb-1">
                  {% for r in chg.rows %}
                     <li>
                        <span class="text-muted">{{ r.date|formatted_datetime }}</span>
                        {% if r.url %}<a href="{{ r.url }}">{{ r.service }}</a>{% else %}{{ r.service }}{% endif %}
                        {% if r.stack %}<span class="text-muted">({{ r.stack }})</span>{% endif %} :
                        <code>{{ r.old }}</code> <i class="ti ti-arrow-right"></i> <code>{{ r.new }}</code>
                        <span class="badge bg-azure-lt">{{ r.kind_label }}</span>
                     </li>
                  {% endfor %}
               </ul>
               {% if chg.total > chg.rows|length %}
                  <small class="text-muted d-block">
                     {{- __('%1$d changes: the %2$d most recent are shown.', 'grcmanager')|format(chg.total, chg.rows|length) -}}
                  </small>
               {% endif %}
            {% endif %}
         {% endif %}
         <small class="form-hint d-block mt-1">
            {{- __('Read live from the Docker inventory plugin, on your active entities and within your rights there. Read only: nothing is changed.', 'grcmanager') -}}
         </small>
         </div>
      {% endset %}
      {{ fields.htmlField('', docker_html, __('Docker inventory evidence', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

