{# Mesure de l'Annexe A dans la SoA (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% macro referentials_hint(text, url) %}
   <small class="form-hint d-block mt-1">{{ text }} <a href="{{ url }}">{{ __('the Reference frameworks screen', 'grcmanager') }}</a> {{ __('for details.', 'grcmanager') }}</small>
{% endmacro %}

{% block form_fields %}
   {{ fields.htmlField('', '<strong>' ~ code|e ~ '</strong>', __('Control', 'grcmanager')) }}
   {{ fields.htmlField('', theme_badge, __('Theme', 'grcmanager')) }}
   {{ fields.htmlField('', title|e, _x('label', 'Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.dropdownArrayField('applicability', item.fields['applicability'] ?: 'yes', applicabilities, __('Applicability', 'grcmanager')) }}
   {{ fields.dropdownArrayField('implementation_status', item.fields['implementation_status'] ?: 'not_started', implementation_statuses, __('Implementation status', 'grcmanager')) }}
   {{ fields.textareaField('justification', item.fields['justification'], __('Justification', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Required if the control is not fully applicable.', 'grcmanager')),
   }) }}
   {# Registre sensible : champ absent sans son droit (les liens existants sont conservés). #}
   {% if can_view_risks %}
   {{ fields.dropdownArrayField('linked_risks', null, risks, __('Linked risks', 'grcmanager'), {
      'multiple': true,
      'values': linked_risks,
      'full_width': true,
      'add_field_html': hints.hint(__('Risk(s) from the register justifying or driving this control\'s implementation.', 'grcmanager')),
   }) }}
   {% endif %}

   {# Correspondance publiée par le NIST (ROADMAP « Version 2.2 ») : ligne absente si le NIST n'en publie aucune. #}
   {% if nist is not empty %}
      {% set nist_html %}
         {% for c in nist %}<span class="badge bg-blue-lt me-1">NIST CSF {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Mapping published by NIST: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', nist_html, __('Equivalent reference frameworks', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issues #110 et #111 : correspondances indicatives établies par ce projet. #}
   {% if nis2 is not empty %}
      {% set nis2_html %}
         {% for c in nis2 %}<span class="badge bg-purple-lt me-1">NIS2 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', nis2_html, __('NIS2 requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : exigences DORA, correspondance indicative établie par ce projet. #}
   {% if dora is not empty %}
      {% set dora_html %}
         {% for c in dora %}<span class="badge bg-indigo-lt me-1">DORA {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', dora_html, __('DORA requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : objectifs ISO/IEC 27701 (vie privée), correspondance indicative établie par ce projet. #}
   {% if iso27701 is not empty %}
      {% set iso27701_html %}
         {% for c in iso27701 %}<span class="badge bg-pink-lt me-1">ISO 27701 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', iso27701_html, __('ISO 27701 objectives', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : articles ISO 22301 (continuité), correspondance indicative établie par ce projet. #}
   {% if iso22301 is not empty %}
      {% set iso22301_html %}
         {% for c in iso22301 %}<span class="badge bg-orange-lt me-1">ISO 22301 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', iso22301_html, __('ISO 22301 requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : groupes ISO/IEC 42001 (IA), correspondance indicative établie par ce projet. #}
   {% if iso42001 is not empty %}
      {% set iso42001_html %}
         {% for c in iso42001 %}<span class="badge bg-teal-lt me-1">ISO 42001 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', iso42001_html, __('ISO 42001 control groups', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : exigences PCI DSS, correspondance indicative établie par ce projet. #}
   {% if pci_dss is not empty %}
      {% set pci_dss_html %}
         {% for c in pci_dss %}<span class="badge bg-lime-lt me-1">PCI DSS {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', pci_dss_html, __('PCI DSS requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : critères SOC 2, correspondance indicative établie par ce projet. #}
   {% if soc2 is not empty %}
      {% set soc2_html %}
         {% for c in soc2 %}<span class="badge bg-purple-lt me-1">SOC 2 {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', soc2_html, __('SOC 2 criteria', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : articles de l'AI Act, correspondance indicative établie par ce projet. #}
   {% if ai_act is not empty %}
      {% set ai_act_html %}
         {% for c in ai_act %}<span class="badge bg-cyan-lt me-1">AI Act {{ __('Art. %s', 'grcmanager')|format(c) }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', ai_act_html, __('AI Act articles', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #379 : exigences HDS v2.0, correspondance indicative établie par ce projet. #}
   {% if hds is not empty %}
      {% set hds_html %}
         {% for c in hds %}<span class="badge bg-pink-lt me-1">HDS {{ c }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', hds_html, __('HDS requirements', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {% if anssi is not empty %}
      {% set anssi_html %}
         {% for m in anssi %}<span class="badge bg-teal-lt me-1" title="{{ m.title }}">{{ __('Measure %d', 'grcmanager')|format(m.number) }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', anssi_html, __('ANSSI hygiene', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
   {# Issue #143 : contrôles CIS, correspondance indicative établie par ce projet. #}
   {% if cis is not empty %}
      {% set cis_html %}
         {% for c in cis %}<span class="badge bg-orange-lt me-1" title="{{ c.title }}">CIS {{ c.number }}</span>{% endfor %}
         {{ _self.referentials_hint(__('Indicative mapping made by this project: see', 'grcmanager'), referentials_url) }}
      {% endset %}
      {{ fields.htmlField('', cis_html, __('CIS Controls v8', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #109 et assetsign #204 : preuves issues d'assetsign, ligne absente si le plugin n'est pas actif. #}
   {% if assetsign_sheets is not empty or assetsign_charter is not null %}
      {% set assetsign_html %}
         {% for s in assetsign_sheets %}
            <div class="mb-1"><strong>{{ s.label }}</strong> :
               <span class="badge bg-green-lt me-1"><i class="ti ti-check me-1"></i>{{ __('%d signed', 'grcmanager')|format(s.signed) }}</span>
               <span class="badge bg-yellow-lt me-1"><i class="ti ti-hourglass me-1"></i>{{ __('%d pending', 'grcmanager')|format(s.pending) }}</span>
               <span class="badge bg-red-lt me-1"><i class="ti ti-clock-x me-1"></i>{{ __('%d expired', 'grcmanager')|format(s.expired) }}</span>
               {% if s.url %} <a href="{{ s.url }}">{{ __('View forms', 'grcmanager') }}</a>{% endif %}
            </div>
         {% endfor %}
         {% if assetsign_charter is not null %}
            <div class="mb-1"><strong>{{ __('Signed IT charter', 'grcmanager') }}</strong> :
               {% if assetsign_charter is empty %}<span class="text-muted">{{ __('no charter campaign launched', 'grcmanager') }}</span>{% endif %}
            </div>
            {% if assetsign_charter is not empty %}
               <ul class="mb-1">
                  {% for line in assetsign_charter %}
                     <li>{{ line.entity }} : <span class="badge {{ line.rate >= 90 ? 'bg-green-lt' : (line.rate >= 60 ? 'bg-yellow-lt' : 'bg-red-lt') }} me-1">{{ __('%1$d / %2$d (%3$d %%)', 'grcmanager')|format(line.signed, line.total, line.rate) }}</span><span class="text-muted">{{ line.campaign }}</span></li>
                  {% endfor %}
               </ul>
               {% if campaigns_url %}<a href="{{ campaigns_url }}">{{ __('View campaigns', 'grcmanager') }}</a>{% endif %}
            {% endif %}
         {% endif %}
         <small class="form-hint d-block mt-1">{{ __('Counters computed live from the assetsign plugin, on your active entities.', 'grcmanager') }}</small>
      {% endset %}
      {{ fields.htmlField('', assetsign_html, __('assetsign evidence', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #368 : couverture Wazuh, lue en direct dans le plugin Wazuh ; ligne absente s'il n'est pas exploitable. #}
   {% if wazuh is not null %}
      {% set wazuh_html %}
         <div class="mb-1">
            <span class="badge bg-blue-lt me-1"><i class="ti ti-heartbeat me-1"></i>{{ __('%1$d active agent(s) out of %2$d', 'grcmanager')|format(wazuh.active, wazuh.agents) }}</span>
            {% if wazuh.rate is null %}
               <span class="text-muted">{{ __('no computer in your entities', 'grcmanager') }}</span>
            {% else %}
               <span class="badge {{ wazuh.rate >= 90 ? 'bg-green-lt' : (wazuh.rate >= 60 ? 'bg-yellow-lt' : 'bg-red-lt') }} me-1"><i class="ti ti-device-desktop me-1"></i>{{ __('%1$d of %2$d computers covered (%3$s %%)', 'grcmanager')|format(wazuh.covered, wazuh.computers, wazuh.rate|number_format(1, ',')) }}</span>
            {% endif %}
            {% if wazuh_agents_url %}<a href="{{ wazuh_agents_url }}">{{ __('View agents', 'grcmanager') }}</a>{% endif %}
         </div>
         <small class="form-hint d-block">{{ __('Read live from the Wazuh plugin: a computer is covered when an active agent is linked to it.', 'grcmanager') }}</small>
      {% endset %}
      {{ fields.htmlField('', wazuh_html, __('Wazuh coverage', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
{% endblock %}
