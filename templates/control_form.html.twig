      {{ fields.htmlField('', patch_compliance_html, __('Security patches', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #781 : conformité de configuration (A.8.9), une ligne par source (OpenSCAP d'abord). #}
   {% if configuration_compliance is defined and configuration_compliance is not null %}
      {% set configuration_compliance_html %}
         {% include '@grcmanager/_configuration_evidence.html.twig' with {'sources': configuration_compliance.sources} only %}
      {% endset %}
      {{ fields.htmlField('', configuration_compliance_html, __('Configuration compliance', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #853 : couverture de la journalisation (A.8.15, A.8.16, A.8.17), dans les entités de la personne. #}
   {% if log_coverage is defined and log_coverage is not null %}
      {% set log_coverage_html %}
         <div id="grc-log-coverage-evidence">
            {% set log_color = log_coverage.rate is null ? 'secondary' : (log_coverage.rate >= 95 ? 'success' : (log_coverage.rate >= 80 ? 'warning' : 'danger')) %}
            <span class="badge bg-{{ log_color }}-subtle text-{{ log_color }}-emphasis me-1"><i class="ti ti-file-search me-1"></i>{{ log_coverage.rate is null ? __('Logging coverage: not measured', 'grcmanager') : __('Logging coverage: %d%%', 'grcmanager')|format(log_coverage.rate) }}</span>
            <span class="badge {{ log_coverage.critical_uncovered > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-alert-octagon me-1"></i>{{ __('%d critical asset(s) without logging', 'grcmanager')|format(log_coverage.critical_uncovered) }}</span>
            {% if log_coverage.stale > 0 %}<span class="badge bg-warning-subtle text-warning-emphasis me-1"><i class="ti ti-clock-pause me-1"></i>{{ __('%d asset(s) whose logs stopped', 'grcmanager')|format(log_coverage.stale) }}</span>{% endif %}
            <span class="badge {{ log_coverage.retention_gaps > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-archive me-1"></i>{{ __('%d platform(s) with a retention too short or not declared', 'grcmanager')|format(log_coverage.retention_gaps) }}</span>
            {% if log_coverage.ntp_missing > 0 %}<span class="badge bg-warning-subtle text-warning-emphasis me-1"><i class="ti ti-clock-exclamation me-1"></i>{{ __('%d platform(s) without declared clock synchronization', 'grcmanager')|format(log_coverage.ntp_missing) }}</span>{% endif %}
            <span class="small text-muted me-2">{{ __('Computed on %s', 'grcmanager')|format(log_coverage.date) }}</span>
            <a href="{{ log_coverage.url }}">{{ __('View the details', 'grcmanager') }}</a>
         </div>
      {% endset %}
      {{ fields.htmlField('', log_coverage_html, __('Logging coverage', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #843 : contrôleurs de gestion des serveurs (A.8.2, A.8.9, A.8.22), dans les entités de la personne. #}
   {% if server_management is defined and server_management is not null %}
      {% set server_management_html %}
         {% include '@grcmanager/_server_management_evidence.html.twig' with {'evidence': server_management} only %}
      {% endset %}
      {{ fields.htmlField('', server_management_html, __('Server management controllers', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #604 : simulations d'hameçonnage (A.6.3), taux agrégés et tendance. #}
   {% if phishing is defined and phishing is not null %}
      {% set phishing_html %}
         {% include '@grcmanager/_phishing_summary.html.twig' with {'summary': phishing} only %}
      {% endset %}
      {{ fields.htmlField('', phishing_html, __('Phishing simulations', 'grcmanager'), {'full_width': true}) }}
   {% endif %}

   {# Issue #835 : audit de sécurité de l'Active Directory (PingCastle), dernier rapport de chaque domaine. #}
   {% if ad_security_audit is defined and ad_security_audit is not null %}
      {% set ad_security_audit_html %}
         <div id="grc-ad-audit-evidence">
            {% for d in ad_security_audit.domains %}
               {% set ad_color = d.level == 'good' ? 'success' : (d.level == 'watch' ? 'warning' : 'danger') %}
               <div class="mb-1">
                  <i class="ti ti-sitemap me-1 text-muted"></i><a href="{{ d.url }}">{{ d.domain }}</a>
                  <span class="badge bg-{{ ad_color }}-subtle text-{{ ad_color }}-emphasis ms-1">{{ __('Score: %d/100', 'grcmanager')|format(d.score) }}</span>
                  <span class="badge {{ d.rules > 0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success-emphasis' }} ms-1"><i class="ti ti-list-details me-1"></i>{{ _n('%d rule concerns this control', '%d rules concern this control', d.rules, 'grcmanager')|format(d.rules) }}</span>
                  <span class="small text-muted ms-1">{{ __('Report of %s', 'grcmanager')|format(d.date) }}</span>
               </div>
            {% endfor %}
         </div>
      {% endset %}
      {{ fields.htmlField('', ad_security_audit_html, __('Active Directory security audit', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
{% endblock %}
