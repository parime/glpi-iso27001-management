{# Issue #608 : en tête du registre du contexte, question du changement climatique et ajouts. #}
<div class="alert {{ climate.answered ? 'alert-success' : 'alert-warning' }} d-flex align-items-center flex-wrap gap-2">
   <i class="ti ti-temperature me-1"></i>
   <div class="me-auto">
      <strong>{{ __('Climate change', 'grcmanager') }} :</strong>
      {% if climate.answered %}
         {{ __('the question is answered (%s).', 'grcmanager')|format(climate.relevance) }}
      {% else %}
         {{ __('say whether climate change is a relevant issue for your ISMS, and why. Required before requirement 4.1 can be marked compliant.', 'grcmanager') }}
      {% endif %}
   </div>
   {% if climate.answered or can_create %}
      <a href="{{ climate.url }}" class="btn btn-sm {{ climate.answered ? 'btn-outline-secondary' : 'btn-warning' }}">
         {{ climate.answered ? __('Open the answer', 'grcmanager') : __('Answer the question', 'grcmanager') }}
      </a>
   {% endif %}
</div>
<div class="d-flex justify-content-end mb-2 gap-2 flex-wrap">
   {# Lot 2 : registre complet pour l'auditeur (enjeux, parties, liens, revues). #}
   <a href="{{ export_pdf }}" class="btn btn-outline-primary btn-sm"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Register for the auditor (PDF)', 'grcmanager') }}</a>
   <a href="{{ export_csv }}" class="btn btn-outline-primary btn-sm"><i class="ti ti-file-spreadsheet me-1"></i>{{ __('Register (CSV)', 'grcmanager') }}</a>
   {% if can_create %}
      <a href="{{ form_url }}?kind={{ kind_issue }}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-world me-1"></i>{{ __('Add an issue', 'grcmanager') }}</a>
      <a href="{{ form_url }}?kind={{ kind_party }}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-users-group me-1"></i>{{ __('Add an interested party', 'grcmanager') }}</a>
   {% endif %}
</div>
