{# Issue #160 : vulnérabilités du parc : CVE touchant les versions installées des logiciels surveillés #}
<div class="container-fluid">
   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <h2 class="mb-0"><i class="ti ti-bug me-1"></i>{{ __('Fleet vulnerabilities', 'grcmanager') }}</h2>
      {% if can_update and summary.enabled %}
         <form method="post" action="{{ action }}" class="d-inline ms-auto">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <button type="submit" name="sync_now" value="1" class="btn btn-outline-secondary" title="{{ __('Checks two pending versions right away; the automatic action checks the others.', 'grcmanager') }}"><i class="ti ti-refresh me-1"></i>{{ __('Check now', 'grcmanager') }}</button>
         </form>
      {% endif %}
   </div>

   {% if not summary.enabled %}
      <div class="alert alert-warning">
         <i class="ti ti-plug-connected-x me-1"></i>{{ __('NVD queries are disabled: no version is checked.', 'grcmanager') }}
         <a href="{{ config_url }}">{{ __('Enable NVD enrichment in the plugin configuration', 'grcmanager') }}</a>
      </div>
   {% endif %}

   {# Issue #485 : rapport des vulnérabilités par e-mail. #}
   <p class="text-muted small mb-2">
      <i class="ti ti-mail-bolt me-1"></i>
      {% if digest.frequency %}
         {{ __('Report by email: %1$s, next one on %2$s.', 'grcmanager')|format(digest.frequency|lower, digest.next) }}
      {% else %}
         {{ __('No report by email.', 'grcmanager') }}
      {% endif %}
      {% if can_update %}<a href="{{ config_url }}">{{ __('Set it up', 'grcmanager') }}</a>{% endif %}
   </p>

   <div class="row row-cards mb-3">
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="text-muted">{{ __('Watched software', 'grcmanager') }}</div>
         <div class="h2 mb-0">{{ summary.watched }}</div>
      </div></div></div>
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="text-muted">{{ __('Installed versions checked', 'grcmanager') }}</div>
         <div class="h2 mb-0">{{ summary.checked }} / {{ summary.versions - summary.unqueryable }}</div>
      </div></div></div>
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="text-muted" title="{{ __('Unreadable version number in the inventory: check it manually.', 'grcmanager') }}">{{ __('Versions to check manually', 'grcmanager') }}</div>
         <div class="h2 mb-0">{{ summary.unqueryable }}</div>
      </div></div></div>
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="text-muted">{{ __('CISA KEV catalog updated', 'grcmanager') }}</div>
         <div class="h2 mb-0">{{ summary.kev_refreshed ? summary.kev_refreshed|formatted_datetime : __('Never', 'grcmanager') }}</div>
      </div></div></div>
   </div>

   {# Issue #601 : délais de correction par niveau et indicateurs de respect (A.8.8). #}
   {% if remediation %}
   <div class="card mb-3" id="grc-remediation">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-calendar-time me-2"></i>{{ __('Remediation deadlines', 'grcmanager') }}</h3>
         {% if can_config %}<a class="ms-auto small" href="{{ config_url }}#grc-remediation-settings"><i class="ti ti-settings me-1"></i>{{ __('Change the deadlines', 'grcmanager') }}</a>{% endif %}
      </div>
      <div class="card-body">
         <div class="row row-cards mb-3">
            <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
               <div class="text-muted" title="{{ __('Open vulnerabilities not overdue and vulnerabilities fixed on time, out of all those open or fixed over the period. A vulnerability covered by a waiver in progress counts as within the deadline.', 'grcmanager') }}">{{ __('Within the deadline', 'grcmanager') }} <i class="ti ti-info-circle"></i></div>
               <div class="h2 mb-0 {{ remediation.compliance is null ? '' : (remediation.compliance >= 90 ? 'text-green' : (remediation.compliance >= 70 ? 'text-orange' : 'text-red')) }}">{{ remediation.compliance is null ? '-' : remediation.compliance ~ ' %' }}</div>
            </div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
               <div class="text-muted">{{ __('Fixed on time (last %d days)', 'grcmanager')|format(remediation.window_days) }}</div>
               <div class="h2 mb-0">{{ remediation.rate is null ? '-' : remediation.rate ~ ' %' }}</div>
               <div class="small text-muted">
                  {% if remediation.previous_rate is not null and remediation.rate is not null %}
                     {% if remediation.rate > remediation.previous_rate %}<i class="ti ti-trending-up text-green me-1"></i>{% elseif remediation.rate < remediation.previous_rate %}<i class="ti ti-trending-down text-red me-1"></i>{% else %}<i class="ti ti-minus me-1"></i>{% endif %}
                     {{ __('previous period: %d %%', 'grcmanager')|format(remediation.previous_rate) }}
                  {% else %}
                     {{ __('%d fixed', 'grcmanager')|format(remediation.fixed) }}
                  {% endif %}
               </div>
            </div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
               <div class="text-muted">{{ __('Overdue vulnerabilities', 'grcmanager') }}</div>
               <div class="h2 mb-0 {{ remediation.overdue > 0 ? 'text-red' : 'text-green' }}">{{ remediation.overdue }}</div>
               <div class="small text-muted">
                  {% if remediation.oldest_overdue is not null %}{{ __('oldest: %1$d days late, average %2$d', 'grcmanager')|format(remediation.oldest_overdue, remediation.average_overdue) }}{% else %}{{ __('%d due soon', 'grcmanager')|format(remediation.due_soon) }}{% endif %}
               </div>
            </div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
               <div class="text-muted">{{ __('Mean time to remediate', 'grcmanager') }}</div>
               <div class="h2 mb-0">{{ remediation.mttr is null ? '-' : __('%s days', 'grcmanager')|format(remediation.mttr|number_format(1, ',')) }}</div>
               <div class="small text-muted">{{ __('%d covered by a waiver', 'grcmanager')|format(remediation.waived) }}</div>
            </div></div></div>
         </div>
         <div class="table-responsive">
            <table class="table table-sm table-vcenter mb-0">
               <thead>
                  <tr>
                     <th>{{ __('Level', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Deadline', 'grcmanager') }}</th>
                     <th class="text-end">{{ _x('vulnerabilities', 'Open', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Overdue', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Fixed (last %d days)', 'grcmanager')|format(remediation.window_days) }}</th>
                     <th class="text-end">{{ __('Fixed on time', 'grcmanager') }}</th>
                  </tr>
               </thead>
               <tbody>
               {% for level, counts in remediation.by_level %}
                  <tr>
                     <td>{{ counts.label }}</td>
                     <td class="text-end">{{ __('%d days', 'grcmanager')|format(counts.days) }}</td>
                     <td class="text-end">{{ counts.open }}</td>
                     <td class="text-end">{% if counts.overdue > 0 %}<span class="badge bg-red text-white">{{ counts.overdue }}</span>{% else %}0{% endif %}</td>
                     <td class="text-end">{{ counts.fixed }}</td>
                     <td class="text-end">{{ counts.rate is null ? '-' : counts.rate ~ ' %' }}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
         <p class="text-muted small mt-2 mb-0"><i class="ti ti-info-circle me-1"></i>{{ __('The deadline runs from the first detection by the plugin. A vulnerability that is no longer found in the fleet counts as fixed. A waiver in progress replaces the deadline by its end date. Nothing is changed automatically.', 'grcmanager') }}</p>
      </div>
   </div>
   {% elseif can_config %}
      <p class="text-muted small mb-3"><i class="ti ti-calendar-time me-1"></i>{{ __('No remediation deadline policy: set a deadline per level to track overdue vulnerabilities.', 'grcmanager') }} <a href="{{ config_url }}#grc-remediation-settings">{{ __('Set the deadlines', 'grcmanager') }}</a></p>
   {% endif %}

   <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <div class="btn-group" role="group">
         <a class="btn {{ priority_only or overdue_only ? 'btn-outline-primary' : 'btn-primary' }}" href="{{ action }}">{{ _x('feminine', 'All', 'grcmanager') }}</a>
         <a class="btn {{ priority_only ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ action }}?priority=1">{{ __('Priority', 'grcmanager') }}</a>
         {% if remediation %}<a class="btn {{ overdue_only ? 'btn-primary' : 'btn-outline-primary' }}" href="{{ action }}?overdue=1"><i class="ti ti-alarm me-1"></i>{{ __('Overdue', 'grcmanager') }}</a>{% endif %}
      </div>
      <span class="text-muted small">{{ __('Priority: actively exploited (CISA KEV), CVSS of at least 9 or exploitation probability (EPSS) of at least 50%.', 'grcmanager') }}</span>
   </div>

   {% if total > rows|length %}
      <div class="alert alert-secondary py-2">
         <i class="ti ti-list-numbers me-1"></i>{{ __('%1$d vulnerabilities: the %2$d highest-priority ones are shown.', 'grcmanager')|format(total, rows|length) }}
      </div>
   {% endif %}

   <div class="card">
      {% if rows is empty %}
         <div class="card-body text-muted">
            {% if summary.watched == 0 %}
               <i class="ti ti-arrow-right me-1"></i>{{ __('Start by choosing the software to watch.', 'grcmanager') }}
               <a href="{{ watch_url }}?filter=exposed">{{ __('See exposed software', 'grcmanager') }}</a>
            {% else %}
               <i class="ti ti-circle-check me-1 text-green"></i>{{ __('No known vulnerability for the versions already checked.', 'grcmanager') }}
            {% endif %}
         </div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead>
                  <tr>
                     <th>{{ __('CVE', 'grcmanager') }}</th>
                     <th>{{ __('Software', 'grcmanager') }}</th>
                     <th>{{ __('Affected versions', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Machines', 'grcmanager') }}</th>
                     <th>{{ __('CVSS', 'grcmanager') }}</th>
                     <th>{{ __('EPSS', 'grcmanager') }}</th>
                     <th>{{ __('Exploited', 'grcmanager') }}</th>
                     <th>{{ __('Published', 'grcmanager') }}</th>
                     {% if remediation %}<th>{{ __('Remediation deadline', 'grcmanager') }}</th>{% endif %}
                     <th>{{ __('Ticket', 'grcmanager') }}</th>
                  </tr>
               </thead>
               <tbody>
               {% for row in rows %}
                  {% set cvss_class = row.cvss is null ? 'bg-secondary-lt' : (row.cvss >= 9 ? 'bg-red text-white' : (row.cvss >= 7 ? 'bg-orange text-white' : (row.cvss >= 4 ? 'bg-yellow text-dark' : 'bg-green-lt'))) %}
                  <tr>
                     <td class="text-nowrap">
                        {% if row.priority %}<i class="ti ti-alert-triangle text-red me-1" title="{{ _x('singular', 'Priority', 'grcmanager') }}"></i>{% endif %}
                        <a href="https://nvd.nist.gov/vuln/detail/{{ row.cve_id }}" target="_blank" rel="noopener">{{ row.cve_id }}</a>
                        {% if wazuh and wazuh.also[row.cve_id] is defined %}
                           <div><span class="badge bg-blue-lt" title="{{ __('Also detected by the Wazuh agents', 'grcmanager') }}"><i class="ti ti-heartbeat me-1"></i>{{ __('Wazuh: %d computer(s)', 'grcmanager')|format(wazuh.also[row.cve_id]) }}</span></div>
                        {% endif %}
                     </td>
                     <td>
                        {# Issue #580 : fiche du logiciel dans l'inventaire (un lien par logiciel regroupé sous ce produit). #}
                        {% if row.software_links|length == 1 %}
                           <a href="{{ row.software_links[0].url }}" title="{{ __('Open the software in the inventory', 'grcmanager') }}"><i class="ti ti-apps me-1"></i>{{ row.product }}</a>
                        {% else %}
                           {{ row.product }}
                           {% for link in row.software_links %}
                              <div class="small"><a href="{{ link.url }}" title="{{ __('Open the software in the inventory', 'grcmanager') }}"><i class="ti ti-apps me-1"></i>{{ link.name }}</a></div>
                           {% endfor %}
                        {% endif %}
                        {% if row.certfr %}<a href="{{ row.certfr.link }}" target="_blank" rel="noopener" class="badge bg-orange-lt ms-1" title="{{ row.certfr.title }}"><i class="ti ti-alert-octagon me-1"></i>CERT-FR</a>{% endif %}
                        {% if row.description %}<div class="text-muted small text-truncate" style="max-width: 22rem" title="{{ row.description }}">{{ row.description }}</div>{% endif %}
                     </td>
                     {# Issue #580 : chaque version ouvre la liste des machines qui l'ont installée. #}
                     <td>
                        {% for v in row.version_links %}
                           {% for link in v.links %}
                              <a href="{{ link.url }}" class="badge bg-azure-lt me-1 mb-1" title="{{ __('Computers where %s is installed', 'grcmanager')|format(link.name ~ ' ' ~ v.version) }}"><i class="ti ti-device-desktop me-1"></i>{{ v.version }}</a>
                           {% else %}
                              <span class="badge bg-azure-lt me-1 mb-1">{{ v.version }}</span>
                           {% endfor %}
                        {% endfor %}
                     </td>
                     <td class="text-end"><strong>{{ row.machines }}</strong></td>
                     <td><span class="badge {{ cvss_class }}">{{ row.cvss is null ? __('n/a', 'grcmanager') : row.cvss|number_format(1, ',') }}</span></td>
                     <td class="text-nowrap">{{ row.epss is null ? '-' : (row.epss * 100)|number_format(1, ',') ~ ' %' }}</td>
                     <td class="text-nowrap">
                        {% if row.is_kev %}
                           <span class="badge bg-red text-white" title="{{ __('CISA catalog of known exploited vulnerabilities', 'grcmanager') }}"><i class="ti ti-flame me-1"></i>KEV</span>
                           {% if row.ransomware %}<span class="badge bg-dark text-white ms-1">{{ __('Ransomware', 'grcmanager') }}</span>{% endif %}
                        {% else %}
                           <span class="text-muted">-</span>
                        {% endif %}
                     </td>
                     <td class="text-nowrap">{{ row.published ? row.published|formatted_date : '' }}</td>
                     {% if remediation %}
                     <td class="text-nowrap">
                        {% set r = row.remediation %}
                        {% if r %}
                           <span class="badge {{ r.badge.class }}" title="{{ __('Deadline %1$s (%2$s: %3$d days)', 'grcmanager')|format(r.sla_due|formatted_date, r.level_label, r.deadline) }}"><i class="{{ r.badge.icon }} me-1"></i>{{ r.badge.label }}</span>
                           {% if r.critical %}<span class="badge bg-purple-lt ms-1" title="{{ __('Installed on an asset with a high C/I/A classification: shorter deadline.', 'grcmanager') }}"><i class="ti ti-shield-lock"></i></span>{% endif %}
                           <div class="small text-muted">{{ __('Detected on %s', 'grcmanager')|format(r.first_seen|formatted_date) }}</div>
                           {% if r.waiver and r.waiver.url %}
                              <div class="small"><a href="{{ r.waiver.url }}"><i class="ti ti-file-alert me-1"></i>{{ r.waiver.name }}</a></div>
                           {% elseif r.status == 'overdue' and waiver_new_url %}
                              <div class="small"><a href="{{ waiver_new_url }}?cve_ids={{ row.cve_id|url_encode }}" title="{{ __('If the vulnerability cannot be fixed in time, document the exception and its compensating controls.', 'grcmanager') }}"><i class="ti ti-file-plus me-1"></i>{{ __('Request a waiver', 'grcmanager') }}</a></div>
                           {% endif %}
                        {% else %}
                           <span class="text-muted small">{{ __('Tracked from the next check', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                     {% endif %}
                     <td class="text-nowrap">
                        {% if row.tickets_id %}
                           <a href="{{ config('root_doc') }}/front/ticket.form.php?id={{ row.tickets_id }}">#{{ row.tickets_id }}</a>
                        {% elseif can_ticket %}
                           <form method="post" action="{{ action }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="canonical_id" value="{{ row.canonical_id }}">
                              <button type="submit" name="create_ticket" value="1" class="btn btn-sm btn-outline-secondary" title="{{ __('Create the software update ticket', 'grcmanager') }}"><i class="ti ti-ticket"></i></button>
                           </form>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Issue #368 : CVE vues par les agents Wazuh et absentes de la veille ci-dessus (sans doublon). #}
   {% if wazuh %}
   <div class="card mt-3" id="grc-wazuh-vulnerabilities">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-heartbeat me-2"></i>{{ __('Detected by Wazuh only', 'grcmanager') }}</h3>
      </div>
      {% if wazuh.only is empty %}
         <div class="card-body text-muted"><i class="ti ti-circle-check me-1 text-green"></i>{{ __('Wazuh reports no vulnerability beyond those listed above.', 'grcmanager') }}</div>
      {% else %}
         <div class="card-body pb-0">
            <p class="text-muted small mb-2">{{ __('Vulnerabilities seen by the Wazuh agents on your computers and not found by the software watch. Read only, from the Wazuh plugin.', 'grcmanager') }}</p>
            {% if wazuh.total > wazuh.only|length %}<p class="small">{{ __('%1$d vulnerabilities: the %2$d highest-priority ones are shown.', 'grcmanager')|format(wazuh.total, wazuh.only|length) }}</p>{% endif %}
         </div>
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead>
                  <tr>
                     <th>{{ __('CVE', 'grcmanager') }}</th>
                     <th>{{ __('Packages', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Machines', 'grcmanager') }}</th>
                     <th>{{ __('CVSS', 'grcmanager') }}</th>
                     <th>{{ __('EPSS', 'grcmanager') }}</th>
                     <th>{{ __('Exploited', 'grcmanager') }}</th>
                  </tr>
               </thead>
               <tbody>
               {% for row in wazuh.only %}
                  {% set cvss_class = row.score is null ? 'bg-secondary-lt' : (row.score >= 9 ? 'bg-red text-white' : (row.score >= 7 ? 'bg-orange text-white' : (row.score >= 4 ? 'bg-yellow text-dark' : 'bg-green-lt'))) %}
                  <tr>
                     <td class="text-nowrap">
                        {% if row.priority %}<i class="ti ti-alert-triangle text-red me-1" title="{{ _x('singular', 'Priority', 'grcmanager') }}"></i>{% endif %}
                        <a href="https://nvd.nist.gov/vuln/detail/{{ row.cve_id }}" target="_blank" rel="noopener">{{ row.cve_id }}</a>
                     </td>
                     <td>{% for p in row.packages %}<span class="badge bg-azure-lt me-1">{{ p }}</span>{% endfor %}</td>
                     <td class="text-end"><strong>{{ row.machines }}</strong></td>
                     <td><span class="badge {{ cvss_class }}">{{ row.score is null ? (row.severity ?: __('n/a', 'grcmanager')) : row.score|number_format(1, ',') }}</span></td>
                     <td class="text-nowrap">{{ row.epss is null ? '-' : (row.epss * 100)|number_format(1, ',') ~ ' %' }}</td>
                     <td class="text-nowrap">
                        {% if row.is_kev %}
                           <span class="badge bg-red text-white" title="{{ __('CISA catalog of known exploited vulnerabilities', 'grcmanager') }}"><i class="ti ti-flame me-1"></i>KEV</span>
                        {% else %}
                           <span class="text-muted">-</span>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>
   {% endif %}
</div>
