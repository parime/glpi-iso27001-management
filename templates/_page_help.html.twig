{# Encadré « À quoi sert cette page ? » des écrans du menu GRC & Conformité (repliable, choix retenu par page). #}
{% set help_id = 'grc-help-' ~ page %}
<div class="container-fluid mt-2 mb-2">
   <div class="card border-info-subtle" style="max-width: 1100px;">
      <div class="card-body py-2">
         <a class="d-flex align-items-center text-decoration-none" data-bs-toggle="collapse" href="#{{ help_id }}" role="button" aria-expanded="true" aria-controls="{{ help_id }}">
            <i class="ti ti-help-circle text-info me-2"></i><strong>{{ __('À quoi sert cette page ?', 'grcmanager') }}</strong>
            <i class="ti ti-chevron-down ms-auto"></i>
         </a>
         <div class="collapse show" id="{{ help_id }}">
            <p class="mb-1 mt-2">{{ purpose }}</p>
            <p class="mb-1"><i class="ti ti-checklist me-1 text-muted"></i><strong>{{ __('Ce qui est attendu', 'grcmanager') }} :</strong> {{ expected }}</p>
            {% if reference is defined and reference %}
               <p class="mb-0 small text-muted"><i class="ti ti-book me-1"></i>{{ reference }}</p>
            {% endif %}
         </div>
      </div>
   </div>
</div>
<script>
   (function () {
      const key = 'grcmanager.help.{{ page }}';
      const panel = document.getElementById('{{ help_id }}');
      try {
         if (window.localStorage.getItem(key) === 'hidden') {
            panel.classList.remove('show');
         }
         panel.addEventListener('hidden.bs.collapse', function () { window.localStorage.setItem(key, 'hidden'); });
         panel.addEventListener('shown.bs.collapse', function () { window.localStorage.removeItem(key); });
      } catch (e) {
         // Stockage du navigateur indisponible : l'encadré reste simplement ouvert.
      }
   })();
</script>
