{# Issue #837 : vue « Sécurité 360° » de l'actif (onglet de l'ordinateur ou du matériel réseau), lecture seule. #}
{% set level = levels[score.level] %}
<div id="grc-security-360" class="p-2">
   <div class="alert alert-info d-flex align-items-start gap-2">
      <i class="ti ti-help-circle fs-2"></i>
      <div>
         <strong>{{ __('What is this page for?', 'grcmanager') }}</strong>
         {{ __('This tab brings together, for this asset, every security source known to the plugin: vulnerabilities, encryption, configuration, management controller, incidents, risks. Each line gives its state and a link to the detail. Nothing is changed: fix the gaps from the detail pages.', 'grcmanager') }}
      </div>
   </div>

   <div class="card mb-3">
      <div class="card-body d-flex flex-wrap align-items-center gap-3">
         <span class="badge bg-{{ level.color }}-subtle text-{{ level.color }}-emphasis fs-3 px-3 py-2">
            <i class="{{ level.icon }} me-1"></i>{{ level.label }}
         </span>
         {% if score.score is not null %}
            <div class="fs-2 fw-bold">{{ __('Score: %s / 100', 'grcmanager')|format(score.score) }}</div>
         {% endif %}
         <div class="small text-muted flex-fill">
            {% if score.score is null %}
               {{ __('No source assessed for this asset yet: import or read the data of the security modules to fill this view.', 'grcmanager') }}
            {% else %}
               {{ __('%1$d sources assessed: %2$d critical, %3$d to watch.', 'grcmanager')|format(score.evaluated, score.critical, score.warning) }}
               {{ __('The score is the weighted average of the sources (compliant 100, to watch 50, critical 0); good from %1$d, to improve from %2$d, weak below. A single critical source prevents the good level.', 'grcmanager')|format(good_from, fair_from) }}
            {% endif %}
         </div>
      </div>
   </div>

   {% if sources is not empty %}
      <div class="table-responsive">
         <table class="table table-vcenter card-table">
            <thead>
               <tr>
                  <th>{{ __('Source', 'grcmanager') }}</th>
                  <th>{{ __('State', 'grcmanager') }}</th>
                  <th>{{ __('Summary', 'grcmanager') }}</th>
                  <th class="text-end">{{ __('Points (weight)', 'grcmanager') }}</th>
                  <th></th>
               </tr>
            </thead>
            <tbody>
               {% for source in sources %}
                  {% set info = statuses[source.status] %}
                  <tr>
                     <td class="text-nowrap"><i class="{{ source.icon }} me-1"></i>{{ source.label }}</td>
                     <td><span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis"><i class="{{ info.icon }} me-1"></i>{{ info.label }}</span></td>
                     <td>
                        {{ source.summary }}
                        {% if source.facts is not empty %}
                           <div class="small text-muted">{{ source.facts|join(' · ') }}</div>
                        {% endif %}
                     </td>
                     <td class="text-end text-nowrap">{{ source.points is null ? '-' : source.points ~ ' (×' ~ source.weight ~ ')' }}</td>
                     <td class="text-end">
                        {% if source.url %}<a href="{{ source.url }}" class="text-nowrap"><i class="ti ti-arrow-right me-1"></i>{{ __('View the details', 'grcmanager') }}</a>{% endif %}
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}
   <div class="small text-muted mt-2"><i class="ti ti-eye-off me-1"></i>{{ __('Sources without data for this asset (module not used, nothing imported, no right) are not shown.', 'grcmanager') }}</div>
</div>
