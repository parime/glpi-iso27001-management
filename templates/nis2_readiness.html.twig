{# Issue #1158 : parcours de mise en conformité NIS2, mêmes composants que la préparation à la
   certification ISO 27001 (score, compteurs, prochaine étape, étapes par groupe). Chaque critère
   cite l'article de la directive (UE) 2022/2555, renvoie vers l'écran à compléter et donne son
   chemin dans le menu. #}
{% set evaluated = summary.evaluated %}
{% set done_width = evaluated > 0 ? (summary.counts.done * 100 / evaluated)|round : 0 %}
{% set partial_width = evaluated > 0 ? (summary.counts.partial * 100 / evaluated)|round : 0 %}
<div class="container-fluid my-2" id="grc-nis2-readiness">
   <div class="row g-3">
      <div class="col-md-6 col-xl-4">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-route me-2"></i>{{ __('NIS2 compliance score', 'grcmanager') }}</h3></div>
            <div class="card-body">
               <div class="display-6 fw-bold text-{{ summary.color }}" id="grc-nis2-score">{{ summary.score is null ? '-' : summary.score ~ ' / 100' }}</div>
               <div class="progress progress-lg my-2" role="progressbar" aria-label="{{ __('NIS2 compliance score', 'grcmanager') }}" aria-valuenow="{{ summary.score ?? 0 }}" aria-valuemin="0" aria-valuemax="100">
                  <div class="progress-bar bg-success" style="width: {{ done_width }}%" title="{{ styles.done.label }}"></div>
                  <div class="progress-bar bg-warning" style="width: {{ partial_width }}%" title="{{ styles.partial.label }}"></div>
               </div>
               <p class="text-muted small mb-0">{{ __('A criterion met counts fully, a criterion partly met counts half. Criteria outside your rights are not counted.', 'grcmanager') }}</p>
            </div>
         </div>
      </div>
      <div class="col-md-6 col-xl-4">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-list-numbers me-2"></i>{{ __('Criteria', 'grcmanager') }}</h3></div>
            <div class="card-body">
               <div class="d-flex flex-wrap gap-2 mb-3">
                  {% for key, style in styles %}
                     {% if key != 'locked' or summary.counts.locked > 0 %}
                        <span class="badge {{ style.class }} fs-5 grc-nis2-count" data-status="{{ key }}"><i class="ti {{ style.icon }} me-1"></i>{{ style.label }} : {{ summary.counts[key] }}</span>
                     {% endif %}
                  {% endfor %}
               </div>
               <p class="small text-muted mb-2">{{ __('Each state is computed from the data already entered in the plugin, each time you open this page. Nothing is changed automatically.', 'grcmanager') }}</p>
               <div class="d-flex flex-wrap gap-2">
                  <a class="btn btn-sm btn-outline-secondary" href="{{ directive_url }}" target="_blank" rel="noopener noreferrer" id="grc-nis2-directive"><i class="ti ti-external-link me-1"></i>{{ __('Directive (EU) 2022/2555 on EUR-Lex', 'grcmanager') }}</a>
                  {% if iso_url %}
                     <a class="btn btn-sm btn-ghost-secondary" href="{{ iso_url }}"><i class="ti ti-certificate me-1"></i>{{ __('Certification readiness', 'grcmanager') }}</a>
                  {% endif %}
               </div>
            </div>
         </div>
      </div>
      <div class="col-xl-4">
         <div class="card h-100 {{ summary.next ? 'border-primary' : 'border-success' }}">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-flag me-2"></i>{{ __('Next step', 'grcmanager') }}</h3></div>
            <div class="card-body" id="grc-nis2-next">
               {% if summary.next %}
                  <p class="mb-1"><strong>{{ summary.next.number }}. {{ summary.next.title }}</strong>
                     <span class="badge {{ summary.next.style.class }} ms-1"><i class="ti {{ summary.next.style.icon }} me-1"></i>{{ summary.next.style.label }}</span></p>
                  <p class="small text-muted mb-2">{{ summary.next.expected }}</p>
                  {% if summary.next.links is not empty %}
                     {% set first = summary.next.links|first %}
                     <a class="btn btn-sm btn-primary" href="{{ first.url }}"><i class="ti {{ first.icon }} me-1"></i>{{ first.label }}</a>
                  {% endif %}
               {% elseif summary.evaluated > 0 %}
                  <p class="mb-0"><span class="badge bg-success-subtle text-success-emphasis fs-5"><i class="ti ti-confetti me-1"></i>{{ __('Every criterion is met.', 'grcmanager') }}</span></p>
               {% else %}
                  <p class="text-muted mb-0">{{ __('No criterion can be evaluated with your rights.', 'grcmanager') }}</p>
               {% endif %}
            </div>
         </div>
      </div>
   </div>

   {% if not recyf_enabled %}
      <div class="alert alert-info mt-3 mb-0" id="grc-nis2-recyf-off">
         <i class="ti ti-info-circle me-1"></i>{{ __('The ReCyF of the ANSSI (NIS2 France) is not enabled: its measures, the missing evidence and the entity category are not followed here. Enable it in the frameworks of the plugin configuration if you are concerned.', 'grcmanager') }}
      </div>
   {% endif %}

   {% for phase in phases %}
      <div class="card mt-3 grc-nis2-group" data-group="{{ phase.key }}">
         <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h3 class="card-title mb-0"><i class="ti {{ phase.icon }} me-2"></i>{{ phase.label }}</h3>
            <span class="text-muted small">{{ phase.summary }}</span>
            <span class="ms-auto d-flex gap-1">
               {% for key in ['done', 'partial', 'todo'] %}
                  {% if phase.counts[key] > 0 %}
                     <span class="badge {{ styles[key].class }}" title="{{ styles[key].label }}"><i class="ti {{ styles[key].icon }} me-1"></i>{{ phase.counts[key] }}</span>
                  {% endif %}
               {% endfor %}
            </span>
         </div>
         <div class="list-group list-group-flush">
            {% for step in phase.steps %}
               <div class="list-group-item grc-nis2-criterion {{ step.next ? 'border-start border-primary border-3' }}" id="grc-nis2-{{ step.key }}" data-criterion="{{ step.key }}" data-status="{{ step.status }}">
                  <div class="d-flex flex-wrap align-items-center gap-2">
                     <span class="avatar avatar-sm rounded-circle {{ step.style.class }} fw-bold">{{ step.number }}</span>
                     <i class="ti {{ step.icon }} text-muted"></i>
                     <strong>{{ step.title }}</strong>
                     <span class="badge bg-secondary-subtle text-secondary-emphasis grc-nis2-article" title="{{ __('Directive (EU) 2022/2555', 'grcmanager') }}"><i class="ti ti-scale me-1"></i>{{ __('NIS2, art. %s', 'grcmanager')|format(step.articles) }}</span>
                     {% if step.next %}
                        <span class="badge bg-primary-subtle text-primary-emphasis"><i class="ti ti-flag me-1"></i>{{ __('Next step', 'grcmanager') }}</span>
                     {% endif %}
                     <span class="ms-auto badge {{ step.style.class }} fs-5"><i class="ti {{ step.style.icon }} me-1"></i>{{ step.style.label }}</span>
                  </div>
                  <p class="small mt-2 mb-1"><i class="ti ti-checklist me-1 text-muted"></i><strong>{{ __('What is expected', 'grcmanager') }} :</strong> {{ step.expected }}</p>
                  {% if step.status == 'locked' %}
                     <p class="small text-muted mb-0"><i class="ti ti-lock me-1"></i>{{ __('Your profile cannot read the data of this criterion: ask an administrator of the management system.', 'grcmanager') }}</p>
                  {% else %}
                     <ul class="small mb-1 ps-4">
                        {% for fact in step.facts %}
                           <li>{{ fact }}</li>
                        {% endfor %}
                     </ul>
                     <div class="d-flex flex-wrap gap-3">
                        {% for link in step.links %}
                           <div class="grc-nis2-link">
                              <a class="btn btn-sm {{ loop.first ? 'btn-outline-primary' : 'btn-ghost-secondary' }}" href="{{ link.url }}"{% if link.path == '' %} target="_blank" rel="noopener noreferrer"{% endif %}><i class="ti {{ link.icon }} me-1"></i>{{ link.label }}</a>
                              {% if link.path %}
                                 <div class="small text-muted mt-1"><i class="ti ti-menu-2 me-1"></i>{{ __('Menu:', 'grcmanager') }} {{ link.path }}</div>
                              {% endif %}
                           </div>
                        {% endfor %}
                     </div>
                  {% endif %}
               </div>
            {% endfor %}
         </div>
      </div>
   {% endfor %}
</div>
