{# Issue #836 : cadre de preuve de la supervision lue dans Zabbix (mesures A.8.16, A.8.6 et A.5.30), dans les
   entités de la personne. Reçoit « evidence » (ZabbixMonitoring::evidence()), affiché par control_form.html.twig. #}
<div id="grc-zabbix-evidence">
   {% if evidence.code == 'A.8.16' %}
      {% set zbx_color = evidence.rate is null ? 'secondary' : (evidence.rate >= 95 ? 'success' : (evidence.rate >= 80 ? 'warning' : 'danger')) %}
      <span class="badge bg-{{ zbx_color }}-subtle text-{{ zbx_color }}-emphasis me-1"><i class="ti ti-activity-heartbeat me-1"></i>{{ evidence.rate is null ? __('Monitored assets: not measured', 'grcmanager') : __('Monitored assets: %d%%', 'grcmanager')|format(evidence.rate) }}</span>
      <span class="badge {{ evidence.critical_uncovered > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-eye-off me-1"></i>{{ __('Critical assets not monitored: %d', 'grcmanager')|format(evidence.critical_uncovered) }}</span>
      <span class="badge {{ evidence.open_high > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-alert-octagon me-1"></i>{{ __('Open high-severity problems: %d', 'grcmanager')|format(evidence.open_high) }}</span>
      <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-circle-check me-1"></i>{{ __('High-severity problems resolved: %d', 'grcmanager')|format(evidence.resolved_high) }}</span>
   {% elseif evidence.code == 'A.8.6' %}
      <span class="badge {{ evidence.capacity_assets > 0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-gauge me-1"></i>{{ __('Assets with a saturation: %d', 'grcmanager')|format(evidence.capacity_assets) }}</span>
      <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-database me-1"></i>{{ __('Disk, memory or processor problems: %d', 'grcmanager')|format(evidence.capacity) }}</span>
   {% else %}
      {% if evidence.lowest_sli is not null %}<span class="badge {{ evidence.services_below > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-chart-line me-1"></i>{{ __('Lowest service availability: %s %%', 'grcmanager')|format(evidence.lowest_sli|number_format(2)) }}</span>{% endif %}
      <span class="badge {{ evidence.services_below > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-target-arrow me-1"></i>{{ __('Services below their objective: %d', 'grcmanager')|format(evidence.services_below) }}</span>
      <span class="badge {{ evidence.rto_gaps > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-clock-exclamation me-1"></i>{{ __('Outages longer than the RTO: %d', 'grcmanager')|format(evidence.rto_gaps) }}</span>
   {% endif %}
   <span class="small text-muted me-2">{{ __('Over %1$d days, read from Zabbix on %2$s', 'grcmanager')|format(evidence.period_days, evidence.date) }}</span>
   <a href="{{ evidence.url }}">{{ __('View the details', 'grcmanager') }}</a>
</div>
