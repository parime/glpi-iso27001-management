{# Issue #1185 : alertes Wazuh récentes, regroupées par règle et ordinateur, à transformer en
   incidents de sécurité sur choix explicite (lecture seule du plugin Wazuh). Inclus par
   edr_import.html.twig ; reçoit `wazuh` (WazuhAlertImport::reviewData()) et `action`. #}
{% set level_badges = {'high': 'bg-red text-white', 'medium': 'bg-orange-lt', 'low': 'bg-secondary-lt', 'unknown': 'bg-secondary-lt'} %}
<div class="card mb-3" id="grc-wazuh-review">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-heartbeat me-2"></i>{{ __('Wazuh alerts to review', 'grcmanager') }}</h3>
    <div class="card-actions">
      <form method="get" action="{{ action }}#grc-wazuh-review" class="d-flex align-items-center gap-2">
        <label for="grc-wazuh-level" class="small text-muted mb-0">{{ __('Minimum rule level', 'grcmanager') }}</label>
        <select name="wazuh_level" id="grc-wazuh-level" class="form-select form-select-sm w-auto">
          {% for value, label in wazuh.levels %}
            <option value="{{ value }}" {{ value == wazuh.min_level ? 'selected' : '' }}>{{ label }}</option>
          {% endfor %}
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="ti ti-filter me-1"></i>{{ __('Filter', 'grcmanager') }}</button>
      </form>
    </div>
  </div>
  {% if wazuh.rows is empty %}
    <div class="card-body text-muted">
      <i class="ti ti-circle-check me-1 text-green"></i>{{ __('No new Wazuh alert at this level in the last %d days.', 'grcmanager')|format(wazuh.days) }}
    </div>
  {% else %}
    <form method="post" action="{{ action }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <div class="card-body pb-0">
        <p class="text-muted small mb-2">{{ __('Alerts of the last %d days on the computers you can see, read from the Wazuh plugin. Repeated alerts (same rule on the same computer) are grouped. Tick the groups that deserve a security incident: each one becomes an incident with its computer, rule level, agent, dates and MITRE ATT&CK techniques; new repetitions are added to the incident while it stays open. Nothing is changed in Wazuh.', 'grcmanager')|format(wazuh.days) }}</p>
        {% if wazuh.total > wazuh.rows|length %}<p class="small">{{ __('%1$d groups: the %2$d highest levels are shown.', 'grcmanager')|format(wazuh.total, wazuh.rows|length) }}</p>{% endif %}
      </div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead>
            <tr>
              <th class="w-1"><input type="checkbox" class="form-check-input" aria-label="{{ __('Select all', 'grcmanager') }}" onclick="this.closest('table').querySelectorAll('input[name=&quot;wazuh_groups[]&quot;]').forEach(function (box) { box.checked = this.checked; }, this);"></th>
              <th>{{ __('Rule', 'grcmanager') }}</th>
              <th>{{ __('Level', 'grcmanager') }}</th>
              <th class="text-end">{{ __('Alerts', 'grcmanager') }}</th>
              <th>{{ __('Last alert', 'grcmanager') }}</th>
              <th>{{ __('Computer', 'grcmanager') }}</th>
              <th>{{ __('Agent', 'grcmanager') }}</th>
            </tr>
          </thead>
          <tbody>
          {% for row in wazuh.rows %}
            {% set box_id = 'grc-wazuh-' ~ loop.index %}
            <tr>
              <td><input type="checkbox" class="form-check-input" name="wazuh_groups[]" value="{{ row.key }}" id="{{ box_id }}" aria-label="{{ row.description ?: row.rule_id }}"></td>
              <td>
                <label for="{{ box_id }}" class="mb-0">{{ row.description ?: '-' }}</label>
                {% if row.rule_id %}<span class="text-muted small">({{ row.rule_id }})</span>{% endif %}
                {% if row.repeated %}<div><span class="badge bg-blue-subtle text-blue-emphasis">{{ __('Already in an incident: new repetitions', 'grcmanager') }}</span></div>{% endif %}
              </td>
              <td><span class="badge {{ level_badges[row.severity] ?? 'bg-secondary-lt' }}">{{ row.level ?? '?' }}</span></td>
              <td class="text-end"><strong>{{ row.count }}</strong></td>
              <td class="text-nowrap">{{ row.last }}{% if row.count > 1 %}<div class="small text-muted">{{ __('since %s', 'grcmanager')|format(row.first) }}</div>{% endif %}</td>
              <td>
                <a href="{{ row.computer_url }}"><i class="ti ti-device-desktop me-1"></i>{{ row.computer }}</a>
                <div><a href="{{ row.alerts_url }}" class="small"><i class="ti ti-external-link me-1"></i>{{ __('Alerts in Wazuh', 'grcmanager') }}</a></div>
              </td>
              <td>{{ row.agent ?: '-' }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <button type="submit" name="wazuh_import" value="1" class="btn btn-primary"><i class="ti ti-shield-plus me-1"></i>{{ __('Create the incidents of the selected groups', 'grcmanager') }}</button>
      </div>
    </form>
  {% endif %}
</div>
