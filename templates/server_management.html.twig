{# Issue #843 : contrôleurs de gestion des serveurs (iLO, iDRAC, XClarity, IPMI), entités de la personne.
   Redfish en lecture seule ; le mot de passe n'est jamais réaffiché. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% macro stat_card(id, icon, color, value, title, help) %}
   <div class="col-sm-6 col-lg"><div class="card card-sm h-100"><div class="card-body">
      <div class="d-flex align-items-center">
         <span class="badge bg-{{ color }}-subtle text-{{ color }}-emphasis me-2 fs-3"><i class="{{ icon }}"></i></span>
         <div>
            <div class="fw-bold fs-3" id="{{ id }}">{{ value }}</div>
            <div class="small">{{ title }}</div>
         </div>
      </div>
      {% if help %}<div class="small text-muted mt-1">{{ help }}</div>{% endif %}
   </div></div></div>
{% endmacro %}
{% macro gap_badges(gap_infos, gaps) %}
   {% for gap in gaps %}
      {% set info = gap_infos[gap] %}
      <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-1 mb-1" title="{{ info.help }}" data-gap="{{ gap }}"><i class="{{ info.icon }} me-1"></i>{{ info.label }}</span>
   {% else %}
      <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-circle-check me-1"></i>{{ __('No gap found', 'grcmanager') }}</span>
   {% endfor %}
{% endmacro %}
{% macro health_badge(health) %}
   {% if health == 'OK' %}
      <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-heart me-1"></i>{{ __('Healthy', 'grcmanager') }}</span>
   {% elseif health == 'Warning' %}
      <span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-heartbeat me-1"></i>{{ __('Warning', 'grcmanager') }}</span>
   {% elseif health == 'Critical' %}
      <span class="badge bg-danger-subtle text-danger-emphasis"><i class="ti ti-heart-broken me-1"></i>{{ __('Critical', 'grcmanager') }}</span>
   {% else %}
      <span class="text-muted">-</span>
   {% endif %}
{% endmacro %}

<div id="grc-bmc">
   {% set s = summary %}
   <div class="row row-cards mb-3">
      {{ _self.stat_card('grc-bmc-total', 'ti ti-server-cog', s.controllers > 0 ? 'azure' : 'secondary', s.controllers, __('Controllers', 'grcmanager'), __('%d read at least once', 'grcmanager')|format(s.read)) }}
      {{ _self.stat_card('grc-bmc-high', 'ti ti-alert-octagon', s.high > 0 ? 'danger' : 'success', s.high, __('Controllers with a serious gap', 'grcmanager'), __('IPMI over the network, default account, exposure...', 'grcmanager')) }}
      {{ _self.stat_card('grc-bmc-default', 'ti ti-user-exclamation', s.gaps.default_account > 0 ? 'danger' : 'success', s.gaps.default_account, __('Default account still enabled', 'grcmanager'), __('%d administrator account(s) in all', 'grcmanager')|format(s.admin_accounts)) }}
      {{ _self.stat_card('grc-bmc-exposed', 'ti ti-route-off', s.gaps.outside_admin_network > 0 ? 'danger' : (s.admin_networks == 0 ? 'secondary' : 'success'), s.admin_networks == 0 ? '-' : s.gaps.outside_admin_network, __('Outside the administration networks', 'grcmanager'), s.admin_networks == 0 ? __('No administration network declared', 'grcmanager') : __('%d administration network(s) declared', 'grcmanager')|format(s.admin_networks)) }}
      {{ _self.stat_card('grc-bmc-without', 'ti ti-server-off', s.servers_without > 0 ? 'warning' : 'success', s.servers_without, __('Physical servers without a known controller', 'grcmanager'), s.coverage is null ? __('No physical server in GLPI', 'grcmanager') : __('Coverage: %d%%', 'grcmanager')|format(s.coverage)) }}
   </div>

   <div class="alert alert-info d-flex align-items-start gap-2 mb-3">
      <i class="ti ti-shield-lock fs-2"></i>
      <div>{{ __('Read only: the plugin only sends Redfish read requests (GET). It never restarts a server, never updates a firmware and never changes a setting. Use a local account of the controller with the read-only role.', 'grcmanager') }}</div>
   </div>
   {% if s.admin_networks == 0 %}
      <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" id="grc-bmc-no-admin-network">
         <i class="ti ti-route fs-2"></i>
         <div>{{ __('No administration network is declared in the network flow matrix: the exposure of the controllers cannot be checked. Write the address range in the source or the destination of a flow whose name says it is an administration zone (for example "MGMT 10.0.99.0/24" or "OOB iLO 192.0.2.0/24").', 'grcmanager') }} <a href="{{ flows_url }}">{{ __('Open the network flow matrix', 'grcmanager') }}</a></div>
      </div>
   {% endif %}
   {% if can_manage and not allow_private %}
      <div class="alert alert-secondary d-flex align-items-start gap-2 mb-3">
         <i class="ti ti-network fs-2"></i>
         <div>{{ __('Controllers usually have an internal address, which the plugin refuses by default. To read them, allow internal addresses in the plugin configuration page.', 'grcmanager') }} <a href="{{ config_url }}">{{ __('Outgoing connections', 'grcmanager') }}</a>{% if glpi12_hint %}<div class="small mt-1">{{ glpi12_hint }}</div>{% endif %}</div>
      </div>
   {% endif %}

   {# Contrôleurs : écarts graves d'abord. #}
   <div class="card mb-3" id="grc-bmc-list">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-server-cog me-2"></i>{{ __('Controllers and their gaps', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_rows }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('A controller is matched with a computer of GLPI by the serial number of the server, or by the server chosen by hand. Gaps are only reported: nothing is changed on the controller. Hover a gap to see what to do.', 'grcmanager') }}</div>
      {% if rows is empty %}
         <div class="card-body text-muted" id="grc-bmc-empty">{{ __('No controller yet: declare one below, or import a CSV file for controllers with IPMI only.', 'grcmanager') }}</div>
      {% else %}
         {% if total_rows > rows|length %}
            <div class="card-body small pb-0">{{ __('%1$d controllers: the first %2$d are shown, serious gaps first.', 'grcmanager')|format(total_rows, rows|length) }}</div>
         {% endif %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Controller', 'grcmanager') }}</th>
                  <th>{{ __('Server in GLPI', 'grcmanager') }}</th>
                  <th>{{ __('Firmware and BIOS', 'grcmanager') }}</th>
                  <th>{{ __('Health', 'grcmanager') }}</th>
                  <th>{{ __('Gaps', 'grcmanager') }}</th>
                  <th>{{ __('Last reading', 'grcmanager') }}</th>
                  {% if can_manage %}<th></th>{% endif %}
               </tr></thead>
               <tbody>
               {% for row in rows %}
                  <tr id="grc-bmc-{{ row.id }}">
                     <td>
                        <span class="fw-bold">{{ row.name }}</span>
                        <div class="small text-muted">{{ [row.vendor, row.manager_model]|filter(v => v)|join(' · ') ?: '-' }}</div>
                        <div class="small text-muted">{{ row.url ?: row.ip_address }}</div>
                        {% if row.is_redfish %}
                           <span class="badge bg-blue-subtle text-blue-emphasis"><i class="ti ti-api me-1"></i>Redfish</span>
                           {% if row.allow_self_signed %}<span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-certificate me-1"></i>{{ __('Self-signed accepted', 'grcmanager') }}</span>{% endif %}
                        {% else %}
                           <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-file-spreadsheet me-1"></i>{{ __('CSV import', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                     <td>
                        {% if row.computer %}
                           <a href="{{ row.computer.url }}">{{ row.computer.name }}</a>
                           <div class="small text-muted">{{ row.matched_by == 'manual' ? __('Chosen by hand', 'grcmanager') : __('By serial number', 'grcmanager') }}</div>
                        {% else %}
                           <span class="text-muted">-</span>
                        {% endif %}
                        {% if row.serial %}<div class="small text-muted">{{ __('Serial number: %s', 'grcmanager')|format(row.serial) }}</div>{% endif %}
                     </td>
                     <td class="small">
                        <div>{{ __('Controller: %s', 'grcmanager')|format(row.firmware_version ?: '-') }}</div>
                        <div>{{ __('BIOS: %s', 'grcmanager')|format(row.bios_version ?: '-') }}</div>
                        {% if row.cert_expiry %}<div class="text-muted">{{ __('Certificate until %s', 'grcmanager')|format(row.cert_expiry) }}</div>{% endif %}
                     </td>
                     <td>{{ _self.health_badge(row.health) }}</td>
                     <td>{{ _self.gap_badges(gap_infos, row.gaps) }}</td>
                     <td class="small">
                        {{ row.date_read ?: '-' }}
                        {% if row.read_error %}<div class="text-danger"><i class="ti ti-alert-triangle me-1"></i>{{ row.read_error }}</div>{% endif %}
                     </td>
                     {% if can_manage %}
                        <td class="text-nowrap">
                           <form method="post" action="{{ action }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              {% if row.is_redfish %}
                                 <button type="submit" class="btn btn-sm btn-primary mb-1" name="read_bmc" value="{{ row.id }}"><i class="ti ti-refresh me-1"></i>{{ __('Read now', 'grcmanager') }}</button>
                                 <a class="btn btn-sm btn-outline-secondary mb-1" href="{{ action }}?edit={{ row.id }}#grc-bmc-form"><i class="ti ti-pencil me-1"></i>{{ __('Edit') }}</a>
                              {% endif %}
                              <button type="submit" class="btn btn-sm btn-outline-danger mb-1" name="delete_bmc" value="{{ row.id }}" onclick="return confirm('{{ __('Delete this controller and its accounts read?', 'grcmanager')|e('js') }}');"><i class="ti ti-trash me-1"></i>{{ __('Delete') }}</button>
                           </form>
                        </td>
                     {% endif %}
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Comptes locaux des contrôleurs : revue des accès privilégiés (A.8.2). #}
   <div class="card mb-3" id="grc-bmc-accounts">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-users me-2"></i>{{ __('Local accounts of the controllers', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ s.accounts }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Accounts read on each controller, to review in the privileged access review: an account of a controller gives full control of the server, even switched off.', 'grcmanager') }}</div>
      {% set has_accounts = false %}
      <div class="table-responsive">
         <table class="table table-vcenter card-table">
            <thead><tr>
               <th>{{ __('Controller', 'grcmanager') }}</th>
               <th>{{ __('Account', 'grcmanager') }}</th>
               <th>{{ __('Role', 'grcmanager') }}</th>
               <th>{{ __('State', 'grcmanager') }}</th>
            </tr></thead>
            <tbody>
            {% for row in rows %}
               {% for account in row.accounts %}
                  {% set has_accounts = true %}
                  <tr>
                     <td>{{ row.name }}</td>
                     <td>
                        {{ account.username }}
                        {% if account.default and account.enabled %}<span class="badge bg-danger-subtle text-danger-emphasis ms-1"><i class="ti ti-user-exclamation me-1"></i>{{ __('Default account', 'grcmanager') }}</span>{% endif %}
                     </td>
                     <td>
                        {% if account.admin %}<span class="badge bg-orange-subtle text-orange-emphasis"><i class="ti ti-crown me-1"></i>{{ account.role }}</span>{% else %}{{ account.role ?: '-' }}{% endif %}
                     </td>
                     <td>
                        {% if not account.enabled %}
                           <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-user-off me-1"></i>{{ __('Disabled', 'grcmanager') }}</span>
                        {% elseif account.locked %}
                           <span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-lock me-1"></i>{{ __('Locked', 'grcmanager') }}</span>
                        {% else %}
                           <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-user-check me-1"></i>{{ __('Enabled', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
            {% endfor %}
            {% if not has_accounts %}
               <tr><td colspan="4" class="text-muted">{{ __('No account read yet.', 'grcmanager') }}</td></tr>
            {% endif %}
            </tbody>
         </table>
      </div>
   </div>

   {# Serveurs physiques sans contrôleur connu. #}
   <div class="card mb-3" id="grc-bmc-without">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-server-off me-2"></i>{{ __('Physical servers without a known controller', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_without }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Computers of GLPI seen as servers (type or operating system) and not virtual (model or manufacturer), for which no controller is declared. A controller nobody knows is never updated nor reviewed.', 'grcmanager') }}</div>
      {% if servers_without is empty %}
         <div class="card-body text-muted">{{ __('Every physical server has a known controller.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Server', 'grcmanager') }}</th>
                  <th>{{ __('Type') }}</th>
                  <th>{{ __('Model') }}</th>
                  <th>{{ __('Serial number') }}</th>
               </tr></thead>
               <tbody>
               {% for server in servers_without %}
                  <tr>
                     <td><a href="{{ server.url }}">{{ server.name }}</a></td>
                     <td>{{ server.type ?: '-' }}</td>
                     <td>{{ server.model ?: '-' }}</td>
                     <td>{{ server.serial ?: '-' }}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {% if can_manage %}
      {# Déclaration ou modification d'un contrôleur lu par Redfish. #}
      <div class="card mb-3" id="grc-bmc-form">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-{{ edit ? 'pencil' : 'plus' }} me-2"></i>{{ edit ? __('Edit the controller %s', 'grcmanager')|format(edit.name) : __('Declare a controller read by Redfish', 'grcmanager') }}</h3>
         </div>
         <form method="post" action="{{ action }}" autocomplete="off">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="bmc_id" value="{{ edit ? edit.id : 0 }}">
            <div class="card-body">
               <div class="small text-muted mb-3">{{ __('The controller is saved in the entity %s. Create on the controller a local account with the read-only role (ReadOnly): the plugin only reads.', 'grcmanager')|format(entity_name) }}</div>
               <div class="row g-3">
                  <div class="col-md-6">
                     <label class="form-label" for="grc-bmc-name">{{ __('Name') }}</label>
                     <input type="text" class="form-control" id="grc-bmc-name" name="bmc_name" value="{{ edit ? edit.name : '' }}" maxlength="255" required placeholder="{{ __('For example: iLO of srv-db-01', 'grcmanager') }}">
                  </div>
                  <div class="col-md-6">
                     <label class="form-label" for="grc-bmc-url">{{ __('Address of the controller', 'grcmanager') }}</label>
                     <input type="text" class="form-control" id="grc-bmc-url" name="bmc_url" value="{{ edit ? edit.url : '' }}" maxlength="255" required placeholder="https://ilo-srv-db-01.example.test">
                     <div class="form-hint">{{ __('https:// only, with the name or the IP address of the controller and an optional port.', 'grcmanager') }}</div>
                  </div>
                  <div class="col-md-6">
                     <label class="form-label" for="grc-bmc-username">{{ __('Account (read only)', 'grcmanager') }}</label>
                     <input type="text" class="form-control" id="grc-bmc-username" name="bmc_username" value="{{ edit ? edit.username : '' }}" maxlength="255" required autocomplete="off">
                  </div>
                  <div class="col-md-6">
                     <label class="form-label" for="grc-bmc-password">{{ __('Password') }}</label>
                     <input type="password" class="form-control" id="grc-bmc-password" name="bmc_password" value="" autocomplete="new-password" {{ edit and edit.has_password ? '' : 'required' }} placeholder="{{ edit and edit.has_password ? __('Password saved (leave empty to keep it)', 'grcmanager') : '' }}">
                     <div class="form-hint">{{ __('Encrypted by GLPI and never shown again. If you change the address or the account, enter it again.', 'grcmanager') }}</div>
                  </div>
                  <div class="col-md-6">
                     <label class="form-label">{{ __('Server in GLPI (optional)', 'grcmanager') }}</label>
                     {{ fields.dropdownField('Computer', 'computers_id', edit ? edit.computers_id : 0, '', {'no_label': true, 'aria_label': __('Server in GLPI (optional)', 'grcmanager'), 'display_emptychoice': true}) }}
                     <div class="form-hint">{{ __('Leave empty to match the server by its serial number.', 'grcmanager') }}</div>
                  </div>
                  <div class="col-md-6">
                     <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="grc-bmc-self-signed" name="bmc_allow_self_signed" value="1" {{ edit and edit.allow_self_signed ? 'checked' : '' }}>
                        <label class="form-check-label" for="grc-bmc-self-signed">{{ __('Accept a self-signed certificate for this controller', 'grcmanager') }}</label>
                     </div>
                     <div class="form-hint">{{ __('Off by default. When ticked, the identity of the controller is not verified: prefer a certificate of your certification authority.', 'grcmanager') }}</div>
                  </div>
               </div>
            </div>
            <div class="card-footer">
               <button type="submit" class="btn btn-primary" name="save_bmc" value="1"><i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}</button>
               {% if edit %}<a class="btn btn-outline-secondary ms-2" href="{{ action }}#grc-bmc-list">{{ __('Cancel') }}</a>{% endif %}
            </div>
         </form>
      </div>

      {# Import CSV des contrôleurs sans Redfish. #}
      <div class="card mb-3" id="grc-bmc-import">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-file-import me-2"></i>{{ __('Import controllers without Redfish (CSV)', 'grcmanager') }}</h3>
         </div>
         <form method="post" action="{{ action }}" enctype="multipart/form-data">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div class="card-body">
               <div class="small text-muted mb-2">{{ __('For controllers with IPMI only, or an export of a manufacturer tool. One line per controller; a controller already imported with the same name is updated. Columns (header line, separator ; or ,):', 'grcmanager') }}</div>
               <div class="small mb-2"><code>name;address;vendor;model;firmware;bios;serial;ipmi_lan;telnet;snmp_v1v2;weak_tls;secure_boot;accounts</code></div>
               <div class="small text-muted mb-3">{{ __('Only "name" is required. Yes/no columns accept yes, no, oui, non, 1, 0 (empty: unknown). Accounts: user:role separated by ";" inside the cell, for example "root:Administrator;audit:ReadOnly", ":disabled" for a disabled account. Maximum size: %s.', 'grcmanager')|format(max_bytes_label) }}</div>
               <label class="form-label" for="grc-bmc-file">{{ __('CSV file', 'grcmanager') }}</label>
               <input type="file" class="form-control" id="grc-bmc-file" name="bmc_file" accept=".csv,text/csv,text/plain" required>
            </div>
            <div class="card-footer">
               <button type="submit" class="btn btn-primary" name="import_bmc" value="1"><i class="ti ti-upload me-1"></i>{{ __('Import', 'grcmanager') }}</button>
            </div>
         </form>
      </div>
   {% endif %}
</div>
