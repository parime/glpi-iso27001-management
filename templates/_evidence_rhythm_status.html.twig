{# Issue #886 : fraîcheur d'une preuve récurrente (badge et prochaine échéance calculée) #}
{% if rhythm.next_due %}
   <div class="small mt-1">
      <span class="badge {{ rhythm.class }}"><i class="ti ti-repeat me-1"></i>{{ rhythm.label }}</span>
      {{ __('Next due: %s', 'grcmanager')|format(rhythm.next_due|formatted_date) }}
      {% if rhythm.reference and not rhythm.last_collected %}
         <span class="text-muted">({{ __('from the document date %s', 'grcmanager')|format(rhythm.reference|formatted_date) }})</span>
      {% endif %}
   </div>
{% endif %}
