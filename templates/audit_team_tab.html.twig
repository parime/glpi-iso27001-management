{# Issue #140 : équipe d'un audit interne, seule audience de ses documents. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
<p class="text-muted">
  {{ __('Only team members can read the documents of the audit and its findings, even with the GLPI Documents right. Auditees can read them but cannot add anything.', 'grcmanager') }}
  {% if ciso_group %}
    {{ __('The CISO group (%s) can access them too.', 'grcmanager')|format(ciso_group) }}
  {% else %}
    {{ __('No CISO group is set in the plugin configuration.', 'grcmanager') }}
  {% endif %}
</p>
{# Issue #773 : indépendance et compétence des auditeurs (ISO 19011). #}
{% if internal and open_conflicts > 0 %}
  <div class="alert alert-warning" id="grc-team-independence">
    <i class="ti ti-alert-triangle me-1"></i>{{ __('%d independence conflict(s) to justify: an auditor performs or approves an audited process. See the "Programme and independence" tab.', 'grcmanager')|format(open_conflicts) }}
  </div>
{% endif %}
<table class="table table-hover card-table mb-3">
  <thead>
    <tr>
      <th>{{ __('Member', 'grcmanager') }}</th>
      <th>{{ __('Role', 'grcmanager') }}</th>
      {% if internal %}<th>{{ __('Auditor competence', 'grcmanager') }}</th>{% endif %}
      {% if can_edit %}<th><span class="visually-hidden">{{ __('Actions') }}</span></th>{% endif %}
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
      <tr>
        <td>{{ row.name }}</td>
        <td>{{ row.role }}{% if row.from_form %} <span class="text-muted">({{ __('audit form', 'grcmanager') }})</span>{% endif %}</td>
        {% if internal %}
          <td class="grc-competence">
            {% set comp = row.competence %}
            {% if comp is null %}
              <span class="text-muted small">-</span>
            {% elseif comp.status == 'not_configured' %}
              <span class="text-muted small">{{ __('Choose the trainings that qualify an internal auditor on the audit programme page.', 'grcmanager') }}</span>
              <a href="{{ programme_url }}" class="small">{{ __('Multi-year audit programme', 'grcmanager') }}</a>
            {% else %}
              {% if comp.status == 'qualified' %}
                <span class="badge bg-green-lt grc-competence-qualified"><i class="ti ti-certificate me-1"></i>{{ __('Qualified', 'grcmanager') }}</span>
              {% elseif comp.status == 'expired' %}
                <span class="badge bg-orange-lt grc-competence-expired"><i class="ti ti-clock-exclamation me-1"></i>{{ __('Qualification to renew', 'grcmanager') }}</span>
              {% else %}
                <span class="badge bg-red-lt grc-competence-missing"><i class="ti ti-alert-triangle me-1"></i>{{ __('No auditor qualification recorded', 'grcmanager') }}</span>
              {% endif %}
              {% for t in comp.trainings %}
                <div class="small{{ t.valid ? '' : ' text-muted' }}">{{ t.title }}{% if t.date_text %} ({{ t.date_text }}){% endif %}</div>
              {% endfor %}
            {% endif %}
          </td>
        {% endif %}
        {% if can_edit %}
          <td class="text-end">
            {% if not row.from_form %}
              <form method="post" action="{{ action }}" class="d-inline">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="plugin_grcmanager_audits_id" value="{{ audit.getID() }}">
                <input type="hidden" name="members_id" value="{{ row.id }}">
                <button type="submit" name="remove" class="btn btn-sm btn-ghost-danger">
                  <i class="ti ti-trash me-1"></i>{{ __('Remove', 'grcmanager') }}
                </button>
              </form>
            {% endif %}
          </td>
        {% endif %}
      </tr>
    {% else %}
      <tr><td colspan="4" class="text-muted">{{ __('No member: set the auditor or the owner on the form.', 'grcmanager') }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% if can_edit %}
  <form method="post" action="{{ action }}" class="row g-2 align-items-end">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="plugin_grcmanager_audits_id" value="{{ audit.getID() }}">
    {{ fields.dropdownField('User', 'users_id', 0, __('Member', 'grcmanager'), {'right': 'all', 'field_class': 'col-md-5', 'entity': audit.fields['entities_id'], 'entity_sons': audit.fields['is_recursive'] ? true : false}) }}
    {{ fields.dropdownArrayField('role', 'auditor', roles, __('Role', 'grcmanager'), {'field_class': 'col-md-4'}) }}
    <div class="col-md-3">
      <button type="submit" name="add" class="btn btn-primary"><i class="ti ti-user-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
    </div>
  </form>
{% endif %}
