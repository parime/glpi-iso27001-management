{# Issue #199 : lien vers une fiche, avec icône et code en gras optionnels (« A.5.1 - Politiques ») ; sans URL, le libellé seul. #}
{% set text %}{% if icon is defined and icon %}<i class="ti {{ icon }} me-1"></i>{% endif %}{% if code is defined and code is not empty %}<strong>{{ code }}</strong> - {% endif %}{{ label }}{% endset %}
{% if url %}<a href="{{ url }}">{{ text }}</a>{% else %}{{ text }}{% endif %}
