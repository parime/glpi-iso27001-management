{# Flux de la matrice des flux réseau, issue #144 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('name', item.fields['name'], __('Nom', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Laissé vide, il est construit à partir de la source et de la destination.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('flow_type', item.fields['flow_type'] ?: default_type, types, __('Type', 'grcmanager')) }}
   {{ fields.dropdownYesNo('is_active', is_active, __('Actif', 'grcmanager')) }}
   {% for side in sides %}
      {{ fields.htmlField('', side.item_selector, side.title, {'add_field_html': hints.hint(__('Actif GLPI (facultatif).', 'grcmanager'))}) }}
      {{ fields.textField(side.key ~ '_label', item.fields[side.key ~ '_label'], __('Réseau, zone ou adresse', 'grcmanager'), {
         'add_field_html': hints.hint(__('Ex. « Internet », « VLAN serveurs », « 10.0.0.0/24 », « Partenaire X ».', 'grcmanager')),
      }) }}
   {% endfor %}
   {{ fields.dropdownArrayField('protocol', item.fields['protocol'] ?: default_protocol, protocols, __('Protocole', 'grcmanager')) }}
   {{ fields.textField('ports', ports, __('Ports', 'grcmanager'), {
      'additional_attributes': {'placeholder': '80, 443, 8000-8100'},
      'add_field_html': hints.hint(__('Vide : tous les ports.', 'grcmanager')),
   }) }}
   {{ fields.textareaField('justification', item.fields['justification'], __('Justification', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Pourquoi ce flux est nécessaire : application, besoin métier, demande ou ticket d\'origine.', 'grcmanager')),
   }) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Propriétaire', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dateField('date_end', item.fields['date_end'], __('Date de fin', 'grcmanager'), {
      'add_field_html': hints.hint(__('Pour un flux temporaire (migration, prestataire).', 'grcmanager')),
   }) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Commentaires', 'grcmanager'), {'full_width': true}) }}
   {% if not is_new %}
      {{ fields.htmlField('', checks, __('Contrôles', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
{% endblock %}
