{# Obligation légale, réglementaire ou contractuelle (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.dropdownArrayField('type', item.fields['type'] ?: default_type, types, __('Type', 'grcmanager')) }}
   {{ fields.textField('reference_source', item.fields['reference_source'], __('Reference / source', 'grcmanager'), {
      'add_field_html': hints.hint(__('E.g. "GDPR", "Client contract Acme Ltd", "Act No. ...".', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('compliance_status', item.fields['compliance_status'] ?: default_status, statuses, __('Compliance status', 'grcmanager')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], _x('owner', 'Owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dateField('review_date', item.fields['review_date'], __('Review date', 'grcmanager')) }}
   {# Registre sensible : champ absent sans son droit (le lien existant est conservé). #}
   {% if can_view_risks %}
   {{ fields.dropdownArrayField('plugin_grcmanager_risks_id', item.fields['plugin_grcmanager_risks_id'], risks, __('Linked risk (optional)', 'grcmanager'), {
      'add_field_html': hints.hint(__('Only fill in if failing to meet this obligation constitutes a risk identified in the risk register.', 'grcmanager')),
   }) }}
   {% endif %}
   {{ fields.textareaField('description', item.fields['description'], __('Description / notes', 'grcmanager'), {'full_width': true}) }}
{% endblock %}
