{# Issue #160, phase 2 : vulnérabilités connues des logiciels installés sur cet élément #}
<div class="container-fluid">
   {% if rows is empty %}
      <div class="text-muted"><i class="ti ti-circle-check me-1 text-green"></i>{{ __('Aucune vulnérabilité connue pour les logiciels surveillés installés ici.', 'grcmanager') }}
         <a href="{{ park_url }}">{{ __('Vulnérabilités du parc', 'grcmanager') }}</a></div>
   {% else %}
      <table class="table table-card">
         <thead><tr><th>CVE</th><th>{{ __('Logiciel', 'grcmanager') }}</th><th>CVSS</th><th>EPSS</th><th>{{ __('Exploitée', 'grcmanager') }}</th><th>{{ __('Ticket', 'grcmanager') }}</th></tr></thead>
         <tbody>
         {% for r in rows %}
            <tr>
               <td class="text-nowrap">{% if r.priority %}<i class="ti ti-alert-triangle text-red me-1"></i>{% endif %}<a href="https://nvd.nist.gov/vuln/detail/{{ r.cve_id }}" target="_blank" rel="noopener">{{ r.cve_id }}</a></td>
               <td>{{ r.product }} {{ r.version }}</td>
               <td>{{ r.cvss is null ? '—' : r.cvss|number_format(1, ',') }}</td>
               <td>{{ r.epss is null ? '—' : (r.epss * 100)|number_format(1, ',') ~ ' %' }}</td>
               <td>{% if r.is_kev %}<span class="badge bg-red text-white">KEV</span>{% else %}—{% endif %}</td>
               <td>{% if r.tickets_id %}<a href="{{ config('root_doc') }}/front/ticket.form.php?id={{ r.tickets_id }}">#{{ r.tickets_id }}</a>{% endif %}</td>
            </tr>
         {% endfor %}
         </tbody>
      </table>
      {% if total > rows|length %}
         <div class="text-muted small">{{ __('%1$d vulnérabilités affichées sur %2$d, les plus graves d\'abord.', 'grcmanager')|format(rows|length, total) }}
            <a href="{{ park_url }}">{{ __('Vulnérabilités du parc', 'grcmanager') }}</a></div>
      {% endif %}
   {% endif %}
</div>
