{# Corps HTML d'un modèle de notification habillé (NotificationHtml::renderBranded()), sur la
   structure de la charte des notifications de Configuration GLPI Auto (en-tête sombre, barre de
   couleur, tableau de lignes, encadré, bouton). La couleur est une balise ##…## remplacée à l'envoi :
   celle de la charte de Configuration GLPI Auto si elle est publiée, sinon la couleur par défaut.
   Texte figé et balises ##…## de GLPI ; tout le texte est échappé. Les blocs ##IF…## de GLPI
   masquent l'encadré quand sa balise est vide. #}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f0f0f5;padding:30px 0;"><tr><td align="center"><table width="600" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;border-radius:12px;overflow:hidden;"><tr><td style="background:#1a1a2e;padding:30px 36px 24px 36px;"><div style="border-left:4px solid {{ color_tag }};padding-left:16px;"><a href="{{ cta.url }}" style="color:#ffffff;text-decoration:none;font-size:20px;font-weight:bold;font-family:Arial,sans-serif;">{{ title }}</a></div><div style="margin-top:16px;padding-left:20px;"><span style="color:#bbbbbb;font-size:12px;font-family:Arial,sans-serif;">{{ meta }}</span></div></td></tr><tr><td style="padding:32px 36px;background:#ffffff;"><table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-radius:8px;overflow:hidden;border:1px solid #eeeeee;">{% for row in rows %}<tr><td style="background:#fafafa;padding:10px 14px;font-family:Arial,sans-serif;font-size:12px;color:#777777;border-bottom:1px solid #eeeeee;width:180px;">{{ row.label }}</td><td style="background:#ffffff;padding:10px 14px;font-family:Arial,sans-serif;font-size:13px;color:#1a1a2e;border-bottom:1px solid #eeeeee;">{{ row.tag }}</td></tr>{% endfor %}</table>{% if highlight %}##IF{{ highlight.if_tag }}##<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;"><tr><td width="4" style="background:{{ color_tag }};border-radius:4px;">&nbsp;</td><td style="background:#f9f9fb;padding:16px 20px;border-radius:0 8px 8px 0;font-family:Arial,sans-serif;font-size:14px;color:#333333;line-height:1.8;">{{ highlight.tag }}</td></tr></table>##ENDIF{{ highlight.if_tag }}##{% endif %}{% for line in lines %}<p style="font-family:Arial,sans-serif;font-size:13px;color:#555555;line-height:1.6;margin:20px 0 0;">{{ line }}</p>{% endfor %}</td></tr><tr><td align="center" style="background:#ffffff;padding:0 36px 32px 36px;"><a href="{{ cta.url }}" style="display:inline-block;border:2px solid {{ color_tag }};border-radius:6px;padding:10px 24px;color:#1a1a2e;text-decoration:none;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;">{{ cta.text }}</a></td></tr><tr><td align="center" style="background:#f8f8fa;padding:12px 36px;border-top:4px solid {{ color_tag }};"><span style="font-family:Arial,sans-serif;font-size:11px;color:#999999;">GRC Manager</span></td></tr></table></td></tr></table>
