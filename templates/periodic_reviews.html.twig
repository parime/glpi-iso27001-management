{# Issue #141 : revues périodiques, une ligne par revue du catalogue (issue #199 : passé de PHP à Twig) #}
<div class="card"><div class="card-body">
   <p class="text-muted mb-3"><i class="ti ti-info-circle me-1"></i>{{ __('Chaque revue activée devient un ticket récurrent natif de GLPI (Assistance > Tickets récurrents), créé à la fréquence choisie et attribué au responsable. Résoudre le ticket date la revue : c\'est la preuve attendue par l\'auditeur.', 'grcmanager') }}</p>
   {% if not can_manage %}
      <div class="alert alert-info">{{ __('Lecture seule : activer une revue demande le droit de modification du plugin et le droit de créer des tickets récurrents et des gabarits de tickets.', 'grcmanager') }}</div>
   {% endif %}
   <div class="table-responsive">
      <table class="table table-hover align-middle">
         <thead><tr><th>{{ __('Revue', 'grcmanager') }}</th><th>{{ __('Fréquence', 'grcmanager') }}</th><th>{{ __('Responsable', 'grcmanager') }}</th><th>{{ __('État', 'grcmanager') }}</th><th>{{ __('Dernière revue', 'grcmanager') }}</th><th>{{ __('Prochain ticket', 'grcmanager') }}</th><th></th></tr></thead>
         <tbody>
            {% for r in reviews %}
               {% set form_id = 'grc-review-' ~ r.id %}
               <tr>
                  <td>
                     <strong>{{ r.label }}</strong>
                     <div class="small text-muted">{% for control in r.controls %}<span class="badge bg-secondary-lt me-1">{{ control }}</span>{% endfor %}</div>
                  </td>
                  <td>
                     {% if can_manage %}
                        <select name="frequency_months" form="{{ form_id }}" class="form-select form-select-sm" style="min-width: 170px;" aria-label="{{ __('Fréquence', 'grcmanager') }}">
                           {% for months, label in frequencies %}<option value="{{ months }}" {{ months == r.months ? 'selected' }}>{{ label }}</option>{% endfor %}
                        </select>
                     {% else %}
                        {{ r.frequency_label }}
                     {% endif %}
                  </td>
                  <td style="min-width: 240px;">
                     {% if can_manage %}
                        {% set user_dropdown = r.user_dropdown %}
                        {% set group_dropdown = r.group_dropdown %}
                        <div class="small text-muted">{{ __('Technicien', 'grcmanager') }}</div>
                        {{ user_dropdown|raw }}
                        <div class="small text-muted mt-1">{{ __('Groupe', 'grcmanager') }}</div>
                        <div>{{ group_dropdown|raw }}</div>
                     {% else %}
                        {{ r.owner }}
                     {% endif %}
                  </td>
                  <td>
                     {% if r.state == 'inactive' %}
                        <span class="badge bg-secondary-lt"><i class="ti ti-player-pause me-1"></i>{{ __('Inactive', 'grcmanager') }}</span>
                     {% elseif r.state == 'overdue' %}
                        <span class="badge bg-danger-lt"><i class="ti ti-alert-triangle me-1"></i>{{ __('En retard', 'grcmanager') }}</span>
                     {% else %}
                        <span class="badge bg-success-lt"><i class="ti ti-check me-1"></i>{{ __('Active', 'grcmanager') }}</span>
                     {% endif %}
                  </td>
                  <td>
                     {{ r.last_review ? r.last_review|formatted_date : __('Jamais', 'grcmanager') }}
                     {% if r.ticket_url %} <a href="{{ r.ticket_url }}" class="small"><i class="ti ti-ticket me-1"></i>{{ __('Ticket n°%d', 'grcmanager')|format(r.tickets_id) }}</a>{% endif %}
                  </td>
                  <td>
                     {{ r.next ? r.next|formatted_datetime : '—' }}
                     {% if r.recurrent_url %} <a href="{{ r.recurrent_url }}" class="small" title="{{ __('Ouvrir le ticket récurrent', 'grcmanager') }}" aria-label="{{ __('Ouvrir le ticket récurrent', 'grcmanager') }}"><i class="ti ti-external-link"></i></a>{% endif %}
                  </td>
                  <td class="text-end text-nowrap">
                     {% if can_manage %}
                        <form id="{{ form_id }}" method="post" action="{{ action }}" class="d-inline">
                           <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                           <input type="hidden" name="id" value="{{ r.id }}">
                           {% if r.state != 'inactive' %}
                              <button type="submit" name="activate" value="1" class="btn btn-sm btn-primary me-1"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer', 'grcmanager') }}</button>
                              <button type="submit" name="deactivate" value="1" class="btn btn-sm btn-outline-secondary"><i class="ti ti-player-pause me-1"></i>{{ __('Désactiver', 'grcmanager') }}</button>
                           {% else %}
                              <button type="submit" name="activate" value="1" class="btn btn-sm btn-success"><i class="ti ti-player-play me-1"></i>{{ __('Activer', 'grcmanager') }}</button>
                           {% endif %}
                        </form>
                     {% endif %}
                  </td>
               </tr>
            {% endfor %}
         </tbody>
      </table>
   </div>
</div></div>
