{# Issue #168 : salle de crise d'un exercice, étapes chronométrées #}
{# Issue #185 : même salle en cellule de crise sur un incident réel (reprise face au RTO, journal) #}
{% set statuses = {
   'on_time': ['bg-green-lt', 'ti-circle-check', __('On time', 'grcmanager')],
   'late': ['bg-red-lt', 'ti-clock-exclamation', __('Overdue', 'grcmanager')],
   'pending': ['bg-secondary-lt', 'ti-hourglass', __('To do', 'grcmanager')],
   'missed': ['bg-red-lt', 'ti-circle-x', __('Not done', 'grcmanager')]
} %}
{% set recovery_states = {
   'restored_on_time': ['bg-green-lt', 'ti-circle-check', __('Restored within RTO', 'grcmanager')],
   'restored_late': ['bg-red-lt', 'ti-clock-exclamation', __('Restored after RTO', 'grcmanager')],
   'restored': ['bg-green-lt', 'ti-circle-check', __('Restored', 'grcmanager')],
   'running': ['bg-orange-lt', 'ti-hourglass', __('Recovery in progress', 'grcmanager')],
   'overdue': ['bg-red-lt', 'ti-alert-octagon', __('RTO exceeded', 'grcmanager')],
   'no_rto': ['bg-secondary-lt', 'ti-help-circle', __('RTO not set', 'grcmanager')]
} %}
<div class="container-fluid">
   {% if drill %}
      <div class="alert alert-warning mt-2"><i class="ti ti-alert-triangle me-1"></i><strong>{{ __('EXERCISE', 'grcmanager') }}</strong> — {{ __('no real incident is in progress. The steps are also tasks of the exercise incident.', 'grcmanager') }}</div>
   {% else %}
      <div class="alert alert-danger mt-2"><i class="ti ti-alarm me-1"></i><strong>{{ __('CRISIS TEAM', 'grcmanager') }}</strong> — {{ __('real incident. The steps are incident tasks and the log is saved in its followups.', 'grcmanager') }}</div>
   {% endif %}
   <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
      <h2 class="mb-0"><i class="ti ti-alarm me-1 text-danger"></i>{{ exercise.scenario }}</h2>
      {% if exercise.ended %}
         <span class="badge bg-green-lt fs-4"><i class="ti ti-flag-check me-1"></i>{{ __('Completed', 'grcmanager') }} — {{ exercise.duration }} min</span>
      {% else %}
         <span class="badge bg-red-lt fs-3" id="grc-exercise-timer" data-started="{{ exercise.started_ts }}"><i class="ti ti-clock me-1"></i><span>T+{{ exercise.duration }} min</span></span>
      {% endif %}
      <a href="{{ incident.url }}"><i class="ti ti-shield-exclamation me-1"></i>{{ drill ? __('Exercise incident', 'grcmanager') : __('Incident', 'grcmanager') }} #{{ incident.id }}</a>
      {% if drill %}<a href="{{ list_url }}" class="ms-auto"><i class="ti ti-list me-1"></i>{{ __('All exercises', 'grcmanager') }}</a>{% endif %}
   </div>
   <p class="text-muted">{{ __('Started on %1$s by %2$s.', 'grcmanager')|format(exercise.started_at|formatted_datetime, exercise.organizer) }}{% if not drill %} — {{ incident.name }}{% endif %}</p>

   <div class="row g-3">
      <div class="col-lg-8">
         <h3><i class="ti ti-list-check me-1"></i>{{ __('Plan steps', 'grcmanager') }}</h3>
         <table class="table table-vcenter card-table">
            <thead><tr><th>#</th><th>{{ __('Step', 'grcmanager') }}</th><th>{{ __('Target', 'grcmanager') }}</th><th>{{ __('Done at', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th><th></th></tr></thead>
            <tbody>
               {% for s in steps %}
                  <tr>
                     <td>{{ loop.index }}</td>
                     <td>{{ s.label }}{% if s.by %}<div class="small text-muted">{{ s.by }}</div>{% endif %}</td>
                     <td class="text-nowrap">T+{{ s.target }} min</td>
                     <td class="text-nowrap">{{ s.minutes is null ? '—' : 'T+' ~ s.minutes ~ ' min' }}</td>
                     <td><span class="badge {{ statuses[s.status][0] }}"><i class="ti {{ statuses[s.status][1] }} me-1"></i>{{ statuses[s.status][2] }}</span></td>
                     <td class="text-end">
                        {% if can_act and not exercise.ended and s.minutes is null %}
                           <form method="post" action="{{ action }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="id" value="{{ exercise.id }}">
                              <button type="submit" name="step_done" value="{{ s.id }}" class="btn btn-sm btn-success"><i class="ti ti-check me-1"></i>{{ _x('task', 'Done', 'grcmanager') }}</button>
                           </form>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>

         <h3 class="mt-4"><i class="ti ti-server-bolt me-1"></i>{{ __('Recovery of affected items', 'grcmanager') }}</h3>
         {% if recovery is empty %}
            <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>{{ __('No item linked to the incident. Add the affected items in the incident\'s "Items" tab: their recovery, and that of what depends on them, will be tracked here against their RTO.', 'grcmanager') }}</div>
         {% else %}
            <table class="table table-vcenter card-table">
               <thead><tr><th>{{ __('Item', 'grcmanager') }}</th><th>RTO</th><th>{{ __('Due date', 'grcmanager') }}</th><th>{{ __('Duration', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th><th></th></tr></thead>
               <tbody>
                  {% for r in recovery %}
                     <tr>
                        <td>
                           <a href="{{ r.url }}">{{ r.label }}</a>
                           <div class="small text-muted">{{ r.depth == 0 ? __('Affected by the incident', 'grcmanager') : __('Depends on an affected item', 'grcmanager') }}{% if r.by %} — {{ __('restored by %s', 'grcmanager')|format(r.by) }}{% endif %}</div>
                        </td>
                        <td class="text-nowrap">{{ r.rto > 0 ? r.rto ~ ' h' : '—' }}</td>
                        <td class="text-nowrap">{{ r.due ? r.due|formatted_datetime : '—' }}</td>
                        <td class="text-nowrap">{{ r.hours is null ? '—' : r.hours ~ ' h' }}</td>
                        <td><span class="badge {{ recovery_states[r.state][0] }}"><i class="ti {{ recovery_states[r.state][1] }} me-1"></i>{{ recovery_states[r.state][2] }}</span></td>
                        <td class="text-end">
                           {% if can_act and not exercise.ended and not r.restored_at %}
                              <form method="post" action="{{ action }}" class="d-inline">
                                 <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                 <input type="hidden" name="id" value="{{ exercise.id }}">
                                 <button type="submit" name="restored" value="{{ r.key }}" class="btn btn-sm btn-success"><i class="ti ti-plug-connected me-1"></i>{{ __('Restored', 'grcmanager') }}</button>
                              </form>
                           {% endif %}
                        </td>
                     </tr>
                  {% endfor %}
               </tbody>
            </table>
            <div class="form-hint">{{ __('The RTO is set in each item\'s "Classification" tab; it is counted from the opening of the crisis room.', 'grcmanager') }}</div>
         {% endif %}

         <h3 class="mt-4" id="grc-crisis-journal"><i class="ti ti-notebook me-1"></i>{{ __('Crisis log', 'grcmanager') }}</h3>
         {% if can_journal and not exercise.ended %}
            <form method="post" action="{{ action }}" class="d-flex gap-2 mb-2">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="id" value="{{ exercise.id }}">
               <input type="text" class="form-control" name="journal" required maxlength="2000" placeholder="{{ __('Decision, finding, call made… (timestamped automatically)', 'grcmanager') }}" aria-label="{{ __('New log entry', 'grcmanager') }}">
               <button type="submit" class="btn btn-primary text-nowrap"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
            </form>
         {% endif %}
         {% if journal is empty %}
            <p class="text-muted">{{ __('No entry yet.', 'grcmanager') }}</p>
         {% else %}
            <ul class="list-unstyled">
               {% for j in journal|reverse %}
                  <li class="mb-2"><span class="text-muted text-nowrap">{{ j.date|formatted_datetime }}</span> — <strong>{{ j.author }}</strong>{% if j.private %} <span class="badge bg-secondary-lt">{{ __('Private', 'grcmanager') }}</span>{% endif %} : {{ j.text|nl2br }}</li>
               {% endfor %}
            </ul>
         {% endif %}
      </div>
      <div class="col-lg-4">
         <div class="card">
            <div class="card-body">
               <h4><i class="ti ti-chart-bar me-1"></i>{{ _x('summary', 'Outcome', 'grcmanager') }}</h4>
               <ul class="list-unstyled">
                  <li>{{ __('Steps done', 'grcmanager') }} : <strong>{{ summary.done }} / {{ summary.total }}</strong></li>
                  <li>{{ __('Steps on time', 'grcmanager') }} : <strong>{{ summary.on_time }}</strong> ({{ summary.rate }} %)</li>
                  <li>{{ __('Average reaction time', 'grcmanager') }} : <strong>{{ summary.average is null ? '—' : summary.average ~ ' min' }}</strong></li>
                  {% if recovery is not empty %}
                     <li>{{ __('Items restored', 'grcmanager') }} : <strong>{{ recovery|filter(r => r.restored_at)|length }} / {{ recovery|length }}</strong></li>
                     <li>{{ __('RTOs exceeded', 'grcmanager') }} : <strong>{{ recovery|filter(r => r.state in ['overdue', 'restored_late'])|length }}</strong></li>
                  {% endif %}
                  <li>{{ __('Participants', 'grcmanager') }} : {{ participants is empty ? '—' : participants|join(', ') }}</li>
               </ul>
               {% if exercise.ended %}
                  {% if exercise.document_url %}
                     <a href="{{ exercise.document_url }}" class="btn btn-primary"><i class="ti ti-file-type-pdf me-1"></i>{{ drill ? __('Open the exercise report', 'grcmanager') : __('Open the crisis report', 'grcmanager') }}</a>
                  {% endif %}
                  {% if can_act %}
                     <form method="post" action="{{ action }}" class="mt-2">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="id" value="{{ exercise.id }}">
                        <button type="submit" name="finish" value="1" class="btn btn-outline-secondary btn-sm"><i class="ti ti-refresh me-1"></i>{{ __('Regenerate the report', 'grcmanager') }}</button>
                     </form>
                     <div class="form-hint">{{ __('Fill in the lessons learned on the incident, then regenerate the report to include them.', 'grcmanager') }}</div>
                  {% endif %}
               {% elseif can_act %}
                  {% if drill %}
                     <form method="post" action="{{ action }}" data-grc-confirm="{{ __('Finish the exercise? Steps not done will be counted as missed.', 'grcmanager') }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="id" value="{{ exercise.id }}">
                        <button type="submit" name="finish" value="1" class="btn btn-danger"><i class="ti ti-flag-check me-1"></i>{{ __('Finish the exercise and generate the report', 'grcmanager') }}</button>
                     </form>
                     <div class="form-hint">{{ __('The PDF report is archived on the exercise incident and as evidence on SoA controls A.5.29 and A.5.30.', 'grcmanager') }}</div>
                  {% else %}
                     <form method="post" action="{{ action }}" data-grc-confirm="{{ __('Close the crisis team? The timer stops; the incident itself stays open.', 'grcmanager') }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="id" value="{{ exercise.id }}">
                        <button type="submit" name="finish" value="1" class="btn btn-danger"><i class="ti ti-flag-check me-1"></i>{{ __('Close the crisis team and generate the report', 'grcmanager') }}</button>
                     </form>
                     <div class="form-hint">{{ __('The PDF report is archived on the incident and as evidence on SoA controls A.5.26 and A.5.29.', 'grcmanager') }}</div>
                  {% endif %}
               {% endif %}
            </div>
         </div>
      </div>
   </div>
</div>
{% include '@grcmanager/_confirm_forms.html.twig' %}
{% if not exercise.ended %}
<script>
   (function () {
      const timer = document.getElementById('grc-exercise-timer');
      const label = timer.querySelector('span');
      const started = parseInt(timer.dataset.started, 10) * 1000;
      const pad = (n) => String(n).padStart(2, '0');
      const tick = function () {
         const seconds = Math.max(0, Math.floor((Date.now() - started) / 1000));
         label.textContent = 'T+' + pad(Math.floor(seconds / 3600)) + ':' + pad(Math.floor(seconds / 60) % 60) + ':' + pad(seconds % 60);
      };
      tick();
      window.setInterval(tick, 1000);
   })();
</script>
{% endif %}
