{# Issue #126 : ticket de modification ou de retrait d'accès ; issue #199 : passé de PHP à Twig. #}
{% macro list(items) %}{% if items is empty %}—{% else %}<ul>{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}{% endmacro %}
<p>{{ __('Demande issue de la campagne « %1$s », par %2$s.', 'grcmanager')|format(campaign, actor) }}</p>
<p><strong>{{ __('Demande', 'grcmanager') }}</strong> : {{ comment|nl2br }}</p>
<p><strong>{{ __('Profils au lancement', 'grcmanager') }}</strong></p>
{{ _self.list(profiles) }}
<p><strong>{{ __('Groupes au lancement', 'grcmanager') }}</strong></p>
{{ _self.list(groups) }}
<p>{{ __('Le plugin GRC ne modifie aucun droit : appliquez la demande puis résolvez ce ticket.', 'grcmanager') }}</p>
