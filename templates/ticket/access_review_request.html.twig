{% macro list(items) %}{% if items is empty %}—{% else %}<ul>{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}{% endmacro %}
<p>{{ __('Request from campaign "%1$s", by %2$s.', 'grcmanager')|format(campaign, actor) }}</p>
<p><strong>{{ __('Request', 'grcmanager') }}</strong> : {{ comment|nl2br }}</p>
<p><strong>{{ __('Profiles at launch', 'grcmanager') }}</strong></p>
{{ _self.list(profiles) }}
<p><strong>{{ __('Groups at launch', 'grcmanager') }}</strong></p>
{{ _self.list(groups) }}
<p>{{ __('The GRC plugin changes no right: apply the request, then solve this ticket.', 'grcmanager') }}</p>
