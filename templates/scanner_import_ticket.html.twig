{# Issue #543 : contenu du ticket proposé pour un constat de scanner (texte du rapport échappé). #}
<p>{{ __('Vulnerability found by %s, to fix on the computer linked to this ticket.', 'grcmanager')|format(scanner) }}</p>
<ul>
   <li>{{ __('Vulnerability', 'grcmanager') }} : {{ finding.name }}</li>
   <li>{{ __('Severity', 'grcmanager') }} : {{ (levels[finding.level].label ?? finding.level) }} ({{ finding.severity|number_format(1) }})</li>
   <li>{{ __('Host in the report', 'grcmanager') }} : {{ finding.host }}{% if finding.hostname %} ({{ finding.hostname }}){% endif %}</li>
   <li>{{ __('Port', 'grcmanager') }} : {{ finding.port }}</li>
   {% if finding.cve_list is not empty %}<li>CVE : {{ finding.cve_list|join(', ') }}</li>{% endif %}
   {% if finding.test_id %}<li>{{ __('Test', 'grcmanager') }} : {{ finding.test_id }}</li>{% endif %}
   <li>{{ __('Last seen', 'grcmanager') }} : {{ last_seen }}</li>
</ul>
{% if finding.solution %}<p>{{ __('Solution', 'grcmanager') }}{% if finding.solution_type %} ({{ finding.solution_type }}){% endif %} :</p><p>{{ finding.solution|nl2br }}</p>{% endif %}
