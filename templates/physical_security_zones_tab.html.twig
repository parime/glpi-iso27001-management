{# Issue #778 : onglet « Zones » d'une évaluation de la sécurité physique : zones du site (publique,
   contrôlée, sensible, local technique), contrôles d'accès, personnes autorisées, consignes. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set v = {'is_horizontal': false} %}

{% macro zone_fields(zone, zone_types, access_means, rand) %}
   {% import 'components/form/fields_macros.html.twig' as fields %}
   {% set v = {'is_horizontal': false} %}
   {{ fields.textField('name', zone.name|default(''), __('Name'), v|merge({'field_class': 'col-md-6', 'rand': 'grcpzname' ~ rand})) }}
   {{ fields.dropdownArrayField('zone_type', zone.type|default('controlled'), zone_types, __('Type of zone', 'grcmanager'), v|merge({'field_class': 'col-md-6', 'rand': 'grcpztype' ~ rand})) }}
   <div class="col-12">
      <label class="form-label">{{ __('Access controls', 'grcmanager') }}</label>
      <div class="d-flex flex-wrap gap-3">
         {% for key, label in access_means %}
            <label class="form-check form-check-inline mb-0">
               <input class="form-check-input" type="checkbox" name="access_means[]" value="{{ key }}"{% if key in zone.means|default([]) %} checked{% endif %}>
               <span class="form-check-label">{{ label }}</span>
            </label>
         {% endfor %}
      </div>
   </div>
   {{ fields.textareaField('authorized_people', zone.authorized_people|default(''), __('Authorized people', 'grcmanager'), v|merge({'field_class': 'col-md-6', 'rows': 2, 'rand': 'grcpzauth' ~ rand})) }}
   {{ fields.textareaField('comment', zone.comment|default(''), __('Comments'), v|merge({'field_class': 'col-md-6', 'rows': 2, 'rand': 'grcpzcom' ~ rand})) }}
   <div class="col-12">
      <label class="form-check mb-0">
         <input class="form-check-input" type="checkbox" name="instructions_posted" value="1"{% if zone.instructions_posted|default(false) %} checked{% endif %}>
         <span class="form-check-label">{{ __('Access instructions posted at the entrance', 'grcmanager') }}</span>
      </label>
   </div>
{% endmacro %}
{% import _self as pz %}

<div class="card mb-3" id="grc-physical-zones">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-map-2 me-2"></i>{{ __('Zones of the site and access controls', 'grcmanager') }}</h3>
   </div>
   <div class="card-body">
      <p class="text-muted small mb-2">
         <i class="ti ti-info-circle me-1"></i>{{ __('List the zones of the site from the most open to the most restricted, with how access is controlled and who may enter. A sensitive area or a technical room needs at least one access control and posted access instructions. The next assessment of the site takes over these zones.', 'grcmanager') }}
      </p>
      <div class="d-flex flex-wrap gap-2 mb-3">
         {% for key, label in zone_types %}
            <span class="small text-muted">{{ __('%1$s: %2$s', 'grcmanager')|format(label, zone_hints[key]) }}</span>
         {% endfor %}
      </div>
      {% if zones is empty %}
         <div class="alert alert-info mb-0" id="grc-physical-zones-empty"><i class="ti ti-info-circle me-1"></i>{{ __('No zone recorded for this site yet.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
         <table class="table table-sm table-vcenter card-table" id="grc-physical-zones-list">
            <thead>
               <tr>
                  <th>{{ __('Zone', 'grcmanager') }}</th>
                  <th>{{ __('Access controls', 'grcmanager') }}</th>
                  <th>{{ __('Authorized people', 'grcmanager') }}</th>
                  <th>{{ __('Access instructions', 'grcmanager') }}</th>
               </tr>
            </thead>
            <tbody>
            {% for zone in zones %}
               <tr id="grc-physical-zone-{{ zone.id }}">
                  <td>
                     <div class="fw-bold">{{ zone.name }}</div>
                     <span class="badge {{ zone.type_class }}">{{ zone.type_label }}</span>
                     {% if zone.comment %}<div class="text-muted small mt-1">{{ zone.comment|nl2br }}</div>{% endif %}
                  </td>
                  <td>
                     {% for label in zone.means_labels %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis me-1 mb-1">{{ label }}</span>
                     {% else %}
                        <span class="text-muted small">-</span>
                     {% endfor %}
                     {% for warning in zone.warnings %}
                        <div class="text-danger small grc-physical-zone-warning"><i class="ti ti-alert-triangle me-1"></i>{{ warning }}</div>
                     {% endfor %}
                  </td>
                  <td>{% if zone.authorized_people %}<div class="small">{{ zone.authorized_people|nl2br }}</div>{% else %}<span class="text-muted small">-</span>{% endif %}</td>
                  <td>
                     {% if zone.instructions_posted %}
                        <span class="badge bg-green-subtle text-green-emphasis"><i class="ti ti-check me-1"></i>{{ __('Posted', 'grcmanager') }}</span>
                     {% else %}
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ __('Not posted', 'grcmanager') }}</span>
                     {% endif %}
                  </td>
               </tr>
               {% if can_edit %}
               <tr>
                  <td colspan="4" class="border-top-0 pt-0">
                     <details>
                        <summary class="btn btn-sm btn-ghost-secondary"><i class="ti ti-pencil me-1"></i>{{ __('Edit', 'grcmanager') }}</summary>
                        <form method="post" action="{{ action }}" class="row g-2 mt-1">
                           <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                           <input type="hidden" name="plugin_grcmanager_physicalsecurityassessments_id" value="{{ assessment_id }}">
                           <input type="hidden" name="id" value="{{ zone.id }}">
                           {{ pz.zone_fields(zone, zone_types, access_means, zone.id) }}
                           <div class="col-12 d-flex flex-wrap gap-2">
                              <button type="submit" name="save_zone" value="1" class="btn btn-sm btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
                              <button type="submit" name="delete_zone" value="1" class="btn btn-sm btn-ghost-danger" onclick="return confirm('{{ __('Remove this zone from the assessment?', 'grcmanager')|e('js') }}');"><i class="ti ti-trash me-1"></i>{{ __('Remove the zone', 'grcmanager') }}</button>
                           </div>
                        </form>
                     </details>
                  </td>
               </tr>
               {% endif %}
            {% endfor %}
            </tbody>
         </table>
         </div>
      {% endif %}
   </div>
</div>

{% if can_edit %}
<div class="card" id="grc-physical-zone-add">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-plus me-2"></i>{{ __('Add a zone', 'grcmanager') }}</h3></div>
   <div class="card-body">
      <form method="post" action="{{ action }}" class="row g-2">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="plugin_grcmanager_physicalsecurityassessments_id" value="{{ assessment_id }}">
         {{ pz.zone_fields({}, zone_types, access_means, 'new') }}
         <div class="col-12">
            <button type="submit" name="add_zone" value="1" class="btn btn-primary"><i class="ti ti-plus me-1"></i>{{ __('Add the zone', 'grcmanager') }}</button>
         </div>
      </form>
   </div>
</div>
{% endif %}
