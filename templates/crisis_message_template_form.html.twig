{# Issue #616 : modèle de message de crise #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('name', item.fields['name'], __('Name'), {
      'required': true,
      'add_field_html': hints.hint(__('Example: "Ransomware: instructions to staff".', 'grcmanager')),
   }) }}
   {{ fields.checkboxField('is_active', item.isNewItem() ? 1 : item.fields['is_active'], __('Active')) }}
   {{ fields.dropdownArrayField('situation', item.fields['situation'], situations, __('Situation', 'grcmanager'), {
      'add_field_html': hints.hint(__('The template is suggested first on incidents of this situation.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('stage', item.fields['stage'], stages, __('Stage', 'grcmanager')) }}
   {{ fields.dropdownArrayField('audience', item.fields['audience'], audiences, __('Audience', 'grcmanager')) }}
   {{ fields.textField('subject', item.fields['subject'], __('Subject', 'grcmanager'), {
      'full_width': true,
   }) }}
   {{ fields.textareaField('body', item.fields['body'], __('Message', 'grcmanager'), {
      'full_width': true,
      'rows': 14,
   }) }}
   {% set variables_html %}
      <div id="grc-crisis-variables">
         <p class="mb-1">{{ __('Write the variables between braces: they are replaced with the values of the incident when the message is prepared. A variable without a value becomes "[to be completed]".', 'grcmanager') }}</p>
         <ul class="mb-1">
            {% for name, label in variables %}
               <li><code>{{ '{' ~ name ~ '}' }}</code> : {{ label }}</li>
            {% endfor %}
         </ul>
         {% if unknown is not empty %}
            <span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-alert-triangle me-1"></i>{{ __('Unknown variables, left as they are: %s', 'grcmanager')|format(unknown|map(v => '{' ~ v ~ '}')|join(', ')) }}</span>
         {% endif %}
      </div>
   {% endset %}
   {{ fields.htmlField('', variables_html, __('Variables', 'grcmanager'), {'full_width': true}) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), {'full_width': true}) }}
{% endblock %}
