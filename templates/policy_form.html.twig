{# Politique de sécurité versionnée, A.5.1 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.textField('version', item.fields['version'] ?: '1.0', __('Version', 'grcmanager')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], _x('owner', 'Owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: default_status, statuses, __('Status', 'grcmanager'), {
      'add_field_html': hints.hint(__('An approval date is required to switch to the "Approved" status.', 'grcmanager')),
   }) }}
   {{ fields.dateField('approval_date', item.fields['approval_date'], __('Approval date', 'grcmanager')) }}
   {{ fields.dateField('next_review_date', item.fields['next_review_date'], __('Next review', 'grcmanager')) }}
   {{ fields.textareaField('description', item.fields['description'], __('Description', 'grcmanager'), {'full_width': true}) }}
   {{ fields.checkboxField('is_it_charter', item.fields['is_it_charter'] ?? 0, __('IT charter', 'grcmanager'), {
      'add_field_html': hints.hint(__('Reference version for assetsign charter campaigns: the most recent approved version is shown in them, and a new approved version calls for a new signature.', 'grcmanager')),
   }) }}
{% endblock %}
