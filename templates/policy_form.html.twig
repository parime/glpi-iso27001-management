{# Politique de sécurité versionnée, A.5.1 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {% if content_locked %}
      {# Issue #611 : contenu figé pendant l'approbation et après. #}
      <div class="alert alert-info d-flex align-items-center gap-2 w-100" role="status">
         <i class="ti ti-lock"></i>
         <div>{{ __('The content of this version is frozen by the approval workflow (title, version, description). Use the "Approval" tab to withdraw the request or to prepare a new version.', 'grcmanager') }}</div>
      </div>
   {% endif %}
   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true, 'readonly': content_locked}) }}
   {# Issue #775 : procédure d'exploitation (A.5.37), classée par domaine. #}
   {{ fields.dropdownArrayField('category', category, categories, __('Category', 'grcmanager'), {
      'add_field_html': hints.hint(__('Choose "Operating procedure" for a documented procedure (backup, restore, updates...): it then appears in the register of operating procedures, with its domain.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('procedure_domain', domain, domains, __('Procedure domain', 'grcmanager'), {
      'add_field_html': hints.hint(__('Operating procedures only. The list of expected domains is set in the configuration of the plugin.', 'grcmanager')),
   }) }}
   {{ fields.textField('version', item.fields['version'] ?: '1.0', __('Version', 'grcmanager'), {'readonly': content_locked}) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], _x('owner', 'Owner', 'grcmanager'), {'right': 'all'}) }}
   {% if approval_workflow %}
      {{ fields.dropdownArrayField('status', item.fields['status'] ?: default_status, statuses, __('Status', 'grcmanager'), {
         'add_field_html': hints.hint(__('The "Approved" status is given by the designated approvers, from the "Approval" tab.', 'grcmanager')),
      }) }}
      {{ fields.dateField('approval_date', item.fields['approval_date'], __('Approval date', 'grcmanager'), {
         'disabled': true,
         'add_field_html': hints.hint(__('Date of the last approval, filled in by the approval workflow.', 'grcmanager')),
      }) }}
   {% else %}
      {{ fields.dropdownArrayField('status', item.fields['status'] ?: default_status, statuses, __('Status', 'grcmanager'), {
         'add_field_html': hints.hint(__('An approval date is required to switch to the "Approved" status.', 'grcmanager')),
      }) }}
      {{ fields.dateField('approval_date', item.fields['approval_date'], __('Approval date', 'grcmanager')) }}
   {% endif %}
   {{ fields.dateField('next_review_date', item.fields['next_review_date'], __('Next review', 'grcmanager')) }}
   {# Issue #775, lot 2 : revue périodique tracée d'une procédure d'exploitation, même sans nouvelle version. #}
   {% if category == 'operating_procedure' and not item.isNewItem() %}
      <div class="form-field row col-12 col-sm-6 mb-2" id="grc-procedure-review">
         <label class="col-form-label col-xxl-5 text-xxl-end">{{ __('Last review', 'grcmanager') }}</label>
         <div class="col-xxl-7 field-container d-flex align-items-center flex-wrap gap-2">
            {% if item.fields['last_review_date'] %}
               <span class="badge bg-success-subtle text-success-emphasis">
                  <i class="ti ti-circle-check me-1"></i>{{ __('%1$s by %2$s', 'grcmanager')|format(item.fields['last_review_date']|formatted_date, last_reviewer ?: '-') }}
               </span>
            {% else %}
               <span class="badge bg-warning-subtle text-warning-emphasis">
                  <i class="ti ti-alert-triangle me-1"></i>{{ __('Never reviewed', 'grcmanager') }}
               </span>
            {% endif %}
            {% if can_review %}
               <button type="submit" name="{{ review_marker }}" value="1" class="btn btn-sm btn-outline-success"
                  title="{{ __('Records today as the review date of the procedure, with your name, without a new version. The next review is the date set above if you moved it later, one year later otherwise. Your other changes on this form are saved too.', 'grcmanager') }}">
                  <i class="ti ti-calendar-check me-1"></i>{{ __('Record the review', 'grcmanager') }}
               </button>
            {% elseif item.fields['status'] != 'approved' %}
               {{ hints.hint(__('A review can be recorded once the procedure is approved. Changes to the procedure go through a new version.', 'grcmanager')) }}
            {% endif %}
         </div>
      </div>
      {# Issue #775, lot 3 : historique de toutes les revues, lu dans le journal d'audit. #}
      {% if review_history is not empty %}
         <div class="form-field row col-12 mb-2" id="grc-procedure-review-history">
            <label class="col-form-label col-xxl-2 text-xxl-end">
               <i class="ti ti-history me-1"></i>{{ __('Review history', 'grcmanager') }}
               <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">{{ review_history|length }}</span>
            </label>
            <div class="col-xxl-10 field-container">
               <table class="table table-sm table-borderless mb-0 w-auto">
                  <thead>
                     <tr>
                        <th>{{ __('Date') }}</th>
                        <th>{{ __('Reviewer', 'grcmanager') }}</th>
                        <th>{{ __('Next review', 'grcmanager') }}</th>
                     </tr>
                  </thead>
                  <tbody>
                     {% for review in review_history %}
                        <tr>
                           <td><i class="ti ti-calendar-check text-success me-1"></i>{{ review.date|formatted_date }}</td>
                           <td>{{ review.reviewer ?: '-' }}</td>
                           <td>{{ review.next_review ? review.next_review|formatted_date : '-' }}</td>
                        </tr>
                     {% endfor %}
                  </tbody>
               </table>
               {{ hints.hint(__('Each review recorded with the "Record the review" button is kept here and in the security audit log; it cannot be changed afterwards.', 'grcmanager')) }}
            </div>
         </div>
      {% endif %}
   {% endif %}
   {{ fields.textareaField('description', item.fields['description'], __('Description', 'grcmanager'), {'full_width': true, 'readonly': content_locked}) }}
   {{ fields.checkboxField('is_it_charter', item.fields['is_it_charter'] ?? 0, __('IT charter', 'grcmanager'), {
      'add_field_html': hints.hint(__('Reference version for assetsign charter campaigns: the most recent approved version is shown in them, and a new approved version calls for a new signature.', 'grcmanager')),
   }) }}
{% endblock %}
