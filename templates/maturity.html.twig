{# Issue #166 : score de maturité cyber, avec le détail du calcul. #}
{% set level_colors = {1: '#d63939', 2: '#f76707', 3: '#f59f00', 4: '#74b816', 5: '#2fb344'} %}
<div class="container-fluid my-2">
   <div class="row g-3">
      <div class="col-lg-4">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-gauge me-2"></i>{{ __('Maturity score', 'grcmanager') }}</h3></div>
            <div class="card-body text-center">
               <div id="grc-maturity-gauge" style="height: 220px;" data-score="{{ score }}" data-color="{{ level_colors[level] }}"></div>
               <div class="fs-2 fw-bold" style="color: {{ level_colors[level] }}">{{ score }} / 100</div>
               <span class="badge text-white" style="background: {{ level_colors[level] }}">{{ __('Level %1$d: %2$s', 'grcmanager')|format(level, level_labels[level]) }}</span>
               <p class="text-muted small mt-2 mb-0">{{ __('Levels: 1 Initial (0-19), 2 Repeatable (20-39), 3 Defined (40-59), 4 Managed (60-79), 5 Optimised (80-100).', 'grcmanager') }}</p>
            </div>
         </div>
      </div>
      <div class="col-lg-8">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-math-function me-2"></i>{{ __('Calculation details', 'grcmanager') }}</h3></div>
            <div class="card-body">
               <table class="table table-sm table-vcenter">
                  <thead><tr><th>{{ __('Component', 'grcmanager') }}</th><th class="text-end text-nowrap">{{ __('Value', 'grcmanager') }}</th><th class="text-end text-nowrap">{{ __('Weight', 'grcmanager') }}</th><th class="text-end text-nowrap">{{ __('Contribution', 'grcmanager') }}</th></tr></thead>
                  <tbody>
                  {% for key, c in components %}
                     <tr>
                        <td>{{ component_labels[key] }}</td>
                        <td class="text-end text-nowrap">{{ c.value is null ? __('no data', 'grcmanager') : c.value|number_format(1, ',') ~ ' %' }}</td>
                        <td class="text-end text-nowrap">{{ c.value is null ? '—' : c.effective_weight|number_format(1, ',') ~ ' %' }}</td>
                        <td class="text-end text-nowrap">{{ c.value is null ? '—' : (c.value * c.effective_weight / 100)|number_format(1, ',') }}</td>
                     </tr>
                  {% endfor %}
                  <tr class="fw-bold"><td>{{ __('Subtotal', 'grcmanager') }}</td><td></td><td></td><td class="text-end text-nowrap">{{ base|number_format(1, ',') }}</td></tr>
                  <tr>
                     <td>{{ __('Penalties: %1$d overdue corrective action(s), %2$d unresolved security incident(s)', 'grcmanager')|format(penalties.capa_overdue, penalties.incidents_open) }}</td>
                     <td></td><td></td><td class="text-end text-danger">− {{ penalty }}</td>
                  </tr>
                  </tbody>
               </table>
               <p class="text-muted small mb-0"><i class="ti ti-info-circle me-1"></i>{{ __('A component without data (unused module) is left out and its weight spread over the others. A control "in progress" counts for half. Each overdue action or open incident removes 2 points, at most 10 per category.', 'grcmanager') }}</p>
            </div>
         </div>
      </div>

      <div class="col-lg-6">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-chart-radar me-2"></i>{{ __('Annex A implementation by theme', 'grcmanager') }}</h3></div>
            <div class="card-body">
               {% if themes is empty %}
                  <p class="text-muted">{{ __('No control declared applicable in the SoA.', 'grcmanager') }}</p>
               {% else %}
                  <div id="grc-maturity-radar" style="height: 300px;" data-themes="{{ themes|json_encode }}"></div>
               {% endif %}
            </div>
         </div>
      </div>
      <div class="col-lg-6">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-chart-line me-2"></i>{{ __('Monthly trend', 'grcmanager') }}</h3></div>
            <div class="card-body">
               {% if history|length < 2 %}
                  <p class="text-muted">{{ __('The history builds up month after month: the scheduled task records the score every day for the current month.', 'grcmanager') }}</p>
               {% endif %}
               {% if history is not empty %}
                  <div id="grc-maturity-history" style="height: 260px;" data-history="{{ history|json_encode }}"></div>
               {% endif %}
            </div>
         </div>
      </div>
   </div>
</div>
<script>
   (function () {
      const draw = function () {
         const gauge = document.getElementById('grc-maturity-gauge');
         window.echarts.init(gauge).setOption({
            series: [{
               type: 'gauge', min: 0, max: 100, startAngle: 210, endAngle: -30,
               progress: {show: true, width: 14, itemStyle: {color: gauge.dataset.color}},
               axisLine: {lineStyle: {width: 14}}, pointer: {show: false},
               axisTick: {show: false}, splitLine: {show: false}, axisLabel: {show: false},
               detail: {show: false}, data: [{value: Number(gauge.dataset.score)}]
            }]
         });
         const radar = document.getElementById('grc-maturity-radar');
         if (radar) {
            const themes = JSON.parse(radar.dataset.themes);
            window.echarts.init(radar).setOption({
               radar: {indicator: themes.map(function (t) { return {name: t.label, max: 100}; })},
               series: [{type: 'radar', areaStyle: {opacity: 0.25}, data: [{value: themes.map(function (t) { return t.value; })}]}]
            });
         }
         const history = document.getElementById('grc-maturity-history');
         if (history) {
            const points = JSON.parse(history.dataset.history);
            window.echarts.init(history).setOption({
               grid: {left: 40, right: 20, top: 20, bottom: 30},
               xAxis: {type: 'category', data: points.map(function (p) { return p.month; })},
               yAxis: {type: 'value', min: 0, max: 100},
               tooltip: {trigger: 'axis'},
               series: [{type: 'line', smooth: true, data: points.map(function (p) { return p.score; })}]
            });
         }
      };
      if (typeof window.echarts === 'undefined') {
         const script = document.createElement('script');
         script.src = '{{ config('root_doc') }}/lib/echarts.min.js';
         script.onload = draw;
         document.head.appendChild(script);
      } else {
         draw();
      }
   })();
</script>
