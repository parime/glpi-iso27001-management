{# Issue #177 : impact d'une panne de cet actif #}
{% set badges = {'high': 'bg-red-lt', 'medium': 'bg-orange-lt', 'low': 'bg-green-lt'} %}
<div class="container-fluid">
   {% if not analysis.has_relations %}
      <div class="alert alert-info">
         <i class="ti ti-info-circle me-1"></i>{{ __('Aucune dépendance déclarée pour cet élément. Décrivez qui dépend de quoi dans l\'onglet « Analyse d\'impact » de GLPI (hyperviseur, stockage, machines virtuelles, applications...) pour voir ici l\'impact d\'une panne.', 'grcmanager') }}
         <a href="{{ impact_url }}">{{ __('Ouvrir l\'analyse d\'impact', 'grcmanager') }}</a>
      </div>
   {% endif %}

   {% if analysis.spof_for is not empty %}
      <div class="alert alert-danger">
         <div><i class="ti ti-alert-triangle me-1"></i><strong>{{ __('Point de défaillance unique', 'grcmanager') }}</strong> : {{ __('ces éléments à disponibilité haute ne dépendent que de lui.', 'grcmanager') }}</div>
         <ul class="mb-2">
            {% for c in analysis.spof_for %}<li>{% if c.url %}<a href="{{ c.url }}">{{ c.label }}</a>{% else %}{{ c.label }}{% endif %}</li>{% endfor %}
         </ul>
         {% if can_create %}
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="itemtype" value="{{ itemtype }}">
               <input type="hidden" name="items_id" value="{{ items_id }}">
               <button type="submit" name="create_risk" value="1" class="btn btn-sm btn-outline-danger"><i class="ti ti-playlist-add me-1"></i>{{ __('Créer le risque correspondant', 'grcmanager') }}</button>
            </form>
         {% endif %}
      </div>
   {% endif %}

   <h4>{{ __('Éléments touchés par une panne', 'grcmanager') }}</h4>
   {% if analysis.downstream is empty %}
      <div class="text-muted mb-3">{{ __('Aucun élément ne dépend de celui-ci.', 'grcmanager') }}</div>
   {% else %}
      <table class="table table-card mb-3">
         <thead><tr><th>{{ __('Élément', 'grcmanager') }}</th><th>{{ __('Dépendance', 'grcmanager') }}</th><th>{{ __('Disponibilité', 'grcmanager') }}</th></tr></thead>
         <tbody>
         {% for d in analysis.downstream %}
            <tr>
               <td>{% if d.url %}<a href="{{ d.url }}">{{ d.label }}</a>{% else %}<span class="text-muted">{{ d.label }}</span>{% endif %}</td>
               <td>{{ d.depth == 1 ? __('Directe', 'grcmanager') : __('Indirecte (niveau %d)', 'grcmanager')|format(d.depth) }}</td>
               <td>{% if d.availability %}<span class="badge {{ badges[d.availability] ?? 'bg-secondary-lt' }}">{{ levels[d.availability] ?? d.availability }}</span>{% else %}<span class="text-muted">{{ __('Non classée', 'grcmanager') }}</span>{% endif %}</td>
            </tr>
         {% endfor %}
         </tbody>
      </table>
   {% endif %}

   <h4>{{ __('Risques concernés', 'grcmanager') }}</h4>
   {% if analysis.risks is empty %}
      <div class="text-muted">{{ __('Aucun risque du registre n\'est lié à cet élément ni à ce qui en dépend.', 'grcmanager') }}</div>
   {% else %}
      <ul>{% for r in analysis.risks %}<li><a href="{{ r.url }}">{{ r.title }}</a></li>{% endfor %}</ul>
   {% endif %}
</div>
