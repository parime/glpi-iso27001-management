{# Issue #777 : fiche « développement sécurisé » d'une application (onglet de l'application). #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}
<div class="container-fluid" id="grc-application-security">
   <p class="text-muted">
      <i class="ti ti-info-circle me-1"></i>{{ __('Fill in this sheet for each application developed or maintained in-house: it then appears in the register of applications (secure development page) and as evidence for controls A.8.25, A.8.28, A.8.29 and A.8.31.', 'grcmanager') }}
      <a href="{{ register_url }}">{{ __('Open the register', 'grcmanager') }}</a>
   </p>

   {% if has_profile %}
      <div class="mb-3" id="grc-application-security-summary">
         {% if missing is empty and not unjustified and profile.environments_separated == 'yes' %}
            <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-circle-check me-1"></i>{{ __('All secure development practices are in place', 'grcmanager') }}</span>
         {% endif %}
         {% for key in missing %}
            <span class="badge bg-warning-subtle text-warning-emphasis me-1"><i class="ti ti-alert-triangle me-1"></i>{{ __('Missing: %s', 'grcmanager')|format(practices[key]) }}</span>
         {% endfor %}
         {% if profile.environments_separated != 'yes' %}
            <span class="badge bg-danger-subtle text-danger-emphasis me-1"><i class="ti ti-arrows-split me-1"></i>{{ __('Environments not separated', 'grcmanager') }}</span>
         {% endif %}
         {% if unjustified %}
            <span class="badge bg-danger-subtle text-danger-emphasis me-1"><i class="ti ti-message-exclamation me-1"></i>{{ __('No justification', 'grcmanager') }}</span>
         {% endif %}
      </div>
      {% if not can_edit %}
         <dl class="row">
            <dt class="col-sm-4">{{ __('Secure development owner', 'grcmanager') }}</dt>
            <dd class="col-sm-8">{{ owner_name ?: (tech_owner_name ? __('%s (technical owner of the application)', 'grcmanager')|format(tech_owner_name) : '-') }}</dd>
            <dt class="col-sm-4">{{ __('Code repository', 'grcmanager') }}</dt>
            <dd class="col-sm-8">
               {% if repository_link %}<a href="{{ profile.repository_url }}" target="_blank" rel="noopener noreferrer">{{ profile.repository_url }}</a>{% else %}{{ profile.repository_url ?: '-' }}{% endif %}
            </dd>
            <dt class="col-sm-4">{{ __('Secure development framework', 'grcmanager') }}</dt>
            <dd class="col-sm-8">{{ frameworks[profile.framework]|default('-') }}{% if profile.framework_detail %} ({{ profile.framework_detail }}){% endif %}</dd>
            {% for key in ['code_review_required', 'sast', 'dast', 'dependency_scan'] %}
               <dt class="col-sm-4">{{ practices[key] }}</dt>
               <dd class="col-sm-8">{{ profile[key] ? __('Yes', 'grcmanager') : __('No', 'grcmanager') }}</dd>
            {% endfor %}
            <dt class="col-sm-4">{{ __('Tools and frequency of the analyses', 'grcmanager') }}</dt>
            <dd class="col-sm-8">{{ profile.tools|default('-')|nl2br }}</dd>
            <dt class="col-sm-4">{{ __('Separated environments (development, test, production)', 'grcmanager') }}</dt>
            <dd class="col-sm-8">{{ separations[profile.environments_separated]|default('-') }}</dd>
            <dt class="col-sm-4">{{ __('Justification', 'grcmanager') }}</dt>
            <dd class="col-sm-8">{{ profile.separation_justification|default('-')|nl2br }}</dd>
         </dl>
      {% endif %}
   {% elseif not can_edit %}
      <p class="text-muted">{{ __('This application has no secure development sheet yet.', 'grcmanager') }}</p>
   {% endif %}

   {% if can_edit %}
      <form method="post" action="{{ action }}">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="appliances_id" value="{{ appliances_id }}">
         <div class="row">
            {{ fields.dropdownField('User', 'users_id_owner', profile.users_id_owner|default(0), __('Secure development owner', 'grcmanager'), {
               'right': 'all',
               'entity': entities_id,
               'rand': 'grcappsecowner',
               'add_field_html': hints.hint(tech_owner_name ? __('Empty: the technical owner of the application (%s).', 'grcmanager')|format(tech_owner_name) : __('Person accountable for the security of the development of this application.', 'grcmanager')),
            }) }}
            {{ fields.textField('repository_url', profile.repository_url|default(''), __('Code repository', 'grcmanager'), {
               'placeholder': 'https://git.example.org/team/application',
               'add_field_html': hints.hint(__('Address starting with https://, ssh:// or git@.', 'grcmanager')),
            }) }}
            {{ fields.dropdownArrayField('framework', profile.framework|default(''), {'': __('None', 'grcmanager')}|merge(frameworks), __('Secure development framework', 'grcmanager'), {'rand': 'grcappsecframework'}) }}
            {{ fields.textField('framework_detail', profile.framework_detail|default(''), __('Level or version of the framework', 'grcmanager'), {
               'placeholder': __('For example: ASVS 4.0.3 level 2', 'grcmanager'),
            }) }}
         </div>
         <div class="row mb-3">
            {% for key in ['code_review_required', 'sast', 'dast', 'dependency_scan'] %}
               <div class="col-md-3">
                  <label class="form-check">
                     <input type="checkbox" class="form-check-input" name="{{ key }}" value="1" {{ profile[key]|default(0) ? 'checked' : '' }}>
                     <span class="form-check-label">{{ practices[key] }}</span>
                  </label>
               </div>
            {% endfor %}
         </div>
         <div class="row">
            {{ fields.textareaField('tools', profile.tools|default(''), __('Tools and frequency of the analyses', 'grcmanager'), {
               'full_width': true,
               'rows': 2,
               'add_field_html': hints.hint(__('For example: merge request reviewed by a second developer, SAST on each commit, dependency analysis every week, DAST before each release.', 'grcmanager')),
            }) }}
            {{ fields.dropdownArrayField('environments_separated', profile.environments_separated|default(''), separations, __('Separated environments (development, test, production)', 'grcmanager'), {'rand': 'grcappsecseparation'}) }}
            {{ fields.textareaField('separation_justification', profile.separation_justification|default(''), __('Justification', 'grcmanager'), {
               'rows': 3,
               'add_field_html': hints.hint(__('How access, data and configuration are separated, or why they are not (mandatory when the answer is no).', 'grcmanager')),
            }) }}
            {{ fields.textareaField('comment', profile.comment|default(''), __('Comment', 'grcmanager'), {'full_width': true, 'rows': 2}) }}
         </div>
         <button type="submit" name="save" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
         {% if has_profile and profile.date_mod %}
            <span class="text-muted small ms-2">{{ __('Last update: %s', 'grcmanager')|format(profile.date_mod|formatted_datetime) }}</span>
         {% endif %}
      </form>
   {% endif %}
</div>
