{# Issue #852 : couverture MFA par compte (A.8.5, A.5.17), comptes habilités dans les entités de la
   personne. Aucun secret n'est lu ni stocké ; rien n'est modifié dans GLPI. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% macro rate_color(rate) %}{{ rate is null ? 'secondary' : (rate >= 95 ? 'success' : (rate >= 80 ? 'warning' : 'danger')) }}{% endmacro %}
{% macro rate_card(id, icon, title, s, help) %}
   {% import _self as helpers %}
   {% set color = helpers.rate_color(s.rate) %}
   <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
      <div class="d-flex align-items-center">
         <span class="badge bg-{{ color }}-subtle text-{{ color }}-emphasis me-2 fs-3"><i class="{{ icon }}"></i></span>
         <div>
            <div class="fw-bold fs-3" id="{{ id }}">{{ s.rate is null ? '-' : s.rate ~ ' %' }}</div>
            <div class="small">{{ title }}</div>
         </div>
      </div>
      <div class="small text-muted mt-1">{{ _n('%d account', '%d accounts', s.total, 'grcmanager')|format(s.total) }} · {{ __('without MFA: %d', 'grcmanager')|format(s.none) }}{% if s.weak > 0 %} · {{ __('weak method only: %d', 'grcmanager')|format(s.weak) }}{% endif %}</div>
      {% if help %}<div class="small text-muted">{{ help }}</div>{% endif %}
   </div></div></div>
{% endmacro %}

<div id="grc-mfa-coverage">
   <div class="row row-cards mb-3">
      {{ _self.rate_card('grc-mfa-rate', 'ti ti-users', __('Accounts protected by MFA', 'grcmanager'), summary.all, summary.all.excluded > 0 ? __('Excluded with a justification: %d', 'grcmanager')|format(summary.all.excluded) : '') }}
      {{ _self.rate_card('grc-mfa-admin-rate', 'ti ti-crown', __('Administrators protected by MFA', 'grcmanager'), summary.admins, '') }}
      {{ _self.rate_card('grc-mfa-remote-rate', 'ti ti-world-share', __('Remote access accounts protected by MFA', 'grcmanager'), summary.remote, summary.remote.total == 0 ? __('Choose the remote access groups below, or import a remote_access column.', 'grcmanager') : '') }}
      {% set gap_color = summary.gap_accounts > 0 ? 'danger' : 'success' %}
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ gap_color }}-subtle text-{{ gap_color }}-emphasis me-2 fs-3"><i class="ti ti-alert-triangle"></i></span>
            <div>
               <div class="fw-bold fs-3" id="grc-mfa-gaps">{{ summary.gap_accounts }}</div>
               <div class="small">{{ __('Accounts with a gap', 'grcmanager') }}</div>
            </div>
         </div>
         <div class="mt-1">
            {% for code, info in gap_infos %}
               {% if summary.gaps[code] > 0 %}<span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-1 mb-1">{{ info.label }} : {{ summary.gaps[code] }}</span>{% endif %}
            {% endfor %}
         </div>
      </div></div></div>
   </div>

   <div class="alert {{ glpi_enforced ? 'alert-success' : 'alert-info' }} d-flex align-items-start gap-2 mb-3">
      <i class="ti {{ glpi_enforced ? 'ti-shield-check' : 'ti-info-circle' }} fs-2"></i>
      <div>
         {% if glpi_enforced %}
            {{ __('GLPI two-factor authentication is enforced for every account.', 'grcmanager') }}
         {% else %}
            {{ __('GLPI two-factor authentication is not enforced for every account: it can be enforced by profile, group or entity, or for everyone in the general configuration (Security tab).', 'grcmanager') }}
         {% endif %}
         {{ __('Accounts that sign in through your identity provider are covered by the methods you import below.', 'grcmanager') }}
      </div>
   </div>

   {# Comptes : écarts d'abord, administrateurs en tête. #}
   <div class="card mb-3" id="grc-mfa-list">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-list-details me-2"></i>{{ __('Accounts and authentication methods', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_rows }}</span></div>
      </div>
      {% if rows is empty %}
         <div class="card-body text-muted">{{ __('No active account in your entities.', 'grcmanager') }}</div>
      {% else %}
         {% if total_rows > rows|length %}
            <div class="card-body small pb-0">{{ __('%1$d accounts: the first %2$d are shown, gaps first.', 'grcmanager')|format(total_rows, rows|length) }}</div>
         {% endif %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Account', 'grcmanager') }}</th>
                  <th>{{ __('MFA', 'grcmanager') }}</th>
                  <th>{{ __('Methods', 'grcmanager') }}</th>
                  <th>{{ __('Source', 'grcmanager') }}</th>
                  <th>{{ __('Gaps', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for row in rows %}
                  {% set level = levels[row.level] %}
                  <tr>
                     <td>
                        <a href="{{ row.url }}">{{ row.fullname }}</a>
                        <div class="small text-muted">{{ row.name }}</div>
                        {% if row.is_admin %}<span class="badge bg-purple-subtle text-purple-emphasis me-1"><i class="ti ti-crown me-1"></i>{{ __('Administrator', 'grcmanager') }}</span>{% endif %}
                        {% if row.is_remote %}<span class="badge bg-azure-subtle text-azure-emphasis me-1"><i class="ti ti-world-share me-1"></i>{{ __('Remote access', 'grcmanager') }}</span>{% endif %}
                     </td>
                     <td>
                        <span class="badge bg-{{ level.color }}-subtle text-{{ level.color }}-emphasis"><i class="{{ level.icon }} me-1"></i>{{ level.label }}</span>
                        {% if row.is_excluded %}<div class="mt-1"><span class="badge bg-secondary-subtle text-secondary-emphasis" title="{{ row.reason }}"><i class="ti ti-user-off me-1"></i>{{ __('Excluded', 'grcmanager') }}</span>{% if row.reason %} <span class="small text-muted">{{ row.reason }}</span>{% endif %}</div>{% endif %}
                        {% if row.unenforced %}<div class="small text-muted mt-1">{{ __('Exempted from GLPI two-factor enforcement', 'grcmanager') }}</div>{% endif %}
                     </td>
                     <td class="small">
                        {% for method in row.methods %}
                           <span class="badge {{ method in row.weak_methods ? 'bg-warning-subtle text-warning-emphasis' : 'bg-secondary-subtle text-secondary-emphasis' }} me-1 mb-1">{{ method }}</span>
                        {% else %}
                           <span class="text-muted">{{ __('None declared', 'grcmanager') }}</span>
                        {% endfor %}
                     </td>
                     <td class="small">{{ row.sources is empty ? '-' : row.sources|join(', ') }}</td>
                     <td>
                        {% for gap in row.gaps %}
                           {% set info = gap_infos[gap] %}
                           <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-1 mb-1"><i class="ti ti-alert-triangle me-1"></i>{{ info.label }}</span>
                        {% endfor %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Comptes importés sans compte GLPI correspondant. #}
   {% if unmatched is not empty %}
      <div class="card mb-3" id="grc-mfa-unmatched">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-user-question me-2"></i>{{ __('Imported accounts not matched with a GLPI account', 'grcmanager') }}</h3>
            <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ unmatched|length }}</span></div>
         </div>
         <div class="card-body small pb-0 text-muted">{{ __('They are matched on the login, the email address, or the part of the user principal name before the @. Check them: an account unknown in GLPI may be a service account or a former employee.', 'grcmanager') }}</div>
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
               <thead><tr><th>{{ __('Identity provider', 'grcmanager') }}</th><th>{{ __('Account', 'grcmanager') }}</th><th>{{ __('MFA', 'grcmanager') }}</th><th>{{ __('Methods', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for row in unmatched %}
                  {% set level = levels[row.level] %}
                  <tr>
                     <td>{{ row.provider }}</td>
                     <td>{{ row.account }}{% if row.email and row.email != row.account %}<div class="small text-muted">{{ row.email }}</div>{% endif %}{% if row.is_admin %} <span class="badge bg-purple-subtle text-purple-emphasis"><i class="ti ti-crown me-1"></i>{{ __('Administrator', 'grcmanager') }}</span>{% endif %}</td>
                     <td><span class="badge bg-{{ level.color }}-subtle text-{{ level.color }}-emphasis"><i class="{{ level.icon }} me-1"></i>{{ level.label }}</span></td>
                     <td class="small">{{ row.methods|join(', ') }}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      </div>
   {% endif %}

   {# Import des méthodes d'authentification d'un fournisseur d'identité. #}
   <div class="card mb-3" id="grc-mfa-import">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-file-import me-2"></i>{{ __('Methods registered with your identity provider', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="small">{{ __('Export the authentication methods registered per user from your identity provider, then import the CSV file here. A new import of the same provider replaces the previous one in the current entity. Only method names are kept, never a secret.', 'grcmanager') }}</p>
         <ul class="small text-muted">
            <li>{{ __('Microsoft Entra ID: Protection > Authentication methods > User registration details, download (columns userPrincipalName, methodsRegistered, isMfaRegistered, isAdmin).', 'grcmanager') }}</li>
            <li>{{ __('Okta, Google Workspace or an on-premises solution: a CSV file with a header, one account per line.', 'grcmanager') }}</li>
            <li>{{ __('Recognized columns: login or email; methods (separated by commas or semicolons) or mfa (yes/no); optional admin, remote_access, excluded and exclusion_reason (yes/no and text).', 'grcmanager') }}</li>
            <li>{{ __('SMS, phone call and email codes are reported as weak methods.', 'grcmanager') }}</li>
         </ul>
         {% if imports is not empty %}
            <table class="table table-sm mb-3">
               <thead><tr><th>{{ __('Identity provider', 'grcmanager') }}</th><th class="text-end">{{ __('Imported accounts', 'grcmanager') }}</th><th class="text-end">{{ __('Matched', 'grcmanager') }}</th><th>{{ __('Last import', 'grcmanager') }}</th>{% if can_manage %}<th><span class="visually-hidden">{{ __('Actions') }}</span></th>{% endif %}</tr></thead>
               <tbody>
               {% for import in imports %}
                  <tr>
                     <td>{{ import.label }}</td>
                     <td class="text-end">{{ import.count }}</td>
                     <td class="text-end">{{ import.matched }}</td>
                     <td>{{ import.date }}</td>
                     {% if can_manage %}
                        <td class="text-end">
                           <form method="post" action="{{ action }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="provider" value="{{ import.provider }}">
                              <button type="submit" class="btn btn-sm btn-outline-danger" name="clear_mfa" value="1"><i class="ti ti-trash me-1"></i>{{ __('Delete the import', 'grcmanager') }}</button>
                           </form>
                        </td>
                     {% endif %}
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         {% endif %}
         {% if can_manage %}
            <form method="post" action="{{ action }}" enctype="multipart/form-data" class="row g-2 align-items-end">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="col-md-4">
                  <label class="form-label" for="grc-mfa-provider">{{ __('Identity provider', 'grcmanager') }}</label>
                  <select class="form-select" id="grc-mfa-provider" name="provider">
                     {% for value, label in providers %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                  </select>
               </div>
               <div class="col-md-5">
                  <label class="form-label" for="grc-mfa-file">{{ __('CSV file', 'grcmanager') }}</label>
                  <input type="file" class="form-control" id="grc-mfa-file" name="mfa_file" accept=".csv,.txt,text/csv" required>
               </div>
               <div class="col-md-3">
                  <button type="submit" class="btn btn-primary" name="import_mfa" value="1"><i class="ti ti-upload me-1"></i>{{ __('Import', 'grcmanager') }}</button>
               </div>
            </form>
         {% endif %}
      </div>
   </div>

   {# Lecture directe d'Entra ID par Microsoft Graph (#852), sur clic, en lecture seule. #}
   <div class="card mb-3" id="grc-mfa-graph">
      <div class="card-header">
         <h3 class="card-title d-flex align-items-center flex-wrap gap-2">
            <i class="ti ti-cloud-download"></i>{{ __('Read Microsoft Entra ID directly (Microsoft Graph)', 'grcmanager') }}
            <span class="badge bg-azure-subtle text-azure-emphasis"><i class="ti ti-eye me-1"></i>{{ __('Read only', 'grcmanager') }}</span>
            {% if graph.configured %}
               <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
            {% else %}
               <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-off me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
            {% endif %}
         </h3>
      </div>
      <div class="card-body">
         <p class="small">{{ __('Instead of downloading the CSV export, GLPI can read the same report (user registration details) from Microsoft Graph when you click the button. The result replaces the Microsoft Entra ID import of the current entity. Nothing is ever written in Entra ID and nothing runs automatically.', 'grcmanager') }}</p>
         <ol class="small text-muted">
            <li>{{ __('In the Entra admin center, App registrations > New registration: create an application (for example "GLPI GRC - MFA report").', 'grcmanager') }}</li>
            <li>{{ __('API permissions > Add a permission > Microsoft Graph > Application permissions: AuditLog.Read.All, then Grant admin consent. The report requires an Entra ID P1 or P2 licence.', 'grcmanager') }}</li>
            <li>{{ __('Certificates & secrets > New client secret, then copy here the tenant ID, the application (client) ID and the secret value.', 'grcmanager') }}</li>
         </ol>
         {% if can_manage %}
            <form method="post" action="{{ action }}" class="row g-2 align-items-end">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="col-md-4">
                  <label class="form-label" for="grc-mfa-graph-tenant">{{ __('Tenant (directory) ID or domain', 'grcmanager') }}</label>
                  <input type="text" class="form-control" id="grc-mfa-graph-tenant" name="mfa_graph_tenant" value="{{ graph.tenant }}" maxlength="253" placeholder="example.onmicrosoft.com" autocomplete="off">
               </div>
               <div class="col-md-4">
                  <label class="form-label" for="grc-mfa-graph-client">{{ __('Application (client) ID', 'grcmanager') }}</label>
                  <input type="text" class="form-control" id="grc-mfa-graph-client" name="mfa_graph_client_id" value="{{ graph.client_id }}" maxlength="36" placeholder="00000000-0000-0000-0000-000000000000" autocomplete="off">
               </div>
               <div class="col-md-4">
                  <label class="form-label" for="grc-mfa-graph-secret">{{ __('Client secret', 'grcmanager') }}</label>
                  <input type="password" class="form-control" id="grc-mfa-graph-secret" name="mfa_graph_secret" value="" autocomplete="new-password" placeholder="{{ graph.has_secret ? __('Secret saved (leave empty to keep it)', 'grcmanager') : '' }}">
               </div>
               <div class="col-12 form-hint">
                  {% if graph.has_secret %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Secret saved', 'grcmanager') }}</span>{% endif %}
                  {{ __('The secret is encrypted with the GLPI key, never displayed again nor logged.', 'grcmanager') }}
                  {% if graph.has_secret %}
                     <span class="form-check form-check-inline ms-2">
                        <input type="checkbox" class="form-check-input" id="grc-mfa-graph-clear" name="mfa_graph_clear_secret" value="1">
                        <label class="form-check-label" for="grc-mfa-graph-clear">{{ __('Delete the saved secret', 'grcmanager') }}</label>
                     </span>
                  {% endif %}
               </div>
               <div class="col-12 d-flex flex-wrap gap-2">
                  <button type="submit" class="btn btn-outline-primary" name="save_mfa_graph" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
                  {% if graph.configured %}
                     <button type="submit" class="btn btn-primary" name="fetch_mfa_graph" value="1"><i class="ti ti-refresh me-1"></i>{{ __('Read now from Microsoft Graph', 'grcmanager') }}</button>
                  {% endif %}
               </div>
            </form>
         {% else %}
            <p class="small text-muted mb-0">{{ __('Only users who can modify the plugin data can set up this reading.', 'grcmanager') }}</p>
         {% endif %}
      </div>
   </div>

   {# Comptes à accès distant : groupes GLPI choisis. #}
   <div class="card mb-3" id="grc-mfa-remote">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-world-share me-2"></i>{{ __('Which accounts have remote access?', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="small mb-2">
            {% if remote_names is empty %}
               {{ __('No group chosen: only the accounts marked remote_access in an import count as remote access accounts.', 'grcmanager') }}
            {% else %}
               {{ __('Members of these groups have remote access: %s.', 'grcmanager')|format(remote_names|join(', ')) }}
            {% endif %}
         </p>
         {% if can_manage %}
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               {{ fields.dropdownField('Group', 'mfa_remote_groups', remote_groups, __('Remote access groups (VPN, remote desktop...)', 'grcmanager'), {
                  'multiple': true,
                  'entity': -1,
               }) }}
               <button type="submit" class="btn btn-primary" name="save_mfa_remote" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
            </form>
         {% endif %}
      </div>
   </div>

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted small me-auto">
         <i class="ti ti-shield-lock me-1"></i>{{ __('Administrators are the accounts whose profile can change the GLPI configuration or the profiles, or that the identity provider reports as administrators. Nothing is changed in GLPI from this page.', 'grcmanager') }}
      </span>
      <a class="btn btn-sm btn-outline-secondary" href="{{ hygiene_url }}"><i class="ti ti-user-search me-1"></i>{{ __('Account hygiene', 'grcmanager') }}</a>
      <a class="btn btn-sm btn-outline-secondary" href="{{ personnel_url }}"><i class="ti ti-id-badge me-1"></i>{{ __('Personnel security compliance', 'grcmanager') }}</a>
      <a class="btn btn-sm btn-outline-primary" href="{{ review_url }}"><i class="ti ti-checklist me-1"></i>{{ __('Access reviews', 'grcmanager') }}</a>
   </div>
</div>
