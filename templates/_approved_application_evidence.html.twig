{# Issue #622 : cadre de preuve du registre des applications approuvées (mesure A.5.23), dans les entités
   de la personne. Reçoit « evidence » (ApprovedApplication::evidence()), affiché par control_form.html.twig. #}
<div id="grc-approved-application-evidence">
   {% set i = evidence.indicators %}
   <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-apps me-1"></i>{{ __('Applications in the register: %d', 'grcmanager')|format(i.total) }}</span>
   <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-circle-check me-1"></i>{{ __('Approved: %d', 'grcmanager')|format(i.approved + i.restricted) }}</span>
   <span class="badge bg-danger-subtle text-danger-emphasis me-1"><i class="ti ti-ban me-1"></i>{{ __('Refused: %d', 'grcmanager')|format(i.refused) }}</span>
   <span class="badge {{ i.review_overdue > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-calendar-repeat me-1"></i>{{ __('Reviews overdue: %d', 'grcmanager')|format(i.review_overdue) }}</span>
   <span class="badge {{ i.with_gaps > 0 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success-emphasis' }} me-1"><i class="ti ti-alert-triangle me-1"></i>{{ __('To complete: %d', 'grcmanager')|format(i.with_gaps) }}</span>
   <span class="small text-muted me-2">{{ __('Computed on %s', 'grcmanager')|format(evidence.date) }}</span>
   <a href="{{ evidence.url }}">{{ __('View the details', 'grcmanager') }}</a>
</div>
