{# Historique des mesures d'un objectif (issue #199 : passé de PHP à Twig). Hors du formulaire de
   l'objectif : ces mini formulaires postent vers front/objectivemeasurement.form.php. #}
<div class="card mt-3"><div class="card-body">
   <h3>{{ __('Measurement history', 'grcmanager') }}</h3>
   {% if can_edit %}
      <form method="post" action="{{ action }}" class="mb-3">
         <input type="hidden" name="plugin_grcmanager_objectives_id" value="{{ objective_id }}">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <div class="row g-2 align-items-end">
            <div class="col-md-3">
               <label class="form-label" for="grc-measure-date">{{ __('Measurement date', 'grcmanager') }}</label>
               <input type="date" id="grc-measure-date" name="measurement_date" value="{{ today }}" class="form-control">
            </div>
            <div class="col-md-2">
               <label class="form-label" for="grc-measure-value">{{ __('Value', 'grcmanager') }}</label>
               <input type="text" id="grc-measure-value" name="value" class="form-control">
            </div>
            <div class="col-md-5">
               <label class="form-label" for="grc-measure-comment">{{ __('Comment', 'grcmanager') }}</label>
               <input type="text" id="grc-measure-comment" name="comment" class="form-control">
            </div>
            <div class="col-md-2">
               <button type="submit" name="add" value="1" class="btn btn-primary">{{ __('Ajouter') }}</button>
            </div>
         </div>
         <div class="form-hint mt-1">{{ numeric ? __('A numeric value is required for this quantitative objective.', 'grcmanager') : __('Qualitative objective: the value stays optional, but a comment is then required.', 'grcmanager') }}</div>
      </form>
   {% endif %}
   <table class="table">
      <thead><tr><th>{{ __('Measurement date', 'grcmanager') }}</th><th>{{ __('Value', 'grcmanager') }}</th><th>{{ __('Comment', 'grcmanager') }}</th>{% if can_purge %}<th></th>{% endif %}</tr></thead>
      <tbody>
         {% for m in measurements %}
            <tr>
               <td>{{ m.measurement_date|formatted_date }}</td>
               <td>{{ m.value ?? '' }}</td>
               <td>{{ m.comment ?? '' }}</td>
               {% if can_purge %}
                  <td>
                     <form method="post" action="{{ action }}" data-grc-confirm="{{ __('Confirm deletion?', 'grcmanager') }}">
                        <input type="hidden" name="id" value="{{ m.id }}">
                        <input type="hidden" name="plugin_grcmanager_objectives_id" value="{{ objective_id }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <button type="submit" name="purge" value="1" class="btn btn-sm btn-outline-danger" aria-label="{{ __('Supprimer') }}"><i class="ti ti-trash"></i></button>
                     </form>
                  </td>
               {% endif %}
            </tr>
         {% else %}
            <tr><td colspan="{{ can_purge ? 4 : 3 }}" class="text-muted">{{ __('No measurement recorded yet.', 'grcmanager') }}</td></tr>
         {% endfor %}
      </tbody>
   </table>
</div></div>
{% include '@grcmanager/_confirm_forms.html.twig' %}
