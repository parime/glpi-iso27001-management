{# Issue #703 : fiche d'une exigence NIS2 Italia - ACN (« DE.CM-01, punto 2 »). #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   <input type="hidden" name="{{ links_marker }}" value="1">

   {{ fields.smallTitle(__('ACN requirement', 'grcmanager'), 'ti ti-flag') }}
   {% set header_html %}
      <div class="d-flex flex-wrap align-items-center gap-2">
         <span class="badge bg-blue-subtle text-blue-emphasis fs-5"><i class="ti ti-hash me-1"></i>{{ reference }}</span>
         <strong>{{ measure }}</strong>
         <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ function }}</span>
         {% for annex in annexes %}
            <span class="badge bg-azure-subtle text-azure-emphasis">{{ __('Annex %d', 'grcmanager')|format(annex) }}</span>
         {% endfor %}
         {% if approval_required %}
            <span class="badge bg-purple-subtle text-purple-emphasis"><i class="ti ti-signature me-1"></i>{{ __('Management approval required', 'grcmanager') }}</span>
         {% endif %}
      </div>
   {% endset %}
   {{ fields.htmlField('', header_html, __('Requirement', 'grcmanager'), {'full_width': true}) }}
   {{ fields.htmlField('', summary, __('Summary', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Summary written by this project to help you find the requirement. Only the text published by the ACN is authentic: open the source below.', 'grcmanager')),
   }) }}
   {% set source_html %}
      <i class="ti ti-file-text me-1"></i>{{ law }}, {{ __('ACN determination %s', 'grcmanager')|format(determination) }}, {{ reference }}
      - <a href="{{ source_url }}" class="text-decoration-underline" target="_blank" rel="noopener noreferrer">acn.gov.it<i class="ti ti-external-link ms-1"></i></a>
   {% endset %}
   {{ fields.htmlField('', source_html, __('Official reference', 'grcmanager'), {'full_width': true}) }}
   {% if not in_scope %}
      <div class="col-12">
         <div class="alert alert-warning d-flex align-items-start">
            <i class="ti ti-alert-triangle me-2 mt-1"></i>
            <div>{{ __('This requirement only applies to essential entities: it is not part of the catalogue of this entity (%s). It is kept in case the classification changes.', 'grcmanager')|format(category_label ?: '-') }}</div>
         </div>
      </div>
   {% endif %}

   {{ fields.smallTitle(__('Compliance', 'grcmanager'), 'ti ti-list-check') }}
   {{ fields.dropdownArrayField('applicability', item.fields['applicability'] ?: 'yes', applicabilities, __('Applicability', 'grcmanager')) }}
   {{ fields.dropdownArrayField('implementation_status', item.fields['implementation_status'] ?: 'not_started', statuses, __('Implementation status', 'grcmanager')) }}
   {{ fields.textareaField('justification', item.fields['justification'], __('Justification', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Required when the requirement is not fully applicable: the ACN accepts exceptions only for reasons that are justified and documented.', 'grcmanager')),
   }) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dateField('due_date', item.fields['due_date'], __('Due date', 'grcmanager')) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Notes', 'grcmanager'), {'full_width': true}) }}

   {% if approval_required %}
      {{ fields.smallTitle(__('Approval by the management bodies', 'grcmanager'), 'ti ti-signature') }}
      {{ fields.dateField('approval_date', item.fields['approval_date'], __('Approval date', 'grcmanager'), {
         'add_field_html': hints.hint(__('This point requires the approval of the administrative and management bodies. Record the date and attach the minutes in the Documents tab.', 'grcmanager')),
      }) }}
      {{ fields.textField('approval_reference', item.fields['approval_reference'], __('Approval reference', 'grcmanager'), {
         'add_field_html': hints.hint(__('For example "Board resolution no. 12 of 3 March".', 'grcmanager')),
      }) }}
   {% endif %}

   {{ fields.smallTitle(__('Policies and documents', 'grcmanager'), 'ti ti-file-certificate') }}
   {% if can_link_policy %}
      {{ fields.dropdownArrayField('_linked_policies', '', policy_choices, __('Related policies', 'grcmanager'), {
         'multiple': true, 'values': policy_values, 'full_width': true,
         'add_field_html': policy_hidden > 0
            ? hints.hint(_n('%d other linked item is not shown to you.', '%d other linked items are not shown to you.', policy_hidden, 'grcmanager')|format(policy_hidden))
            : hints.hint(__('Policies of this plugin that answer the requirement. Procedures, plans and evidence go in the Documents tab.', 'grcmanager')),
      }) }}
      {% if policies is not empty %}
         {% set policies_html %}
            <ul class="list-unstyled mb-0">
            {% for policy in policies %}
               <li class="mb-1">
                  <a href="{{ policy.url }}"><i class="ti ti-shield-lock me-1"></i>{{ policy.title }}</a>
                  {% if policy.approved %}
                     <span class="badge bg-green-subtle text-green-emphasis ms-1"><i class="ti ti-circle-check me-1"></i>{{ policy.status }}{% if policy.approval_date %} ({{ policy.approval_date }}){% endif %}</span>
                  {% else %}
                     <span class="badge bg-orange-subtle text-orange-emphasis ms-1"><i class="ti ti-clock me-1"></i>{{ policy.status }}</span>
                  {% endif %}
               </li>
            {% endfor %}
            </ul>
         {% endset %}
         {{ fields.htmlField('', policies_html, __('Approval of the linked policies', 'grcmanager'), {'full_width': true}) }}
      {% endif %}
   {% endif %}

   {% if nis2 is not empty or nist_text or annex_a is not empty %}
      {{ fields.smallTitle(__('Related references', 'grcmanager'), 'ti ti-arrows-exchange') }}
      {% if nis2 is not empty %}
         {% set nis2_html %}
            {% for key, text in nis2 %}<div class="mb-1"><span class="badge bg-indigo-subtle text-indigo-emphasis me-1">NIS2 {{ key }}</span>{{ text }}</div>{% endfor %}
         {% endset %}
         {{ fields.htmlField('', nis2_html, __('NIS2 directive (EU)', 'grcmanager'), {
            'full_width': true,
            'add_field_html': hints.hint(__('Indicative mapping made by this project.', 'grcmanager')),
         }) }}
      {% endif %}
      {% if nist_text %}
         {% set nist_html %}<span class="badge bg-blue-subtle text-blue-emphasis me-1">{{ item.fields['code'] }}</span>{{ nist_text }}{% endset %}
         {{ fields.htmlField('', nist_html, 'NIST CSF 2.0', {'full_width': true}) }}
      {% endif %}
      {% if annex_a is not empty %}
         {% set iso_html %}
            {% for control in annex_a %}
               {% if control.url %}
                  <a href="{{ control.url }}" class="badge bg-teal-subtle text-teal-emphasis me-1 mb-1 text-decoration-none" title="{{ control.title }}">{{ control.code }}</a>
               {% else %}
                  <span class="badge bg-teal-subtle text-teal-emphasis me-1 mb-1" title="{{ control.title }}">{{ control.code }}</span>
               {% endif %}
            {% endfor %}
         {% endset %}
         {{ fields.htmlField('', iso_html, __('ISO 27001 Annex A (optional)', 'grcmanager'), {
            'full_width': true,
            'add_field_html': hints.hint(__('Controls that NIST links to this subcategory. You do not need the Statement of Applicability to follow this requirement.', 'grcmanager')),
         }) }}
      {% endif %}
   {% endif %}

   {% set back_html %}<a href="{{ register_url }}"><i class="ti ti-arrow-left me-1"></i>{{ __('Back to the NIS2 Italy register', 'grcmanager') }}</a>{% endset %}
   {{ fields.htmlField('', back_html, '', {'full_width': true}) }}
{% endblock %}
