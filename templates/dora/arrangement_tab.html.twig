{# Issue #540 : onglet « Registre DORA » d'un contrat : accord contractuel (B_02.01, B_02.02, B_07.01),
   fonctions soutenues (B_06.01) et chaîne de sous-traitance (B_05.02). #}
{% import '@grcmanager/dora/_macros.html.twig' as m %}

<div class="grc-dora-arrangement">
{% if not in_register %}
   <div class="card">
      <div class="card-body">
         <h3 class="card-title"><i class="ti ti-building-bank me-2"></i>{{ __('DORA register of information', 'grcmanager') }}</h3>
         <p>{{ __('Financial entities must keep a register of all their contracts for ICT services (DORA, article 28). Add this contract if it covers an ICT service: its number, dates, duration, notice and costs are taken from GLPI; you only add what is specific to DORA.', 'grcmanager') }}</p>
         <span class="badge bg-secondary-lt mb-3" id="grc-dora-not-in-register"><i class="ti ti-minus me-1"></i>{{ __('Not in the register', 'grcmanager') }}</span>
         {% if can_edit %}
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="contracts_id" value="{{ contract_id }}">
               <button type="submit" name="include" value="1" class="btn btn-primary" id="grc-dora-include"><i class="ti ti-plus me-1"></i>{{ __('Add this contract to the DORA register', 'grcmanager') }}</button>
            </form>
         {% endif %}
      </div>
   </div>
{% else %}
   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="badge bg-green-lt" id="grc-dora-in-register"><i class="ti ti-building-bank me-1"></i>{{ __('In the DORA register', 'grcmanager') }}</span>
      {% if is_critical %}
         <span class="badge bg-red-lt" id="grc-dora-critical"><i class="ti ti-flame me-1"></i>{{ __('Supports a critical or important function', 'grcmanager') }}</span>
      {% else %}
         <span class="badge bg-azure-lt"><i class="ti ti-info-circle me-1"></i>{{ __('No critical or important function supported: fewer fields are required', 'grcmanager') }}</span>
      {% endif %}
      <a href="{{ register_url }}" class="ms-auto"><i class="ti ti-building-bank me-1"></i>{{ __('Open the DORA register', 'grcmanager') }}</a>
   </div>

   {{ m.issues(issues, __('Missing for the register', 'grcmanager')) }}
   {% if provider_issues is not empty %}
      <div class="alert alert-warning mb-3" id="grc-dora-provider-issues">
         <i class="ti ti-building-skyscraper me-1"></i>{{ __('%d field(s) are missing on the provider of this contract.', 'grcmanager')|format(provider_issues|length) }}
         <a href="{{ provider_url }}" class="ms-1">{{ __('Complete the provider', 'grcmanager') }}</a>
      </div>
   {% endif %}

   <form method="post" action="{{ action }}" id="grc-dora-arrangement-form">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="contracts_id" value="{{ contract_id }}">
      <fieldset {{ can_edit ? '' : 'disabled' }}>

      {# ------------------------------------------------------------ Accord #}
      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title"><i class="ti ti-file-certificate me-2"></i>{{ __('Contractual arrangement', 'grcmanager') }}</h3></div>
         <div class="card-body row g-3">
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-reference', __('Contract reference number', 'grcmanager'), 'B_02.01.0010', issues, true) }}
               <input type="text" class="form-control" name="reference" id="grc-dora-reference" maxlength="255" value="{{ dora.reference }}" placeholder="{{ contract_num }}">
               <div class="form-hint">{{ __('Empty: the number of the contract in GLPI. It must stay the same over time.', 'grcmanager') }}</div>
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-type', __('Type of contractual arrangement', 'grcmanager'), 'B_02.01.0020', issues, true) }}
               {{ m.select('arrangement_type', options.arrangement_type, dora.arrangement_type, 'grc-dora-type') }}
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-overarching', __('Reference of the overarching arrangement', 'grcmanager'), 'B_02.01.0030', issues, false) }}
               <input type="text" class="form-control" name="overarching_reference" id="grc-dora-overarching" maxlength="255" value="{{ dora.overarching_reference }}">
               <div class="form-hint">{{ __('Only for a subsequent or associated arrangement.', 'grcmanager') }}</div>
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-cost', __('Annual cost for the past year', 'grcmanager'), 'B_02.01.0050', issues, true) }}
               <div class="input-group">
                  <input type="text" class="form-control" name="annual_cost" id="grc-dora-cost" value="{{ dora.annual_cost }}" inputmode="decimal">
                  <input type="text" class="form-control text-uppercase" name="currency" maxlength="3" style="max-width: 5.5rem" value="{{ dora.currency }}" placeholder="{{ currency }}" aria-label="{{ __('Currency', 'grcmanager') }}">
               </div>
               <div class="form-hint">
                  {% if computed_cost is not null %}
                     {{ __('Empty: the costs of the contract over the last twelve months (Costs tab), currently %s.', 'grcmanager')|format(computed_cost|number_format(2, ',', ' ') ~ ' ' ~ currency) }}
                  {% else %}
                     {{ __('Empty: the costs of the contract over the last twelve months (Costs tab of the contract): none entered yet.', 'grcmanager') }}
                  {% endif %}
               </div>
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-provider', __('ICT third-party service provider', 'grcmanager'), 'B_02.02.0030', issues, true) }}
               {% if suppliers is empty %}
                  <div class="text-danger small" id="grc-dora-no-supplier"><i class="ti ti-alert-circle me-1"></i>{{ __('Link the provider to this contract first (Suppliers tab of the contract).', 'grcmanager') }}</div>
               {% else %}
                  <select class="form-select" name="suppliers_id" id="grc-dora-provider">
                     {% if suppliers|length > 1 %}<option value="0">{{ __('Not filled in', 'grcmanager') }}</option>{% endif %}
                     {% for id, name in suppliers %}
                        <option value="{{ id }}" {{ provider == id ? 'selected' : '' }}>{{ name }}</option>
                     {% endfor %}
                  </select>
                  {% if provider_url %}<a href="{{ provider_url }}" class="small"><i class="ti ti-building-skyscraper me-1"></i>{{ __('Provider information', 'grcmanager') }}</a>{% endif %}
               {% endif %}
            </div>
            <div class="col-12 col-md-4">
               <div class="form-label">{{ __('Dates of the contract (from GLPI)', 'grcmanager') }} <span class="badge bg-secondary-lt fw-normal">B_02.02.0070-0080</span></div>
               <div>
                  <i class="ti ti-calendar me-1"></i>
                  {% if begin_date %}{{ begin_date|formatted_date }}{% else %}<span class="text-danger">{{ __('Start date missing in the contract', 'grcmanager') }}</span>{% endif %}
                  <i class="ti ti-arrow-right mx-1"></i>
                  {% if is_open_ended %}{{ __('No end date', 'grcmanager') }}{% elseif end_date %}{{ end_date|formatted_date }}{% endif %}
               </div>
               {% if has_ended %}<span class="badge bg-orange-lt mt-1"><i class="ti ti-clock-off me-1"></i>{{ __('Ended', 'grcmanager') }}</span>{% endif %}
            </div>
            <div class="col-12">
               {{ m.label('grc-dora-services', __('Type of ICT services', 'grcmanager'), 'B_02.02.0060', issues, true) }}
               <div class="row g-1" id="grc-dora-services">
                  {% for code, label in service_types %}
                     <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-check mb-0">
                           <input class="form-check-input" type="checkbox" name="service_types[]" value="{{ code }}" {{ code in selected_types ? 'checked' : '' }}>
                           <span class="form-check-label"><span class="badge bg-blue-lt me-1">{{ code }}</span>{{ label }}</span>
                        </label>
                     </div>
                  {% endfor %}
               </div>
            </div>
            {% if has_ended or dora.termination_reason > 0 %}
               <div class="col-12 col-md-6">
                  {{ m.label('grc-dora-termination', __('Reason for the end of the contract', 'grcmanager'), 'B_02.02.0090', issues, has_ended) }}
                  {{ m.select('termination_reason', options.termination_reason, dora.termination_reason, 'grc-dora-termination') }}
               </div>
            {% endif %}
         </div>
      </div>

      {# ------------------------------------------------------------ Préavis, droit et données #}
      <div class="card mb-3">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-world me-2"></i>{{ __('Notice, law and data', 'grcmanager') }}</h3>
            {% if is_critical %}<span class="card-actions badge bg-red-lt">{{ __('Required: critical or important function', 'grcmanager') }}</span>{% endif %}
         </div>
         <div class="card-body row g-3">
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-notice-entity', __('Notice period for the financial entity', 'grcmanager'), 'B_02.02.0100', issues, is_critical) }}
               <div class="input-group">
                  <input type="number" min="0" class="form-control" name="notice_entity_days" id="grc-dora-notice-entity" value="{{ dora.notice_entity_days }}">
                  <span class="input-group-text">{{ __('days', 'grcmanager') }}</span>
               </div>
               {% if contract_notice > 0 %}<div class="form-hint">{{ __('Notice in the contract: %d month(s).', 'grcmanager')|format(contract_notice) }}</div>{% endif %}
            </div>
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-notice-provider', __('Notice period for the provider', 'grcmanager'), 'B_02.02.0110', issues, is_critical) }}
               <div class="input-group">
                  <input type="number" min="0" class="form-control" name="notice_provider_days" id="grc-dora-notice-provider" value="{{ dora.notice_provider_days }}">
                  <span class="input-group-text">{{ __('days', 'grcmanager') }}</span>
               </div>
            </div>
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-law', __('Country of the governing law', 'grcmanager'), 'B_02.02.0120', issues, is_critical) }}
               <input type="text" class="form-control text-uppercase" name="governing_law_country" id="grc-dora-law" maxlength="2" value="{{ dora.governing_law_country }}" placeholder="FR">
            </div>
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-provision', __('Country of provision of the services', 'grcmanager'), 'B_02.02.0130', issues, is_critical) }}
               <input type="text" class="form-control text-uppercase" name="provision_country" id="grc-dora-provision" maxlength="2" value="{{ dora.provision_country }}" placeholder="FR">
            </div>
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-storage', __('Storage of data', 'grcmanager'), 'B_02.02.0140', issues, is_critical) }}
               {{ m.select('data_storage', options.yes_no, dora.data_storage, 'grc-dora-storage') }}
               <div class="form-hint">{{ __('Does the service store data, even temporarily?', 'grcmanager') }}</div>
            </div>
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-storage-countries', __('Location of the data at rest', 'grcmanager'), 'B_02.02.0150', issues, false) }}
               <input type="text" class="form-control text-uppercase" name="storage_countries" id="grc-dora-storage-countries" maxlength="255" value="{{ dora.storage_countries }}" placeholder="FR, DE">
            </div>
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-processing-countries', __('Location of data processing', 'grcmanager'), 'B_02.02.0160', issues, is_critical) }}
               <input type="text" class="form-control text-uppercase" name="processing_countries" id="grc-dora-processing-countries" maxlength="255" value="{{ dora.processing_countries }}" placeholder="FR">
            </div>
            <div class="col-12 col-md-3">
               {{ m.label('grc-dora-sensitivity', __('Sensitiveness of the data', 'grcmanager'), 'B_02.02.0170', issues, false) }}
               {{ m.select('data_sensitivity', options.sensitivity, dora.data_sensitivity, 'grc-dora-sensitivity') }}
            </div>
            <div class="col-12">
               <div class="form-hint"><i class="ti ti-info-circle me-1"></i>{{ __('Countries: two-letter ISO codes separated by commas, for example FR, DE, IE. Each country becomes a line of the register.', 'grcmanager') }}</div>
            </div>
         </div>
      </div>

      {# ------------------------------------------------------------ Dépendance et sortie #}
      <div class="card mb-3">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-arrows-exchange me-2"></i>{{ __('Reliance, substitutability and exit', 'grcmanager') }}</h3>
            {% if is_critical %}<span class="card-actions badge bg-red-lt">{{ __('Required: critical or important function', 'grcmanager') }}</span>{% endif %}
         </div>
         <div class="card-body row g-3">
            <div class="col-12 col-md-6">
               {{ m.label('grc-dora-reliance', __('Level of reliance on the service', 'grcmanager'), 'B_02.02.0180', issues, is_critical) }}
               {{ m.select('reliance', options.reliance, dora.reliance, 'grc-dora-reliance') }}
            </div>
            <div class="col-12 col-md-6">
               {{ m.label('grc-dora-impact', __('Impact of discontinuing the services', 'grcmanager'), 'B_07.01.0100', issues, is_critical) }}
               {{ m.select('discontinuing_impact', options.impact, dora.discontinuing_impact, 'grc-dora-impact') }}
            </div>
            <div class="col-12 col-md-6">
               {{ m.label('grc-dora-substitutability', __('Substitutability of the provider', 'grcmanager'), 'B_07.01.0050', issues, is_critical) }}
               {{ m.select('substitutability', options.substitutability, dora.substitutability, 'grc-dora-substitutability') }}
            </div>
            <div class="col-12 col-md-6">
               {{ m.label('grc-dora-reason', __('Reason why it is hard to substitute', 'grcmanager'), 'B_07.01.0060', issues, false) }}
               {{ m.select('non_substitutable_reason', options.non_substitutable_reason, dora.non_substitutable_reason, 'grc-dora-reason') }}
               <div class="form-hint">{{ __('Only if the provider is not or hardly substitutable.', 'grcmanager') }}</div>
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-exit', __('Exit plan', 'grcmanager'), 'B_07.01.0080', issues, is_critical) }}
               {{ m.select('exit_plan', options.yes_no, dora.exit_plan, 'grc-dora-exit') }}
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-reintegration', __('Possibility of reintegration', 'grcmanager'), 'B_07.01.0090', issues, is_critical) }}
               {{ m.select('reintegration', options.reintegration, dora.reintegration, 'grc-dora-reintegration') }}
               <div class="form-hint">{{ __('Could the service be brought back in-house?', 'grcmanager') }}</div>
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-audit', __('Date of the last audit of the provider', 'grcmanager'), 'B_07.01.0070', issues, false) }}
               <input type="date" class="form-control" name="last_audit_date" id="grc-dora-audit" value="{{ dora.last_audit_date }}">
               <div class="form-hint">{{ __('Empty: no audit performed.', 'grcmanager') }}</div>
            </div>
            <div class="col-12 col-md-4">
               {{ m.label('grc-dora-alternatives', __('Alternative providers identified', 'grcmanager'), 'B_07.01.0110', issues, is_critical) }}
               {{ m.select('alternatives', options.alternatives, dora.alternatives, 'grc-dora-alternatives') }}
            </div>
            <div class="col-12 col-md-8">
               {{ m.label('grc-dora-alternative-providers', __('Which alternative providers?', 'grcmanager'), 'B_07.01.0120', issues, false) }}
               <input type="text" class="form-control" name="alternative_providers" id="grc-dora-alternative-providers" maxlength="2000" value="{{ dora.alternative_providers }}">
            </div>
         </div>
      </div>
      </fieldset>
      {% if can_edit %}
         <button type="submit" name="save_arrangement" value="1" class="btn btn-primary mb-3" id="grc-dora-save"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
      {% endif %}
   </form>

   <div class="row g-3 mb-3">
      {# ------------------------------------------------------------ Fonctions soutenues #}
      <div class="col-12 col-xl-6">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-briefcase me-2"></i>{{ __('Supported functions', 'grcmanager') }} <span class="badge bg-secondary-lt fw-normal">B_02.02.0050</span></h3></div>
            <div class="card-body">
               <p class="text-muted small"><i class="ti ti-info-circle me-1"></i>{{ __('The business processes that rely on this contract. Whether a function is critical or important is set on the process, in its "DORA function" tab.', 'grcmanager') }}</p>
               {% if functions is empty %}
                  <div class="alert alert-warning" id="grc-dora-no-function"><i class="ti ti-alert-circle me-1"></i>{{ __('No function linked yet.', 'grcmanager') }}</div>
               {% else %}
                  <ul class="list-group mb-3" id="grc-dora-functions">
                     {% for function in functions %}
                        <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                           <span class="badge bg-purple-lt">{{ function.identifier }}</span>
                           <a href="{{ function.url }}" class="flex-grow-1">{{ function.name }}</a>
                           <span class="badge text-wrap {{ function.criticality == 1 ? 'bg-red-lt' : (function.criticality == 2 ? 'bg-green-lt' : 'bg-orange-lt') }}">{{ function.criticality_label }}</span>
                           {% if can_edit %}
                              <form method="post" action="{{ action }}" class="m-0">
                                 <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                 <input type="hidden" name="contracts_id" value="{{ contract_id }}">
                                 <input type="hidden" name="plugin_grcmanager_businessprocesses_id" value="{{ function.id }}">
                                 <button type="submit" name="remove_function" value="1" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
                              </form>
                           {% endif %}
                        </li>
                     {% endfor %}
                  </ul>
               {% endif %}
               {% if hidden_functions > 0 %}
                  <p class="text-muted small">{{ __('%d function(s) you cannot see.', 'grcmanager')|format(hidden_functions) }}</p>
               {% endif %}
               {% if can_edit and can_link_functions %}
                  {% for process in proposed %}
                     <form method="post" action="{{ action }}" class="d-flex align-items-center gap-2 mb-2 grc-dora-proposed">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="contracts_id" value="{{ contract_id }}">
                        <input type="hidden" name="plugin_grcmanager_businessprocesses_id" value="{{ process.id }}">
                        <span class="badge bg-azure-lt"><i class="ti ti-bulb me-1"></i>{{ __('Depends on this provider', 'grcmanager') }}</span>
                        <span class="flex-grow-1">{{ process.name }}</span>
                        <button type="submit" name="add_function" value="1" class="btn btn-sm btn-outline-primary"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
                     </form>
                  {% endfor %}
                  <form method="post" action="{{ action }}" class="d-flex flex-wrap align-items-center gap-2" id="grc-dora-add-function">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="contracts_id" value="{{ contract_id }}">
                     <div class="flex-grow-1">{{ process_dropdown|raw }}</div>
                     <button type="submit" name="add_function" value="1" class="btn btn-sm btn-outline-primary"><i class="ti ti-plus me-1"></i>{{ __('Add a function', 'grcmanager') }}</button>
                  </form>
               {% elseif not can_link_functions %}
                  <p class="text-muted small mb-0">{{ __('You need read access to business processes to link functions.', 'grcmanager') }}</p>
               {% endif %}
            </div>
         </div>
      </div>

      {# ------------------------------------------------------------ Sous-traitance #}
      <div class="col-12 col-xl-6">
         <div class="card h-100">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-hierarchy-2 me-2"></i>{{ __('Subcontracting chain', 'grcmanager') }} <span class="badge bg-secondary-lt fw-normal">B_05.02</span></h3></div>
            <div class="card-body">
               <p class="text-muted small"><i class="ti ti-info-circle me-1"></i>{{ __('The subcontractors that effectively provide part of the service, and for whom they work. The rank is computed: 1 for the direct provider, 2 for its subcontractors, and so on.', 'grcmanager') }}</p>
               {% if chain is empty %}
                  <p class="text-muted" id="grc-dora-no-subcontractor">{{ __('No subcontractor declared.', 'grcmanager') }}</p>
               {% else %}
                  <ul class="list-group mb-3" id="grc-dora-chain">
                     {% for sub in chain %}
                        <li class="list-group-item d-flex align-items-center gap-2">
                           <span class="badge bg-indigo-lt text-nowrap">{{ __('Rank %d', 'grcmanager')|format(sub.rank) }}</span>
                           <a href="{{ sub.url }}" class="flex-grow-1">{{ sub.name }}</a>
                           <span class="text-muted small"><i class="ti ti-arrow-right me-1"></i>{{ sub.recipient }}</span>
                           {% if can_edit %}
                              <form method="post" action="{{ action }}" class="m-0">
                                 <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                 <input type="hidden" name="contracts_id" value="{{ contract_id }}">
                                 <input type="hidden" name="suppliers_id" value="{{ sub.id }}">
                                 <button type="submit" name="remove_subcontractor" value="1" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
                              </form>
                           {% endif %}
                        </li>
                     {% endfor %}
                  </ul>
               {% endif %}
               {% if can_edit %}
                  <form method="post" action="{{ action }}" class="row g-2 align-items-end" id="grc-dora-add-subcontractor">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="contracts_id" value="{{ contract_id }}">
                     <div class="col-12 col-md-6">
                        <label class="form-label">{{ __('Subcontractor (GLPI supplier)', 'grcmanager') }}</label>
                        {{ supplier_dropdown|raw }}
                     </div>
                     <div class="col-12 col-md-6">
                        <label class="form-label" for="grc-dora-recipient">{{ __('Works for', 'grcmanager') }}</label>
                        <select class="form-select" name="recipient" id="grc-dora-recipient">
                           {% for id, name in recipients %}<option value="{{ id }}">{{ name }}</option>{% endfor %}
                        </select>
                     </div>
                     <div class="col-12">
                        <button type="submit" name="add_subcontractor" value="1" class="btn btn-sm btn-outline-primary"><i class="ti ti-plus me-1"></i>{{ __('Add a subcontractor', 'grcmanager') }}</button>
                     </div>
                  </form>
               {% endif %}
            </div>
         </div>
      </div>
   </div>

   {% if can_edit %}
      <form method="post" action="{{ action }}" class="text-end" onsubmit="return confirm('{{ __('Remove this contract from the DORA register? Its DORA information will be deleted; the contract itself is kept.', 'grcmanager')|e('js') }}');">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="contracts_id" value="{{ contract_id }}">
         <button type="submit" name="exclude" value="1" class="btn btn-outline-danger btn-sm" id="grc-dora-exclude"><i class="ti ti-trash me-1"></i>{{ __('Remove from the register', 'grcmanager') }}</button>
      </form>
   {% endif %}
{% endif %}
</div>
