{# Issue #540 : registre d'informations DORA : entité qui le tient, complétude, accords, export. #}
{% import '@grcmanager/dora/_macros.html.twig' as m %}

<div class="container-fluid grc-dora-register">
   {% if not can_view_contracts %}
      <div class="alert alert-warning"><i class="ti ti-lock me-1"></i>{{ __('You need read access to contracts and suppliers to see the register.', 'grcmanager') }}</div>
   {% endif %}

   {# ---------------------------------------------------------------- Chiffres clés #}
   <div class="row g-3 mb-3">
      <div class="col-6 col-lg-3"><div class="card card-sm"><div class="card-body"><div class="text-muted small"><i class="ti ti-checklist me-1"></i>{{ __('Completeness', 'grcmanager') }}</div><div class="mt-1">{{ m.rate(completeness.rate) }}</div></div></div></div>
      <div class="col-6 col-lg-3"><div class="card card-sm"><div class="card-body"><div class="text-muted small"><i class="ti ti-file-certificate me-1"></i>{{ __('Contracts in the register', 'grcmanager') }}</div><div class="h2 mb-0" id="grc-dora-contracts-count">{{ arrangements|length }}</div></div></div></div>
      <div class="col-6 col-lg-3"><div class="card card-sm"><div class="card-body"><div class="text-muted small"><i class="ti ti-building-skyscraper me-1"></i>{{ __('ICT providers and subcontractors', 'grcmanager') }}</div><div class="h2 mb-0">{{ providers_count }}</div></div></div></div>
      <div class="col-6 col-lg-3"><div class="card card-sm"><div class="card-body"><div class="text-muted small"><i class="ti ti-briefcase me-1"></i>{{ __('Functions supported', 'grcmanager') }}</div><div class="h2 mb-0">{{ functions_count }} <span class="badge bg-red-lt fs-6 align-middle">{{ __('%d critical or important', 'grcmanager')|format(critical_count) }}</span></div></div></div></div>
   </div>

   {# ---------------------------------------------------------------- Champs manquants #}
   <div class="card mb-3" id="grc-dora-completeness">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-list-check me-2"></i>{{ __('Missing fields before the export', 'grcmanager') }}</h3>
         <div class="card-actions">{{ m.rate(completeness.rate) }}</div>
      </div>
      <div class="card-body">
         {% if arrangements is empty %}
            <p class="text-muted mb-0">{{ __('No contract in the register yet: open a contract with an ICT provider, then its "DORA register" tab.', 'grcmanager') }}</p>
         {% elseif completeness.issues is empty %}
            <div class="alert alert-success mb-0" id="grc-dora-all-complete"><i class="ti ti-circle-check me-1"></i>{{ __('Every required field is filled in: the register can be exported.', 'grcmanager') }}</div>
         {% else %}
            <p class="text-muted small"><i class="ti ti-info-circle me-1"></i>{{ __('%d required field(s) missing or invalid out of %d checked. Click a line to complete it where it is entered.', 'grcmanager')|format(completeness.issues|length, completeness.checked) }}</p>
            <div class="table-responsive">
               <table class="table table-sm table-hover mb-0" id="grc-dora-issues">
                  <thead><tr><th>{{ __('Item', 'grcmanager') }}</th><th>{{ __('Field', 'grcmanager') }}</th><th>{{ __('Column', 'grcmanager') }}</th><th>{{ __('Problem', 'grcmanager') }}</th></tr></thead>
                  <tbody>
                     {% for issue in completeness.issues %}
                        <tr class="grc-dora-issue-row" data-scope="{{ issue.scope }}" data-column="{{ issue.column }}">
                           <td><span class="badge bg-azure-lt me-1">{{ issue.object_type }}</span><a href="{{ issue.url }}">{{ issue.object_name ?: '-' }}</a></td>
                           <td>{{ issue.label }}</td>
                           <td class="text-muted small">{{ issue.column }}</td>
                           <td><span class="badge {{ issue.kind == 'invalid' ? 'bg-red-lt' : 'bg-orange-lt' }}"><i class="ti {{ issue.kind == 'invalid' ? 'ti-forbid' : 'ti-alert-circle' }} me-1"></i>{{ issue.kind == 'invalid' ? __('Invalid format', 'grcmanager') : __('Missing', 'grcmanager') }}</span></td>
                        </tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
         {% endif %}
      </div>
   </div>

   {# ---------------------------------------------------------------- Accords #}
   <div class="card mb-3">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-file-certificate me-2"></i>{{ __('Contractual arrangements', 'grcmanager') }}</h3>
         <div class="card-actions"><a href="{{ contract_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-list me-1"></i>{{ __('All contracts', 'grcmanager') }}</a></div>
      </div>
      <div class="card-body">
         {% if arrangements is empty %}
            <p class="text-muted mb-0">{{ __('To add a contract: open it in GLPI (Management > Contracts), then its "DORA register" tab.', 'grcmanager') }}</p>
         {% else %}
            <div class="table-responsive">
               <table class="table table-sm table-hover" id="grc-dora-arrangements">
                  <thead><tr>
                     <th>{{ __('Contract', 'grcmanager') }}</th><th>{{ __('Reference', 'grcmanager') }}</th><th>{{ __('Provider', 'grcmanager') }}</th>
                     <th>{{ __('ICT services', 'grcmanager') }}</th><th>{{ __('Functions', 'grcmanager') }}</th><th>{{ __('Subcontractors', 'grcmanager') }}</th><th>{{ __('Status', 'grcmanager') }}</th>
                  </tr></thead>
                  <tbody>
                     {% for a in arrangements %}
                        <tr>
                           <td><a href="{{ a.url }}"><i class="ti ti-file-certificate me-1"></i>{{ a.name }}</a></td>
                           <td>{{ a.reference ?: '-' }}</td>
                           <td>{% if a.provider %}<a href="{{ a.provider_url }}">{{ a.provider }}</a>{% else %}<span class="text-danger">{{ __('Not filled in', 'grcmanager') }}</span>{% endif %}</td>
                           <td>{% for s in a.services %}<span class="badge bg-blue-lt me-1 mb-1">{{ s }}</span>{% else %}<span class="text-danger">{{ __('Not filled in', 'grcmanager') }}</span>{% endfor %}</td>
                           <td>
                              {% for f in a.functions %}
                                 <a href="{{ f.url }}" class="badge {{ f.critical ? 'bg-red-lt' : 'bg-secondary-lt' }} me-1 mb-1">{% if f.critical %}<i class="ti ti-flame me-1"></i>{% endif %}{{ f.name }}</a>
                              {% else %}<span class="text-danger">{{ __('None', 'grcmanager') }}</span>{% endfor %}
                           </td>
                           <td>{{ a.subcontractors }}</td>
                           <td>
                              {% if a.missing == 0 %}
                                 <span class="badge bg-green-lt"><i class="ti ti-circle-check me-1"></i>{{ __('Complete', 'grcmanager') }}</span>
                              {% else %}
                                 <span class="badge bg-orange-lt"><i class="ti ti-alert-triangle me-1"></i>{{ __('%d missing', 'grcmanager')|format(a.missing) }}</span>
                              {% endif %}
                           </td>
                        </tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
         {% endif %}
         {% if suggestions is not empty %}
            <div class="mt-3" id="grc-dora-suggestions">
               <div class="fw-bold mb-1"><i class="ti ti-bulb me-1 text-azure"></i>{{ __('Contracts of ICT providers not in the register yet', 'grcmanager') }}</div>
               {% for s in suggestions %}
                  <a href="{{ s.url }}" class="badge bg-azure-lt me-1 mb-1"><i class="ti ti-plus me-1"></i>{{ s.name }} ({{ s.supplier }})</a>
               {% endfor %}
            </div>
         {% endif %}
      </div>
   </div>

   <div class="row g-3">
      {# ---------------------------------------------------------------- Entité #}
      <div class="col-12 col-xl-6">
         <div class="card h-100" id="grc-dora-settings">
            <div class="card-header"><h3 class="card-title"><i class="ti ti-building-bank me-2"></i>{{ __('Financial entity maintaining the register', 'grcmanager') }} <span class="badge bg-secondary-lt fw-normal">B_01.01 / B_01.02</span></h3></div>
            <div class="card-body">
               <form method="post" action="{{ action }}" class="row g-3">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <fieldset class="row g-3 m-0 p-0" {{ can_edit ? '' : 'disabled' }}>
                  <div class="col-12 col-md-6">
                     {{ m.label('grc-dora-lei', __('LEI of the financial entity', 'grcmanager'), 'B_01.01.0010', completeness.issues|filter(i => i.scope == 'entity'), true) }}
                     <input type="text" class="form-control text-uppercase {{ lei_valid ? '' : 'is-invalid' }}" name="lei" id="grc-dora-lei" maxlength="20" value="{{ settings.lei }}">
                     {% if not lei_valid %}<div class="invalid-feedback">{{ __('This is not a valid LEI (20 characters with a check digit).', 'grcmanager') }}</div>{% endif %}
                  </div>
                  <div class="col-12 col-md-6">
                     {{ m.label('grc-dora-name', __('Legal name of the financial entity', 'grcmanager'), 'B_01.01.0020', completeness.issues|filter(i => i.scope == 'entity'), true) }}
                     <input type="text" class="form-control" name="name" id="grc-dora-name" maxlength="255" value="{{ settings.name }}">
                  </div>
                  <div class="col-12 col-md-6">
                     {{ m.label('grc-dora-type', __('Type of financial entity', 'grcmanager'), 'B_01.01.0040', completeness.issues|filter(i => i.scope == 'entity'), true) }}
                     {{ m.select('type', entity_types, settings.type, 'grc-dora-type') }}
                  </div>
                  <div class="col-12 col-md-3">
                     {{ m.label('grc-dora-country', __('Country', 'grcmanager'), 'B_01.01.0030', completeness.issues|filter(i => i.scope == 'entity'), true) }}
                     <input type="text" class="form-control text-uppercase" name="country" id="grc-dora-country" maxlength="2" value="{{ settings.country }}" placeholder="FR">
                  </div>
                  <div class="col-12 col-md-3">
                     <label class="form-label" for="grc-dora-currency">{{ __('Currency', 'grcmanager') }} <span class="badge bg-secondary-lt fw-normal">B_01.02.0100</span></label>
                     <input type="text" class="form-control text-uppercase" name="currency" id="grc-dora-currency" maxlength="3" value="{{ settings.currency }}">
                     <div class="form-hint">{{ __('Default currency of the amounts.', 'grcmanager') }}</div>
                  </div>
                  <div class="col-12 col-md-6">
                     {{ m.label('grc-dora-authority', __('Competent authority', 'grcmanager'), 'B_01.01.0050', completeness.issues|filter(i => i.scope == 'entity'), true) }}
                     <input type="text" class="form-control" name="authority" id="grc-dora-authority" maxlength="255" value="{{ settings.authority }}">
                     <div class="form-hint">{{ __('The supervisor to which the register is reported.', 'grcmanager') }}</div>
                  </div>
                  <div class="col-12 col-md-6">
                     {{ m.label('grc-dora-assets', __('Value of total assets', 'grcmanager'), 'B_01.02.0110', completeness.issues|filter(i => i.scope == 'entity'), false) }}
                     <input type="text" class="form-control" name="total_assets" id="grc-dora-assets" value="{{ settings.total_assets }}" inputmode="decimal">
                     <div class="form-hint">{{ __('From the last annual financial statements, in units.', 'grcmanager') }}</div>
                  </div>
                  <div class="col-12 col-md-6">
                     {{ m.label('grc-dora-hierarchy', __('Position in the group', 'grcmanager'), 'B_01.02.0050', completeness.issues|filter(i => i.scope == 'entity'), true) }}
                     {{ m.select('hierarchy', hierarchies, settings.hierarchy, 'grc-dora-hierarchy') }}
                  </div>
                  <div class="col-12 col-md-6">
                     {{ m.label('grc-dora-parent-lei', __('LEI of the direct parent undertaking', 'grcmanager'), 'B_01.02.0060', completeness.issues|filter(i => i.scope == 'entity'), false) }}
                     <input type="text" class="form-control text-uppercase" name="parent_lei" id="grc-dora-parent-lei" maxlength="20" value="{{ settings.parent_lei }}">
                  </div>
                  <div class="col-12 col-md-6">
                     <label class="form-label" for="grc-dora-integration">{{ __('Date of integration in the register', 'grcmanager') }} <span class="badge bg-secondary-lt fw-normal">B_01.02.0080</span></label>
                     <input type="date" class="form-control" name="integration_date" id="grc-dora-integration" value="{{ settings.integration_date }}">
                     <div class="form-hint">{{ __('Empty: the date the first contract was added.', 'grcmanager') }}</div>
                  </div>
                  </fieldset>
                  {% if can_edit %}
                     <div class="col-12"><button type="submit" name="save_settings" value="1" class="btn btn-primary" id="grc-dora-settings-save"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button></div>
                  {% endif %}
               </form>
            </div>
         </div>
      </div>

      {# ---------------------------------------------------------------- Export #}
      <div class="col-12 col-xl-6">
         <div class="card h-100" id="grc-dora-export">
            <div class="card-header">
               <h3 class="card-title"><i class="ti ti-file-export me-2"></i>{{ __('Export for the supervisor', 'grcmanager') }}</h3>
               {% if zip_available %}
                  <div class="card-actions"><a href="{{ zip_url }}" class="btn btn-primary btn-sm" id="grc-dora-export-zip"><i class="ti ti-file-zip me-1"></i>{{ __('Download all the templates (ZIP)', 'grcmanager') }}</a></div>
               {% endif %}
            </div>
            <div class="card-body">
               <p class="small text-muted"><i class="ti ti-info-circle me-1"></i>{{ __('One CSV file per template of the implementing regulation, with the official column codes (c0010...), as in an xBRL-CSV report package. Closed lists are written with their official English wording: your reporting tool converts them into the codes of the EBA taxonomy and adds the package files (report.json, parameters, filing indicators).', 'grcmanager') }}</p>
               <div class="table-responsive">
                  <table class="table table-sm mb-2" id="grc-dora-templates">
                     <thead><tr><th>{{ __('Template', 'grcmanager') }}</th><th>{{ __('Content', 'grcmanager') }}</th><th>{{ __('Filled in by GLPI', 'grcmanager') }}</th><th class="text-end">{{ __('Lines', 'grcmanager') }}</th></tr></thead>
                     <tbody>
                        {% for t in templates %}
                           <tr>
                              <td><a href="{{ t.url }}" class="text-nowrap" title="{{ __('Download', 'grcmanager') }} {{ t.file }}"><i class="ti ti-download me-1"></i>{{ t.code }}</a></td>
                              <td>{{ t.label }}</td>
                              <td>
                                 {% if t.coverage == 'auto' %}
                                    <span class="badge bg-green-lt"><i class="ti ti-check me-1"></i>{{ __('Yes', 'grcmanager') }}</span>
                                 {% elseif t.coverage == 'partial' %}
                                    <span class="badge bg-orange-lt"><i class="ti ti-pencil me-1"></i>{{ __('Partly: complete by hand', 'grcmanager') }}</span>
                                 {% else %}
                                    <span class="badge bg-secondary-lt"><i class="ti ti-hand-finger me-1"></i>{{ __('By hand (groups and branches)', 'grcmanager') }}</span>
                                 {% endif %}
                              </td>
                              <td class="text-end">{{ t.rows }}</td>
                           </tr>
                        {% endfor %}
                     </tbody>
                  </table>
               </div>
               <p class="small mb-0"><i class="ti ti-book me-1"></i>{{ __('Sources:', 'grcmanager') }} <a href="{{ dora_url }}" target="_blank" rel="noopener">{{ __('Regulation (EU) 2022/2554 (DORA), article 28', 'grcmanager') }}</a>, <a href="{{ its_url }}" target="_blank" rel="noopener">{{ __('Implementing Regulation (EU) 2024/2956 (templates of the register)', 'grcmanager') }}</a></p>
            </div>
         </div>
      </div>
   </div>
</div>
