{# Issue #171 : effet domino de l'ensemble des risques et incidents reliés #}
<div class="container-fluid my-3">
   <div class="card">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-hierarchy-3 me-2"></i>{{ __('Domino effect', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="text-muted">{{ __('Chains of causes and consequences between risks, supplier risks and security incidents. Links are created from the "Domino effect" tab of each one. This is a representation: no probability is computed.', 'grcmanager') }}</p>
         {% if elements is empty %}
            <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>{{ __('No link yet.', 'grcmanager') }}
               <a href="{{ risk_url }}">{{ __('Open the risk register', 'grcmanager') }}</a></div>
         {% else %}
            {% include '@grcmanager/_causal_graph.html.twig' with {'elements': elements, 'height': '640px'} %}
         {% endif %}
      </div>
   </div>
</div>
