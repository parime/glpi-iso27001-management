{# ROADMAP.md "Version 1.5" (import/export de la SoA au format standard) — voir front/control.csv.php.
   Contrairement à l'export CSV natif de Search::showList() (menu "Exporter" sur la liste des
   contrôles), ce CSV dédié sépare le code de l'intitulé et n'utilise que des libellés stables,
   pensé pour être réimporté tel quel après modification dans un tableur. #}

<p class="text-muted">
  {{ __('Export the current state of the Statement of Applicability, edit it in a spreadsheet, then re-import the file to apply the changes at once.', 'grcmanager') }}
</p>

<a href="{{ path('/plugins/grcmanager/front/control.csv.php') }}?action=export" class="btn btn-outline-secondary mb-3">
  <i class="ti ti-download me-1"></i>{{ __('Download the current CSV', 'grcmanager') }}
</a>

{% if import_result %}
  {% if import_result.no_rows_found %}
    <div class="alert alert-danger">
      {{ __('No usable row was found in this file — check that it is really a CSV exported from this screen (semicolon-separated columns).', 'grcmanager') }}
    </div>
  {% else %}
    <div class="alert {{ import_result.rejected_count > 0 ? 'alert-warning' : 'alert-success' }}">
      {{ __('%d control(s) updated.', 'grcmanager')|format(import_result.updated_count) }}
      {% if import_result.rejected_count > 0 %}
        {{ __('%d row(s) rejected:', 'grcmanager')|format(import_result.rejected_count) }}
        <ul class="mb-0">
          {% for rejection in import_result.rejected %}
            <li><strong>{{ rejection.code|default(__('(empty row)', 'grcmanager')) }}</strong> — {{ rejection.reason }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endif %}
{% endif %}

{% if can_edit %}
  <form method="post" action="{{ path('/plugins/grcmanager/front/control.csv.php') }}" enctype="multipart/form-data" class="card">
    <div class="card-body">
      <h3 class="card-title">{{ __('Import a modified CSV', 'grcmanager') }}</h3>
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="file" name="soa_file" accept=".csv" class="form-control mb-2" required>
      <small class="form-hint d-block mb-2">
        {{ __('Expected file: the one downloaded above, possibly edited (semicolon-separated columns). Only the applicabilite, etat_mise_en_oeuvre and justification columns are applied, matched by the control\'s code. No row is ever created or deleted.', 'grcmanager') }}
      </small>
      <button type="submit" name="import" class="btn btn-primary">
        <i class="ti ti-upload me-1"></i>{{ __('Import', 'grcmanager') }}
      </button>
    </div>
  </form>
{% endif %}
