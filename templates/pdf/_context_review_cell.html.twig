{# Issue #608, lot 2 : cellule « Revue » du registre PDF du contexte (propriétaire, dernière revue
   tracée, prochaine revue). #}
<td>
  {% if line.owner %}{{ line.owner }}<br>{% endif %}
  {{ __('Last review', 'grcmanager') }} : {{ line.last_review ? line.last_review|formatted_date ~ (line.last_reviewer ? ' (' ~ line.last_reviewer ~ ')' : '') : __('Never reviewed', 'grcmanager') }}<br>
  {{ __('Next review', 'grcmanager') }} : {{ line.review_date ? line.review_date|formatted_date : '-' }}{% if line.overdue %} ({{ __('overdue', 'grcmanager') }}){% endif %}
</td>
