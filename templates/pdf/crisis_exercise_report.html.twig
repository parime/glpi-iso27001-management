{# Issue #168 : rapport d'exercice de crise (A.5.29 / A.5.30), archivé comme preuve #}
{# Issue #185 : même rapport pour une cellule de crise réelle (A.5.26 / A.5.29), avec reprise et journal #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}
{% set statuses = {'on_time': __('On time', 'grcmanager'), 'late': __('Overdue', 'grcmanager'), 'pending': __('To do', 'grcmanager'), 'missed': __('Not done', 'grcmanager')} %}
{% set recovery_states = {'restored_on_time': __('Restored within RTO', 'grcmanager'), 'restored_late': __('Restored after RTO', 'grcmanager'), 'restored': __('Restored', 'grcmanager'), 'running': __('Recovery in progress', 'grcmanager'), 'overdue': __('RTO exceeded', 'grcmanager'), 'no_rto': __('RTO not set', 'grcmanager')} %}

{% if drill %}
<p><strong>{{ __('EXERCISE', 'grcmanager') }}</strong> - {{ __('this report covers a fictitious incident, simulated to test the continuity plan.', 'grcmanager') }}</p>
{% endif %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ drill ? __('Scenario', 'grcmanager') : __('Response plan', 'grcmanager') }}</td><td>{{ exercise.scenario }}</td></tr>
  <tr><td>{{ drill ? __('Exercise incident', 'grcmanager') : __('Incident', 'grcmanager') }}</td><td>#{{ incident.id }} - {{ incident.name }}</td></tr>
  <tr><td>{{ drill ? __('Organised by', 'grcmanager') : __('Crisis team activated by', 'grcmanager') }}</td><td>{{ exercise.organizer }}</td></tr>
  <tr><td>{{ __('Start / end', 'grcmanager') }}</td><td>{{ exercise.started_at }} / {{ exercise.ended_at ?: '-' }}</td></tr>
  <tr><td>{{ __('Duration', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ exercise.duration }} min</td></tr>
  <tr><td>{{ __('Steps done', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.done }} / {{ summary.total }}</td></tr>
  <tr><td>{{ __('Steps on time', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.on_time }} ({{ summary.rate }} %)</td></tr>
  <tr><td>{{ __('Average reaction time', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.average is null ? '-' : summary.average ~ ' min' }}</td></tr>
  {% if recovery is not empty %}
  <tr><td>{{ __('Items restored', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ recovery|filter(r => r.restored_at)|length }} / {{ recovery|length }}</td></tr>
  {% endif %}
  <tr><td>{{ __('Participants', 'grcmanager') }}</td><td>{{ participants is empty ? '-' : participants|join(', ') }}</td></tr>
</table>

<h2>{{ __('Course of the exercise', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead><tr><th>#</th><th>{{ __('Step', 'grcmanager') }}</th><th>{{ __('Target', 'grcmanager') }}</th><th>{{ __('Done at', 'grcmanager') }}</th><th>{{ __('By', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for s in steps %}
      <tr><td>{{ loop.index }}</td><td>{{ s.label }}</td><td>T+{{ s.target }} min</td><td>{{ s.minutes is null ? '-' : 'T+' ~ s.minutes ~ ' min' }}</td><td>{{ s.by ?: '-' }}</td><td>{{ statuses[s.status] }}</td></tr>
    {% endfor %}
  </tbody>
</table>

{% if recovery is not empty %}
<h2>{{ __('Recovery of affected items', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Item', 'grcmanager') }}</th><th>RTO</th><th>{{ __('Restored on', 'grcmanager') }}</th><th>{{ __('Duration', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for r in recovery %}
      <tr><td>{{ r.label }}{% if r.depth > 0 %} ({{ __('dependent', 'grcmanager') }}){% endif %}</td><td>{{ r.rto > 0 ? r.rto ~ ' h' : '-' }}</td><td>{{ r.restored_at ?: '-' }}</td><td>{{ r.hours is null ? '-' : r.hours ~ ' h' }}</td><td>{{ recovery_states[r.state] }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{# Issue #771, lot 3 : contacts officiels à prévenir et situation de chacun. #}
{% if official_contacts.contacts|default([]) is not empty %}
<h2>{{ __('Official contacts to inform', 'grcmanager') }} (A.5.5, A.5.6)</h2>
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Name') }}</th><th>{{ __('Contact category', 'grcmanager') }}</th><th>{{ __('Deadline', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for contact in official_contacts.contacts %}
      <tr>
        <td>{{ contact.name }}</td>
        <td>{{ contact.category }}</td>
        <td>{{ contact.notice and contact.notice.deadline ? contact.notice.deadline|formatted_datetime : '-' }}</td>
        <td>{{ contact.notice ? contact.notice.label : '-' }}{% if contact.notice and contact.notice.date %} ({{ contact.notice.date|formatted_datetime }}){% endif %}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if journal is not empty %}
<h2>{{ __('Crisis log', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Date', 'grcmanager') }}</th><th>{{ __('Author', 'grcmanager') }}</th><th>{{ __('Entry', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for j in journal %}<tr><td>{{ j.date }}</td><td>{{ j.author }}</td><td>{{ j.text|nl2br }}</td></tr>{% endfor %}
  </tbody>
</table>
{% endif %}

{% if communications is defined and communications is not empty %}
{# Issue #616, lot 2 : communications de crise tracées pendant l'exercice ou la crise. #}
<h2>{{ __('Crisis communications', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Sent on', 'grcmanager') }}</th><th>{{ __('Author', 'grcmanager') }}</th><th>{{ __('Message template', 'grcmanager') }}</th><th>{{ __('Subject', 'grcmanager') }}</th><th>{{ __('Recipients', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for c in communications %}<tr><td>{{ c.date }}</td><td>{{ c.author }}</td><td>{{ c.template }}</td><td>{{ c.subject }}</td><td>{{ c.recipients|join(', ') }}</td></tr>{% endfor %}
  </tbody>
</table>
{% endif %}

{% if review %}
{# Issue #732 : bilan après exercice #}
{% set outcomes = {'met': __('Achieved', 'grcmanager'), 'partial': __('Partially achieved', 'grcmanager'), 'not_met': __('Not achieved', 'grcmanager'), '': __('To evaluate', 'grcmanager')} %}
{% set severities = {'minor': __('Minor', 'grcmanager'), 'major': __('Major', 'grcmanager'), 'critical': __('Critical', 'grcmanager')} %}
{% set action_states = {'done': __('Done', 'grcmanager'), 'overdue': __('Overdue', 'grcmanager'), 'open': __('In progress', 'grcmanager'), 'hidden': __('Not visible to you', 'grcmanager'), 'missing': __('Deleted', 'grcmanager')} %}
<h2>{{ __('Objectives of the exercise', 'grcmanager') }}</h2>
{% if review.objectives is empty %}
<p>{{ __('No objective defined.', 'grcmanager') }}</p>
{% else %}
<table class="grcmanager-pdf-table">
  <thead><tr><th>#</th><th>{{ __('Objective', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th><th>{{ __('Comment', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for o in review.objectives %}<tr><td>{{ loop.index }}</td><td>{{ o.name }}</td><td>{{ outcomes[o.outcome] }}</td><td>{{ o.comment ?: '-' }}</td></tr>{% endfor %}
  </tbody>
</table>
<p>{{ __('%1$d achieved, %2$d partially, %3$d not achieved, %4$d to evaluate', 'grcmanager')|format(review.objectives_summary.met, review.objectives_summary.partial, review.objectives_summary.not_met, review.objectives_summary.pending) }}</p>
{% endif %}

<h2>{{ __('Findings and improvement plan', 'grcmanager') }}</h2>
{% if review.findings is empty %}
<p>{{ __('No finding recorded.', 'grcmanager') }}</p>
{% else %}
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Finding', 'grcmanager') }}</th><th>{{ __('Severity', 'grcmanager') }}</th><th>{{ __('Improvement action', 'grcmanager') }}</th><th>{{ __('Owner', 'grcmanager') }}</th><th>{{ __('Due date', 'grcmanager') }}</th><th>{{ __('Progress', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for f in review.findings %}
      <tr>
        <td>{{ f.name }}{% if f.description %}<br>{{ f.description|nl2br }}{% endif %}</td>
        <td>{{ severities[f.severity] }}</td>
        {% if f.action is null %}
          <td colspan="4">{{ __('No action decided', 'grcmanager') }}</td>
        {% else %}
          <td>{{ f.action.label }} #{{ f.action.id }}{% if f.action.title is defined %}<br>{{ f.action.title }}{% endif %}</td>
          <td>{{ f.action.responsible|default('-') }}</td>
          <td>{{ f.action.due_date|default('-') }}</td>
          <td>{{ action_states[f.action.state] }}</td>
        {% endif %}
      </tr>
    {% endfor %}
  </tbody>
</table>
<p>{{ __('%1$d finding(s), %2$d action(s) decided, %3$d done', 'grcmanager')|format(review.plan_summary.findings, review.plan_summary.actions, review.plan_summary.done) }}{% if review.plan_summary.overdue > 0 %} - {{ _n('%d action overdue', '%d actions overdue', review.plan_summary.overdue, 'grcmanager')|format(review.plan_summary.overdue) }}{% endif %}</p>
{% endif %}

<h2>{{ __('Review validation', 'grcmanager') }}</h2>
{% if review.validated %}
<p><strong>{{ __('Validated', 'grcmanager') }}</strong> - {{ __('on %1$s by %2$s', 'grcmanager')|format(review.validated_at, review.validator) }}</p>
{% else %}
<p><strong>{{ __('Draft', 'grcmanager') }}</strong> - {{ __('this review has not been validated yet.', 'grcmanager') }}</p>
{% endif %}
{% if review.history is not empty %}
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Date', 'grcmanager') }}</th><th>{{ __('Event', 'grcmanager') }}</th><th>{{ __('By', 'grcmanager') }}</th><th>{{ __('Comment', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for h in review.history %}<tr><td>{{ h.date }}</td><td>{{ h.action == 'validated' ? __('Validated', 'grcmanager') : __('Returned to draft', 'grcmanager') }}</td><td>{{ h.user }}</td><td>{{ h.comment ?: '-' }}</td></tr>{% endfor %}
  </tbody>
</table>
{% endif %}
{% endif %}

<h2>{{ __('Lessons learned', 'grcmanager') }}</h2>
<p>{{ incident.lessons ? incident.lessons|nl2br : __('Not filled in: complete them on the incident and regenerate the report.', 'grcmanager') }}</p>
