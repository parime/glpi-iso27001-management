{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr>
    <td>{{ __('Risks in the register', 'grcmanager') }}</td>
    <td class="grcmanager-pdf-summary-number">{{ total_count }}</td>
  </tr>
  <tr>
    <td>{{ open_count.label }}</td>
    <td class="grcmanager-pdf-summary-number">{{ open_count.number }}</td>
  </tr>
  {% for entry in by_level.data %}
    <tr>
      <td>{{ __('Level', 'grcmanager') }} : {{ entry.label }}</td>
      <td class="grcmanager-pdf-summary-number">{{ entry.number }}</td>
    </tr>
  {% endfor %}
</table>

<h2>{{ __('Risk details', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Title', 'grcmanager') }}</th>
      <th>{{ __('Category', 'grcmanager') }}</th>
      <th>{{ __('Risk level', 'grcmanager') }}</th>
      <th>{{ __('Treatment', 'grcmanager') }}</th>
      <th>{{ __('Status', 'grcmanager') }}</th>
      <th>{{ _x('owner', 'Owner', 'grcmanager') }}</th>
      <th>{{ __('Review date', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for risk in risks %}
      <tr>
        <td>{{ risk.title }}</td>
        <td>{{ risk.category }}</td>
        <td>{{ risk.risk_level }}</td>
        <td>{{ risk.treatment }}</td>
        <td>{{ risk.status }}</td>
        <td>{{ risk.owner }}</td>
        <td>{{ risk.review_date }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
