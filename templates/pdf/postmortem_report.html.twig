{# Issue #169 : rapport post-incident (enseignements tirés, A.5.27), archivé comme preuve #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}
{% set outcomes = {'met': __('Met', 'grcmanager'), 'late': __('Overdue', 'grcmanager'), 'missing': __('Not notified', 'grcmanager')} %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Incident', 'grcmanager') }}</td><td>#{{ incident.id }} — {{ incident.name }}</td></tr>
  <tr><td>{{ __('Status', 'grcmanager') }}</td><td>{{ incident.status }}{% if not incident.closed %} — {{ __('provisional report, incident not closed', 'grcmanager') }}{% endif %}</td></tr>
  <tr><td>{{ __('Category / severity', 'grcmanager') }}</td><td>{{ incident.category }} / {{ incident.severity }}</td></tr>
  <tr><td>{{ __('Declared on', 'grcmanager') }}</td><td>{{ incident.opened }}</td></tr>
  <tr><td>{{ __('Solved / closed on', 'grcmanager') }}</td><td>{{ incident.solved ?: '—' }} / {{ incident.closed_at ?: '—' }}</td></tr>
  {% if incident.hours is not null %}<tr><td>{{ __('Time to resolution', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ incident.hours }} h</td></tr>{% endif %}
  <tr><td>{{ __('Total cost', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ cost|number_format(2, ',', ' ') }}</td></tr>
</table>

<h2>{{ __('Description', 'grcmanager') }}</h2>
<p>{{ incident.description|nl2br }}</p>

<h2>{{ __('Timeline', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Date', 'grcmanager') }}</th><th>{{ __('Event', 'grcmanager') }}</th><th>{{ __('Detail', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for e in timeline %}
      <tr><td>{{ e.date }}</td><td>{{ e.kind }}</td><td>{{ e.text|nl2br }}</td></tr>
    {% endfor %}
  </tbody>
</table>

<h2>{{ __('Scope', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Affected items', 'grcmanager') }}</td><td>{{ assets is empty ? '—' : assets|join(', ') }}</td></tr>
  <tr><td>CVE</td><td>{{ cves is empty ? '—' : cves|join(', ') }}</td></tr>
  <tr><td>{{ __('Linked tickets', 'grcmanager') }}</td><td>{{ tickets is empty ? '—' : '#' ~ tickets|join(', #') }}</td></tr>
</table>

{% if deadlines is not empty %}
<h2>{{ __('Regulatory notifications', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Due date', 'grcmanager') }}</th><th>{{ __('Deadline', 'grcmanager') }}</th><th>{{ _x('feminine', 'Notified on', 'grcmanager') }}</th><th>{{ __('Outcome', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for d in deadlines %}
      <tr><td>{{ d.label }}</td><td>{{ d.due }}</td><td>{{ d.done_at ?: '—' }}</td><td>{{ outcomes[d.outcome] }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>{{ __('Root cause', 'grcmanager') }}</h2>
<p>{{ incident.root_cause ? incident.root_cause|nl2br : __('Not filled in.', 'grcmanager') }}</p>

<h2>{{ __('Lessons learned', 'grcmanager') }}</h2>
<p>{{ incident.lessons ? incident.lessons|nl2br : _x('plural', 'Not filled in.', 'grcmanager') }}</p>

<h2>{{ __('Decided actions', 'grcmanager') }}</h2>
{% if actions is empty %}
  <p>{{ __('No action plan (nonconformity) linked to the incident.', 'grcmanager') }}</p>
{% else %}
<table class="grcmanager-pdf-table">
  <thead><tr><th>{{ __('Action', 'grcmanager') }}</th><th>{{ __('Status', 'grcmanager') }}</th><th>{{ __('Due date', 'grcmanager') }}</th></tr></thead>
  <tbody>
    {% for a in actions %}<tr><td>{{ a.title }}</td><td>{{ a.status }}</td><td>{{ a.due ?: '—' }}</td></tr>{% endfor %}
  </tbody>
</table>
{% endif %}
