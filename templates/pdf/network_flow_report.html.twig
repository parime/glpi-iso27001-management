{# Issue #144, phase 2 : rapport de la matrice des flux pour l'auditeur (A.8.20 à A.8.22) #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Active flows', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ active }}</td></tr>
  <tr><td>{{ __('Disabled flows', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ inactive }}</td></tr>
  {% for c in checks %}
    <tr><td>{{ c.label }}</td><td class="grcmanager-pdf-summary-number">{{ c.count }}</td></tr>
  {% endfor %}
  {% if checks is empty and active > 0 %}
    <tr><td colspan="2">{{ __('No gap on active flows.', 'grcmanager') }}</td></tr>
  {% endif %}
</table>

{% for group in groups %}
  <h2>{{ group.label }}</h2>
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Name', 'grcmanager') }}</th>
        <th>{{ __('Source', 'grcmanager') }}</th>
        <th>{{ __('Destination', 'grcmanager') }}</th>
        <th>{{ __('Protocol and ports', 'grcmanager') }}</th>
        <th>{{ __('Justification', 'grcmanager') }}</th>
        <th>{{ _x('owner', 'Owner', 'grcmanager') }}</th>
        <th>{{ __('End', 'grcmanager') }}</th>
        <th>{{ __('Gaps', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for f in group.flows %}
        <tr>
          <td>{{ f.name }}</td>
          <td>{{ f.source }}</td>
          <td>{{ f.destination }}</td>
          <td>{{ f.service }}</td>
          <td>{{ f.justification }}</td>
          <td>{{ f.owner }}</td>
          <td>{{ f.date_end }}</td>
          <td>{{ f.checks|join(', ') }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <p>{{ __('No active flow.', 'grcmanager') }}</p>
{% endfor %}

<h2>{{ __('Addressing plan', 'grcmanager') }}</h2>
{% if networks is empty %}
  <p>{{ __('No IP network declared in GLPI.', 'grcmanager') }}</p>
{% else %}
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Network', 'grcmanager') }}</th>
        <th>{{ __('Address', 'grcmanager') }}</th>
        <th>{{ __('Gateway', 'grcmanager') }}</th>
        <th>{{ __('Entity', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for n in networks %}
        <tr><td>{{ n.name }}</td><td>{{ n.address }}</td><td>{{ n.gateway }}</td><td>{{ n.entity }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
