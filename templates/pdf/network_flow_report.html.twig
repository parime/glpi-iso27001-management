{# Issue #144, phase 2 : rapport de la matrice des flux pour l'auditeur (A.8.20 à A.8.22) #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Résumé', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Flux actifs', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ active }}</td></tr>
  <tr><td>{{ __('Flux désactivés', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ inactive }}</td></tr>
  {% for c in checks %}
    <tr><td>{{ c.label }}</td><td class="grcmanager-pdf-summary-number">{{ c.count }}</td></tr>
  {% endfor %}
  {% if checks is empty and active > 0 %}
    <tr><td colspan="2">{{ __('Aucun écart sur les flux actifs.', 'grcmanager') }}</td></tr>
  {% endif %}
</table>

{% for group in groups %}
  <h2>{{ group.label }}</h2>
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Nom', 'grcmanager') }}</th>
        <th>{{ __('Source', 'grcmanager') }}</th>
        <th>{{ __('Destination', 'grcmanager') }}</th>
        <th>{{ __('Protocole et ports', 'grcmanager') }}</th>
        <th>{{ __('Justification', 'grcmanager') }}</th>
        <th>{{ __('Propriétaire', 'grcmanager') }}</th>
        <th>{{ __('Fin', 'grcmanager') }}</th>
        <th>{{ __('Écarts', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for f in group.flows %}
        <tr>
          <td>{{ f.name }}</td>
          <td>{{ f.source }}</td>
          <td>{{ f.destination }}</td>
          <td>{{ f.service }}</td>
          <td>{{ f.justification }}</td>
          <td>{{ f.owner }}</td>
          <td>{{ f.date_end }}</td>
          <td>{{ f.checks|join(', ') }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <p>{{ __('Aucun flux actif.', 'grcmanager') }}</p>
{% endfor %}

<h2>{{ __('Plan d\'adressage', 'grcmanager') }}</h2>
{% if networks is empty %}
  <p>{{ __('Aucun réseau IP déclaré dans GLPI.', 'grcmanager') }}</p>
{% else %}
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Réseau', 'grcmanager') }}</th>
        <th>{{ __('Adresse', 'grcmanager') }}</th>
        <th>{{ __('Passerelle', 'grcmanager') }}</th>
        <th>{{ __('Entité', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for n in networks %}
        <tr><td>{{ n.name }}</td><td>{{ n.address }}</td><td>{{ n.gateway }}</td><td>{{ n.entity }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
