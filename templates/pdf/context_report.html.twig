{# Issue #608, lot 2 : registre du contexte de l'organisation pour l'auditeur (ISO 27001, 4.1 et
   4.2) : synthèse, réponse sur le changement climatique, enjeux, parties intéressées. #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Internal and external issues', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.issues }}</td></tr>
  <tr><td>{{ __('Interested parties', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.parties }}</td></tr>
  <tr><td>{{ __('Items past their review date', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.overdue }}</td></tr>
  <tr><td>{{ __('Climate change', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ climate_answered ? climate.relevance : __('Not answered yet', 'grcmanager') }}</td></tr>
</table>
{% if climate and climate.justification %}
  <p><strong>{{ __('Climate change', 'grcmanager') }} :</strong> {{ climate.justification }}</p>
{% endif %}

<h2>{{ __('Internal and external issues', 'grcmanager') }} (4.1)</h2>
{% if issues is empty %}
  <p>{{ __('No item recorded.', 'grcmanager') }}</p>
{% else %}
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th style="width: 18%;">{{ __('Name') }}</th>
        <th style="width: 13%;">{{ __('Category', 'grcmanager') }}</th>
        <th>{{ __('Effect on the ISMS', 'grcmanager') }}</th>
        <th style="width: 15%;">{{ __('Decision', 'grcmanager') }}</th>
        <th style="width: 18%;">{{ __('Links with the ISMS', 'grcmanager') }}</th>
        <th style="width: 14%;">{{ __('Review', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for line in issues %}
        <tr>
          <td><strong>{{ line.name }}</strong><br>{{ line.nature }}</td>
          <td>{{ line.category }}</td>
          <td>{{ line.effect }}</td>
          <td>{{ line.relevance }}{% if line.justification %}<br>{{ line.justification }}{% endif %}</td>
          {% include '@grcmanager/pdf/_context_links_cell.html.twig' %}
          {% include '@grcmanager/pdf/_context_review_cell.html.twig' %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

<h2>{{ __('Interested parties', 'grcmanager') }} (4.2)</h2>
{% if parties is empty %}
  <p>{{ __('No item recorded.', 'grcmanager') }}</p>
{% else %}
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th style="width: 14%;">{{ __('Name') }}</th>
        <th style="width: 18%;">{{ __('Needs and expectations', 'grcmanager') }}</th>
        <th style="width: 18%;">{{ __('Requirements retained by the ISMS', 'grcmanager') }}</th>
        <th style="width: 12%;">{{ __('Decision', 'grcmanager') }}</th>
        <th style="width: 22%;">{{ __('Links with the ISMS', 'grcmanager') }}</th>
        <th style="width: 14%;">{{ __('Review', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for line in parties %}
        <tr>
          <td><strong>{{ line.name }}</strong><br>{{ line.party_type }}</td>
          <td>{{ line.expectations }}</td>
          <td>{{ line.requirements }}</td>
          <td>{{ line.relevance }}{% if line.justification %}<br>{{ line.justification }}{% endif %}</td>
          {% include '@grcmanager/pdf/_context_links_cell.html.twig' %}
          {% include '@grcmanager/pdf/_context_review_cell.html.twig' %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
