{# Issue #126 : rapport de clôture d'une campagne de revue des accès, archivé comme preuve #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Entity', 'grcmanager') }}</td><td>{{ entity }}{{ campaign.is_recursive ? ' ' ~ __('(and sub-entities)', 'grcmanager') : '' }}</td></tr>
  <tr><td>{{ _x('process pilot', 'Owner', 'grcmanager') }}</td><td>{{ owner }}</td></tr>
  <tr><td>{{ __('Frequency', 'grcmanager') }}</td><td>{{ frequency }}</td></tr>
  {% if control %}<tr><td>{{ __('SoA control', 'grcmanager') }}</td><td>{{ control }}</td></tr>{% endif %}
  <tr><td>{{ __('Start / due date', 'grcmanager') }}</td><td>{{ dates.start }} / {{ dates.due }}</td></tr>
  <tr><td>{{ __('Launched on', 'grcmanager') }}</td><td>{{ dates.launch }}</td></tr>
  <tr><td>{{ __('Closed on', 'grcmanager') }}</td><td>{{ dates.close }}</td></tr>
  <tr><td>{{ __('Accounts reviewed', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ progress.done }} / {{ progress.total }} ({{ progress.percent }} %)</td></tr>
</table>

<h2>{{ __('Decisions per account', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Account', 'grcmanager') }}</th>
      <th>{{ __('Profiles and groups at launch', 'grcmanager') }}</th>
      <th>{{ __('Owner', 'grcmanager') }}</th>
      <th>{{ __('Decision', 'grcmanager') }}</th>
      <th>{{ __('Comment', 'grcmanager') }}</th>
      <th>{{ __('Ticket', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for line in lines %}
      <tr>
        <td>{{ line.user_name }}</td>
        <td>
          {% for p in line.profiles_list %}{{ p }}<br>{% endfor %}
          {% if line.groups_list is not empty %}<em>{{ line.groups_list|join(', ') }}</em>{% endif %}
        </td>
        <td>{{ line.reviewer_name }}</td>
        <td>
          {{ line.decision == 'pending' ? __('Not reviewed', 'grcmanager') : decisions[line.decision] }}
          {% if line.decided_by_name %}<br><small>{{ line.decided_by_name }}, {{ line.date_decision }}</small>{% endif %}
        </td>
        <td>{{ line.comment }}</td>
        <td>{{ line.tickets_id > 0 ? '#' ~ line.tickets_id : '' }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
