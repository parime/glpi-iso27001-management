{# Issue #139, phase 2 : rapport d'une session de formation (A.6.3, clauses 7.2 et 7.3) #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Format', 'grcmanager') }}</td><td>{{ format }}</td></tr>
  <tr><td>{{ __('Completion date', 'grcmanager') }}</td><td>{{ date_delivered }}</td></tr>
  <tr><td>{{ __('Target audience', 'grcmanager') }}</td><td>{{ training.target_audience }}</td></tr>
  <tr><td>{{ __('Mandatory', 'grcmanager') }}</td><td>{{ training.is_mandatory ? __('Yes', 'grcmanager') : __('No', 'grcmanager') }}</td></tr>
  {% if is_scored %}
    <tr><td>{{ __('Pass threshold (%)', 'grcmanager') }}</td><td>{{ training.pass_threshold }} % ({{ __('maximum score: %s', 'grcmanager')|format(training.max_score) }})</td></tr>
  {% endif %}
  <tr><td>{{ __('Participants', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ participants|length }}</td></tr>
  {% if session_rate.rate is not null %}
    <tr><td>{{ __('Pass rate', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ session_rate.passed }} / {{ session_rate.assessed }} ({{ session_rate.rate }} %)</td></tr>
  {% endif %}
</table>

{% if training.description %}
  <h2>{{ __('Description', 'grcmanager') }}</h2>
  <p>{{ training.description|nl2br }}</p>
{% endif %}

<h2>{{ __('Attendance and results', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Participant', 'grcmanager') }}</th>
      <th>{{ __('Completion status', 'grcmanager') }}</th>
      <th>{{ __('Completion date', 'grcmanager') }}</th>
      {% if is_scored %}<th>{{ __('Score', 'grcmanager') }}</th>{% endif %}
      <th>{{ __('Assessment', 'grcmanager') }}</th>
      <th style="width: 22%;">{{ __('Signature', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for p in participants %}
      <tr>
        <td>{{ p.name }}</td>
        <td>{{ p.status_label }}</td>
        <td>{{ p.date_label }}</td>
        {% if is_scored %}<td>{{ p.score_label }}</td>{% endif %}
        <td>{{ p.result_label }}</td>
        <td style="height: 28px;"></td>
      </tr>
    {% else %}
      <tr><td colspan="{{ is_scored ? 6 : 5 }}">{{ __('No participant.', 'grcmanager') }}</td></tr>
    {% endfor %}
  </tbody>
</table>
