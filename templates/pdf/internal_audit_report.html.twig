{# Issue #140 : rapport d'un audit interne, archivé en document à sa clôture (clause 9.2) #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Auditor', 'grcmanager') }}</td><td>{{ auditor }}</td></tr>
  <tr><td>{{ __('Status', 'grcmanager') }}</td><td>{{ status }}</td></tr>
  <tr><td>{{ __('Planned / actual date', 'grcmanager') }}</td><td>{{ planned_date }} / {{ actual_date }}</td></tr>
  {% if categories is not empty %}<tr><td>{{ __('Risk categories', 'grcmanager') }}</td><td>{{ categories|join(', ') }}</td></tr>{% endif %}
  <tr><td>{{ __('Findings', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ findings|length }}</td></tr>
</table>

{% if audit.scope %}
  <h2>{{ __('Scope', 'grcmanager') }}</h2>
  <p>{{ audit.scope|nl2br }}</p>
{% endif %}

{# Issue #773, lot 2 : objectifs, critères, processus, auditeurs (compétence, indépendance) et
   remise du rapport à la direction. #}
{% if audit.objectives is defined and audit.objectives %}
  <h2>{{ __('Audit objectives', 'grcmanager') }}</h2>
  <p>{{ audit.objectives|nl2br }}</p>
{% endif %}
{% if audit.criteria is defined and audit.criteria %}
  <h2>{{ __('Audit criteria', 'grcmanager') }}</h2>
  <p>{{ audit.criteria|nl2br }}</p>
{% endif %}
{% if programme %}
  {% if programme.processes is not empty %}
    <h2>{{ __('Audited processes', 'grcmanager') }}</h2>
    <ul>{% for process in programme.processes %}<li>{{ process }}</li>{% endfor %}</ul>
  {% endif %}
  <h2>{{ __('Audit checkpoints', 'grcmanager') }}</h2>
  <table class="grcmanager-pdf-table">
    <tbody>
      {% for line in programme.checks %}<tr><td>{{ line.label }}</td><td>{{ line.state }}</td></tr>{% endfor %}
    </tbody>
  </table>
  {% if programme.auditors is not empty %}
    <h2>{{ __('Auditor competence', 'grcmanager') }}</h2>
    <table class="grcmanager-pdf-table">
      <thead><tr><th>{{ __('Auditor', 'grcmanager') }}</th><th>{{ __('Competence', 'grcmanager') }}</th><th>{{ __('Qualifying trainings', 'grcmanager') }}</th></tr></thead>
      <tbody>
        {% for a in programme.auditors %}<tr><td>{{ a.name }}</td><td>{{ a.status }}</td><td>{{ a.trainings|join(', ') }}</td></tr>{% endfor %}
      </tbody>
    </table>
  {% endif %}
  <h2>{{ __('Independence of the auditors', 'grcmanager') }}</h2>
  {% if programme.conflicts is empty %}
    <p>{{ __('No independence conflict between the auditors and the audited processes.', 'grcmanager') }}</p>
  {% else %}
    <table class="grcmanager-pdf-table">
      <thead><tr><th>{{ __('Auditor', 'grcmanager') }}</th><th>{{ __('Process', 'grcmanager') }}</th><th>{{ __('Role in the matrix', 'grcmanager') }}</th><th>{{ __('Justification', 'grcmanager') }}</th></tr></thead>
      <tbody>
        {% for c in programme.conflicts %}
          <tr>
            <td>{{ c.user }}</td>
            <td>{{ c.process }}</td>
            <td>{{ c.role_label }}</td>
            <td>{% if c.waiver %}{{ c.waiver.justification|nl2br }} ({{ __('%1$s, %2$s', 'grcmanager')|format(c.waiver.author, c.waiver.date) }}){% else %}{{ __('To justify', 'grcmanager') }}{% endif %}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
  <h2>{{ __('Report delivered to management', 'grcmanager') }}</h2>
  <p>{{ programme.delivery ?: __('Not yet delivered to management', 'grcmanager') }}</p>
{% endif %}

{% if controls is not empty %}
  <h2>{{ __('Audited controls', 'grcmanager') }}</h2>
  <ul>
    {% for control in controls %}<li>{{ control }}</li>{% endfor %}
  </ul>
{% endif %}

{# Issue #538 : demandes de preuves de l'auditeur et leur état à la date du rapport. #}
{% if evidence_requests is not empty %}
  <h2>{{ _n('Evidence request', 'Evidence requests', 2, 'grcmanager') }}</h2>
  <p>{{ __('%1$d of %2$d request(s) accepted (%3$d %%).', 'grcmanager')|format(evidence_progress.accepted, evidence_progress.total, evidence_progress.percent) }}</p>
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Request', 'grcmanager') }}</th>
        <th>{{ __('Control', 'grcmanager') }}</th>
        <th>{{ __('Assignee', 'grcmanager') }}</th>
        <th>{{ __('Due date', 'grcmanager') }}</th>
        <th>{{ __('Status', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for r in evidence_requests %}
        <tr>
          <td>{{ r.label }}</td>
          <td>{{ r.control }}</td>
          <td>{{ r.assignee }}</td>
          <td>{{ r.due_date }}</td>
          <td>{{ r.status }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

{# Issue #606 : grille d'audit par exigence (question, audité, preuves examinées, résultat, constat). #}
{% if checklist is defined and checklist.rows is not empty %}
  <h2>{{ __('Audit checklist', 'grcmanager') }}</h2>
  <p>{{ __('%1$d of %2$d audited', 'grcmanager')|format(checklist.summary.audited, checklist.summary.total) }}
    {% for key, label in checklist_results %}{% if checklist.summary.counts[key] > 0 %} | {{ __('%1$s: %2$d', 'grcmanager')|format(label, checklist.summary.counts[key]) }}{% endif %}{% endfor %}</p>
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Requirement', 'grcmanager') }}</th>
        <th>{{ __('Question asked', 'grcmanager') }}</th>
        <th>{{ __('Auditee', 'grcmanager') }}</th>
        <th>{{ __('Evidence examined', 'grcmanager') }}</th>
        <th>{{ __('Result', 'grcmanager') }}</th>
        <th>{{ __('Comment', 'grcmanager') }}</th>
        <th>{{ __('Finding', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for line in checklist.rows %}
        <tr>
          <td>{{ line.title }}</td>
          <td>{{ line.question|nl2br }}</td>
          <td>{{ line.auditee }}</td>
          <td>{{ line.evidence|nl2br }}{% for doc in line.documents %}<br>{{ doc.name }}{% endfor %}</td>
          <td>{{ line.result_label }}</td>
          <td>{{ line.comment|nl2br }}</td>
          <td>{{ line.finding_title }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

<h2>{{ __('Findings', 'grcmanager') }}</h2>
{% if findings is empty %}
  <p>{{ __('No finding for this audit.', 'grcmanager') }}</p>
{% else %}
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Title', 'grcmanager') }}</th>
        <th>{{ __('Finding type', 'grcmanager') }}</th>
        <th>{{ __('Severity', 'grcmanager') }}</th>
        <th>{{ __('Status', 'grcmanager') }}</th>
        <th>{{ __('Corrective action', 'grcmanager') }}</th>
        <th>{{ __('Owner', 'grcmanager') }}</th>
        <th>{{ __('Due date', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for f in findings %}
        <tr>
          <td>{{ f.title }}</td>
          <td>{{ f.type }}</td>
          <td>{{ f.severity }}</td>
          <td>{{ f.status }}</td>
          <td>{{ f.corrective_action }}</td>
          <td>{{ f.owner }}</td>
          <td>{{ f.due_date }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

{% if audit.conclusion %}
  <h2>{{ __('Conclusion', 'grcmanager') }}</h2>
  <p>{{ audit.conclusion|nl2br }}</p>
{% endif %}
