{# Issue #140 : rapport d'un audit interne, archivé en document à sa clôture (clause 9.2) #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Auditor', 'grcmanager') }}</td><td>{{ auditor }}</td></tr>
  <tr><td>{{ __('Status', 'grcmanager') }}</td><td>{{ status }}</td></tr>
  <tr><td>{{ __('Planned / actual date', 'grcmanager') }}</td><td>{{ planned_date }} / {{ actual_date }}</td></tr>
  {% if categories is not empty %}<tr><td>{{ __('Risk categories', 'grcmanager') }}</td><td>{{ categories|join(', ') }}</td></tr>{% endif %}
  <tr><td>{{ __('Findings', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ findings|length }}</td></tr>
</table>

{% if audit.scope %}
  <h2>{{ __('Scope', 'grcmanager') }}</h2>
  <p>{{ audit.scope|nl2br }}</p>
{% endif %}

{% if controls is not empty %}
  <h2>{{ __('Audited controls', 'grcmanager') }}</h2>
  <ul>
    {% for control in controls %}<li>{{ control }}</li>{% endfor %}
  </ul>
{% endif %}

<h2>{{ __('Findings', 'grcmanager') }}</h2>
{% if findings is empty %}
  <p>{{ __('No finding for this audit.', 'grcmanager') }}</p>
{% else %}
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th>{{ __('Title', 'grcmanager') }}</th>
        <th>{{ __('Finding type', 'grcmanager') }}</th>
        <th>{{ __('Severity', 'grcmanager') }}</th>
        <th>{{ __('Status', 'grcmanager') }}</th>
        <th>{{ __('Corrective action', 'grcmanager') }}</th>
        <th>{{ __('Owner', 'grcmanager') }}</th>
        <th>{{ __('Due date', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for f in findings %}
        <tr>
          <td>{{ f.title }}</td>
          <td>{{ f.type }}</td>
          <td>{{ f.severity }}</td>
          <td>{{ f.status }}</td>
          <td>{{ f.corrective_action }}</td>
          <td>{{ f.owner }}</td>
          <td>{{ f.due_date }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

{% if audit.conclusion %}
  <h2>{{ __('Conclusion', 'grcmanager') }}</h2>
  <p>{{ audit.conclusion|nl2br }}</p>
{% endif %}
