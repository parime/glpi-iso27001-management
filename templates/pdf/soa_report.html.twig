{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

{# Issue #112 : version figée soumise à l'approbation de la direction. #}
{% if approval is not null %}
<table class="grcmanager-pdf-summary">
  <tr>
    <td><strong>{{ __('Version submitted for approval', 'grcmanager') }}</strong></td>
    <td class="grcmanager-pdf-summary-number">{{ __('Version %d', 'grcmanager')|format(approval.version) }}</td>
  </tr>
  <tr>
    <td>{{ __('Requested on %1$s by %2$s', 'grcmanager')|format(approval.requested_at, approval.requested_by) }}</td>
    <td>{{ __('Content fingerprint (SHA-256)', 'grcmanager') }} : {{ approval.fingerprint|slice(0, 16) }}…</td>
  </tr>
</table>
{% endif %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr>
    <td>{{ __('Annex A controls', 'grcmanager') }}</td>
    <td class="grcmanager-pdf-summary-number">{{ total_count }}</td>
  </tr>
  <tr>
    <td>{{ __('Reviewed controls', 'grcmanager') }}</td>
    <td class="grcmanager-pdf-summary-number">{{ reviewed_count.number }} / {{ total_count }}</td>
  </tr>
</table>

<table class="grcmanager-pdf-summary">
  <tr>
    <td><strong>{{ __('By applicability', 'grcmanager') }}</strong></td>
    <td><strong>{{ __('By implementation status', 'grcmanager') }}</strong></td>
  </tr>
  <tr>
    <td>
      {% for entry in by_applicability.data %}
        {{ entry.label }} : {{ entry.number }}<br>
      {% endfor %}
    </td>
    <td>
      {% for entry in by_status.data %}
        {{ entry.label }} : {{ entry.number }}<br>
      {% endfor %}
    </td>
  </tr>
</table>

{# Issue #609 : synthèse par thème ; mises en œuvre, en cours et non démarrées parmi les mesures applicables. #}
<h2>{{ __('Summary by theme', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Theme', 'grcmanager') }}</th>
      <th>{{ __('Controls', 'grcmanager') }}</th>
      <th>{{ __('Applicable', 'grcmanager') }}</th>
      <th>{{ __('Excluded', 'grcmanager') }}</th>
      <th>{{ __('Implemented', 'grcmanager') }}</th>
      <th>{{ __('In progress', 'grcmanager') }}</th>
      <th>{{ __('Planned', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for line in theme_summary.lines %}
      <tr>
        <td>{{ line.label }}</td>
        <td>{{ line.total }}</td>
        <td>{{ line.applicable }}{% if line.partial > 0 %} ({{ __('%d partially', 'grcmanager')|format(line.partial) }}){% endif %}</td>
        <td>{{ line.excluded }}</td>
        <td>{{ line.implemented }}</td>
        <td>{{ line.in_progress }}</td>
        <td>{{ line.not_started }}</td>
      </tr>
    {% endfor %}
    <tr>
      <td><strong>{{ __('Total', 'grcmanager') }}</strong></td>
      <td><strong>{{ theme_summary.totals.total }}</strong></td>
      <td><strong>{{ theme_summary.totals.applicable }}</strong>{% if theme_summary.totals.partial > 0 %} ({{ __('%d partially', 'grcmanager')|format(theme_summary.totals.partial) }}){% endif %}</td>
      <td><strong>{{ theme_summary.totals.excluded }}</strong></td>
      <td><strong>{{ theme_summary.totals.implemented }}</strong></td>
      <td><strong>{{ theme_summary.totals.in_progress }}</strong></td>
      <td><strong>{{ theme_summary.totals.not_started }}</strong></td>
    </tr>
  </tbody>
</table>

{# Issue #109 : preuves agrégées issues du plugin assetsign (A.5.9, A.5.10, A.5.11), section
   absente si assetsign n'est pas installé et actif. Type 0 = remise, 1 = restitution. #}
{% if assetsign_evidence is not null %}
<h2>{{ __('assetsign evidence (A.5.9, A.5.10, A.5.11)', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th></th>
      <th>{{ __('Signed', 'grcmanager') }}</th>
      <th>{{ __('Pending', 'grcmanager') }}</th>
      <th>{{ __('Expired', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>{{ __('Handovers (A.5.9, A.5.10)', 'grcmanager') }}</td>
      <td>{{ assetsign_evidence[0].signed }}</td>
      <td>{{ assetsign_evidence[0].pending }}</td>
      <td>{{ assetsign_evidence[0].expired }}</td>
    </tr>
    <tr>
      <td>{{ __('Returns (A.5.11)', 'grcmanager') }}</td>
      <td>{{ assetsign_evidence[1].signed }}</td>
      <td>{{ assetsign_evidence[1].pending }}</td>
      <td>{{ assetsign_evidence[1].expired }}</td>
    </tr>
  </tbody>
</table>
{% endif %}

{# Issue #610 : taux de mise en œuvre par type de mesure, propriété et concept de cybersécurité. #}
{% if attribute_summary is not empty %}
<h2>{{ __('Summary by attribute', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Attribute', 'grcmanager') }}</th>
      <th>{{ __('Value', 'grcmanager') }}</th>
      <th>{{ __('Applicable controls', 'grcmanager') }}</th>
      <th>{{ __('Implemented', 'grcmanager') }}</th>
      <th>{{ __('Implementation rate', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for attribute in attribute_summary %}
      {% for line in attribute.lines %}
        <tr>
          <td>{{ loop.first ? attribute.label : '' }}</td>
          <td>{{ line.label }}</td>
          <td>{{ line.applicable }} / {{ line.total }}</td>
          <td>{{ line.implemented }}</td>
          <td>{{ line.rate is null ? '-' : (line.rate|round ~ ' %') }}</td>
        </tr>
      {% endfor %}
    {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>{{ __('Control details', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Code') }}</th>
      <th>{{ __('Theme', 'grcmanager') }}</th>
      <th>{{ _x('label', 'Title', 'grcmanager') }}</th>
      <th>{{ __('Applicability', 'grcmanager') }}</th>
      <th>{{ __('Implementation status', 'grcmanager') }}</th>
      <th>{{ __('Reasons for selection', 'grcmanager') }}</th>
      <th>{{ __('Justification', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for control in controls %}
      <tr>
        <td>{{ control.code }}</td>
        <td>{{ control.theme }}</td>
        <td>
          {{ control.title }}
          {# Issue #610 : attributs de la mesure (ISO/IEC 27002:2022), sous l'intitulé. #}
          {% for name, values in control.attributes %}
            <br><small>{{ name }} : {{ values }}</small>
          {% endfor %}
        </td>
        <td>{{ control.applicability }}</td>
        <td>{{ control.implementation_status }}</td>
        <td>{{ control.selection_reasons }}</td>
        <td>
          {{ control.justification }}
          {# Issue #609 : détail de l'exclusion, sous la justification. #}
          {% if control.exclusion.category is defined %}<br><small>{{ __('Exclusion category', 'grcmanager') }} : {{ control.exclusion.category }}</small>{% endif %}
          {% if control.exclusion.controls is defined %}<br><small>{{ __('Compensating controls', 'grcmanager') }} : {{ control.exclusion.controls }}</small>{% endif %}
          {% if control.exclusion.measures is defined %}<br><small>{{ __('Compensating measures', 'grcmanager') }} : {{ control.exclusion.measures }}</small>{% endif %}
          {% if control.exclusion.residual is defined %}<br><small>{{ __('Residual risk', 'grcmanager') }} : {{ control.exclusion.residual }}</small>{% endif %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{# Issue #113 : exigences du système de management (articles 4 à 10), références et titres courts
   uniquement. #}
{% if clauses is not empty %}
<h2>{{ __('ISMS requirements (clauses 4 to 10)', 'grcmanager') }}</h2>
<p>{{ __('ISMS completeness: %1$d %% (%2$d / %3$d requirements compliant)', 'grcmanager')|format(clause_completion.percent, clause_completion.compliant, clause_completion.total) }}</p>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Requirement', 'grcmanager') }}</th>
      <th>{{ _x('label', 'Title', 'grcmanager') }}</th>
      <th>{{ __('Status') }}</th>
      <th>{{ __('Owner', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for clause in clauses %}
      <tr>
        <td>{{ clause.code }}</td>
        <td>{{ clause.title }}</td>
        <td>{{ clause.status }}</td>
        <td>{{ clause.owner }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{# Issue #112 : bloc de signature manuscrite (approbation hors ligne ou en complément). #}
{% if approval is not null %}
<h2>{{ __('Management approval', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Approver', 'grcmanager') }}</th>
      <th>{{ __('Date') }}</th>
      <th>{{ __('Signature', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for approver in approval.approvers %}
      <tr>
        <td>{{ approver }}</td>
        <td style="height: 40px"></td>
        <td></td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}
