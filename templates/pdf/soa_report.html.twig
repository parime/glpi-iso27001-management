{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

{# Issue #112 : version figée soumise à l'approbation de la direction. #}
{% if approval is not null %}
<table class="grcmanager-pdf-summary">
  <tr>
    <td><strong>{{ __('Version submitted for approval', 'grcmanager') }}</strong></td>
    <td class="grcmanager-pdf-summary-number">{{ __('Version %d', 'grcmanager')|format(approval.version) }}</td>
  </tr>
  <tr>
    <td>{{ __('Requested on %1$s by %2$s', 'grcmanager')|format(approval.requested_at, approval.requested_by) }}</td>
    <td>{{ __('Content fingerprint (SHA-256)', 'grcmanager') }} : {{ approval.fingerprint|slice(0, 16) }}…</td>
  </tr>
</table>
{% endif %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr>
    <td>{{ __('Annex A controls', 'grcmanager') }}</td>
    <td class="grcmanager-pdf-summary-number">{{ total_count }}</td>
  </tr>
  <tr>
    <td>{{ __('Reviewed controls', 'grcmanager') }}</td>
    <td class="grcmanager-pdf-summary-number">{{ reviewed_count.number }} / {{ total_count }}</td>
  </tr>
</table>

<table class="grcmanager-pdf-summary">
  <tr>
    <td><strong>{{ __('By applicability', 'grcmanager') }}</strong></td>
    <td><strong>{{ __('By implementation status', 'grcmanager') }}</strong></td>
  </tr>
  <tr>
    <td>
      {% for entry in by_applicability.data %}
        {{ entry.label }} : {{ entry.number }}<br>
      {% endfor %}
    </td>
    <td>
      {% for entry in by_status.data %}
        {{ entry.label }} : {{ entry.number }}<br>
      {% endfor %}
    </td>
  </tr>
</table>

{# Issue #109 : preuves agrégées issues du plugin assetsign (A.5.9, A.5.10, A.5.11), section
   absente si assetsign n'est pas installé et actif. Type 0 = remise, 1 = restitution. #}
{% if assetsign_evidence is not null %}
<h2>{{ __('assetsign evidence (A.5.9, A.5.10, A.5.11)', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th></th>
      <th>{{ __('Signed', 'grcmanager') }}</th>
      <th>{{ __('Pending', 'grcmanager') }}</th>
      <th>{{ __('Expired', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>{{ __('Handovers (A.5.9, A.5.10)', 'grcmanager') }}</td>
      <td>{{ assetsign_evidence[0].signed }}</td>
      <td>{{ assetsign_evidence[0].pending }}</td>
      <td>{{ assetsign_evidence[0].expired }}</td>
    </tr>
    <tr>
      <td>{{ __('Returns (A.5.11)', 'grcmanager') }}</td>
      <td>{{ assetsign_evidence[1].signed }}</td>
      <td>{{ assetsign_evidence[1].pending }}</td>
      <td>{{ assetsign_evidence[1].expired }}</td>
    </tr>
  </tbody>
</table>
{% endif %}

<h2>{{ __('Control details', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Code') }}</th>
      <th>{{ __('Theme', 'grcmanager') }}</th>
      <th>{{ __('Intitulé') }}</th>
      <th>{{ __('Applicability', 'grcmanager') }}</th>
      <th>{{ __('Implementation status', 'grcmanager') }}</th>
      <th>{{ __('Justification', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for control in controls %}
      <tr>
        <td>{{ control.code }}</td>
        <td>{{ control.theme }}</td>
        <td>{{ control.title }}</td>
        <td>{{ control.applicability }}</td>
        <td>{{ control.implementation_status }}</td>
        <td>{{ control.justification }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{# Issue #113 : exigences du système de management (articles 4 à 10), références et titres courts
   uniquement. #}
{% if clauses is not empty %}
<h2>{{ __('ISMS requirements (clauses 4 to 10)', 'grcmanager') }}</h2>
<p>{{ __('ISMS completeness: %1$d %% (%2$d / %3$d requirements compliant)', 'grcmanager')|format(clause_completion.percent, clause_completion.compliant, clause_completion.total) }}</p>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Requirement', 'grcmanager') }}</th>
      <th>{{ __('Intitulé') }}</th>
      <th>{{ __('Statut') }}</th>
      <th>{{ __('Owner', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for clause in clauses %}
      <tr>
        <td>{{ clause.code }}</td>
        <td>{{ clause.title }}</td>
        <td>{{ clause.status }}</td>
        <td>{{ clause.owner }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{# Issue #112 : bloc de signature manuscrite (approbation hors ligne ou en complément). #}
{% if approval is not null %}
<h2>{{ __('Management approval', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Approver', 'grcmanager') }}</th>
      <th>{{ __('Date') }}</th>
      <th>{{ __('Signature', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for approver in approval.approvers %}
      <tr>
        <td>{{ approver }}</td>
        <td style="height: 40px"></td>
        <td></td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}
