{# Issue #771 : registre des contacts officiels en PDF (A.5.5, A.5.6), à imprimer pour l'avoir hors
   ligne pendant une crise. #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Official contacts', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.total }}</td></tr>
  <tr><td>{{ __('Verified within 12 months', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.verified }}</td></tr>
  <tr><td>{{ __('To verify', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.to_verify }}</td></tr>
</table>

<h2>{{ __('Official contacts', 'grcmanager') }} (A.5.5, A.5.6)</h2>
{% include '@grcmanager/pdf/_official_contacts_table.html.twig' with {'contacts': contacts, 'perimeter': perimeter} only %}
