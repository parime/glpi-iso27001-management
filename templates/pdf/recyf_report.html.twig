{# Issue #599 : rapport de conformité du registre ReCyF (NIS2 France) d'une entité. #}
{% include '@grcmanager/pdf/_pdf_style.html.twig' %}

<h2>{{ __('Summary', 'grcmanager') }}</h2>
<table class="grcmanager-pdf-summary">
  <tr><td>{{ __('Entity', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ entity }}</td></tr>
  <tr><td>{{ __('Classification', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ category_label }}</td></tr>
  <tr><td>{{ __('Reference', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ __('ANSSI, Cyber France framework (ReCyF), working version %s', 'grcmanager')|format(version) }}</td></tr>
  <tr><td>{{ __('Measures', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.total }} ({{ __('%d not applicable', 'grcmanager')|format(summary.not_applicable) }})</td></tr>
  <tr><td>{{ __('Implementation rate', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.rate is null ? '-' : summary.rate ~ ' %' }}</td></tr>
  <tr><td>{{ __('Implemented measures', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.done }} / {{ summary.applicable }}</td></tr>
  <tr><td>{{ __('Overdue', 'grcmanager') }}</td><td class="grcmanager-pdf-summary-number">{{ summary.overdue }}</td></tr>
</table>

<table class="grcmanager-pdf-table">
  <thead>
    <tr>
      <th>{{ __('Objective', 'grcmanager') }}</th>
      <th>{{ __('Measures', 'grcmanager') }}</th>
      <th>{{ __('Implementation rate', 'grcmanager') }}</th>
      <th>{{ __('Overdue', 'grcmanager') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for objective in objectives %}
      <tr>
        <td>{{ objective.number }}. {{ objective.name }}</td>
        <td>{{ objective.summary.total }}</td>
        <td>{{ objective.summary.rate is null ? '-' : objective.summary.rate ~ ' %' }}</td>
        <td>{{ objective.summary.overdue }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{% for objective in objectives %}
  <h2>{{ objective.number }}. {{ objective.name }}</h2>
  <table class="grcmanager-pdf-table">
    <thead>
      <tr>
        <th style="width: 12%;">{{ __('Measure', 'grcmanager') }}</th>
        <th>{{ __('Summary', 'grcmanager') }}</th>
        <th style="width: 12%;">{{ __('Applicability', 'grcmanager') }}</th>
        <th style="width: 12%;">{{ __('Implementation status', 'grcmanager') }}</th>
        <th style="width: 14%;">{{ __('Owner', 'grcmanager') }}</th>
        <th style="width: 11%;">{{ __('Due date', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for line in objective.lines %}
        <tr>
          <td><strong>{{ line.reference }}</strong>{% if line.section %}<br>{{ line.section }}{% endif %}</td>
          <td>{{ line.summary }}</td>
          <td>{{ line.applicability_label }}</td>
          <td>{{ line.status_label }}</td>
          <td>{{ line.owner }}</td>
          <td>{{ line.due_date }}{% if line.overdue %} ({{ __('overdue', 'grcmanager') }}){% endif %}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endfor %}

<p style="font-size: 8px; color: #6c757d;">
  {{ __('Measure numbers come from the ReCyF published by ANSSI; summaries are written by this project and do not replace the official text.', 'grcmanager') }}
</p>
