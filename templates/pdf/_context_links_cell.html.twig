{# Issue #608, lot 2 : cellule « Liens avec le SMSI » du registre PDF du contexte (risques,
   obligations et mesures lisibles par la personne qui exporte). #}
<td>
  {% if line.risks is not empty %}<strong>{{ __('Related risks', 'grcmanager') }} :</strong> {{ line.risks|join(', ') }}<br>{% endif %}
  {% if line.obligations is not empty %}<strong>{{ __('Related obligations', 'grcmanager') }} :</strong> {{ line.obligations|join(', ') }}<br>{% endif %}
  {% if line.controls is not empty %}<strong>{{ __('Controls that respond', 'grcmanager') }} :</strong> {{ line.controls|join(', ') }}{% endif %}
  {% if line.risks is empty and line.obligations is empty and line.controls is empty %}-{% endif %}
</td>
