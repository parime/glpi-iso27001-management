{# Issue #772, lot 2 : onglet « Plan d'audit de l'organisme » d'un audit de certification. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
<div id="grc-certification-sampling-tab">
<div class="card mb-3">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-table-options me-2"></i>{{ __('Processes sampled by the certification body', 'grcmanager') }}</h3>
      <div class="card-actions">
         <a href="{{ plan_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-table-options me-1"></i>{{ __('Audit plan of the certification body', 'grcmanager') }}</a>
      </div>
   </div>
   <div class="card-body">
      <p class="text-muted small"><i class="ti ti-info-circle me-1"></i>{{ __('Copy here the processes that the audit plan of the certification body announces for this audit. They are the processes of the internal audit programme (ISMS activities of the responsibility matrix).', 'grcmanager') }}</p>
      {% if choices is empty %}
         <div class="alert alert-info mb-0"><i class="ti ti-info-circle me-1"></i>{{ __('No ISMS activity in the entity of the audit: create them in the responsibility matrix first.', 'grcmanager') }}
            {% if raci_url %}<a href="{{ raci_url }}">{{ __('Responsibility matrix', 'grcmanager') }}</a>{% endif %}</div>
      {% elseif can_edit %}
         <form method="post" action="{{ action }}" id="grc-sampling-audit-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="plugin_grcmanager_audits_id" value="{{ audit.getID() }}">
            {{ fields.dropdownArrayField('processes', null, choices, __('Sampled processes', 'grcmanager'), {
               'multiple': true,
               'values': selected,
               'full_width': true,
            }) }}
            <button type="submit" name="save_audit_sampling" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
         </form>
      {% endif %}
   </div>
</div>

<div class="card mb-3">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-checklist me-2"></i>{{ __('Preparing the sampled processes', 'grcmanager') }}</h3>
   </div>
   <div class="card-body">
      {{ include('@grcmanager/certification_sampling_processes.html.twig', {'processes': processes}) }}
   </div>
</div>
</div>
