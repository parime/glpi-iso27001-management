{# Issue #773 : programme d'audit interne pluriannuel (processus x années du cycle), couverture et
   alertes. #}
{% set p = programme %}
{% set states = {
   'done':    ['bg-green-lt', 'ti-circle-check', __('Audited', 'grcmanager')],
   'planned': ['bg-blue-lt', 'ti-calendar-event', __('Planned', 'grcmanager')],
   'late':    ['bg-orange-lt', 'ti-clock-exclamation', __('Overdue', 'grcmanager')],
   'none':    ['bg-red-lt', 'ti-alert-triangle', __('Not covered', 'grcmanager')],
} %}
<div class="container-fluid" id="grc-audit-programme">
   <div class="card mb-3">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-calendar-stats me-2"></i>{{ __('Multi-year audit programme', 'grcmanager') }}</h3>
         <div class="card-actions d-flex gap-2">
            {% if new_audit_url %}<a href="{{ new_audit_url }}" class="btn btn-sm btn-primary"><i class="ti ti-plus me-1"></i>{{ __('Plan an audit', 'grcmanager') }}</a>{% endif %}
            <a href="{{ coverage_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-chart-dots-3 me-1"></i>{{ __('Audit programme coverage', 'grcmanager') }}</a>
         </div>
      </div>
      <div class="card-body">
         <form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3" id="grc-programme-cycle">
            <label class="form-label mb-0" for="grc-programme-start">{{ __('Certification cycle', 'grcmanager') }}</label>
            <select name="start" id="grc-programme-start" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
               {% for value, label in start_choices %}
                  <option value="{{ value }}"{% if value == p.start %} selected{% endif %}>{{ label }}</option>
               {% endfor %}
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-primary">{{ __('Show', 'grcmanager') }}</button></noscript>
            <span class="text-muted small">{{ __('From %1$s to %2$s', 'grcmanager')|format(p.from, p.to) }}</span>
         </form>

         <div class="row g-2 mb-3">
            {% for key, count in {'done': p.covered, 'planned': p.planned, 'late': p.late, 'none': p.uncovered} %}
               <div class="col-6 col-md-3">
                  <div class="card card-sm"><div class="card-body d-flex align-items-center gap-3">
                     <span class="avatar {{ states[key][0] }}"><i class="ti {{ states[key][1] }}"></i></span>
                     <div><div class="fw-bold fs-3" id="grc-programme-{{ key }}">{{ count }}</div><div class="text-muted small">{{ states[key][2] }}</div></div>
                  </div></div>
               </div>
            {% endfor %}
         </div>
         {% if p.total > 0 %}
            <div class="mb-1 small">{{ __('Processes audited over the cycle: %1$d of %2$d (%3$d %%)', 'grcmanager')|format(p.covered, p.total, p.percent) }}</div>
            <div class="progress mb-3" style="height: .75rem">
               <div class="progress-bar bg-green" role="progressbar" style="width: {{ p.percent }}%" aria-label="{{ __('Processes audited over the cycle: %1$d of %2$d (%3$d %%)', 'grcmanager')|format(p.covered, p.total, p.percent) }}"></div>
            </div>
         {% endif %}

         {# Alertes du programme. #}
         {% if p.uncovered > 0 or p.late > 0 %}
            <div class="alert alert-warning" id="grc-programme-alert-processes">
               <i class="ti ti-alert-triangle me-1"></i>
               {{ __('%d process(es) have no completed audit over the cycle and none planned on time: plan an audit for each one before the end of the cycle.', 'grcmanager')|format(p.uncovered + p.late) }}
            </div>
         {% endif %}
         {% if p.clauses_never is not empty %}
            <div class="alert alert-warning" id="grc-programme-alert-clauses">
               <i class="ti ti-alert-triangle me-1"></i>
               {{ __('ISMS requirements not covered by any audit checklist of the cycle:', 'grcmanager') }}
               {% for c in p.clauses_never %}<span class="badge bg-red-lt ms-1">{{ c.code }}</span>{% endfor %}
            </div>
         {% endif %}
         {% if p.controls_never > 0 %}
            <div class="alert alert-info">
               <i class="ti ti-info-circle me-1"></i>{{ __('%d applicable control(s) not audited over the cycle.', 'grcmanager')|format(p.controls_never) }}
               <a href="{{ coverage_url }}">{{ __('Audit programme coverage', 'grcmanager') }}</a>
            </div>
         {% endif %}

         {% if new_audit_url and p.rows is not empty %}
            <p class="text-muted small mb-2"><i class="ti ti-info-circle me-1"></i>{{ __('"Plan" creates an internal audit for the process and the year, in the entity of the process. Then complete its objectives, scope, criteria and auditors on the audit.', 'grcmanager') }}</p>
         {% endif %}
         {% if p.rows is empty %}
            <div class="alert alert-info mb-0"><i class="ti ti-info-circle me-1"></i>{{ __('No ISMS process yet. The processes of the programme are the ISMS activities of the responsibility matrix.', 'grcmanager') }}
               {% if raci_url %}<a href="{{ raci_url }}">{{ __('Responsibility matrix', 'grcmanager') }}</a>{% endif %}</div>
         {% else %}
         <div class="table-responsive">
         <table class="table table-sm table-vcenter table-bordered" id="grc-programme-matrix">
            <thead>
               <tr>
                  <th>{{ __('Process', 'grcmanager') }}</th>
                  {% for year in p.years %}<th class="text-center{% if year == p.current_year %} bg-azure-lt{% endif %}">{{ year }}</th>{% endfor %}
                  <th>{{ __('Cycle', 'grcmanager') }}</th>
               </tr>
            </thead>
            <tbody>
            {% for row in p.rows %}
               <tr class="grc-programme-row grc-programme-{{ row.state }}">
                  <td class="fw-bold">{{ row.label }}</td>
                  {% for year in p.years %}
                     {% set cell = row.cells[year] %}
                     <td class="text-center">
                        {% for a in cell.audits %}
                           <div><a href="{{ a.url }}" class="badge {{ states[a.state][0] }}" title="{{ a.status_label }} - {{ a.date_text }}">{{ a.title }}</a></div>
                        {% else %}
                           <span class="text-muted">-</span>
                        {% endfor %}
                        {# Lot 3 : planifier un audit pré-rempli pour ce processus et cette année. #}
                        {% if new_audit_url and cell.can_plan %}
                           <form method="post" action="{{ action }}" class="mt-1 grc-programme-plan">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="process_id" value="{{ row.id }}">
                              <input type="hidden" name="year" value="{{ year }}">
                              <button type="submit" name="plan_audit" value="1" class="btn btn-sm btn-ghost-primary py-0 px-1"
                                 title="{{ __('Plan an internal audit of %1$s in %2$d', 'grcmanager')|format(row.label, year) }}"
                                 aria-label="{{ __('Plan an internal audit of %1$s in %2$d', 'grcmanager')|format(row.label, year) }}">
                                 <i class="ti ti-calendar-plus me-1"></i>{{ __('Plan', 'grcmanager') }}
                              </button>
                           </form>
                        {% endif %}
                     </td>
                  {% endfor %}
                  <td><span class="badge {{ states[row.state][0] }}"><i class="ti {{ states[row.state][1] }} me-1"></i>{{ states[row.state][2] }}</span></td>
               </tr>
            {% endfor %}
            </tbody>
         </table>
         </div>
         {% endif %}

         {% if p.gap_audits > 0 %}
            <div class="alert alert-warning mt-3" id="grc-programme-alert-checks">
               <i class="ti ti-alert-triangle me-1"></i>{{ __('%d audit(s) of the cycle have checkpoints to complete (objectives, criteria, competence or independence of the auditors, report to management): see the table below.', 'grcmanager')|format(p.gap_audits) }}
            </div>
         {% endif %}
         {% if p.unassigned is not empty %}
            <div class="alert alert-info mt-3 mb-0" id="grc-programme-unassigned">
               <i class="ti ti-info-circle me-1"></i>{{ __('Audits of the cycle with no audited process (choose them in the "Programme and independence" tab of the audit):', 'grcmanager') }}
               {% for a in p.unassigned %}<a href="{{ a.url }}" class="badge bg-secondary-lt ms-1">{{ a.title }} ({{ a.date_text }})</a>{% endfor %}
            </div>
         {% endif %}
      </div>
   </div>

   {# Lot 2 : points de contrôle de chaque audit du cycle. #}
   <div class="card mb-3" id="grc-programme-checks">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-list-check me-2"></i>{{ __('Checkpoints of the audits of the cycle', 'grcmanager') }}</h3></div>
      <div class="card-body">
         <p class="text-muted small"><i class="ti ti-info-circle me-1"></i>{{ __('For each internal audit of the cycle: what the certification auditor will look for. Open the audit and its "Programme and independence" tab to complete a missing point.', 'grcmanager') }}</p>
         {% if p.audit_checks is empty %}
            <div class="alert alert-info mb-0"><i class="ti ti-info-circle me-1"></i>{{ __('No internal audit dated in this cycle.', 'grcmanager') }}</div>
         {% else %}
            <div class="d-flex flex-wrap gap-2 mb-2 small">
               {% for state, st in check_states %}<span class="badge {{ st.badge }}"><i class="ti {{ st.icon }} me-1"></i>{{ st.label }}</span>{% endfor %}
            </div>
            <div class="table-responsive">
            <table class="table table-sm table-vcenter" id="grc-programme-checks-table">
               <thead><tr>
                  <th>{{ __('Audit', 'grcmanager') }}</th>
                  <th>{{ __('Date', 'grcmanager') }}</th>
                  {% for key, labels in check_labels %}<th class="text-center" title="{{ labels[1] }}">{{ labels[0] }}</th>{% endfor %}
               </tr></thead>
               <tbody>
               {% for a in p.audit_checks %}
                  <tr class="grc-programme-check-row{{ a.gaps > 0 ? ' grc-has-gaps' : '' }}">
                     <td><a href="{{ a.url }}">{{ a.title }}</a> <span class="badge {{ states[a.state][0] }} ms-1">{{ a.status_label }}</span></td>
                     <td>{{ a.date_text }}</td>
                     {% for key, labels in check_labels %}
                        {% set st = check_states[a.checks[key]] %}
                        <td class="text-center"><span class="badge {{ st.badge }}" role="img" title="{{ labels[1] }} : {{ st.label }}" aria-label="{{ labels[1] }} : {{ st.label }}"><i class="ti {{ st.icon }}" aria-hidden="true"></i></span></td>
                     {% endfor %}
                  </tr>
               {% endfor %}
               </tbody>
            </table>
            </div>
         {% endif %}
      </div>
   </div>

   {# Issue #1045 : réglages du programme dans la configuration du plugin. #}
   {% include '@grcmanager/config/_settings_link.html.twig' with {settings_title: __('Programme settings', 'grcmanager')} %}
</div>
