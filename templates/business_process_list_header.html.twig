{# Issue #377 : boutons de la liste des processus métier (nouveau, export pour le PCA / PRA) #}
<div class="d-flex gap-2 mb-3">
  {% if new_url is not empty %}
    <a href="{{ new_url }}" class="btn btn-primary"><i class="ti ti-plus me-1"></i>{{ __('New business process', 'grcmanager') }}</a>
  {% endif %}
  <a href="{{ programme_url }}" class="btn btn-outline-primary"><i class="ti ti-calendar-repeat me-1"></i>{{ __('Recovery test programme', 'grcmanager') }}</a>
  <a href="{{ report_url }}" class="btn btn-outline-secondary"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Business continuity plan (PDF)', 'grcmanager') }}</a>
  <a href="{{ export_url }}" class="btn btn-outline-secondary"><i class="ti ti-file-spreadsheet me-1"></i>{{ __('Export for the business continuity plan (CSV)', 'grcmanager') }}</a>
</div>
