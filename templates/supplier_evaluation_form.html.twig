{# Issue #864 : évaluation d'un fournisseur (en-tête) : fournisseur et risque évalués, modèle utilisé,
   synthèse des réponses et du score. Les questions sont dans l'onglet « Questionnaire ». #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {% set badge = badges[item.fields['domain']] ?? badges['other'] %}
   {% set status = statuses[item.fields['status']] ?? statuses['in_progress'] %}
   <div class="col-12 mb-3" id="grc-evaluation-summary">
      <div class="d-flex flex-wrap gap-2 align-items-center">
         <span class="badge {{ badge[0] }} fs-5"><i class="ti {{ badge[1] }} me-1"></i>{{ domains[item.fields['domain']] ?? item.fields['domain'] }}</span>
         <span class="badge {{ status[1] }} fs-5" id="grc-evaluation-status"><i class="ti {{ status[2] }} me-1"></i>{{ status[0] }}</span>
         {% if summary.score is not null %}
            <span class="badge {{ levels[summary.level][1] }} fs-5" id="grc-evaluation-score" title="{{ __('Expected answer = 1 point, partial = 0.5, other answer = 0, multiplied by the weight of the question; "not applicable" and unanswered questions are not counted.', 'grcmanager') }}"><i class="ti ti-gauge me-1"></i>{{ __('Score: %1$d%% - %2$s', 'grcmanager')|format(summary.score, levels[summary.level][0]) }}</span>
         {% endif %}
         <span class="badge bg-secondary-subtle text-secondary-emphasis fs-5"><i class="ti ti-list-check me-1"></i>{{ __('%1$d of %2$d questions answered', 'grcmanager')|format(summary.answered, summary.total) }}</span>
         {% if summary.gaps > 0 %}
            <span class="badge bg-orange-subtle text-orange-emphasis fs-5"><i class="ti ti-alert-triangle me-1"></i>{{ _n('%d gap', '%d gaps', summary.gaps, 'grcmanager')|format(summary.gaps) }}</span>
         {% endif %}
         {% if summary.missing_evidence > 0 %}
            <span class="badge bg-red-subtle text-red-emphasis fs-5" id="grc-evaluation-missing"><i class="ti ti-paperclip me-1"></i>{{ _n('%d evidence missing', '%d evidence missing', summary.missing_evidence, 'grcmanager')|format(summary.missing_evidence) }}</span>
         {% endif %}
      </div>
      {% if completed %}
         <div class="alert alert-success mt-3 mb-0"><i class="ti ti-lock me-2"></i>{{ __('This evaluation is completed: its answers can no longer be changed. Reopen it from the "Questionnaire" tab to change them.', 'grcmanager') }}</div>
      {% else %}
         <div class="form-hint mt-2"><i class="ti ti-arrow-right me-1"></i>{{ __('Answer the questions in the "Questionnaire" tab, then mark the evaluation as completed.', 'grcmanager') }}</div>
      {% endif %}
   </div>

   {{ fields.smallTitle(__('Supplier', 'grcmanager'), 'ti ti-truck') }}
   {{ fields.htmlField('', '<i class="ti ti-building-store me-1"></i>' ~ (supplier_name ?: '-')|e, __('Supplier', 'grcmanager')) }}
   {% if risk_url %}
      {{ fields.htmlField('', '<a href="' ~ risk_url|e('html_attr') ~ '"><i class="ti ti-truck me-1"></i>' ~ risk_name|e ~ '</a>', _n('Supplier risk', 'Supplier risks', 1, 'grcmanager')) }}
   {% endif %}
   {% set template_label = __('%1$s (version %2$d)', 'grcmanager')|format(item.fields['template_name'], item.fields['template_version']) %}
   {{ fields.htmlField('', template_url
      ? '<a href="' ~ template_url|e('html_attr') ~ '"><i class="ti ti-forms me-1"></i>' ~ template_label|e ~ '</a>'
      : '<i class="ti ti-forms me-1"></i>' ~ template_label|e, __('Questionnaire template', 'grcmanager')) }}

   {{ fields.smallTitle(__('Evaluation', 'grcmanager'), 'ti ti-clipboard-check') }}
   {{ fields.textField('name', item.fields['name'], __('Name'), {
      'add_field_html': hints.hint(__('For example "Security 2026" or "Personal data - contract renewal".', 'grcmanager')),
   }) }}
   {{ fields.dateField('evaluation_date', item.fields['evaluation_date'], __('Evaluation date', 'grcmanager')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Assessor', 'grcmanager'), {
      'right': 'all',
      'entity': item.fields['entities_id'],
   }) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), {'full_width': true}) }}
{% endblock %}
