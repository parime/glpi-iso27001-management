{# Audit interne, clause 9.2 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Auditor', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dropdownField('User', 'users_id_responsible', item.fields['users_id_responsible'], __('Audit owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: 'planned', statuses, __('Status', 'grcmanager')) }}
   {{ fields.dateField('planned_date', item.fields['planned_date'], __('Planned date', 'grcmanager')) }}
   {{ fields.dateField('actual_date', item.fields['actual_date'], __('Actual date', 'grcmanager')) }}
   {{ fields.textareaField('scope', item.fields['scope'], __('Scope', 'grcmanager'), {
      'full_width': true,
      'add_field_html': hints.hint(__('Free-text description of the audited scope (processes, sites, systems...).', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('risk_categories', null, categories, __('Risk categories covered', 'grcmanager'), {
      'multiple': true,
      'values': risk_categories,
      'full_width': true,
   }) }}
   {{ fields.dropdownArrayField('linked_controls', null, controls, __('Annex A controls covered', 'grcmanager'), {
      'multiple': true,
      'values': linked_controls,
      'full_width': true,
   }) }}
   {{ fields.textareaField('conclusion', item.fields['conclusion'], __('Conclusion', 'grcmanager'), {'full_width': true}) }}
{% endblock %}
