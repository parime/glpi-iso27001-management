{# Issue #612 : activité de la matrice des responsabilités du SMSI (article 5.3, mesure A.5.3). #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {% if alerts is not empty %}
      <div class="col-12">
         <div class="alert alert-warning">
          <div class="w-100">
            <div class="fw-bold mb-1"><i class="ti ti-alert-triangle me-1"></i>{{ __('To fix before the audit', 'grcmanager') }}</div>
            <ul class="mb-1">
               {% for alert in alerts %}
                  <li>
                     <span class="badge {{ alert.severity == 'high' ? 'bg-danger-subtle text-danger-emphasis' : 'bg-warning-subtle text-warning-emphasis' }}">
                        {{ alert.severity == 'high' ? __('To fix', 'grcmanager') : __('To check', 'grcmanager') }}
                     </span>
                     {{ alert.message }}
                  </li>
               {% endfor %}
            </ul>
            <div class="small">{{ __('Nothing is changed automatically: adjust the assignments below if needed.', 'grcmanager') }}</div>
          </div>
         </div>
      </div>
   {% endif %}

   {{ fields.smallTitle(__('Activity', 'grcmanager'), 'ti ti-list-check') }}
   {{ fields.textField('name', item.fields['name'], __('Name'), {
      'placeholder': default_label,
      'add_field_html': default_label
         ? hints.hint(__('Leave empty to keep the default name, shown in the language of each user.', 'grcmanager'))
         : hints.hint(__('For example "Review of firewall rules".', 'grcmanager')),
   }) }}
   {{ fields.checkboxField('is_sensitive', item.fields['is_sensitive'], __('Sensitive activity', 'grcmanager'), {
      'add_field_html': hints.hint(__('The same person must not both perform and approve a sensitive activity (segregation of duties).', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('_control_codes', '', controls, __('Related Annex A controls', 'grcmanager'), {
      'multiple': true, 'values': codes, 'full_width': true,
      'add_field_html': hints.hint(__('Optional: the controls of your Statement of Applicability that this activity implements.', 'grcmanager')),
   }) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), {'full_width': true}) }}

   {% if not item.isNewItem() %}
      {{ fields.smallTitle(__('Who does what', 'grcmanager'), 'ti ti-users-group') }}
      <div class="col-12 mb-3">
         {% if assignments is empty %}
            <div class="text-secondary"><i class="ti ti-info-circle me-1"></i>{{ __('Nobody is assigned yet. Add below who performs and who approves this activity.', 'grcmanager') }}</div>
         {% else %}
            <table class="table table-sm table-hover align-middle mb-0">
               <thead>
                  <tr>
                     <th>{{ __('Role', 'grcmanager') }}</th>
                     <th>{{ __('User or group', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Remove', 'grcmanager') }}</th>
                  </tr>
               </thead>
               <tbody>
                  {% for row in assignments %}
                     {% set style = role_styles[row.role] %}
                     <tr>
                        <td><span class="badge {{ style.class }}"><i class="ti {{ style.icon }} me-1"></i>{{ roles[row.role] }}</span></td>
                        <td><i class="ti {{ row.itemtype == 'Group' ? 'ti-users' : 'ti-user' }} me-1 text-secondary"></i>{{ row.label }}</td>
                        <td class="text-end">
                           <input type="checkbox" class="form-check-input" name="_remove_assignments[]" value="{{ row.id }}" aria-label="{{ __('Remove', 'grcmanager') }}">
                        </td>
                     </tr>
                  {% endfor %}
               </tbody>
            </table>
         {% endif %}
      </div>
      {{ fields.dropdownArrayField('_add_role', '', {'': '-----'}|merge(roles), __('Add a role', 'grcmanager'), {
         'add_field_html': hints.hint(__('Choose the role, then a user or a group, and save. Only one person or group approves.', 'grcmanager')),
      }) }}
      {{ fields.dropdownField('User', '_add_users_id', 0, user_label, {
         'right': 'all', 'entity': entity_id, 'entity_sons': recursive,
      }) }}
      {{ fields.dropdownField('Group', '_add_groups_id', 0, group_label, {
         'entity': entity_id, 'entity_sons': recursive,
      }) }}
   {% endif %}
{% endblock %}
