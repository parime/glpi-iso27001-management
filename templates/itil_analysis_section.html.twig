{# Absorbé depuis glpi-security-incidents (ROADMAP.md "Version 2.0") — voir
   plugin_grcmanager_post_itil_info_section() dans hook.php. #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set analysis_fields = {
   'impact_content': __('Impact', 'grcmanager'),
   'control_list_content': __('Contrôles appliqués / à appliquer', 'grcmanager'),
   'rollback_plan_content': __('Plan de retour arrière / confinement', 'grcmanager'),
} %}

{% set nb_analysis = 0 %}
{% for analysis_field, label in analysis_fields %}
   {% if item.fields[analysis_field]|default('')|trim|length > 0 %}
      {% set nb_analysis = nb_analysis + 1 %}
   {% endif %}
{% endfor %}

<section class="accordion-item" aria-label="{{ __('Analyse', 'grcmanager') }}">
   <div class="accordion-header" id="grcmanager-analysis-heading" title="{{ __('Analyse', 'grcmanager') }}" data-bs-toggle="tooltip">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#grcmanager-analysis" aria-expanded="true" aria-controls="grcmanager-analysis">
         <i class="ti ti-eyeglass"></i>
         <span class="item-title">
            {{ __('Analyse', 'grcmanager') }}
         </span>
         {% if nb_analysis > 0 %}
            <span class="badge bg-secondary text-secondary-fg ms-2">{{ nb_analysis }}</span>
         {% endif %}
      </button>
   </div>
   <div id="grcmanager-analysis" class="accordion-collapse collapse show" aria-labelledby="grcmanager-analysis-heading">
      <div class="accordion-body row m-0 mt-n2">
         {% for analysis_field, label in analysis_fields %}
            {{ fields.textareaField(
               analysis_field,
               item.fields[analysis_field],
               label,
               {
                  'full_width': true,
                  'is_horizontal': false,
                  'enable_richtext': false,
                  'disabled': not item.canUpdateItem(),
                  'rand': rand,
               }
            ) }}
         {% endfor %}
      </div>
   </div>
</section>
