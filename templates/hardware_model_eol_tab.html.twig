{# Issue #1039 : onglet « Fin de vie constructeur » d'une fiche de modèle de matériel de GLPI
   (GlpiPlugin\Grcmanager\HardwareModelEol). Rien n'est écrit dans le modèle de GLPI. #}
<div class="card m-2" id="grc-hardware-model-eol">
  <div class="card-body">
    <h4 class="d-flex align-items-center flex-wrap gap-2">
      <i class="ti ti-calendar-x" aria-hidden="true"></i>{{ __('Manufacturer end of life', 'grcmanager') }}
      {% if status %}<span class="badge bg-{{ status.color }}-subtle text-{{ status.color }}-emphasis" title="{{ status.help }}"><i class="{{ status.icon }} me-1" aria-hidden="true"></i>{{ status.label }}</span>{% endif %}
    </h4>
    <p class="text-muted mb-2">
      {{ __('The date after which the manufacturer no longer provides repairs, spare parts or firmware updates for this model (optional). The hardware of this model is then shown as "end of life reached" or "soon" in Assets > Asset security (ISO 27001 A.7.13 and A.8.9).', 'grcmanager') }}
    </p>
    <ul class="list-unstyled small mb-3">
      {% if asset_type %}<li><i class="ti ti-devices me-1" aria-hidden="true"></i>{{ __('Hardware of this model in your entities', 'grcmanager') }} : <strong>{{ assets }}</strong> <span class="text-muted">({{ asset_type }})</span></li>{% endif %}
      {% if detail %}<li><i class="ti ti-calendar me-1" aria-hidden="true"></i>{{ detail }}</li>{% endif %}
      <li><i class="ti ti-bell me-1" aria-hidden="true"></i>{{ __('"End of life soon": within %d days.', 'grcmanager')|format(warning_days) }}</li>
    </ul>
    <form method="post" action="{{ action }}" class="row g-2 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="from_model" value="1">
      <div class="col-auto">
        <label class="form-label" for="grc-model-eol-date">{{ __('Manufacturer end of life date', 'grcmanager') }}</label>
        <input type="date" class="form-control" id="grc-model-eol-date" name="hardware_eol[{{ field }}]" value="{{ date }}" {{ can_edit ? '' : 'disabled' }}>
      </div>
      {% if can_edit %}
        <div class="col-auto">
          <button type="submit" name="update_hardware_eol" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ _x('button', 'Save') }}</button>
        </div>
      {% endif %}
      <div class="col-auto">
        <a class="btn btn-ghost-secondary" href="{{ bulk_url }}"><i class="ti ti-table me-1" aria-hidden="true"></i>{{ __('All the models', 'grcmanager') }}</a>
      </div>
    </form>
  </div>
</div>
