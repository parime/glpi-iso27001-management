{# Événement du calendrier de conformité, issue #142 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.dropdownArrayField('event_type', item.fields['event_type'] ?: default_type, types, __('Type', 'grcmanager')) }}
   {{ fields.textField('name', item.fields['name'], __('Name', 'grcmanager'), {
      'add_field_html': hints.hint(__('If left empty, the type is used as the name.', 'grcmanager')),
   }) }}
   {{ fields.datetimeField('date_begin', item.fields['date_begin'], __('Start', 'grcmanager'), {'required': true}) }}
   {{ fields.datetimeField('date_end', item.fields['date_end'], __('End', 'grcmanager'), {
      'add_field_html': hints.hint(__('Empty: the day of the start.', 'grcmanager')),
   }) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], __('Owner', 'grcmanager'), {
      'right': 'all',
      'add_field_html': hints.hint(__('The event appears in their GLPI planning.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: default_status, statuses, __('Status', 'grcmanager')) }}
   {{ fields.dropdownField('Supplier', 'suppliers_id', item.fields['suppliers_id'], __('Provider', 'grcmanager')) }}
   {{ fields.textareaField('scope', item.fields['scope'], __('Scope', 'grcmanager')) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments', 'grcmanager'), {'full_width': true}) }}
{% endblock %}
