{# Issue #538 : « Mes demandes de preuves ». Demandes d'audit confiées à la personne connectée : ajouter
   un fichier ou une preuve existante de la mesure, retirer une pièce en préparation, soumettre ; puis
   l'historique des demandes soumises ou acceptées. #}
<div class="container-fluid my-2">
   <div class="card mb-3">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-file-upload me-2"></i>{{ __('My evidence requests', 'grcmanager') }}</h3>
         <div class="card-actions">
            <span class="badge {{ waiting is empty ? 'bg-green-lt' : 'bg-orange-lt' }}" id="grc-evreq-mine-count"><i class="ti ti-hourglass me-1"></i>{{ __('%d waiting for you', 'grcmanager')|format(waiting|length) }}</span>
         </div>
      </div>
      <div class="card-body">
         <p class="text-muted small">
            <i class="ti ti-info-circle me-1"></i>{{ __('An audit needs these documents from you. For each request, add one or more files (or an existing evidence of the control), then click "Submit to the audit". Until you submit, nobody outside the audit team sees your documents; once submitted, the auditor can read them.', 'grcmanager') }}
         </p>
         {% if waiting is empty %}
            <div class="alert alert-success mb-0" id="grc-evreq-mine-empty"><i class="ti ti-circle-check me-1"></i>{{ __('No evidence is waiting for you.', 'grcmanager') }}</div>
         {% endif %}
      </div>
   </div>

   {% for row in waiting %}
      <div class="card mb-3 grc-evreq-mine{% if row.overdue %} border-danger{% endif %}" id="grc-evreq-{{ row.id }}">
         <div class="card-header">
            <div>
               <h3 class="card-title mb-1"><i class="ti ti-file-search me-2"></i>{{ row.label }}</h3>
               <div class="text-muted small"><i class="ti ti-clipboard-check me-1"></i>{{ __('Audit: %s', 'grcmanager')|format(row.audit_title) }}</div>
            </div>
            <div class="card-actions d-flex flex-wrap gap-1">
               <span class="badge {{ row.status_class }} grc-evreq-badge"><i class="ti {{ row.status_icon }} me-1"></i>{{ row.status_label }}</span>
               {% if row.due_text %}
                  {% if row.overdue %}
                     <span class="badge bg-red-lt"><i class="ti ti-alarm me-1"></i>{{ __('Due %1$s, %2$d day(s) late', 'grcmanager')|format(row.due_text, row.days_late) }}</span>
                  {% else %}
                     <span class="badge bg-secondary-lt"><i class="ti ti-calendar me-1"></i>{{ __('Due %s', 'grcmanager')|format(row.due_text) }}</span>
                  {% endif %}
               {% endif %}
            </div>
         </div>
         <div class="card-body">
            {% if row.control %}<p class="mb-2"><span class="badge bg-azure-lt"><i class="ti ti-shield-check me-1"></i>{{ row.control }}</span></p>{% endif %}
            {% if row.description %}<p>{{ row.description|nl2br }}</p>{% endif %}
            {% if row.status == 'to_complete' %}
               <div class="alert alert-danger"><i class="ti ti-arrow-back-up me-1"></i><strong>{{ __('The audit asks you to complete this evidence:', 'grcmanager') }}</strong> {{ row.review_comment }}</div>
            {% endif %}

            <h4 class="mt-3"><i class="ti ti-paperclip me-1"></i>{{ __('Documents of this request', 'grcmanager') }}</h4>
            {% if row.pieces is empty %}
               <p class="text-muted">{{ __('No document yet.', 'grcmanager') }}</p>
            {% else %}
               <ul class="list-group mb-3">
               {% for piece in row.pieces %}
                  <li class="list-group-item d-flex align-items-center gap-2">
                     <i class="ti {{ piece.origin == 'existing' ? 'ti-link' : 'ti-file' }}"></i>
                     <span class="flex-grow-1">{% if piece.url %}<a href="{{ piece.url }}">{{ piece.name }}</a>{% else %}{{ piece.name }}{% endif %}</span>
                     {% if piece.is_submitted %}
                        <span class="badge bg-blue-lt"><i class="ti ti-send me-1"></i>{{ __('Submitted on %s', 'grcmanager')|format(piece.submitted_text) }}</span>
                     {% else %}
                        <span class="badge bg-secondary-lt"><i class="ti ti-pencil me-1"></i>{{ __('Not submitted yet', 'grcmanager') }}</span>
                        <form method="post" action="{{ action }}" class="m-0">
                           <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                           <input type="hidden" name="requests_id" value="{{ row.id }}">
                           <input type="hidden" name="pieces_id" value="{{ piece.id }}">
                           <button type="submit" name="remove_piece" value="1" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
                        </form>
                     {% endif %}
                  </li>
               {% endfor %}
               </ul>
            {% endif %}

            <div class="row g-3">
               <div class="col-12 col-lg-6">
                  <form method="post" action="{{ action }}" enctype="multipart/form-data" class="grc-evreq-upload">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="requests_id" value="{{ row.id }}">
                     <label class="form-label" for="grc-evreq-file-{{ row.id }}"><i class="ti ti-upload me-1"></i>{{ __('Add a file', 'grcmanager') }}</label>
                     <div class="d-flex gap-2">
                        <input type="file" class="form-control" id="grc-evreq-file-{{ row.id }}" name="evidence_file" required>
                        <button type="submit" name="add_file" value="1" class="btn btn-outline-primary text-nowrap"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
                     </div>
                     <div class="form-hint">{{ __('PDF, image, office document... The file types allowed by GLPI are accepted.', 'grcmanager') }}</div>
                  </form>
               </div>
               {% if row.selectable is not empty %}
               <div class="col-12 col-lg-6">
                  <form method="post" action="{{ action }}" class="grc-evreq-existing">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="requests_id" value="{{ row.id }}">
                     <label class="form-label" for="grc-evreq-doc-{{ row.id }}"><i class="ti ti-link me-1"></i>{{ __('Or use an existing evidence of the control', 'grcmanager') }}</label>
                     <div class="d-flex gap-2">
                        <select class="form-select" id="grc-evreq-doc-{{ row.id }}" name="documents_id" required>
                           {% for doc in row.selectable %}
                              <option value="{{ doc.documents_id }}">{{ doc.name }}{% if validity[doc.validity] is defined %} ({{ validity[doc.validity][1] }}){% endif %}</option>
                           {% endfor %}
                        </select>
                        <button type="submit" name="add_existing" value="1" class="btn btn-outline-primary text-nowrap"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
                     </div>
                  </form>
               </div>
               {% endif %}
            </div>
         </div>
         <div class="card-footer">
            <form method="post" action="{{ action }}" class="d-flex flex-wrap align-items-center gap-2 grc-evreq-submit">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="requests_id" value="{{ row.id }}">
               <input type="text" class="form-control flex-grow-1" style="max-width: 32rem" name="submission_comment" maxlength="1000" placeholder="{{ __('Comment for the audit (optional)', 'grcmanager') }}" aria-label="{{ __('Comment', 'grcmanager') }}">
               <button type="submit" name="submit_request" value="1" class="btn btn-primary"{% if row.pieces is empty %} disabled title="{{ __('Add at least one document before submitting.', 'grcmanager') }}"{% endif %}><i class="ti ti-send me-1"></i>{{ __('Submit to the audit', 'grcmanager') }}</button>
            </form>
         </div>
      </div>
   {% endfor %}

   {% if done is not empty %}
      <div class="card">
         <div class="card-header"><h3 class="card-title"><i class="ti ti-history me-2"></i>{{ __('Evidence already submitted', 'grcmanager') }}</h3></div>
         <div class="table-responsive">
         <table class="table table-sm table-vcenter card-table" id="grc-evreq-mine-done">
            <thead>
               <tr>
                  <th>{{ __('Request', 'grcmanager') }}</th>
                  <th>{{ __('Audit', 'grcmanager') }}</th>
                  <th>{{ __('Status', 'grcmanager') }}</th>
                  <th>{{ __('Documents', 'grcmanager') }}</th>
               </tr>
            </thead>
            <tbody>
            {% for row in done %}
               <tr id="grc-evreq-{{ row.id }}">
                  <td>{{ row.label }}{% if row.control %}<div><span class="badge bg-azure-lt">{{ row.control }}</span></div>{% endif %}</td>
                  <td>{{ row.audit_title }}</td>
                  <td><span class="badge {{ row.status_class }} grc-evreq-badge"><i class="ti {{ row.status_icon }} me-1"></i>{{ row.status_label }}</span>{% if row.submitted_text %}<div class="text-muted small">{{ __('Submitted on %s', 'grcmanager')|format(row.submitted_text) }}</div>{% endif %}</td>
                  <td>
                     {% for piece in row.pieces %}
                        <div>{% if piece.url %}<a href="{{ piece.url }}">{{ piece.name }}</a>{% else %}{{ piece.name }}{% endif %}</div>
                     {% endfor %}
                  </td>
               </tr>
            {% endfor %}
            </tbody>
         </table>
         </div>
      </div>
   {% endif %}
</div>
