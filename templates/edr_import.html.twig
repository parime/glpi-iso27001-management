{# Issue #370 : import d'un export CSV d'EDR / XDR, en trois étapes (fichier, correspondance,
   résultat), voir front/securityincidentedrimport.php. #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# Issue #707 : alertes SentinelOne proposées par la tâche automatique, à vérifier avant de créer
   les incidents (aucune création automatique, rien n'est envoyé à SentinelOne). #}
{% if sentinelone %}
<div class="card mb-3" id="grc-sentinelone-review">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-shield-search me-2"></i>{{ __('SentinelOne alerts to review', 'grcmanager') }}</h3>
    <div class="card-actions d-flex align-items-center gap-2">
      <span class="badge bg-blue-subtle text-blue-emphasis">{{ __('%d pending', 'grcmanager')|format(sentinelone.total) }}</span>
      {% if sentinelone.last_run %}<span class="text-muted small">{{ __('Last read: %s', 'grcmanager')|format(sentinelone.last_run) }}</span>{% endif %}
      {% if sentinelone.config_url %}<a href="{{ sentinelone.config_url }}" class="small"><i class="ti ti-settings me-1"></i>{{ __('Settings', 'grcmanager') }}</a>{% endif %}
      {# Issue #1041 : lecture à la demande, auparavant dans la configuration. #}
      {% if sentinelone.can_fetch %}
        <form method="post" action="{{ action }}" class="d-inline">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
          <button type="submit" name="s1_fetch_now" class="btn btn-sm btn-outline-secondary"><i class="ti ti-refresh me-1"></i>{{ __('Fetch now', 'grcmanager') }}</button>
        </form>
      {% endif %}
    </div>
  </div>
  {% if sentinelone.rows is empty %}
    <div class="card-body text-muted">
      <i class="ti ti-circle-check me-1 text-green"></i>{{ __('No SentinelOne alert waiting for review.', 'grcmanager') }}
      {% if not sentinelone.enabled %}<div class="small mt-1">{{ __('The automatic reading is disabled: enable it in the Connectors tab of the plugin configuration, or use the button "Fetch now".', 'grcmanager') }}</div>{% endif %}
    </div>
  {% else %}
    <form method="post" action="{{ action }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <div class="card-body pb-0">
        <p class="text-muted small mb-2">{{ __('Tick the alerts that deserve a security incident: each one becomes an incident with its indicators, MITRE ATT&CK techniques and computer. The others can be set aside. Nothing is changed in SentinelOne.', 'grcmanager') }}</p>
        {% if sentinelone.total > sentinelone.rows|length %}<p class="small">{{ __('%1$d alerts: the %2$d most recent are shown.', 'grcmanager')|format(sentinelone.total, sentinelone.rows|length) }}</p>{% endif %}
      </div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead>
            <tr>
              <th class="w-1"><input type="checkbox" class="form-check-input" aria-label="{{ __('Select all', 'grcmanager') }}" onclick="this.closest('table').querySelectorAll('input[name=&quot;s1_ids[]&quot;]').forEach(function (box) { box.checked = this.checked; }, this);"></th>
              <th>{{ __('Detection date', 'grcmanager') }}</th>
              <th>{{ __('Alert name', 'grcmanager') }}</th>
              <th>{{ __('Severity', 'grcmanager') }}</th>
              <th>{{ __('Computer', 'grcmanager') }}</th>
              <th>{{ __('Account', 'grcmanager') }}</th>
              <th>{{ __('Entity') }}</th>
            </tr>
          </thead>
          <tbody>
          {% for row in sentinelone.rows %}
            {% set sev_class = row.severity == 'critical' ? 'bg-red-subtle text-red-emphasis' : (row.severity == 'major' ? 'bg-orange-subtle text-orange-emphasis' : 'bg-yellow-subtle text-yellow-emphasis') %}
            <tr>
              <td><input type="checkbox" class="form-check-input" name="s1_ids[]" value="{{ row.id }}" id="grc-s1-{{ row.id }}" aria-label="{{ row.name }}"></td>
              <td class="text-nowrap">{{ row.detected_at }}</td>
              <td>
                <label for="grc-s1-{{ row.id }}" class="mb-0">{{ row.name }}</label>
                <div>
                  <span class="badge {{ row.kind == 'alert' ? 'bg-purple-subtle text-purple-emphasis' : 'bg-azure-subtle text-azure-emphasis' }}">{{ sentinelone.kinds[row.kind] ?? row.kind }}</span>
                  {% if row.console_url %}<a href="{{ row.console_url }}" target="_blank" rel="noopener noreferrer" class="small ms-1"><i class="ti ti-external-link me-1"></i>{{ __('Console link', 'grcmanager') }}</a>{% endif %}
                </div>
              </td>
              <td><span class="badge {{ sev_class }}">{{ sentinelone.severities[row.severity] ?? row.severity }}</span></td>
              <td>
                {% if row.computer_url %}
                  <a href="{{ row.computer_url }}"><i class="ti ti-device-desktop me-1"></i>{{ row.computer }}</a>
                {% else %}
                  {{ row.hostname ?: '-' }}
                  <div><span class="badge bg-warning-subtle text-warning-emphasis">{{ __('Not found in GLPI', 'grcmanager') }}</span></div>
                {% endif %}
              </td>
              <td>{{ row.username ?: '-' }}</td>
              <td>{{ row.entity }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% if sentinelone.can_import %}
        <div class="card-footer d-flex flex-wrap gap-2">
          <button type="submit" name="s1_import" class="btn btn-primary"><i class="ti ti-shield-plus me-1"></i>{{ __('Create the incidents of the selected alerts', 'grcmanager') }}</button>
          <button type="submit" name="s1_ignore" class="btn btn-outline-secondary"><i class="ti ti-eye-off me-1"></i>{{ __('Set the selected alerts aside', 'grcmanager') }}</button>
        </div>
      {% endif %}
    </form>
  {% endif %}
  {# Issue #1041 : résultat de la dernière lecture et agents sans ordinateur GLPI (sortis de la configuration). #}
  {% if sentinelone.steps is not empty or sentinelone.agents.agents > 0 %}
    <div class="card-body border-top">
      {% if sentinelone.steps is not empty %}
        <h4 class="mb-2"><i class="ti ti-history me-1"></i>{{ __('Last read', 'grcmanager') }}</h4>
        <ul class="list-unstyled mb-2">
          {% for key, step in sentinelone.steps %}
            <li class="mb-1">
              <strong>{{ sentinelone.step_labels[key] ?? key }}</strong> :
              {% if step.error is empty %}
                <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-check me-1"></i>{{ __('%d read', 'grcmanager')|format(step.items) }}</span>
                {% if step.new is defined and step.new > 0 %}<span class="badge bg-blue-subtle text-blue-emphasis">{{ __('%d new', 'grcmanager')|format(step.new) }}</span>{% endif %}
                {% if not step.complete %}<span class="badge bg-warning-subtle text-warning-emphasis">{{ __('continued at the next run', 'grcmanager') }}</span>{% endif %}
              {% else %}
                <span class="badge bg-warning-subtle text-warning-emphasis"><i class="ti ti-alert-triangle me-1"></i>{{ sentinelone.error_labels[step.error] ?? step.error }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if sentinelone.agents.agents > 0 %}
        <h4 class="mt-3 mb-2"><i class="ti ti-device-desktop me-1"></i>{{ __('Agents', 'grcmanager') }}</h4>
        <p class="mb-1">
          <span class="badge bg-blue-subtle text-blue-emphasis">{{ __('%d agent(s) in the console', 'grcmanager')|format(sentinelone.agents.agents) }}</span>
          {% if sentinelone.agents.total > 0 %}
            <span class="badge bg-warning-subtle text-warning-emphasis">{{ __('%d without a matching GLPI computer', 'grcmanager')|format(sentinelone.agents.total) }}</span>
          {% else %}
            <span class="badge bg-success-subtle text-success-emphasis">{{ __('all matched with a GLPI computer', 'grcmanager') }}</span>
          {% endif %}
        </p>
        {% if sentinelone.agents.rows is not empty %}
          <p class="text-muted small mb-1">{{ __('These agents are never matched by a similar name: create or rename the computer in the inventory, or fill in its serial number.', 'grcmanager') }}</p>
          <div class="table-responsive">
            <table class="table table-sm table-vcenter small mb-0">
              <thead><tr><th>{{ __('Computer name in SentinelOne', 'grcmanager') }}</th><th>{{ __('Serial number') }}</th><th>{{ __('Operating system') }}</th></tr></thead>
              <tbody>
                {% for agent in sentinelone.agents.rows %}
                  <tr><td>{{ agent.computer_name }}</td><td>{{ agent.serial ?: '-' }}</td><td>{{ agent.os ?: '-' }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}
</div>
{% endif %}

<div class="card">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-file-import me-2"></i>{{ __('Import an EDR / XDR export', 'grcmanager') }}</h3>
    <ul class="steps steps-counter ms-auto mb-0" style="max-width: 28rem">
      <li class="step-item {{ step == 'upload' ? 'active' : '' }}">{{ __('File', 'grcmanager') }}</li>
      <li class="step-item {{ step == 'mapping' ? 'active' : '' }}">{{ __('Columns', 'grcmanager') }}</li>
      <li class="step-item {{ step == 'result' ? 'active' : '' }}">{{ __('Result', 'grcmanager') }}</li>
    </ul>
  </div>
  <div class="card-body">

  {% if step == 'upload' %}
    <form method="post" action="{{ action }}" enctype="multipart/form-data">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <p class="text-muted">{{ __('CSV export of the alerts from your EDR or XDR console (Microsoft Defender, CrowdStrike, SentinelOne, Sophos, Wazuh...). The separator and the encoding are detected, the usual columns are recognised automatically: you check them at the next step.', 'grcmanager') }}</p>
      <div class="mb-3">
        <label class="form-label" for="grc-edr-file">{{ __('CSV file', 'grcmanager') }}</label>
        <input type="file" id="grc-edr-file" name="edr_file" class="form-control" accept=".csv,.txt,text/csv" required>
        <div class="form-hint">{{ __('At most %1$d MB and %2$d lines.', 'grcmanager')|format(max_mb, max_rows) }}</div>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" name="upload" class="btn btn-primary"><i class="ti ti-arrow-right me-1"></i>{{ __('Next', 'grcmanager') }}</button>
        <a href="{{ action }}?example=1" class="btn btn-ghost-secondary"><i class="ti ti-download me-1"></i>{{ __('Example file', 'grcmanager') }}</a>
      </div>
    </form>

  {% elseif step == 'mapping' %}
    <form method="post" action="{{ action }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <p><i class="ti ti-file-text me-1"></i><strong>{{ file_name }}</strong> : {{ row_count }} {{ __('line(s)', 'grcmanager') }}{% if truncated %} <span class="badge bg-orange-lt">{{ __('truncated to the first %d lines', 'grcmanager')|format(max_rows) }}</span>{% endif %}</p>

      <h4>{{ __('Column of each field', 'grcmanager') }}</h4>
      <div class="row g-2 mb-3">
        {% for field, label in field_labels %}
          <div class="col-md-3">
            <label class="form-label small mb-1" for="grc-map-{{ field }}">{{ label }}</label>
            <select id="grc-map-{{ field }}" name="mapping[{{ field }}]" class="form-select form-select-sm {{ mapping[field] is defined ? 'border-green' : '' }}">
              <option value="">{{ __('(not imported)', 'grcmanager') }}</option>
              {% for index, header in headers %}
                <option value="{{ index }}" {{ mapping[field] is defined and mapping[field] == index ? 'selected' : '' }}>{{ header }}</option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}
      </div>

      <div class="row g-2 mb-3">
        <div class="col-md-4">
          <label class="form-label" for="grc-edr-grouping">{{ __('Create', 'grcmanager') }}</label>
          <select id="grc-edr-grouping" name="grouping" class="form-select">
            {% for key, label in groupings %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="grc-edr-timezone">{{ __('Time zone of dates without one', 'grcmanager') }}</label>
          <select id="grc-edr-timezone" name="timezone" class="form-select">
            {% for zone in timezones %}<option value="{{ zone }}" {{ zone == default_timezone ? 'selected' : '' }}>{{ zone }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label" for="grc-edr-target">{{ __('Or add everything to an existing incident', 'grcmanager') }}</label>
          <select id="grc-edr-target" name="target" class="form-select">
            <option value="0">{{ __('No: create new incidents', 'grcmanager') }}</option>
            {% for id, name in incidents %}<option value="{{ id }}">{{ name }}</option>{% endfor %}
          </select>
        </div>
      </div>

      <h4>{{ __('Preview', 'grcmanager') }}</h4>
      <div class="table-responsive mb-3">
        <table class="table table-sm table-vcenter small">
          <thead><tr>{% for header in headers %}<th>{{ header }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for row in preview %}<tr>{% for value in row %}<td class="text-truncate" style="max-width: 14rem" title="{{ value }}">{{ value }}</td>{% endfor %}</tr>{% endfor %}
          </tbody>
        </table>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" name="import" class="btn btn-primary"><i class="ti ti-file-import me-1"></i>{{ __('Import', 'grcmanager') }}</button>
        <a href="{{ action }}" class="btn btn-ghost-secondary">{{ __('Start again', 'grcmanager') }}</a>
      </div>
    </form>

  {% else %}
    <div class="d-flex flex-wrap gap-2 mb-3">
      <span class="badge bg-green-lt fs-5"><i class="ti ti-plus me-1"></i>{{ created|length }} {{ __('incident(s) created', 'grcmanager') }}</span>
      <span class="badge bg-blue-lt fs-5"><i class="ti ti-pencil me-1"></i>{{ updated|length }} {{ __('incident(s) completed', 'grcmanager') }}</span>
      <span class="badge bg-secondary-lt fs-5"><i class="ti ti-copy-off me-1"></i>{{ skipped }} {{ __('already imported, ignored', 'grcmanager') }}</span>
    </div>
    {% if links is not empty %}
      <div class="list-group mb-3">
        {% for link in links %}<a href="{{ link.url }}" class="list-group-item list-group-item-action"><i class="ti ti-shield-exclamation me-1"></i>{{ link.label }}</a>{% endfor %}
      </div>
    {% endif %}
    <a href="{{ action }}" class="btn btn-outline-primary"><i class="ti ti-file-import me-1"></i>{{ __('Import another file', 'grcmanager') }}</a>
  {% endif %}
  </div>
</div>
