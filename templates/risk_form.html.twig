{# Registre des risques, 6.1.2 / 8.2 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.textField('external_ref', item.fields['external_ref']|default(''), __('External reference', 'grcmanager'), {
      'maxlength': 100,
      'helper': __('Reference of the risk in your spreadsheet register: a CSV import updates the risk that carries it.', 'grcmanager')
   }) }}
   {{ fields.dropdownArrayField('category', item.fields['category'] ?: 'process', categories, __('Category', 'grcmanager')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], _x('owner', 'Owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dropdownArrayField('probability', item.fields['probability'] ?: 'possible', probabilities, __('Probability', 'grcmanager')) }}
   {# Issue #26 : simple signal quand un actif lié porte une classification C/I/D élevée ; ne change jamais la valeur. #}
   {{ fields.dropdownArrayField('impact', item.fields['impact'] ?: 'medium', impacts, __('Impact', 'grcmanager'), high_classification ? {
      'add_field_html': hints.hint(__('A linked asset carries a high C/I/A classification: check this risk\'s impact.', 'grcmanager')),
   } : {}) }}
   {% if not is_new %}
      {{ fields.htmlField('', risk_level_badge, __('Risk level', 'grcmanager')) }}
      {{ fields.htmlField('', item.fields['computed_score']|default('0')|e, _x('score', 'Score', 'grcmanager')) }}
   {% endif %}
   {# Issue #378 : risque résiduel, une fois le traitement appliqué. #}
   {{ fields.dropdownArrayField('residual_probability', item.fields['residual_probability']|default(''), residual_probabilities, __('Residual probability', 'grcmanager'), {
      'add_field_html': hints.hint(__('After the treatment. Leave "To be assessed" until the treatment is defined: the initial risk is then compared to the appetite.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('residual_impact', item.fields['residual_impact']|default(''), residual_impacts, __('Residual impact', 'grcmanager')) }}
   {% if not is_new %}
      {% if residual_badge %}
         {{ fields.htmlField('', residual_badge, __('Residual risk level', 'grcmanager')) }}
      {% endif %}
      {# Issue #378 : position par rapport à l'appétence de la catégorie. #}
      {% if appetite_position == 'above_tolerance' or appetite_position == 'above_appetite' %}
         {% set appetite_html %}
            <a href="{{ appetite_url }}" class="badge {{ appetite_position == 'above_tolerance' ? 'bg-red-lt' : 'bg-orange-lt' }}">
               <i class="ti {{ appetite_position == 'above_tolerance' ? 'ti-alert-octagon' : 'ti-alert-triangle' }} me-1"></i>
               {{ appetite_position == 'above_tolerance' ? __('Above tolerance', 'grcmanager') : __('Above appetite', 'grcmanager') }}
            </a>
            <div class="form-hint">
               {% if appetite_position == 'above_tolerance' and direction_group %}
                  {{ __('A treatment is required. Only management (group %s) can accept this risk.', 'grcmanager')|format(direction_group) }}
               {% else %}
                  {{ __('A treatment, or a formal acceptance with a justification, is required.', 'grcmanager') }}
               {% endif %}
            </div>
            <div class="form-hint">{{ appetite_on_residual ? __('Compared on the residual risk level.', 'grcmanager') : __('Compared on the initial risk level: assess the residual risk once the treatment is defined.', 'grcmanager') }}</div>
            {% if accepted_by %}
               <div class="form-hint">
                  {{ __('Formally accepted by %1$s on %2$s', 'grcmanager')|format(accepted_by, accepted_on|formatted_datetime) }}
                  {% if accepted_direction %}<span class="badge bg-blue-lt ms-1"><i class="ti ti-building me-1"></i>{{ __('Management', 'grcmanager') }}</span>{% endif %}
               </div>
            {% endif %}
            {% if needs_direction %}
               <div class="text-warning small mt-1"><i class="ti ti-alert-triangle me-1"></i>{{ __('Now above tolerance: management (group %s) must sign this acceptance again, by saving the risk.', 'grcmanager')|format(direction_group) }}</div>
            {% endif %}
         {% endset %}
         {{ fields.htmlField('', appetite_html, __('Risk appetite', 'grcmanager')) }}
      {% elseif appetite_position == 'within' %}
         {% set appetite_html %}<span class="badge bg-green-lt"><i class="ti ti-circle-check me-1"></i>{{ __('Within appetite', 'grcmanager') }}</span>{% if appetite_on_residual %}<div class="form-hint">{{ __('Compared on the residual risk level.', 'grcmanager') }}</div>{% endif %}{% endset %}
         {{ fields.htmlField('', appetite_html, __('Risk appetite', 'grcmanager')) }}
      {% endif %}
      {% if indicators is not empty %}
         {% set kri_html %}
            {% for kri in indicators %}
               <div><a href="{{ kri.url }}">{{ kri.name }}</a> {% include '@grcmanager/_badge.html.twig' with kri.status_badge only %}{% if kri.value is not null %} <span class="text-muted">{{ kri.value }}{% if kri.unit %} {{ kri.unit }}{% endif %}</span>{% endif %}</div>
            {% endfor %}
         {% endset %}
         {{ fields.htmlField('', kri_html, __('Risk indicators (KRI)', 'grcmanager')) }}
      {% endif %}
   {% endif %}
   {# Issue #31 : le choix implique un plan de traitement, plus bas sur la fiche. #}
   {{ fields.dropdownArrayField('treatment', item.fields['treatment'], treatments, __('Treatment', 'grcmanager'), plan_relevant ? {
      'add_field_html': hints.hint(__('A treatment plan (one or more concrete actions) is expected for this choice, see further down this record.', 'grcmanager')),
   } : {}) }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: 'identified', statuses, __('Status', 'grcmanager')) }}
   {{ fields.dateField('review_date', item.fields['review_date'], __('Review date', 'grcmanager')) }}
   {{ fields.textareaField('description', item.fields['description'], __('Description', 'grcmanager'), {'full_width': true}) }}
   {{ fields.textareaField('justification', item.fields['justification'], __('Justification', 'grcmanager'), {'full_width': true}) }}

   {# Issue #25 : une sélection multiple par type d'actif liable (seulement les types qui ont des actifs visibles). #}
   {{ fields.smallTitle(__('Linked assets (CMDB)', 'grcmanager'), 'ti ti-device-desktop') }}
   {% for group in asset_groups %}
      {{ fields.dropdownArrayField(group.field, null, group.options, group.label, {
         'multiple': true,
         'values': group.values,
         'full_width': true,
      }) }}
   {% endfor %}

   {# Issue #368 : alertes Wazuh récentes des ordinateurs liés, lues dans le plugin Wazuh (lecture seule). #}
   {% if wazuh_alerts is not null %}
      {% set alert_badges = {'high': 'bg-red text-white', 'medium': 'bg-orange-lt', 'low': 'bg-secondary-lt', 'unknown': 'bg-secondary-lt'} %}
      {% set wazuh_html %}
         {% if wazuh_alerts is empty %}
            <span class="text-muted">{{ __('No Wazuh alert on the linked computers in the last %d days.', 'grcmanager')|format(wazuh_alert_days) }}</span>
         {% else %}
            <table class="table table-sm table-vcenter mb-1">
               <thead><tr><th>{{ __('Date') }}</th><th>{{ __('Computer') }}</th><th>{{ __('Level', 'grcmanager') }}</th><th>{{ __('Rule', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for alert in wazuh_alerts %}
                  <tr>
                     <td class="text-nowrap">{{ alert.date|formatted_datetime }}</td>
                     <td><a href="{{ alert.computer_url }}">{{ alert.computer }}</a></td>
                     <td><span class="badge {{ alert_badges[alert.severity] }}">{{ alert.level ?? '?' }}</span></td>
                     <td>{{ alert.description }}{% if alert.rule_id %} <span class="text-muted small">({{ alert.rule_id }})</span>{% endif %}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         {% endif %}
         <small class="form-hint d-block">{{ __('The %1$d most recent alerts of the last %2$d days, read from the Wazuh plugin. Only computers you can see are included.', 'grcmanager')|format(wazuh_alert_max, wazuh_alert_days) }}</small>
      {% endset %}
      {{ fields.htmlField('', wazuh_html, __('Recent Wazuh alerts', 'grcmanager'), {'full_width': true}) }}
   {% endif %}
{% endblock %}
