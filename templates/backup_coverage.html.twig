{# Issue #838 : couverture des sauvegardes (A.8.13, A.5.30), dans les entités de la personne. Le
   plugin lit seulement : aucune sauvegarde n'est lancée, rien n'est modifié dans l'outil. #}
{% macro rate_color(rate) %}{{ rate is null ? 'secondary' : (rate >= 95 ? 'success' : (rate >= 80 ? 'warning' : 'danger')) }}{% endmacro %}

<div id="grc-backup-coverage">
   {# Synthèse. #}
   <div class="row row-cards mb-3">
      {% set cov_color = _self.rate_color(summary.concerned.rate) %}
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ cov_color }}-subtle text-{{ cov_color }}-emphasis me-2 fs-3"><i class="ti ti-database-export"></i></span>
            <div>
               <div class="fw-bold fs-3" id="grc-backup-rate">{{ summary.concerned.rate is null ? '-' : summary.concerned.rate ~ ' %' }}</div>
               <div class="small">{{ __('Assets concerned with a recent backup', 'grcmanager') }}</div>
            </div>
         </div>
         <div class="small text-muted mt-1">{{ _n('%d asset concerned', '%d assets concerned', summary.concerned.total, 'grcmanager')|format(summary.concerned.total) }}</div>
      </div></div></div>
      {% set crit_color = summary.critical.total == 0 ? 'secondary' : (summary.critical.uncovered > 0 ? 'danger' : 'success') %}
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ crit_color }}-subtle text-{{ crit_color }}-emphasis me-2 fs-3"><i class="ti ti-alert-octagon"></i></span>
            <div>
               <div class="fw-bold fs-3" id="grc-backup-critical">{{ summary.critical.uncovered }}</div>
               <div class="small">{{ __('Critical assets without a recent backup', 'grcmanager') }}</div>
            </div>
         </div>
         <div class="small text-muted mt-1">{{ _n('%d critical asset', '%d critical assets', summary.critical.total, 'grcmanager')|format(summary.critical.total) }}</div>
      </div></div></div>
      {% set fail_count = summary.concerned.failed + summary.failed_jobs %}
      {% set fail_color = fail_count > 0 ? 'warning' : (summary.sources == 0 ? 'secondary' : 'success') %}
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ fail_color }}-subtle text-{{ fail_color }}-emphasis me-2 fs-3"><i class="ti ti-alert-triangle"></i></span>
            <div>
               <div class="fw-bold fs-3">{{ summary.concerned.failed }}</div>
               <div class="small">{{ __('Assets whose last backup failed', 'grcmanager') }}</div>
            </div>
         </div>
         <div class="small text-muted mt-1">{{ _n('%d job failed', '%d jobs failed', summary.failed_jobs, 'grcmanager')|format(summary.failed_jobs) }}</div>
      </div></div></div>
      {% set rest_color = summary.critical.total == 0 ? 'secondary' : (summary.critical_untested > 0 ? 'warning' : 'success') %}
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ rest_color }}-subtle text-{{ rest_color }}-emphasis me-2 fs-3"><i class="ti ti-rotate-clockwise-2"></i></span>
            <div>
               <div class="fw-bold fs-3">{{ summary.critical_untested }}</div>
               <div class="small">{{ __('Critical assets without a recent restore test', 'grcmanager') }}</div>
            </div>
         </div>
         <div class="small text-muted mt-1">{{ _n('Expected every %d month', 'Expected every %d months', settings.restore_months, 'grcmanager')|format(settings.restore_months) }}</div>
      </div></div></div>
   </div>
   <div class="row row-cards mb-3">
      {% for code, info in infos %}
         <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body" title="{{ info.help }}">
            <div class="d-flex align-items-center">
               <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-2 fs-3"><i class="{{ info.icon }}"></i></span>
               <div>
                  <div class="fw-bold fs-3">{{ summary.concerned[code] }}</div>
                  <div class="small">{{ info.label }}</div>
               </div>
            </div>
            <div class="small text-muted mt-1">{{ info.help }}</div>
         </div></div></div>
      {% endfor %}
   </div>

   {# Réglages : ils se règlent dans la configuration (issue #1042) ; ici, leur rappel. #}
   <div class="card mb-3" id="grc-backup-settings">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-adjustments me-2"></i>{{ __('Which assets must be backed up, and how often?', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="mb-2"><i class="ti ti-info-circle me-1"></i>{{ scopes[settings.scope] }} · {{ __('Maximum age without RPO: %s', 'grcmanager')|format(max_age_label) }} · {{ _n('Restore test expected every %d month', 'Restore test expected every %d months', settings.restore_months, 'grcmanager')|format(settings.restore_months) }}</p>
         <p class="text-muted small">{{ __('The maximum age of the last successful backup is the smallest RPO among the asset (C/I/A classification tab) and the business processes that use it. Without any RPO, the default maximum age applies. An asset is critical when one axis of its classification is high, or when a network flow publishes it on the Internet.', 'grcmanager') }}</p>
         <a class="btn btn-outline-secondary" href="{{ settings_url }}"><i class="ti ti-settings me-1"></i>{{ __('Change the settings', 'grcmanager') }}</a>
      </div>
   </div>

   {# Connecteur Veeam : lecture sur clic ; la connexion se règle dans la configuration (issue #1042). #}
   <div class="card mb-3" id="grc-backup-veeam">
      <div class="card-header">
         <h3 class="card-title d-flex align-items-center flex-wrap gap-2">
            <i class="ti ti-plug"></i>{{ __('Read Veeam Backup & Replication directly', 'grcmanager') }}
            <span class="badge bg-azure-subtle text-azure-emphasis"><i class="ti ti-eye me-1"></i>{{ __('Read only', 'grcmanager') }}</span>
            {% if veeam.configured %}
               <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
            {% else %}
               <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-off me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
            {% endif %}
         </h3>
      </div>
      <div class="card-body">
         <p class="small">{{ __('When you click the button, GLPI reads from the REST API of Veeam the restore points of the last %d days (so the last successful backup of each machine) and the last result of each job. The result replaces the Veeam import of the current entity. No backup is ever started, nothing is changed in Veeam and nothing runs automatically.', 'grcmanager')|format(veeam.lookback) }}</p>
         <div class="d-flex flex-wrap gap-2">
            {% if can_manage and veeam.configured %}
               <form method="post" action="{{ action }}">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <button type="submit" class="btn btn-primary" name="fetch_veeam" value="1"><i class="ti ti-refresh me-1"></i>{{ __('Read now from Veeam', 'grcmanager') }}</button>
               </form>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ connector_url }}"><i class="ti ti-settings me-1"></i>{{ __('Set up the connection', 'grcmanager') }}</a>
         </div>
      </div>
   </div>

   {# Outils de sauvegarde : imports CSV et lecture de Veeam. #}
   <div class="card mb-3" id="grc-backup-import">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-database-import me-2"></i>{{ __('Backup tools', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="small">{{ __('For the other tools, export the list of protected machines with the date of their last backup, then import the CSV file here. A new import of the same tool replaces the previous one in the current entity. Only machine names, addresses, jobs, dates and results are kept, never the content of a backup.', 'grcmanager') }}</p>
         <ul class="small text-muted">
            <li>{{ __('Acronis Cyber Protect: Devices, export the list (columns Name, Last backup, Status).', 'grcmanager') }}</li>
            <li>{{ __('Synology Active Backup for Business: export of the devices or of the task log (Device, Last backup time, Status).', 'grcmanager') }}</li>
            <li>{{ __('Commvault: report of the clients with their last successful backup (Client, Last successful backup).', 'grcmanager') }}</li>
            <li>{{ __('Proxmox Backup Server: list of the snapshots of a datastore (backup-id, backup-time), for example "proxmox-backup-client snapshot list --output-format json" converted to CSV.', 'grcmanager') }}</li>
            <li>{{ __('Recognized columns: host (or hostname, vm, device, client, backup-id), ip, job, last success (or last backup, backup-time), date of the run (or end time) and result (or status). A file with one line per run is accepted: the most recent run of each machine counts.', 'grcmanager') }}</li>
         </ul>
         {% if sources is not empty %}
            <div class="table-responsive">
               <table class="table table-sm mb-3">
                  <thead><tr>
                     <th>{{ __('Backup tool', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Machines', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Matched', 'grcmanager') }}</th>
                     <th>{{ __('Most recent backup', 'grcmanager') }}</th>
                     <th>{{ __('Last import', 'grcmanager') }}</th>
                     {% if can_manage %}<th><span class="visually-hidden">{{ __('Actions') }}</span></th>{% endif %}
                  </tr></thead>
                  <tbody>
                  {% for s in sources %}
                     <tr>
                        <td>{{ s.label }}{% if s.origin == 'api' %} <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Read directly', 'grcmanager') }}</span>{% endif %}</td>
                        <td class="text-end">{{ s.hosts }}</td>
                        <td class="text-end">{{ s.matched }}</td>
                        <td>{{ s.last_success_label is empty ? '-' : s.last_success_label }}</td>
                        <td>{{ s.date_import_label is empty ? '-' : s.date_import_label }}</td>
                        {% if can_manage %}
                           <td class="text-end">
                              <form method="post" action="{{ action }}" class="d-inline">
                                 <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                 <input type="hidden" name="source" value="{{ s.source }}">
                                 <button type="submit" class="btn btn-sm btn-outline-danger" name="clear_backup_hosts" value="1"><i class="ti ti-trash me-1"></i>{{ __('Delete the import', 'grcmanager') }}</button>
                              </form>
                           </td>
                        {% endif %}
                     </tr>
                  {% endfor %}
                  </tbody>
               </table>
            </div>
         {% else %}
            <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>{{ __('No backup tool yet: read Veeam or import the list of machines of your backup tool to measure the coverage.', 'grcmanager') }}</div>
         {% endif %}
         {% if can_manage %}
            <form method="post" action="{{ action }}" enctype="multipart/form-data" class="row g-2 align-items-end">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="col-md-4">
                  <label class="form-label" for="grc-backup-source">{{ __('Backup tool', 'grcmanager') }}</label>
                  <select class="form-select" id="grc-backup-source" name="source">
                     {% for value, label in source_labels %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                  </select>
               </div>
               <div class="col-md-5">
                  <label class="form-label" for="grc-backup-file">{{ __('CSV file', 'grcmanager') }}</label>
                  <input type="file" class="form-control" id="grc-backup-file" name="backup_file" accept=".csv,.txt,text/csv" required>
               </div>
               <div class="col-md-3">
                  <button type="submit" class="btn btn-primary" name="import_backup_hosts" value="1"><i class="ti ti-upload me-1"></i>{{ __('Import', 'grcmanager') }}</button>
               </div>
            </form>
         {% endif %}
      </div>
   </div>

   {# Travaux lus dans Veeam, en échec d'abord. #}
   {% if jobs is not empty %}
      <div class="card mb-3" id="grc-backup-jobs">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-list-check me-2"></i>{{ __('Backup jobs', 'grcmanager') }}</h3>
            <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ jobs|length }}</span></div>
         </div>
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
               <thead><tr><th>{{ __('Job', 'grcmanager') }}</th><th>{{ __('Type') }}</th><th>{{ __('Last run', 'grcmanager') }}</th><th>{{ __('Result', 'grcmanager') }}</th><th class="text-end">{{ __('Objects', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for job in jobs %}
                  {% set res = result_infos[job.last_result] %}
                  <tr>
                     <td>{{ job.name }}</td>
                     <td class="small">{{ job.type }}</td>
                     <td class="small">{{ job.last_run_label is empty ? '-' : job.last_run_label }}</td>
                     <td><span class="badge bg-{{ res.color }}-subtle text-{{ res.color }}-emphasis"><i class="{{ res.icon }} me-1"></i>{{ res.label }}</span></td>
                     <td class="text-end">{{ job.objects }}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      </div>
   {% endif %}

   {# Actifs concernés : aucune sauvegarde d'abord, puis trop ancienne, puis échec. #}
   <div class="card mb-3" id="grc-backup-list">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-list-details me-2"></i>{{ __('Assets that must be backed up', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_rows }}</span></div>
      </div>
      {% if rows is empty %}
         <div class="card-body text-muted">{{ __('No asset concerned in your entities.', 'grcmanager') }}</div>
      {% else %}
         {% if total_rows > rows|length %}
            <div class="card-body small pb-0">{{ __('%1$d assets: the first %2$d are shown, gaps first.', 'grcmanager')|format(total_rows, rows|length) }}</div>
         {% endif %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Asset', 'grcmanager') }}</th>
                  <th>{{ __('State', 'grcmanager') }}</th>
                  <th>{{ __('Last successful backup', 'grcmanager') }}</th>
                  <th>{{ __('Maximum age', 'grcmanager') }}</th>
                  <th>{{ __('Backup tool', 'grcmanager') }}</th>
                  <th>{{ __('Last restore test', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for row in rows %}
                  {% set info = infos[row.status] %}
                  {% set rest = restore_infos[row.restore] %}
                  <tr>
                     <td>
                        <a href="{{ row.url }}"><i class="ti {{ row.kind == 'network' ? 'ti-router' : (row.is_server ? 'ti-server' : 'ti-device-desktop') }} me-1"></i>{{ row.name }}</a>
                        {% if row.critical %}<span class="badge bg-danger-subtle text-danger-emphasis ms-1"><i class="ti ti-alert-octagon me-1"></i>{{ __('Critical', 'grcmanager') }}</span>{% endif %}
                        {% if row.exposed %}<span class="badge bg-warning-subtle text-warning-emphasis ms-1"><i class="ti ti-world me-1"></i>{{ __('Published on the Internet', 'grcmanager') }}</span>{% endif %}
                        <div class="small text-muted">{{ row.entity }}{% if row.type %} · {{ row.type }}{% endif %}</div>
                     </td>
                     <td>
                        <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis" title="{{ info.help }}"><i class="{{ info.icon }} me-1"></i>{{ info.label }}</span>
                        {% if row.last_result == 'failed' and row.status != 'failed' %}<div class="small text-danger mt-1"><i class="ti ti-x me-1"></i>{{ __('Last attempt failed', 'grcmanager') }}</div>{% endif %}
                     </td>
                     <td class="small">
                        {{ row.last_success_label is empty ? '-' : row.last_success_label }}
                        {% if row.age_label is not empty %}<div class="text-muted">{{ __('%s ago', 'grcmanager')|format(row.age_label) }}</div>{% endif %}
                     </td>
                     <td class="small">{{ row.allowed_label }}<div class="text-muted">{{ limit_labels[row.limit_origin] }}</div></td>
                     <td class="small">{{ row.sources|join(', ') }}{% if row.job is not empty %}<div class="text-muted">{{ row.job }}</div>{% endif %}</td>
                     <td class="small">
                        <span class="badge bg-{{ rest.color }}-subtle text-{{ rest.color }}-emphasis"><i class="{{ rest.icon }} me-1"></i>{{ rest.label }}</span>
                        {% if row.restore_label is not empty %}
                           <div class="text-muted">{{ row.restore_label }}{% if row.restore_url is not empty %} · <a href="{{ row.restore_url }}">{{ row.restore_process }}</a>{% endif %}</div>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
         <div class="card-body small text-muted pt-2">
            <i class="ti ti-info-circle me-1"></i>{{ __('Restore tests come from the recovery exercises of the business processes: record a test on the process (Recovery strategy tab), naming the asset tested, to prove that its backup can be restored.', 'grcmanager') }}
            {% if processes_url is not empty %}<a href="{{ processes_url }}" class="ms-1"><i class="ti ti-sitemap me-1"></i>{{ __('Business processes', 'grcmanager') }}</a>{% endif %}
         </div>
      {% endif %}
   </div>

   {# Machines sauvegardées qu'aucun actif ne reconnaît. #}
   {% if unmatched is not empty %}
      <div class="card mb-3" id="grc-backup-unmatched">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-question-mark me-2"></i>{{ __('Backed up machines not found in GLPI', 'grcmanager') }}</h3>
            <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_unmatched }}</span></div>
         </div>
         <div class="card-body small pb-0">{{ __('Check the name of the asset in GLPI, or add the asset to the inventory: an unknown machine may be an asset missing from the inventory.', 'grcmanager') }}</div>
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
               <thead><tr><th>{{ __('Machine', 'grcmanager') }}</th><th>{{ __('IP address', 'grcmanager') }}</th><th>{{ __('Backup tool', 'grcmanager') }}</th><th>{{ __('Last successful backup', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for host in unmatched %}
                  <tr>
                     <td>{{ host.host }}{% if host.job is not empty %}<div class="small text-muted">{{ host.job }}</div>{% endif %}</td>
                     <td>{{ host.ip }}</td>
                     <td>{{ host.source_label }}</td>
                     <td>{{ host.last_success_label is empty ? '-' : host.last_success_label }}</td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      </div>
   {% endif %}

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted small me-auto">
         <i class="ti ti-eye me-1"></i>{{ __('Read-only: the plugin reads the lists of backups, it never starts a backup or a restore and changes nothing in the backup tools nor in GLPI.', 'grcmanager') }}
      </span>
      <a class="btn btn-sm btn-outline-primary" href="{{ log_url }}"><i class="ti ti-file-search me-1"></i>{{ __('Logging coverage', 'grcmanager') }}</a>
   </div>
</div>
