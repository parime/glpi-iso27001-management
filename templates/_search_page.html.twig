{# Issue #1093 : même enveloppe que SearchEngine::show() autour de Search::showList(), voir Services/Ui/SearchPage.php #}
<div class="search_page row" data-testid="search-page">
  {{ include('layout/parts/saved_searches.html.twig', {itemtype: itemtype}) }}
  <div class="col search-container" data-glpi-search-container data-testid="search-container" tabindex="-1">
    {% do call('Glpi\\Search\\Output\\HTMLSearchOutput::showPreSearchDisplay', [itemtype]) %}
    {% if user_pref('show_search_form') %}
      {% do call('Glpi\\Search\\Input\\QueryBuilder::showGenericSearch', [itemtype, params]) %}
    {% endif %}
    {% do call('Search::showList', [itemtype, params, forcedisplay]) %}
  </div>
</div>
