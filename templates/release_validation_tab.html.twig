{# Issue #777 : liste de contrôle sécurité avant mise en production et décision (onglet du changement). #}
<div class="container-fluid" id="grc-release-validation">
   <p class="text-muted">
      <i class="ti ti-info-circle me-1"></i>{{ __('Before this change goes into production, check the security points below, then the CIO or the CISO approves or rejects the release. The decision is recorded with its author and date, and in the history of the change.', 'grcmanager') }}
      <a href="{{ register_url }}">{{ __('Secure development', 'grcmanager') }}</a>
   </p>

   <p>
      <strong>{{ __('Applications concerned', 'grcmanager') }} :</strong>
      {% for app in applications %}
         {% if app.url %}<a href="{{ app.url }}">{{ app.name }}</a>{% else %}<span class="text-muted">{{ app.name }}</span>{% endif %}
         {% if not app.has_profile %}<span class="badge bg-warning-subtle text-warning-emphasis ms-1" title="{{ __('Fill in the secure development tab of the application.', 'grcmanager') }}">{{ __('No secure development sheet', 'grcmanager') }}</span>{% endif %}{% if not loop.last %}, {% endif %}
      {% endfor %}
      <span class="ms-3 text-muted small">{{ __('GLPI approval of the change: %s', 'grcmanager')|format(glpi_approval) }}</span>
   </p>

   {% if release_state is not null %}
      <div class="alert alert-{{ release_state.color }} py-2" id="grc-release-state">
         <i class="{{ release_state.icon }} me-1"></i>{{ __('This change is in production.', 'grcmanager') }} <strong>{{ release_state.label }}</strong>
      </div>
   {% endif %}

   <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-checklist me-1"></i>{{ __('Security checklist before release', 'grcmanager') }}</h3></div>
      <div class="card-body">
         {% if can_edit %}
            <form method="post" action="{{ action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="changes_id" value="{{ changes_id }}">
               {% for key, label in checklist %}
                  <label class="form-check">
                     <input type="checkbox" class="form-check-input" name="{{ key }}" value="1" {{ validation[key]|default(0) ? 'checked' : '' }}>
                     <span class="form-check-label">{{ label }}</span>
                  </label>
               {% endfor %}
               <label class="form-label mt-2" for="grc-release-checklist-comment">{{ __('Evidence (reports, links, ticket numbers)', 'grcmanager') }}</label>
               <textarea class="form-control" id="grc-release-checklist-comment" name="checklist_comment" rows="2">{{ validation.checklist_comment|default('') }}</textarea>
               <button type="submit" name="save_checklist" value="1" class="btn btn-primary mt-2"><i class="ti ti-device-floppy me-1"></i>{{ __('Save the checklist', 'grcmanager') }}</button>
            </form>
         {% else %}
            <ul class="list-unstyled mb-2">
               {% for key, label in checklist %}
                  <li>
                     {% if validation[key]|default(0) %}<i class="ti ti-square-check text-success me-1"></i>{% else %}<i class="ti ti-square text-muted me-1"></i>{% endif %}{{ label }}
                  </li>
               {% endfor %}
            </ul>
            {% if validation.checklist_comment|default('') %}<p class="mb-0"><strong>{{ __('Evidence (reports, links, ticket numbers)', 'grcmanager') }} :</strong> {{ validation.checklist_comment|nl2br }}</p>{% endif %}
         {% endif %}
      </div>
   </div>

   <div class="card">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-gavel me-1"></i>{{ __('Decision of the CIO or the CISO', 'grcmanager') }}</h3></div>
      <div class="card-body">
         {% if decided %}
            <p id="grc-release-decision">
               {% if validation.decision == 'approved' %}
                  <span class="badge bg-success-subtle text-success-emphasis fs-5"><i class="ti ti-circle-check me-1"></i>{{ __('Release approved', 'grcmanager') }}</span>
               {% else %}
                  <span class="badge bg-danger-subtle text-danger-emphasis fs-5"><i class="ti ti-circle-x me-1"></i>{{ __('Release rejected', 'grcmanager') }}</span>
               {% endif %}
               <span class="ms-2">{{ __('By %1$s (%2$s) on %3$s', 'grcmanager')|format(decider_name, roles[validation.validator_role]|default('-'), validation.date_decision|formatted_datetime) }}</span>
            </p>
            {% if validation.decision_comment %}<p><strong>{{ __('Reason or comment', 'grcmanager') }} :</strong> {{ validation.decision_comment|nl2br }}</p>{% endif %}
            {% if can_decide %}
               <form method="post" action="{{ action }}">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <input type="hidden" name="changes_id" value="{{ changes_id }}">
                  <button type="submit" name="reopen" value="1" class="btn btn-outline-secondary"><i class="ti ti-arrow-back-up me-1"></i>{{ __('Reopen the decision', 'grcmanager') }}</button>
               </form>
            {% endif %}
         {% elseif can_decide %}
            {% if unchecked is not empty %}
               <p class="text-warning"><i class="ti ti-alert-triangle me-1"></i>{{ __('The checklist is not complete: the release can only be rejected.', 'grcmanager') }}</p>
            {% endif %}
            <form method="post" action="{{ action }}" class="row g-2">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="changes_id" value="{{ changes_id }}">
               <div class="col-md-4">
                  <label class="form-label" for="grc-release-role">{{ __('I decide as', 'grcmanager') }}</label>
                  <select class="form-select" id="grc-release-role" name="validator_role">
                     <option value="">-----</option>
                     {% for key, label in roles %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
                  </select>
               </div>
               <div class="col-md-8">
                  <label class="form-label" for="grc-release-reason">{{ __('Reason or comment (mandatory for a rejection)', 'grcmanager') }}</label>
                  <textarea class="form-control" id="grc-release-reason" name="decision_comment" rows="2"></textarea>
               </div>
               <div class="col-12">
                  <button type="submit" name="decision" value="approved" class="btn btn-success" {{ unchecked is not empty ? 'disabled' : '' }}><i class="ti ti-circle-check me-1"></i>{{ __('Approve the release', 'grcmanager') }}</button>
                  <button type="submit" name="decision" value="rejected" class="btn btn-outline-danger ms-1"><i class="ti ti-circle-x me-1"></i>{{ __('Reject the release', 'grcmanager') }}</button>
               </div>
            </form>
         {% else %}
            <p class="text-muted mb-0"><i class="ti ti-hourglass me-1"></i>{{ __('Awaiting the decision of the CIO or the CISO.', 'grcmanager') }}</p>
         {% endif %}
      </div>
   </div>
</div>
