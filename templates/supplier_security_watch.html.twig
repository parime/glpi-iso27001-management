{# Issue #167 : veille de sécurité d'un fournisseur (avis CERT-FR et vulnérabilités du parc) #}
<div class="container-fluid">
   {% if keywords is empty %}
      <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>{{ __('Choisissez le fournisseur de ce risque pour suivre les avis de sécurité qui le concernent.', 'grcmanager') }}</div>
   {% else %}
      <p class="text-muted">
         <i class="ti ti-search me-1"></i>{{ __('Noms recherchés', 'grcmanager') }} :
         {% for k in keywords %}<span class="badge bg-secondary-lt me-1">{{ k }}</span>{% endfor %}
      </p>
      {% if not enabled %}
         <div class="alert alert-warning"><i class="ti ti-plug-off me-1"></i>{{ __('La veille consulte le CERT-FR une fois l\'option « Activer l\'enrichissement NVD » cochée dans la configuration du plugin.', 'grcmanager') }}
            <a href="{{ config_url }}">{{ __('Configuration', 'grcmanager') }}</a></div>
      {% endif %}

      <h4 class="mt-2"><i class="ti ti-alert-octagon me-1"></i>{{ __('Avis et alertes du CERT-FR (%d derniers jours)', 'grcmanager')|format(days) }}</h4>
      {% if notices is empty %}
         <p class="text-muted"><i class="ti ti-circle-check text-green me-1"></i>{{ __('Aucun avis ne cite ce fournisseur.', 'grcmanager') }}
            {% if last_refresh %}{{ __('Dernière consultation du CERT-FR : %s.', 'grcmanager')|format(last_refresh|formatted_datetime) }}{% endif %}</p>
      {% else %}
         <table class="table table-card">
            <thead><tr><th>{{ __('Date', 'grcmanager') }}</th><th>{{ __('Référence', 'grcmanager') }}</th><th>{{ __('Titre', 'grcmanager') }}</th></tr></thead>
            <tbody>
            {% for n in notices %}
               <tr>
                  <td class="text-nowrap">{{ n.published ? n.published|formatted_date : '' }}</td>
                  <td class="text-nowrap">
                     {% if n.kind == 'alerte' %}<span class="badge bg-red text-white me-1">{{ __('Alerte', 'grcmanager') }}</span>{% endif %}
                     <a href="{{ n.link }}" target="_blank" rel="noopener">{{ n.ref }}</a>
                  </td>
                  <td>{{ n.title }}{% if n.summary %}<div class="text-muted small">{{ n.summary }}</div>{% endif %}</td>
               </tr>
            {% endfor %}
            </tbody>
         </table>
      {% endif %}

      <h4 class="mt-3"><i class="ti ti-bug me-1"></i>{{ __('Vulnérabilités de ses logiciels dans le parc', 'grcmanager') }}</h4>
      {% if park is empty %}
         <p class="text-muted">{{ __('Aucun logiciel surveillé de ce fournisseur n\'a de vulnérabilité connue.', 'grcmanager') }}</p>
      {% else %}
         <table class="table table-card">
            <thead><tr><th>{{ __('Logiciel', 'grcmanager') }}</th><th class="text-end">CVE</th><th class="text-end">{{ __('Prioritaires', 'grcmanager') }}</th><th class="text-end">{{ __('Exploitées', 'grcmanager') }}</th><th class="text-end">{{ __('Machines', 'grcmanager') }}</th></tr></thead>
            <tbody>
            {% for p in park %}
               <tr>
                  <td>{{ p.product }}</td>
                  <td class="text-end">{{ p.cves }}</td>
                  <td class="text-end">{% if p.priority %}<span class="badge bg-orange text-white">{{ p.priority }}</span>{% else %}0{% endif %}</td>
                  <td class="text-end">{% if p.kev %}<span class="badge bg-red text-white">{{ p.kev }}</span>{% else %}0{% endif %}</td>
                  <td class="text-end">{{ p.machines }}</td>
               </tr>
            {% endfor %}
            </tbody>
         </table>
         <a href="{{ park_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-list me-1"></i>{{ __('Vulnérabilités du parc', 'grcmanager') }}</a>
      {% endif %}
   {% endif %}
</div>
