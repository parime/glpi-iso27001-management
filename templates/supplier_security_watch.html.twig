{# Issue #167 : veille de sécurité d'un fournisseur (avis CERT-FR et vulnérabilités du parc) #}
<div class="container-fluid">
   {% if keywords is empty %}
      <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>{{ __('Choose this risk\'s supplier to follow the security advisories about it.', 'grcmanager') }}</div>
   {% else %}
      <p class="text-muted">
         <i class="ti ti-search me-1"></i>{{ __('Searched names', 'grcmanager') }} :
         {% for k in keywords %}<span class="badge bg-secondary-lt me-1">{{ k }}</span>{% endfor %}
      </p>
      {% if not enabled %}
         <div class="alert alert-warning"><i class="ti ti-plug-off me-1"></i>{{ __('The watch queries CERT-FR once the "Enable NVD enrichment" option is checked in the plugin configuration.', 'grcmanager') }}
            <a href="{{ config_url }}">{{ __('Configuration', 'grcmanager') }}</a></div>
      {% endif %}

      <h4 class="mt-2"><i class="ti ti-alert-octagon me-1"></i>{{ __('CERT-FR advisories and alerts (last %d days)', 'grcmanager')|format(days) }}</h4>
      {% if notices is empty %}
         <p class="text-muted"><i class="ti ti-circle-check text-green me-1"></i>{{ __('No advisory mentions this supplier.', 'grcmanager') }}
            {% if last_refresh %}{{ __('Last CERT-FR check: %s.', 'grcmanager')|format(last_refresh|formatted_datetime) }}{% endif %}</p>
      {% else %}
         <table class="table table-card">
            <thead><tr><th>{{ __('Date', 'grcmanager') }}</th><th>{{ __('Reference', 'grcmanager') }}</th><th>{{ __('Title', 'grcmanager') }}</th></tr></thead>
            <tbody>
            {% for n in notices %}
               <tr>
                  <td class="text-nowrap">{{ n.published ? n.published|formatted_date : '' }}</td>
                  <td class="text-nowrap">
                     {% if n.kind == 'alerte' %}<span class="badge bg-red text-white me-1">{{ __('Alert', 'grcmanager') }}</span>{% endif %}
                     <a href="{{ n.link }}" target="_blank" rel="noopener">{{ n.ref }}</a>
                  </td>
                  <td>{{ n.title }}{% if n.summary %}<div class="text-muted small">{{ n.summary }}</div>{% endif %}</td>
               </tr>
            {% endfor %}
            </tbody>
         </table>
      {% endif %}

      <h4 class="mt-3"><i class="ti ti-bug me-1"></i>{{ __('Vulnerabilities of its software in the fleet', 'grcmanager') }}</h4>
      {% if park is empty %}
         <p class="text-muted">{{ __('No watched software from this supplier has a known vulnerability.', 'grcmanager') }}</p>
      {% else %}
         <table class="table table-card">
            <thead><tr><th>{{ __('Software', 'grcmanager') }}</th><th class="text-end">CVE</th><th class="text-end">{{ __('Priority', 'grcmanager') }}</th><th class="text-end">{{ _x('plural', 'Exploited', 'grcmanager') }}</th><th class="text-end">{{ __('Machines', 'grcmanager') }}</th></tr></thead>
            <tbody>
            {% for p in park %}
               <tr>
                  <td>{{ p.product }}</td>
                  <td class="text-end">{{ p.cves }}</td>
                  <td class="text-end">{% if p.priority %}<span class="badge bg-orange text-white">{{ p.priority }}</span>{% else %}0{% endif %}</td>
                  <td class="text-end">{% if p.kev %}<span class="badge bg-red text-white">{{ p.kev }}</span>{% else %}0{% endif %}</td>
                  <td class="text-end">{{ p.machines }}</td>
               </tr>
            {% endfor %}
            </tbody>
         </table>
         <a href="{{ park_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-list me-1"></i>{{ __('Fleet vulnerabilities', 'grcmanager') }}</a>
      {% endif %}
   {% endif %}
</div>
