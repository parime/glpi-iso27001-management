{# Issue #143 : choix du tableau de bord affiché (vue d'ensemble ISMS, incidents de sécurité). #}
{# GLPI affiche « carte vide » à la place d'une carte que l'utilisateur n'a pas le droit de voir :
   sur cette page, la carte disparaît (sauf en mode édition, pour pouvoir la retirer). #}
<style>
   .grcmanager-dashboard .dashboard:not(.edit-mode) .grid-stack-item:has(.empty-card.card-warning) {
      display: none;
   }
</style>
{% if views|length > 1 %}
   <div class="btn-group mb-3 flex-wrap" role="group" aria-label="{{ __('Dashboard', 'grcmanager') }}">
      {% for name, view in views %}
         <a class="btn btn-sm {{ name == active ? 'btn-primary' : 'btn-outline-secondary' }}"
            href="{{ url }}?view={{ name|url_encode }}"{% if name == active %} aria-current="page"{% endif %}>
            <i class="{{ view.icon }} me-1"></i>{{ view.label }}
         </a>
      {% endfor %}
   </div>
{% endif %}
