{# Issue #604 : correspondance des colonnes du fichier de résultats d'une simulation d'hameçonnage,
   avant l'import (voir front/phishingimport.php). #}
<div class="container-fluid">
<div class="card">
   <div class="card-header">
      <h3 class="card-title"><i class="ti ti-file-import me-2"></i>{{ __('Import the results of "%s"', 'grcmanager')|format(campaign.name) }}</h3>
   </div>
   <div class="card-body">
      <form method="post" action="{{ action }}">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="id" value="{{ campaign.id }}">
         <p><i class="ti ti-file-text me-1"></i><strong>{{ file_name }}</strong> : {{ row_count }} {{ __('line(s)', 'grcmanager') }}{% if truncated %} <span class="badge bg-orange-lt">{{ __('truncated to the first %d lines', 'grcmanager')|format(max_rows) }}</span>{% endif %}</p>

         <h4>{{ __('Column of each field', 'grcmanager') }}</h4>
         <p class="text-secondary small">{{ __('The usual columns are recognised automatically. Only the email address (or login) is required: without a "received" or status column, each line is a person who received the email.', 'grcmanager') }}</p>
         <div class="row g-2 mb-3">
            {% for field, label in labels %}
               <div class="col-md-3">
                  <label class="form-label small mb-1" for="grc-map-{{ field }}">{{ label }}{% if field == 'identifier' %} <span class="text-danger">*</span>{% endif %}</label>
                  <select id="grc-map-{{ field }}" name="mapping[{{ field }}]" class="form-select form-select-sm {{ mapping[field] is defined ? 'border-green' : '' }}">
                     <option value="">{{ __('(not imported)', 'grcmanager') }}</option>
                     {% for index, header in headers %}
                        <option value="{{ index }}" {{ mapping[field] is defined and mapping[field] == index ? 'selected' : '' }}>{{ header }}</option>
                     {% endfor %}
                  </select>
               </div>
            {% endfor %}
         </div>

         {% if preview is not empty %}
            <h4>{{ __('First lines of the file', 'grcmanager') }}</h4>
            <div class="table-responsive mb-3">
               <table class="table table-sm table-bordered small">
                  <thead><tr>{% for header in headers %}<th>{{ header }}</th>{% endfor %}</tr></thead>
                  <tbody>
                     {% for row in preview %}
                        <tr>{% for value in row %}<td>{{ value }}</td>{% endfor %}</tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
         {% endif %}

         <div class="alert alert-info small"><i class="ti ti-shield-lock me-1"></i>{{ __('The results replace those of the campaign. People are matched with the active GLPI users of the entity of the campaign; the address is kept only for the lines not matched. Nothing is sent to anyone.', 'grcmanager') }}</div>
         <div class="d-flex gap-2">
            <button type="submit" name="import" class="btn btn-primary"><i class="ti ti-check me-1"></i>{{ __('Import', 'grcmanager') }}</button>
            <button type="submit" name="cancel" class="btn btn-ghost-secondary" formnovalidate>{{ __('Cancel') }}</button>
         </div>
      </form>
   </div>
</div>
</div>
