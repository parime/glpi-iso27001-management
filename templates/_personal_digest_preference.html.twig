{# Issue #877 : choix du récapitulatif par e-mail, sous la liste de « Mon espace GRC »
   (PersonalDigest::showPreference()). #}
<div class="container-fluid my-2">
   <div class="card" id="grc-personal-digest">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-mail-opened me-2"></i>{{ __('Summary by email', 'grcmanager') }}</h3>
         <div class="card-actions">
            {% if frequency == 'never' %}
               <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-mail-off me-1"></i>{{ __('No summary', 'grcmanager') }}</span>
            {% else %}
               <span class="badge bg-blue-subtle text-blue-emphasis"><i class="ti ti-calendar-repeat me-1"></i>{{ frequencies[frequency] }}</span>
            {% endif %}
         </div>
      </div>
      <div class="card-body">
         <div class="alert alert-info">
            <div class="fw-bold mb-1"><i class="ti ti-help-circle me-1"></i>{{ __('What is this for?', 'grcmanager') }}</div>
            {{ __('Instead of waiting for separate notifications, you can receive one email that lists everything shown on this page. It is only sent when something is waiting for you, it only lists what you are allowed to see, and it is written in your language.', 'grcmanager') }}
         </div>
         {% if not can_be_sent %}
            <div class="alert alert-warning" id="grc-personal-digest-off">
               <i class="ti ti-alert-triangle me-1"></i>{{ __('Summaries are not sent on this GLPI yet: ask your GLPI administrator to enable the "personaldigest" automatic task and email notifications. Your choice is kept in the meantime.', 'grcmanager') }}
            </div>
         {% endif %}
         <form method="post" action="{{ action }}" class="d-flex flex-wrap align-items-end gap-2">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div>
               <label class="form-label" for="grc-personal-digest-frequency">{{ __('Receive my summary', 'grcmanager') }}</label>
               <select class="form-select" name="personal_digest_frequency" id="grc-personal-digest-frequency">
                  {% for value, label in frequencies %}
                     <option value="{{ value }}"{% if value == frequency %} selected{% endif %}>{{ label }}</option>
                  {% endfor %}
               </select>
            </div>
            <button type="submit" class="btn btn-primary" name="save_personal_digest" value="1"><i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}</button>
            {% if can_be_sent %}
               <button type="submit" class="btn btn-outline-secondary" name="send_personal_digest" value="1"><i class="ti ti-send me-1"></i>{{ __('Send me my summary now', 'grcmanager') }}</button>
            {% endif %}
         </form>
         <p class="text-muted small mt-2 mb-0">
            <i class="ti ti-clock me-1"></i>{% if last_sent %}{{ __('Last summary sent: %s', 'grcmanager')|format(last_sent) }}{% else %}{{ __('No summary has been sent to you yet.', 'grcmanager') }}{% endif %}
         </p>
      </div>
   </div>
</div>
