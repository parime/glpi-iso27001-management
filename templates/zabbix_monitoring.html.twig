{# Issue #836 : supervision lue dans Zabbix (A.8.16, A.8.6, A.5.30), actifs des entités de la personne.
   Lecture seule : rien n'est modifié dans Zabbix ; le jeton n'est jamais réaffiché. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% macro stat_card(id, icon, color, value, title, help) %}
   <div class="col-sm-6 col-lg"><div class="card card-sm h-100"><div class="card-body">
      <div class="d-flex align-items-center">
         <span class="badge bg-{{ color }}-subtle text-{{ color }}-emphasis me-2 fs-3"><i class="{{ icon }}"></i></span>
         <div>
            <div class="fw-bold fs-3" id="{{ id }}">{{ value }}</div>
            <div class="small">{{ title }}</div>
         </div>
      </div>
      {% if help %}<div class="small text-muted mt-1">{{ help }}</div>{% endif %}
   </div></div></div>
{% endmacro %}
{% macro severity_badge(severities, severity) %}
   {% set info = severities[severity] %}
   <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis"><i class="ti ti-alert-triangle me-1"></i>{{ info.label }}</span>
{% endmacro %}

<div id="grc-zabbix">
   {% set c = summary.concerned %}
   {% set rate_color = c.rate is null ? 'secondary' : (c.rate >= 95 ? 'success' : (c.rate >= 80 ? 'warning' : 'danger')) %}
   <div class="row row-cards mb-3">
      {{ _self.stat_card('grc-zabbix-rate', 'ti ti-activity-heartbeat', rate_color, c.rate is null ? '-' : c.rate ~ ' %', __('Assets monitored by Zabbix', 'grcmanager'), _n('%d asset concerned', '%d assets concerned', c.total, 'grcmanager')|format(c.total)) }}
      {{ _self.stat_card('grc-zabbix-critical', 'ti ti-eye-off', summary.critical.uncovered > 0 ? 'danger' : 'success', summary.critical.uncovered, __('Critical assets not monitored', 'grcmanager'), __('out of %d critical assets', 'grcmanager')|format(summary.critical.total)) }}
      {{ _self.stat_card('grc-zabbix-open-high', 'ti ti-alert-octagon', summary.open_high > 0 ? 'danger' : 'success', summary.open_high, __('Open high-severity problems', 'grcmanager'), __('%1$d problem(s) over %2$d days', 'grcmanager')|format(summary.problems, summary.period_days)) }}
      {{ _self.stat_card('grc-zabbix-sli', 'ti ti-chart-line', summary.services_below > 0 ? 'danger' : (summary.lowest_sli is null ? 'secondary' : 'success'), summary.lowest_sli is null ? '-' : summary.lowest_sli|number_format(2) ~ ' %', __('Lowest service availability', 'grcmanager'), summary.services > 0 ? __('%1$d service(s), %2$d below their objective', 'grcmanager')|format(summary.services, summary.services_below) : __('No service level (SLA) read', 'grcmanager')) }}
      {{ _self.stat_card('grc-zabbix-capacity', 'ti ti-gauge', summary.capacity_assets > 0 ? 'warning' : 'success', summary.capacity_assets, __('Assets with a saturation', 'grcmanager'), __('Disk, memory or processor, over %d days', 'grcmanager')|format(summary.period_days)) }}
   </div>

   {% if not readings %}
      <div class="alert alert-info d-flex align-items-start gap-2 mb-3" id="grc-zabbix-empty">
         <i class="ti ti-info-circle fs-2"></i>
         <div>{{ __('Nothing has been read from Zabbix yet: enter the connection below, then click "Read now". Until then, every asset concerned is shown as not monitored.', 'grcmanager') }}</div>
      </div>
   {% elseif last_read.error_label %}
      <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
         <i class="ti ti-alert-triangle fs-2"></i>
         <div>{{ __('The last reading failed: the page shows the previous successful reading.', 'grcmanager') }} {{ last_read.error_label }}</div>
      </div>
   {% endif %}

   {# Actifs concernés : non supervisés d'abord, critiques en tête. #}
   <div class="card mb-3" id="grc-zabbix-assets">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-server-2 me-2"></i>{{ __('Assets and their monitoring', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_rows }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Concerned assets: %s. A Zabbix host is matched with an asset by its serial number, its name, its short name (without the domain) or its IP address. The availability is the share of time without a high-severity problem over the period.', 'grcmanager')|format(scopes[settings.scope]) }}</div>
      {% if rows is empty %}
         <div class="card-body text-muted">{{ __('No computer or network device concerned in your entities.', 'grcmanager') }}</div>
      {% else %}
         {% if total_rows > rows|length %}
            <div class="card-body small pb-0">{{ __('%1$d assets: the first %2$d are shown, gaps first.', 'grcmanager')|format(total_rows, rows|length) }}</div>
         {% endif %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Asset', 'grcmanager') }}</th>
                  <th>{{ __('Monitoring', 'grcmanager') }}</th>
                  <th>{{ __('Availability', 'grcmanager') }}</th>
                  <th>{{ __('Open problems', 'grcmanager') }}</th>
                  <th>{{ __('Longest outage and RTO', 'grcmanager') }}</th>
                  <th>{{ __('Saturation', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for row in rows %}
                  {% set st = statuses[row.status] %}
                  <tr>
                     <td>
                        <a href="{{ row.url }}">{{ row.name }}</a>
                        <div class="small text-muted">{{ row.type }}{% if row.entity %} · {{ row.entity }}{% endif %}</div>
                        {% if row.critical %}<span class="badge bg-red-subtle text-red-emphasis me-1"><i class="ti ti-flame me-1"></i>{{ __('Critical', 'grcmanager') }}</span>{% endif %}
                        {% if row.is_server %}<span class="badge bg-azure-subtle text-azure-emphasis me-1"><i class="ti ti-server me-1"></i>{{ __('Server', 'grcmanager') }}</span>{% endif %}
                     </td>
                     <td>
                        <span class="badge bg-{{ st.color }}-subtle text-{{ st.color }}-emphasis"><i class="{{ st.icon }} me-1"></i>{{ st.label }}</span>
                        {% if row.hosts is not empty %}<div class="small text-muted mt-1">{{ __('Zabbix host: %s', 'grcmanager')|format(row.hosts|join(', ')) }}</div>{% endif %}
                     </td>
                     <td>
                        {% if row.availability is null %}
                           <span class="text-muted">-</span>
                        {% else %}
                           {% set av_color = row.availability >= 99.9 ? 'success' : (row.availability >= 99 ? 'warning' : 'danger') %}
                           <span class="badge bg-{{ av_color }}-subtle text-{{ av_color }}-emphasis">{{ row.availability|number_format(2) }} %</span>
                        {% endif %}
                     </td>
                     <td>
                        {% if row.open_high > 0 %}<span class="badge bg-red-subtle text-red-emphasis me-1"><i class="ti ti-alert-octagon me-1"></i>{{ __('High: %d', 'grcmanager')|format(row.open_high) }}</span>{% endif %}
                        {% if row.open_other > 0 %}<span class="badge bg-orange-subtle text-orange-emphasis me-1">{{ __('Other: %d', 'grcmanager')|format(row.open_other) }}</span>{% endif %}
                        {% if row.open_high == 0 and row.open_other == 0 %}<span class="text-muted">-</span>{% endif %}
                     </td>
                     <td class="small">
                        {{ row.longest_label ?: '-' }}
                        {% for process in row.processes %}
                           <div>
                              <a href="{{ process.url }}">{{ process.name }}</a>
                              {% if process.rto %}<span class="text-muted">· RTO {{ process.rto }}</span>{% endif %}
                              {% if process.exceeded %}<span class="badge bg-danger-subtle text-danger-emphasis ms-1"><i class="ti ti-clock-exclamation me-1"></i>{{ __('Outage longer than the RTO', 'grcmanager') }}</span>{% endif %}
                           </div>
                        {% endfor %}
                     </td>
                     <td>
                        {% for kind, count in row.capacity %}
                           <span class="badge bg-warning-subtle text-warning-emphasis me-1 mb-1"><i class="{{ capacities[kind].icon }} me-1"></i>{{ capacities[kind].label }} : {{ count }}</span>
                        {% else %}
                           <span class="text-muted">-</span>
                        {% endfor %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Problèmes de la période et problèmes ouverts. #}
   <div class="card mb-3" id="grc-zabbix-problems">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-alert-triangle me-2"></i>{{ __('Problems over the last %d days', 'grcmanager')|format(settings.period_days) }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_problems }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Problems of severity Warning or higher, open ones first. A high-severity problem can be turned into a security incident or a ticket: it is only created when you click, never automatically.', 'grcmanager') }}</div>
      {% if problems is empty %}
         <div class="card-body text-muted">{{ __('No problem on your assets over the period.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Severity', 'grcmanager') }}</th>
                  <th>{{ __('Problem', 'grcmanager') }}</th>
                  <th>{{ __('Asset', 'grcmanager') }}</th>
                  <th>{{ __('Started', 'grcmanager') }}</th>
                  <th>{{ __('Duration', 'grcmanager') }}</th>
                  <th>{{ __('Follow-up', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for problem in problems %}
                  <tr>
                     <td>{{ _self.severity_badge(severities, problem.severity) }}</td>
                     <td>
                        {{ problem.name }}
                        <div class="mt-1">
                           {% if problem.is_open %}
                              <span class="badge bg-danger-subtle text-danger-emphasis"><i class="ti ti-circle-dot me-1"></i>{{ __('Open', 'grcmanager') }}</span>
                           {% else %}
                              <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-circle-check me-1"></i>{{ __('Resolved', 'grcmanager') }}</span>
                           {% endif %}
                           {% if problem.acknowledged %}<span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-eye-check me-1"></i>{{ __('Acknowledged in Zabbix', 'grcmanager') }}</span>{% endif %}
                           {% if problem.capacity %}<span class="badge bg-warning-subtle text-warning-emphasis"><i class="{{ capacities[problem.capacity].icon }} me-1"></i>{{ capacities[problem.capacity].label }}</span>{% endif %}
                        </div>
                     </td>
                     <td>
                        {% if problem.asset %}<a href="{{ problem.asset.url }}">{{ problem.asset.name }}</a>{% else %}<span class="text-muted">{{ problem.host }}</span>{% endif %}
                     </td>
                     <td class="small">{{ problem.date_label }}</td>
                     <td class="small">{{ problem.duration_label ?: '-' }}</td>
                     <td>
                        {% if problem.incident_url %}<a class="badge bg-purple-subtle text-purple-emphasis me-1" href="{{ problem.incident_url }}"><i class="ti ti-shield-exclamation me-1"></i>{{ __('Security incident', 'grcmanager') }}</a>{% endif %}
                        {% if problem.ticket_url %}<a class="badge bg-blue-subtle text-blue-emphasis me-1" href="{{ problem.ticket_url }}"><i class="ti ti-ticket me-1"></i>{{ __('Ticket', 'grcmanager') }}</a>{% endif %}
                        {% if problem.high and ((can_incident and not problem.incident_url) or (can_ticket and not problem.ticket_url)) %}
                           <form method="post" action="{{ action }}" class="d-inline">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              {% if can_incident and not problem.incident_url %}
                                 <button type="submit" class="btn btn-sm btn-outline-danger mb-1" name="zabbix_incident" value="{{ problem.id }}"><i class="ti ti-shield-plus me-1"></i>{{ __('Propose as security incident', 'grcmanager') }}</button>
                              {% endif %}
                              {% if can_ticket and not problem.ticket_url %}
                                 <button type="submit" class="btn btn-sm btn-outline-secondary mb-1" name="zabbix_ticket" value="{{ problem.id }}"><i class="ti ti-ticket me-1"></i>{{ __('Create a ticket', 'grcmanager') }}</button>
                              {% endif %}
                           </form>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Disponibilité des services (SLA Zabbix), rattachés aux processus métier. #}
   <div class="card mb-3" id="grc-zabbix-services">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-chart-line me-2"></i>{{ __('Availability of the services (Zabbix SLA)', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ services|length }}</span></div>
      </div>
      <div class="card-body small pb-0 text-muted">{{ __('Availability measured by Zabbix over the current period of each SLA, compared with its objective (SLO). Link a service to the business process it supports to compare it with the continuity needs.', 'grcmanager') }}</div>
      {% if services is empty %}
         <div class="card-body text-muted">{{ __('No service level read: SLAs are available from Zabbix 6.0 (Services > SLA).', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Service', 'grcmanager') }}</th>
                  <th>{{ __('Objective (SLO)', 'grcmanager') }}</th>
                  <th>{{ __('Current period', 'grcmanager') }}</th>
                  <th>{{ __('Previous period', 'grcmanager') }}</th>
                  <th>{{ __('Downtime', 'grcmanager') }}</th>
                  <th>{{ __('Business process', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for service in services %}
                  <tr>
                     <td>{{ service.service }}<div class="small text-muted">{{ service.sla }}</div></td>
                     <td>{{ service.slo is null ? '-' : service.slo|number_format(2) ~ ' %' }}</td>
                     <td>
                        {% if service.sli is null %}
                           <span class="text-muted">-</span>
                        {% else %}
                           {% set sli_color = service.status == 'below' ? 'danger' : 'success' %}
                           <span class="badge bg-{{ sli_color }}-subtle text-{{ sli_color }}-emphasis"><i class="ti {{ service.status == 'below' ? 'ti-trending-down' : 'ti-circle-check' }} me-1"></i>{{ service.sli|number_format(2) }} %</span>
                           {% if service.status == 'below' %}<div class="small text-danger">{{ __('Below the objective', 'grcmanager') }}</div>{% endif %}
                        {% endif %}
                     </td>
                     <td>{{ service.sli_previous is null ? '-' : service.sli_previous|number_format(2) ~ ' %' }}</td>
                     <td class="small">{{ service.downtime_label ?: '-' }}</td>
                     <td>
                        {% if service.process_url %}<a href="{{ service.process_url }}">{{ service.process }}</a>{% endif %}
                        {% if can_manage and process_choices is not empty %}
                           <form method="post" action="{{ action }}" class="d-flex gap-1 mt-1">
                              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="zabbix_service" value="{{ service.id }}">
                              <select class="form-select form-select-sm" name="zabbix_process" aria-label="{{ __('Business process', 'grcmanager') }}">
                                 <option value="0">-----</option>
                                 {% for id, name in process_choices %}
                                    <option value="{{ id }}" {{ id == service.process_id ? 'selected' }}>{{ name }}</option>
                                 {% endfor %}
                              </select>
                              <button type="submit" class="btn btn-sm btn-outline-primary" name="link_zabbix_service" value="1" title="{{ __('Save', 'grcmanager') }}"><i class="ti ti-device-floppy"></i></button>
                           </form>
                        {% elseif not service.process_url %}
                           <span class="text-muted">-</span>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   {# Hôtes Zabbix sans actif GLPI reconnu. #}
   {% if unmatched is not empty %}
      <div class="card mb-3" id="grc-zabbix-unmatched">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-help-hexagon me-2"></i>{{ __('Zabbix hosts not matched with a GLPI asset', 'grcmanager') }}</h3>
            <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_unmatched }}</span></div>
         </div>
         <div class="card-body small pb-0 text-muted">{{ __('Check them: the asset may be missing from the inventory, or named differently in GLPI and in Zabbix.', 'grcmanager') }}</div>
         <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
               <thead><tr><th>{{ __('Zabbix host', 'grcmanager') }}</th><th>{{ __('Technical name', 'grcmanager') }}</th><th>{{ __('IP addresses', 'grcmanager') }}</th><th>{{ __('Monitoring', 'grcmanager') }}</th></tr></thead>
               <tbody>
               {% for host in unmatched %}
                  <tr>
                     <td>{{ host.name }}</td>
                     <td class="small text-muted">{{ host.host }}</td>
                     <td class="small">{{ host.ips|join(', ') }}</td>
                     <td>
                        {% if host.monitored %}
                           <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-activity-heartbeat me-1"></i>{{ __('Monitored', 'grcmanager') }}</span>
                        {% else %}
                           <span class="badge bg-orange-subtle text-orange-emphasis"><i class="ti ti-player-pause me-1"></i>{{ __('Monitoring disabled in Zabbix', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      </div>
   {% endif %}

   {# Connexion au serveur Zabbix (lecture seule). #}
   <div class="card mb-3" id="grc-zabbix-connection">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-plug-connected me-2"></i>{{ __('Connection to Zabbix (read only)', 'grcmanager') }}</h3>
         <div class="card-actions">
            {% if connection.configured %}
               <span class="badge bg-success-subtle text-success-emphasis"><i class="ti ti-plug-connected me-1"></i>{{ __('Configured', 'grcmanager') }}</span>
            {% else %}
               <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-plug-x me-1"></i>{{ __('Not configured', 'grcmanager') }}</span>
            {% endif %}
         </div>
      </div>
      <div class="card-body">
         <p class="small mb-2">
            {% if last_read.date_label %}
               <span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-clock me-1"></i>{{ __('Last reading: %s', 'grcmanager')|format(last_read.date_label) }}</span>
               {% if last_read.version %}<span class="badge bg-secondary-subtle text-secondary-emphasis me-1">Zabbix {{ last_read.version }}</span>{% endif %}
               {{ __('%1$d host(s), %2$d problem(s), %3$d service(s).', 'grcmanager')|format(last_read.hosts, last_read.problems, last_read.services) }}
               {% if last_read.truncated %}<span class="badge bg-warning-subtle text-warning-emphasis ms-1">{{ __('Only the most recent items were read', 'grcmanager') }}</span>{% endif %}
            {% else %}
               {{ __('No reading yet.', 'grcmanager') }}
            {% endif %}
            {% if last_read.error_label %}<span class="d-block text-danger mt-1"><i class="ti ti-alert-triangle me-1"></i>{{ last_read.error_label }}</span>{% endif %}
         </p>
         <p class="small text-muted mb-1">{{ __('How to prepare Zabbix:', 'grcmanager') }}</p>
         <ol class="small text-muted">
            <li>{{ __('Users > User roles: create a role of type User with API access limited to the methods host.get, problem.get, event.get, service.get, sla.get and sla.getsli.', 'grcmanager') }}</li>
            <li>{{ __('Users > Users: create a user with this role, in a user group with read permission on the host groups to monitor (and on the services).', 'grcmanager') }}</li>
            <li>{{ __('Users > API tokens: create a token for this user, then copy it here with the address of the Zabbix interface.', 'grcmanager') }}</li>
         </ol>
         {% if not connection.allow_private %}
            <div class="alert alert-info small py-2">
               <i class="ti ti-info-circle me-1"></i>{{ __('A Zabbix server on an internal address (private network) is refused by default: an administrator can allow internal addresses in the plugin configuration.', 'grcmanager') }}
               <a href="{{ config_url }}">{{ __('Outgoing connections', 'grcmanager') }}</a>
            </div>
         {% endif %}
         {% if can_manage %}
            <form method="post" action="{{ action }}" class="row g-2 align-items-end">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="col-md-6">
                  <label class="form-label" for="grc-zabbix-url">{{ __('Address of the Zabbix interface', 'grcmanager') }}</label>
                  <input type="url" class="form-control" id="grc-zabbix-url" name="zabbix_url" value="{{ connection.url }}" maxlength="255" placeholder="https://zabbix.example.test/zabbix" autocomplete="off">
               </div>
               <div class="col-md-6">
                  <label class="form-label" for="grc-zabbix-token">{{ __('API token', 'grcmanager') }}</label>
                  <input type="password" class="form-control" id="grc-zabbix-token" name="zabbix_api_token" value="" autocomplete="new-password" placeholder="{{ connection.has_token ? __('Token saved (leave empty to keep it)', 'grcmanager') : '' }}">
               </div>
               <div class="col-12 form-hint">
                  {% if connection.has_token %}<span class="badge bg-success-subtle text-success-emphasis me-1"><i class="ti ti-lock me-1"></i>{{ __('Token saved', 'grcmanager') }}</span>{% endif %}
                  {{ __('The token is encrypted with the GLPI key, never displayed again nor logged. Only the address of this server is called, and only to read.', 'grcmanager') }}
                  {% if connection.has_token %}
                     <span class="form-check form-check-inline ms-2">
                        <input type="checkbox" class="form-check-input" id="grc-zabbix-clear" name="zabbix_clear_token" value="1">
                        <label class="form-check-label" for="grc-zabbix-clear">{{ __('Delete the saved token', 'grcmanager') }}</label>
                     </span>
                  {% endif %}
               </div>
               <div class="col-md-6">
                  {{ fields.dropdownField('Entity', 'zabbix_entities_id', connection.entity, __('Entity of the readings', 'grcmanager'), {
                     'helper': __('The readings are visible in this entity and its sub-entities; hosts not matched with an asset are only listed in this entity.', 'grcmanager'),
                     'full_width': true,
                  }) }}
               </div>
               <div class="col-md-6">
                  <div class="form-check form-switch">
                     <input type="checkbox" class="form-check-input" role="switch" id="grc-zabbix-enabled" name="zabbix_enabled" value="1" {{ connection.enabled ? 'checked' }}>
                     <label class="form-check-label" for="grc-zabbix-enabled">{{ __('Read automatically every day (automatic action "zabbix")', 'grcmanager') }}</label>
                  </div>
               </div>
               <div class="col-12 d-flex flex-wrap gap-2">
                  <button type="submit" class="btn btn-outline-primary" name="save_zabbix" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
                  {% if connection.configured %}
                     <button type="submit" class="btn btn-primary" name="read_zabbix" value="1"><i class="ti ti-refresh me-1"></i>{{ __('Read now', 'grcmanager') }}</button>
                  {% endif %}
                  {% if readings %}
                     <button type="submit" class="btn btn-outline-danger ms-auto" name="clear_zabbix" value="1"><i class="ti ti-trash me-1"></i>{{ __('Delete the readings', 'grcmanager') }}</button>
                  {% endif %}
               </div>
            </form>
         {% else %}
            <p class="small text-muted mb-0">{{ __('Only users who can modify the plugin data can set up this reading.', 'grcmanager') }}</p>
         {% endif %}
      </div>
   </div>

   {# Actifs concernés et période. #}
   <div class="card mb-3" id="grc-zabbix-settings">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-adjustments me-2"></i>{{ __('Which assets must be monitored?', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="small mb-2">{{ __('Critical assets are those with a high confidentiality, integrity or availability level (C/I/A classification tab), or published on the Internet (network flow matrix).', 'grcmanager') }}</p>
         {% if can_manage %}
            <form method="post" action="{{ action }}" class="row g-2 align-items-end">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="col-md-6">
                  <label class="form-label" for="grc-zabbix-scope">{{ __('Assets concerned', 'grcmanager') }}</label>
                  <select class="form-select" id="grc-zabbix-scope" name="zabbix_scope">
                     {% for key, label in scopes %}
                        <option value="{{ key }}" {{ key == settings.scope ? 'selected' }}>{{ label }}</option>
                     {% endfor %}
                  </select>
               </div>
               <div class="col-md-3">
                  <label class="form-label" for="grc-zabbix-period">{{ __('Period of the problems (days)', 'grcmanager') }}</label>
                  <input type="number" class="form-control" id="grc-zabbix-period" name="zabbix_period_days" value="{{ settings.period_days }}" min="1" max="90">
               </div>
               <div class="col-md-3">
                  <button type="submit" class="btn btn-primary" name="save_zabbix_settings" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
               </div>
            </form>
         {% else %}
            <p class="small mb-0"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ scopes[settings.scope] }}</span> <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ __('%d days', 'grcmanager')|format(settings.period_days) }}</span></p>
         {% endif %}
      </div>
   </div>

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted small me-auto"><i class="ti ti-lock me-1"></i>{{ __('Read only: nothing is ever changed in Zabbix from GLPI.', 'grcmanager') }}</span>
      <a class="btn btn-sm btn-outline-secondary" href="{{ processes_url }}"><i class="ti ti-building-factory-2 me-1"></i>{{ __('Business processes', 'grcmanager') }}</a>
      <a class="btn btn-sm btn-outline-primary" href="{{ audit_url }}"><i class="ti ti-shield-check me-1"></i>{{ __('Technical security', 'grcmanager') }}</a>
   </div>
</div>
