{# Version installee vs derniere version publiee sur GitHub - meme mecanisme/gabarit que les
   plugins jumeaux glpi-vulnerability-manager, assetsign-glpi et Configuration-glpi-auto. #}
<div class="card card-sm mb-3">
  <div class="card-body d-flex align-items-center gap-3">
    <i class="ti ti-brand-github fs-1 text-muted"></i>
    <div>
      <div class="fw-bold">{{ __('Plugin version', 'grcmanager') }}</div>
      <div class="text-muted small">
        {{ __('Installed version', 'grcmanager') }}
        <span class="badge bg-blue-lt">v{{ installed_version }}</span>
        {% if latest_github_version %}
          {{ __('Latest version on GitHub', 'grcmanager') }}
          <span class="badge {{ latest_github_version != installed_version ? 'bg-orange-lt' : 'bg-green-lt' }}">v{{ latest_github_version }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{# Issue #403 : référentiels de conformité actifs. Une case décochée masque le référentiel et
   l'écarte des scores, sans rien supprimer (voir front/config.php, FrameworkConfig). #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Compliance frameworks', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('Untick a framework your organisation does not follow: it is no longer shown or counted in the scores. Nothing is deleted, and its data comes back when it is enabled again.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      {% for key, name in frameworks %}
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" role="switch" id="grc-framework-{{ key }}" name="frameworks[]" value="{{ key }}" {{ key in frameworks_enabled ? 'checked' }} {{ can_edit_config ? '' : 'disabled' }}>
          <label class="form-check-label" for="grc-framework-{{ key }}">{{ name }}</label>
          <div class="form-hint">{{ frameworks_help[key] ?? '' }}</div>
        </div>
      {% endfor %}
      {% if can_edit_config %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_frameworks" class="btn btn-primary">{{ __('Enregistrer') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>

{# Issue #375 : contact du DPO, repris sur l'export du registre des traitements (article 30). #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Data protection officer (DPO)', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('Name and contact details of the data protection officer, shown on the record of processing activities (GDPR, article 30).', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <input type="text" class="form-control" name="dpo_contact" maxlength="255" value="{{ dpo_contact }}" aria-label="{{ __('Data protection officer (DPO)', 'grcmanager') }}" {{ can_edit_config ? '' : 'disabled' }}>
      {% if can_edit_config %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_dpo_contact" class="btn btn-primary">{{ __('Enregistrer') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>

{# Issue #140 : groupe RSSI, qui lit les documents de tous les audits internes. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{# Registres sensibles : contenu des e-mails des risques, risques fournisseurs et actions de traitement. #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Sensitive registers', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('The risk register, fleet vulnerabilities and network flow matrix describe the organisation\'s weak points. They have their own right (GRC Manager tab of profiles): give it only to the CISO and risk owners.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="form-check form-switch">
        <input type="hidden" name="notifications_minimal" value="0">
        <input type="checkbox" class="form-check-input" id="grc-notifications-minimal" name="notifications_minimal" value="1" {{ notifications_minimal ? 'checked' }} {{ can_edit_sensitive ? '' : 'disabled' }}>
        <label class="form-check-label" for="grc-notifications-minimal">{{ __('E-mails without details: "Risk no. X" and the link to the record, without title, category, level or supplier', 'grcmanager') }}</label>
      </div>
      <p class="text-muted small mt-1 mb-0">{{ __('An e-mail travels in clear text and stays in mailboxes and archives. The recipient reads the details in GLPI, with their own rights.', 'grcmanager') }}</p>
      {% if can_edit_sensitive %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_sensitive_config" class="btn btn-primary">{{ __('Enregistrer') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>

{# Issue #183 : surveillance des fuites de données (Have I Been Pwned). #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Data breach monitoring', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('Every day, the work email addresses of active users are checked with Have I Been Pwned; each exposure is recorded in a sensitive register and the CISO group is notified. Personal addresses are never sent. A verified domain needs a single request; otherwise addresses are checked one by one, within the rate limit of the key.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="form-check form-switch mb-2">
        <input type="hidden" name="hibp_enabled" value="0">
        <input type="checkbox" class="form-check-input" id="grc-hibp-enabled" name="hibp_enabled" value="1" {{ breach_enabled ? 'checked' }} {{ can_edit_sensitive ? '' : 'disabled' }}>
        <label class="form-check-label" for="grc-hibp-enabled">{{ __('Enable data breach monitoring', 'grcmanager') }}</label>
      </div>
      <label class="form-label" for="grc-hibp-domains">{{ __('Work email domains to monitor', 'grcmanager') }}</label>
      <input type="text" class="form-control mb-1" id="grc-hibp-domains" name="hibp_domains" value="{{ breach_domains }}" placeholder="example.com, example.org" {{ can_edit_sensitive ? '' : 'disabled' }}>
      <p class="text-muted small mb-2">{{ __('Only addresses on these domains are checked.', 'grcmanager') }}</p>
      <label class="form-label" for="grc-hibp-key">{{ __('Have I Been Pwned API key', 'grcmanager') }}</label>
      <input type="password" class="form-control mb-1" id="grc-hibp-key" name="hibp_api_key" value="" autocomplete="new-password" placeholder="{{ breach_has_key ? __('Key saved (leave empty to keep it)', 'grcmanager') : '' }}" {{ can_edit_sensitive ? '' : 'disabled' }}>
      <p class="text-muted small mb-2">{{ __('Encrypted with the GLPI key and never displayed again.', 'grcmanager') }}</p>
      {% if breach_has_key %}
        <div class="form-check mb-2">
          <input type="checkbox" class="form-check-input" id="grc-hibp-clear" name="hibp_clear_key" value="1" {{ can_edit_sensitive ? '' : 'disabled' }}>
          <label class="form-check-label" for="grc-hibp-clear">{{ __('Delete the saved key', 'grcmanager') }}</label>
        </div>
      {% endif %}
      {% if can_edit_sensitive %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_breach_config" class="btn btn-primary">{{ __('Enregistrer') }}</button>
          {% if breach_has_key %}
            <button type="submit" name="test_breach_config" class="btn btn-outline-secondary">{{ __('Test the key', 'grcmanager') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Internal audits', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('The documents of an audit can only be read by its team (auditors, owner, auditees) and by the members of this group, even with the GLPI Documents right.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      {{ fields.dropdownField('Group', 'ciso_groups_id', ciso_groups_id, __('CISO group', 'grcmanager'), {'entity': -1}) }}
      <div class="d-flex gap-2 mt-2">
        <button type="submit" name="update_audit_config" class="btn btn-primary">{{ __('Enregistrer') }}</button>
      </div>
    </form>
  </div>
</div>

{# Issue #380 : rappel des tests d'efficacité (tâche planifiée controltestreminder). Le responsable
   du plan de test est toujours prévenu ; le groupe RSSI ci-dessus selon ce réglage. #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Effectiveness test reminders', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('The test plan owner is reminded of an overdue test or a test due within 30 days. An overdue test withdraws the "Verified" status of the control.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <label class="form-label" for="grc-controltest-ciso">{{ __('Also remind the CISO group', 'grcmanager') }}</label>
      <select class="form-select" id="grc-controltest-ciso" name="controltest_reminder_ciso" {{ can_edit_config ? '' : 'disabled' }}>
        {% for key, label in controltest_ciso_modes %}
          <option value="{{ key }}" {{ key == controltest_ciso_mode ? 'selected' }}>{{ label }}</option>
        {% endfor %}
      </select>
      {% if ciso_groups_id <= 0 %}
        <div class="form-hint">{{ __('No CISO group is set (Internal audits above, or Configuration GLPI Auto): only the test plan owner is reminded.', 'grcmanager') }}</div>
      {% endif %}
      <div class="form-hint">
        {{ controltest_cga_branding ? __('E-mail colour taken from the notification branding of Configuration GLPI Auto:', 'grcmanager') : __('E-mail colour:', 'grcmanager') }}
        <span class="badge" style="background-color: {{ controltest_brand_color }};">&nbsp;&nbsp;&nbsp;</span> {{ controltest_brand_color }}
      </div>
      {% if can_edit_config %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_controltest_reminder" class="btn btn-primary">{{ __('Enregistrer') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>

{# Issue #378 : alerte des indicateurs de risque (KRI), au responsable du KRI et au groupe RSSI,
   une fois par changement d'état, puis au retour au vert. #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Risk indicator (KRI) alerts', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('The owner of the indicator and the CISO group are notified once when an indicator reaches the alert level, then when it is back to green. Only recipients who can read the indicator and the data it measures receive it.', 'grcmanager') }}
    </p>
    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <label class="form-label" for="grc-kri-alert-level">{{ __('Alert level', 'grcmanager') }}</label>
      <select class="form-select" id="grc-kri-alert-level" name="kri_alert_level" {{ can_edit_config ? '' : 'disabled' }}>
        {% for key, label in kri_alert_levels %}
          <option value="{{ key }}" {{ key == kri_alert_level ? 'selected' }}>{{ label }}</option>
        {% endfor %}
      </select>
      {% if can_edit_config %}
        <div class="d-flex gap-2 mt-2">
          <button type="submit" name="update_kri_alert" class="btn btn-primary">{{ __('Enregistrer') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>

{# Absorption de glpi-security-incidents (ROADMAP.md "Version 2.0") : interrupteurs
   module/CVE/modèles/tableau de bord, un par fonctionnalité plutôt qu'un seul bouton global
   (voir front/config.php, SecurityIncidentModuleConfig). Le sous-module technique
   (registre parent : securityincident_enabled) désactive aussi ses sous-modules à l'affichage,
   même si leur propre case reste cochée en base - évite de présenter des cases actives sans
   effet visible. #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('Security incidents', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('Enables or disables each part of the security incident management module (dedicated ITIL object, visible in the Assistance menu).', 'grcmanager') }}
    </p>

    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="securityincident_enabled" name="securityincident_enabled" {{ securityincident_modules.securityincident_enabled ? 'checked' : '' }}>
        <label class="form-check-label" for="securityincident_enabled">{{ __('Security incidents module (Assistance menu)', 'grcmanager') }}</label>
      </div>

      <div class="ms-4">
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" role="switch" id="securityincident_cve_enabled" name="securityincident_cve_enabled" {{ securityincident_modules.securityincident_cve_enabled ? 'checked' : '' }}>
          <label class="form-check-label" for="securityincident_cve_enabled">{{ __('CVE tracking', 'grcmanager') }}</label>
        </div>
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" role="switch" id="securityincident_templates_enabled" name="securityincident_templates_enabled" {{ securityincident_modules.securityincident_templates_enabled ? 'checked' : '' }}>
          <label class="form-check-label" for="securityincident_templates_enabled">{{ __('Incident templates', 'grcmanager') }}</label>
        </div>
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" role="switch" id="securityincident_dashboard_enabled" name="securityincident_dashboard_enabled" {{ securityincident_modules.securityincident_dashboard_enabled ? 'checked' : '' }}>
          <label class="form-check-label" for="securityincident_dashboard_enabled">{{ __('Dashboard cards', 'grcmanager') }}</label>
        </div>
      </div>

      {# Issue #371 : groupe sécurité optionnel. #}
      <div class="mt-3" style="max-width: 32rem">
        <label class="form-label" for="dropdown_security_groups_id{{ security_group_rand }}">{{ __('Security group (optional)', 'grcmanager') }}</label>
        {{ security_group_dropdown|raw }}
        <div class="form-hint">{{ __('If set, only the members of this group use the security incidents module, whatever the rights of their profile. A GLPI administrator is never blocked, but each of their consultations outside the group is flagged in the audit log.', 'grcmanager') }}</div>
      </div>

      <div class="d-flex gap-2 mt-2">
        <button type="submit" name="update_securityincident_modules" class="btn btn-primary">{{ __('Enregistrer') }}</button>
      </div>
    </form>
  </div>
</div>

{# Enrichissement CVE via NVD : dépend d'un appel réseau externe (services.nvd.nist.gov) à
   chaque nouvelle CVE suivie, désactivé par défaut - même raisonnement/convention que le module
   Incidents de sécurité ci-dessus (interrupteur explicite plutôt qu'un comportement silencieux
   au premier upgrade). #}
<div class="card mb-3">
  <div class="card-body">
    <h4>{{ __('CVE enrichment (NVD)', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('Automatically retrieves the CVSS score, severity, description and patch links for each tracked CVE, from the public NVD (National Vulnerability Database). No data is ever invented: if the NVD hasn\'t analyzed a CVE yet, nothing is shown until it has.', 'grcmanager') }}
    </p>

    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="enable_nvd_enrichment" name="enable_nvd_enrichment" {{ nvd_config.enable_nvd_enrichment ? 'checked' : '' }}>
        <label class="form-check-label" for="enable_nvd_enrichment">{{ __('Enable NVD enrichment', 'grcmanager') }}</label>
      </div>

      <div class="mb-2" style="max-width: 220px;">
        <label class="form-label" for="cvss_alert_threshold">{{ __('Alert threshold (CVSS score)', 'grcmanager') }}</label>
        <input type="number" class="form-control" id="cvss_alert_threshold" name="cvss_alert_threshold" min="0" max="10" step="0.1" value="{{ nvd_config.cvss_alert_threshold }}">
        <div class="form-hint">{{ __('A CVE with an equal or higher score is highlighted as urgent.', 'grcmanager') }}</div>
      </div>

      {# Issue #160, phase 2 : tickets automatiques des vulnérabilités du parc. #}
      <h5 class="mt-3">{{ __('Fleet vulnerability tickets', 'grcmanager') }}</h5>
      <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="park_tickets_enabled" name="park_tickets_enabled" value="1" {{ park_thresholds.enabled ? 'checked' : '' }}>
        <label class="form-check-label" for="park_tickets_enabled">{{ __('Automatically create a ticket for each vulnerability above a threshold', 'grcmanager') }}</label>
      </div>
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="park_ticket_kev" name="park_ticket_kev" value="1" {{ park_thresholds.kev ? 'checked' : '' }}>
        <label class="form-check-label" for="park_ticket_kev">{{ __('Actively exploited vulnerability (CISA KEV catalog)', 'grcmanager') }}</label>
      </div>
      <div class="d-flex flex-wrap gap-3 mb-2">
        <div style="max-width: 220px;">
          <label class="form-label" for="park_ticket_cvss">{{ __('or CVSS of at least', 'grcmanager') }}</label>
          <input type="number" class="form-control" id="park_ticket_cvss" name="park_ticket_cvss" min="0" max="10" step="0.1" value="{{ park_thresholds.cvss }}">
        </div>
        <div style="max-width: 220px;">
          <label class="form-label" for="park_ticket_epss_percent">{{ __('or exploitation probability (EPSS, %) of at least', 'grcmanager') }}</label>
          <input type="number" class="form-control" id="park_ticket_epss_percent" name="park_ticket_epss_percent" min="0" max="100" step="1" value="{{ (park_thresholds.epss * 100)|round }}">
        </div>
      </div>
      <div class="form-hint mb-2">{{ __('A single open ticket per software, detailing its vulnerabilities and linked to the affected machines. At most %d tickets are created per run, most severe first. A followup is added when more machines are affected, when a vulnerability becomes actively exploited, or when no machine is vulnerable anymore. The ticket is never closed and its priority never changed automatically.', 'grcmanager')|format(max_tickets) }}</div>

      {# Issue #485 : rapport des vulnérabilités du parc par e-mail. #}
      <h5 class="mt-4"><i class="ti ti-mail-bolt me-1"></i>{{ __('Fleet vulnerability report by email', 'grcmanager') }}</h5>
      <p class="text-muted mb-2">{{ __('A regular email listing the vulnerabilities of the fleet that are exploited, likely to be exploited, critical or high. Its subject shows the urgency at a glance, for instance "[URGENT] 2 actively exploited vulnerabilities, 14 machines exposed".', 'grcmanager') }}</p>
      <div class="d-flex flex-wrap gap-3 mb-2">
        <div style="max-width: 260px;">
          <label class="form-label" for="park_digest_frequency">{{ __('Send the report', 'grcmanager') }}</label>
          <select class="form-select" id="park_digest_frequency" name="park_digest_frequency">
            {% for key, label in digest.frequencies %}<option value="{{ key }}" {{ key == digest.frequency ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div style="max-width: 260px;">
          <label class="form-label" for="park_digest_min_cvss">{{ __('Include vulnerabilities from CVSS', 'grcmanager') }}</label>
          <input type="number" class="form-control" id="park_digest_min_cvss" name="park_digest_min_cvss" min="0" max="10" step="0.1" value="{{ digest.min_cvss }}">
          <div class="form-hint">{{ __('7 = high and critical. Exploited vulnerabilities are always included.', 'grcmanager') }}</div>
        </div>
      </div>
      <ul class="list-unstyled small mb-2">
        <li><i class="ti ti-calendar-event me-1"></i>{{ __('Last report', 'grcmanager') }} :
          {% if digest.last %}
            {{ digest.last_date }} <span class="badge {{ {'urgent': 'bg-red-lt', 'high': 'bg-orange-lt', 'watch': 'bg-yellow-lt', 'ok': 'bg-green-lt'}[digest.last.urgency]|default('bg-secondary-lt') }}">{{ digest.urgencies[digest.last.urgency]|default(digest.last.urgency) }}</span>
          {% else %}
            {{ __('none yet', 'grcmanager') }}
          {% endif %}
        </li>
        {% if digest.next_date %}<li><i class="ti ti-calendar-time me-1"></i>{{ __('Next report', 'grcmanager') }} : {{ digest.next_date }}</li>{% endif %}
        <li><i class="ti ti-users me-1"></i>{{ __('Recipients: the CISO group, and anyone added to the notification who can read the vulnerabilities of the whole fleet.', 'grcmanager') }}
          {% if digest.notification_url %}<a href="{{ digest.notification_url }}">{{ __('Change the recipients or the text', 'grcmanager') }}</a>{% endif %}
        </li>
      </ul>
      {% for problem, active in {
        (__('The vulnerability watch (NVD enrichment) is disabled: no report is sent.', 'grcmanager')): not digest.watch_enabled,
        (__('Email notifications are disabled in GLPI (Setup > Notifications): the report cannot reach anyone.', 'grcmanager')): not digest.mail_enabled,
        (__('No CISO group is set (Audit team section above): add recipients to the notification, or the report will reach nobody.', 'grcmanager')): not digest.has_ciso_group,
        (__('The notification "GRC Manager - Fleet vulnerability report" is inactive.', 'grcmanager')): digest.notification_url and not digest.is_active,
      } %}
        {% if active %}<div class="alert alert-warning py-2 mb-2"><i class="ti ti-alert-triangle me-1"></i>{{ problem }}</div>{% endif %}
      {% endfor %}


      <div class="d-flex gap-2 mt-2">
        <button type="submit" name="update_nvd_config" class="btn btn-primary">{{ __('Enregistrer') }}</button>
        <button type="submit" name="send_vulnerability_digest" class="btn btn-outline-secondary" title="{{ __('Sends the report now to its recipients, whatever the frequency.', 'grcmanager') }}"><i class="ti ti-send me-1"></i>{{ __('Send the report now', 'grcmanager') }}</button>
      </div>
    </form>
  </div>
</div>

{# Sprint 2 : matrice probabilité x impact administrable (voir front/config.php,
   RiskMatrixConfig). Un seul écran pour l'instant (pas d'onglets comme le plugin jumeau
   glpi-vulnerability-manager, qui en a besoin pour 11 sous-écrans différents) : à réévaluer en
   onglets si un futur sprint ajoute d'autres réglages ici. #}
<div class="card">
  <div class="card-body">
    <h4>{{ __('Risk matrix', 'grcmanager') }}</h4>
    <p class="text-muted">
      {{ __('Automatically determines a risk\'s level (low/medium/high/critical) from its probability and impact. The default values below reproduce exactly the register\'s behaviour before this screen existed: no existing risk changes level until you edit the grid.', 'grcmanager') }}
    </p>

    <form method="post" action="{{ config('root_doc') }}/plugins/grcmanager/front/config.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      <div class="table-responsive">
        <table class="table table-bordered align-middle grcmanager-risk-matrix" style="max-width: 720px;">
          <thead>
            <tr>
              <th>{{ __('Probability', 'grcmanager') }} \ {{ __('Impact', 'grcmanager') }}</th>
              {% for impact_key, impact_label in risk_impacts %}<th>{{ impact_label }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for probability_key, probability_label in risk_probabilities %}
              <tr>
                <th>{{ probability_label }}</th>
                {% for impact_key, impact_label in risk_impacts %}
                  {% set current_level = risk_matrix[probability_key][impact_key]|default('medium') %}
                  <td class="grcmanager-matrix-cell grcmanager-level-{{ current_level }}">
                    <select name="matrix_{{ probability_key }}_{{ impact_key }}" class="form-select form-select-sm grcmanager-level-select" data-level="{{ current_level }}">
                      {% for level_key, level_label in risk_impacts %}
                        <option value="{{ level_key }}" {{ current_level == level_key ? 'selected' : '' }}>{{ level_label }}</option>
                      {% endfor %}
                    </select>
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="d-flex gap-2 mt-3">
        <button type="submit" name="update_risk_matrix" class="btn btn-primary">{{ __('Enregistrer') }}</button>
      </div>
    </form>
  </div>
</div>

{# Color-coded matrix cells (same low/medium/high/critical -> green/yellow/orange/red convention
   as GlpiPlugin\\Grcmanager\\Risk::riskLevelBadge(), inc/risk.class.php), so a non-technical admin sees
   at a glance which combinations are severe without reading every select's value. Updates live on
   change, not just on page load, so the visual stays true after an edit and before saving. #}
<style>
  .grcmanager-matrix-cell.grcmanager-level-low { background-color: var(--tblr-green-lt, #d4f4e2); }
  .grcmanager-matrix-cell.grcmanager-level-medium { background-color: var(--tblr-yellow-lt, #fdf3d8); }
  .grcmanager-matrix-cell.grcmanager-level-high { background-color: var(--tblr-orange-lt, #fde6d8); }
  .grcmanager-matrix-cell.grcmanager-level-critical { background-color: var(--tblr-red-lt, #fbd9d3); }
</style>
<script>
(function () {
    document.querySelectorAll('.grcmanager-level-select').forEach(function (select) {
        select.addEventListener('change', function () {
            var cell = select.closest('.grcmanager-matrix-cell');
            if (!cell) {
                return;
            }
            cell.classList.remove(
                'grcmanager-level-low',
                'grcmanager-level-medium',
                'grcmanager-level-high',
                'grcmanager-level-critical'
            );
            cell.classList.add('grcmanager-level-' + select.value);
        });
    });
})();
</script>
