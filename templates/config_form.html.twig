{# Issue #1036 : page de configuration en onglets. Les onglets (src/Config/Tab/*Tab.php) et les
   blocs (src/Config/Block/*Block.php, gabarits templates/config/blocks/) sont découverts par
   ConfigTabs : ajouter un réglage, c'est ajouter un fichier de bloc, sans toucher ce gabarit.
   Chaque bloc reçoit ses propres données, plus csrf_token, can_edit_config et can_edit_sensitive. #}
<ul class="nav nav-tabs mb-3" id="grc-config-tabs" role="tablist" data-current="{{ current }}" data-anchors="{{ anchors|json_encode }}">
  {% for tab in tabs %}
    <li class="nav-item" role="presentation">
      <a class="nav-link {{ tab.key == current ? 'active' }}" href="{{ tab.url }}" role="tab" aria-selected="{{ tab.key == current ? 'true' : 'false' }}">
        <i class="ti {{ tab.icon }} me-1"></i>{{ tab.label }}
      </a>
    </li>
  {% endfor %}
</ul>

<div role="tabpanel">
  {% for block in blocks %}
    {% include block.template with block.data %}
  {% endfor %}
</div>

{# Anciens liens config.php#<identifiant> (avant les onglets) : ouvre l'onglet du bloc visé. #}
<script>
(function () {
    var bar = document.getElementById('grc-config-tabs');
    var anchor = decodeURIComponent(window.location.hash.slice(1));
    if (!bar || anchor === '' || document.getElementById(anchor)) {
        return;
    }
    var map = JSON.parse(bar.dataset.anchors || '{}');
    if (Object.prototype.hasOwnProperty.call(map, anchor)) {
        window.location.replace(map[anchor] + '#' + encodeURIComponent(anchor));
    }
})();
</script>
