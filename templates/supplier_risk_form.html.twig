{# Risque fournisseur, A.5.19 à A.5.22 (issue #199 : formulaire passé de PHP à Twig) #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import '@grcmanager/_hint.html.twig' as hints %}

{% block form_fields %}
   {{ fields.textField('title', item.fields['title'], __('Title', 'grcmanager'), {'full_width': true}) }}
   {{ fields.dropdownField('Supplier', 'suppliers_id', item.fields['suppliers_id'], supplier_label, {
      'add_field_html': hints.hint(__('Required: this register is dedicated to supplier-related risks.', 'grcmanager')),
   }) }}
   {{ fields.dropdownArrayField('category', item.fields['category'] ?: 'third_party', categories, __('Category', 'grcmanager')) }}
   {{ fields.dropdownField('User', 'users_id', item.fields['users_id'], _x('owner', 'Owner', 'grcmanager'), {'right': 'all'}) }}
   {{ fields.dropdownArrayField('probability', item.fields['probability'] ?: 'possible', probabilities, __('Probability', 'grcmanager')) }}
   {{ fields.dropdownArrayField('impact', item.fields['impact'] ?: 'medium', impacts, __('Impact', 'grcmanager')) }}
   {% if not is_new %}
      {{ fields.htmlField('', risk_level_badge, __('Risk level', 'grcmanager')) }}
      {{ fields.htmlField('', item.fields['computed_score']|default('0')|e, _x('score', 'Score', 'grcmanager')) }}
   {% endif %}
   {{ fields.dropdownArrayField('treatment', item.fields['treatment'], treatments, __('Treatment', 'grcmanager')) }}
   {{ fields.dropdownArrayField('status', item.fields['status'] ?: 'identified', statuses, __('Status', 'grcmanager')) }}
   {{ fields.dateField('review_date', item.fields['review_date'], __('Review date', 'grcmanager')) }}
   {# Issue #127 : ticket ouvert par la tâche de rappel à l'échéance de la revue. #}
   {{ fields.htmlField('', review_ticket_url
      ? '<a href="' ~ review_ticket_url|e ~ '"><i class="ti ti-ticket me-1"></i>' ~ (__('Ticket #%d', 'grcmanager')|format(review_ticket_id))|e ~ '</a>'
      : '—', __('Reassessment ticket', 'grcmanager')) }}
   {{ fields.textareaField('description', item.fields['description'], __('Description', 'grcmanager'), {'full_width': true}) }}
   {{ fields.textareaField('justification', item.fields['justification'], __('Justification', 'grcmanager'), {'full_width': true}) }}
{% endblock %}
