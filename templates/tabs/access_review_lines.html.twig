{# Issue #126 : onglet « Comptes à revoir » d'une campagne de revue des accès #}
<div class="card mb-3">
   <div class="card-body d-flex flex-wrap align-items-center gap-3">
      {% if status == 'draft' %}
         <div class="flex-grow-1 text-muted">
            <i class="ti ti-info-circle me-1"></i>{{ __('Le lancement liste les comptes actifs de l\'entité avec leurs profils et groupes GLPI, désigne leur responsable (responsable hiérarchique, sinon responsable de groupe, sinon le pilote) et le prévient par notification.', 'grcmanager') }}
         </div>
         {% if can_manage %}
            <form method="post" action="{{ form_action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="id" value="{{ item.id }}">
               <button type="submit" name="launch" value="1" class="btn btn-primary"><i class="ti ti-player-play me-1"></i>{{ __('Lancer la campagne', 'grcmanager') }}</button>
            </form>
         {% endif %}
      {% else %}
         <div class="flex-grow-1">
            <div class="d-flex justify-content-between small mb-1">
               <span>{{ __('%1$d compte(s) revu(s) sur %2$d', 'grcmanager')|format(progress.done, progress.total) }}</span>
               <span>{{ progress.percent }} %</span>
            </div>
            <div class="progress progress-sm"><div class="progress-bar {{ progress.percent == 100 ? 'bg-green' : 'bg-blue' }}" style="width: {{ progress.percent }}%"></div></div>
            {% if late %}
               <span class="badge bg-red-lt mt-2"><i class="ti ti-alarm me-1"></i>{{ __('Échéance dépassée : les responsables en retard sont relancés chaque semaine.', 'grcmanager') }}</span>
            {% endif %}
         </div>
         <a class="btn btn-outline-secondary" href="{{ mine_url }}"><i class="ti ti-list-check me-1"></i>{{ __('Mes revues d\'accès', 'grcmanager') }}</a>
         {% if report_url %}
            <a class="btn btn-outline-primary" href="{{ report_url }}"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Rapport PDF', 'grcmanager') }}</a>
         {% endif %}
         {% if can_manage %}
            <form method="post" action="{{ form_action }}">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="id" value="{{ item.id }}">
               {% if status == 'open' %}
                  <button type="submit" name="close" value="1" class="btn btn-success"
                     onclick="return confirm('{{ __('Clôturer la campagne ? Les comptes non revus resteront « Non revu » dans le rapport.', 'grcmanager')|e('js') }}');">
                     <i class="ti ti-lock-check me-1"></i>{{ __('Clôturer et archiver le rapport', 'grcmanager') }}
                  </button>
               {% else %}
                  <button type="submit" name="prepare_next" value="1" class="btn btn-outline-primary"><i class="ti ti-calendar-plus me-1"></i>{{ __('Préparer la campagne suivante', 'grcmanager') }}</button>
               {% endif %}
            </form>
         {% endif %}
      {% endif %}
   </div>
</div>

{% if lines is not empty %}
   <div class="card">
      <div class="card-body">
         <form method="post" action="{{ decide_url }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            {{ include('@grcmanager/tabs/_access_review_rows.html.twig', {show_reviewer: true}) }}
            {% if can_decide %}
               <button type="submit" name="save_decisions" value="1" class="btn btn-primary mt-3"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer les décisions', 'grcmanager') }}</button>
            {% endif %}
         </form>
      </div>
   </div>
{% endif %}
