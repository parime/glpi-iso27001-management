{# Issue #128 : onglet « Tickets liés » de l'incident de sécurité (GlpiPlugin\\Grcmanager\\SecurityIncidentTicket) #}
<div class="card">
   <div class="card-body">
      {% if rows is empty %}
         <p class="text-muted mb-0"><i class="ti ti-ticket me-1"></i>{{ __('No ticket has been qualified as this incident. From a ticket, the “Security incident” tab does it.', 'grcmanager') }}</p>
      {% else %}
         <table class="table table-sm table-vcenter mb-0">
            <thead><tr><th>{{ __('Ticket') }}</th><th>{{ __('Statut') }}</th></tr></thead>
            <tbody>
               {% for r in rows %}
                  <tr>
                     <td><a href="{{ r.url }}"><i class="ti ti-ticket me-1"></i>{{ r.name }} ({{ r.id }})</a></td>
                     <td>{{ r.status }}</td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>
      {% endif %}
   </div>
</div>
