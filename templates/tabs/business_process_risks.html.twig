{# Issue #377 : risques du registre liés à un processus métier, voir
   GlpiPlugin\\Grcmanager\\BusinessProcessRisk::displayTabContentForItem(). #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% if can_edit %}
<form method="post" action="{{ form_url }}" class="card card-body mb-3">
  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
  <input type="hidden" name="plugin_grcmanager_businessprocesses_id" value="{{ item.getID() }}">
  <div class="row g-2 align-items-end">
    <div class="col-md-7">
      {{ fields.dropdownArrayField('plugin_grcmanager_risks_id', 0, choices, __('Risk', 'grcmanager'), {
         'is_horizontal': false,
         'full_width': true,
      }) }}
    </div>
    <div class="col-md-3">
      <label class="form-label" for="grc-process-risk-comment">{{ __('Comment', 'grcmanager') }}</label>
      <input type="text" id="grc-process-risk-comment" name="comment" class="form-control" maxlength="255">
    </div>
    <div class="col-md-2">
      <button type="submit" name="add" value="1" class="btn btn-primary w-100"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
    </div>
  </div>
</form>
{% endif %}

<p class="text-muted">{{ __('Risks of the register that threaten the continuity of this process. A risk can also be proposed from the Dependencies tab for an item that does not meet the objectives.', 'grcmanager') }}</p>
{% if risks is empty %}
  <p class="text-muted">{{ __('No risk linked to this process.', 'grcmanager') }}</p>
{% else %}
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">{{ __('Title', 'grcmanager') }}</th>
          <th scope="col">{{ __('Risk level', 'grcmanager') }}</th>
          <th scope="col">{{ __('Treatment', 'grcmanager') }}</th>
          <th scope="col">{{ __('Status', 'grcmanager') }}</th>
          <th scope="col">{{ __('Comment', 'grcmanager') }}</th>
          {% if can_edit %}<th scope="col"><span class="visually-hidden">{{ __('Actions', 'grcmanager') }}</span></th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for risk in risks %}
          <tr>
            <td><a href="{{ risk.url }}">{{ risk.title }}</a></td>
            <td>{{ risk.level }}</td>
            <td>{{ risk.treatment }}</td>
            <td>{{ risk.status }}</td>
            <td>{{ risk.comment }}</td>
            {% if can_edit %}
              <td>
                <form method="post" action="{{ form_url }}">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <input type="hidden" name="id" value="{{ risk.link_id }}">
                  <button type="submit" name="purge" value="1" class="btn btn-sm btn-ghost-danger"
                          title="{{ __('Remove', 'grcmanager') }}" aria-label="{{ __('Remove', 'grcmanager') }}"
                          onclick="return confirm('{{ __('Remove this link?', 'grcmanager')|e('js') }}');"><i class="ti ti-trash"></i></button>
                </form>
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
