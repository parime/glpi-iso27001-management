{# Issue #375 : analyse d'impact (AIPD, RGPD article 35) d'une fiche du registre des traitements. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set fk = 'plugin_grcmanager_processingactivities_id' %}
{% set level_classes = {'none': 'bg-secondary-lt', 'low': 'bg-green-lt', 'medium': 'bg-yellow-lt', 'high': 'bg-red-lt'} %}
{% set editable = can_edit and not is_approved %}
{% set off = editable ? '' : 'disabled' %}
{% set scale_titles = {
  'severity': __('Seriousness', 'grcmanager'),
  'likelihood': __('Likelihood', 'grcmanager'),
  'residual_severity': __('Severity after measures', 'grcmanager'),
  'residual_likelihood': __('Likelihood after measures', 'grcmanager'),
} %}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  {% if is_approved %}
    <span class="badge bg-green-lt fs-5"><i class="ti ti-circle-check me-1"></i>{{ __('Approved', 'grcmanager') }}</span>
    <span class="text-muted">{{ approval_name }}{{ dpia.date_approval ? ' - ' ~ dpia.date_approval : '' }}</span>
  {% else %}
    <span class="badge bg-yellow-lt fs-5"><i class="ti ti-pencil me-1"></i>{{ __('Draft', 'grcmanager') }}</span>
  {% endif %}
  <span class="badge bg-secondary-lt fs-5">{{ __('On the record', 'grcmanager') }} : {{ record_status_label }}</span>
  {% if exists %}
    <a href="{{ report_url }}" class="btn btn-sm btn-outline-secondary ms-auto"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Report (PDF)', 'grcmanager') }}</a>
  {% endif %}
</div>

{% if needs_consultation %}
  <div class="alert alert-danger">
    <i class="ti ti-alert-octagon me-1"></i>{{ __('A residual risk remains high: article 36 of the GDPR requires consulting the supervisory authority (CNIL in France) before starting the processing.', 'grcmanager') }}
  </div>
{% endif %}

{% if exists and suggested_status and can_edit %}
  <form method="post" action="{{ form_url }}" class="alert alert-info d-flex flex-wrap align-items-center gap-2">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="{{ fk }}" value="{{ activity.getID() }}">
    <span><i class="ti ti-info-circle me-1"></i>{{ __('The record of this processing could be updated: %s.', 'grcmanager')|format(suggested_status) }}</span>
    <button type="submit" name="apply_record_status" class="btn btn-sm btn-outline-primary ms-auto">{{ __('Update the record', 'grcmanager') }}</button>
  </form>
{% endif %}

<form method="post" action="{{ form_url }}">
  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
  <input type="hidden" name="{{ fk }}" value="{{ activity.getID() }}">

  <h3><i class="ti ti-list-check me-1"></i>{{ __('Is a DPIA needed?', 'grcmanager') }}</h3>
  <p class="text-muted">{{ __('European guidelines (WP248) list nine criteria. From two criteria met, a DPIA is required in principle. The final decision remains yours, after the opinion of the DPO.', 'grcmanager') }}</p>
  <div class="row mb-2">
    {% for key, label in criteria_labels %}
      <div class="col-md-6">
        <label class="form-check">
          <input class="form-check-input" type="checkbox" name="criteria[]" value="{{ key }}" {{ key in criteria ? 'checked' : '' }} {{ off }}>
          <span class="form-check-label">{{ label }}</span>
        </label>
      </div>
    {% endfor %}
  </div>
  <p>
    <span class="badge {{ is_required ? 'bg-red-lt' : 'bg-green-lt' }}">{{ __('Criteria met', 'grcmanager') }} : {{ criteria_count }}/{{ criteria_labels|length }}</span>
    <span class="ms-1">{{ is_required ? __('A DPIA is required in principle.', 'grcmanager') : __('Below the threshold: a DPIA is not required in principle.', 'grcmanager') }}</span>
  </p>

  <h3 class="mt-4"><i class="ti ti-file-description me-1"></i>{{ __('Description and proportionality', 'grcmanager') }}</h3>
  <div class="mb-3">
    <label class="form-label" for="grc-dpia-description">{{ __('Description of the processing', 'grcmanager') }}</label>
    <textarea id="grc-dpia-description" name="description" class="form-control" rows="2" {{ off }} placeholder="{{ __('What the record does not say: how data flows, who accesses it, in which tools', 'grcmanager') }}">{{ dpia.description|default('') }}</textarea>
  </div>
  <div class="mb-3">
    <label class="form-label" for="grc-dpia-necessity">{{ __('Necessity and proportionality', 'grcmanager') }}</label>
    <textarea id="grc-dpia-necessity" name="necessity" class="form-control" rows="3" {{ off }} placeholder="{{ __('Why this data, why this duration, could the same goal be reached with less?', 'grcmanager') }}">{{ dpia.necessity|default('') }}</textarea>
  </div>

  <h3 class="mt-4"><i class="ti ti-shield-exclamation me-1"></i>{{ __('Risks for the people concerned', 'grcmanager') }}</h3>
  <p class="text-muted">{{ __('Rate each risk from the point of view of the people concerned, not of the organisation, before and after the planned measures.', 'grcmanager') }}</p>
  <div class="table-responsive mb-3">
    <table class="table table-sm table-vcenter card-table">
      <thead>
        <tr>
          <th>{{ __('Risk', 'grcmanager') }}</th>
          {% for scale in scales %}<th>{{ scale_titles[scale] }}</th>{% endfor %}
          <th>{{ __('Level', 'grcmanager') }}</th>
          <th>{{ __('Residual level', 'grcmanager') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for risk in risks %}
          <tr>
            <td class="fw-bold">{{ risk.label }}</td>
            {% for scale in scales %}
              <td>
                <select name="risks[{{ risk.key }}][{{ scale }}]" class="form-select form-select-sm" aria-label="{{ risk.label }} - {{ scale_titles[scale] }}" {{ off }}>
                  <option value="0">{{ constant('Dropdown::EMPTY_VALUE') }}</option>
                  {% for value, label in scale_labels %}<option value="{{ value }}" {{ value == risk[scale] ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
                </select>
              </td>
            {% endfor %}
            <td><span class="badge {{ level_classes[risk.level] }}">{{ level_labels[risk.level] }}</span></td>
            <td><span class="badge {{ level_classes[risk.residual_level] }}">{{ level_labels[risk.residual_level] }}</span></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="mb-3">
    <label class="form-label" for="grc-dpia-measures">{{ __('Planned measures', 'grcmanager') }}</label>
    <textarea id="grc-dpia-measures" name="measures" class="form-control" rows="3" {{ off }} placeholder="{{ __('Encryption, access limited to..., shorter retention, information of the people...', 'grcmanager') }}">{{ dpia.measures|default('') }}</textarea>
  </div>

  <h3 class="mt-4"><i class="ti ti-gavel me-1"></i>{{ __('Opinions', 'grcmanager') }}</h3>
  <div class="row g-2">
    <div class="col-md-4">
      {{ fields.dropdownField('User', 'users_id_dpo', dpia.users_id_dpo|default(0), __('DPO', 'grcmanager'), {
         'right': 'all',
         'full_width': true,
         'is_horizontal': false,
         'disabled': not editable,
      }) }}
    </div>
    <div class="col-md-8">
      <label class="form-label" for="grc-dpia-opinion">{{ __('Opinion of the DPO', 'grcmanager') }}</label>
      <textarea id="grc-dpia-opinion" name="dpo_opinion" class="form-control" rows="3" {{ off }}>{{ dpia.dpo_opinion|default('') }}</textarea>
      {% if dpia.date_dpo_opinion|default('') %}<div class="form-hint">{{ dpia.date_dpo_opinion }}</div>{% endif %}
    </div>
    <div class="col-12">
      <label class="form-label" for="grc-dpia-views">{{ __('Views of the people concerned', 'grcmanager') }}</label>
      <textarea id="grc-dpia-views" name="data_subjects_views" class="form-control" rows="2" {{ off }} placeholder="{{ __('Consultation carried out, or why it was not appropriate', 'grcmanager') }}">{{ dpia.data_subjects_views|default('') }}</textarea>
    </div>
  </div>

  {% if editable %}
    <div class="text-end mt-3">
      <button type="submit" name="save" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
    </div>
  {% endif %}
</form>

{% if can_edit and exists %}
  <hr>
  <h3><i class="ti ti-circle-check me-1"></i>{{ __('Approval by the data controller', 'grcmanager') }}</h3>
  {% if not is_approved and missing is not empty %}
    <p class="text-muted"><i class="ti ti-info-circle me-1"></i>{{ __('Still missing before approval:', 'grcmanager') }} {{ missing|join(', ') }}</p>
  {% endif %}
  <form method="post" action="{{ form_url }}" class="d-inline" onsubmit="return confirm('{{ (is_approved ? __('Reopen this DPIA? The approval will be withdrawn.', 'grcmanager') : __('Approve this DPIA? It can no longer be changed unless it is reopened.', 'grcmanager'))|e('js') }}');">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="{{ fk }}" value="{{ activity.getID() }}">
    {% if is_approved %}
      <button type="submit" name="reopen" class="btn btn-outline-warning"><i class="ti ti-lock-open me-1"></i>{{ __('Reopen', 'grcmanager') }}</button>
    {% else %}
      <button type="submit" name="approve" class="btn btn-success" {{ missing is empty ? '' : 'disabled' }}><i class="ti ti-circle-check me-1"></i>{{ __('Approve', 'grcmanager') }}</button>
    {% endif %}
  </form>
{% endif %}

{% if risk %}
  <p class="mt-3">
    <i class="ti ti-shield-exclamation me-1"></i>{{ __('Risk register', 'grcmanager') }} :
    <a href="{{ risk.url }}">{{ risk.title }}</a>
  </p>
{% elseif can_send_to_register %}
  <form method="post" action="{{ form_url }}" class="mt-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="{{ fk }}" value="{{ activity.getID() }}">
    <button type="submit" name="send_to_register" class="btn btn-outline-primary"><i class="ti ti-shield-plus me-1"></i>{{ __('Add the highest residual risk to the register', 'grcmanager') }}</button>
  </form>
{% endif %}
