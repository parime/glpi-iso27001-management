{# Issue #376, atelier 3 : parties prenantes, cartographie de la menace, scénarios stratégiques. #}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set fk = 'plugin_grcmanager_ebiosstudies_id' %}
{% set severity_classes = {1: 'bg-green-lt', 2: 'bg-yellow-lt', 3: 'bg-orange-lt', 4: 'bg-red-lt'} %}
{% set zones = {
  'danger': ['bg-red-lt', 'ti-alert-octagon', __('Danger zone', 'grcmanager'), __('Act first: reduce the dependence or demand stronger guarantees.', 'grcmanager')],
  'control': ['bg-yellow-lt', 'ti-eye-check', __('Control zone', 'grcmanager'), __('Check their security measures regularly.', 'grcmanager')],
  'watch': ['bg-green-lt', 'ti-eye', __('Watch zone', 'grcmanager'), __('Keep an eye on them, no specific action needed.', 'grcmanager')],
} %}
{% set scales = {
  'dependence': [__('Dependence', 'grcmanager'), __('How much you rely on them to operate', 'grcmanager')],
  'penetration': [__('Penetration', 'grcmanager'), __('How far they can access your systems and data', 'grcmanager')],
  'maturity': [__('Cyber maturity', 'grcmanager'), __('How well they protect themselves', 'grcmanager')],
  'trust': [__('Trust', 'grcmanager'), __('How much you trust their intentions and interests', 'grcmanager')],
} %}

<p class="text-muted">{{ __('Attackers often go through a supplier or a partner. Rate your stakeholders to see which ones are the most exposed, then describe how each retained risk source could reach a feared event.', 'grcmanager') }}</p>

<h3><i class="ti ti-topology-star-3 me-1"></i>{{ __('Stakeholders of the ecosystem', 'grcmanager') }}</h3>

{% if can_edit %}
<form method="post" action="{{ form_url }}" class="card card-body mb-3">
  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
  <input type="hidden" name="element" value="stakeholder">
  <input type="hidden" name="{{ fk }}" value="{{ item.getID() }}">
  <div class="row g-2 align-items-end">
    <div class="col-md-5">
      <label class="form-label" for="grc-ebios-stakeholder">{{ __('New stakeholder', 'grcmanager') }}</label>
      <input type="text" id="grc-ebios-stakeholder" name="name" class="form-control" maxlength="255" placeholder="{{ __('e.g. Hosting provider (or choose a GLPI supplier)', 'grcmanager') }}">
    </div>
    <div class="col-md-4">
      {{ fields.dropdownField('Supplier', 'suppliers_id', 0, __('GLPI supplier', 'grcmanager'), {
         'full_width': true,
         'is_horizontal': false,
         'mb': '',
      }) }}
    </div>
    <div class="col-md-3">
      <label class="form-label" for="grc-ebios-category">{{ __('Category') }}</label>
      <select id="grc-ebios-category" name="category" class="form-select">
        {% for key, label in categories %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
      </select>
    </div>
  </div>
  <div class="row g-2 mt-1">
    {% for scale, texts in scales %}
      <div class="col-md-3">
        <label class="form-label" for="grc-ebios-{{ scale }}">{{ texts[0] }}</label>
        <select id="grc-ebios-{{ scale }}" name="{{ scale }}" class="form-select">
          {% for level, text in levels %}<option value="{{ level }}" {{ level == 2 ? 'selected' : '' }}>{{ text }}</option>{% endfor %}
        </select>
        <div class="form-hint">{{ texts[1] }}</div>
      </div>
    {% endfor %}
    <div class="col-12 text-end">
      <button type="submit" name="add" class="btn btn-primary"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
    </div>
  </div>
</form>
{% endif %}

{% if stakeholders is empty %}
  <div class="empty">
    <div class="empty-icon"><i class="ti ti-topology-star-3 fs-1"></i></div>
    <p class="empty-title">{{ __('No stakeholder yet', 'grcmanager') }}</p>
    <p class="empty-subtitle text-muted">{{ __('Think of your hosting provider, software vendors, IT service companies, key partners...', 'grcmanager') }}</p>
  </div>
{% else %}
  <p class="small text-muted mb-2"><i class="ti ti-math-function me-1"></i>{{ __('Threat level = (dependence x penetration) / (maturity x trust).', 'grcmanager') }}</p>
  <div class="row g-2 mb-3">
    {% for zone, meta in zones %}
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-header py-2"><span class="badge {{ meta[0] }}"><i class="ti {{ meta[1] }} me-1"></i>{{ meta[2] }}</span></div>
          <div class="card-body py-2">
            <p class="small text-muted mb-1">{{ meta[3] }}</p>
            {% for s in stakeholders|filter(s => s.zone == zone) %}
              <div class="d-flex justify-content-between"><span>{{ s.name }}</span><span class="fw-bold">{{ s.threat_label }}</span></div>
            {% else %}
              <span class="text-muted small">-</span>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="table-responsive mb-4">
    <table class="table table-sm table-vcenter card-table">
      <thead>
        <tr>
          <th>{{ __('Stakeholder', 'grcmanager') }}</th>
          <th>{{ __('Category') }}</th>
          {% for scale, texts in scales %}<th title="{{ texts[1] }}">{{ texts[0] }}</th>{% endfor %}
          <th>{{ __('Threat', 'grcmanager') }}</th>
          {% if can_edit %}<th></th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for s in stakeholders %}
          {% set update_form = 'grc-ebios-stakeholder-' ~ s.id %}
          <tr>
            <td class="fw-bold">
              {% if s.supplier_url %}<a href="{{ s.supplier_url }}"><i class="ti ti-link me-1"></i>{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}
            </td>
            <td>{{ categories[s.category]|default(s.category) }}</td>
            {% for scale, texts in scales %}
              <td>
                {% if can_edit %}
                  <select name="{{ scale }}" form="{{ update_form }}" class="form-select form-select-sm" aria-label="{{ texts[0] }}">
                    {% for level, text in levels %}<option value="{{ level }}" {{ level == s[scale] ? 'selected' : '' }}>{{ text }}</option>{% endfor %}
                  </select>
                {% else %}
                  {{ levels[s[scale]]|default(s[scale]) }}
                {% endif %}
              </td>
            {% endfor %}
            <td><span class="badge {{ zones[s.zone][0] }}">{{ s.threat_label }}</span></td>
            {% if can_edit %}
              <td class="text-nowrap">
                <form method="post" action="{{ form_url }}" id="{{ update_form }}" class="d-inline">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <input type="hidden" name="element" value="stakeholder">
                  <input type="hidden" name="id" value="{{ s.id }}">
                  <button type="submit" name="update" class="btn btn-sm btn-outline-primary" title="{{ __('Save') }}" aria-label="{{ __('Save') }}"><i class="ti ti-device-floppy"></i></button>
                </form>
                <form method="post" action="{{ form_url }}" class="d-inline" onsubmit="return confirm('{{ __('Remove this stakeholder and the scenarios that go through it?', 'grcmanager')|e('js') }}');">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <input type="hidden" name="element" value="stakeholder">
                  <input type="hidden" name="id" value="{{ s.id }}">
                  <button type="submit" name="purge" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}" aria-label="{{ __('Remove', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
                </form>
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}

<h3><i class="ti ti-route me-1"></i>{{ __('Strategic scenarios', 'grcmanager') }}</h3>

{% if sources is empty or events is empty %}
  <div class="alert alert-info">
    <i class="ti ti-info-circle me-1"></i>{{ __('A strategic scenario links a retained risk source to a feared event: fill in workshops 1 and 2 first.', 'grcmanager') }}
  </div>
{% elseif can_edit %}
<form method="post" action="{{ form_url }}" class="card card-body mb-3">
  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
  <input type="hidden" name="element" value="strategic">
  <input type="hidden" name="{{ fk }}" value="{{ item.getID() }}">
  <div class="row g-2 align-items-end">
    <div class="col-12">
      <label class="form-label" for="grc-ebios-strategic">{{ __('New strategic scenario', 'grcmanager') }}</label>
      <input type="text" id="grc-ebios-strategic" name="name" class="form-control" maxlength="255" required placeholder="{{ __('e.g. Ransom demand after compromising the hosting provider', 'grcmanager') }}">
    </div>
    <div class="col-md-4">
      <label class="form-label" for="grc-ebios-strategic-source">{{ __('Risk source', 'grcmanager') }}</label>
      <select id="grc-ebios-strategic-source" name="plugin_grcmanager_ebiosrisksources_id" class="form-select" required>
        {% for source in sources %}<option value="{{ source.id }}">{{ source.name }}{{ source.objective ? ' : ' ~ source.objective : '' }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label" for="grc-ebios-strategic-event">{{ __('Feared event', 'grcmanager') }}</label>
      <select id="grc-ebios-strategic-event" name="plugin_grcmanager_ebiosfearedevents_id" class="form-select" required>
        {% for event in events %}<option value="{{ event.id }}">{{ event.name }} ({{ severities[event.severity]|default(event.severity) }})</option>{% endfor %}
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label" for="grc-ebios-strategic-through">{{ __('Attack path', 'grcmanager') }}</label>
      <select id="grc-ebios-strategic-through" name="plugin_grcmanager_ebiosstakeholders_id" class="form-select">
        <option value="0">{{ __('Direct attack', 'grcmanager') }}</option>
        {% for s in stakeholders %}<option value="{{ s.id }}">{{ __('Through: %s', 'grcmanager')|format(s.name) }}</option>{% endfor %}
      </select>
    </div>
    <div class="col-md-10">
      <label class="form-label" for="grc-ebios-strategic-measures">{{ __('Measures planned on this path', 'grcmanager') }}</label>
      <input type="text" id="grc-ebios-strategic-measures" name="measures" class="form-control" placeholder="{{ __('e.g. Security clause, annual audit of the provider', 'grcmanager') }}">
    </div>
    <div class="col-md-2">
      <button type="submit" name="add" class="btn btn-primary w-100"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
    </div>
  </div>
</form>
{% endif %}

{% if scenarios is empty %}
  <p class="text-muted">{{ __('No strategic scenario yet.', 'grcmanager') }}</p>
{% else %}
<div class="table-responsive">
  <table class="table table-sm table-vcenter card-table">
    <thead>
      <tr>
        <th>{{ __('Scenario', 'grcmanager') }}</th>
        <th>{{ __('Risk source', 'grcmanager') }}</th>
        <th>{{ __('Attack path', 'grcmanager') }}</th>
        <th>{{ __('Feared event', 'grcmanager') }}</th>
        <th>{{ __('Measures planned on this path', 'grcmanager') }}</th>
        {% if can_edit %}<th></th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for scenario in scenarios %}
        <tr>
          <td class="fw-bold">{{ scenario.name }}</td>
          <td>
            {{ scenario.source_name }}
            {% if not scenario.source_retained %}<span class="badge bg-secondary-lt">{{ __('Set aside', 'grcmanager') }}</span>{% endif %}
            {% if scenario.source_objective %}<div class="small text-muted">{{ scenario.source_objective }}</div>{% endif %}
          </td>
          <td>{{ scenario.stakeholder_name ?: __('Direct attack', 'grcmanager') }}</td>
          <td>
            {{ scenario.event_name }}
            <span class="badge {{ severity_classes[scenario.severity]|default('bg-secondary-lt') }}">{{ severities[scenario.severity]|default(scenario.severity) }}</span>
          </td>
          <td style="min-width: 16rem">
            {% if can_edit %}
              <form method="post" action="{{ form_url }}" class="d-flex gap-1 align-items-center">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="element" value="strategic">
                <input type="hidden" name="id" value="{{ scenario.id }}">
                <input type="text" name="measures" value="{{ scenario.measures }}" class="form-control form-control-sm" aria-label="{{ __('Measures planned on this path', 'grcmanager') }}">
                <button type="submit" name="update" class="btn btn-sm btn-outline-primary" title="{{ __('Save') }}" aria-label="{{ __('Save') }}"><i class="ti ti-device-floppy"></i></button>
              </form>
            {% else %}
              {{ scenario.measures }}
            {% endif %}
          </td>
          {% if can_edit %}
            <td>
              <form method="post" action="{{ form_url }}" onsubmit="return confirm('{{ __('Remove this strategic scenario and its operational scenarios?', 'grcmanager')|e('js') }}');">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="element" value="strategic">
                <input type="hidden" name="id" value="{{ scenario.id }}">
                <button type="submit" name="purge" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}" aria-label="{{ __('Remove', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
              </form>
            </td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
