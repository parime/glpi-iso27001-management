{# Issue #377 : processus métier qui dépendent de cet élément, voir
   GlpiPlugin\\Grcmanager\\BusinessProcessItem::displayTabContentForItem().
   Issue #733 : historique des tests de reprise qui ont couvert l'élément. #}
{% if processes is empty %}
  <p class="text-muted">{{ __('No business process you can see depends on this item.', 'grcmanager') }}</p>
{% else %}
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">{{ _n('Business process', 'Business processes', 1, 'grcmanager') }}</th>
          <th scope="col">{{ __('Role', 'grcmanager') }}</th>
          <th scope="col">{{ __('MTPD', 'grcmanager') }}</th>
          <th scope="col">RTO</th>
        </tr>
      </thead>
      <tbody>
        {% for process in processes %}
          <tr>
            <td><a href="{{ process.url }}">{{ process.name }}</a></td>
            <td>{{ process.comment }}</td>
            <td>{{ process.mtpd }}</td>
            <td>{{ process.rto }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}

<h3 class="mt-4"><i class="ti ti-lifebuoy me-1"></i>{{ __('Recovery tests that covered this item', 'grcmanager') }}</h3>
<p class="text-muted">{{ __('Tests that named this item, and tests of the business processes that depend on it. Record a test from the "Recovery strategy" tab of the process.', 'grcmanager') }}</p>
{% if tests is empty %}
  <p class="text-muted">{{ __('No recovery test has covered this item yet.', 'grcmanager') }}</p>
{% else %}
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">{{ __('Date') }}</th>
          <th scope="col">{{ _n('Business process', 'Business processes', 1, 'grcmanager') }}</th>
          <th scope="col">{{ __('Type of exercise', 'grcmanager') }}</th>
          <th scope="col">{{ __('Measured time', 'grcmanager') }}</th>
          <th scope="col">{{ __('Measured data loss', 'grcmanager') }}</th>
          <th scope="col">{{ __('Result', 'grcmanager') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for test in tests %}
          <tr>
            <td>{{ test.date }}</td>
            <td>
              <a href="{{ test.url }}">{{ test.process }}</a>
              {% if test.direct %}<span class="badge bg-info-subtle text-info-emphasis ms-1"><i class="ti ti-target me-1"></i>{{ __('This item was tested', 'grcmanager') }}</span>{% endif %}
              {% if test.exercise %}<div class="small text-muted">{{ test.exercise }}</div>{% endif %}
            </td>
            <td>{{ test.type ?: '-' }}</td>
            <td>{{ test.duration }} <span class="small text-muted">(RTO {{ test.rto ?: '-' }})</span></td>
            <td>{% if test.rpo_minutes is null %}<span class="text-muted">-</span>{% else %}{{ test.rpo_duration }}{% endif %} <span class="small text-muted">(RPO {{ test.rpo ?: '-' }})</span></td>
            <td><span class="badge {{ result_labels[test.result][0] }}"><i class="ti {{ result_labels[test.result][1] }} me-1"></i>{{ result_labels[test.result][2] }}</span></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if tests|length >= max_tests %}
    <p class="text-muted small">{{ __('Only the %d most recent tests are listed.', 'grcmanager')|format(max_tests) }}</p>
  {% endif %}
{% endif %}
