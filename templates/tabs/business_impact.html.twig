{# Issue #377 : analyse d'impact sur l'activité (BIA) d'un processus, voir
   GlpiPlugin\\Grcmanager\\BusinessImpact::displayTabContentForItem(). #}

<div class="d-flex justify-content-end mb-2">
  <a href="{{ report_url }}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Continuity plan of this process (PDF)', 'grcmanager') }}</a>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-4">
    <div class="card card-body">
      <div class="text-muted small">{{ __('MTPD', 'grcmanager') }}</div>
      <div class="fs-3">{{ durations[item.fields['mtpd_hours']] ?? __('Not set', 'grcmanager') }}</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-body">
      <div class="text-muted small">RTO / RPO</div>
      <div class="fs-3">{{ durations[item.fields['rto_hours']] ?? __('Not set', 'grcmanager') }} / {{ durations[item.fields['rpo_hours']] ?? __('Not set', 'grcmanager') }}</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-body">
      <div class="text-muted small">{{ __('Impact becomes serious after', 'grcmanager') }}</div>
      <div class="fs-3">{{ analysis.first_unacceptable > 0 ? durations[analysis.first_unacceptable] : __('Never, according to the analysis', 'grcmanager') }}</div>
    </div>
  </div>
</div>

{% if analysis.issues is not empty %}
  <div class="alert alert-warning" role="alert">
    <ul class="mb-0">
      {% for code in analysis.issues %}<li>{{ issues[code] ?? code }}</li>{% endfor %}
    </ul>
  </div>
{% else %}
  <div class="alert alert-success" role="status">{{ __('The objectives of the process are consistent with its impact analysis.', 'grcmanager') }}</div>
{% endif %}

<p class="text-muted">{{ __('Rate the impact of an interruption of the process for each duration, from negligible to critical. The MTPD must not exceed the first duration rated serious, and the RTO must not exceed the MTPD.', 'grcmanager') }}</p>

{% set grid_table %}
  <div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
      <thead>
        <tr>
          <th scope="col">{{ __('Impact', 'grcmanager') }}</th>
          {% for horizon in horizons %}<th scope="col">{{ durations[horizon] }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for category, category_label in categories %}
          <tr>
            <th scope="row">{{ category_label }}</th>
            {% for horizon in horizons %}
              {% set level = analysis.grid[horizon][category] %}
              <td>
                {% if can_edit %}
                  <select name="levels[{{ horizon }}][{{ category }}]" class="form-select form-select-sm"
                          aria-label="{{ category_label }}, {{ durations[horizon] }}">
                    {% for value, label in levels %}<option value="{{ value }}" {{ value == level ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
                  </select>
                {% else %}
                  <span class="badge {{ level_classes[level] }}">{{ levels[level] }}</span>
                {% endif %}
              </td>
            {% endfor %}
          </tr>
        {% endfor %}
        <tr>
          <th scope="row">{{ __('Worst impact', 'grcmanager') }}</th>
          {% for horizon in horizons %}
            {% set worst = analysis.worst[horizon] %}
            <td><span class="badge {{ level_classes[worst] }}">{{ levels[worst] }}</span></td>
          {% endfor %}
        </tr>
      </tbody>
    </table>
  </div>
{% endset %}

{% if can_edit %}
  <form method="post" action="{{ form_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="plugin_grcmanager_businessprocesses_id" value="{{ item.getID() }}">
    {{ grid_table }}
    <button type="submit" name="save" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
  </form>
{% else %}
  {{ grid_table }}
{% endif %}
