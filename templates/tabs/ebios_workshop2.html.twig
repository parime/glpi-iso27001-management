{# Issue #376, atelier 2 : couples source de risque / objectif visé. #}
{% set fk = 'plugin_grcmanager_ebiosstudies_id' %}
{% set relevance = {
  'low': ['bg-green-lt', __('Low relevance', 'grcmanager')],
  'medium': ['bg-yellow-lt', __('Medium relevance', 'grcmanager')],
  'high': ['bg-red-lt', __('High relevance', 'grcmanager')],
} %}

<p class="text-muted">{{ __('Who could attack you, and to achieve what? Rate each pair, then keep the ones the study will follow: the computed relevance is only a suggestion.', 'grcmanager') }}</p>

{% if can_edit %}
<form method="post" action="{{ form_url }}" class="card card-body mb-3">
  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
  <input type="hidden" name="element" value="risk_source">
  <input type="hidden" name="{{ fk }}" value="{{ item.getID() }}">
  <div class="row g-2 align-items-end">
    <div class="col-md-6">
      <label class="form-label" for="grc-ebios-source">{{ __('Risk source', 'grcmanager') }}</label>
      <input type="text" id="grc-ebios-source" name="name" class="form-control" maxlength="255" required placeholder="{{ __('e.g. Organised crime', 'grcmanager') }}">
    </div>
    <div class="col-md-6">
      <label class="form-label" for="grc-ebios-objective">{{ __('Target objective', 'grcmanager') }}</label>
      <input type="text" id="grc-ebios-objective" name="objective" class="form-control" maxlength="255" placeholder="{{ __('e.g. Financial gain through ransom', 'grcmanager') }}">
    </div>
    {% for scale, label in {'motivation': __('Motivation', 'grcmanager'), 'resources': __('Resources', 'grcmanager'), 'activity': __('Activity', 'grcmanager')} %}
      <div class="col-md-3">
        <label class="form-label" for="grc-ebios-{{ scale }}">{{ label }}</label>
        <select id="grc-ebios-{{ scale }}" name="{{ scale }}" class="form-select">
          {% for level, text in levels %}<option value="{{ level }}" {{ level == 2 ? 'selected' : '' }}>{{ text }}</option>{% endfor %}
        </select>
      </div>
    {% endfor %}
    <input type="hidden" name="is_retained" value="1">
    <div class="col-md-3">
      <button type="submit" name="add" class="btn btn-primary w-100"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
    </div>
  </div>
</form>
{% endif %}

{% if sources is empty %}
  <div class="empty">
    <div class="empty-icon"><i class="ti ti-user-exclamation fs-1"></i></div>
    <p class="empty-title">{{ __('No risk source yet', 'grcmanager') }}</p>
    <p class="empty-subtitle text-muted">{{ __('Think of organised crime, a competitor, a disgruntled employee, an activist, a state-backed group...', 'grcmanager') }}</p>
  </div>
{% else %}
<div class="table-responsive">
  <table class="table table-sm table-vcenter card-table">
    <thead>
      <tr>
        <th>{{ __('Risk source', 'grcmanager') }}</th>
        <th>{{ __('Target objective', 'grcmanager') }}</th>
        <th>{{ __('Motivation', 'grcmanager') }}</th>
        <th>{{ __('Resources', 'grcmanager') }}</th>
        <th>{{ __('Activity', 'grcmanager') }}</th>
        <th>{{ __('Relevance', 'grcmanager') }}</th>
        <th>{{ __('Decision and justification', 'grcmanager') }}</th>
        {% if can_edit %}<th></th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for source in sources %}
        <tr class="{{ source.is_retained ? '' : 'text-muted' }}">
          <td class="fw-bold">{{ source.name }}</td>
          <td>{{ source.objective }}</td>
          <td>{{ source.motivation }}</td>
          <td>{{ source.resources }}</td>
          <td>{{ source.activity }}</td>
          <td><span class="badge {{ relevance[source.relevance][0] }}">{{ relevance[source.relevance][1] }}</span></td>
          <td style="min-width: 18rem">
            {% if can_edit %}
              <form method="post" action="{{ form_url }}" class="d-flex gap-1 align-items-center">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="element" value="risk_source">
                <input type="hidden" name="id" value="{{ source.id }}">
                <select name="is_retained" class="form-select form-select-sm" style="max-width: 8rem" aria-label="{{ __('Decision and justification', 'grcmanager') }}">
                  <option value="1" {{ source.is_retained ? 'selected' : '' }}>{{ __('Retained', 'grcmanager') }}</option>
                  <option value="0" {{ source.is_retained ? '' : 'selected' }}>{{ __('Set aside', 'grcmanager') }}</option>
                </select>
                <input type="text" name="justification" value="{{ source.justification }}" class="form-control form-control-sm" placeholder="{{ __('Why', 'grcmanager') }}" aria-label="{{ __('Why', 'grcmanager') }}">
                <button type="submit" name="update" class="btn btn-sm btn-outline-primary" title="{{ __('Save') }}" aria-label="{{ __('Save') }}"><i class="ti ti-device-floppy"></i></button>
              </form>
            {% else %}
              <span class="badge {{ source.is_retained ? 'bg-blue-lt' : 'bg-secondary-lt' }}">{{ source.is_retained ? __('Retained', 'grcmanager') : __('Set aside', 'grcmanager') }}</span>
              {{ source.justification }}
            {% endif %}
          </td>
          {% if can_edit %}
            <td>
              <form method="post" action="{{ form_url }}" onsubmit="return confirm('{{ __('Remove this risk source and the scenarios built on it?', 'grcmanager')|e('js') }}');">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="element" value="risk_source">
                <input type="hidden" name="id" value="{{ source.id }}">
                <button type="submit" name="purge" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}" aria-label="{{ __('Remove', 'grcmanager') }}"><i class="ti ti-trash"></i></button>
              </form>
            </td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
