{# Issue #370 : plan de remédiation de l'incident, voir
   GlpiPlugin\\Grcmanager\\SecurityIncidentPlaybookTask::displayTabContentForItem(). #}

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
  <div class="flex-fill" style="min-width: 16rem">
    <div class="d-flex justify-content-between small mb-1">
      <span class="fw-bold">{{ __('Progress', 'grcmanager') }} : {{ progress.done }}/{{ progress.total }}</span>
      <span class="text-muted">{{ progress.percent }} %</span>
    </div>
    <div class="progress progress-sm">
      <div class="progress-bar {{ progress.mandatory_pending > 0 ? 'bg-orange' : 'bg-green' }}" style="width: {{ progress.percent }}%"
           role="progressbar" aria-valuenow="{{ progress.percent }}" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
  </div>
  {% if progress.mandatory_pending > 0 %}
    <span class="badge bg-orange-lt"><i class="ti ti-lock me-1"></i>{{ __('%d mandatory step(s) open: closure blocked', 'grcmanager')|format(progress.mandatory_pending) }}</span>
  {% elseif progress.total > 0 %}
    <span class="badge bg-green-lt"><i class="ti ti-lock-open me-1"></i>{{ __('Mandatory steps completed', 'grcmanager') }}</span>
  {% endif %}
  {% if progress.total > 0 %}
    <a href="{{ pdf_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-file-type-pdf me-1"></i>{{ __('Remediation plan (PDF)', 'grcmanager') }}</a>
  {% endif %}
  {% if can_library %}
    <a href="{{ library_url }}" class="btn btn-sm btn-ghost-secondary"><i class="ti ti-books me-1"></i>{{ __('Playbook library', 'grcmanager') }}</a>
  {% endif %}
</div>

{% if can_edit %}
  <div class="row g-2 mb-3">
    <div class="col-lg-6">
      <form method="post" action="{{ form_url }}" class="card card-body h-100">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="plugin_grcmanager_securityincidents_id" value="{{ item.getID() }}">
        <label class="form-label" for="grc-playbook">{{ __('Apply a playbook', 'grcmanager') }}</label>
        <div class="d-flex gap-2">
          <select id="grc-playbook" name="plugin_grcmanager_playbooks_id" class="form-select" required>
            {% for p in playbooks %}
              <option value="{{ p.id }}" {{ p.id in applied ? 'disabled' : '' }}>{{ p.recommended ? '★ ' : '' }}{{ p.name }}{{ p.id in applied ? ' (' ~ __('already applied', 'grcmanager') ~ ')' : '' }}</option>
            {% endfor %}
          </select>
          <button type="submit" name="apply" class="btn btn-primary text-nowrap"><i class="ti ti-player-play me-1"></i>{{ __('Apply', 'grcmanager') }}</button>
        </div>
        <div class="form-hint">{{ __('★ = suggested for the category of this incident. The steps are copied as tasks: changing the playbook later does not change them.', 'grcmanager') }}</div>
      </form>
    </div>
    <div class="col-lg-6">
      <form method="post" action="{{ form_url }}" class="card card-body h-100">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="plugin_grcmanager_securityincidents_id" value="{{ item.getID() }}">
        <label class="form-label" for="grc-task-name">{{ __('Add a task specific to this incident', 'grcmanager') }}</label>
        <div class="d-flex flex-wrap gap-2">
          <select name="phase" class="form-select" style="max-width: 11rem" aria-label="{{ __('Phase', 'grcmanager') }}">
            {% for key, label in phases %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
          </select>
          <input type="text" id="grc-task-name" name="name" class="form-control flex-fill" style="min-width: 12rem; width: auto" maxlength="255" required>
          <input type="hidden" name="rank" value="{{ (progress.total + 1) * 10 + 1000 }}">
          <button type="submit" name="add" class="btn btn-outline-primary text-nowrap"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
        </div>
        <label class="form-check mt-2 mb-0">
          <input type="checkbox" class="form-check-input" name="is_mandatory" value="1">
          <span class="form-check-label">{{ __('Mandatory before closing', 'grcmanager') }}</span>
        </label>
      </form>
    </div>
  </div>
{% endif %}

{% if groups is empty %}
  <div class="empty">
    <div class="empty-icon"><i class="ti ti-checklist fs-1"></i></div>
    <p class="empty-title">{{ __('No remediation plan yet', 'grcmanager') }}</p>
    <p class="empty-subtitle text-muted">{{ __('Apply the playbook that matches the incident: its steps become tasks to follow up, phase by phase.', 'grcmanager') }}</p>
  </div>
{% endif %}

{% for phase, tasks in groups %}
  <h4 class="mt-3 mb-2"><span class="badge bg-blue-lt">{{ phases[phase] }}</span>
    <span class="text-muted small ms-1">{{ tasks|filter(t => t.status in ['done', 'not_applicable'])|length }}/{{ tasks|length }}</span></h4>
  <div class="list-group mb-2">
    {% for task in tasks %}
      {% set status = statuses[task.status]|default(statuses['todo']) %}
      <div class="list-group-item {{ task.status in ['done', 'not_applicable'] ? 'bg-light' : '' }}">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="badge {{ status.class }}"><i class="ti {{ status.icon }} me-1"></i>{{ status.label }}</span>
          <span class="fw-bold {{ task.status == 'not_applicable' ? 'text-decoration-line-through text-muted' : '' }}">{{ task.name }}</span>
          {% if task.is_mandatory %}<span class="badge bg-red-lt">{{ __('Mandatory', 'grcmanager') }}</span>{% endif %}
          {% if task.date_done %}
            <span class="text-muted small"><i class="ti ti-signature me-1"></i>{{ users[task.users_id_done]|default('') }}, {{ task.date_done|formatted_datetime }}</span>
          {% endif %}
        </div>
        {% if task.description %}<div class="text-muted small mt-1">{{ task.description }}</div>{% endif %}
        {# Issue #620 : l'étape du registre des violations mène à la fiche, ou propose de la créer. #}
        {% if breach is defined and breach and task.id in breach_task_ids %}
          <div class="mt-1">
            {% if breach.readable %}
              <a href="{{ breach.url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-file-alert me-1"></i>{{ __('Breach register entry', 'grcmanager') }}</a>
              <span class="badge {{ breach.state.class }} ms-1">{{ breach.state.label }}</span>
            {% elseif breach.can_create %}
              <a href="{{ breach.create_url }}" class="btn btn-sm btn-outline-primary"><i class="ti ti-file-plus me-1"></i>{{ __('Record this breach in the register', 'grcmanager') }}</a>
            {% else %}
              <a href="{{ breach.register_url }}" class="btn btn-sm btn-ghost-secondary"><i class="ti ti-list me-1"></i>{{ __('Breach register', 'grcmanager') }}</a>
            {% endif %}
          </div>
        {% endif %}
        {% if can_edit %}
          <form method="post" action="{{ form_url }}" class="row g-2 mt-1 align-items-center">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ task.id }}">
            <div class="col-md-3">
              <select name="status" class="form-select form-select-sm" aria-label="{{ __('Status') }}">
                {% for key, s in statuses %}<option value="{{ key }}" {{ key == task.status ? 'selected' : '' }}>{{ s.label }}</option>{% endfor %}
              </select>
            </div>
            <div class="col-md-3">
              {{ call('User::dropdown', [{
                'name': 'users_id',
                'value': task.users_id,
                'right': 'all',
                'entity': item.fields['entities_id'],
                'display': false,
                'width': '100%',
                'rand': task.id,
              }])|raw }}
            </div>
            <div class="col-md-5">
              <input type="text" name="report" value="{{ task.report }}" class="form-control form-control-sm"
                     placeholder="{{ __('Report: what was done, result', 'grcmanager') }}" aria-label="{{ __('Report', 'grcmanager') }}">
            </div>
            <div class="col-md-1 d-flex gap-1">
              <button type="submit" name="update" class="btn btn-sm btn-outline-primary" title="{{ __('Save') }}" aria-label="{{ __('Save') }}"><i class="ti ti-device-floppy"></i></button>
              {% if not task.plugin_grcmanager_playbooks_id %}
                <button type="submit" name="purge" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove', 'grcmanager') }}" aria-label="{{ __('Remove', 'grcmanager') }}"
                        onclick="return confirm('{{ __('Remove this task?', 'grcmanager')|e('js') }}');"><i class="ti ti-trash"></i></button>
              {% endif %}
            </div>
          </form>
        {% else %}
          {% if task.report %}<div class="mt-1"><i class="ti ti-notes me-1"></i>{{ task.report }}</div>{% endif %}
          {% if task.users_id %}<div class="text-muted small"><i class="ti ti-user me-1"></i>{{ users[task.users_id]|default('') }}</div>{% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endfor %}
