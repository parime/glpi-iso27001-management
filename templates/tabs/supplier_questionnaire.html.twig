{# Issue #864 : onglet « Questionnaires » d'un risque fournisseur (GlpiPlugin\\Grcmanager\\SupplierAssessment) :
   évaluations du fournisseur avec leur modèle, leur score pondéré et leur évolution, et création d'une
   évaluation à partir d'un modèle. #}
<div class="card" id="grc-supplier-evaluations">
   <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <h3 class="card-title mb-0"><i class="ti ti-checklist me-1"></i>{{ __('Questionnaires', 'grcmanager') }}</h3>
      {% for domain, delta in trends %}
         <span class="badge {{ delta > 0 ? 'bg-green-subtle text-green-emphasis' : (delta < 0 ? 'bg-red-subtle text-red-emphasis' : 'bg-secondary-subtle text-secondary-emphasis') }} grc-evaluation-trend"
               title="{{ __('Change between the last two completed evaluations', 'grcmanager') }}">
            <i class="ti {{ delta > 0 ? 'ti-trending-up' : (delta < 0 ? 'ti-trending-down' : 'ti-minus') }} me-1"></i>{{ __('%1$s: %2$s points', 'grcmanager')|format(domains[domain] ?? domain, (delta > 0 ? '+' : '') ~ delta) }}
         </span>
      {% endfor %}
      {% if templates_url %}
         <a href="{{ templates_url }}" class="ms-auto btn btn-sm btn-outline-secondary" id="grc-questionnaire-templates-link"><i class="ti ti-forms me-1"></i>{{ __('Questionnaire templates', 'grcmanager') }}</a>
      {% endif %}
   </div>
   <div class="card-body">
      <p class="text-muted small">
         <i class="ti ti-info-circle me-1"></i>{{ __('Evaluate the supplier with one or more questionnaires (security, personal data, artificial intelligence...). Each question has a weight and an expected answer; the score informs the assessment and never changes the risk level entered. Evidence requested for a question is added to the Documents tab of this supplier risk.', 'grcmanager') }}
      </p>

      {% if evaluations is empty %}
         <div class="alert alert-info mb-3" id="grc-no-evaluation"><i class="ti ti-clipboard-off me-2"></i>{{ __('No evaluation yet for this supplier.', 'grcmanager') }}</div>
      {% else %}
         <div class="table-responsive">
         <table class="table table-sm table-vcenter card-table" id="grc-evaluation-list">
            <thead>
               <tr>
                  <th>{{ __('Evaluation', 'grcmanager') }}</th>
                  <th>{{ __('Domain', 'grcmanager') }}</th>
                  <th>{{ __('Status', 'grcmanager') }}</th>
                  <th>{{ __('Score', 'grcmanager') }}</th>
                  <th>{{ __('Evaluation date', 'grcmanager') }}</th>
                  <th>{{ __('Assessor', 'grcmanager') }}</th>
               </tr>
            </thead>
            <tbody>
               {% for e in evaluations %}
                  {% set badge = badges[e.domain] ?? badges['other'] %}
                  {% set status = statuses[e.status] ?? statuses['in_progress'] %}
                  <tr>
                     <td>
                        <a href="{{ e.url }}"><i class="ti ti-clipboard-check me-1"></i>{{ e.name ?: e.template_name }}</a>
                        {% if e.source == 'legacy' %}
                           <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1" title="{{ __('Taken over from the former fixed questionnaire', 'grcmanager') }}"><i class="ti ti-archive me-1"></i>{{ __('Taken over', 'grcmanager') }}</span>
                        {% endif %}
                        <div class="text-muted small">{{ __('Template: %1$s (version %2$d)', 'grcmanager')|format(e.template_name, e.template_version) }}</div>
                     </td>
                     <td><span class="badge {{ badge[0] }}"><i class="ti {{ badge[1] }} me-1"></i>{{ domains[e.domain] ?? e.domain }}</span></td>
                     <td><span class="badge {{ status[1] }}"><i class="ti {{ status[2] }} me-1"></i>{{ status[0] }}</span></td>
                     <td>
                        {% if e.score is not null %}
                           <span class="badge {{ levels[e.level][1] }}" title="{{ levels[e.level][0] }}"><i class="ti ti-gauge me-1"></i>{{ e.score }} %</span>
                        {% else %}
                           <span class="text-muted">-</span>
                        {% endif %}
                     </td>
                     <td>{{ e.evaluation_date ? e.evaluation_date|formatted_date : '-' }}</td>
                     <td>{{ e.evaluator ?: '-' }}</td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>
         </div>
      {% endif %}

      {% if can_create %}
         {% if templates is empty %}
            <div class="alert alert-warning mt-3 mb-0" id="grc-no-template"><i class="ti ti-alert-triangle me-2"></i>{{ __('No active questionnaire template is available in the entity of this supplier risk.', 'grcmanager') }}</div>
         {% else %}
            <form method="post" action="{{ action }}" class="row g-2 align-items-end mt-3" id="grc-new-evaluation">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <input type="hidden" name="plugin_grcmanager_supplierrisks_id" value="{{ risk.fields.id }}">
               <div class="col-md-5">
                  <label class="form-label" for="grc-evaluation-template">{{ __('Questionnaire template', 'grcmanager') }}</label>
                  <select class="form-select" name="plugin_grcmanager_supplierquestionnairetemplates_id" id="grc-evaluation-template" required>
                     {% for id, name in templates %}
                        <option value="{{ id }}">{{ name }}</option>
                     {% endfor %}
                  </select>
               </div>
               <div class="col-md-4">
                  <label class="form-label" for="grc-evaluation-name">{{ __('Name') }}</label>
                  <input type="text" class="form-control" name="name" id="grc-evaluation-name" maxlength="255" placeholder="{{ __('Optional: the template name and the year otherwise', 'grcmanager') }}">
               </div>
               <div class="col-md-3">
                  <button type="submit" name="add" value="1" class="btn btn-primary w-100"><i class="ti ti-plus me-1"></i>{{ __('Start an evaluation', 'grcmanager') }}</button>
               </div>
            </form>
         {% endif %}
      {% endif %}
   </div>
</div>
