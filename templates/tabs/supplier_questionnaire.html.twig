{# Issue #127 : questionnaire de sécurité du fournisseur (PluginGrcmanagerSupplierAssessment) #}
{% set level_class = {'good': 'bg-green-lt', 'fair': 'bg-orange-lt', 'poor': 'bg-red-lt'} %}
{% set level_labels = {
   'good': __('Good level', 'grcmanager'),
   'fair': __('Needs improvement', 'grcmanager'),
   'poor': __('Insufficient level', 'grcmanager')
} %}
<div class="card">
   <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <h3 class="card-title mb-0"><i class="ti ti-checklist me-1"></i>{{ __('Security questionnaire', 'grcmanager') }}</h3>
      {% if score is not null %}
         <span class="badge {{ level_class[level] }} ms-2">{{ __('Score: %d %%', 'grcmanager')|format(score) }} — {{ level_labels[level] }}</span>
      {% endif %}
      {% if date %}
         <span class="text-muted small ms-auto">{{ __('Filled in on %1$s by %2$s', 'grcmanager')|format(date|formatted_datetime, author) }}</span>
      {% endif %}
   </div>
   <div class="card-body">
      <p class="text-muted">{{ __('Yes = 1 point, partial = ½, no = 0; "not applicable" is not counted. The score informs the assessment; it does not change the risk level entered. Attach the evidence (signed questionnaire, certificates) in the Documents tab.', 'grcmanager') }}</p>
      <form method="post" action="{{ action }}">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="id" value="{{ item.fields.id }}">
         <table class="table table-sm table-vcenter">
            <tbody>
               {% for key, label in questions %}
                  <tr>
                     <td>{{ label }}</td>
                     <td class="text-nowrap">
                        <div class="btn-group btn-group-sm" role="group">
                           {% for value, choice in choices %}
                              <input type="radio" class="btn-check" name="answers[{{ key }}]" id="q-{{ key }}-{{ value }}" value="{{ value }}"
                                 {{ answers[key]|default('') == value ? 'checked' : '' }} {{ can_edit ? '' : 'disabled' }}>
                              <label class="btn btn-outline-secondary" for="q-{{ key }}-{{ value }}">{{ choice }}</label>
                           {% endfor %}
                        </div>
                     </td>
                  </tr>
               {% endfor %}
            </tbody>
         </table>
         {% if can_edit %}
            <button type="submit" name="save_questionnaire" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save questionnaire', 'grcmanager') }}</button>
         {% endif %}
      </form>
   </div>
</div>
