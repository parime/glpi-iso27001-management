{# Issue #859 : onglet « Comptes à privilèges » d'une campagne de revue des accès : écarts du coffre-fort
   dans les entités de la campagne (et de la personne). Rien n'est décidé ici : le retrait se fait dans le coffre. #}
{% import '@grcmanager/_privileged_vault_macros.html.twig' as vault %}
<div id="grc-review-privileged-vault">
   <div class="alert alert-info d-flex align-items-start gap-2">
      <i class="ti ti-lock-access fs-2"></i>
      <div>
         {{ __('Privileged accesses to review in the password vault: people who left, members unknown in GLPI, administrators without two-step login, passwords not changed for more than %d months. Remove the accesses and change the passwords in the vault itself.', 'grcmanager')|format(rotation_months) }}
         <a href="{{ page_url }}">{{ __('View all the privileged accounts', 'grcmanager') }}</a>
      </div>
   </div>
   <div class="mb-3">
      <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-key me-1"></i>{{ _n('%d shared account in the vault', '%d shared accounts in the vault', summary.entries, 'grcmanager')|format(summary.entries) }}</span>
      <span class="badge bg-secondary-subtle text-secondary-emphasis me-1"><i class="ti ti-users me-1"></i>{{ _n('%d member', '%d members', summary.members, 'grcmanager')|format(summary.members) }}</span>
   </div>

   <h4><i class="ti ti-users me-2"></i>{{ __('Members to review', 'grcmanager') }}</h4>
   {% if members is empty %}
      <p class="text-muted">{{ __('No member with a gap.', 'grcmanager') }}</p>
   {% else %}
      <div class="table-responsive mb-3">
         <table class="table table-sm table-vcenter">
            <thead><tr><th>{{ __('Member', 'grcmanager') }}</th><th>{{ __('Role', 'grcmanager') }}</th><th>{{ __('Gaps', 'grcmanager') }}</th></tr></thead>
            <tbody>
            {% for row in members %}
               {% set role = role_infos[row.role] ?? role_infos['user'] %}
               <tr><td>{{ row.email }}</td><td><span class="badge bg-{{ role.color }}-subtle text-{{ role.color }}-emphasis">{{ role.label }}</span></td><td>{{ vault.gaps(row.gaps, gap_infos) }}</td></tr>
            {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}

   <h4><i class="ti ti-key me-2"></i>{{ __('Shared accounts to review', 'grcmanager') }}</h4>
   {% if entries is empty %}
      <p class="text-muted">{{ __('No shared account with a gap.', 'grcmanager') }}</p>
   {% else %}
      <div class="table-responsive mb-3">
         <table class="table table-sm table-vcenter">
            <thead><tr><th>{{ __('Item', 'grcmanager') }}</th><th>{{ __('Last change', 'grcmanager') }}</th><th>{{ __('Gaps', 'grcmanager') }}</th></tr></thead>
            <tbody>
            {% for row in entries %}
               <tr><td>{{ row.name }}{% if row.username %}<div class="small text-muted">{{ row.username }}</div>{% endif %}</td><td>{{ row.date_label ?: '-' }}</td><td>{{ vault.gaps(row.gaps, gap_infos) }}</td></tr>
            {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}

   {% if equipment is not empty %}
      <h4><i class="ti ti-server-cog me-2"></i>{{ __('Server controller administrator accounts missing from the vault', 'grcmanager') }}</h4>
      <div class="table-responsive">
         <table class="table table-sm table-vcenter">
            <thead><tr><th>{{ __('Controller', 'grcmanager') }}</th><th>{{ __('Login name', 'grcmanager') }}</th><th>{{ __('Role', 'grcmanager') }}</th></tr></thead>
            <tbody>
            {% for row in equipment %}
               <tr><td>{{ row.controller }}</td><td>{{ row.username }}</td><td>{{ row.role }}</td></tr>
            {% endfor %}
            </tbody>
         </table>
      </div>
   {% endif %}
</div>
