{# Issue #126 : lignes de revue (onglet de la campagne et « Mes revues d'accès »).
   Paramètres : lines, decisions, sources, can_decide, show_reviewer.
   Issue #866 : suggestion des règles et sa raison (AccessReviewSuggestion::decorate()).
   Issue #932 : bouton « Reporter les suggestions » : coche dans le formulaire la décision proposée
   (garder ou retirer) des comptes encore à revoir ; rien n'est enregistré avant « Enregistrer les
   décisions », chaque décision reste celle du relecteur. #}
{% set decision_class = {'pending': 'bg-secondary-lt', 'keep': 'bg-green-lt', 'modify': 'bg-orange-lt', 'remove': 'bg-red-lt'} %}
{% set prefillable = can_decide ? lines|filter(l => l.decision == 'pending' and l.suggested_decision != '' and l.tickets_id == 0)|length : 0 %}
{% if prefillable > 0 %}
   <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <button type="button" class="btn btn-sm btn-outline-warning" data-grc-ar-prefill
         data-done="{{ __('%d decision(s) pre-filled: check each one, then click "Save decisions". Nothing is saved until then.', 'grcmanager')|e('html_attr') }}"
         data-comment-prefix="{{ __('Suggested by the rules:', 'grcmanager')|e('html_attr') }}">
         <i class="ti ti-bulb me-1"></i>{{ __('Pre-fill with the suggestions', 'grcmanager') }}
         <span class="badge bg-warning-subtle text-warning-emphasis ms-1">{{ prefillable }}</span>
      </button>
      <span class="text-muted small">{{ __('Ticks "Keep" or "Remove" on the accounts still to review that have a suggestion. Accounts to examine are left for you to decide.', 'grcmanager') }}</span>
      <span class="badge bg-info-subtle text-info-emphasis d-none" data-grc-ar-prefill-result role="status"></span>
   </div>
{% endif %}
<div class="table-responsive">
<table class="table table-sm table-vcenter mb-0">
   <thead>
      <tr>
         <th>{{ __('Account', 'grcmanager') }}</th>
         <th>{{ __('Profiles and groups', 'grcmanager') }}</th>
         <th>{{ __('Suggestion and reason', 'grcmanager') }}</th>
         {% if show_reviewer %}<th>{{ __('Owner', 'grcmanager') }}</th>{% endif %}
         <th>{{ __('Decision and comment', 'grcmanager') }}</th>
      </tr>
   </thead>
   <tbody>
      {% for line in lines %}
         {% set locked = line.tickets_id > 0 %}
         <tr data-grc-ar-line data-pending="{{ line.decision == 'pending' and not locked ? 1 : 0 }}"
            data-suggested="{{ line.suggested_decision|e('html_attr') }}" data-reasons="{{ line.suggestion_reasons_text|default('')|e('html_attr') }}">
            <td class="text-nowrap"><i class="ti ti-user me-1"></i>{{ line.user_name }}</td>
            <td>
               {% for p in line.profiles_list %}<div><i class="ti ti-id-badge-2 me-1 text-muted"></i>{{ p }}</div>{% endfor %}
               {% if line.groups_list is not empty %}
                  <div class="text-muted small"><i class="ti ti-users me-1"></i>{{ line.groups_list|join(', ') }}</div>
               {% endif %}
            </td>
            <td style="min-width: 220px">
               {% if line.suggestion %}
                  <span class="badge bg-{{ line.suggestion_color }}-subtle text-{{ line.suggestion_color }}-emphasis"><i class="{{ line.suggestion_icon }} me-1"></i>{{ line.suggestion_label }}</span>
                  <ul class="list-unstyled small mb-0 mt-1">
                     {% for reason in line.suggestion_reasons_list %}
                        <li class="{{ reason.removal ? 'text-danger' : 'text-muted' }}"><i class="ti {{ reason.removal ? 'ti-alert-triangle' : 'ti-point' }} me-1"></i>{{ reason.label }}</li>
                     {% endfor %}
                  </ul>
               {% else %}
                  <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-help me-1"></i>{{ __('No suggestion yet', 'grcmanager') }}</span>
               {% endif %}
            </td>
            {% if show_reviewer %}
               <td class="text-nowrap">{{ line.reviewer_name }}<div class="text-muted small">{{ sources[line.reviewer_source]|default('') }}</div></td>
            {% endif %}
            <td style="min-width: 300px">
               {% if can_decide and not locked %}
                  <div class="btn-group btn-group-sm" role="group">
                     {% for value in ['keep', 'modify', 'remove'] %}
                        <input type="radio" class="btn-check" name="decisions[{{ line.id }}]" id="d-{{ line.id }}-{{ value }}" value="{{ value }}" {{ line.decision == value ? 'checked' : '' }}>
                        <label class="btn btn-outline-secondary" for="d-{{ line.id }}-{{ value }}"{% if line.suggested_decision == value %} title="{{ __('Suggested by the rules', 'grcmanager') }}"{% endif %}>{% if line.suggested_decision == value %}<i class="ti ti-bulb me-1 text-warning"></i>{% endif %}{{ decisions[value] }}</label>
                     {% endfor %}
                  </div>
               {% else %}
                  <span class="badge {{ decision_class[line.decision] }}">{{ decisions[line.decision] }}</span>
               {% endif %}
               {% if can_decide and not locked and line.suggested_decision %}
                  <div class="d-none" data-grc-ar-prefilled><span class="badge bg-warning-subtle text-warning-emphasis mt-1"><i class="ti ti-pencil me-1"></i>{{ __('Pre-filled from the suggestion, not saved yet', 'grcmanager') }}</span></div>
               {% endif %}
               {% if line.differs %}
                  <div><span class="badge bg-info-subtle text-info-emphasis mt-1"><i class="ti ti-arrows-diff me-1"></i>{{ __('Decision differs from the suggestion', 'grcmanager') }}</span></div>
               {% endif %}
               {% if line.decided_by_name %}
                  <div class="text-muted small">{{ line.decided_by_name }}, {{ line.date_decision|formatted_datetime }}</div>
               {% endif %}
               {% if can_decide and not locked %}
                  <input type="text" class="form-control form-control-sm mt-1" name="comments[{{ line.id }}]" value="{{ line.comment }}"
                     placeholder="{{ line.suggestion == 'remove' ? __('Comment (required to keep, change or remove)', 'grcmanager') : __('Comment (required to change or remove)', 'grcmanager') }}">
               {% elseif line.comment %}
                  <div class="mt-1"><i class="ti ti-message me-1 text-muted"></i>{{ line.comment }}</div>
               {% endif %}
               {% if line.ticket_url %}
                  <div><a href="{{ line.ticket_url }}"><i class="ti ti-ticket me-1"></i>{{ __('Ticket #%d', 'grcmanager')|format(line.tickets_id) }}</a></div>
               {% endif %}
            </td>
         </tr>
      {% endfor %}
   </tbody>
</table>
</div>
{% if prefillable > 0 %}
<script>
   // Issue #932 : report des suggestions dans le formulaire, sans enregistrement.
   if (!window.grcAccessReviewPrefill) {
      window.grcAccessReviewPrefill = true;
      document.addEventListener('click', function (event) {
         const button = event.target.closest('[data-grc-ar-prefill]');
         if (!button) {
            return;
         }
         const form = button.closest('form');
         let count = 0;
         form.querySelectorAll('tr[data-grc-ar-line][data-pending="1"]').forEach(function (row) {
            const value = row.dataset.suggested;
            if (value === '' || row.querySelector('input.btn-check:checked')) {
               return;
            }
            const radio = row.querySelector('input.btn-check[value="' + value + '"]');
            if (!radio) {
               return;
            }
            radio.checked = true;
            const comment = row.querySelector('input[name^="comments["]');
            if (value === 'remove' && comment && comment.value.trim() === '' && row.dataset.reasons !== '') {
               comment.value = button.dataset.commentPrefix + ' ' + row.dataset.reasons;
            }
            const badge = row.querySelector('[data-grc-ar-prefilled]');
            if (badge) {
               badge.classList.remove('d-none');
            }
            count++;
         });
         const result = button.parentElement.querySelector('[data-grc-ar-prefill-result]');
         if (result) {
            result.textContent = button.dataset.done.replace('%d', String(count));
            result.classList.remove('d-none');
         }
      });
      document.addEventListener('change', function (event) {
         const row = event.target.closest('tr[data-grc-ar-line]');
         const badge = row ? row.querySelector('[data-grc-ar-prefilled]') : null;
         if (badge && event.target.classList.contains('btn-check')) {
            badge.classList.add('d-none');
         }
      });
   }
</script>
{% endif %}
