{# Issue #377, troisième étape : stratégie de reprise d'un processus et temps de reprise mesurés, voir
   GlpiPlugin\\Grcmanager\\BusinessProcessRecovery::displayTabContentForItem().
   Issue #733 : perte de données mesurée (RPO), type d'exercice, élément testé, programme de tests. #}
{% set fields_labels = {
   'degraded_mode': [__('Degraded mode', 'grcmanager'), __('How the activity continues while the system is down (paper forms, manual workaround…).', 'grcmanager')],
   'backup_solution': [__('Backup solution', 'grcmanager'), __('Backup site, standby system, alternative supplier…', 'grcmanager')],
   'recovery_procedure': [__('Recovery procedure', 'grcmanager'), __('Main steps to restore the process, or reference of the detailed procedure.', 'grcmanager')],
} %}
{% set data_loss_hint = __('The data loss (time between the last usable backup and the incident) is compared with its RPO; leave it empty if it was not measured, enter 0 if no data was lost.', 'grcmanager') %}

<div class="row g-3 mb-3">
  <div class="col-md-2">
    <div class="card card-body">
      <div class="text-muted small">RTO</div>
      <div class="fs-3">{{ durations[item.fields['rto_hours']] ?? __('Not set', 'grcmanager') }}</div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card card-body">
      <div class="text-muted small">RPO</div>
      <div class="fs-3">{{ durations[item.fields['rpo_hours']] ?? __('Not set', 'grcmanager') }}</div>
    </div>
  </div>
  <div class="col-md-8">
    <div class="card card-body">
      <div class="text-muted small">{{ __('Recovery time measured at the last test', 'grcmanager') }}</div>
      {% if strategy.last %}
        <div class="fs-3">
          {{ strategy.last.duration }}
          {% if strategy.last.exceeds %}<span class="badge bg-red-lt ms-2 grcmanager-recovery-late">{{ __('Above the RTO', 'grcmanager') }}</span>{% else %}<span class="badge bg-green-lt ms-2">{{ __('Within the RTO', 'grcmanager') }}</span>{% endif %}
        </div>
        <div>
          {{ __('Measured data loss', 'grcmanager') }} :
          {% if strategy.last.rpo_minutes is null %}
            <span class="text-muted">{{ __('Not measured', 'grcmanager') }}</span>
          {% else %}
            {{ strategy.last.rpo_duration }}
            {% if strategy.last.rpo_exceeds %}<span class="badge bg-danger-subtle text-danger-emphasis ms-1">{{ __('Above the RPO', 'grcmanager') }}</span>{% elseif item.fields['rpo_hours'] > 0 %}<span class="badge bg-success-subtle text-success-emphasis ms-1">{{ __('Within the RPO', 'grcmanager') }}</span>{% endif %}
          {% endif %}
        </div>
        <div class="small text-muted">{{ strategy.last.date }}{% if strategy.last.type %} - {{ strategy.last.type }}{% endif %}{% if strategy.last.exercise %} - {{ strategy.last.exercise }}{% endif %}</div>
      {% else %}
        <div class="fs-3 text-muted">{{ __('Never tested', 'grcmanager') }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% if strategy.issues is not empty %}
  <div class="alert alert-warning" role="alert">
    <ul class="mb-0">
      {% for code in strategy.issues %}<li>{{ issues[code] ?? code }}</li>{% endfor %}
    </ul>
  </div>
{% endif %}

<h3>{{ __('Recovery strategy', 'grcmanager') }}</h3>
{% if can_edit %}
  <form method="post" action="{{ process_url }}" class="mb-4">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="id" value="{{ item.getID() }}">
    {% for field, label in fields_labels %}
      <div class="mb-2">
        <label class="form-label" for="grc-strategy-{{ field }}">{{ label[0] }}</label>
        <textarea id="grc-strategy-{{ field }}" name="{{ field }}" class="form-control" rows="3">{{ strategy[field] }}</textarea>
        <div class="form-hint">{{ label[1] }}</div>
      </div>
    {% endfor %}
    <button type="submit" name="update" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
  </form>
{% else %}
  <dl class="mb-4">
    {% for field, label in fields_labels %}
      <dt>{{ label[0] }}</dt>
      <dd>{% if strategy[field] is not empty %}{{ strategy[field]|nl2br }}{% else %}<span class="text-muted">{{ __('Not described', 'grcmanager') }}</span>{% endif %}</dd>
    {% endfor %}
  </dl>
{% endif %}

{# Issue #733 : programme de tests (fréquence propre au processus) et couverture pluriannuelle. #}
{% set programme = strategy.programme %}
<h3 id="grc-recovery-programme"><i class="ti ti-calendar-repeat me-1"></i>{{ __('Test programme', 'grcmanager') }}</h3>
<div class="card card-body mb-4">
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <div class="text-muted small">{{ __('Next test due', 'grcmanager') }}</div>
      <div class="fs-4">
        {{ programme.due_label ?: '-' }}
        <span class="badge {{ due_labels[programme.due_status][0] }} ms-1"><i class="ti {{ due_labels[programme.due_status][1] }} me-1"></i>{{ due_labels[programme.due_status][2] }}</span>
      </div>
      <div class="small text-muted">
        {% if programme.own_months > 0 %}
          {{ __('Every %d months (frequency set on this process).', 'grcmanager')|format(programme.own_months) }}
        {% else %}
          {{ __('Every %d months (frequency of the periodic review of continuity tests).', 'grcmanager')|format(programme.default_months) }}
        {% endif %}
      </div>
    </div>
    <div class="col-md-4">
      <div class="text-muted small mb-1">{{ __('Coverage by year', 'grcmanager') }}</div>
      {% for year in programme.years %}
        {% set r = result_labels[programme.coverage[year]] %}
        <span class="badge {{ r[0] }} me-1" title="{{ r[2] }}"><i class="ti {{ r[1] }} me-1"></i>{{ year }}</span>
      {% endfor %}
    </div>
    {% if can_edit %}
      <form method="post" action="{{ process_url }}" class="col-md-4 d-flex align-items-end gap-2">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="id" value="{{ item.getID() }}">
        <div class="flex-grow-1">
          <label class="form-label" for="grc-recovery-frequency">{{ __('Test frequency (months)', 'grcmanager') }}</label>
          <input type="number" id="grc-recovery-frequency" name="recovery_test_months" class="form-control" min="0" max="{{ max_frequency }}" value="{{ programme.own_months }}">
          <div class="form-hint">{{ __('0: use the frequency of the periodic review.', 'grcmanager') }}</div>
        </div>
        <button type="submit" name="update" value="1" class="btn btn-outline-primary mb-4"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
      </form>
    {% endif %}
  </div>
  <div class="form-hint mt-2">{{ __('A process that is not tested in time is reported to its owner and to the CISO group by an automatic action; nothing is changed automatically.', 'grcmanager') }}</div>
</div>

<h3>{{ _n('Recovery test', 'Recovery tests', 2, 'grcmanager') }}</h3>
<p class="text-muted">{{ __('Time actually needed to restore the process during a test or a crisis exercise, compared with its RTO. A test can also be recorded from the crisis room.', 'grcmanager') }} {{ data_loss_hint }}</p>

{% if can_edit %}
  <form method="post" action="{{ form_url }}" class="card card-body mb-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="plugin_grcmanager_businessprocesses_id" value="{{ item.getID() }}">
    <div class="row g-2 align-items-end">
      <div class="col-md-2">
        <label class="form-label" for="grc-recovery-date">{{ __('Date') }}</label>
        <input type="date" id="grc-recovery-date" name="test_date" class="form-control" value="{{ today }}">
      </div>
      <div class="col-md-2">
        <label class="form-label" for="grc-recovery-minutes">{{ __('Measured time (minutes)', 'grcmanager') }}</label>
        <input type="number" id="grc-recovery-minutes" name="measured_minutes" class="form-control" min="1" required>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="grc-recovery-rpo">{{ __('Data loss (minutes)', 'grcmanager') }}</label>
        <input type="number" id="grc-recovery-rpo" name="measured_rpo_minutes" class="form-control" min="0">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-recovery-type">{{ __('Type of exercise', 'grcmanager') }}</label>
        <select id="grc-recovery-type" name="exercise_type" class="form-select">
          <option value="">{{ __('Not specified', 'grcmanager') }}</option>
          {% for key, label in types %}<option value="{{ key }}" {{ key == 'technical_restore' ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-recovery-asset">{{ __('Item tested', 'grcmanager') }}</label>
        <select id="grc-recovery-asset" name="asset" class="form-select">
          <option value="">{{ __('The whole process', 'grcmanager') }}</option>
          {% for key, label in assets %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="grc-recovery-exercise">{{ __('Crisis exercise', 'grcmanager') }}</label>
        <select id="grc-recovery-exercise" name="plugin_grcmanager_crisisexercises_id" class="form-select">
          <option value="0">{{ __('None (test outside an exercise)', 'grcmanager') }}</option>
          {% for id, label in exercises %}<option value="{{ id }}">{{ label }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-md-7">
        <label class="form-label" for="grc-recovery-comment">{{ __('Comment', 'grcmanager') }}</label>
        <input type="text" id="grc-recovery-comment" name="comment" class="form-control" maxlength="255">
      </div>
      <div class="col-md-2">
        <button type="submit" name="add" value="1" class="btn btn-primary w-100"><i class="ti ti-plus me-1"></i>{{ __('Add', 'grcmanager') }}</button>
      </div>
    </div>
  </form>
{% endif %}

{% if strategy.tests is empty %}
  <p class="text-muted">{{ __('No recovery test recorded yet.', 'grcmanager') }}</p>
{% else %}
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">{{ __('Date') }}</th>
          <th scope="col">{{ __('Type of exercise', 'grcmanager') }}</th>
          <th scope="col">{{ __('Measured time', 'grcmanager') }}</th>
          <th scope="col">{{ __('Measured data loss', 'grcmanager') }}</th>
          <th scope="col">{{ __('Result', 'grcmanager') }}</th>
          <th scope="col">{{ __('Item tested', 'grcmanager') }}</th>
          <th scope="col">{{ __('Crisis exercise', 'grcmanager') }}</th>
          <th scope="col">{{ __('Comment', 'grcmanager') }}</th>
          <th scope="col">{{ __('Recorded by', 'grcmanager') }}</th>
          {% if can_edit %}<th scope="col"><span class="visually-hidden">{{ __('Actions', 'grcmanager') }}</span></th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for test in strategy.tests %}
          <tr>
            <td>{{ test.date }}</td>
            <td>{{ test.type ?: '-' }}</td>
            <td>
              {{ test.duration }}
              {% if test.exceeds %}<span class="badge bg-red-lt ms-1">{{ __('Above the RTO', 'grcmanager') }}</span>{% endif %}
            </td>
            <td>
              {% if test.rpo_minutes is null %}<span class="text-muted">-</span>{% else %}{{ test.rpo_duration }}{% endif %}
              {% if test.rpo_exceeds %}<span class="badge bg-danger-subtle text-danger-emphasis ms-1">{{ __('Above the RPO', 'grcmanager') }}</span>{% endif %}
            </td>
            <td>
              <span class="badge {{ result_labels[test.result][0] }}"><i class="ti {{ result_labels[test.result][1] }} me-1"></i>{{ result_labels[test.result][2] }}</span>
              {% if test.asset_exceeds %}<div class="small text-danger">{{ __('Above the objectives of the item tested', 'grcmanager') }}</div>{% endif %}
            </td>
            <td>{% if test.asset_url %}<a href="{{ test.asset_url }}">{{ test.asset }}</a>{% else %}<span class="text-muted">-</span>{% endif %}</td>
            <td>
              {% if test.exercise_url %}
                <a href="{{ test.exercise_url }}">{{ test.exercise }}</a>
              {% elseif test.exercise_hidden %}
                <span class="text-muted">{{ __('Exercise you cannot see', 'grcmanager') }}</span>
              {% endif %}
            </td>
            <td>{{ test.comment }}</td>
            <td>{{ test.by }}</td>
            {% if can_edit %}
              <td>
                <form method="post" action="{{ form_url }}">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  <input type="hidden" name="id" value="{{ test.id }}">
                  <button type="submit" name="purge" value="1" class="btn btn-sm btn-ghost-danger"
                          title="{{ __('Remove', 'grcmanager') }}" aria-label="{{ __('Remove', 'grcmanager') }}"
                          onclick="return confirm('{{ __('Remove this recovery test?', 'grcmanager')|e('js') }}');"><i class="ti ti-trash"></i></button>
                </form>
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
