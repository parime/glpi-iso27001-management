{# Issue #1083 : onglet « Tests du plan » : tests enregistrés (date, type, résultat, exercice, écarts et
   non-conformité créée), saisie d'un test, tests de reprise des processus couverts en lecture.
   Voir GlpiPlugin\Grcmanager\ContinuityPlanTesting::displayTabContentForItem(). #}
<div class="mb-3">
   {% if test_status == 'never' %}
      <div class="alert alert-warning mb-0"><i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>{{ __('This plan has never been tested. A plan that has not been tested gives no assurance that it works.', 'grcmanager') }}</div>
   {% elseif test_status == 'overdue' %}
      <div class="alert alert-warning mb-0"><i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>{{ __('The last test is more than a year old: plan a new exercise.', 'grcmanager') }}</div>
   {% else %}
      <div class="alert alert-success mb-0"><i class="ti ti-circle-check me-1" aria-hidden="true"></i>{{ __('This plan has been tested within the year.', 'grcmanager') }}</div>
   {% endif %}
</div>

<div class="card mb-3">
   <div class="card-header"><h3 class="card-title"><i class="ti ti-test-pipe me-2" aria-hidden="true"></i>{{ _n('Plan test', 'Plan tests', 2, 'grcmanager') }}</h3></div>
   <div class="card-body p-0">
      {% if tests is empty %}
         <p class="text-muted p-3 mb-0">{{ __('No test recorded yet.', 'grcmanager') }}</p>
      {% else %}
         <div class="table-responsive">
            <table class="table table-vcenter mb-0" id="grc-continuity-plan-tests">
               <thead>
                  <tr>
                     <th>{{ __('Date') }}</th>
                     <th>{{ __('Type') }}</th>
                     <th>{{ __('Result', 'grcmanager') }}</th>
                     <th>{{ __('Summary', 'grcmanager') }}</th>
                     <th>{{ __('Gaps found', 'grcmanager') }}</th>
                     <th></th>
                  </tr>
               </thead>
               <tbody>
                  {% for test in tests %}
                     <tr>
                        <td>{{ test.date }}{% if test.by %}<div class="text-muted small">{{ test.by }}</div>{% endif %}</td>
                        <td>
                           {{ test.type ?: '-' }}
                           {% if test.exercise %}<div class="small"><a href="{{ test.exercise_url }}"><i class="ti ti-alarm me-1" aria-hidden="true"></i>{{ test.exercise }}</a></div>{% endif %}
                        </td>
                        <td><span class="badge {{ test.result_class }}"><i class="ti {{ test.result_icon }} me-1" aria-hidden="true"></i>{{ test.result_label }}</span></td>
                        <td class="small">{{ test.summary|nl2br }}</td>
                        <td class="small">
                           {{ test.gaps|nl2br }}
                           {% if test.action is not null %}
                              <div><a href="{{ test.action.url }}"><i class="ti ti-alert-octagon me-1" aria-hidden="true"></i>{{ test.action.name }}</a></div>
                           {% elseif test.has_action %}
                              <div class="text-muted">{{ __('Action created', 'grcmanager') }}</div>
                           {% endif %}
                        </td>
                        <td class="text-end">
                           {% if can_update and not test.has_action %}
                              {% if test.gaps and can_nc %}
                                 <form method="post" action="{{ action }}" class="d-inline">
                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="id" value="{{ plan_id }}">
                                    <input type="hidden" name="tests_id" value="{{ test.id }}">
                                    <button type="submit" name="create_nonconformity" value="1" class="btn btn-sm btn-outline-warning"><i class="ti ti-alert-octagon me-1" aria-hidden="true"></i>{{ __('Create a nonconformity', 'grcmanager') }}</button>
                                 </form>
                              {% endif %}
                              <form method="post" action="{{ action }}" class="d-inline">
                                 <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                 <input type="hidden" name="id" value="{{ plan_id }}">
                                 <input type="hidden" name="tests_id" value="{{ test.id }}">
                                 <button type="submit" name="delete_test" value="1" class="btn btn-sm btn-ghost-danger" title="{{ __('Remove this test', 'grcmanager') }}" aria-label="{{ __('Remove this test', 'grcmanager') }}"><i class="ti ti-trash" aria-hidden="true"></i></button>
                              </form>
                           {% endif %}
                        </td>
                     </tr>
                  {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>
</div>

{% if can_update %}
   <div class="card mb-3" id="grc-continuity-plan-test-form">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-plus me-2" aria-hidden="true"></i>{{ __('Record a test of the plan', 'grcmanager') }}</h3></div>
      <div class="card-body">
         <form method="post" action="{{ action }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ plan_id }}">
            <div class="row g-2">
               <div class="col-md-3">
                  <label class="form-label" for="grc-continuity-test-date">{{ __('Date') }}</label>
                  <input type="date" class="form-control" name="test_date" id="grc-continuity-test-date" value="{{ today }}" max="{{ today }}" required>
               </div>
               <div class="col-md-3">
                  <label class="form-label" for="grc-continuity-test-type">{{ __('Type') }}</label>
                  <select class="form-select" name="test_type" id="grc-continuity-test-type">
                     {% for key, label in types %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
                  </select>
               </div>
               <div class="col-md-3">
                  <label class="form-label" for="grc-continuity-test-result">{{ __('Result', 'grcmanager') }}</label>
                  <select class="form-select" name="result" id="grc-continuity-test-result">
                     {% for key, label in results %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
                  </select>
               </div>
               <div class="col-md-3">
                  <label class="form-label" for="grc-continuity-test-exercise">{{ __('Crisis exercise', 'grcmanager') }}</label>
                  <select class="form-select" name="plugin_grcmanager_crisisexercises_id" id="grc-continuity-test-exercise">
                     {% for key, label in exercises %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
                  </select>
               </div>
               <div class="col-md-6">
                  <label class="form-label" for="grc-continuity-test-summary">{{ __('Summary', 'grcmanager') }}</label>
                  <textarea class="form-control" name="summary" id="grc-continuity-test-summary" rows="3"></textarea>
                  <div class="form-hint">{{ __('What was tested, who took part, the times measured against the objectives.', 'grcmanager') }}</div>
               </div>
               <div class="col-md-6">
                  <label class="form-label" for="grc-continuity-test-gaps">{{ __('Gaps found', 'grcmanager') }}</label>
                  <textarea class="form-control" name="gaps" id="grc-continuity-test-gaps" rows="3"></textarea>
                  <div class="form-hint">{{ __('Each gap can then become a nonconformity to follow up in the improvement section.', 'grcmanager') }}</div>
               </div>
            </div>
            <button type="submit" name="add_test" value="1" class="btn btn-primary mt-2"><i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ __('Record the test', 'grcmanager') }}</button>
         </form>
      </div>
   </div>
{% endif %}

{% if processes is not empty %}
   <div class="card">
      <div class="card-header"><h3 class="card-title"><i class="ti ti-lifebuoy me-2" aria-hidden="true"></i>{{ __('Recovery tests of the covered processes', 'grcmanager') }}</h3></div>
      <div class="card-body p-0">
         <div class="table-responsive">
            <table class="table table-vcenter mb-0">
               <thead>
                  <tr><th>{{ __('Process', 'grcmanager') }}</th><th>RTO</th><th>{{ __('Last recovery test', 'grcmanager') }}</th></tr>
               </thead>
               <tbody>
                  {% for process in processes %}
                     <tr>
                        <td><a href="{{ process.url }}">{{ process.name }}</a></td>
                        <td>{{ process.rto ?: '-' }}</td>
                        <td>
                           {% if process.last_test %}
                              {{ process.last_test|formatted_date }} ({{ process.test_duration }})
                              {% if process.test_exceeds %}<span class="badge bg-red-subtle text-red-emphasis">{{ __('Above the RTO', 'grcmanager') }}</span>{% endif %}
                           {% else %}
                              <span class="badge bg-orange-subtle text-orange-emphasis">{{ __('Never tested', 'grcmanager') }}</span>
                           {% endif %}
                        </td>
                     </tr>
                  {% endfor %}
               </tbody>
            </table>
         </div>
         <p class="text-muted small p-3 mb-0">{{ __('Recovery tests are recorded on each process (Recovery strategy tab) and in the recovery test programme.', 'grcmanager') }}</p>
      </div>
   </div>
{% endif %}
