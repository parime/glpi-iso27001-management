{# Issue #139 : « Mes formations », dans les préférences de l'utilisateur connecté. #}
{% if rows is empty %}
  <div class="alert alert-info">{{ __('You are not enrolled in any training.', 'grcmanager') }}</div>
{% else %}
  <table class="table table-hover card-table">
    <thead>
      <tr>
        <th>{{ __('Training', 'grcmanager') }}</th>
        <th>{{ __('Completion date', 'grcmanager') }}</th>
        <th>{{ __('Completion status', 'grcmanager') }}</th>
        <th>{{ __('Score', 'grcmanager') }}</th>
        <th>{{ __('Assessment', 'grcmanager') }}</th>
        <th>{{ __('Quiz copy', 'grcmanager') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr>
          <td>{{ row.title }}</td>
          <td>{{ row.date }}</td>
          <td>{{ row.status }}</td>
          <td>{{ row.score }}</td>
          <td>{{ row.result }}</td>
          <td>{% if row.url %}<a href="{{ row.url }}"><i class="ti ti-download me-1"></i>{{ __('Download', 'grcmanager') }}</a>{% endif %}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
