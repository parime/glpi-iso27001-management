{# Issue #854 : retard des correctifs de sécurité (A.8.8, A.8.19), d'après l'inventaire de GLPI, dans
   les entités de la personne. Lecture seule : aucune mise à jour n'est lancée. #}
{% macro rate_color(rate) %}{{ rate is null ? 'secondary' : (rate >= 95 ? 'success' : (rate >= 80 ? 'warning' : 'danger')) }}{% endmacro %}

<div id="grc-patch-compliance">
   <div class="row row-cards mb-3">
      {% set rate_color = _self.rate_color(summary.rate) %}
      <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ rate_color }}-subtle text-{{ rate_color }}-emphasis me-2 fs-3"><i class="ti ti-refresh-alert"></i></span>
            <div>
               <div class="fw-bold fs-3" id="grc-patch-rate">{{ summary.rate is null ? '-' : summary.rate ~ ' %' }}</div>
               <div class="small">{{ __('Computers with security patches on time', 'grcmanager') }}</div>
            </div>
         </div>
         <div class="small text-muted mt-1">{{ __('Among the %d computers whose last patch is known', 'grcmanager')|format(summary.late + summary.up_to_date) }}</div>
      </div></div></div>
      {% for code, info in infos %}
         <div class="col-sm-6 col-lg-3"><div class="card card-sm"><div class="card-body" title="{{ info.help }}">
            <div class="d-flex align-items-center">
               <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis me-2 fs-3"><i class="{{ info.icon }}"></i></span>
               <div>
                  <div class="fw-bold fs-3">{{ summary[code] }}</div>
                  <div class="small">{{ info.label }}</div>
               </div>
            </div>
            <div class="small text-muted mt-1">{{ info.help }}</div>
         </div></div></div>
      {% endfor %}
   </div>
   <div class="row row-cards mb-3">
      {% set srv_color = summary.late_critical_servers > 0 ? 'danger' : 'success' %}
      <div class="col-sm-6"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ srv_color }}-subtle text-{{ srv_color }}-emphasis me-2 fs-3"><i class="ti ti-server"></i></span>
            <div>
               <div class="fw-bold fs-3" id="grc-patch-critical-servers">{{ summary.late_critical_servers }}</div>
               <div class="small">{{ __('Critical servers with overdue patches', 'grcmanager') }}</div>
            </div>
         </div>
      </div></div></div>
      {% set exp_color = summary.late_exposed > 0 ? 'danger' : 'success' %}
      <div class="col-sm-6"><div class="card card-sm"><div class="card-body">
         <div class="d-flex align-items-center">
            <span class="badge bg-{{ exp_color }}-subtle text-{{ exp_color }}-emphasis me-2 fs-3"><i class="ti ti-world-upload"></i></span>
            <div>
               <div class="fw-bold fs-3">{{ summary.late_exposed }}</div>
               <div class="small">{{ __('Computers published on the Internet with overdue patches', 'grcmanager') }}</div>
            </div>
         </div>
      </div></div></div>
   </div>

   {# Délais cibles par criticité. #}
   <div class="card mb-3" id="grc-patch-targets">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-adjustments me-2"></i>{{ __('Target delays by criticality', 'grcmanager') }}</h3>
      </div>
      <div class="card-body">
         <p class="text-muted small">{{ __('The criticality of a computer comes from its C/I/A classification (tab of the computer form): the highest of the three levels counts. A computer that a network flow publishes on the Internet is critical. A computer is late when its last known patch is older than the delay of its criticality.', 'grcmanager') }}</p>
         <form method="post" action="{{ action }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div class="table-responsive">
               <table class="table table-sm table-vcenter">
                  <thead><tr>
                     <th>{{ __('Criticality', 'grcmanager') }}</th>
                     <th>{{ __('Target delay (days)', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Computers', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Patches overdue', 'grcmanager') }}</th>
                     <th class="text-end">{{ __('Rate', 'grcmanager') }}</th>
                  </tr></thead>
                  <tbody>
                  {% for tier, info in tiers %}
                     {% set group = by_tier[tier] %}
                     {% set color = _self.rate_color(group.rate) %}
                     <tr>
                        <td><span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis" title="{{ info.help }}">{{ info.label }}</span> <span class="small text-muted">{{ info.help }}</span></td>
                        <td>
                           {% if can_manage %}
                              <input type="number" class="form-control form-control-sm w-auto" name="patch_targets[{{ tier }}]" min="{{ min_target }}" max="{{ max_target }}" value="{{ targets[tier] }}" aria-label="{{ __('Target delay (days)', 'grcmanager') }}">
                           {% else %}
                              {{ targets[tier] }}
                           {% endif %}
                        </td>
                        <td class="text-end">{{ group.total }}</td>
                        <td class="text-end">{{ group.late }}</td>
                        <td class="text-end"><span class="badge bg-{{ color }}-subtle text-{{ color }}-emphasis">{{ group.rate is null ? '-' : group.rate ~ ' %' }}</span></td>
                     </tr>
                  {% endfor %}
                  </tbody>
               </table>
            </div>
            {% if can_manage %}
               <button type="submit" class="btn btn-primary" name="save_patch_targets" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'grcmanager') }}</button>
            {% endif %}
         </form>
      </div>
   </div>

   {# Ordinateurs : retards d'abord, exposés sur Internet et critiques en tête. #}
   <div class="card mb-3" id="grc-patch-list">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-list-details me-2"></i>{{ __('Patch status by computer', 'grcmanager') }}</h3>
         <div class="card-actions"><span class="badge bg-secondary-subtle text-secondary-emphasis">{{ total_rows }}</span></div>
      </div>
      {% if rows is empty %}
         <div class="card-body text-muted">{{ __('No computer in your entities.', 'grcmanager') }}</div>
      {% else %}
         {% if total_rows > rows|length %}
            <div class="card-body small pb-0">{{ __('%1$d computers: the first %2$d are shown, overdue ones first.', 'grcmanager')|format(total_rows, rows|length) }}</div>
         {% endif %}
         <div class="table-responsive">
            <table class="table table-vcenter card-table">
               <thead><tr>
                  <th>{{ __('Computer') }}</th>
                  <th>{{ __('Operating system') }}</th>
                  <th>{{ __('Last known patch', 'grcmanager') }}</th>
                  <th>{{ __('State', 'grcmanager') }}</th>
                  <th>{{ __('Vulnerabilities and end of support', 'grcmanager') }}</th>
                  <th>{{ __('Last inventory', 'grcmanager') }}</th>
               </tr></thead>
               <tbody>
               {% for row in rows %}
                  {% set info = infos[row.status] %}
                  {% set tier = tiers[row.tier] %}
                  <tr>
                     <td>
                        <a href="{{ row.url }}">{{ row.name }}</a>
                        <div class="small text-muted">{{ row.entity }}{% if row.type %} · {{ row.type }}{% endif %}</div>
                        <div class="mt-1">
                           <span class="badge bg-{{ tier.color }}-subtle text-{{ tier.color }}-emphasis" title="{{ tier.help }}">{{ tier.label }}</span>
                           {% if row.is_server %}<span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-server me-1"></i>{{ __('Server', 'grcmanager') }}</span>{% endif %}
                           {% if row.exposed %}<span class="badge bg-danger-subtle text-danger-emphasis"><i class="ti ti-world-upload me-1"></i>{{ __('Published on the Internet', 'grcmanager') }}</span>{% endif %}
                        </div>
                     </td>
                     <td class="small">
                        {{ row.os is empty ? __('Not inventoried', 'grcmanager') : row.os }}
                        {% if row.os_version or row.kernel %}<div class="text-muted">{{ row.os_version }}{% if row.os_version and row.kernel %} · {% endif %}{{ row.kernel }}</div>{% endif %}
                     </td>
                     <td class="small">
                        {% if row.last_patch_label is empty %}
                           <span class="text-muted">{{ sources[row.source] }}</span>
                        {% else %}
                           {{ row.last_patch_label }}
                           <div class="text-muted">{{ sources[row.source] }}{% if row.last_update %} · {{ row.last_update }}{% endif %}</div>
                           <div class="text-muted">{{ _n('%d day ago', '%d days ago', row.age, 'grcmanager')|format(row.age) }}</div>
                        {% endif %}
                     </td>
                     <td>
                        <span class="badge bg-{{ info.color }}-subtle text-{{ info.color }}-emphasis" title="{{ info.help }}"><i class="{{ info.icon }} me-1"></i>{{ info.label }}</span>
                        <div class="small text-muted mt-1">{{ __('Target: %d days', 'grcmanager')|format(row.target) }}{% if row.overdue > 0 %} · <span class="text-danger">{{ __('%d days late', 'grcmanager')|format(row.overdue) }}</span>{% endif %}</div>
                     </td>
                     <td class="small">
                        {% if row.cves is not null and row.cves.total > 0 %}
                           <a href="{{ row.vuln_url }}" class="badge {{ row.cves.critical > 0 or row.cves.kev > 0 ? 'bg-danger-subtle text-danger-emphasis' : 'bg-warning-subtle text-warning-emphasis' }} text-decoration-none"><i class="ti ti-bug me-1"></i>{{ __('%d known CVE(s) of the system', 'grcmanager')|format(row.cves.total) }}</a>
                           {% if row.cves.kev > 0 %}<span class="badge bg-danger-subtle text-danger-emphasis"><i class="ti ti-flame me-1"></i>{{ __('%d exploited', 'grcmanager')|format(row.cves.kev) }}</span>{% endif %}
                        {% endif %}
                        {% if row.eol is not null and row.eol is not empty %}
                           <span class="badge bg-danger-subtle text-danger-emphasis" title="{{ row.eol|join(', ') }}"><i class="ti ti-calendar-off me-1"></i>{{ __('No longer supported', 'grcmanager') }}</span>
                        {% endif %}
                     </td>
                     <td class="small">
                        {{ row.last_inventory_label is empty ? __('Never inventoried', 'grcmanager') : row.last_inventory_label }}
                        {% if row.stale_inventory %}<div class="mt-1"><span class="badge bg-warning-subtle text-warning-emphasis" title="{{ __('Inventory older than %d days: the data may be out of date.', 'grcmanager')|format(stale_days) }}"><i class="ti ti-clock me-1"></i>{{ __('Old inventory', 'grcmanager') }}</span></div>{% endif %}
                     </td>
                  </tr>
               {% endfor %}
               </tbody>
            </table>
         </div>
      {% endif %}
   </div>

   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="text-muted small me-auto">
         <i class="ti ti-eye me-1"></i>{{ __('Read only: the plugin reads the GLPI inventory, never starts an update and changes nothing in GLPI.', 'grcmanager') }}
      </span>
      <a class="btn btn-sm btn-outline-secondary" href="{{ computer_url }}"><i class="ti ti-device-desktop me-1"></i>{{ __('Computers in GLPI', 'grcmanager') }}</a>
      {% if vulnerabilities_url %}<a class="btn btn-sm btn-outline-primary" href="{{ vulnerabilities_url }}"><i class="ti ti-bug me-1"></i>{{ __('Fleet vulnerabilities', 'grcmanager') }}</a>{% endif %}
      {% if endoflife_url %}<a class="btn btn-sm btn-outline-primary" href="{{ endoflife_url }}"><i class="ti ti-calendar-off me-1"></i>{{ __('End of support', 'grcmanager') }}</a>{% endif %}
      {% if flows_url %}<a class="btn btn-sm btn-outline-secondary" href="{{ flows_url }}"><i class="ti ti-arrows-exchange me-1"></i>{{ __('Network flows', 'grcmanager') }}</a>{% endif %}
   </div>
</div>
