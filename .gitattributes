# Exclu par `git archive` (utilise par .github/workflows/release.yml pour construire l'archive de
# release) : utile au developpement et a la CI, jamais a l'execution du plugin.
/.github export-ignore
/.semgrep export-ignore
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpstan.neon.dist export-ignore
/phpstan.glpi12.neon export-ignore
/phpstan.glpi.neon export-ignore
/.phpstan export-ignore
/phpunit.xml.dist export-ignore
/phpunit-integration.xml.dist export-ignore
/phpcs.xml.dist export-ignore
/.glpi-security-exceptions export-ignore

/changes export-ignore

# Fins de ligne LF dans tous les clones, Windows compris : sync-locale-variants.sh compare les .po
# avec sed et un ancrage de fin de ligne, et les scripts .sh tournent sous Linux (docker, CI). En
# CRLF, le précheck local échouait sur les variantes régionales et la publication sur « set -e ».
*.sh  text eol=lf
*.po  text eol=lf
*.pot text eol=lf
*.py  text eol=lf
